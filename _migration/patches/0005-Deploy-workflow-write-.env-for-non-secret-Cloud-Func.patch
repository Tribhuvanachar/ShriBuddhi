From e49c0e7473c8d2bfc9655643de13d236927d1170 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 10 Sep 2026 09:40:15 +0000
Subject: [PATCH 5/7] Deploy workflow: write .env for non-secret Cloud
 Functions params

firebase-tools refuses to apply a defineString()'s own code-level
default in --non-interactive mode; it wants a dotenv file instead, or
the deploy fails outright listing all twelve params with no value.
Writes their already-declared defaults from index.js explicitly, never
committed, regenerated every run. Found on the first attempt that got
far enough to resolve every Secret Manager secret successfully.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0111c5EUqdmiA4aXfMDSjopx
---
 .../workflows/deploy-firebase-functions.yml   | 24 +++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/.github/workflows/deploy-firebase-functions.yml b/.github/workflows/deploy-firebase-functions.yml
index a69e69f3c..b1070c405 100644
--- a/.github/workflows/deploy-firebase-functions.yml
+++ b/.github/workflows/deploy-firebase-functions.yml
@@ -97,6 +97,30 @@ jobs:
           printf '{ "projects": { "default": "%s" } }\n' "${{ secrets.FIREBASE_PROJECT_ID }}" > dge/firebase/.firebaserc
       - name: Install function dependencies
         run: cd dge/firebase/functions && npm install
+      - name: Write default values for non-secret Cloud Functions params
+        # firebase-tools v2 params (defineString/defineInt) refuse to fall back to their own
+        # code-level `default` in --non-interactive mode -- it wants an explicit .env file
+        # instead, or the deploy fails outright listing every param with no value. None of
+        # these are secrets (see PAYMENT_SECRETS/index.js for the ones that are, which go
+        # through Secret Manager instead) -- this file just makes each one's already-declared
+        # default explicit so CI can deploy without a prompt. Never committed; regenerated by
+        # this step every run. Discovered 10 Sep 2026 on the first deploy attempt that got far
+        # enough to resolve all twelve Secret Manager secrets successfully.
+        run: |
+          cat > dge/firebase/functions/.env <<'EOF'
+          OTP_PROVIDER=whatsapp
+          OTP_TEMPLATE_NAME=dge_otp
+          OTP_TEMPLATE_LANG=en
+          OTP_DEFAULT_COUNTRY=91
+          MSG91_TEMPLATE_ID=
+          GITHUB_REPO=Tribhuvanachar/bhumandala
+          PAYMENT_GATEWAY=mock
+          PAYMENT_GATEWAYS_ENABLED=mock
+          CASHFREE_ENV=sandbox
+          CASHFREE_API_VERSION=2023-08-01
+          RAZORPAY_KEY_ID=
+          EMAIL_PROVIDER=console
+          EOF
       - name: Deploy Cloud Functions
         env:
           GOOGLE_APPLICATION_CREDENTIALS: /home/runner/.sa/key.json
