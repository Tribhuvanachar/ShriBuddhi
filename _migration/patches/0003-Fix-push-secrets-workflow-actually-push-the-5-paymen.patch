From c2e95e8f674a2200cb7567abb6cb35bebaffb354 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 10 Sep 2026 05:59:39 +0000
Subject: [PATCH 3/7] Fix push-secrets workflow: actually push the 5 payment
 secrets
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The workflow's own header comment documented PAYMENT_WEBHOOK_SECRET,
CASHFREE_CLIENT_ID/SECRET, and RAZORPAY_KEY_SECRET/WEBHOOK_SECRET as
required for any functions deploy to succeed, but the push loop never
included them — so a deploy would fail on a missing secret version no
matter what GitHub secrets existed. Discovered because Functions shows
"Waiting for your first deploy": nothing has ever deployed successfully.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0111c5EUqdmiA4aXfMDSjopx
---
 .github/workflows/push-firebase-function-secrets.yml | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/push-firebase-function-secrets.yml b/.github/workflows/push-firebase-function-secrets.yml
index 266f1345a..f84b36a51 100644
--- a/.github/workflows/push-firebase-function-secrets.yml
+++ b/.github/workflows/push-firebase-function-secrets.yml
@@ -133,12 +133,17 @@ jobs:
           S_OTP_PEPPER: ${{ secrets.OTP_PEPPER }}
           S_MSG91_AUTHKEY: ${{ secrets.MSG91_AUTHKEY }}
           S_GITHUB_DISPATCH_TOKEN: ${{ secrets.GITHUB_DISPATCH_TOKEN }}
+          S_PAYMENT_WEBHOOK_SECRET: ${{ secrets.PAYMENT_WEBHOOK_SECRET }}
+          S_CASHFREE_CLIENT_ID: ${{ secrets.CASHFREE_CLIENT_ID }}
+          S_CASHFREE_CLIENT_SECRET: ${{ secrets.CASHFREE_CLIENT_SECRET }}
+          S_RAZORPAY_KEY_SECRET: ${{ secrets.RAZORPAY_KEY_SECRET }}
+          S_RAZORPAY_WEBHOOK_SECRET: ${{ secrets.RAZORPAY_WEBHOOK_SECRET }}
         run: |
           npm install -g firebase-tools@15 >/dev/null 2>&1
           cd dge/firebase
           pushed=()
           skipped=()
-          for NAME in WHATSAPP_TOKEN WHATSAPP_PHONE_NUMBER_ID WHATSAPP_VERIFY_TOKEN WHATSAPP_APP_SECRET OTP_PEPPER MSG91_AUTHKEY GITHUB_DISPATCH_TOKEN; do
+          for NAME in WHATSAPP_TOKEN WHATSAPP_PHONE_NUMBER_ID WHATSAPP_VERIFY_TOKEN WHATSAPP_APP_SECRET OTP_PEPPER MSG91_AUTHKEY GITHUB_DISPATCH_TOKEN PAYMENT_WEBHOOK_SECRET CASHFREE_CLIENT_ID CASHFREE_CLIENT_SECRET RAZORPAY_KEY_SECRET RAZORPAY_WEBHOOK_SECRET; do
             VAR="S_${NAME}"
             VALUE="${!VAR}"
             if [ -z "$VALUE" ]; then
