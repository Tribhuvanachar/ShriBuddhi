+   "apparatus": {
+    "cross_ref": "",
+    "allusions_in": "[?]Pr.",
+    "allusions_to": "[?]Pr.",
+    "parallels": "",
+    "comments": ""
+   },
+   "has_cross_reference_content": false,
+   "domain": "",
+   "crosscheck": ""
+  }
+ ]
+}
