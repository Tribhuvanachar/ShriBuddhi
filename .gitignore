# Python bytecode. Running the test suite writes these all over the tree, and
# without this line every run leaves a dozen untracked directories behind.
__pycache__/
*.py[cod]
*$py.class

# Test and coverage scratch
.pytest_cache/
.coverage
htmlcov/

# Local editor / OS noise
.DS_Store
*.swp

# Personal Claude Code overrides. .claude/settings.json IS tracked — it is the
# team's permission rules; this is the per-person file that sits beside it.
.claude/settings.local.json
admin/config/vocab.json
