{"schema": "dhatu_vrittis", "code": "10.0449", "dhatu": "गर्व", "sources": ["madhaviya", "kshira", "dhatupradipa"], "vrittis": [{"source": "madhaviya", "name": "माधवीयधातुवृत्तिः", "author": "सायणः", "no": "1411", "meaning": "माने", "text": "माने ( गर्वयते ) आगर्वीयाः गर्वतीति शपि 361"}, {"source": "kshira", "name": "क्षीरतरङ्गिणी", "author": "क्षीरस्वामी", "no": "1429", "meaning": "माने", "text": "माने - गर्वयते भ्वादौ गर्व दर्प (1384)-गर्वति 347"}, {"source": "dhatupradipa", "name": "धातुप्रदीपः", "author": "मैत्रेयरक्षितः", "no": "1467", "meaning": "माने", "text": "माने - गर्वयते गर्वः अन्यत्र गर्वति गर्वप्रभृतिष्वदन्तत्वप्रयोजनं न दृश्यते णिचोऽनित्यत्वेन यङोऽभावार्थमिति केचित् (43) इति पदादिः 350"}], "licence": "GPL-2.0 (samsaadhanii/scl) — keep attribution"}