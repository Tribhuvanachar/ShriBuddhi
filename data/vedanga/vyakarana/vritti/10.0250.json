{"schema": "dhatu_vrittis", "code": "10.0250", "dhatu": "अर्ज", "sources": ["madhaviya", "kshira", "dhatupradipa"], "vrittis": [{"source": "madhaviya", "name": "माधवीयधातुवृत्तिः", "author": "सायणः", "no": "1295", "meaning": "प्रतियत्ने", "text": "प्रतियत्ने ( अर्जयति ) द्रव्यमर्जयतीत्यादिप्रयोगदर्शनादयमर्थान्तरेऽपि 190"}, {"source": "kshira", "name": "क्षीरतरङ्गिणी", "author": "क्षीरस्वामी", "no": "1315", "meaning": "प्रतियत्ने", "text": "प्रतियत्ने - प्रतियत्नः संस्कारः अर्जयति भ्वादौ अर्ज सर्ज अर्जने (1138) -अर्जति 191"}, {"source": "dhatupradipa", "name": "धातुप्रदीपः", "author": "मैत्रेयरक्षितः", "no": "1348", "meaning": "प्रतियत्ने", "text": "प्रतियत्ने - अर्जयति आर्जिजत् अन्यत्रार्जति 186"}], "licence": "GPL-2.0 (samsaadhanii/scl) — keep attribution"}