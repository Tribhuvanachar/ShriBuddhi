{"schema": "dhatu_vrittis", "code": "02.0056", "dhatu": "प्रा", "sources": ["madhaviya", "kshira", "dhatupradipa"], "vrittis": [{"source": "madhaviya", "name": "माधवीयधातुवृत्तिः", "author": "सायणः", "no": "711", "meaning": "पूरणे", "text": "पूरणे ( प्राति ) इत्यादि ( प्राणः, प्राणवान् ) \"संयोगादेरात'' इति निष्ठानत्वम् ( प्रायः ) \"श्याद्व्यध'' इति णः 51"}, {"source": "kshira", "name": "क्षीरतरङ्गिणी", "author": "क्षीरस्वामी", "no": "733", "meaning": "पूरणे", "text": "पूरणे - प्राति क्ते (द्र0 8243) प्राणः 49"}, {"source": "dhatupradipa", "name": "धातुप्रदीपः", "author": "मैत्रेयरक्षितः", "no": "750", "meaning": "पूरणे", "text": "पूरणे - प्राति । पप्रौ । प्रायः ।। 52 ।।"}], "licence": "GPL-2.0 (samsaadhanii/scl) — keep attribution"}