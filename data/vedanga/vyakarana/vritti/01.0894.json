{"schema": "dhatu_vrittis", "code": "01.0894", "dhatu": "रगे", "sources": ["madhaviya", "kshira", "dhatupradipa"], "vrittis": [{"source": "madhaviya", "name": "माधवीयधातुवृत्तिः", "author": "सायणः", "no": "485", "meaning": "शङ्कायाम्", "text": "शङ्कायाम् लगे सङ्गे ( रगति लगतीत्यादि ) कखिवत् (लग्नः) \"क्षुब्धस्वान्त'' इति अनिट्त्वं निष्ठायां निपात्यते अन्यत्र (लगितम्) रङ्गतिलङ्गती गत्यर्थेषु गतौ 774"}, {"source": "kshira", "name": "क्षीरतरङ्गिणी", "author": "क्षीरस्वामी", "no": "508", "meaning": "शङ्कायाम्", "text": "शङ्कायाम् - रगति अरगीत् रगडस्तालः 765"}, {"source": "dhatupradipa", "name": "धातुप्रदीपः", "author": "मैत्रेयरक्षितः", "no": "513", "meaning": "शङ्कायाम्", "text": "शङ्कायाम् - रगति ।अरगीत् । रगयति ।। 789 ।।"}], "licence": "GPL-2.0 (samsaadhanii/scl) — keep attribution"}