{"schema": "dhatu_vrittis", "code": "01.0444", "dhatu": "शीभृ", "sources": ["madhaviya", "kshira", "dhatupradipa"], "vrittis": [{"source": "madhaviya", "name": "माधवीयधातुवृत्तिः", "author": "सायणः", "no": "246", "meaning": "कत्थने", "text": "कत्थने ( शीभते ) शिशीभे शीभिता शिशीभिषते शेशीभ्यते शेशीब्धि \"झषस्तथोः'' इति तकारस्य धकारे \"झलां जश् झशि'' इति भकारस्य बकारः ( शीभयति अशिशीभत् शीभरः बाहुलकादरः 380"}, {"source": "kshira", "name": "क्षीरतरङ्गिणी", "author": "क्षीरस्वामी", "no": "260", "meaning": "कत्थने", "text": "कत्थने - शीभते शीभरः कत्थनः 375"}, {"source": "dhatupradipa", "name": "धातुप्रदीपः", "author": "मैत्रेयरक्षितः", "no": "261", "meaning": "कत्थने", "text": "कत्थने - शीभते । अशिशीभत् । शीभः ।। 374 ।।"}], "licence": "GPL-2.0 (samsaadhanii/scl) — keep attribution"}