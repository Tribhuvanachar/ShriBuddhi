{"schema": "dhatu_vrittis", "code": "01.0190", "dhatu": "श्वच", "sources": ["madhaviya", "kshira", "dhatupradipa"], "vrittis": [{"source": "madhaviya", "name": "माधवीयधातुवृत्तिः", "author": "सायणः", "no": "93", "meaning": "गतौ", "text": "गतौ ( श्वचते शश्वचे श्वचिता श्वञ्चते शश्वञ्चे श्वञ्चितेत्यादि ) उच्यादयस्तालव्यादयः 165"}, {"source": "kshira", "name": "क्षीरतरङ्गिणी", "author": "क्षीरस्वामी", "no": "97", "meaning": "गतौ", "text": "गतौ श्वचते, श्वञ्चते 166,167"}, {"source": "dhatupradipa", "name": "धातुप्रदीपः", "author": "मैत्रेयरक्षितः", "no": "99", "meaning": "गतौ", "text": "गतौ - श्वचते । शश्वचे । श्वञ्चते । श्वञ्च्यते ।। 164,165 ।।"}], "licence": "GPL-2.0 (samsaadhanii/scl) — keep attribution"}