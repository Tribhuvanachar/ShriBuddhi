{"schema": "dhatu_vrittis", "code": "01.0350", "dhatu": "षट", "sources": ["madhaviya", "kshira", "dhatupradipa"], "vrittis": [{"source": "madhaviya", "name": "माधवीयधातुवृत्तिः", "author": "सायणः", "no": "195", "meaning": "अवयवे", "text": "अवयवे ( सेटति ससाट सेटतुः सटिता सिसटिषति ) \"स्तौतिण्योरेव''इत्यषत्वम् ( साटयति असीषटत् सटा ) अजन्ताट्टाप् 310"}, {"source": "kshira", "name": "क्षीरतरङ्गिणी", "author": "क्षीरस्वामी", "no": "204", "meaning": "अवयवे", "text": "अवयवे - सटति, सिषाटयिषति सटा 305"}, {"source": "dhatupradipa", "name": "धातुप्रदीपः", "author": "मैत्रेयरक्षितः", "no": "204", "meaning": "अवयवे", "text": "अवयवे - सटति । सिषाटयिषति । साटः । सटा ।। 311 ।।"}], "licence": "GPL-2.0 (samsaadhanii/scl) — keep attribution"}