{"schema": "dhatu_vrittis", "code": "01.0872", "dhatu": "स्खद", "sources": ["madhaviya", "kshira", "dhatupradipa"], "vrittis": [{"source": "madhaviya", "name": "माधवीयधातुवृत्तिः", "author": "सायणः", "no": "471", "meaning": "स्खदने", "text": "स्खदने स्खदनं विद्रावणमिति स्वामी ( स्खदते स्खदिता स्खसदयति अचिस्खदत् अस्खदि परिस्खायदति) इत्यत्र मित्त्वं न भवति 756"}, {"source": "kshira", "name": "क्षीरतरङ्गिणी", "author": "क्षीरस्वामी", "no": "494", "meaning": "खदने", "text": "खदने - खदनं विदारणम् स्खदयति 477"}, {"source": "dhatupradipa", "name": "धातुप्रदीपः", "author": "मैत्रेयरक्षितः", "no": "499", "meaning": "स्खदने", "text": "स्खदने - स्खदते । चस्खदे । स्खदयति । स्खदा । 771"}], "licence": "GPL-2.0 (samsaadhanii/scl) — keep attribution"}