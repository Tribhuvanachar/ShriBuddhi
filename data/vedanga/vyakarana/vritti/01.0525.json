{"schema": "dhatu_vrittis", "code": "01.0525", "dhatu": "श्रोणृ", "sources": ["madhaviya", "kshira", "dhatupradipa"], "vrittis": [{"source": "madhaviya", "name": "माधवीयधातुवृत्तिः", "author": "सायणः", "no": "280", "meaning": "गतिप्रतिघाते", "text": "गतिप्रतिघाते (श्रोणा ) नक्षत्रम् अजन्ताष्टाप् श्रोणिः) इन्प्रत्ययः (श्रोणी) कृदिकारत्वाद्वा ङीष् (श्रोणा) नक्षत्रम् अजन्ताष्टम् 452"}, {"source": "kshira", "name": "क्षीरतरङ्गिणी", "author": "क्षीरस्वामी", "no": "293", "meaning": "संघाते", "text": "संघाते - श्रोणिः श्रोणः पङ्गुः 442"}, {"source": "dhatupradipa", "name": "धातुप्रदीपः", "author": "मैत्रेयरक्षितः", "no": "296", "meaning": "संघाते", "text": "संघाते - श्रोणति । श्रोणः ।। 455 ।।"}], "licence": "GPL-2.0 (samsaadhanii/scl) — keep attribution"}