{
  "schema": "grantha_mula_text",
  "default_author": "श्रीमदानन्दतीर्थभगवत्पादाचार्यः",
  "source_url": "https://anandamakaranda.in/index.php?title=Tattvasankhyanam",
  "source_note": "",
  "items": [
    {
      "id": "TSK_C01_V01",
      "reference": "1",
      "sanskrit_text": "स्वतन्त्रमस्वतन्त्रं च द्विविधं तत्त्वमिष्यते ।\nस्वतन्त्रो भगवान् विष्णुः भावाभावौ द्विधेतरत् ॥1॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvasankhyanam-1",
        "oldKey": "TSK_C01_V01",
        "type": "verse",
        "chapter": "TSK_C01"
      }
    },
    {
      "id": "TSK_C01_V02",
      "reference": "1",
      "sanskrit_text": "प्राक्प्रध्वंससदात्वेन त्रिविधोऽभाव इष्यते ।\nचेतनाचेतनत्वेन भावोऽपि द्विविधो मतः ॥2॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvasankhyanam-2",
        "oldKey": "TSK_C01_V02",
        "type": "verse",
        "chapter": "TSK_C01"
      }
    },
    {
      "id": "TSK_C01_V03",
      "reference": "1",
      "sanskrit_text": "दुःखस्पृष्टं तदस्पृष्टमिति द्वेधैव चेतनम् ।\nनित्यादुःखा रमाऽन्ये तु स्पृष्टदुःखास्समस्तशः ॥3॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvasankhyanam-3",
        "oldKey": "TSK_C01_V03",
        "type": "verse",
        "chapter": "TSK_C01"
      }
    },
    {
      "id": "TSK_C01_V04",
      "reference": "1",
      "sanskrit_text": "स्पृष्टदुःखा विमुक्ताश्च दुःखसंस्था इति द्विधा ।\nदुःखसंस्था मुक्तियोग्या अयोग्या इति च द्विधा ॥4॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvasankhyanam-4",
        "oldKey": "TSK_C01_V04",
        "type": "verse",
        "chapter": "TSK_C01"
      }
    },
    {
      "id": "TSK_C01_V05",
      "reference": "1",
      "sanskrit_text": "देवर्षिपितृपनरा इति मुक्तास्तु पञ्चधा ।\nएवं विमुक्तियोग्याश्च तमोगाः सृतिसंस्थिताः ॥5॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvasankhyanam-5",
        "oldKey": "TSK_C01_V05",
        "type": "verse",
        "chapter": "TSK_C01"
      }
    },
    {
      "id": "TSK_C01_V06",
      "reference": "1",
      "sanskrit_text": "इति द्विधा मुक्त्ययोग्या दैत्यरक्षपिशाचकाः ।\nमर्त्याधमाश्चतुर्धैव तमोयोग्याः प्रकीर्तिताः ॥6॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvasankhyanam-6",
        "oldKey": "TSK_C01_V06",
        "type": "verse",
        "chapter": "TSK_C01"
      }
    },
    {
      "id": "TSK_C01_V07",
      "reference": "1",
      "sanskrit_text": "ते च प्राप्तान्धतमसः सृतिसंस्था इति द्विधा ।\nनित्यानित्यविभागेन त्रिधैवाचेतनं मतम् ॥7॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvasankhyanam-7",
        "oldKey": "TSK_C01_V07",
        "type": "verse",
        "chapter": "TSK_C01"
      }
    },
    {
      "id": "TSK_C01_V08",
      "reference": "1",
      "sanskrit_text": "नित्या वेदाः पुराणाद्याः कालः प्रकृतिरेव च ।\nनित्यानित्यं त्रिधा प्रोक्तमनित्यं द्विविधं स्मृतम् ॥8॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvasankhyanam-8",
        "oldKey": "TSK_C01_V08",
        "type": "verse",
        "chapter": "TSK_C01"
      }
    },
    {
      "id": "TSK_C01_V09",
      "reference": "1",
      "sanskrit_text": "असंसृष्टं च संसृष्टमसंसृष्टं महानहम् ।\nबुद्धिर्मनःखानि दश मात्रा भूतानि पञ्च च ॥9॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvasankhyanam-9",
        "oldKey": "TSK_C01_V09",
        "type": "verse",
        "chapter": "TSK_C01"
      }
    },
    {
      "id": "TSK_C01_V10",
      "reference": "1",
      "sanskrit_text": "संसृष्टमण्डं तद्गं च समस्तं सम्प्रकीर्तितम् ।\nसृष्टिः स्थितिः संहृतिश्च नियमोऽज्ञानबोधने ॥10॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvasankhyanam-10",
        "oldKey": "TSK_C01_V10",
        "type": "verse",
        "chapter": "TSK_C01"
      }
    },
    {
      "id": "TSK_C01_V11",
      "reference": "1",
      "sanskrit_text": "बन्धो मोक्षः सुखं दुःखमावृत्तिर्ज्योतिरेव च ।\nविष्णुनास्य समस्तस्य समासव्यासयोगतः ॥11॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvasankhyanam-11",
        "oldKey": "TSK_C01_V11",
        "type": "verse",
        "chapter": "TSK_C01"
      }
    }
  ]
}
