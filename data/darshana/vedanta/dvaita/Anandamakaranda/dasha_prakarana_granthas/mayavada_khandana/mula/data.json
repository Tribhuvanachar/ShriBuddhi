      }
    },
    {
      "id": "MVK_C01_B07",
      "reference": "1",
      "sanskrit_text": "<span class=\"gr-reference gr-ref-Kathopanishat-id\">‘इन्द्रियेभ्यः परा ह्यर्था अर्थेभ्यश्च परं मनः ।<br/> मनसस्तु परा बुद्धिः बुद्धेरात्मा महान् परः ॥’(कठ.१.३.१०)</span>",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Mayavadakhandanam-8",
