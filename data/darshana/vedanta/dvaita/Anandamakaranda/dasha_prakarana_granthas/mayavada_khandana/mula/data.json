        "type": "bhashya",
        "chapter": "MVK_C01"
      }
    },
    {
      "id": "MVK_C01_B05",
      "reference": "1",
      "sanskrit_text": "<span class=\"gr-reference gr-ref-Bhagavata-id\">यो मामेवमसम्मूढो जानाति पुरुषोत्तमम् ।<br/> स सर्वविद्भजति मां सर्वभावेन भारत ॥(भ.गी.१५.१९)</span>",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Mayavadakhandanam-6",
