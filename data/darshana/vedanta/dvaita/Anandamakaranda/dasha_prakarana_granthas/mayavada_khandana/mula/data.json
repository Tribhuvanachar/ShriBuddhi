    {
      "id": "MVK_C01_V01",
      "reference": "1",
      "sanskrit_text": "नरसिंहोखिलाज्ञानमतध्वान्तदिवाकरः ।\nजयत्यमितसज्ज्ञानसुखशक्तिपयोनिधिः ॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Mayavadakhandanam-1",
        "oldKey": "MVK_C01_V01",
        "type": "verse",
        "chapter": "MVK_C01"
      }
    },
    {
      "id": "MVK_C01_B01",
      "reference": "1",
      "sanskrit_text": "‘विमतम् अनारम्भणीयम् अन्यथाप्रतिपादकत्वात्, यदित्थं तत्तथा, यथा सम्प्रतिपन्नम्’ । न हि ब्रह्मात्मैक्यस्य याथार्थ्यं तत्पक्षे । अद्वैतहानेः स्वरूपातिरेके । अनतिरेके स्वप्रकाशत्वादात्मनः सिद्धसाधनता । निर्विशेषत्वादात्मनो नानधिगतो विशेषः । सिद्धत्वाद् स्वरूपस्य विशेषाभावाच्च नाज्ञानं कस्यचिदावरकम् । ‘अनधिगतार्थगन्तृ प्रमाणम्’ इति च तन्मतम् । अज्ञानासम्भवादेव तन्मतम् अखिलमपाकृतम् । मिथ्यात्वे चैक्यस्यातत्त्वावेदकत्वमागमस्य स्यात् । सत्यता च भेदस्य । एवमेव प्रयोजनमपि निरस्तम् । स्वरूपत्वात् मोक्षस्य पूर्वमेव सिद्धत्वात् । अज्ञानासम्भवेन चतुर्थप्रकाराभावात् पञ्चमप्रकारताऽपि निरस्ता । विषयप्रयोजनाभावादेव अधिकारी च । तदभावादेव सम्बन्धोऽपि ।",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Mayavadakhandanam-2",
        "oldKey": "MVK_C01_B01",
        "type": "bhashya",
        "chapter": "MVK_C01"
      }
    },
    {
      "id": "MVK_C01_B02",
      "reference": "1",
      "sanskrit_text": "<span class=\"gr-reference gr-ref-Bhagavata-id\">‘द्वाविमौ पुरुषौ लोके क्षरश्चाक्षर एव च ।<br/> क्षरः सर्वाणि भूतानि कूटस्थोऽक्षर उच्यते ॥(भ.गी.१५.१६)</span>",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Mayavadakhandanam-3",
        "oldKey": "MVK_C01_B02",
        "type": "bhashya",
        "chapter": "MVK_C01"
      }
    },
    {
      "id": "MVK_C01_B03",
      "reference": "1",
      "sanskrit_text": "<span class=\"gr-reference gr-ref-Bhagavata-id\">उत्तमः पुरुषस्त्वन्यः परमात्मेत्युदाहृतः ।<br/> यो लोकत्रयमाविश्य बिभर्त्यव्यय ईश्वरः ॥(भ.गी.१५.१७)</span>",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Mayavadakhandanam-4",
        "oldKey": "MVK_C01_B03",
        "type": "bhashya",
        "chapter": "MVK_C01"
      }
    },
    {
      "id": "MVK_C01_B04",
      "reference": "1",
      "sanskrit_text": "<span class=\"gr-reference gr-ref-Bhagavata-id\">यस्माद् क्षरमतीतोऽहमक्षरादपि चोत्तमः ।<br/> अतोऽस्मि लोके वेदे च प्रथितः पुरुषोत्तमः ॥(भ.गी.१५.१८)</span>",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
