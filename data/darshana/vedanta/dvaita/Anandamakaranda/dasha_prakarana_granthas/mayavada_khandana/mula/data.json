      }
    },
    {
      "id": "MVK_C01_B09",
      "reference": "1",
      "sanskrit_text": "<span class=\"gr-reference gr-ref-Brahmasutra-id\">‘भूम्नः क्रतुवज्ज्यायस्त्वं तथा च दर्शयति’(ब्र.सू.३.३.५९)</span>\n। इति विष्णोः पुरुषोत्तमत्वमेव सर्वशास्त्रार्थत्वेन भगवता श्रुत्या चाभिहितम् ।",
