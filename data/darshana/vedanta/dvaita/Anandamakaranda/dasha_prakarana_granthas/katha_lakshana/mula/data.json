{
  "schema": "grantha_mula_text",
  "default_author": "श्रीमदानन्दतीर्थभगवत्पादाचार्यः",
  "source_url": "https://anandamakaranda.in/index.php?title=Kathalakshanam",
  "source_note": "",
  "items": [
    {
      "id": "KL_C01_V01",
      "reference": "1",
      "sanskrit_text": "नरसिंहमखिलाज्ञानतिमिराशिशिरद्युतिम् ।\nसम्प्रणम्य प्रवक्ष्यामि कथालक्षणमञ्जसा ॥1॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-1",
        "oldKey": "KL_C01_V01",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V02",
      "reference": "1",
      "sanskrit_text": "वादो जल्पो वितण्डेति त्रिविधा विदुषां कथा ।\nतत्त्वनिर्णयमुद्दिश्य केवलं गुरुशिष्ययोः ॥2॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-2",
        "oldKey": "KL_C01_V02",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V03",
      "reference": "1",
      "sanskrit_text": "कथाऽन्येषामपि सतां वादो वा समितेः शुभा ।\nख्यात्याद्यर्थं स्पर्धया वा सतां जल्प इतीर्यते ॥3॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-3",
        "oldKey": "KL_C01_V03",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V04",
      "reference": "1",
      "sanskrit_text": "वितण्डा तु सतामन्यैस्तत्त्वमेषु निगूहितम् ।\nस्वयं वा प्राश्निकैर्वादे चिन्तयेत् तत्त्वनिर्णयम् ॥4॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-4",
        "oldKey": "KL_C01_V04",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V05",
      "reference": "1",
      "sanskrit_text": "रागद्वेषविहीनास्तु सर्वविद्याविशारदाः ।\nप्राश्निका इति सम्प्रोक्ता विषमा एक एव वा ॥5॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-5",
        "oldKey": "KL_C01_V05",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V06",
      "reference": "1",
      "sanskrit_text": "अशेषसंशयच्छेत्ता निःसंशय उदारधीः ।\nएकश्चेत् प्राश्निको ज्ञेयः सर्वदोषविवर्जितः ॥6॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-6",
        "oldKey": "KL_C01_V06",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V07",
      "reference": "1",
      "sanskrit_text": "एको वा बहवो वा स्युर्विष्णुभक्तिपरास्सदा ।\nविष्णुभक्तिर्हि सर्वेषां सद्गुणानां स्वलक्षणम् ॥7॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-7",
        "oldKey": "KL_C01_V07",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V08",
      "reference": "1",
      "sanskrit_text": "पृष्टेनागम एवादौ वक्तव्यः साध्यसिद्धये ।\nनैषा तर्केणापनेया मतिरित्याह हि श्रुतिः ।\nअन्यार्थ एवागमस्य वक्तव्यः प्रतिवादिना ॥8॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-8",
        "oldKey": "KL_C01_V08",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V09",
      "reference": "1",
      "sanskrit_text": "ऋग्यजुःसामाथर्वाश्च भारतं पञ्चरात्रकम् ।\nमूलरामायणं चैव सम्प्रोच्यन्ते सदागमाः ॥9॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-9",
        "oldKey": "KL_C01_V09",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V10",
      "reference": "1",
      "sanskrit_text": "अनुकूला य एतेषां ते च प्रोक्तास्सदागमाः ।\nअन्ये दुरागमा नाम तैर्न साध्यं हि साध्यते ॥10॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-10",
        "oldKey": "KL_C01_V10",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V11",
      "reference": "1",
      "sanskrit_text": "स्वपक्ष आगमश्चैव वक्तव्यः प्रतिवादिना ।\nतस्याप्यन्यार्थता साध्या वादिना स्वार्थसिद्धये ॥11॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-11",
        "oldKey": "KL_C01_V11",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V12",
      "reference": "1",
      "sanskrit_text": "अन्यार्थता निराकार्या स्वागमस्य विनिश्चयम् ।\nउपपत्त्यवकाशोऽत्र ह्यागमार्थविनिर्णये ॥12॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-12",
        "oldKey": "KL_C01_V12",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V13",
      "reference": "1",
      "sanskrit_text": "वाद्यागमार्थे निर्णीत आगमार्थः परस्य तु ।\nनिर्णेयः सहितैः पश्चात्ततो निश्शेषनिर्णयः ॥13॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-13",
        "oldKey": "KL_C01_V13",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V14",
      "reference": "1",
      "sanskrit_text": "प्रत्यक्षसिद्धेष्वर्थेषु प्रश्ने मामक्षजं वदेत् ।\nज्ञानं वा ज्ञानसिद्धेषु नानुमां प्रथमं वदेत् ॥14॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-14",
        "oldKey": "KL_C01_V14",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V15",
      "reference": "1",
      "sanskrit_text": "परतुष्टिकरं वाक्यं वदेतां यदि वादिनी ।\nस एवात्रागमो ज्ञेयः परतुष्टिर्हि तत्फलम् ॥15॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-15",
        "oldKey": "KL_C01_V15",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V16",
      "reference": "1",
      "sanskrit_text": "एवं निर्णयपर्यन्तं वादे सुबहवोऽपि हि ।\nघटेयुश्चिरकालं च जल्पे यावत्परो जितः ॥16॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-16",
        "oldKey": "KL_C01_V16",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V17",
      "reference": "1",
      "sanskrit_text": "तत्त्वनिर्णयवैलोम्यं वादे साक्षात्पराजयः ।\nसंवादे श्लाघ्यतैव स्याद् गुरुत्वमितरस्य च ॥17॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-17",
        "oldKey": "KL_C01_V17",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V18",
      "reference": "1",
      "sanskrit_text": "तत्त्वनिर्णयवैलोम्ये निन्द्यो दण्ड्योऽथवा भवेत् ।\nविरोधासङ्गतिन्यूनतूष्णीम्भावादिकैर्जितः ॥18॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-18",
        "oldKey": "KL_C01_V18",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V19",
      "reference": "1",
      "sanskrit_text": "भवेज्जल्पे वितण्डायां न्यायो जल्पवदीरितः ।\nसंवादे दण्ड्यतां न स्याद् वितण्डाजल्पयोरपि ॥19॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-19",
        "oldKey": "KL_C01_V19",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V20",
      "reference": "1",
      "sanskrit_text": "पराजितत्वमात्रं स्यान्निन्द्यो दण्ड्योऽपि वाऽन्यथा ।\nअनुवादादिराहित्यं नैव जल्पेऽपि दूषणम् ॥20॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-20",
        "oldKey": "KL_C01_V20",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V21",
      "reference": "1",
      "sanskrit_text": "विद्याहीनत्वलिङ्गेऽपि वादिनोः स्यात् पराजयः ।\nतदभावान्नैव षट्कादन्यो निग्रह इष्यते ॥21॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-21",
        "oldKey": "KL_C01_V21",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V22",
      "reference": "1",
      "sanskrit_text": "अन्तर्भावादिहान्येषां निग्रहाणामिति स्म ह ।\nविद्यापरीक्षापूर्वैव वृत्तिर्जल्पवितण्डयोः ॥22॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-22",
        "oldKey": "KL_C01_V22",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V23",
      "reference": "1",
      "sanskrit_text": "स्खलितात्वादिमात्रेण न तत्रापि पराजयः ।\nवादजल्पवितण्डानामिति शुद्धं स्वलक्षणम् ॥23॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-23",
        "oldKey": "KL_C01_V23",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V24",
      "reference": "1",
      "sanskrit_text": "आनन्दतीर्थमुनिना ब्रह्मतर्कानुसारतः ।\nकथालक्षणमित्युक्तं प्रीत्यर्थं शार्ङ्गधन्वनः ॥24॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-24",
        "oldKey": "KL_C01_V24",
        "type": "verse",
        "chapter": "KL_C01"
      }
    },
    {
      "id": "KL_C01_V25",
      "reference": "1",
      "sanskrit_text": "सदोदितामितज्ञानपूरवारितहृत्तमाः ।\nनरसिंहः प्रियतमः प्रीयतां पुरुषोत्तमः ॥25॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Kathalakshanam-25",
        "oldKey": "KL_C01_V25",
        "type": "verse",
        "chapter": "KL_C01"
      }
    }
  ]
}
