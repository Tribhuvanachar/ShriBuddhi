{
  "schema": "grantha_mula_text",
  "default_author": "श्रीमदानन्दतीर्थभगवत्पादाचार्यः",
  "source_url": "https://anandamakaranda.in/index.php?title=Upadhikhandanam",
  "source_note": "",
  "items": [
    {
      "id": "UK_C01_V01",
      "reference": "1",
      "sanskrit_text": "नारायणोऽगण्यगुणनित्यैकनिलयाकृतिः ।\nअशेषदोषरहितः प्रीयतां कमलालयः ॥1॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Upadhikhandanam-1",
        "oldKey": "UK_C01_V01",
        "type": "verse",
        "chapter": "UK_C01"
      }
    },
    {
      "id": "UK_C01_B01",
      "reference": "1",
      "sanskrit_text": "अज्ञताऽखिलसंवेत्तुर्घटते न कुतश्चन ।\nउपाधिभेदाद्धटत इति चेत् स स्वभावतः ॥2॥",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Upadhikhandanam-2",
        "oldKey": "UK_C01_B01",
        "type": "bhashya",
        "chapter": "UK_C01"
      }
    },
    {
      "id": "UK_C01_B02",
      "reference": "1",
      "sanskrit_text": "अज्ञानतो वा द्वैतस्य सत्यता स्वत एव चेत् ।\nअनवस्थितिरज्ञानहेतौ वाऽन्योन्यसिद्धिता ॥3॥",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Upadhikhandanam-3",
        "oldKey": "UK_C01_B02",
        "type": "bhashya",
        "chapter": "UK_C01"
      }
    },
    {
      "id": "UK_C01_B03",
      "reference": "1",
      "sanskrit_text": "चक्रकापत्तिरथवा भेदश्चोपाधितः कुतः ।\nविद्यमानस्य भेदस्य ज्ञापको नैव कारकः ॥4॥",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Upadhikhandanam-4",
        "oldKey": "UK_C01_B03",
        "type": "bhashya",
        "chapter": "UK_C01"
      }
    },
    {
      "id": "UK_C01_B04",
      "reference": "1",
      "sanskrit_text": "उपाधिर्दृष्टपूर्वो हि खेऽपि देशान्तरस्य सः ।\nज्ञापको विद्यमानस्य मूढबुद्धिव्यपेक्षया ॥5॥",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Upadhikhandanam-5",
        "oldKey": "UK_C01_B04",
        "type": "bhashya",
        "chapter": "UK_C01"
      }
    },
    {
      "id": "UK_C01_B05",
      "reference": "1",
      "sanskrit_text": "न चेदुपाधिसम्बन्ध एकदेशेऽथ सर्वगः ।\nएकदेशेऽनवस्था स्यात् सर्वगश्चेन्न भेदकः ॥6॥",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Upadhikhandanam-6",
        "oldKey": "UK_C01_B05",
        "type": "bhashya",
        "chapter": "UK_C01"
      }
    },
    {
      "id": "UK_C01_B06",
      "reference": "1",
      "sanskrit_text": "सुखदुःखादिभोगश्च स्वरूपैक्ये न भेदतः ।\nदृश्यो ह्युपाधिभेदेऽपि हस्तपादादिगो यथा ॥7॥",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Upadhikhandanam-7",
        "oldKey": "UK_C01_B06",
        "type": "bhashya",
        "chapter": "UK_C01"
      }
    },
    {
      "id": "UK_C01_B07",
      "reference": "1",
      "sanskrit_text": "नानादेहगभोगानुसन्धानं योगिनो यथा ।\nन चेद्भोगानुसन्धानं तदिच्छा योगिनः कुतः ॥8॥",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Upadhikhandanam-8",
        "oldKey": "UK_C01_B07",
        "type": "bhashya",
        "chapter": "UK_C01"
      }
    },
    {
      "id": "UK_C01_B08",
      "reference": "1",
      "sanskrit_text": "अनुसन्धानरहितदेहबाहुल्यमन्यथा ।\nसिद्धमेव हि तत्पक्षे विशेषो योगिनः कुतः ॥9॥",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Upadhikhandanam-9",
        "oldKey": "UK_C01_B08",
        "type": "bhashya",
        "chapter": "UK_C01"
      }
    },
    {
      "id": "UK_C01_B09",
      "reference": "1",
      "sanskrit_text": "सिद्धौ हि कर्मभेदस्य स्यादुपाधिविभिन्नता ।\nतत्सिद्धौ चैव तत्सिद्धिरित्यन्योन्यव्यपाश्रयः ॥10॥",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Upadhikhandanam-10",
        "oldKey": "UK_C01_B09",
        "type": "bhashya",
        "chapter": "UK_C01"
      }
    },
    {
      "id": "UK_C01_B10",
      "reference": "1",
      "sanskrit_text": "आत्मस्वभावभेदस्य विदोषत्वेन चाखिलः ।\nप्रत्यक्षादिविरोधाच्च दुष्टः पक्षोऽयमञ्जसा ॥11॥",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Upadhikhandanam-11",
        "oldKey": "UK_C01_B10",
        "type": "bhashya",
        "chapter": "UK_C01"
      }
    },
    {
      "id": "UK_C01_B11",
      "reference": "1",
      "sanskrit_text": "चेष्टालिङ्गेन सात्मत्वे परदेहस्य साधिते ।\nअन्यत्वं स्वात्मनस्तस्मात् सर्वैरेवानुभूयते ॥12॥",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Upadhikhandanam-12",
        "oldKey": "UK_C01_B11",
        "type": "bhashya",
        "chapter": "UK_C01"
      }
    },
    {
      "id": "UK_C01_B12",
      "reference": "1",
      "sanskrit_text": "अज्ञता चाल्पशक्तित्वं दुःखित्वं स्वल्पकर्तृता ।\nसर्वज्ञतादीशगुणविरुद्धा ह्यनुभूतिगाः ॥13॥",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Upadhikhandanam-13",
        "oldKey": "UK_C01_B12",
        "type": "bhashya",
        "chapter": "UK_C01"
      }
    },
    {
      "id": "UK_C01_B13",
      "reference": "1",
      "sanskrit_text": "सार्वज्ञादिगुणा विष्णोः श्रुतिषु प्रतिपादिताः ।\n<span class=\"gr-reference gr-ref-Rigveda-id\">‘सत्यः सो अस्य महिमे’(ऋ.सं.८.३.४)</span>\nत्यादिवाक्यान्मृषा न च ॥14॥",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Upadhikhandanam-14",
        "oldKey": "UK_C01_B13",
        "type": "bhashya",
        "chapter": "UK_C01"
      }
    },
    {
      "id": "UK_C01_B14",
      "reference": "1",
      "sanskrit_text": "न च वेदोक्तमिथ्यात्वे मानं तन्मानताऽपि न ।\nअतोऽज्ञासम्भवादेव नाधिकार्यैक्यवादिनाम् ॥15॥",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Upadhikhandanam-15",
        "oldKey": "UK_C01_B14",
        "type": "bhashya",
        "chapter": "UK_C01"
      }
    },
    {
      "id": "UK_C01_B15",
      "reference": "1",
      "sanskrit_text": "अतो नाज्ञातमिति च विषयो विषयान्तरे ।\nअज्ञाभावात् फलं कस्य योगः शशनृशृङ्गयोः ॥16॥",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Upadhikhandanam-16",
        "oldKey": "UK_C01_B15",
        "type": "bhashya",
        "chapter": "UK_C01"
      }
    },
    {
      "id": "UK_C01_B16",
      "reference": "1",
      "sanskrit_text": "दुर्घटत्वं भूषणं चेत् स्यादविद्यात्वमात्मनः ।\nअन्धन्तमोऽप्यलङ्कारो नित्यदुःखं शिरोमणिः ॥17॥",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Upadhikhandanam-17",
        "oldKey": "UK_C01_B16",
        "type": "bhashya",
        "chapter": "UK_C01"
      }
    },
    {
      "id": "UK_C01_B17",
      "reference": "1",
      "sanskrit_text": "अतो\n<span class=\"gr-reference gr-ref-Rigveda-id\">‘परो मात्रये’(ऋ.सं.७.९९)</span>\nति पूर्वश्रुतिनिदर्शितः ।\n<span class=\"gr-reference gr-ref-Shwetashwatropanishat-id\">‘अन्यमीश’(श्वे.उ.४.७)</span>\nमिति श्रुत्या भिन्नजीवदृशं गतः ॥ भिन्नत्वेनात्मसादृश्यदो\n<span class=\"gr-reference gr-ref-Atharvanopanishat-id\">‘यदे’(आथ.उ.३.१.३)</span>\nति श्रुतेः सदा ॥18॥",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Upadhikhandanam-18",
        "oldKey": "UK_C01_B17",
        "type": "bhashya",
        "chapter": "UK_C01"
      }
    },
    {
      "id": "UK_C01_B18",
      "reference": "1",
      "sanskrit_text": "मायावादतमोव्याप्तमिति तत्त्वदृशा जगत् ।\nभातं सर्वज्ञसूर्येण प्रीतये श्रीपतेः सदा ॥19॥",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Upadhikhandanam-19",
        "oldKey": "UK_C01_B18",
        "type": "bhashya",
        "chapter": "UK_C01"
      }
    },
    {
      "id": "UK_C01_B19",
      "reference": "1",
      "sanskrit_text": "नमोऽमन्दनिजानन्दसान्द्रसुन्दरमूर्तये ।\nइन्दिरापतये नित्याऽनन्दभोजनदायिने ॥20॥",
      "tags": [
        "bhashya"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Upadhikhandanam-20",
        "oldKey": "UK_C01_B19",
        "type": "bhashya",
        "chapter": "UK_C01"
      }
    }
  ]
}
