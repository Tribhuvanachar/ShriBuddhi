{
  "schema": "grantha_mula_text",
  "default_author": "श्रीमदानन्दतीर्थभगवत्पादाचार्यः",
  "source_url": "https://anandamakaranda.in/index.php?title=Tattvaviveka",
  "source_note": "",
  "items": [
    {
      "id": "TV_C01_B01",
      "reference": "1",
      "sanskrit_text": "स्वतन्त्रं परतन्त्रं च प्रमेयं द्विविधं मतम् ।\nस्वतन्त्रो भगवान् विष्णुः निर्दोषाखलिसद्गुणः ॥1॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvaviveka-1",
        "oldKey": "TV_C01_B01",
        "type": "verse",
        "chapter": "TV_C01"
      }
    },
    {
      "id": "TV_C01_B02",
      "reference": "1",
      "sanskrit_text": "द्विविधं परतन्त्रं च भावोऽभाव इतीरितः ।\nपूर्वापरसदात्वेन त्रिविधोऽभाव इष्यते ॥2॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvaviveka-2",
        "oldKey": "TV_C01_B02",
        "type": "verse",
        "chapter": "TV_C01"
      }
    },
    {
      "id": "TV_C01_B03",
      "reference": "1",
      "sanskrit_text": "भावाभावस्वरूपत्वान्नान्योन्याभावता पृथक् ।\nचेतनाचेतनश्चेति भावश्च द्विविधः स्मृतः ॥3॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvaviveka-3",
        "oldKey": "TV_C01_B03",
        "type": "verse",
        "chapter": "TV_C01"
      }
    },
    {
      "id": "TV_C01_B04",
      "reference": "1",
      "sanskrit_text": "नित्यमुक्तश्च सृतियुक् परतन्त्रोऽपि चेतनः ।\nद्विधैव श्रीर्नित्यमुक्ता सृतियुक्च द्विधा मतः ॥4॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvaviveka-4",
        "oldKey": "TV_C01_B04",
        "type": "verse",
        "chapter": "TV_C01"
      }
    },
    {
      "id": "TV_C01_B05",
      "reference": "1",
      "sanskrit_text": "मुक्तोऽमुक्त इति ह्यत्र ब्रह्मान्ता उत्तरोत्तरम् ।\nमुक्ताः शतगुणाः प्रोक्ताः रमा तेभ्योऽखिलैर्गुणैः ॥5॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvaviveka-5",
        "oldKey": "TV_C01_B05",
        "type": "verse",
        "chapter": "TV_C01"
      }
    },
    {
      "id": "TV_C01_B06",
      "reference": "1",
      "sanskrit_text": "नित्यं बहुगुणोद्रिक्ता ततोऽनन्तगुणो हरिः ।\nअमुक्तास्त्रिविधास्तत्र नीचमध्योच्चभेदतः ॥6॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvaviveka-6",
        "oldKey": "TV_C01_B06",
        "type": "verse",
        "chapter": "TV_C01"
      }
    },
    {
      "id": "TV_C01_B07",
      "reference": "1",
      "sanskrit_text": "मुक्तियोग्यास्तत्र चोच्चा नित्यावर्तास्तु मध्यमाः ।\nनीचा नित्यतमोयोग्या द्विधैवाचेतनं मतम् ॥7॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvaviveka-7",
        "oldKey": "TV_C01_B07",
        "type": "verse",
        "chapter": "TV_C01"
      }
    },
    {
      "id": "TV_C01_B08",
      "reference": "1",
      "sanskrit_text": "नित्यानित्यत्वभेदेन देशः कालः श्रुतिस्तथा ।\nभूतेन्द्रियप्राणगुणसूक्ष्मरूपं च नित्यकम् ॥8॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvaviveka-8",
        "oldKey": "TV_C01_B08",
        "type": "verse",
        "chapter": "TV_C01"
      }
    },
    {
      "id": "TV_C01_B09",
      "reference": "1",
      "sanskrit_text": "एषां विकारोऽनित्यः स्यान्नित्या एव हि चेतनाः ।\nगुणक्रियाजातिपूर्वा धर्मा सर्वेऽपि वस्तुनः ॥9॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvaviveka-9",
        "oldKey": "TV_C01_B09",
        "type": "verse",
        "chapter": "TV_C01"
      }
    },
    {
      "id": "TV_C01_B10",
      "reference": "1",
      "sanskrit_text": "रूपमेव द्विधं तच्च यावद्वस्तु च खण्डितम् ।\nखण्डिते भेद ऐक्यं च यावद्वस्तु न भेदवत् ॥10॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvaviveka-10",
        "oldKey": "TV_C01_B10",
        "type": "verse",
        "chapter": "TV_C01"
      }
    },
    {
      "id": "TV_C01_B11",
      "reference": "1",
      "sanskrit_text": "खण्डितं रूपमेवात्र विकारोऽपि विकारिणः ।\nकार्यकारणयोश्चैव तथैव गुणतद्वतोः ॥11॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvaviveka-11",
        "oldKey": "TV_C01_B11",
        "type": "verse",
        "chapter": "TV_C01"
      }
    },
    {
      "id": "TV_C01_B12",
      "reference": "1",
      "sanskrit_text": "क्रियाक्रियावतोस्तद्वत् तथा जातिविशेषयोः ।\nविशिष्टशुद्धयोश्चैव तथैवांशांशिनोरपि ॥12॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvaviveka-12",
        "oldKey": "TV_C01_B12",
        "type": "verse",
        "chapter": "TV_C01"
      }
    },
    {
      "id": "TV_C01_B13",
      "reference": "1",
      "sanskrit_text": "य एतत्परतन्त्रं तु सर्वमेव हरेः सदा ।\nवशमित्येव जानाति संसारात् मुच्यते हि सः ॥13॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Tattvaviveka-13",
        "oldKey": "TV_C01_B13",
        "type": "verse",
        "chapter": "TV_C01"
      }
    }
  ]
}
