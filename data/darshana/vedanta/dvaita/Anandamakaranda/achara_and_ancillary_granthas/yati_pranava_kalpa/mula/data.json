{
  "schema": "grantha_mula_text",
  "default_author": "श्रीमदानन्दतीर्थभगवत्पादाचार्यः",
  "source_url": "https://anandamakaranda.in/index.php?title=Yatipranavavakalpa",
  "source_note": "",
  "items": [
    {
      "id": "YPK_C01_V01",
      "reference": "1",
      "sanskrit_text": "समिच्चर्वाज्यकान्हुत्वा सम्यक्पुरुषसूक्ततः ।\nसर्वेषामभयं दत्वा विरक्तः प्रव्रजेद्धरिम्॥ १॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-1",
        "oldKey": "YPK_C01_V01",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V02",
      "reference": "1",
      "sanskrit_text": "श्रुत्वा भागवतं शुद्धमाचार्यं शरणं व्रजेत् ।\nअधीहि भगवो ब्रह्मेत्यस्मै ब्रूयाद्गुरुः परम्॥ २॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-2",
        "oldKey": "YPK_C01_V02",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V03",
      "reference": "1",
      "sanskrit_text": "उच्चारयेत्त्रिशस्तारं दक्षिणे श्रवणे तथा ।\nऋषिच्छन्दोदैवतानि ब्रूयात्तस्य क्रमात्सुधीः॥ ३॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-3",
        "oldKey": "YPK_C01_V03",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V04",
      "reference": "1",
      "sanskrit_text": "अन्तर्यामीति गायत्री परमात्मेत्यनुक्रमात् ।\nविश्वश्च तैजसः प्राज्ञस्तुर्यश्चाक्षरदेवताः॥ ४॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-4",
        "oldKey": "YPK_C01_V04",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V05",
      "reference": "1",
      "sanskrit_text": "कृष्णो रामो नृसिंहश्च वराहो विष्णुरेव च ।\nपरञ्ज्योतिः परम्ब्रह्म वासुदेव इति क्रमात्॥ ५॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-5",
        "oldKey": "YPK_C01_V05",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V06",
      "reference": "1",
      "sanskrit_text": "अकारादेस्तथा शान्तातिशान्तान्तस्य देवताः ।\nएवमुक्त्वा तु तद्ध्यानं ब्रूयाच्छिष्याय सद्गुरुः॥ ६॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-6",
        "oldKey": "YPK_C01_V06",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V07",
      "reference": "1",
      "sanskrit_text": "अष्टपत्रे तु हृत्पद्मे मध्ये सूर्येन्दुवह्निगम् ।\nपीठं तत्पद्ममध्यस्थं नारायणमनामयम्॥ ७॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-7",
        "oldKey": "YPK_C01_V07",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V08",
      "reference": "1",
      "sanskrit_text": "उद्यदादित्यसङ्काशं तेजसानुपमं सदा ।\nसहस्रेणापि सूर्याणां सञ्ज्ञानानन्दरूपिणम्॥ ८॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-8",
        "oldKey": "YPK_C01_V08",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V09",
      "reference": "1",
      "sanskrit_text": "अतिरक्ततलं भास्वन्नखव्रातविभूषितम् वृत्तजङ्घं वृत्तजानुं हस्तिहस्तोरुमीश्वरम्॥ ९॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-9",
        "oldKey": "YPK_C01_V09",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V10",
      "reference": "1",
      "sanskrit_text": "महाकटितटाबद्धकाञ्चीपीताम्बरोज्ज्वलम् ।\nसुनिम्ननाभिं त्रिवलिं सुवृत्तोदरबन्धनम्॥ १०॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-10",
        "oldKey": "YPK_C01_V10",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V11",
      "reference": "1",
      "sanskrit_text": "विशालवक्षसं भ्राजत्कौस्तुभामुक्तकन्धरम् ।\nवनमालाधरं हारवैजयन्त्यादिभिर्युतम्॥ ११॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-11",
        "oldKey": "YPK_C01_V11",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V12",
      "reference": "1",
      "sanskrit_text": "पृथुदीर्घचतुर्बाहुं शङ्खचक्रगदाम्बुजैः ।\nयुक्तमुन्निद्रपद्माक्षं स्फुरन्मकरकुण्डलम्॥ १२॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-12",
        "oldKey": "YPK_C01_V12",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V13",
      "reference": "1",
      "sanskrit_text": "पूर्णचन्द्रायुतोद्रिक्तकान्तिमन्मुखपङ्कजम् ।\nसुभ्रुवं सुललाटान्तं किरीटाबद्धमूर्धजम्॥ १३॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-13",
        "oldKey": "YPK_C01_V13",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V14",
      "reference": "1",
      "sanskrit_text": "निःशेषदुःखदमनं नित्यानन्दशुचिस्मितम् ।\nविश्वादींश्चैव कृष्णादीनेवं भूतान्सनातनान्॥ १४॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-14",
        "oldKey": "YPK_C01_V14",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V15",
      "reference": "1",
      "sanskrit_text": "अभिन्नानेव सततं तस्माद्विष्णोः परात्मनः ।\nवराभयोद्यतकरान्नित्यानन्दैकरूपिणः॥ १५॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-15",
        "oldKey": "YPK_C01_V15",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V16",
      "reference": "1",
      "sanskrit_text": "एवमुक्त्वा गुरुर्ध्यानं शपथं कारयेत्ततः ।\nन विष्णुं वैष्णवांश्चैव विसृजेयमिति त्रिशः॥ १६॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-16",
        "oldKey": "YPK_C01_V16",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V17",
      "reference": "1",
      "sanskrit_text": "न चान्यदेवतासाम्यं तदैक्यमथवा हरेः ।\nचिन्तयेयं मृतो वापि न चाप्येकत्ववादिभिः॥ १७॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-17",
        "oldKey": "YPK_C01_V17",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V18",
      "reference": "1",
      "sanskrit_text": "समत्ववादिभिर्वाहं सङ्गच्छेयं कदाचन ।\nतन्निन्दकैश्च तद्भक्तनिन्दकैर्वा महामुने॥ १८॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-18",
        "oldKey": "YPK_C01_V18",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V19",
      "reference": "1",
      "sanskrit_text": "एवं कृते तु शपथे मस्तके हस्तपङ्कजम् ।\nनिधायोत्तीर्य संसारात्सुखी भव हरेः प्रियः॥ १९॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-19",
        "oldKey": "YPK_C01_V19",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V20",
      "reference": "1",
      "sanskrit_text": "सर्वदुःखादिभिर्मुक्तो नित्यानन्दैकरूपकः ।\nसम्प्राप्य विष्णुसामीप्यं तत्रापि हरिभक्तिमान्॥ २०॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-20",
        "oldKey": "YPK_C01_V20",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V21",
      "reference": "1",
      "sanskrit_text": "भक्तिमांश्चान्यदेवेषु तारतम्यं च संस्मरन् ।\nसर्वोत्कर्षं स्मरन्विष्णोर्भूयाश्चैव सदा सुखी॥ २१॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-21",
        "oldKey": "YPK_C01_V21",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V22",
      "reference": "1",
      "sanskrit_text": "न मुक्तौ विष्णुनैक्यं वा मुक्तानां साम्यमेव वा ।\nस्मरेथा इति चोक्त्वाथ समयाननुशिक्षयेत्॥ २२॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-22",
        "oldKey": "YPK_C01_V22",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V23",
      "reference": "1",
      "sanskrit_text": "नित्यशश्च हरेः पूजा जपध्यानसमर्पणम् ।\nकर्तव्यं तु त्वया वत्स जपश्च त्रिसहस्रकः॥ २३॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-23",
        "oldKey": "YPK_C01_V23",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V24",
      "reference": "1",
      "sanskrit_text": "मध्यमः प्रणवस्योक्तो योवरः स सहस्रकः ।\nत्रिसहस्रात्परो यस्तु स उत्तमजपः ---स्मृतः॥ २४॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-24",
        "oldKey": "YPK_C01_V24",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V25",
      "reference": "1",
      "sanskrit_text": "आत्मानं प्रतिबिम्बत्वे ध्यायन् बिम्बं जनार्दनम् ।\nध्यायस्व सततं वत्स सपर्यां नित्यशः कुरु॥ २५॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-25",
        "oldKey": "YPK_C01_V25",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V26",
      "reference": "1",
      "sanskrit_text": "मानसैर्वाथ पुष्पैर्वा प्रणवेन समाहितः ।\nअन्यांश्च वैष्णवान्मन्त्राञ्जपेथा भक्तिपूर्वकम्॥ २६॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-26",
        "oldKey": "YPK_C01_V26",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V27",
      "reference": "1",
      "sanskrit_text": "शृृणुष्व वैष्णवं शास्त्रं सदा वेदार्थतत्परः ।\nवेदान्मन्त्रानुपनिषत्सहितान्सर्वदा शृृणु॥ २७॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-27",
        "oldKey": "YPK_C01_V27",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    },
    {
      "id": "YPK_C01_V28",
      "reference": "1",
      "sanskrit_text": "इतिहासपुराणं च पञ्चरात्रं तथैव च ।\nतदर्थान् ब्रह्मसूत्रैश्च सम्यङ्निर्णीय तत्त्वतः ।\nविष्णोः सर्वोत्तमत्त्वं च सर्वदा प्रतिपादय॥ २८॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Yatipranavavakalpa-28",
        "oldKey": "YPK_C01_V28",
        "type": "verse",
        "chapter": "YPK_C01"
      }
    }
  ]
}
