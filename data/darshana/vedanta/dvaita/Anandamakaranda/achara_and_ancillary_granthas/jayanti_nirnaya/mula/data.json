{
  "schema": "grantha_mula_text",
  "default_author": "श्रीमदानन्दतीर्थभगवत्पादाचार्यः",
  "source_url": "https://anandamakaranda.in/index.php?title=Jayantinirnaya",
  "source_note": "",
  "items": [
    {
      "id": "JN_C01_V01",
      "reference": "1",
      "sanskrit_text": "रोहिण्यामर्धरात्रे तु यदा कालाष्टमी भवेत् ।\nजयन्ती नाम सा प्रोक्ता सर्वपापप्रणाशिनी॥ १॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Jayantinirnaya-1",
        "oldKey": "JN_C01_V01",
        "type": "verse",
        "chapter": "JN_C01"
      }
    },
    {
      "id": "JN_C01_V02",
      "reference": "1",
      "sanskrit_text": "यस्यां जातो हरिः साक्षान्निशीथे भगवानजः ।\nतस्मात्तद्दिनमत्यन्तं पुण्यं पापहरं परम्॥ २॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Jayantinirnaya-2",
        "oldKey": "JN_C01_V02",
        "type": "verse",
        "chapter": "JN_C01"
      }
    },
    {
      "id": "JN_C01_V03",
      "reference": "1",
      "sanskrit_text": "तस्मात् सर्वैरुपोष्या सा जयन्ती नाम वै सदा ।\nद्विजातिभिर्विशेषेण तद्भक्तैश्च विशेषतः॥ ३॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Jayantinirnaya-3",
        "oldKey": "JN_C01_V03",
        "type": "verse",
        "chapter": "JN_C01"
      }
    },
    {
      "id": "JN_C01_V04",
      "reference": "1",
      "sanskrit_text": "यो भुङ्क्ते तद्दिने मोहात्पूयशोणितमत्ति सः ।\nतस्मादुपवसेत् पुण्यं तद्दिनं श्रद्धयान्वितः॥ ४॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Jayantinirnaya-4",
        "oldKey": "JN_C01_V04",
        "type": "verse",
        "chapter": "JN_C01"
      }
    },
    {
      "id": "JN_C01_V05",
      "reference": "1",
      "sanskrit_text": "कृत्वा शौचं यथान्यायं स्नानं कुर्यादतन्द्रितः ।\nप्रभातकाले मेधावी योगायेति यथाविधि॥ ५॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Jayantinirnaya-5",
        "oldKey": "JN_C01_V05",
        "type": "verse",
        "chapter": "JN_C01"
      }
    },
    {
      "id": "JN_C01_V06",
      "reference": "1",
      "sanskrit_text": "नित्याह्निकं प्रकुर्वीत भगवन्तमनुस्मरन् ।\nयोगाय योगपतये योगेश्वराय योगसम्भवाय श्रीगोविन्दाय नमो नमः॥ ६॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Jayantinirnaya-6",
        "oldKey": "JN_C01_V06",
        "type": "verse",
        "chapter": "JN_C01"
      }
    },
    {
      "id": "JN_C01_V07",
      "reference": "1",
      "sanskrit_text": "मध्याह्नकाले च पुमान् सायङ्काले त्वतन्द्रितः ।\nस्नायीत पूर्वमन्त्रेण वासुदेवमनुस्मरन्॥ ७॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Jayantinirnaya-7",
        "oldKey": "JN_C01_V07",
        "type": "verse",
        "chapter": "JN_C01"
      }
    },
    {
      "id": "JN_C01_V08",
      "reference": "1",
      "sanskrit_text": "ततः पूजां प्रकुर्वीत विधिवत्सुसमाहितः ।\nयज्ञायेति च मन्त्रेण श्रद्धाभक्तियुतः पुमान्॥ ८॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Jayantinirnaya-8",
        "oldKey": "JN_C01_V08",
        "type": "verse",
        "chapter": "JN_C01"
      }
    },
    {
      "id": "JN_C01_V09",
      "reference": "1",
      "sanskrit_text": "कृष्णं च बलभद्रं च वसुदेवं च देवकीम् ।\nनन्दगोपं यशोदां च सुभद्रां तत्र पूजयेत् ।\nअर्घ्यं दत्वा समभ्यर्च्याभ्युदिते शशिमण्डले॥ ९॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Jayantinirnaya-9",
        "oldKey": "JN_C01_V09",
        "type": "verse",
        "chapter": "JN_C01"
      }
    },
    {
      "id": "JN_C01_V10",
      "reference": "1",
      "sanskrit_text": "जातः कंसवधार्थाय भूभारोत्तारणाय च ।\nकौरवाणां विनाशाय दैत्यानां निधनाय च॥ १०॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Jayantinirnaya-10",
        "oldKey": "JN_C01_V10",
        "type": "verse",
        "chapter": "JN_C01"
      }
    },
    {
      "id": "JN_C01_V11",
      "reference": "1",
      "sanskrit_text": "पाण्डवानां हितार्थाय धर्मसंस्थापनाय च ।\nगृहणार्घ्यं मया दत्तं देवक्या सहितो हरे॥ ११॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Jayantinirnaya-11",
        "oldKey": "JN_C01_V11",
        "type": "verse",
        "chapter": "JN_C01"
      }
    },
    {
      "id": "JN_C01_V12",
      "reference": "1",
      "sanskrit_text": "क्षीरोदार्णवसम्भूत अत्रिनेत्रसमुद्भव ।\nगृहाणार्घ्यं मया दत्तं रोहिण्या सहितः शशिन्॥ १२॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Jayantinirnaya-12",
        "oldKey": "JN_C01_V12",
        "type": "verse",
        "chapter": "JN_C01"
      }
    },
    {
      "id": "JN_C01_V13",
      "reference": "1",
      "sanskrit_text": "दत्वार्घ्यं मनुनानेन ह्युपस्थाय विधुं बुधः ।\nशशिने चन्द्रदेवाय सोमदेवाय चेन्दवे॥ १३॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Jayantinirnaya-13",
        "oldKey": "JN_C01_V13",
        "type": "verse",
        "chapter": "JN_C01"
      }
    },
    {
      "id": "JN_C01_V14",
      "reference": "1",
      "sanskrit_text": "मृगिणे सितबिम्बाय लोकदीपाय दीपिने ।\nशीतदीधितिबिम्बाय तारकापतये नमः॥ १४॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Jayantinirnaya-14",
        "oldKey": "JN_C01_V14",
        "type": "verse",
        "chapter": "JN_C01"
      }
    },
    {
      "id": "JN_C01_V15",
      "reference": "1",
      "sanskrit_text": "उपसंहृत्य तत्सर्वं ब्रह्मचारी जितेन्द्रियः ।\nविश्वायेति च मन्त्रेण ततः स्वापं समाचरेत्॥ १५॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Jayantinirnaya-15",
        "oldKey": "JN_C01_V15",
        "type": "verse",
        "chapter": "JN_C01"
      }
    },
    {
      "id": "JN_C01_V16",
      "reference": "1",
      "sanskrit_text": "ततो नित्याह्निकं कृत्वा शक्तितो दीयतां धनम् ।\nसर्वायेति च मन्त्रेण ततः पारणमाचरेत् ।\nधर्मायेति ततः स्वस्थो मुच्यते सर्वकिल्बिषैः॥ १७॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Jayantinirnaya-16",
        "oldKey": "JN_C01_V16",
        "type": "verse",
        "chapter": "JN_C01"
      }
    }
  ]
}
