{
  "schema": "grantha_mula_text",
  "default_author": "श्रीमदानन्दतीर्थभगवत्पादाचार्यः",
  "source_url": "https://anandamakaranda.in/index.php?title=Sadacharasmriti",
  "source_note": "",
  "items": [
    {
      "id": "SSM_C01_V01",
      "reference": "1",
      "sanskrit_text": "यस्मिन् सर्वाणि कर्माणि संन्यस्याध्यात्मचेतसा ।\nनिराशीर्निर्ममो याति परं जयति सोऽच्युतः॥ १॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-1",
        "oldKey": "SSM_C01_V01",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V02",
      "reference": "1",
      "sanskrit_text": "स्मृत्वा विष्णुं समुत्थाय कृतशौचो यथाविधि ।\nधौतदन्तः समाचम्य स्नानं कुर्याद् विधानतः॥ २॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-2",
        "oldKey": "SSM_C01_V02",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V03",
      "reference": "1",
      "sanskrit_text": "उद्धृतेति मृदाऽऽलिप्य द्विषडष्टषडक्षरैः ।\nत्रिर्निमज्याप्यसूक्तेन प्रोक्षयित्वा पुनस्ततः ।\nमृदाऽऽलिप्य निमज्य त्रिस्त्रिर्जपेदघमर्षणम्॥ ३॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-3",
        "oldKey": "SSM_C01_V03",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V04",
      "reference": "1",
      "sanskrit_text": "स्रष्टारं सर्वलोकानां स्मृत्वा नारायणं परम् ।\nयतश्वासो निमज्याप्सु प्रणवेनोत्थितस्ततः ।\nसिञ्चन् पुरुषसूक्तेन स्वदेहस्थं हरिं स्मरन्॥ ४॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-4",
        "oldKey": "SSM_C01_V04",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V05",
      "reference": "1",
      "sanskrit_text": "वसित्वा वास आचभ्य प्रोक्ष्याचम्य च मन्त्रतः ।\nगायत्र्या चाञ्जलिं दत्वा ध्यात्वा सूर्यगतं हरिम्॥ ५॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-5",
        "oldKey": "SSM_C01_V05",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V06",
      "reference": "1",
      "sanskrit_text": "मन्त्रतः परिवृत्याथ समाचम्य सुरादिकान् ।\nतर्पयित्वा निपीड्याथ वासो विस्तृत्य चाञ्जसा॥ ६॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-6",
        "oldKey": "SSM_C01_V06",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V07",
      "reference": "1",
      "sanskrit_text": "अर्कमण्डलगं विष्णुं ध्यात्वैव त्रिपदीं जपेत् ।\nसहस्रपरमां देवीं शतमध्यां दशावराम्॥ ७॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-7",
        "oldKey": "SSM_C01_V07",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V08",
      "reference": "1",
      "sanskrit_text": "आसूर्यदर्शनात्तिष्ठेत् ततस्तूपविशेत वा ।\nपूर्वां सन्ध्यां सनक्षत्राम् उत्तरां सदिवाकराम् ।\nउत्तरामुपविश्यैव वाग्यतः सर्वदा जपेत्॥८॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-8",
        "oldKey": "SSM_C01_V08",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V09",
      "reference": "1",
      "sanskrit_text": "ध्येयः सदा सवितृमण्डलमध्यवर्ती नारायणः सरसिजासनसन्निविष्टः ।\nकेयूरवान् मकरकुण्डलवान् किरीटी हारी हिरण्मयवपुर्धृतशङ्खचक्रः॥९॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-9",
        "oldKey": "SSM_C01_V09",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V10",
      "reference": "1",
      "sanskrit_text": "गायत्र्यास्त्रिगुणं विष्णुं ध्यायन्नष्टाक्षरं जपेत् ।\nप्रणम्य देवान् विप्रांश्च गुरूंश्च हरिपार्षदान् ।\nएवं सर्वोत्तमं विष्णुं ध्यायन्नेवार्चयेद्धरिम्॥ १०॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-10",
        "oldKey": "SSM_C01_V10",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V11",
      "reference": "1",
      "sanskrit_text": "ध्यानप्रवचनाभ्यां च यथायोग्यमुपासनम् ।\nधर्मेणेज्यासाधनानि साधयित्वा विधानतः ।\nस्नात्वा सम्पूजयेद्विष्णुं वेदतन्त्रोक्तमार्गतः॥ ११॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-11",
        "oldKey": "SSM_C01_V11",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V12",
      "reference": "1",
      "sanskrit_text": "वैश्वदेवं बलिं चैव कुर्यान्नित्यं तदर्पणम् ।\nइष्टं दत्तं हुतं जप्तं पूर्तं यच्चात्मनः प्रियम् ।\nदारान् सुतान् प्रियान् प्राणान् परस्मै सन्निवेदयेन्॥ १२॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-12",
        "oldKey": "SSM_C01_V12",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V13",
      "reference": "1",
      "sanskrit_text": "भुक्तशेषं भगवतो भृत्यातिथिपुरस्सरः ।\nभुञ्जीत हृद्गतं विष्णुं स्मरंस्तद्गतमानसः ।\nआचम्य मूलमन्त्रेण कोष्ठं स्वमभिमन्त्रयेत्॥ १३॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-13",
        "oldKey": "SSM_C01_V13",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V14",
      "reference": "1",
      "sanskrit_text": "वेदशास्त्रविनोदेन प्रीणयन् पुरुषोत्तमम् ।\nअहःशेषं नयेत्सन्ध्याम् उपासीताथ पूर्ववत्॥ १४॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-14",
        "oldKey": "SSM_C01_V14",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V15",
      "reference": "1",
      "sanskrit_text": "यामात्परत एवाथ स्वपेद्ध्यायन् जनार्दनम् ।\nअन्तराले ततो बुद्‍ध्वा स्मरेत बहुशो हरिम्॥ १५॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-15",
        "oldKey": "SSM_C01_V15",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V16",
      "reference": "1",
      "sanskrit_text": "कायेन वाचा मनसेन्द्रियैर्वा बुद्ध्यात्मना वानुसृतस्स्वभावम् ।\nकरोति यद्यत्सकलं परस्मै नारायणायेति समर्पयेत्तत्॥ १६॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-16",
        "oldKey": "SSM_C01_V16",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V17",
      "reference": "1",
      "sanskrit_text": "द्वाविमौ पुरुषौ लोके क्षरश्चाक्षर एव च ।\nक्षरः सर्वाणि भूतानि कूटस्थोऽक्षर उच्यते॥ १७॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-17",
        "oldKey": "SSM_C01_V17",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V18",
      "reference": "1",
      "sanskrit_text": "उत्तमः पुरुषस्त्वन्यः परमात्मेत्युदाहृतः ।\nयो लोकत्रयमाविश्य बिभर्त्यव्यय ईश्वरः॥ १८॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-18",
        "oldKey": "SSM_C01_V18",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V19",
      "reference": "1",
      "sanskrit_text": "यस्मात्क्षरमतीतोहमक्षरादपि चोत्तमः ।\nअतोऽस्मि लोके वेदे च प्रथितः पुरुषोत्तमः॥ १९॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-19",
        "oldKey": "SSM_C01_V19",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V20",
      "reference": "1",
      "sanskrit_text": "यो मामेवमसम्मूढो जानाति पुरुषोत्तमम् ।\nस सर्वविद्भजति मां सर्वभावेन भारत॥ २०॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-20",
        "oldKey": "SSM_C01_V20",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V21",
      "reference": "1",
      "sanskrit_text": "इति गुह्यतमं शास्त्रमिदमुक्तं मयानघ ।\nएतद्बुद्‍ध्वा बुद्धिमान्स्यात्कृतकृत्यश्च भारत'''॥ २१॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-21",
        "oldKey": "SSM_C01_V21",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V22",
      "reference": "1",
      "sanskrit_text": "रुद्रं समाश्रिता देवा रुद्रो ब्रह्माणमाश्रितः ।\nब्रह्मा मामाश्रितो नित्यं नाहं कञ्चिदुपाश्रितः'''॥ २२॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-22",
        "oldKey": "SSM_C01_V22",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V23",
      "reference": "1",
      "sanskrit_text": "ये मे मतमिदं नित्यमनुतिष्ठन्ति मानवाः ।\nश्रद्धावन्तोऽनसूयन्तो मुच्यन्ते तेऽपि कर्मभिः॥ २३॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-23",
        "oldKey": "SSM_C01_V23",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V24",
      "reference": "1",
      "sanskrit_text": "ये त्वेतदभ्यसूयन्तो नानुतिष्ठन्ति मे मतम् ।\nसर्वज्ञानविमूढांस्तान्विद्धि नष्टानचेतसः॥ २४॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-24",
        "oldKey": "SSM_C01_V24",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V25",
      "reference": "1",
      "sanskrit_text": "द्वौ भूतसर्गौ लोकेऽस्मिन्दैव आसुर एव च ।\nविष्णुभक्तिपरो दैवो विपरीतस्तथासुरः॥२५॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-25",
        "oldKey": "SSM_C01_V25",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V26",
      "reference": "1",
      "sanskrit_text": "स्मर्तव्यः सततं विष्णुर्विस्मर्तव्यो न जातुचित् ।\nसर्वे विधिनिषेधाः स्युरेतयोरेव किङ्कराः॥२६॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-26",
        "oldKey": "SSM_C01_V26",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V27",
      "reference": "1",
      "sanskrit_text": "धर्मो भवत्यधर्मोऽपि कृतो भक्तैस्तवाच्युत ।\nपापं भवति धर्मोऽपि यो न भक्तैः कृतो हरेः॥२७॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-27",
        "oldKey": "SSM_C01_V27",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V28",
      "reference": "1",
      "sanskrit_text": "मन्मना भव मद्भक्तो मद्याजी मां नमस्कुरु ।\nनित्यं भवेच्च मन्निष्ठो बुभूषुः पुरुषस्सदा॥२८॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-28",
        "oldKey": "SSM_C01_V28",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V29",
      "reference": "1",
      "sanskrit_text": "एष नित्यः सदाचारो गृहिणो वनिनस्तथा ।\nवैश्वदेवं बलिं दन्तधावनं चाप्यृते वटोः॥२९॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-29",
        "oldKey": "SSM_C01_V29",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V30",
      "reference": "1",
      "sanskrit_text": "एवमेव यतेः स्वीयवित्तेन तु विना सदा ।\nमूलमन्त्रैः सदा स्नानं विष्णोरेव च तर्पणम्॥३०॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-30",
        "oldKey": "SSM_C01_V30",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V31",
      "reference": "1",
      "sanskrit_text": "विशेषो निष्क्रिययतेरजलाञ्जलिना तथा ।\nतर्पणं तु हरेरेव यतेरन्यस्य चोदितम्। समिद्धोमो वटोश्चैव स्मृत्वा विष्णुं हुताशने॥३१॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-31",
        "oldKey": "SSM_C01_V31",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V32",
      "reference": "1",
      "sanskrit_text": "सर्ववर्णाश्रमैर्विष्णुरेक एवेज्यते सदा ।\nरमाब्रह्मादयस्तस्य परिवारत एव तु॥३२॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-32",
        "oldKey": "SSM_C01_V32",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V33",
      "reference": "1",
      "sanskrit_text": "कविं पुराणमनुशासितारम् अणोरणीयांसमनुस्मरेद् यः ।\nसर्वस्य धातारमचिन्त्यरूपम् आदित्यवर्णं तमसः परस्तात्॥३३॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-33",
        "oldKey": "SSM_C01_V33",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V34",
      "reference": "1",
      "sanskrit_text": "वेदाहमेतं पुरुषं महान्तम् आदित्यवर्णं तमसस्तु पारे ।\nसर्वाणि रूपाणि विचिन्त्य धीरः नामानि कृत्वाभिवदन् यदास्ते॥ ३४॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-34",
        "oldKey": "SSM_C01_V34",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V35",
      "reference": "1",
      "sanskrit_text": "धाता पुरस्ताद्यमुदाजहार शक्रः प्रविद्वान्प्रदिशश्चतस्रः ।\nतमेवं विद्वानमृत इह भवति नान्यः पन्था अयनाय विद्यते॥ ३५॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-35",
        "oldKey": "SSM_C01_V35",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V36",
      "reference": "1",
      "sanskrit_text": "आनन्दतीर्थमुनिना व्यासवाक्यसमुद्धृतिः ।\nसदाचारस्य विषये कृता सङ्क्षेपतः शुभा॥ ३६॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-36",
        "oldKey": "SSM_C01_V36",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    },
    {
      "id": "SSM_C01_V37",
      "reference": "1",
      "sanskrit_text": "अशेषकल्याणगुणनित्यानुभवसत्तनुः ।\nअशेषदोषरहितः प्रीयतां पुरुषोत्तमः॥ ३९॥",
      "tags": [
        "verse",
        "shloka"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Sadacharasmriti-37",
        "oldKey": "SSM_C01_V37",
        "type": "verse",
        "chapter": "SSM_C01"
      }
    }
  ]
}
