{
  "schema": "grantha_mula_text",
  "default_author": "श्रीमदानन्दतीर्थभगवत्पादाचार्यः",
  "source_url": "https://anandamakaranda.in/index.php?title=Anubhashya",
  "source_note": "",
  "items": [
    {
      "id": "BSAB_C01_I01",
      "reference": "1",
      "sanskrit_text": "नारायणं गुणैः सर्वैरुदीर्णं दोषवर्जितम्।\nज्ञेयं गम्यं गुरूंश्चापि नत्वा सूत्रार्थ उच्यते ॥1॥",
      "tags": [
        "introduction"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-1",
        "oldKey": "BSAB_C01_I01",
        "type": "introduction",
        "chapter": "BSAB_C01"
      }
    },
    {
      "id": "BSAB_C01_V01",
      "reference": "1",
      "sanskrit_text": "विष्णुरेव विजिज्ञास्यः सर्वकर्ताऽगमोदितः।\nसमन्वयादीक्षतेश्च पूर्णानन्दोऽन्तरः खवत्‌॥ १॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-2",
        "oldKey": "BSAB_C01_V01",
        "type": "verse",
        "chapter": "BSAB_C01"
      }
    },
    {
      "id": "BSAB_C01_V02",
      "reference": "1",
      "sanskrit_text": "प्रणेता ज्योतिरित्याद्यैः प्रसिद्धैरन्यवस्तुषु।\nउच्यते विष्णुरेवैकः सर्वैः सर्वगुणत्वतः॥ २॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-3",
        "oldKey": "BSAB_C01_V02",
        "type": "verse",
        "chapter": "BSAB_C01"
      }
    },
    {
      "id": "BSAB_C01_V03",
      "reference": "1",
      "sanskrit_text": "सर्वगोऽत्ता नियन्ता च दृश्यत्वाद्युज्झितः सदा।\nविश्वजीवान्तरत्वाद्यैर्लिङ्गैः सर्वैर्युतः स हि॥ ३॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-4",
        "oldKey": "BSAB_C01_V03",
        "type": "verse",
        "chapter": "BSAB_C01"
      }
    },
    {
      "id": "BSAB_C01_V04",
      "reference": "1",
      "sanskrit_text": "सर्वाश्रयः पूर्णगुणः सोऽक्षरः सन्‌ हृदब्जगः।\nसूर्यादिभासकः प्राणप्रेरको दैवतैरपि॥ ४॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-5",
        "oldKey": "BSAB_C01_V04",
        "type": "verse",
        "chapter": "BSAB_C01"
      }
    },
    {
      "id": "BSAB_C01_V05",
      "reference": "1",
      "sanskrit_text": "ज्ञेयो न वेदैः शूद्रादैः कम्पकोऽन्यश्च जीवतः।\nपतित्वादिगुणैर्युक्तः तदन्यत्र च वाचकैः॥ ५॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-6",
        "oldKey": "BSAB_C01_V05",
        "type": "verse",
        "chapter": "BSAB_C01"
      }
    },
    {
      "id": "BSAB_C01_V06",
      "reference": "1",
      "sanskrit_text": "मुख्यतः सर्वशब्दैश्च वाच्य एको जनार्दनः।\nअव्यक्तः कर्मवाच्यैश्च वाच्य एकोऽमितात्मकः॥ ६॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-7",
        "oldKey": "BSAB_C01_V06",
        "type": "verse",
        "chapter": "BSAB_C01"
      }
    },
    {
      "id": "BSAB_C01_V07",
      "reference": "1",
      "sanskrit_text": "अवान्तरं कारणं च प्रकृतिः शून्यमेव च।\nइत्याद्यन्यत्र नियतैरपि मुख्यतयोदितः।\nशब्दैरतोऽनन्तगुणो यच्छब्दा योगवृत्तयः॥ ७॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-8",
        "oldKey": "BSAB_C01_V07",
        "type": "verse",
        "chapter": "BSAB_C01"
      }
    },
    {
      "id": "BSAB_C02_V01",
      "reference": "2",
      "sanskrit_text": "श्रौतस्मृतिविरुद्धत्वात्‌ स्मृतयो न गुणान् हरेः।\nनिषेद्धुं शक्नुयुर्वेदा नित्यत्वान्मानमुत्तमम्‌॥ १॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-9",
        "oldKey": "BSAB_C02_V01",
        "type": "verse",
        "chapter": "BSAB_C02"
      }
    },
    {
      "id": "BSAB_C02_V02",
      "reference": "2",
      "sanskrit_text": "देवतावचनादापो वदन्तीत्यादिकं वचः ।\nनायुक्तवाद्यसन्नैव कारणं दृश्यते क्वचित् ॥ २॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-10",
        "oldKey": "BSAB_C02_V02",
        "type": "verse",
        "chapter": "BSAB_C02"
      }
    },
    {
      "id": "BSAB_C02_V03",
      "reference": "2",
      "sanskrit_text": "असज्जीवप्रधानादिशब्दा ब्रह्मैव नापरम्‌।\nवदन्ति कारणत्वेन क्वापि पूर्णगुणो हरिः॥ ३॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-11",
        "oldKey": "BSAB_C02_V03",
        "type": "verse",
        "chapter": "BSAB_C02"
      }
    },
    {
      "id": "BSAB_C02_V04",
      "reference": "2",
      "sanskrit_text": "स्वातन्त्र्यात् सर्वकर्तृत्वान्नायुक्तं तद्वदेच्छ्रुतिः।\nभ्रान्तिमूलतया सर्वसमयानामयुक्तितः॥४॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-12",
        "oldKey": "BSAB_C02_V04",
        "type": "verse",
        "chapter": "BSAB_C02"
      }
    },
    {
      "id": "BSAB_C02_V05",
      "reference": "2",
      "sanskrit_text": "न तद्विरोधाद्वचनं वैदिकं शङ्क्यतां व्रजेत्‌।\nआकाशादिसमस्तं च तज्जं तेनैव लीयते॥ ५ ॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-13",
        "oldKey": "BSAB_C02_V05",
        "type": "verse",
        "chapter": "BSAB_C02"
      }
    },
    {
      "id": "BSAB_C02_V06",
      "reference": "2",
      "sanskrit_text": "सोऽनुत्पत्तिलयः कर्ता जीवः तद्वशगः सदा।\nतदाभासो हरिः सर्वरूपेष्वपि समः सदा॥ .६॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-14",
        "oldKey": "BSAB_C02_V06",
        "type": "verse",
        "chapter": "BSAB_C02"
      }
    },
    {
      "id": "BSAB_C02_V07",
      "reference": "2",
      "sanskrit_text": "मुख्यप्राणश्चेन्द्रियाणि देहश्चैव तदुद्भवः।\nमुख्यप्राणवशे सर्वं स विष्णोर्वशगः सदा॥ ७॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-15",
        "oldKey": "BSAB_C02_V07",
        "type": "verse",
        "chapter": "BSAB_C02"
      }
    },
    {
      "id": "BSAB_C02_V08",
      "reference": "2",
      "sanskrit_text": "सर्वदोषोज्झितः तस्माद्‌ भगवान्‌ पुरुषोत्तमः।\nउक्ता गुणाश्चाविरुद्धास्तस्य वेदेषु सर्वशः॥ ८॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-16",
        "oldKey": "BSAB_C02_V08",
        "type": "verse",
        "chapter": "BSAB_C02"
      }
    },
    {
      "id": "BSAB_C03_V01",
      "reference": "3",
      "sanskrit_text": "शुभेन कर्मणा स्वर्गं निरयं च विकर्मणा।\nमिथ्याज्ञानेन च तमो ज्ञानेनैव परं पदम्‌॥ १॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-17",
        "oldKey": "BSAB_C03_V01",
        "type": "verse",
        "chapter": "BSAB_C03"
      }
    },
    {
      "id": "BSAB_C03_V02",
      "reference": "3",
      "sanskrit_text": "याति तस्माद्विरक्तः सन्‌ ज्ञानमेव समाश्रयेत्‌।\nसर्वावस्थाप्रेरकश्च सर्वरूपेष्वभेदवान्‌॥ २॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-18",
        "oldKey": "BSAB_C03_V02",
        "type": "verse",
        "chapter": "BSAB_C03"
      }
    },
    {
      "id": "BSAB_C03_V03",
      "reference": "3",
      "sanskrit_text": "सर्वदेशेषु कालेषु स एकः परमेश्वरः।\nतद्भक्तितारतम्येन तारतम्यं विमुक्तिगम्‌॥ ३॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-19",
        "oldKey": "BSAB_C03_V03",
        "type": "verse",
        "chapter": "BSAB_C03"
      }
    },
    {
      "id": "BSAB_C03_V04",
      "reference": "3",
      "sanskrit_text": "सच्चिदानन्द आत्मेति मानुषैस्तु सुरेश्वरैः।\nयथाक्रमं बहुगुणैर्ब्रह्मणा त्वखिलैर्गुणैः॥ ४॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-20",
        "oldKey": "BSAB_C03_V04",
        "type": "verse",
        "chapter": "BSAB_C03"
      }
    },
    {
      "id": "BSAB_C03_V05",
      "reference": "3",
      "sanskrit_text": "उपास्यः सर्वदेवैश्च सर्वैरपि यथा बलम्‌।\nज्ञेयो विष्णुर्विशेषस्तु ज्ञाने स्यादुत्तरोत्तरम्॥ ५॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-21",
        "oldKey": "BSAB_C03_V05",
        "type": "verse",
        "chapter": "BSAB_C03"
      }
    },
    {
      "id": "BSAB_C03_V06",
      "reference": "3",
      "sanskrit_text": "सर्वेऽपि पुरुषार्थास्युः ज्ञानादेव न संशयः।\nन लिप्यते ज्ञानावांश्च सर्वदोषैरपि क्वचित्‌॥ ६॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-22",
        "oldKey": "BSAB_C03_V06",
        "type": "verse",
        "chapter": "BSAB_C03"
      }
    },
    {
      "id": "BSAB_C03_V07",
      "reference": "3",
      "sanskrit_text": "गुणदोषैः सुखस्यापि वृद्धिह्रासौ विमुक्तिगौ।\nनृणां सुराणां मुक्तौ तु सुखं क्लृप्तं यथाक्रमम्‌॥ ७॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-23",
        "oldKey": "BSAB_C03_V07",
        "type": "verse",
        "chapter": "BSAB_C03"
      }
    },
    {
      "id": "BSAB_C04_V01",
      "reference": "4",
      "sanskrit_text": "विष्णुर्ब्रह्म तथाऽदातेत्येवं नित्यमुपासनम्‌।\nकार्यमापद्यपि ब्रह्म तेन यात्यपरोक्षताम्‌॥ १॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-24",
        "oldKey": "BSAB_C04_V01",
        "type": "verse",
        "chapter": "BSAB_C04"
      }
    },
    {
      "id": "BSAB_C04_V02",
      "reference": "4",
      "sanskrit_text": "प्रारब्धकर्मणोऽन्यस्य ज्ञानादेव परिक्षयः।\nअनिष्टस्योभयस्यापि सर्वस्यान्यस्य भोगतः॥ २॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-25",
        "oldKey": "BSAB_C04_V02",
        "type": "verse",
        "chapter": "BSAB_C04"
      }
    },
    {
      "id": "BSAB_C04_V03",
      "reference": "4",
      "sanskrit_text": "उत्तरेषूत्तरेष्वेवं यावद्वायुं विमुक्तिगाः।\nप्रविश्य भुञ्जते भोगांस्तदन्तर्बहिरेव वा॥ ३॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-26",
        "oldKey": "BSAB_C04_V03",
        "type": "verse",
        "chapter": "BSAB_C04"
      }
    },
    {
      "id": "BSAB_C04_V04",
      "reference": "4",
      "sanskrit_text": "वायुर्विष्णुं प्रविश्यैव भोगांश्चैवोत्तरोत्तरम्‌।\nउत्क्रम्य मानुषा मुक्तिं यान्ति देहक्षयात् सुराः॥४॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-27",
        "oldKey": "BSAB_C04_V04",
        "type": "verse",
        "chapter": "BSAB_C04"
      }
    },
    {
      "id": "BSAB_C04_V05",
      "reference": "4",
      "sanskrit_text": "अर्चिरादिपथा वायुं प्राप्य तेन जनार्दनम्‌।\nयान्त्युत्तमा नरोच्चाद्या ब्रह्मलोकात् सहाऽमुना॥ ५॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-28",
        "oldKey": "BSAB_C04_V05",
        "type": "verse",
        "chapter": "BSAB_C04"
      }
    },
    {
      "id": "BSAB_C04_V06",
      "reference": "4",
      "sanskrit_text": "यथासङ्कल्पभोगाश्च चिदानन्दशरीरिणः।\nजगत्सृष्ट्यादिविषये महासामर्थ्यमप्यृते॥ ६॥",
      "tags": [
        "verse",
        "mantra"
      ],
      "notes": "",
      "references": [],
      "audio": [],
      "source": {
        "site": "anandamakaranda.in",
        "block_id": "Anubhashya-29",
        "oldKey": "BSAB_C04_V06",
        "type": "verse",
        "chapter": "BSAB_C04"
      }
    },
    {
      "id": "BSAB_C04_V07",
      "reference": "4",
