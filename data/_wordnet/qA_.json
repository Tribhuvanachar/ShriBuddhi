{"s":[["n","मृतस्त्रियः आत्मनः सा अवस्था या गत्याभावात् अनिष्टानि कार्याणि करोति।","विज्ञानयुगेऽपि नैके जनाः मायिनीं विश्वसन्ति।",["मायिनी","पुतना","डाकिनी"],"धारणा",["ಭೂತ","ಪಿಶಾಚಿ","ದೆವ್ವ","ಆತ್ಮ"]],["v","आकाशमार्गेण एकस्मात् स्थानात् अन्यस्थानसंयोगाय उत्पतनप्रेरणानुकूलव्यापारः।","वैमानिकः विमानं डाययति।",["डाय","प्रडाय","उड्डाय","खे विसर्पय","वियति विसर्पय","पातय","उत्पातय","प्रोत्पातय","समुत्पातय","सम्पातय","आकाशेन गमय","आकाशेन यापय"],"कृ",["ಹಾರಿಸು"]],["v","उड्डयनप्रेरणानुकूलः व्यापारः।","कृषकः महायावानलं भक्षयतः पक्षिणः बालैः डाययति।",["डायय","उड्डायय"],"कारय",["ಓಡಿಸು"]],["n","एकः जलीयः पक्षीविशेषः।","अत्यूहस्य शिरः कृष्णं भवति।",["अत्यूहः","काकमद्गुः","कालकण्ठकः","कालकण्टकः","डाहुकः","मादकः","डुन्दुकः","दात्यूहः","दात्यौहः","शकटविलः","शितिकण्ठः","सितकण्ठः"],"जलपक्षी",[]],["n","सेनेगलदेशस्य राजधानी।","डाकारनगरं सेनेगलदेशस्य महिष्ठं नगरम्।",["डाकारनगरम्"],"राजधानी",[]],["n","गुजरातप्रान्ते वर्तमानम् एकं मण्डलम्।","डाङ्गमण्डलस्य मुख्यालयः डाङ्गे वर्तते।",["डाङ्गमण्डलम्"],"मण्डलम्",[]],["n","एकं स्थानम् ।","डाकिन्याः उल्लेखः शिवपुराणे वर्तते",["डाकिनी"],"",[]],["n","एकः जनसमुदायः ।","डाहलस्य उल्लेखः रोमकसिद्धान्ते अस्ति",["डाहलः"],"",[]]],"w":{"डाकिनी":[0,6],"डाय":[1],"डायय":[2],"डाहुकः":[3],"डाहुक":[3],"डाकारनगरम्":[4],"डाकारनगर":[4],"डाङ्गमण्डलम्":[5],"डाङ्गमण्डल":[5],"डाहलः":[7],"डाहल":[7]}}