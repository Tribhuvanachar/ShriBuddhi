{"s":[["n","गजस्य वाहकः।","गजः अङ्कुशग्रहस्य नियन्त्रणात् परे गतः।",["अङ्कुशग्रहः","आधोरणः","हस्तिपकः","इभपः","गजवाहः"],"",["ಮಾವುತ","ಮಾವಟಿಗ","ಕುಜರೋಹ"]],["a","यः धनेन सम्पन्नः।","धनाढ्येन परोपकाराय फलदायिनः वृक्षस्य इव भाव्यम्।",["धनिकः","धनाढ्यः","धनी","धनवान्","सधनः","लक्ष्मीवान्","श्रीमान्","धनेश्वरः","लक्ष्मीशः","इभ्यः","सश्रीकः","कोषवान्"],"",["ಸಿರಿವಂತ","ಶ್ರೀಮಂತ","ಧನವಂತ","ಐಶ್ವರ್ಯವಂತ"]],["n","पशुविशेषः- सः पशुः यः विशालः स्थूलः शुण्डायुक्तः च।","गजाय इक्षुः रोचते।",["गजः","हस्ती","करी","दन्ती","द्विपः","वारणः","मातङ्गः","मतङ्गः","कुञ्जरः","नागः","द्विरदः","इभः"],"पशुः",["ಆನೆ","ಗಜ","ಮದಗಜ","ಕರಿ"]],["n","दन्तविहीनः पुंजातीयः गजशिशुः।","गजयुथस्य अन्ते एकः कारजः मन्दगत्या गच्छति।",["कारजः","कारुजः","वासन्तः","इभपोटा","इभयुवतिः"],"गजः",["ಕೋರೆಗಳಿಲ್ಲದ ಆನೆ","ಕೋರೆಗಳಿಲ್ಲದ-ಆನೆ","ಕೋರೆ ಹಲ್ಲುಗಳಿಲ್ಲದ ಆನೆ","ಕೋರೆ ಹಲ್ಲುಗಳಿಲ್ಲದ-ಆನೆ"]],["n","स्त्रीत्वविशिष्टः गजः।","व्याधात् शावकं मोचयितुं कुञ्जरी आक्रमणम् अकरोत्।",["कुञ्जरी","गजी","पद्मिनी","हस्तिनी","करेणुका","करभी","पुष्करिणी","इभ्या"],"गजः",["ಹೆಣ್ಣಾನೆ","ಹೆಣ್ಣು ಆನೆ","ಹೆಣ್ಣು-ಆನೆ"]],["n","गजस्य मस्तकम्।","हस्तिपकः अङकुशेन करिकुम्भे प्रहरति।",["करिकुम्भः","इभकुम्भः"],"ललाटः",[]],["n","वन्यपशुः , यस्य वक्षो अथ कक्षावलयः,श्लथाश्च लम्बोदरसः त्वग्बृहतीगलश्च पेचकेन सह स्थूला कुक्षिः अस्ति। तथा च यः शुण्डावान् अस्ति।","हया जिहेषिरे हर्षाद् गम्भीरं जगजुः गजाः।",["गजः","हस्ती","करी","दन्ती","द्विपः","वारण-","मातङ्गः","मतङ्गः","कुञ्जरः","नागः","द्विरदः","इभः"],"गजः",[]],["n","मध्यमाकारस्य वृक्षविशेषः।","गजपिप्पल्याः कश्चित् भागः भेषजरूपेण प्रयुज्यते।",["गजपिप्पली","करिपिप्पली","इभकणा","कपिवल्ली","कपिल्लिका","श्रेयसी","वशिरः","गजाह्वा","कोलवल्ली","वसिरः","गजोषणा","चव्यफलम्"],"क्षुपः",[]],["n","सा गजी या स्तनपेन गजेन सह विद्यमाना ।","इभ्या शिशुना सह गच्छति ।",["इभ्या","पिल्लका"],"कुञ्जरी",[]],["n","एकः क्षुपः ।","इभस्य उल्लेखः कोषे अस्ति",["इभः"],"",[]],["n","एकं विषयुक्तं फलम् ।","इभगन्धायाः उल्लेखः कोषे अस्ति",["इभगन्धा"],"",[]]],"w":{"इभपः":[0],"इभप":[0],"इभ्यः":[1],"इभ्य":[1],"इभः":[2,6,9],"इभ":[2,6,9],"इभपोटा":[3],"इभयुवतिः":[3],"इभयुवति":