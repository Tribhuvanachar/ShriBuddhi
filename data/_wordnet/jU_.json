{"s":[["n","शिरो मध्यस्य केशाः।","शिखां निबद्ध आसीनो द्विज आचमनम् चरेत्।",["शिखा","चूडा","केशपाशः","जूटिका","जुटिका","शिखण्डिका"],"केशसमूहः",["ಚಂಡಿಕೆ","ಚಿಂಡಿಕೆ","ತುರಾಯಿ","ಶಿಖೆ"]],["n","आङ्गलसंवत्सरस्य षष्ठः मासः।","जूनमासे मुम्बईनगर्यां वर्षा प्रारभते।",["जूनमासः"],"मासः",["ಜೂನ್"]],["n","परस्परलग्नाः कचाः विशेषतः व्रतिनां शिखा।","गङ्गा शिवस्य जटासु संलग्ना जाता।",["जटा","जटिः","जटी","जूटः","जुटकम्","शटम्","कौटीरम्","जूटकम्","हस्तम्"],"केशसमूहः",["ಜಡೆ","ಜಟ್ಟೆ","ಜಡೆಗಟ್ಟಿನ ಕೂದಲು"]],["n","मुखजातः रसः।","तस्य मुखात् आस्यासवेन सह रुधिरम् अपि आगच्छति।",["आस्यासवः","जाम्बीलम्","जूरी","मुखस्रावः","मुखास्रावः","लाला","लसिका","लासः","ष्ठ्यूतः","सृणीका","स्यन्दनी"],"शारीरिकद्रवः",["ಉಗುಳು","ಜೊಲ್ಲು","ಲಾಲಾರಸ"]],["n","पक्वसागे वर्तमानः रसः।","अस्मिन् सागे सूपः अधिकः अस्ति।",["सूपः","जूवम्","यूषम्","निष्क्वाथः"],"",["ರಸ"]],["n","आम्राणाम् एकः प्रकारः।","जूली-आम्रं वेस्ट इंडीजदेशात् यूरोपखण्डम् आनीयते।",["जूली-आम्रम्"],"आम्रम्",[]],["n","जूली इति नामकानाम् आम्राणां वृक्षः","घानादेशे जूली-आम्रः नवदशतमस्य शतकस्य विशंतिवर्षात् वर्ध्यते।",["जूली-आम्रः"],"आम्रः",[]],["n","गुजरातप्रान्ते वर्तमानम् एकं मण्डलम्।","जूनागढमण्डलस्य मुख्यालयः जूनागढे वर्तते।",["जूनागढमण्डलम्"],"मण्डलम्",[]],["n","गुजरातप्रान्ते वर्तमानम् एकं नगरम्।","नरसीमेहतामहोदयः जूनागढे जातः।",["जूनागढः"],"पुरम्",[]],["n","रोमनजनानाम् ईश्वरः।","वयं जूपिटरस्य दर्शनाय गताः।",["जूपिटरः"],"ईश्वरः",[]],["n","एकः कविः ।","जुतेः उल्लेखः कोषे अस्ति",["जूतिः"],"",[]],["n","एकः क्षुपः ।","जूर्णाह्वस्य उल्लेखः चरकेण कृतः",["जूर्णाह्वः"],"",[]],["n","एकः सर्पः ।","जूर्ण्याः उल्लेखः अथर्ववेदे अस्ति",["जूर्णी"],"",[]]],"w":{"जूटिका":[0],"जूनमासः":[1],"जूनमास":[1],"जूटः":[2],"जूट":[2],"जूटकम्":[2],"जूटक":[2],"जूरी":[3],"जूवम्":[4],"जूव":[4],"जूली-आम्रम्":[5],"जूली-आम्र":[5,6],"जूली-आम्रः":[6],"जूनागढमण्डलम्":[7],"जूनागढमण्डल":[7],"जूनागढः":[8],"जूनागढ":[8],"जूपिटरः":[9],"जूपिटर":[9],"जूतिः":[10],"जूति":[10],"जूर्णाह्वः":[11],"जूर्णाह्व":[11],"जूर्णी":[12]}}