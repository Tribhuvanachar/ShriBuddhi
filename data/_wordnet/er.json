{"s":[["n","क्षुपविशेषः सः क्षुपः यस्मात् तैलं प्राप्यते।","एरण्डस्य फलं कण्टकयुक्तम् अस्ति।",["एरण्डः","अमङ्गलः","अमण्डः","असारः","आमण्डः","आमण्डकः","गन्धर्वहस्तः","चञ्चुः","निधापकः","रुवुः","रूवुकः","वरण्डालुः"],"क्षुपः",["ಔಡಲಗಿಡ","ಔಡಲ ಗಿಡ","ಹುರಳುಗಿಡ"]],["n","एरण्डस्य क्षुपात् प्राप्तं बीजं यस्मात् तैलं तथा च भेषजं प्राप्यते।","एरण्डस्य तैलात् वैद्यः भेषजं निर्माति।",["एरण्डः","अमङ्गलः","अमण्डः","असारः","आमण्डः","आमण्डकः","गन्धर्वहस्तः","चञ्चुः","निधापकः","रुवुः","रूवुकः","वरण्डालुः"],"बीजम्",["ಜಾದಲ","ಜಾಡಲ ಗಿಡ","ಗಿಡ","ಹುರಳುಗಿಡ"]],["n","केरलस्य नगरविशेषः।","भारतस्य एर्णाकुलनगरे सर्वे साक्षराः सन्ति।",["एर्णाकुलनगरम्"],"पुरम्",[]],["n","केरळ-प्रान्ते एकः जिल्हाप्रदेशः","एर्नाकुलम-जिल्हाप्रदेशस्य मुख्यालयः कोची-नगर्याम् वर्त",["एर्नाकुलम-जिल्हाप्रदेशः"],"मण्डलम्",[]],["n","एका नदी ।","एरक्याः उल्लेखः कोषे अस्ति",["एरकी"],"",[]],["n","एकः पुरुषः ।","एरमत्तकस्य उल्लेखः राजतरङ्गिण्याम् अस्ति",["एरमत्तकः"],"",[]]],"w":{"एरण्डः":[0,1],"एरण्ड":[0,1],"एर्णाकुलनगरम्":[2],"एर्णाकुलनगर":[2],"एर्नाकुलम-जिल्हाप्रदेशः":[3],"एर्नाकुलम-जिल्हाप्रदेश":[3],"एरकी":[4],"एरमत्तकः":[5],"एरमत्तक":[5]}}