{"s":[["n","तत् मन्दिरं यत्र जैनधर्मावलम्बीनः पूजापाठं कुर्वन्ति।","जैनसमुदायेन अस्मिन् नगरे विशालं जैनमन्दिरं निर्मितम्।",["जैनमन्दिरम्"],"मन्दिरम्",["ಜೈನ ಮಂದಿರ","ಜೈನ-ಮಂದಿರ"]],["n","सः साधुः यः जैनधर्मम् अनुसरति।","जैनसाधुना स्वस्य प्रवचने अहिंसा पाठिता।",["जैनसाधुः","जैनमुनिः"],"साधुः",["ಜೈನ ಮುನಿ","ಜೈನ-ಮುನಿ","ಜೈನ ಸಾಧು","ಜೈನ-ಸಾಧು"]],["n","जीवसम्बन्धिनी प्रक्रिया।","सः क्षुपाणां जैविकप्रक्रियायाः अध्ययनं करोति।",["जैविकप्रक्रिया"],"प्राकृतिकक्रिया",["ಜೈವಿಕ ಪ್ರಕ್ರಿಯೆ","ಜೈವಿಕ-ಪ್ರಕ್ರಿಯೆ","ಜೈವಿಕಪ್ರಕ್ರಿಯೆ"]],["n","धातुविशेषः, क्रमिकुष्ठनाशकः ओजयुक्तः रसमयः धातुः।","पारदः निखिलयोगवाहकः अस्ति।",["पारदः","रसराजः","रसनाथः","महारसः","रसः","महातेजः","रसलेहः","रसोत्तमः","सूतराट्","चपलः","जैत्रः","रसेन्द्रः"],"धातुः",["ಪಾದರಸ","ಪಾರಜ","ಅಮೃತ","ಸುಧೆ"]],["a","जीवसम्बन्धी।","सः जैविकम् अध्ययनं करोति।",["जैव","जैविक"],"",["ಜೈವಿಕ","ಜೈವ"]],["n","तद् शास्त्रं यस्मिन् जीवानाम् उत्पत्ति-स्वरूप-विकास-विभागादीनां विवेचनं भवति।","मनीषमहोदयः जीवशास्त्रस्य प्रवक्ता अस्ति।",["जीवशास्त्रम्","जैविकी"],"शास्त्रम्",["ಜೀವ ವಿಜ್ಞಾನ","ಜೀವ-ವಿಜ್ಞಾನ","ಜೀವವಿಜ್ಞಾನ","ಜೈವಿಕ ವಿಜ್ಞಾನ"]],["n","भारते वर्तमानः अनिश्वरवादी एकः सम्प्रदायः यः अहिंसा परमः धर्मः अस्ति इति मन्यते।","जैनसम्प्रदायस्य दिगम्बरः तथा च श्वेताम्बरः इति द्वौ भागौ स्तः।",["जैनसम्प्रदायः"],"धर्मः",["ಜೈನ ಧರ್ಮ","ಜೈನ"]],["n","जिनोपासकः","जिनधर्मः एव श्रेष्ठतमः इति जैनाः प्रवदन्ति",["जैनः"],"धर्मानुयायी",["ಜೈನ ಧರ್ಮಾನುಯಾಯಿ"]],["n","जैनानां दर्शनम्।","सः जैनदर्शनस्य अध्ययनं करोति।",["जैनदर्शनम्"],"दर्शनम्",[]],["n","आम्राणाम् एकः प्रकारः।","अद्य मया प्रथमवारं जैक़लिन-आम्रं भुक्तम्।",["जैकलिन-आम्रम्"],"आम्रम्",[]],["n","जैकलिन इति नामकानाम् आम्राणां वृक्षः।","जैकलिन-आम्रः कीटकैः नष्टः।",["जैकलिन-आम्रः"],"आम्रः",[]],["n","राजस्थानप्रान्ते वर्तमानम् एकं मण्डलम्।","जैसलमेरमण्डलस्य मुख्यालयः जैसलमेरनगरे वर्तते।",["जैसलमेरमण्डलम्"],"मण्डलम्",[]],["n","\"राजस्थानप्रान्ते वर्तमानम् एकं नगरम्।","जैसलमेरनगरे वर्तमानं दुर्गम् अधुना पिहितम्।",["जैसलमेरनगरम्"],"पुरम्",["ಜೈಸಲ್ಮೇರ"]],["n","महर्षिविशेषः यः धर्मस्य दर्शनस्य च ज्ञाता आसीत्।","जैमिनिः मीमांसायाः आचार्यः आसीत्।",["जैमिनिः"],"पौराणिकपुरुषः",[]],["n","रागिणीविशेषः।","सङ्गीतकारः जैतश्रीं गायति।",["जैतश्री"],"रागिणी",[]],["n","ज्ञानी ऋषिः।","एकदा जैगीषव्यः तपोबलेन ब्रह्मलोकं जगाम।",["जैगीषव्यः"],"आप्तः",[]],["n","ऋषिविशेषः।","जैमिनिना नैकानि सूक्तानि रचितानि।",["जैमिनिः"],"आप्तः",[]],["n","भारतस्य कश्चन राजवंशः ।","जैसलमेरराजवंशस्य स्थापना भाटीराजा जैसलेन कृता ।",["जैसलमेरराजवंशः"],"राजवंशः",[]],["n","राजविशेषः।","जैसलमैरस्य स्थापना जैसलेन कृता।",["जैसलः"],"नृपः",[]],["n","कस्यापि क्षेत्रविशेषे जीवितस्य तथा च सद्य काले एव मृतः पदार्थः यस्मिन् कौकिलीयम् उदजनम् तथा च प्राणवायुः सन्ति तस्य समस्त द्रव्यमानः ।","वृक्षाणां अविविक्तेन छेदनेन जैविकद्रव्यमानं क्षियते ।",["जैविकद्रव्यमानम्"],"",[]],["n","भोतिकविज्ञानस्य काचित् शाखा यस्यां जैविकप्रक्रियाणां घटनानां वा प्रयोगाः भवन्ति ।","समीरा जैवभौतिक्याः छात्रा अस्ति ।",["जीवभौतिकी","जैविकभौतिकी"],"विज्ञानम्",[]],["n","एकः पुरुषः ।","जैकशून्यस्य उल्लेखः प्रवरग्रन्थेषु अस्ति",["जैकशून्यः"],"",[]],["n","एकः वैद्यकीयाणां विषयाणां लेखकः ।","जैज्जटस्य उल्लेखः भावप्रकाशे अस्ति",["जैज्जटः"],"",[]],["n","एकः पुरुषः ।","जैनपालस्य उल्लेखः कोषे अस्ति",["जैनपालः"],"",[]],["n","एकः वैयाकरणः ।","जैनेन्द्रस्य उल्लेखः कोषे अस्ति",["जैनेन्द्रः"],"",[]],["n","महाभारतस्य आधुनिकं पाठान्तरम् ।","जैमिनिभारतस्य उल्लेखः कोषे अस्ति",["जैमिनिभारतम्"],"",[]],["n","भागवतपुराणस्य आधुनिकं पाठान्तरम् ।","जैमिनीभागवतस्य उल्लेखः कोषे अस्ति",["जैमिनीभागवतम्"],"",[]],["n","सामवेदस्य चरणव्यूहस्य च विद्यालयः ।","जैमिनीयस्य उल्लेखः कोषे अस्ति",["जैमिनीयः"],"",[]]],"w":{"जैनमन्दिरम्":[0],"जैनमन्दिर":[0],"जैनसाधुः":[1],"जैनसाधु":[1],"जैनमुनिः":[1],"जैनमुनि":[1],"जैविकप्रक्रिया":[2],"जैत्रः":[3],"जैत्र":[3],"जैव":[4],"जैविक":[4],"जैविकी":[5],"जैनसम्प्रदायः":[6],"जैनसम्प्रदाय":[6],"जैनः":[7],"जैन":[7],"जैनदर्शनम्":[8],"जैनदर्शन":[8],"जैकलिन-आम्रम्":[9],"जैकलिन-आम्र":[9,10],"जैकलिन-आम्रः":[10],"जैसलमेरमण्डलम्":[11],"जैसलमेरमण्डल":[11],"जैसलमेरनगरम्":[12],"जैसलमेरनगर":[12],"जैमिनिः":[13,16],"जैमिनि":[13,16],"जैतश्री":[14],"जैगीषव्यः":[15],"जैगीषव्य":[15],"जैसलमेरराजवंशः":[1