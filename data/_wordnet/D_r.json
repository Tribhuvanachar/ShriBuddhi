{"s":[["n","आकाशे उत्तरदिशि स्थितः खगोलियपिण्डः यं हिन्दुधर्मीयग्रन्थाः उत्तानपादजः इति मन्यन्ते।","ध्रुवतारा उत्तरस्यां दिशि दृश्यते।",["ध्रुवतारा","ध्रुव","उत्तानपादजः","चित्ररथः"],"तारा",["ದ್ರುವ ನಕ್ಷತ್ರ","ದ್ರುವ","ದ್ರುವ ತಾರೆ","ದ್ರುವ-ತಾರೆ"]],["n","गतिशीलस्य अवस्था भावो वा।","नित्यता जीवनस्य मूलमन्त्रम् अस्ति।",["नित्यता","अविराम","अविरतिः","स्थायित्व","ध्रौव्यम्","अविश्रान्तिः"],"गतिशीलता",["ನಿರಂತರವಾಗಿ","ಎಡೆಬಿಡದೆ","ವಿರಾಮವಿಲ್ಲದೆ","ಸತತವಾಗಿ"]],["n","दार्वादौ चक्रधारणदण्डः।","अक्षस्य भङ्गेन चक्रभङ्गः जायते।",["अक्षः","ध्रुवः"],"",["ಅಚ್ಚು","ಗಾಡಿಯ ಮೊಳೆ"]],["a","यद् निवारितुं न शक्यते।","जातस्य ही मृत्युः ध्रुवः।",["ध्रुव","अनिवार्य"],"",["ಅನಿವಾರ್ಯ","ಅನಿವಾರ್ಯವಾದ","ಅನಿವಾರ್ಯವಾದಂತ","ಅನಿವಾರ್ಯವಾದಂತಹ"]],["n","कस्यापि गीतस्य सा आरम्भिका पङ्क्तिः या पुनः पुनः गीयते।","अहं प्रायः गीतानां ध्रुवपदम् एव जानामि।",["ध्रुवपदम्"],"रचना",["ಮೊದಲ ಸಾಲು","ಆರಂಭದ ಸಾಲು"]],["n","पृथिव्याः द्वौ ध्रुवौ येन कल्पिताक्षेण युज्यते।","मेरुदण्डस्य परितः पृथ्वी परिभ्रमति।",["मेरुदण्डः","अक्षः","ध्रुवयष्टिः"],"धारणा",["ಅಕ್ಷ"]],["a","ध्रुवसम्बन्धी।","ध्रुवीयाः वृक्षाः शुभ्राः सन्ति।",["ध्रुवीय"],"",["ಧ್ರವಪ್ರದೇಶದ","ಧ್ರುವೀಯ"]],["n","गीतप्रकारः यस्य स्वराः निश्चिताः सन्ति।","ध्रुपदेन देवताः स्तूयन्ते।",["ध्रुपदः"],"गीतम्",[]],["n","उत्तानपादनृपतेः पुत्रः यः सुनीतेः जातः।","पञ्चमे वयसि एव ध्रुवः तपः कर्तुं वनं गतवान्।",["ध्रुवः"],"",[]],["n","इक्ष्वाकुवंशीयः राजा।","ध्रुवसन्धिः सुसन्धेः पुत्रः आसीत्।",["ध्रुवसन्धिः"],"पौराणिकपुरुषः",[]],["n","कृष्णस्य पितुः नन्दस्य भ्राता।","ध्रुवनन्दस्य वर्णनं पुराणेषु प्राप्यते।",["ध्रुवनन्दः"],"पौराणिकपुरुषः",[]],["n","कार्तिकेयस्य मातृका।","ध्रुवरत्नायाः वर्णनं पुराणेषु प्राप्यते।",["ध्रुवरत्ना"],"",[]],["n","यज्ञपात्रविशेषः।","पण्डितः ध्रुवां सम्यक् प्रक्षालयति।",["ध्रुवा"],"भण्डम्",[]],["a","छिन्नस्य अथवा शुष्कस्य वृक्षस्य शाखापत्रादिविरहितः भूमिस्थः काण्डाधोभागः।","कृषकः स्थूणां छिनत्ति।",["स्थूणा","स्थाणुः","स्थाणु","ध्रुवः","शङ्कुः","सस्थूणच्छिन्नः","आव्रश्चनः"],"",[]],["a","यद् न विचलति।","अस्य गृहस्य इष्टिकान्यासः सुदृढः अस्ति।",["सुदृढ","दृढ","अटल","अस्खलित","कीकस","ध्रुव","निष्ठित","शूर्ण","सम्बाळ्ह"],"",["ಸದೃಢ","ಗಟ್ಟಿಮುಟ್ಟಾದ"]],["n","पृथिव्याः दक्षिणोत्तरयोः दिशोः विद्यमानौ प्रदेशौ ययोः आधारेण भूमध्यरेखा निर्णीयते ।","एशियाखण्डः उत्तरात् ध्रुवात् आरभ्य भूमध्यरेखां यावत् प्रसृतः अस्ति ।",["ध्रुवम्"],"स्थानम्",[]],["n","संशयस्य अभावः।","असंशयः मनः दृढीकरोति।",["असंशयः","निश्चयः","निश्चितम्","निर्धारणम्","असंदिग्धत्वम्","ध्रुवत्वम्"],"अनुपलब्धिः",[]],["n","सा घटना यस्यां प्रकाशस्य अन्यस्य विकिरणस्य वा किरणाः कम्पनस्य दिशम् अभि प्रतिबध्यन्ते।","बहुतरङ्गग्राहकेन विद्युच्चुम्बकीयानां तरङ्गाणां ध्रुवीकरणं क्रियते।",["ध्रुवीकरणम्"],"घटना",["ಧ್ರುವೀಕರಣ","ಧ್ರುವೀಕರಿಸುವುದು","ಧ್ರುವಿಕೃತವಾಗುವುದು"]],["n","एकं स्थानम् ।","ध्रुवक्षेत्रस्य उल्लेखः कोषे अस्ति",["ध्रवुक्षेत्रम्"],"",[]],["n","एका स्त्री ।","ध्रुवकायाः उल्लेखः बाह्वादिगणे अस्ति",["ध्रुवका"],"",[]],["n","स्कन्दस्य एकः अनुचरः ।","ध्रुवकस्य उल्लेखः महाभारते अस्ति",["ध्रुवकः"],"",[]],["n","एका तारका ।","ध्रुवका इति स्थिरा तारका वर्तते",["ध्रुवका","जयन्ती"],"",[]],["n","एका राजकन्या ।","ध्रुवदेव्याः उल्लेखः कोषे अस्ति",["ध्रुवदेवी"],"",[]],["n","एकः राजपुत्रः ।","ध्रुवपटोः उल्लेखः कोषे अस्ति",["ध्रुवपटुः"],"",[]],["n","एकः लेखकः ।","ध्रुवपालस्य उल्लेखः विवरणपुस्तिकायाम् अस्ति",["ध्रुवपालः"],"",[]],["n","एकः लेखकः ।","ध्रुवानन्दस्य उल्लेखः विवरणपुस्तिकायाम् अस्ति",["ध्रुवानन्दः"],"",[]],["n","ध्रुवानन्दस्य कृतेः टीकाग्रन्थः ।","ध्रुवानन्दमतव्याख्यायाः उल्लेखः कोषे अस्ति",["ध्रुवानन्दमतव्याख्या"],"",[]],["n","एकः राजपुत्रः ।","ध्रुवाश्वस्य उल्लेखः मत्स्यपुराणे अस्ति",["ध्रुवाश्वः"],"",[]],["n","एकः विशिष्टः होमकर्म ।","ध्रुवाश्वस्य उल्लेखः मानव-गृह्यसूत्रे अस्ति",["ध्रुवाश्वः"],"",[]]],"w":{"ध्रुवतारा":[0],"ध्रुव":[0,2,3,8,13,14],"ध्रौव्यम्":[1],"ध्रौव्य":[1],"ध्रुवः":[2,8,13],"ध्रुवपदम्":[4],"ध्रुवपद":[4],"ध्रुवयष्टिः":[5],"ध्रुवयष्टि":[5],"ध्रुवीय":[6],"ध्रुपदः":[7],"ध्रुपद":[7],"ध्रुवसन्धिः":[9],"ध्रुवसन्धि":[9],"ध्रुवनन्दः":[10],"ध्रुवनन्द":[10],"ध्रुवरत्ना":[11],"ध्रुवा":[12],"ध्रुवम्":[15],"ध्रुवत्वम्":[16],"ध्रुवत्व":[16],"ध्रुवीकरणम्":[17],"ध्रुवीकरण":[17],"ध्रवुक्षेत्रम्":[18],"