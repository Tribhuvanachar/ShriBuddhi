{"s":[["n","महिषजातीयः पुमान् पशुः।","सः महिषं हलेन युनक्ति।",["महिषः","लुलापः","सैरिभः","यमाहनः","विषज्वरन्","वंशभीरुः","रजस्वलः","आनूपः","रक्ताक्षः","अश्वारिः","क्रोधी","कलुषः"],"महिषः",["ಕೋಣ"]],["n","लवणप्रकारः यः कृष्णवर्णीयः पाचकः च अस्ति।","सैन्धवं पाचकरूपेण उपयुज्यते।",["सैन्धवम्"],"लवणम्",["ಕಪ್ಪು ಉಪ್ಪು","ಕಪ್ಪುಪ್ಪು","ಕಪ್ಪು ಲವಣ"]],["n","ग्राम्यपशुविशेषः-यः विषाणहीनः चतुष्पादः।","राणाप्रतापस्य अश्वस्य नाम चेतकः इति आसीत्।",["अश्वः","वाजी","हयः","तुरगः","तुरङ्गः","तुरङ्गमः","सैन्धवः","पीतिः","पीती","घोटकः","घोटः","वीतिः"],"",["ಕುದುರೆ","ಅಶ್ವ","ತುರಗ"]],["n","शास्त्रेषु वर्णितः नवग्रहेषु एकः ग्रहः।","भवतः पुत्रस्य जन्मपत्रिकायां सप्तमे स्थाने राहुः अस्ति।",["राहुः","तमः","स्वर्भानुः","सैंहिकेयः","विधुन्तुदः","अस्रपिशाचः","ग्रहकल्लोलः","सैंहिकः","उपप्लवः","शीर्षकः","उपरागः","सिंहिकासूनुः"],"असुरः",["ರಾಹು","ರಾಹು ಗ್ರಹ"]],["n","द्रुपदकन्या या पाण्डवानां पत्नी आसीत्।","द्रौपदी यज्ञात् जाता।",["द्रौपदी","पाञ्चाली","कृष्णा","याज्ञसेनी","त्रिहायणी","वेदिजा","नित्ययौवना","सैरन्ध्री"],"पौराणिकस्त्री",["ದ್ರೌಪದಿ","ಪಾಂಚಾಲಿ","ಕೃಷ್ಣೆ","ನರನಾರಿ"]],["n","सेनायाः वसतिस्थानम्।","एतद् गोरखा रेजीमेंट इति सेनायाः शिबिरः अस्ति।",["शिबिरः","अवस्कन्दः","सेनावासः","सेनास्थानम्","सैन्यम्"],"स्थलम्",["ಶಿಬಿರ","ದಂಡಿನ ಸ್ಥಳ","ಡೇರೆ","ತಂಗುವ ಸ್ಥಳ"]],["n","चोचवृक्षस्य सदृशः वृक्षः यस्य पत्राणि तमालपत्रम् इति नाम्ना ख्यातानि।","तमालकस्य पत्राणि व्यञ्जकरूपेण उपयुज्यन्ते।",["तमालकः","तमालकम्","उत्कटा","त्वक्पत्त्रः","सैंहलम्"],"सदापर्णवृक्षः",["ಬೇ ಎಲೆ","ಬೇ ಮರ"]],["n","निर्जलभूमिः।","उष्ट्रं मरुस्थलस्य नौका इति मन्यते।",["मरुस्थलम्","मरुभूमिः","सैकतम्"],"भूभागः",["ಮರುಭೂಮಿ","ಮರಳುಗಾಡು","ಉಸುಕಿನ ಬೈಲು","ಮಳಲುಭೂಮಿ"]],["n","विशिष्टं कार्यम् उद्दिश्य सैनिकानाम् अथवा तादृशानां केषाञ्चित् दलादीनां यात्रा।","बालचराणां एकः गणः सञ्चलनं करोति।",["सञ्चलनम्","सैन्ययात्रा"],"कर्म",["ಪರೇಡ್"]],["a","यस्मिन् सिकता वर्तते।","वयं पांसुतेन मार्गेण आगताः।",["पांसुल","सैकत","सिकतामय","सिकतावत्","सिकतिल","सिकतोत्तर"],"",["ಮರಳಿನ","ಮರಳಿನಂಥ","ಮರಳಿನಂತಹ"]],["n","यः सैन्याङ्गं भूत्वा युद्धं करोति।","सः शूरः सैनिकः अस्ति।",["सैनिकः","योद्धा","योधः","शस्त्रजीवी","शस्त्रधरः","शस्त्रभृत्","शस्त्रधारी","अस्त्रधरः","अस्त्रधारी","अस्त्रभृत्","युधानः","चमूचरः"],"मनुष्यः",["ಸೈನಿಕ","ಯೋಧ","ಯೋದ್ಧಾ","ರಕ್ಷಕ"]],["n","यः संरक्षणं करोति।","सुरक्षां कर्तुं सीम्नि सैनिकाः सन्ति।",["सैनिकः","परिचरः","रक्षकः"],"मनुष्यः",["ಸೈನಿಕ","ಸಿಪಾಯಿ","ಪಹರೆದಾರ"]],["a","सेनासम्बन्धी।","सैन्यं दलं वने विश्राम्यति।",["सैन्य","सैनिक"],"",["ಸೈನ್ಯ"]],["n","खनिजलवणम्।","सिन्धुजस्य उपयोगः पाचक- चूर्णार्थं क्रियते।",["सिन्धुजः","सैन्धवः"],"लवणम्",["ಸೈಂಧವ ಲವಣ"]],["a","सिन्धप्रदेशसम्बन्धी।","नैके सैन्धवाः जनाः भारतपाकिस्तानयोः विभाजने भारतम् आगताः।",["सैन्धव"],"",["ಸಿಂಧಿ"]],["a","सिद्धान्तसम्बन्धी।","सैद्धान्तिकात् मतभेदात् अग्रे गत्वा अशोकरमेशयोः मध्ये गाढा मित्रता अस्ति।",["सैद्धान्तिक"],"",["ಸೈದ್ಧಾಂತಿಕವಾಗಿ"]],["n","सैनिकेभ्यः दत्तं प्रशिक्षणम्।","नवनियुक्तेभ्यः सैनिकेभ्यः सैन्यप्रशिक्षणं दीयते।",["सैन्यप्रशिक्षणम्"],"प्रशिक्षणम्",["ಸೈನಿಕರ ತರಬೇತಿ","ಮಿಲಿಟರಿ ತರಬೇತಿ"]],["n","सैनिकानाम् अभ्यासार्थे प्रयाणार्थे वा संघटितरित्या ताल-बद्ध-पद-विन्यासः","अस्मिन् प्राङ्गणे सैनिकानाम् अभिषेणम् प्रचलति",["अभिषेणम्","सैनिकगमनम्","सैनिकयात्रा"],"शारीरिकक्रिया",["ಸಮಹೆಜ್ಜೆ","ನಡಗೆ","ಏಕರೀತಿಯ ನಡಿಗೆ","ಮೆರವಣಿಗೆ"]],["n","एका रागिणी।","सैन्धवी सम्पूर्णजातेः एका रागिणी आसीत्।",["सैन्धवी"],"रागिणी",[]],["a","सिकतया युक्तः।","माता सैकतान् तण्डुलान् मार्जयति।",["सैकत"],"",["ಹರಳುಗಳುಳ್ಳ","ಹರಳುಗಳುಳ್ಳಂತ","ಹರಳುಗಳುಳ್ಳಂತಹ","ಉಸುಕಿನ"]],["n","सेनायाः निवासस्थानम्।","इतः बहवः सैन्यावासाः रिक्ताः।",["सैन्यावासः","योधागारः"],"गृहम्",[]],["n","आम्राणाम् एकः प्रकारः।","मह्यं सैगॉन-आम्रं बहु न रोचते।",["सैगॉन-आम्रम्"],"आम्रम्",[]],["n","सैगॉन इति नामकानाम् आम्राणां वृक्षः।","सैगॉन-आम्रे बहवः रक्ताः पिपीलिकाः चलन्ति।",["सैगॉन-आम्रः"],"आम्रः",[]],["a","यस्मिन् शर्करा मिश्रिता।","प्रमेहस्य रोगिणा शार्करीयाणां पदार्थानां सेवनं न कर्तव्यम्।",["शार्कर","सैक्षव"],"",["ಸಕ್ಕರೆ","ಸಕ್ಕರೆಯುಕ್ತವಾದ","ಸಕ್ಕರೆಯುಕ್ತವಾದಂತ","ಸಕ್ಕರೆಯುಕ್ತವಾದಂತಹ"]],["a","समुद्रात् उत्पन्नः।","सः शङ्खाः मौक्तिकाः इत्येतेषां समुद्रियाणां वस्तूनां व्यापारं करोति।",["समुद्रिय","समुद्रज","सामुद्र","सागर","सामुद्रिक","अब्धिज","सैन्धव","जलोद्भव","जलधिसम्भव","सिन्धुक"],"",["ಸಾಗರೋತ್ಪನ್ನ"]],["n","एल-साल्वाडोरदेशस्य राजधानी।","सैन-सल्वाडोरनगरे पुनः पुनः भूकम्पस्य प्रकोपः भवति।",["सैन-सल्वाडोरनगरम्"],"राजधानी",[]],["n","डोमोनिका-गणतन्त्रस्य राजधानी।","सर्वप्रथमं सैन्टो-डोमिङ्गोनगरे युरोपखण्डस्य निवासिनः आगताः।",["सैन्टो-डोमिङ्गोनगरम्"],"राजधानी",[]],["n","पशुविशेषः यस्य स्त्रीत्वविशिष्टः पशुः दुग्धार्थं पाल्यते पुंजातीयश्च भारवहनार्थम् उपयुज्यते।","सः नैकान् महिषान् पालयति।",["महिषः","रक्ताश्वः","अश्वारिः","लुलापः","वाहद्विषा","कासरः","सैरिभः","यमवाहनः","विषज्वरा","वंशभीरुः","रजस्वलः","आनूपः"],"पशुः",[]],["n","सेनायाम् उच्चपदे नियुक्तः अधिकारी।","प्रधानमन्त्री अद्य काश्मिरे कैश्चित् सैन्याधिकारीभिः अमिलत्।",["सेनाधिकारी","सैन्याधिकारी"],"अधिकारी",["ನೈನ್ಯಾಧಿಕಾರಿ","ಸೈನ್ಯ ಅಧಿಕಾರಿ"]],["n","दक्षिणकैलिफोर्नियादेशे वर्तमानम् एकं रम्यं नगरम्।","सैनडिएगोनगरस्य प्राकृतिकी शोभा मनोहारिणी।",["सैनडिएगोनगरम्"],"पुरम्",["ಸೈನ ಡಿಏಗೊ"]],["n","अमेरिकादेशस्य केलिफोर्नियाराज्ये वर्तमानं नगरम् ।","अमेरिदेशस्य प्रमुखेषु औद्योगिकेषु परिवहनकेन्द्रेषु च एकः सैन-फ्रान्सिस्कोनगरम् अस्ति ।",["सैन-फ्रान्सिस्कोनगरम्"],"पुरम्",["ಸೆನ್ ಫ್ರಾಂಸಿಸ್ಕೂ"]],["n","तद् स्थानं यस्मात् स्थलसेनायाः सञ्चालनं भवति ।","सैनिक-आस्थानस्य समीपे सुरक्षाव्यवस्था अस्ति ।",["सैनिक-आस्थानम्"],"",["ಮಿಟಿಟರಿ ದಳದ ಸಂಚಾಲನ ಕೇಂದ್ರ"]],["n","एकः आचार्यः ।","सैन्धवस्य उल्लेखः कोशे वर्तते",["सैन्धवः"],"",[]]],"w":{"सैरिभः":[0,27],"सैरिभ":[0,27],"सैन्धवम्":[1],"सैन्धव":[1,2,13,14,24,32],"सैन्धवः":[2,13,32],"सैंहिकेयः":[3],"सैंहिकेय":[3],"सैंहिकः":[3],"सैंहिक":[3],"सैरन्ध्री":[4],"सैन्यम्":[5],"सैन्य":[5,12],"सैंहलम्":[6],"सैंहल":[6],"सैकतम्":[7],"सैकत":[7,9,19],"सैन्ययात्रा":[8],"सैनिकः":[10,11],"सैनिक":[10,11,12],"सैद्धान्तिक":[15],"सैन्यप्रशिक्षणम्":[16],"सैन्यप्रशिक्षण":[16],"सैनिकगमनम्":[17],"सैनिकगमन":[17],"सैनिकयात्रा":[17],"सैन्धवी":[18],"सैन्यावासः":[20],"सैन्यावास":[20],"सैगॉन-आम्रम्":[21],"सैगॉन-आम्र":[21,22],"सैगॉन-आम्रः":[22],"सैक्षव":[23],"सैन-सल्वाडोरनगरम्":[25],"सैन-सल्वाडोरनगर":[25],"सैन्टो-डोमिङ्गोनगरम्":[26],"सैन्टो-डोमिङ्गोनगर":[26],"सैन्याधिकारी"