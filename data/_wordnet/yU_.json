{"s":[["n","मेषादिद्वादशराश्यान्तर्गतः सप्तमः राशिः स च चित्रीशेषपादद्वयस्वातीसमुदाययुक्तविशाखाप्रथमपादत्रयेण भवति।","तुलायाः चिह्नं तुला एव अस्ति।",["तुला","तुलाराशिः","यूकः","युक्","धटः","तौली","तुलाभृत्।"],"राशिः",["ತುಲಾ","ತುಲಾ ರಾಶಿ","ತುಲರಾಶಿ"]],["n","वृक्षविशेषः यस्य फलानि मिष्टानि सन्ति।","तूतस्य अदनार्थे वयं तूते आरोहामः।",["तूतः","तूदः","यूपः","क्रमुकः","ब्रह्मभागः","ब्राह्मणेष्टः","ब्रह्मनिष्ठः","ब्रह्मस्थानः","सुरूपः","यूषः","नूदः","पूषः"],"वृक्षः",["ನೇರಿಳೆ","ನೇರಳೆ","ನೇರಳೆಹಣ್ಣು"]],["n","मध्यमाकारवतः तूतवृक्षस्य फलम्।","बालकाः तूदान् अदन्ति।",["तूदः","क्रमुकः","यूपः"],"खाद्यफलम्",["ನೇರಳೆ","ನೇರಿಳೆ","ನೇರಳೆ ಹಣ್ಣು","ನೇರಿಳೆ ಹಣ್ಣು"]],["n","यूनानदेशस्य वासी।","प्राचीने काले यूनानीयैः विश्व स्वस्य वीरतायाः प्रदर्शनं कृतम्।",["यूनानीय"],"निवासी",["ಯುನಾನಿ","ಯುನಾನಿವಾಸಿ","ಯುನಾನಿ-ವಾಸಿ","ಗ್ರೀಕ್"]],["n","यूनानानाम् भाषा।","श्यामः युनानीभाषायां व्यवहरति।",["यूनानी-भाषा"],"भाषा",["ಯೂನಾನಿ","ಯೂನಾನೀ-ಭಾಷೆ","ಯೂನಾನೀ ಭಾಷೆ","ಗ್ರೀಕ್ ಭಾಷೆ"]],["n","पुष्पप्रकारः।","मालिकः पुष्पवाटिकया कुन्दानि तथा च अन्यानि अपि पुष्पाणि आनयति।",["कुन्दम्","यूथिका","शङ्खधवला"],"पुष्पम्",["ಸಣ್ಣ ಜಾಜಿ ಮಲ್ಲಿಗೆ","ಜಾಜಿ ಮಲ್ಲಿಗೆ"]],["n","शिलाकाष्ठादिभिः विनिर्मिता वर्तुलाकारा चतुष्कोणयुक्ता वा उन्नताकृतिः।","स्तम्भात् नरसिंहः आगतः।",["स्तम्भः","स्थूणा","यूपः","यूपम्","यष्टिः"],"मानवकृति",["ಕಂಬ","ಸ್ತಂಭ","ಆಧಾರ","ಆಸರೆ"]],["n","मनुष्याणां केशाम्बराश्रया कीटः।","नागवल्लीद्रनयलेपनेन मौलौ यूका पतन्ति।",["यूका","केशकीटः"],"कीटकः",["ಹೇನು","ಯೂಕ"]],["n","यूरोपमहाद्विपान्तर्गतं राष्ट्रम्।","रुसपोलण्डादयः यूरोपीयदेशाः सन्ति।",["यूरोपीयदेशः","यूरोपीयराष्ट्रम्"],"देशः",["ಯುರೋಪಿಯ ದೇಶ","ಯುರೋಪ್ ರಾಷ್ಟ್ರ"]],["n","प्राप्तयौवना स्त्री। (प्राग् यौवना युवतिः इति वात्स्यायनः।)","यो यं विचिन्तयति यानि स तन्मयत्वम्। यस्स्माद् अतः सुभगया इव गता युवत्यः॥",["युवती","युवतिः","तरुणी","यूनी","तलुनी","दिक्करी","धनिका","धनीका","मध्यमा","दृष्टरजाः","मध्यमिका","ईश्वरी"],"स्त्री",["ಯುವತಿ","ತರುಣಿ"]],["n","पक्वसागे वर्तमानः रसः।","अस्मिन् सागे सूपः अधिकः अस्ति।",["सूपः","जूवम्","यूषम्","निष्क्वाथः"],"",["ರಸ"]],["n","स्वेदे मले वा उद्भवः केशाम्बराश्रयः कीटकः।","यूकाः कण्डूगण्डान् जनयन्ति।",["यूकाः","लोमकीटः","केशकीटः","स्वेदजः"],"कीटकः",["ಉಣ್ಣೆ","ಉಣ್ಣಿ"]],["n","स्तम्भविशेषः, युद्ध-विजय-स्मृत्यर्थं सम्पन्नयाग-स्मृत्यर्थं वा उद्धृतः स्तम्भः।","संग्राम-निर्विष्ट-समस्रबाहुः कार्तवीर्यः  अष्टादशद्वीपेषु यूपान् निखातवान्।",["यूपः","जयस्तम्भः","यागस्तम्भः"],"स्तम्भः",["ಜಯಸ್ಥಂಭ","ಜಯ-ಸ್ಥಂಭ","ಜಯ ಸ್ಥಂಭ","ವಿಜಯಸ್ಥಂಭ"]],["n","सजातीयानां पश्वादीनां एकस्थले दृश्यमाणः समूहः।","तत्र कुञ्जरयूथानि मृगयूथानि चैव हि। विचरन्ति वनान्तेषु तानि द्रक्ष्यसि राघव॥",["युथः","यूथम् (प्राचीनभाषायाम् एव)"],"वस्तुः",["ಸಮೂಹ","ಗುಂಪು","ಮಂದೆ"]],["n","पृथिव्याः पूर्वदिशि वर्तमानेषु गोलार्धेषु लघु महाद्वीपम्।","ब्रिटन-जर्मनी-फ्रान्स-इटली इत्यादीनां देशानाम् अन्तर्भावः यूरोपखण्डे भवति।",["यूरोपखण्डः"],"महाद्वीपम्",["ಯುರೋಪ್","ಯೂರೋಪ್"]],["n","यायावरैः विक्रयणाय नीयमानः पशूनां समूहः।","पूर्वं यायावराः यूथ्यया सह गच्छन्ति स्म।",["यूथ्या","समितिः","कुल्मिः","गणः","व्रजः","सार्थः","यूथम्","कदम्बम्","कदम्बकम्","कुलम्","पाशवम्"],"युथः",[]],["n","देशविशेषः, युरोपखण्डे दक्षिणप्राच्यां दिशि वर्तमानः देशः।","पृथ्विं विजिगीषुः अलक्षेन्द्रः यवनदेशात् ससैन्यं प्रययौ।",["यवनदेशः","यूनानदेशः","ग्रीसदेशः"],"यूरोपीयदेशः",[]],["n","यूकायाः अण्डम्।","तस्याः केशेषु लिक्षाः जाताः।",["लिक्षा","लिक्षिका","दिङ्क","रिक्षा","यूकाण्डम्"],"अण्डम्",["ಸೀರು","ಹೇನಿನ ಮೊಟ್ಟೆ","ಹೇನಿನ ತತ್ತಿ"]],["n","एकः राक्षसः।","यूपाक्षः रावणस्य सेनायां महत्वपूर्णे पदे आसीत्।",["यूपाक्षः"],"असुरः",[]],["n","सः स्तम्भः यस्मिन् यज्ञीयः पशुः बध्यते।","यज्ञस्थलस्य समीपे यूपे बद्धः अजः रेभते।",["यूपः"],"स्तम्भः",[]],["n","यूपस्य सः भागः यस्मिन् घृतस्य लेपनं भवति।","मन्त्राणाम् उच्चारणं कुर्वन् एव अर्चकः  यूपकर्णं घृतादिभिः लिम्पति।",["यूपकर्णः"],"वस्तुभागः",[]],["n","तत् कृत्यं यत् यज्ञस्य समीपं यूपस्य स्थापनानन्तरं क्रियते।","यूपाहुतेः अनन्तरम् अजः यूपेन बद्धः।",["यूपाहुतिः"],"धर्म-कर्म",[]],["n","पर्वतविशेषः।","यूरालः रुष्यदेशस्य प्रतीच्यां दिशि अस्ति।",["यूरालः"],"कुलपर्वतः",[]],["n","जातिविशेषस्य वन्यस्तनपायिनां समुदायः।","सङ्घात् बहिः गतः मृगशावकः वृकेन घातितः।",["सङ्घः","यूथ","गणः"],"युथः",[]],["n","संयुक्तराष्ट्रसङ्घेन स्थापिता सङ्घटना।","संयुक्त-राष्ट्र-शैक्षिक-वैज्ञानिक-सांस्कृतिकी सङ्घटना राष्ट्रे राष्ट्रे शिक्षायाः तथा च कलायाः प्रसारार्थे यतते।",["संयुक्त-राष्ट्र-शैक्षिक-वैज्ञानिक-सांस्कृतिकी सङ्घटना","यूनेस्को"],"संस्था",["ಯುನೆಸ್ಕೋ"]],["n","युरोपखण्डस्य सप्तविंशतेः राष्ट्राणाम् एकः राजनैतिकः आर्थिकः सङ्घः यस्मिन् परस्परेषु प्रशासकीया संविभागिता वर्तते या सर्वान् प्रति समाना भवति।","यूरोपीयसङ्घस्य आरम्भः 1957 तमे वर्षे जातः।",["यूरोपीयसङ्घः"],"सङघः",["ಯೂರೋಪಿಯ ಸಭೆ","ಯೂರೋಪಿಯ ಸಮೂಹ","ಯೂರೋಪಿಯ ದಲ","ಯೂರೋಪಿಯ ಸಮಿತಿ"]],["n","भारतदेशे वर्तमानः एकः प्रमुखः वित्तकोषः।","यूको-बैन्क इति वित्तकोषस्य कार्यालयः मुम्बईनगर्याम् अस्ति।",["यूको-बैङ्क"],"वित्तकोषः",["ಯೂಕೋ ಬ್ಯಾಂಕ್"]],["n","एका राजकन्या ।","यूकदेव्याः उल्लेखः राजतरङ्गिण्याम् अस्ति",["यूकदेवी"],"",[]],["n","एकः दानवः ।","यूपकेशिनः उल्लेखः मानव-गृह्य-सूत्रे अस्ति",["यूपकेशी"],"",[]]],"w":{"यूकः":[0],"यूक":[0],"यूपः":[1,2,6,12,19],"यूप":[1,2,6,12,19],"यूषः":[1],"यूष":[1,10],"यूनानीय":[3],"यूनानी-भाषा":[4],"यूथिका":[5],"यूपम्":[6],"यूका":[7,11],"यूरोपीयदेशः":[8],"यूरोपीयदेश":[8],"यूरोपीयराष्ट्रम्":[8],"यूरोपीयराष्ट्र":[8],"यूनी":[9],"यूषम्":[10],"यूकाः":[11],"यूथम् (प्राचीनभाषायाम् एव)":[13],"यूरोपखण्डः":[14],"यूरोपखण्ड":[14],"यूथ्या":[15],"यूथम्":[15],"यूथ":[15,23],"यूनानदेशः":[16],"यूनानदेश":[16],"यूकाण्डम्":[17],"यूकाण्ड":[17],"यूपाक्षः":[18],"यूपाक्ष":[18],"यूपकर्णः":[20],"यूपकर्ण":[20],"यूपाहुतिः":[21],"यूपाहुति":[21],"यूरालः":[22],"यूराल":[22],"यूनेस्को":[24],"यूरोपीयसङ्घः":[25],"यूरोपीयसङ्घ":[25],"यूको-बैङ्क":[26],"यूकदेवी":[27],"यूपकेशी":[28]}}