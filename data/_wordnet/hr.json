{"s":[["n","तत् स्थानं यत्र जलं सम्भृतं वर्तते|","ह्रदे कमलानि विलसन्ति।",["ह्रदः","जलाशयः","जलाधारः","जलाकरः"],"स्थलम्",["ಅಣೆಕಟ್ಟು","ಜಲಾಶಯ"]],["n","अल्पकालमात्रः स्वरः।","अ इति ह्रस्वस्वरः।",["ह्रस्वस्वरः","ह्रस्वः"],"स्वरः",["ಹ್ರಸ್ವ ಸ್ವರ","ಹ್ರಸ್ವ"]],["a","यस्य आयुः अल्पकालिकः।","श्वानः मनुष्यस्य अपेक्षया अल्पायुः अस्ति।",["अल्पायु","अल्पायू","ह्रसितायु","अल्पवया","अल्पकालिक","अचिरजीवी"],"",["ಅಲ್ಪಾಯು","ಅಲ್ಪಾಯುಷಿ","ಅಲ್ಪಕಾಲೀಕ","ಕ್ಷಣಭಂಗುರ"]],["n","जलस्य आधारः।","तडागे नैकानि चित्राणि कमलानि सन्ति।",["तडागः","सरोवरः","जलाशयः","जलाधारः","सरस्","ह्रदः","खातम्"],"ह्रदः",["ಆಣೆಕಟ್ಟು","ಜಲಾಶಯ","ಡ್ಯಾಮ್"]],["n","लघुः जलाशयः।","सः तडागे मत्स्याघातं करोति।",["तडागः","सरठः","ह्रदः","सरोवरम्","सरोवरः","कासारः","मीनगोधिका"],"तडागः",["ಕೊಳ"]],["a","यः स्वभावतः लज्जावान् अस्ति।","शालीनः लज्जावशात् स्वकीयं मतं कथयितुम् असमर्थः भवति।",["शालीन","लज्जाशील","संविग्न","ह्रीण","ह्रीत","ह्लीकु","शारद","पलङ्कट","भीरुभीरु"],"",["ಲಜ್ಜಾಶೀಲ","ನಾಚಿಕೆಯ","ಸಂಕೋಚದ","ಸಿಗ್ಗಾದ"]],["v","वस्तुगततत्त्वानां न्यूनीभवनानुकूलः व्यापारः।","निरन्तरं चलनेन ऊर्जा ह्रसते।",["ह्रस्","क्षि","अल्पय","अल्पीभू","अपहा","परिहा"],"क्षि",["ಕಡಿಮೆಯಾಗು","ಕಡಿಮೆ ಆಗು","ಕೊರತೆಯೊಂದು","ಕುಸಿ"]],["n","न्यूनीभवनस्य क्रिया भावो वा।","विद्युतः सम्यक् प्रयोगात् देयकस्य अल्पीभावः भवति।",["अल्पीभावः","प्रत्यवायः","ह्रासः","उपक्षयः","अपचयः","परिहानिः","परिहाणिः"],"कर्म",["ಕಡಿಮೆ","ಕಡಮೆ","ಇಳಿತ","ಇಳಿಮೆ"]],["v","लज्जाप्रकटीकरणानुकूलव्यापारः।","अभ्यागतात् त्रपते सा।",["त्रप्","लज्ज्","विलज्ज्","संलज्ज्","व्रीड्","ह्री"],"आविष्कृ",["ನಾಚಿಸು","ನಾಚು","ನಾಚಿಕೆಪಡು","ಸಂಕೋಚ ಪಡು"]],["v","कस्माद् अपि वस्तुनः कस्याः अपि संङ्ख्यायाः वा तदवयवभूतस्य अंशस्य क्षयात्मकः व्यापारः।","शासनेन दैनंदिने व्यवहारे ये वस्तूनि आवश्यकानि तेषां मूल्यानि न्यूनीकृतानि।",["न्यूनीकृ","अल्पीकृ","अल्पय्","ऊनीकृ","लघूकृ","ऊन्","ह्रस्","लघ्"],"कृ",["ಕಡಿಮೆ ಮಾಡು","ಕಡಿಮೆಗೊಳಿಸು"]],["n","सः नाशः यः मन्दगत्या भवति।","वृद्धावस्थायां स्मरणशक्तेः ह्रासः भवति।",["ह्रासः","क्षयः","अपचयः"],"क्रिया",["ಕೊಳೆತ","ಕ್ಷಯ","ಜೀರ್ಣತೆ"]],["v","लज्जाप्रेरणानुकूलः व्यापारः।","सः माम् सर्वेषां पुरतः ह्रेपयति।",["ह्रेपय","व्रीडय","लज्जय"],"कृ",["ನಾಚಿಸು","ಲಜ್ಜಿಸು","ನಾಚಿಕೆ ಪಡಿಸು"]],["n","जलस्य आशयः विशिष्य प्राकृतिकः।","सः ह्रदे स्नानं करोति।",["ह्रदः","सरस्","जलाशयः","जलाधारः","सरोवरः","सरोवरम्","सरसी","तडागः","कासारः","खातम्","अखातम्"],"ह्रदः",["ಸರೋವರ","ಉಪಸಾಗರ","ಕೊಳ","ಸರಸ್ಸು"]],["v","कस्यापि वस्तुनः कार्यस्य वा विनाशनानुकूलः व्यापारः।","तस्य व्यापारः अह्रासयत्।",["ह्रासय","अपकृष्","दूषय","विकृ","प्रदूषय","सम्प्रदूषय"],"अस्",["ಮುಳುಗು","ಹಾಳಾಗು"]],["a","लज्जाव्यापाराश्रयः।","सः स्वस्य कार्येण लज्जितः अस्ति।",["लज्जित","ह्रीण","ह्रीत"],"",["ಲಜ್ಜಿತ","ನಾಚಿದ","ತಲೆತಗ್ಗಿಸಿದ"]],["n","पृथिव्याः वायुमण्डलस्थायाः वैद्युतायाः ऊर्जायाः उत्सर्गः यद् मेघानां घर्षणात् प्रादुर्भवति तथा च आकाशे प्रकाशं तथा च घोषध्वनिं जनयति।","आकाशे विद्युत् देदीप्यते।",["विद्युत्","तडित्","वज्रस्फुलिङ्गः","शम्पा","शतह्रदा","ह्रादिनी","ऐरावती","क्षणप्रभा","तडित्","सौदामिनी","चञ्चला","चपला"],"प्रकाशः",["ಮಿಂಚು"]],["v","स्वस्य पापकर्मणः कारणात् [उत्पन्ना]लज्जानुकूलः व्यापारः।","स्तेये निगृहीते श्यामः अलज्जत।",["लज्ज्","व्रीड्","ह्री","त्रप्"],"आविष्कृ",["ಲಜ್ಜೆಗೊಳ್ಳು","ನಾಚಿಕೆಪಟ್ಟುಕೊ","ತಲೆ ತಗ್ಗಿಸು"]],["n","अन्तःकरणवृत्तिविशेषः दोषसङ्कोचादिवशात् वक्तुं वा द्रष्टुं न शक्यते।","लज्जया सा वक्तुं न शक्नोति।",["लज्जा","मन्दाक्षम्","ह्रीः","त्रपा","व्रीडा","मन्दास्यम्","लज्या","व्रीडः","व्रीडनम्"],"",["ಲಜ್ಜೆ","ನಾಚಿಕೆ","ಸಂಕೋಚ"]],["n","विनयेन युक्तः व्यवहारः।","अधिकारी नम्रतया अस्माकं वचनम् अश्रृणोत्।",["नम्रता","ह्रीतिः","शालीनता","विनयता","सुवृत्तिः","विनीतता","नाभिमानः","विनीतत्वम्"],"व्यवहारः",["ವಿನೀತತೆ","ವಿನಯ","ನಮ್ರತೆ"]],["n","अश्वस्य नादः।","हेषां श्रृत्वा अश्वपालः अश्वशालां प्रति अधावत्।",["हेषा","हेषारवः","हेषितम्","ह्रेषा","ह्रेषितम्","अश्वनादः","स्वनः"],"बृंह्",["ಹೇಕರಿಸುವಿಕೆ","ಕೆನೆಯುವಿಕೆ"]],["a","त्रपा इति शीलं यस्य।","मोहनः अतीव अपत्रपिष्णुः अस्ति।",["अपत्रपिष्णु","अनूढमान","व्रीडित","सव्रीड","ह्रीमत्","ह्लीक","ह्रीण","सव्यपत्रप","लज्जावत्","लज्जाशील","लज्जालु"],"",["ಸಂಕೋಚ","ಲಜ್ಜೆಯ","ಅಳುಕಿನ","ನಾಚಿಕೆಯ"]],["n","एका बहुवर्षीया वनस्पतिः।","शुकफलस्य पत्राणि विषमयानि भवन्ति।",["शुकफलः","विक्षीरः","राजार्कः","सूर्यलता","रविप्रियः","प्रतापः","ह्रस्वाग्निः","सूर्यपत्रः","आस्फोतकः","शीतपुष्पकः","रश्मिपतिःदिवाकरः","सूरः"],"वृक्षः",[]],["a","यस्य ह्रासः भवति।","तयोः ह्रासकं सख्यं दृष्ट्वा अहं दुःखितः जातः।",["ह्रासक"],"",["ತಗ್ಗುತ್ತಿರುವ","ತಗ್ಗಿದಂತಹ","ತಗ್ಗುವಂತಹ","ಅವನತಿಯ"]],["n","दक्षप्रजापतेः कन्या।","ह्र्याः वर्णनं पुराणेषु प्राप्यते।",["ह्री"],"पौराणिकस्त्री",[]],["n","औषधीयः क्षुपविशेषः।","नागबला पुरुषस्य कामशक्तिं वर्धयति।",["नागबला","गाङ्गेरुकी","ह्रस्वगवेधुका","गाङ्गेरुही","गोरक्षतण्डुला","भद्रोदनी","खरगन्धा","चतुःपला","महोदया","महापत्रा","महाशाखा","महाफला"],"",[]],["n","यस्य उच्चारणम् एकमात्रिकं भवति ।","हिन्दीभाषायाम् अ, इ, उ इत्यादयः स्वराः ह्रस्वाः सन्ति ।",["ह्रस्व","लघु"],"",["ಹ್ರಸ್ವ"]],["n","क्षुपनामविशेषः ।","ह्रस्वः इति नैकेषां क्षुपाणां नाम वर्तते",["ह्रस्वः"],"",[]],["n","एकः राजपुत्रः ।","ह्रीनिषेवस्य उल्लेखः कोषे अस्ति",["ह्रीनिषेवः"],"",[]]],"w":{"ह्रदः":[0,3,4,12],"ह्रद":[0,3,4,12],"ह्रस्वस्वरः":[1],"ह्रस्वस्वर":[1],"ह्रस्वः":[1,26],"ह्रस्व":[1,25,26],"ह्रसितायु":[2],"ह्रीण":[5,14,20],"ह्रीत":[5,14],"ह्रस्":[6,9],"ह्रासः":[7,10],"ह्रास":[7,10],"ह्री":[8,16,17,23],"ह्रेपय":[11],"ह्रासय":[13],"ह्रादिनी":[15],"ह्रीः":[17],"ह्रीतिः":[18],"ह्रीति":[18],"ह्रेषा":[19],"ह्रेषितम्":[19],"ह्रेषित":[19],"ह्रीमत्":[20],"ह्रस्वाग्निः":[21],"ह्रस्वाग्नि":[21],"ह्रासक":[22],"ह्रस्वगवेधुका":[24],"ह्रीनिषेवः":[27],"ह्रीनिषेव":[27]}}