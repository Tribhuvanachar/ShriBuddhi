{"s":[["d","प्रकृतम् एव।","भोः, विस्मृतवान् खलु भवतः नाम।",["खलु","नूनम्","सत्यम्","अर्थतः","तत्वतः","वस्तुतः","अव्यलीकम्","यथार्थम्","तत्त्वेन","यथातथम्","यथार्थतः","परमार्थतः"],"",["ನಿಜ ಹೇಳಬೇಕೆಂದರೆ","ವಾಸ್ತವದಲ್ಲಿ","ವಾಸ್ತವವಾಗಿ","ಅಸಲು"]],["n","धातुभिः विनिर्मितं सा गुटिका या मधुरं शब्दायते।","बालकस्य कट्यां मञ्जीरः शोभते।",["मञ्जीरः","नूपुरः"],"मानवकृति",["ಗೆಜ್ಜೆ","ಕಿರುಗಂಟೆ","ನೂಪುರ","ಕಾಲಂದುಗೆ"]],["n","अलङ्कारविशेषः, पादभूषणम्।","गुणवानपि मौखर्यात् पादे लुठति नूपुरः हारस्तु मूकभावेन कण्ठवल्लभतां गतः।",["नूपुरम्","पादाङ्गदम्","तुलाकोटिः","मञ्जीरः","हंसकः","पादकटकः"],"पादाभूषणम्",["ಕಾಲಿನ ಕಡಗ","ಕಾಲಿನ ಬಳೆ","ಕಾಲೊಂದಿಗೆ","ನೂಪುರ"]],["a","वर्तमानसम्बन्धि।","आधुनिकः भारतीयसमाजः भ्रष्टाचारम् अनुसरति।",["आधुनिक","अद्यतनीय","इदानीतन","नवीन","नूतन","साम्प्रतिक"],"",["ಆಧುನಿಕ","ಆಧುನಿಕವಾದ","ಆಧುನಿಕವಾದಂತ","ಆಧುನಿಕವಾದಂತಹ"]],["a","अपुरातनं वस्तु।","रोबोट इति नूतना सङ्कल्पना।",["नूतन","नवीन","नव"],"",["ಹೊಸದಾದ","ಹೊಸದಾದಂತ","ಹೊಸದಾದಂತಹ","ನವೀನವಾದ"]],["n","वृक्षविशेषः यस्य फलानि मिष्टानि सन्ति।","तूतस्य अदनार्थे वयं तूते आरोहामः।",["तूतः","तूदः","यूपः","क्रमुकः","ब्रह्मभागः","ब्राह्मणेष्टः","ब्रह्मनिष्ठः","ब्रह्मस्थानः","सुरूपः","यूषः","नूदः","पूषः"],"वृक्षः",["ನೇರಿಳೆ","ನೇರಳೆ","ನೇರಳೆಹಣ್ಣು"]],["n","पादालङ्कारः यः शब्दायते।","वध्वाः आगमनस्य सूचना तस्याः नूपुराणि ददाति।",["नूपुरम्","पादाङ्गदम्","तुलाकोटिः","मञ्जीरः","हंसकः","पादकटकः","पदाङ्गदम्"],"पादाभूषणम्",["ಗೆಜ್ಜೆ"]],["n","समयस्य समाप्तेः अनन्तरं तस्य वैधीकरणस्य क्रिया।","मम परिचयपत्रं नूतनीकरणाय दत्तम् अस्ति।",["नूतनीकरणम्"],"विकारः",["ನವೀಕರಣ","ನವೀಭವನ","ಹೊಸದಾಗಿಸುವಿಕೆ"]],["a","नूतनीकर्तुं योग्यः।","एतद् पारपत्रं नूतनीकरणीयं भवति।",["नूतनीकरणीय","नवीनीकरणीय"],"",["ನವೀಕರಿಸಬಹುದಾದ","ನವೀಕರಿಸಬಹುದಾದಂತ","ನವೀಕರಿಸಬಹುದಾದಂತಹ","ಹೊಸದಾಗಿಸಬಹುದಾದ"]],["n","नूपुराणां माला।","सा नूपुरमालां परिधाय नृत्यति।",["नूपुरमाला"],"मानवकृति",["ಗೆಜ್ಜೆ","ನೂಪುರ","ಕಾಲಂದುಗೆ"]],["n","नूतनस्य अवस्था।","अस्माकं कार्ये अस्माभिः नवीनता आनेतव्या।",["नवीनता","नूतनत्वम्","नवत्वम्","प्रत्यग्रता","प्रत्यग्रत्वम्"],"दशा",["ಹೊಸತನ","ನವೀನತೆ","ನಾವೀನ್ಯ","ಆಧುನಿಕತೆ"]],["n","अलङ्कारविशेषः, पादाभूषणः।","नर्तकी नूपुरान् धारयति।",["नूपुरः"],"पादाभूषणम्",["ಗೆಜ್ಜೆ","ನೂಪುರ","ಕಾಲ್ಗೆಜ್ಜೆ","ಕಿರುಗಂಟೆ"]],["a","यौवनावस्थाविशिष्टः।","तस्य युवा पुत्रः देशान्तरं गतः।",["युवा","तरुणः","वयस्थः","प्राप्तयौवनः","यविष्ठः","नवकः","नवीयः","नूतनयौवनः","युवशः","युवानकः","युवीभूतः","वत्सः"],"",["ಪ್ರಾಯಕ್ಕೆ ಬಂದ","ಪ್ರಾಯಕ್ಕೆ-ಬಂದಂತ","ಪ್ರಾಯಕ್ಕೆ-ಬಂದಂತಹ","ಪ್ರಾಯಕ್ಕೆ ಬಂದಂತ"]],["n","सः कोणः यः नवतेः अंशात् लघु, शून्यात् च बृहत्तरः भवति।","छात्रः पुस्तिकायां नूनकोणः रचयति।",["नूनकोणः"],"कोणः",[]],["n","अद्यतनीया व्यक्तिः।","अभिनवैः जनैः नूतनः पथः प्रदर्शितः।",["अभिनवः","आधुनिकः","अधुनातनः","इदानींतनः","अर्वाचीनः","अप्राचीनः","अपुराणः","नूतनः","नवः","नवीनः","नूतनकालीनः"],"मनुष्यः",["ಆಧುನಿಕ ವ್ಯಕ್ತಿ","ಆಧುನಿಕ-ವ್ಯಕ್ತಿ","ಆಧುನಿಕ ಮನುಷ್ಯ","ಆಧುನಿಕ-ಮನುಷ್ಯ"]],["n","पादयोः धार्यमाणं किञ्चन आभूषणम् ।","लोधीजातेः स्त्रियः सामान्यतः नूपुरं धरन्ति ।",["नूपुरम्"],"पादाभूषणम्",[]],["n","इक्ष्वाकुवंशीयः राजा।","नूपुरस्य वर्णनं पुराणेषु प्राप्यते।",["नूपुरः"],"पौराणिकपुरुषः",[]],["a","यस्य विद्यमानता पूर्वं नासीत्।","किमपि नूतनं कार्यम् अस्माभिः कर्तव्यम्।",["नूतन","नवीन","नव","अपूर्व","अभिनव","नवक","आर्द्र","प्रत्यग्र"],"",["ಹೊಸದಾದ","ಹೊಸದಾಂತ","ಹೊಸದಾಂತಹ","ಹೊಸತಾದ"]],["n","नूतनस्य वर्षस्य प्रथमः दिवसः यः भारतस्य विभिन्नेषु स्थानेषु भिन्नासु तिथिसु उत्सवरूपेण आचर्यते ।","भारतस्य विभिन्नेषु स्थानेषु नूतनवर्षं भिन्नासु तिथिसु प्रायः मार्च-एप्रिलमासयोः आचर्यते ।",["नूतनवर्षम्","नववर्षम्"],"वत्सरः",["ಹೊಸ ವರ್ಷ","ಹೊಸ-ವರ್ಷ","ನವ ವರ್ಷ","ನವ-ವರ್ಷ"]],["n","यस्य क्रमः चक्रं वा पुनरारब्धम् ।","सर्वेभ्यः नूतनस्य वर्षस्य शुभकामना ।",["नूतन","नव","नवीन"],"",[]],["n","यस्य उत्पाद्यं सद्यः जातः ।","नूतनस्य आलुकस्य मूल्यं पूरातनस्य आलुकस्य मूल्यात् न्यूनम् अस्ति ।",["नूतन","नव","नवीन"],"",[]],["n","यस्य अस्तित्वं पूर्वतः एव वर्तते परं तस्य अधिकारः ज्ञानं परिचयः वा सद्यः एव प्राप्तः स्यात् ।","ते मासात् प्राक् एकस्मात् गृहात् निष्क्रम्य नवं गृहं प्राविशन् ।",["नव","नूतन"],"",[]],["n","यस्य उपयोगः पूर्वं न कृतः स्यात् ।","बालकाः नवं वस्त्रं धृत्वा आनन्दिताः भवन्ति ।",["नव","नूतन"],"",[]],["n","पूर्ववतां स्थाने यः नियुक्तः भवति सः ।","विद्यालये बहवः नवाः अध्यापकाः आगताः ।",["नव","नूतन"],"",[]],["n","परिवर्तनेन परिष्करणेन पूर्वस्मात् भिन्नं जातं यत्किञ्चित् वस्तु ।","किञ्चित् धनव्ययेन गृहमेतत् नवं भवितुं शक्यते ।",["नव","नूतन","परिवर्तित"],"",[]],["n","यत् एकवारं नष्टवत् भूत्वा पुनः कार्यशीलम् अभवत् तत् ।","कर्करोगात् विमुच्य मम पुत्रः नवं जीवनम् अप्राप्नोत् ।",["नव","नूतन"],"",[]],["n","किञ्चन स्थानं यत् कस्यचन महत्स्थानस्य भागः स्यात् अथवा तस्य महत्स्थानस्य अन्येभ्यः भागेभ्यः अनन्तरं निर्मितं स्यात् तथा च तस्य स्थानस्य नाम महत्स्थानम् अनुसृत्य भवति ।","अस्माभिः नवे रायपुरे एकं गृहं स्वीकृतम् ।",["नव","नूतन"],"",[]]],"w":{"नूनम्":[0],"नून":[0],"नूपुरः":[1,11,16],"नूपुर":[1,2,6,11,15,16],"नूपुरम्":[2,6,15],"नूतन":[3,4,14,17,19,20],"नूदः":[5],"नूद":[5],"नूतनीकरणम्":[7],"नूतनीकरण":[7],"नूतनीकरणीय":[8],"नूपुरमाला":[9],"नूतनत्वम्":[10],"नूतनत्व":[10],"नूतनयौवनः":[12],"नूतनयौवन":[12],"नूनकोणः":[13],"नूनकोण":[13],"नूतनः":[14],"नूतनकालीनः":[14],"नूतनकालीन":[14],"नूतनवर्षम्":[18],"नूतनवर्ष":[18]}}