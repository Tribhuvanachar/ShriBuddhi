{"s":[["n","शुष्कतृणैः पलालैः वा विनिर्मिता शय्या।","सः कटे शेते।",["कटः","इटः","कटकः","कलिञ्जः","किलिञ्जः","किलिञ्जकः","वटरः"],"शय्या",["ಚಾಪೆ","ಮಂದಲಿಗೆ"]],["n","तृणप्रकारः।","कृषिक्षेत्रे कुद्रङ्के इटः आच्छादितः।",["इटः","इत्कटः"],"क्षुपः",["ಲಾಳದಕಡ್ಡಿ","ಗಲಗು"]],["n","अरुणाचलप्रदेशस्य राजधानी।","इटानगरं 1974तमे संवत्सरे अप्रैलमासस्य 20तमे दिने संजाता अरुणाचलप्रदेशस्य राजधानी।",["इटानगरम्"],"राजधानी",[]],["n","उत्तरप्रदेशे वर्तमानम् एकं नगरम्।","इटावा इति प्राचीने पाञ्चालदेशे आसीत् यस्य प्राचीनं नाम इष्टिकापुरी आसीत्।",["इटावानगरम्"],"पुरम्",[]],["n","उत्तरप्रदेशे वर्तमानम् एकं मण्डलम्।","इटावामण्डलस्य मुख्यालयः इटावानगरे अस्ति।",["इटावामण्डलम्"],"मण्डलम्",[]],["n","लेखनपद्धतिविशेषः।","इटालिकशैल्याम् अक्षराणि वक्राणि सन्ति।",["इटालिकशैली"],"लेखनपद्धतिः",[]]],"w":{"इटः":[0,1],"इट":[0,1],"इटानगरम्":[2],"इटानगर":[2],"इटावानगरम्":[3],"इटावानगर":[3],"इटावामण्डलम्":[4],"इटावामण्डल":[4],"इटालिकशैली":[5]}}