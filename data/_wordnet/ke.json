{"s":[["n","अग्निरेखाकारि गगनात् पतत् ज्योतिः।","श्यामः खगोलशास्त्रे उल्का इति विषयस्य अध्ययनं करोति।",["उल्का","खोल्का","खोल्कः","अग्न्युत्पातः","केतुतारा","शिखावज्ज्योतिः"],"खगोलीयपिण्डः",["ಉಲ್ಕೆ","ನಕ್ಷತ್ರ"]],["n","दण्डस्य आधारेण समुत्थिता नानावर्णीया विशिष्टवर्णीया वा पट्टिका यया कस्यापि सत्ता कोऽपि उत्सवः सङ्केतः वा सूच्यते।","भारतदेशस्य ध्वजः चक्राङ्कितः अस्ति।",["ध्वजः","पताका","ध्वजपटः","ध्वजांशुकः","केतनम्","केतुः","केतुवसनः","वैजयन्तिका","वैजयन्ती","जयन्तः","कदली","कदलिका"],"मानवकृति",["ಧ್ವಜ","ಬಾವುಟ","ಪತಾಕೆ"]],["n","मनोरञ्जनात्मिका शरीरव्यापारादिक्रिया।","क्रीडायां जयपराजयौ स्तः एव।",["क्रीडा","खेला","केलिः","लीला","नर्म","कूर्दनम्"],"क्रियारूपम्",["ಆಟ","ಆಟ-ಪಾಠ","ಕ್ರೀಡೆ"]],["n","कस्यापि वृत्तस्य परिधेः पङ्क्तेः वा याथार्थेन मध्ये वर्तमानो बिन्दुः।","अस्य वृत्तस्य केन्द्रबिन्दुं छिन्दन्तीं रेखां लिखतु।",["केन्द्र बिन्दुः","केन्द्रम्","मध्य-बिन्दुः","नाभिः","मध्यम्","मध्यः","मध्यस्थानम्","मध्यस्थलम्","गर्भः","उदरम्","अभ्यन्तरम्","हृदयम्"],"स्थलम्",["ಕೇಂದ್ರ ಬಿಂದು","ಕೇಂದ್ರ","ಮಧ್ಯಬಿಂದು","ಮಧ್ಯ ಬಿಂದು"]],["n","वन्यपशुः- मार्जारजातीयः हिंस्रः तथा च बलवान् पशुः।","अस्मिन् काव्ये कविना शिवरायस्य तुलना सिंहैः कृता।",["सिंहः","मृगेन्द्रः","पञ्चास्यः","हर्यक्षः","केशरी","हरिः","पारीन्द्रः","श्वेतपिङ्गलः","कण्ठीरवः","पञ्चशिखः","शैलाटः","भीमविक्रमः"],"बिडालजातीयपशुः",["ಸಿಂಹ","(ಕೇಸರಿ","ಸಿಂಗ",")"]],["n","केशानां समूहः।","नापितस्य आपणके स्थाने स्थाने केशसमूहाः दृश्यन्ते।",["केशसमूहः"],"समुदायः",["ಕೂದಲು","ಕೇಶ","ಕೇಶರಾಶಿ"]],["n","असामान्यस्य अवस्था भावो वा।","धनुर्विद्यायाम् अर्जुनस्य असाधारणता ख्याता।",["असाधारणता","असामान्यता","लोकोत्तरता","केवलता"],"दशा",["ಅಸಮಾನ್ಯತೆ","ಅಸಾಧಾರಣ"]],["n","सिंहादीनां स्कन्धकेशः।","केसरैः सिंहः शोभते।",["केसरः","केशरः"],"वृजिनः",["ಕೂದಲು","ಆಯಾಲ","ರೋಮ."]],["n","शिरो मध्यस्य केशाः।","शिखां निबद्ध आसीनो द्विज आचमनम् चरेत्।",["शिखा","चूडा","केशपाशः","जूटिका","जुटिका","शिखण्डिका"],"केशसमूहः",["ಚಂಡಿಕೆ","ಚಿಂಡಿಕೆ","ತುರಾಯಿ","ಶಿಖೆ"]],["n","नवरत्नेषु एकं रत्नम्।","केतुग्रहस्य प्रभावात् रक्षणार्थे केतुरत्नं धारयन्ति।",["केतुरत्नम्","वैदूर्यम्","विदूरजम्","वैदुर्यमणिः","कैतवम्","प्रावृष्यम्","अभ्ररोहम्","खराब्दाङ्कुरम्"],"मणिः",["ವೈಡೂರ್ಯ"]],["n","अलङ्कारविशेषः हस्तालङ्कारः।","श्यामः केयूरं धारयति।",["केयूरम्","अङ्गदः","वलयः","वलयम्","कटकवलयी","परिहाटकः","परिहारकः","परिहारकम्","बाहुभूषा"],"आभूषणम्",["ತೋಳ್ಬಂದಿ"]],["n","पवनस्य पुत्रः यः बलशाली तथाच अमरः अस्ति।","हनुमान् रामस्य भक्तः अस्ति।",["हनुमान्","पवनपुत्रः","पवनसुतः","पवनकुमारः","अञ्जनीनन्दनः","आञ्जनेय","कपीशः","केसरीनन्दनः","वातात्मजः","मारुतिः","मनुमान्","योगचरः"],"देवः",["ಹನುಮಂತ","ವಾತಾತ್ಮಜ","ಅಂಜನಪುತ್ರ","ಅಂಜನನ ಮಗ"]],["n","क्षुपविशेषः शीतप्रदेशे जातः क्षुपः यः सुगन्धार्थे ख्यातः।","केशरात् प्राप्तः सुगन्धितः पदार्थः धार्मिककार्ये अपि उपयुज्यते।",["केशरः","केसरः","अग्निसेखरः","अम्बरम्","असृक्","कनकगौरम्","कान्तम्","कालेयम्","कावेरम्","काश्मीर","कुचन्दनम्","कुसुमात्मकम्"],"कन्दजवनस्पतिः",["ಕೇಸರಿ","ಕುಂಕುಮ ಕೇಸರಿ"]],["n","देवताविशेषः हिन्दुधर्मानुसारं जगतः पालनकर्ता।","एकादशस्तथा त्वष्टा द्वादशो विष्णुरुच्यते जघन्यजस्तु सर्वेषामादित्यानां गुणाधिकः।",["विष्णुः","नारायणः","कृष्णः","वैकुण्ठः","विष्टरश्रवाः","दामोदरः","हृषीकेशः","केशवः","माधवः","स्वभूः","दैत्यारिः","पुण्डरीकाक्षः"],"",["ವಿಷ್ಣು","ಕಮಲಪತಿ","ಕಮಲೇಶ","ಚಕ್ರಧರ"]],["a","सहायरहितः।","एकाकी चिन्तयेन्नित्यं विविक्ते हितमात्मनः। एकाकी चिन्तयानो हि परं श्रेयः अधिगच्छति।",["एकाकी","एकः","निभृतः","केवलः","एकलः"],"",["ಏಕಾಂಗಿ","ಏಕಾಂಗಿಯಾದ","ಏಕಾಂಗಿಯಾದಂತ","ಏಕಾಂಗಿಯಾದಂತಹ"]],["n","यदुवंशीय वसुदेवस्य पुत्रः यः विष्णोः अवतारः इति मन्यते।","सूरदासः कृष्णस्य परमो भक्तः।",["कृष्णः","नारायणः","दामोदरः","हृषीकेशः","केशवः","माधवः","अच्युतः","गोविन्दः","जनार्दनः","गिरिधरः","दैवकीनन्दनः","माधवः"],"",["ವಿಶ್ವಪತಿ","ಸೋಮೇಶ್ವರ","ಗೋಪಾಲ","ಗಿರಿಧಾರಿ"]],["n","मनोविनोदनार्थं कृता क्रिया।","वालाः जले क्रीडां कुर्वन्ति।",["क्रीडा","खेला","केलिः"],"क्रियारूपम्",["ಆಟ","ಕ್ರೀಡೆ"]],["n","कस्यापि विशेषकार्यार्थे जनानां संमेलनस्य स्थानम्।","स्वतन्त्रतासङ्ग्रामे लखनौनगरं क्रान्तिकारकाणां केन्द्रम् आसीत्।",["केन्द्रम्"],"स्थलम्",["ಬಿಡಾರ","ಅಡ್ಡ","ಕೇಂದ್ರ","ಕೋಟೆ"]],["n","कस्यापि विशेषकार्यार्थे विशेषरूपेण नियतं स्थानम्।","दिल्लीनगरम् नेतृणां कृते एकम् राजनैतिकं केन्द्रम्।",["केन्द्रम्","केन्द्रस्थानम्"],"स्थलम्",["ಕೇಂದ್ರ","ಕೇಂದ್ರೀಯ ಸ್ಥಾನ"]],["n","स्वनामख्यातवृक्षविशेषः यः  सदा हरितः अस्ति।","अशोकः भारते सर्वत्र दृश्यते।",["अशोकः","शोकनाशः","विशोकः","वञ्जुलद्रुमः","वञ्जलः","मधुपुष्पः","अपशोकः","कङ्केल्लिः","केलिकः","रक्तपल्लवः","चित्रः","विचित्रः"],"वृक्षः",["ಅಶೋಕ","ಅಶೋಕ ವೃಕ್ಷ"]],["n","वन्यक्षुपः यः भेषजरूपेण उपयुज्यते।","वैद्येन पीडिताय शिखरिणः सत्वस्य सेवनं सूचितम्।",["शिखरी","विषघ्निका","श्वेतधामा","वृहत्फला","वेश्मकूला","शिखी","मालाकण्ठः","अर्ग्वधा","केशपर्णी"],"क्षुपः",[]],["n","नवग्रहान्तर्गतः एकः ग्रहः यः पुराणानुसारेण राक्षसः अस्ति।","शास्त्रानुसारेण केतुः सूर्यम् अतिक्रामति अतः सूर्यग्रहणं भवति।",["केतुः","शिखी","केतुः"],"असुरः",["ಕೇತು","ಕಬಂಧ"]],["n","उत्पातविशेषः सौरमण्डलीय धूमाभा तारका या ग्रहः इव सूर्यं परितः भ्रमति।","धूमकेतुः क्वचित् एव दृश्यते।",["धूमकेतुः","केतुतारा","केतुः","अग्न्युत्पातः","शिखावज्ज्योतिः","उत्पातः","उपग्रहः"],"तारा",["ಧೂಮಕೇತು","ಬಾಲಚಿಕ್ಕಿ","ಅಗ್ನಿ","ಬಾಲವುಳ್ಳನಕ್ಷತ್ರ"]],["n","केशलुञ्चनात् उद्भूतः स्फोटः।","रघुवीरः केशलुञ्चनस्फोटस्य पीडाम् अनुभवति।",["केशलुञ्चनस्फोटः"],"गण्डः",["ಕೂದಲು ಕಿತ್ತುವರಿಂದುಂಟಾದ ಹುಣ್ಣು ಅಥವಾ ಗುಳ್ಳೆ"]],["n","कस्यापि राष्ट्रस्य प्रधानं शासनं यत् तस्य राष्ट्रस्य राजधान्यां वर्तते तथा च सम्पूर्णे राष्ट्रे शासनं करोति।","पक्षवादं विहाय केन्द्रशासनेन सर्वेभ्यः राज्येभ्यः साहाय्यं दातव्यम्।",["केन्द्रशासनम्"],"सर्वकारः",["ಕೇಂದ್ರ ಸರಕಾರ","ಕೇಂದ್ರ ಸರ್ಕಾರ","ಕೇಂದ್ರ-ಸರ್ಕಾರ","ಕೇಂದ್ರೀಯ ಸರಕಾರ"]],["n","शिरस्थानि लोमानि।","दीर्घाः कृष्णवर्णीयाः केशाः शोभनाः।",["केशः","कचः","कुन्तलः","चिकुरः","वृजनः","बालः","शिरोरुहः","शिरसिजः","शिरोरुढः","मूर्ध्दजः","कृशला"],"वृजिनः",["ಕೂದಲು","ಕೇಶ","ತಲೆಗೂದಲು"]],["a","अन्यं विना।","अधुना केवलः ईश्वरः एव सहाय्यकः।",["केवल","एकमेव","मात्र"],"",["ಕೇವಲ","ಬರಿಯ","ಮಾತ್ರ"]],["a","केसरसदृशवर्णः।","यज्ञस्थले स्थाने स्थाने केसरवर्णाः पताकाः दृश्यन्ते।",["केसरवर्ण"],"",["ಕೇಸರೀಯ","ಕೇಸರೀಯವಾದ","ಕೇಸರೀಯವಾದಂತ","ಕೇಸರೀಯವಾದಂತಹ"]],["a","कस्यापि राज्यस्य राष्ट्रस्य वा केन्द्रेण सम्बद्धः।","अधुना भारतस्य केन्द्रीया सत्ता विविधपक्षाणां सङ्घस्य अस्ति।",["केन्द्रीय"],"",["ಕೇಂದ್ರೀಯ","ಕೇಂದ್ರೀಯವಾ