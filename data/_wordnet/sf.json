{"s":[["n","उत्पादनस्य क्रिया।","अस्य भुवनस्य निर्माणं मुघलशैल्या कृतम्।",["निर्माणम्","सर्जनम्","सृष्टिः","उत्पत्तिः","सर्गः","निसर्गः","भावनम्"],"उत्पादनम्",["ರಚನೆ","ನಿರ್ಮಾಣ","ಸೃಷ್ಠಿ"]],["a","यस्मिन् कापि व्यवस्था वा कोपि नियमो वा अस्ति।","तेन कक्षे सम्यक् विरचितानि वस्तूनि विकीर्णानि।",["व्यूढ","संव्यूढ","विन्यस्त","विहित","प्रतिविहित","व्यवस्थापित","संस्थापित","रचित","विरचित","कल्पित","परिकल्पित","सृष्ट"],"",["ಸುವ್ಯವಸ್ಥಿತ","ಸುವ್ಯವಸ್ಥಿತವಾದ","ಸುವ್ಯವಸ್ಥಿತವಾದಂತ","ಸುವ್ಯವಸ್ಥಿತವಾದಂತಹ"]],["a","कृतनिर्माणम्।","सप्तदशशताहब्द्यां निर्मितः तेजोमहालयः शहाजानराज्ञः उपायनम्।",["निर्मित","विनिर्मित","रचित","विरचित","सृष्ट","कृत","सर्जित","सृजित","संरचित","प्रणीत","घटित"],"",["ಕಟ್ಟಿದ","ನಿರ್ಮಿತ","ರಚಿತ","ನಿರ್ಮಿಸಿದ"]],["n","हस्तिचालनार्थलोहमयवक्राग्रास्त्रम्।","हास्तिकः अङ्कुशेण नैकवारं गजम् आहन्यत्।",["अङ्कुशः","तोदनम्","तोत्रम्","प्रतोदः","प्राजनम्","शृणिः","सृणिः","प्रवयणम्"],"साधनम्",["ಅಂಕುಶ","ತಿವಿಗೋಲು","ಚುಚ್ಚುಗೋಲು"]],["v","कालस्थानसम्बन्धादिभिः परिमाणैः दूरीकरणानुकूलः व्यापारः।","पापानामनुपत्तये प्रायश्चित्तम्।",["अपनी","विनी","व्यपनी","अपसृ","उतसृ","निःसृ","सृ","अपहृ","हृ","अपकृष्","व्यपकृष","अवकृष्"],"",["ತೊಡೆದುಹಾಕು","ಅಳಿಸಿಹಾಕು","ನಿವಾರಿಸು"]],["n","रोगविशेषः यस्मिन् शरीरः कण्डूयते।","सः कण्डुना त्रस्तः अस्ति।",["कण्डुः","कण्डूः","खर्ज्जूः","कच्छूः","कच्छुः","सुकाण्डुः","सृकण्डुः","खसः","पाम"],"त्वग्रोगः",["ನವೆ","ತುರಿ","ಹುರುಕು","ಕಜ್ಜಿ"]],["v","स्वस्थानात् अग्रे वामतः पृष्ठतः अथवा दक्षिणतः गमनानुकूलव्यापारः।","एतद् उक्त्वा सः स्वस्थानाद् अचलत्।",["चल्","सृ"],"",["ಅಲ್ಲಾಡು","ಕದಲು","ಜರಗು"]],["n","श्वानसदृशः वन्यपशुः।","शृगालः मांसाहारी अस्ति।",["शृगालः","सृगालः","जम्बुकः","जम्बूकः","वञ्चकः","क्रोष्टा","गोमी","क्रश्वा","भूरिमायः","घोररासनः","हूरवः","श्वभीरुः"],"मांसाहारी",["ನರಿ","ಜಂಬುಕ","ಬಳ್ಳು"]],["n","मुखजातः रसः।","तस्य मुखात् आस्यासवेन सह रुधिरम् अपि आगच्छति।",["आस्यासवः","जाम्बीलम्","जूरी","मुखस्रावः","मुखास्रावः","लाला","लसिका","लासः","ष्ठ्यूतः","सृणीका","स्यन्दनी"],"शारीरिकद्रवः",["ಉಗುಳು","ಜೊಲ್ಲು","ಲಾಲಾರಸ"]],["v","प्राक् अज्ञातस्य वस्तुनः आविष्करणानुकूलः व्यापारः।","एडीसनमहोदयः विद्युतं चक्लृपे।",["क्लृप्","निर्मा","सृज्","विधा","घटय","रचय","विरचय"],"उत्पादय",["ಬಿಡುಗಡೆ ಮಾಡು ಹೊರತಗೆ","ಅವಿಷ್ಕರಿಸು"]],["v","कस्यापि वस्तुनः निर्माणानुकूलः व्यापारः।","नद्यां सेतुं विनिर्मीय विद्युत् उत्पाद्यते।",["उत्पादय","विनिर्मा","सृज्","विधा","कल्पय","घटय","विरचय","रचय"],"कृ",["ಉತ್ಪಾದನೆ ಮಾಡು","ಉತ್ಪಾದಿಸು"]],["v","रसस्य बहिः अप्रतिहतं निःसरणानुकूलः व्यापारः।","तस्य स्फोटात् पूयं प्रस्रवते।",["प्रस्रु","स्रु","प्रस्यन्द्","प्रस्यंद","निष्यन्द्","निष्यंद्","अभिष्यन्द्","अभिष्यंद्","क्षर्","गल्","सृ","प्रवह्"],"चल्",["ಹರಿ"]],["v","सञ्चालनानुकूलव्यापारः।","जलतरङ्गाः तं चालयन्ति।",["चल्","सृ"],"धू",["ಅಲ್ಲಾಡಿಸು","ಬೀಸು"]],["a","तादृशं कार्यं यस्मात् नूतना निर्मितिः भवति।","सृजनात्मकं कार्यं कर्तुं बालकान् प्रोत्साहयेयुः।",["सृजनात्मक","रचनात्मक"],"",["ರಚನಾತ್ಮಕವಾದ","ಸೃಜನಾತ್ಮಕವಾದ","ಸೃಜನಶೀಲ"]],["n","मुखात् स्रवमाणः रसः।","पुत्रस्य मुखात् स्रवमाणां लालां माता पुनः पुनः प्रोञ्छयति।",["लाला","स्यन्दिनी","लसिका","द्राविका","सृणीका","सृणिका","स्यन्दनी","लासः","आस्यासवः","मुखस्रावः","वदनासवः","वक्त्रासवः"],"शारीरिकद्रवः",["ಜೊಲ್ಲು ಜ್ವಲ್ಲು"]],["v","मन्दगत्या चलनानुकूलः व्यापारः।","स्थानकस्य समीपम् आगम्य रेलयानम् असर्पत्।",["सृप्"],"प्रस्थानं कृ",["ನಿಧಾನವಾಗಿ ಚೆಲಿಸು","ನಿಧಾನವಾಗಿ-ಚಲಿಸು","ನಿಧಾನವಾಗಿ ನಡೆ","ಸಾವಕಾಶವಾಗಿ ನಡೆ"]],["v","भूमौ सर्पणानुकूलः व्यापारः।","गृहे कोऽपि जन्तुः सर्पति।",["सृप्"],"प्रस्था",["ತೆವಳು","ಹರಿದಾಡು"]],["n","गात्रघर्षणस्य इच्छा।","मम पादे कण्डूतिः वर्तते।",["कण्डूतिः","कच्छू","कण्डू","खर्जुः","राका","विचर्चिका","सृकण्डुः","कण्डूलभावः","खसः"],"इच्छा",["ನವೆ","ತುರಿಕೆ","ಕೆರತ","ತುರುಕೆ"]],["n","एकः असुरः।","सृगालवदनस्य वर्णनं पुराणेषु वर्तते।",["सृगालवदनः"],"असुरः",[]],["n","एकं शरीरं त्यक्त्वा आत्मनः अन्यस्मिन् शरीरे प्रवेशस्य क्रिया।","हिंदूनां देहान्तरप्राप्तौ विश्वासः वर्तते।",["देहान्तरप्राप्तिः","संसृतिः","सृतिः","पुनर्भवः","जीवसंक्रमणम्","देहान्तरणम्"],"क्रिया",["ದೇಹಾಂತರ"]],["n","येन गत्वा गन्तव्यं प्राप्यते।","विमानस्यापि विशिष्टः मार्गः अस्ति।",["मार्गः","पन्थाः","अयनम्","वर्त्म","सृतिः","पद्या","वर्तनिः","शरणिः","पद्धती","वर्तनिः","अध्वा","वीथिः"],"साधनम्",["ಮಾರ್ಗ","ರಸ್ತೆ","ಹಾದಿ","ದಾರಿ"]],["a","यः नूतनानां वस्त्वादीनां निर्माणे समर्थः।","सर्जनात्मिकया गृहिण्या गृहस्य शोभा वर्धते।",["सर्जनात्मक","सृजनशील","सर्जनशील"],"",["ಸೃಜನಶೀಲವಾದ","ಸೃಜನಶೀಲವಾದಂತ","ಸೃಜನಶೀಲವಾದಂತಹ"]],["n","लोहपथगामिन्यः पथिकयानानाम् अग्रधुरीणं यन्त्रम् यद् लोहपथगामिनीं स्थानान्तरगमनशक्तिं प्रयच्छति।","गत्वरः लोहपथगामिनीम् आबध्यते।",["गत्वरः","सृत्वरः","चरिष्णुः","चालकः"],"गन्त्रम्",["ಇಂಜಿನ್","ಎಂಜಿನ್"]],["n","बहिर्लोकः यस्मिन् वृक्षक्षुपाः पशुपक्षिणः तथा च पर्वतादयः इत्यादयः निसर्गोद्भवाः भावाः समाख्यायन्ते।","प्रकृतेः रक्षणार्थे सर्वैः प्रयतितव्यम्।",["प्रकृतिः","सृष्टिः"],"समुदायः",["ಪ್ರಕೃತಿ","ನಿಸರ್ಗ"]],["n","मनोः एकः पुत्रः ।","सृञ्जयस्य उल्लेखः प्राचीनेषु ग्रन्थेषु अस्ति ।",["सृञ्जयः"],"",[]],["n","एकः पुरुषः ।","सृकण्डुः शुभ्रादिगणे वर्तते",["सृकण्डुः"],"",[]],["n","एका स्त्री ।","सृगालिकायाः उल्लेखः दकुमारचरिते वर्तते",["सृगालिका"],"",[]]],"w":{"सृष्टिः":[0,23],"सृष्टि":[0,23],"सृष्ट":[1,2],"सृजित":[2],"सृणिः":[3],"सृणि":[3],"सृ":[4,6,11,12],"सृकण्डुः":[5,17,25],"सृकण्डु":[5,17,25],"सृगालः":[7],"सृगाल":[7],"सृणीका":[8,14],"सृज्":[9,10],"सृजनात्मक":[13],"सृणिका":[14],"सृप्":[15,16],"सृगालवदनः":[18],"सृगालवदन":[18],"सृतिः":[19,20],"सृति":[19,20],"सृजनशील":[21],"सृत्वरः":[22],"सृत्वर":[22],"सृञ्जयः":[24],"सृञ्जय":[24],"सृगालिका":[26]}}