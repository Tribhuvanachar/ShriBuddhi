{"s":[["n","अवयवविशेषः- आकटि अधमाङ्गं, मनुष्यादयः अनेन सरन्ति।","वने चरतः मम पादः बहु क्लेशम् अन्वभवत्",["पादः","प्रेष्ठा","टङ्का","टङ्गः","टङ्गम्","टङ्कः","टङ्कम्","प्रसृता","नलकिनी","जङ्घा"],"बाह्य-शारीरिक-भागः",["ಕಾಲು","ಪಾದ"]],["n","निर्दिष्टमूल्यं क्रयविक्रयमाध्यमः धातोः निर्मितः गोलः।- धातोः खण्डः यस्य मूल्यं निर्धारितं तथा च विनिमयस्य साधनमपि असौ।","प्राचीने काले सुवर्णस्य नाणकानि आसन्।",["नाणकम्","निष्कः","निष्कम्","मुद्रा","टङ्कः","टङ्ककः"],"मुद्रा",["ಮುದ್ರಾ","ಸಿಕ್ಕಾ","ಮೊಹರು","ಠಸ್ಸೆ"]],["n","मनसि प्रादुर्भूता अहं सर्वोत्कृष्टः इति अभिमानात्मिका अन्तःकरणवृत्तिः।","अहङ्कारात् सर्वं विनश्यति।",["अहङ्कारः","अभिमानः","गर्वः","स्मयः","अवलेपः","दर्पः","अवश्यायः","टङ्कः"],"मनोभावः",["ಗರ್ವ","ಜಂಭ","ಸಿಂಗಾರ","ಪ್ರತಾಪ"]],["n","अलघुपलस्य लघु चर्पटः खण्डः।","पाषाणशिलायाः भ्रंशात् पुरुषद्वयः हतः।",["पाषाणशिला","शिलाखण्डः","चर्पटखण्डः टङ्कः","टङ्कम्"],"शिला",["ಬಂಡೆ ಕಲ್ಲು","ಬಂಡೆ","ಕಲ್ಲು ಬಂಡೆ","ಬೆಟ್ಟ"]],["n","तन्त्वादीन् आहत्य कृतः ध्वनिः।","महाभारतस्य युद्धे सैनिकानां धनुषः टङकारः वारंवारं अनदत्।",["टङ्कारः","क्वणितम्"],"शब्दः",["ಠೇಂಕಾರ"]],["n","अस्त्रविशेषः, लोहस्य खननसाधनद्रव्यम्।","वृक्षस्य रोपणार्थे खनित्रेन भूमिम् खनयति कृषीवलः।",["खनित्रम्","खात्रम्","आखनिकः","आखनः","आखनम्","आखः","अवदारणम्","गोदारणम्","स्तम्बघ्नः","टङ्कः","टङ्गः","विशिखा"],"खनित्रम्",["ಪಿಕಾಸಿ","ಮೊಂಟಿ"]],["n","यन्त्रविशेषः येन पत्रादीनाम् अङ्कनं क्रियते।","सङ्गणकस्य आगमनेन टङ्ककस्य महत्त्वं न्यूनायते।",["टङ्ककम्"],"उपकरणम्",["ಬೆರಳಚ್ಚು ಯಂತ್ರ"]],["n","यत्र नाणकनिर्माणं क्रियते।","रामस्य पिता टङ्कशालायां कार्यं करोति।",["टङ्कशाला","मुद्राङ्कनशाला","भौरिकी"],"स्थलम्",["ಟಂಕ ಸಾಲೆ","ಟಂಕಸಾಲೆ","ಹಣ ತಯಾರಿಸುವ ಸ್ಥಳ"]],["n","पञ्जाबप्रदेशे वर्तमानः गानप्रकारः।","परमजीतः मित्रेभ्यः टप्पां श्रावयति।",["टप्पाः"],"गीतम्",[]],["a","यस्य कनीनिका तिर्यक् वर्तते।","कुशिकः पुरुषः कुत्र पश्यति एतद् ज्ञातुं बहु कठिनम् अस्ति।",["कुशिक","केकर","गोकुलिक","टगर","टेराक्ष","दूरितेक्षण","वलिर","विषमदृष्टि"],"",["ಮಾಲುಗಣ್ಣಿನ","ಒರಚುಗಣಣ್ಣಿನ","ಮೆಳ್ಳಗಣ್ಣಿನ","ಮೆಳ್ಳೆಗಣ್ಣಿನ"]],["n","एका रागिणी।","टङ्की श्रीरागस्य सहचरी अस्ति।",["टङ्की"],"रागिणी",[]],["n","सम्पूर्णजातेः रागः।","सङ्गीतज्ञः टङ्कं गायति।",["टङ्कः"],"रागः",[]],["n","वीणायाः प्रकारः।","महेशः टंसरीं वादयति।",["टंसरी"],"वीणा",[]],["n","पटहसदृशं लघुवाद्यम्।","श्यामः टमक्याः वादनकाले एव पटहम् अपि अवादयत्।",["टमकी"],"आनद्धवाद्यम्",[]],["n","टवर्णात् आरभ्य णवर्णं यावत् वर्णाः।","टवर्गे ट ठ ड ढ तथा च ण इत्येते वर्णाः सन्ति।",["टवर्गः"],"वर्गः",[]],["a","टवर्गसम्बन्धी।","ठकारः  टवर्गीयः वर्णः अस्ति।",["टवर्गीय"],"",["ಟವರ್ಗೀಯ","ಟ ವರ್ಗೀಯ","ಟ-ವರ್ಗೀಯ"]],["n","फिलिपीन्सदेशस्य आद्यः निवासिनां समूहः यः मनीला तथा तस्य परिसरे वसति।","टगलगानां भाषा अपि टगलग एव कथ्यते।",["टगलगः"],"युथः",[]],["n","टगलगजातेः भाषा।","टगलग-भाषा फिलिपीनदेशीयायाः भाषायाः आधारः वर्तते।",["टगलग-भाषा"],"भाषा",[]],["n","आम्राणाम् एकः प्रकारः।","टॉमी-एटकिन्स-आम्रम् एकः अमेरिकादेशीया जातिः अस्ति।",["टॉमी-एटकिन्स-आम्रम्"],"आम्रम्",[]],["n","टॉमी-एटकिन्स इति नामकानाम् आम्राणां वृक्षः।","प्रथमः टॉमी-एटकिन्स-आम्रः फ्लोरिडादेशे वर्धितः।",["टॉमी-एटकिन्स-आम्रः"],"आम्रः",[]],["a","टङ्कनयन्त्रेण मुद्रितं लिखितं वा।","टङ्कितं पत्रम् एकवारं पठतु।",["टङ्कित"],"",["ಠಂಕಿಸಿದ","ಠಂಕಿಸಿದಂತ","ಠಂಕಿಸಿದಂತಹ","ಟೈಪ್ ಮಾಡಿದ"]],["n","मैक्सिकोदेशस्य सुराविशेषः।","टकीलामद्यम् अगावेनामकस्य क्षुपस्य रसस्य किण्वनं कृत्वा निर्मीयते।",["टकीलामद्यम्"],"मद्यम्",[]],["n","जार्जियादेशस्य राजधानी।","टबलीसीनगरं जार्जियादेशस्य महिष्ठं नगरम्।",["टबलीसीनगरम्","त्बिलिसीनगरम्"],"राजधानी",[]],["n","छन्दःशास्त्रानुसारेण पञ्चसु गणेषु एकः।","टगणः षण्णां मात्राणाम् अस्ति यस्य त्रयोदश उपभेदाश्च सन्ति।",["टगणः"],"मात्रिकगणः",[]],["n","वर्णमालायाः एकादशतमः वर्णः टवर्गस्य प्रथमं व्यञ्जनम् च।","टकारस्य उच्चारणस्थानं मूर्द्धा अस्ति।",["टकारः"],"",[]],["n","गानप्रकारः यस्मिन् स्वराणां लघुः समूहः विशिष्टेन प्रकारेण गीयते।","टप्पागानस्य प्रचलनं लखनऊनगरस्य गुलामनबीशोरीमहोदयेन कृतम्।",["टप्पागानम्"],"गानम्",["ಪಲುಕು (ವೋಕಲೈಸಿಂಗ್)"]],["n","गृहगोधायाः ध्वनिः।","मन्दिरस्य भित्तौ गृहगोधिका टट्टनं करोति।",["टट्टनम्"],"शब्दः",["ಲೊಚ್","ಚುಕ್ ಚುಕ್","ಚುಕ್-ಚುಕ್","ಚಿಕ್"]],["n","एकः गुल्मः ।","टङ्कार्याः उल्लेखः भावप्रकाशे अस्ति",["टङ्कारी"],"",[]],["n","एकं वाद्यम् ।","टट्टर्याः उल्लेखः कोषे अस्ति",["टट्टरी"],"",[]],["n","एकः राजपुत्रः ।","टण्डनस्य उल्लेखः तोडरानन्दे अस्ति",["टण्डनः"],"",[]]],"w":{"टङ्का":[0],"टङ्गः":[0,5],"टङ्ग":[0,5],"टङ्गम्":[0],"टङ्कः":[0,1,2,5,11],"टङ्क":[0,1,2,3,5,11],"टङ्कम्":[0,3],"टङ्ककः":[1],"टङ्कक":[1,6],"टङ्कारः":[4],"टङ्कार":[4],"टङ्ककम्":[6],"टङ्कशाला":[7],"टप्पाः":[8],"टप्पा":[8],"टगर":[9],"टङ्की":[10],"टंसरी":[12],"टमकी":[13],"टवर्गः":[14],"टवर्ग":[14],"टवर्गीय":[15],"टगलगः":[16],"टगलग":[16],"टगलग-भाषा":[17],"टॉमी-एटकिन्स-आम्रम्":[18],"टॉमी-एटकिन्स-आम्र":[18,19],"टॉमी-एटकिन्स-आम्रः":[19],"टङ्कित":[20],"टकीलामद्यम्":[21],"टकीलामद्य":[21],"टबलीसीनगरम्":[22],"टबलीसीनगर":[22],"टगणः":[23],"टगण":[23],"टकारः":[24],"टकार":[24],"टप्पागानम्":[25],"टप्पागान":[25],"टट्टनम्":[26],"टट्टन":[26],"टङ्कारी":[27],"टट्टरी":[28],"टण्डनः":[29],"टण्डन":[29]}}