{"s":[["v","साक्षात् अग्निसम्पर्कात् अनुष्णस्य ऊष्णीकरणानुकूलः व्यापारः।","सः अयसं तपति।",["तप्","उत्तप्","ऊष्णीकृ"],"वि कृ",["ಕಾಯಿಸು","ಬೆಚ್ಚಗೆ ಮಾಡು","ಕಾವೇರಿಸು"]],["n","एकः कृष्णवर्णीयः लघुः कुण्डलाकारः कटुः व्यञ्जनविशेषः।","मम पितामहः ऊषणं मिश्रीय एव चायं पिबति।",["ऊषणम्","उषणम्","मरीचम्","मरिची","द्वारवृत्तम्","मरिचम्","औषनम्","शनिजम्","पवितम्","वलितम्","कोलकम्","उल्लाघः"],"व्यञ्जनम्",["ಕರಿ ಮೆಣಸು","ಮೆಣಸು","ಕರಿ-ಮೆಣಸು","ಅಕ್ರೋಡ"]],["a","ऊष्मागतिकसम्बन्धी","प्रवाहितायाः ऊर्जायाः ऊष्मागतिकां मात्रां कथयतु।",["ऊष्मागतिक"],"",["ಉಷ್ಣೋತ್ಪಾದಕ"]],["n","एका लता यस्य कलिका तूतस्य आकारवत् भवति।","पिप्पली औषधस्य रूपेण उपयुज्यते।",["पिप्पली","कृष्णा","उपकुल्या","वैदेही","मागधी","चपला","कणा","उषणा","शौण्डी","कोला","ऊषणा","पिप्पलिः"],"लता",[]],["n","बाणासुरस्य एका कन्या यस्याः विवाहः कृष्णस्य पौत्रेण अनिरुद्धेन सह अभवत्।","उषा अनिरुद्धस्य पत्नी आसीत्।",["उषा","ऊषा","बाणसुता","अर्जुनी"],"पौराणिकस्त्री",[]],["n","लताप्रकारकः यस्याः कटुः कृष्णवर्णीया लघुगुलिका या भोजने उपस्कररूपेण उपयुज्यते।","कृषकः कृषीक्षेत्रात् मरीचम् आमूलात् उद्गृह्णाति।",["मरीचम्","मल्लजम्","उल्लाघःउषणम्","ऊषणम्","औषणशौण्डी","कफविरोधि","कृष्णः","केवलद्रव्यम्","कोलम्","कोलकम्","चन्द्रकम्","तीक्ष्णः"],"लता",[]],["n","उष्णतायाः परिमाणम्।","एकघण्टां यावत् व्यायामेन 200-300 ऊष्माङ्काः न्यूनीकर्तुं शक्यन्ते।",["ऊष्माङ्कः"],"मात्रा",["ಕ್ಯಾಲೋರಿ","ಶಾಖದ ಮಾನ"]],["n","भोजनस्य ऊर्जा उत्पादनक्षमतायाः परिमाणम् ।","प्रथिने कर्बोदकस्य अपेक्षया न्यूनः ऊष्माङ्कः भवति ।",["ऊष्माङ्कः"],"एककः",[]],["n","चन्द्रगोलस्थानां वर्गः ।","ऊष्मपस्य उल्लेखः महाभारते हरिवंशे भागवतपुराणे च अस्ति",["ऊष्मपः"],"",[]]],"w":{"ऊष्णीकृ":[0],"ऊषणम्":[1,5],"ऊषण":[1,5],"ऊष्मागतिक":[2],"ऊषणा":[3],"ऊषा":[4],"ऊष्माङ्कः":[6,7],"ऊष्माङ्क":[6,7],"ऊष्मपः":[8],"ऊष्मप":[8]}}