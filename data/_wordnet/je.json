{"s":[["a","जेतुं योग्यः।","खलोऽपि प्रेम्णा जेयः वर्तते।",["जेय"],"",["ಜಯಿಸಬಹುದಾದ","ಗೆಲ್ಲಬಹುದಾದ","ವಿಜಯಿಯಾಗಬಹುದಾದ"]],["n","अदनस्य क्रिया।","भोजनात् अनन्तरं सः विश्रामार्थे गतः।",["भोजनम्","जग्धः","जेमनम्","लेपः","आहारः","निघसः","न्यादः","जमनम्","विघसः","अभ्यवहारः","प्रत्यवसानम्","अशनम्"],"कर्म",["ಭೋಜನಮಾಡುವುದು","ಊಟಮಾಡುವುದು"]],["n","येन विजयः प्राप्तः।","जनैः जयी स्कन्धेभ्यः उद्धृतः।",["जयी","जयिनी","जेता","जेत्री","विजयी","विजयिनी","संजित्","संजित्"],"",["ವಿಜೇತ","ಗೆದ್ದವರು","ವಿಜಯಶಾಲಿ","ಯಶಸ್ವಿ"]],["n","इस्रेलदेशस्य राजधानी।","जेरुसलमनगरं यहूदीनां, ख्रीष्टीयानां च जनानां तथा यवनानां पवित्रं तीर्थं मतम्।",["जेरुसलमनगरम्"],"राजधानी",[]],["n","विमानविशेषः यः एकेन अथवा एकाधिकेन जेटसंयंन्त्रेण सञ्चाल्यते।","अस्य जेटविमानस्य मूल्यं षट्कोटिः अस्ति।",["जेटविमानम्"],"आकाशयानम्",["ಜೆಟ್ ವಿಮಾನ"]],["n","वैदिकः ऋषिविशेषः।","जेतस्य वर्णनं ऋग्वेदे अस्ति।",["जेतः"],"आप्तः",[]],["n","भारतस्य बङ्गालराज्ये वर्तमानं मण्डलम्।","सः जेस्सोरमण्डलस्य निवासी अस्ति।",["जेस्सोरमण्डलम्","जेस्सोरः"],"मण्डलम्",[]],["n","स्विजरलैण्डदेशे वर्तमानम् एकं नगरम्।","अस्माकं पिता जेनेवानगरम् अगच्छत्।",["जेनेवानगरम्"],"पुरम्",["ಜೆನೆವಾ","ಜಿನಿವಾ"]],["n","नैऋत्य-स्विजरलैण्डदेशस्य तथा च फ्रान्सदेशस्य मध्यभागे स्थितः एकः सरोवरः।","जेनेवानगरं जेनेवासरोवरस्य मध्ये तटे स्थितः अस्ति।",["जेनेवासरोवरः"],"ह्रदः",["ಜೆನೆವಾ ಸರೋವರ","ಜಿನಿವಾ ಸರೋವರ","ಲೇಕ್ ಜೆನೆವಾ","ಲೇಕ್ ಲೆಮನ್"]],["n","एकः पुरुषः ।","जेलकस्य उल्लेखः राजतरङ्गिण्याम् अस्ति",["जेलकः"],"",[]]],"w":{"जेय":[0],"जेमनम्":[1],"जेमन":[1],"जेता":[2],"जेत्री":[2],"जेरुसलमनगरम्":[3],"जेरुसलमनगर":[3],"जेटविमानम्":[4],"जेटविमान":[4],"जेतः":[5],"जेत":[5],"जेस्सोरमण्डलम्":[6],"जेस्सोरमण्डल":[6],"जेस्सोरः":[6],"जेस्सोर":[6],"जेनेवानगरम्":[7],"जेनेवानगर":[7],"जेनेवासरोवरः":[8],"जेनेवासरोवर":[8],"जेलकः":[9],"जेलक":[9]}}