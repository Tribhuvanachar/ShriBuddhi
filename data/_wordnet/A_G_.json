{"s":[["n","कस्मिंश्चित् वस्तुनि अन्येन वस्तुना आहननम्।","तेन दण्डेन आघातः कृतः।",["आघातः","अभिघातः","घातः","आहतिः","हतिः","प्रहारः","ताडनम्","पातः","पातनम्"],"कर्म",["ಏಟು","ಪೆಟ್ಟು","ಹೊಡೆತ"]],["n","बलेन सेनया सह स्वं प्रदेशम् उल्लंघ्य अपरस्य प्रान्ते गमनम्।","शत्रुसेना सीमाभागे आक्रमणम् अकरोत्।",["आक्रमणम्","अभियोगः","अवगोरणम्","अभ्याघातः","आघातः","उपघातः"],"",["ಆಕ್ರಮಣ","ಧಾಳಿ","ಪ್ರಹಾರ","ಬಲಪ್ರಯೋಗ"]],["v","घ्राणेन्द्रियेण गन्धानुभूत्यनुकूलव्यापारः।","सः कुसुमान् आजिघ्रति।",["आघ्रा"],"ज्ञा",["ವಾಸನೆನೋಡು","ಮೂಸು","ಸುವಾಸನೆ ತೆಗೆದುಕೊಳ್ಳು","ಸುಗಂಧ ನೋಡು"]],["n","पेषण्याम् घर्षणेन आघातेन वा पेषणार्थम् उपयुज्यमानः पाषाणखण्डः।","सः उपलेन माषान् पिनष्टि।",["उपलः","आघट्टकः","घर्षणालः","घर्षणी"],"पाकसाधनम्",["ಅರೆಯುವ ಕಲ್ಲು","ಗುಂಡುಕಲ್ಲು","ಒಕ್ಕುವ ಕಲ್ಲು"]],["n","द्वयोः वस्तुनोः परस्परं जातः आघातः।","वृक्षाणां घर्षणेन वने दावाग्निः प्रदीप्तः।",["घर्षणम्","संघर्षः","आघर्षः","आघर्षणम्","अभिघर्षः","अभिघर्षणम्","विघट्टनम्","आघट्टनम्","घर्षः"],"क्रिया",["ಘರ್ಷಣೆಯಾಗುವುದು","ಉಜ್ಜುವುದು","ತೀಡುವುದು"]],["n","आघातनस्य क्रिया।","अद्य तस्य ताडनं भविष्यति।",["ताडनम्","आघातः","प्रहारः","प्रहारकरणम्","प्रहरणम्","आहननम्","विष्पन्दः"],"क्रिया",["ಹೊಡೆಯುವುದು","ಹೊಡೆತ","ಹೊಡೆಯುವಿಕೆ","ಪ್ರಹಾರ"]],["n","एकस्य वस्तुनः अन्येन वस्तुना सह वेगेन जातः स्पर्शः।","तस्य कारयानेन आघातः जातः।",["आघातः","अभ्याघातः"],"क्रिया",["ಹೊಡೆತ","ಪೆಟ್ಟು"]],["n","मृदङ्गादिषु हस्तेन क्रियमाणं ताडनम्।","तस्य बलपूर्णेन आघातेन ऊर्ध्वकः भग्नः जातः।",["आघातः"],"आघातः",["ತಟ್ಟು","ತಟ್ಟುವಿಕೆ"]],["n","कस्यापि प्रदेशस्य वस्तुनः वा विस्तारस्य अन्तिमा रेखा।","भारतदेशस्य सीम्नि सैनिकाः सन्ति।",["सीमा","मर्यादा","आघाटः","अवधिः","मर्या","अणी","आणिः","अणिः","आयत्तिः","अन्तः","अन्तकः","परिसीमा"],"स्थानम्",["ಸೀಮೆ","ಸರಹದ್ದು","ಗಡಿ","ಎಲ್ಲೆ"]],["n","धात्वादिभ्यः विनिर्मितं तत् उपकरणं यद् वस्त्वादिमार्जनार्थे उपयुज्यते।","माता आघर्षण्या वस्त्रगतं कल्मषं दूरीकरोति।",["आघर्षणी","अवलेखनी","इषीका","ईषिका","ईषीका","वर्धनी","विमार्गः","शतमुखम्","शलाका","शोधनी"],"उपकरणम्",["ಬ್ರಷ್"]],["n","सः घृषिखण्डः येन लेखन्या लिखितः लेखः संमार्ज्यते।","सः अयोग्यम् उत्तरम् आघर्षण्या संमार्जयति।",["आघर्षणी"],"साधनम्",["ರಬ್ಬರು"]],["n","घर्षणस्य कर्म।","अश्मनः आघट्टनं पूर्णम् अभवत्।",["आघट्टनम्","आघर्षणम्","निर्घर्षणम्"],"कर्म",["ಮಸೆಯುವಿಕೆ","ತಿಕ್ಕುವಿಕೆ","ಉಜ್ಜುವಿಕೆ"]],["a","यद् आघातेन वर्धयित्वा नैकविधानि आकाराणि धारयति।","केचन धातवः आघातेन वर्धनीयाः सन्ति।",["आघातवर्घनीय"],"",["ಆಘಾತ ವರ್ಧನೀಯ"]],["n","आघर्षस्य क्रिया।","ऊषा पात्रस्य दग्धं भागं अवघर्षणेन मार्ष्टुं प्रयतते।",["अवघर्षणम्","अभिघर्षणम्","अवमर्दनम्","आघर्षणम्","घर्षणम्","निघर्षणम्"],"क्रिया",["ತಿಕ್ಕು","ತಿಕ್ಕಲ್ಪಟು","ಉಜ್ಜು","ತೀಡು"]],["n","प्रहर्तुं निपतनस्य क्रिया।","सिंहस्य आक्रमणेन आहतः पुरुषः रुग्णालयम् आनीयत।",["आक्रमणम्","अभ्याघातः","आघातः","उपघातः"],"कर्म",[]],["n","केनापि अस्त्रेण शस्त्रेण वा कृतः प्रहारः।","ग्रामीणाः आततायिनाम् आक्रमणं कियत्कालपर्यन्तं सहेरन्।",["आक्रमणम्","आघातः","अभ्याघातः","उपघातः"],"आघातः",[]],["n","यज्ञादिषु घृतधारादानम्।","यज्ञस्य अग्निः आघारेण अधिका एव प्रज्वलितः।",["आघारः"],"अग्निहोत्रम्",[]],["a","यः भ्रमति।","सूर्यं परितः आघूर्णितानां ग्रहाणां गतिः भिन्ना वर्तते।",["आघूर्णित","परिभ्रमित"],"",["ಸುತ್ತುತ್ತಿರುವ","ಸುತ್ತುತ್ತಿರುವಂತ","ಸುತ್ತುತ್ತಿರುವಂತಹ","ತಿರುಗು"]],["n","घ्राणस्य क्रिया।","कर्पूरस्य आघ्राणं सुखदायकं भवति।",["आघ्राणम्","अवघ्राणम्"],"सप्तपर्णः",[]],["a","यस्य आघ्राणं क्रियते।","केचन जनाः आघ्रातानि पुष्पाणि भगवते न अर्पयन्ति।",["आघ्रात","घ्रात","शिङ्घित"],"",["ಒಣಗಿದ","ಒಣಗಿದಂತ","ಒಣಗಿದಂತಹ","ಬಾಡಿದ"]],["n","ग्रहणस्य दशसु भेदेषु एकः।","आघ्राते चन्द्रमण्डलस्य सूर्यमण्डलस्य वा कश्चित् भागः मन्दप्रभः दृश्यते।",["आघ्रातम्"],"ग्रहपीडनम्",[]],["a","यस्मिन् आघातः जातः।","आघातितं काष्ठं भग्नं जातम्।",["आघातित"],"",["ಗಾಯಗೊಂಡ","ಗಾಯಗೊಂಡಂತ","ಗಾಯಗೊಂಡಂತಹ"]],["n","गमनसमये शरीरभागस्य केनचित् वस्तुना हननम्।","गमनसमये पाषाणेन आघातः जातः।",["आघातः"],"",[]]],"w":{"आघातः":[0,1,5,6,7,14],"आघात":[0,1,5,6,7,14],"आघ्रा":[2],"आघट्टकः":[3],"आघट्टक":[3],"आघर्षः":[4],"आघर्ष":[4],"आघर्षणम्":[4,11,13],"आघर्षण":[4,11,13],"आघट्टनम्":[4,11],"आघट्टन":[4,11],"आघाटः":[8],"आघाट":[8],"आघर्षणी":[9,10],"आघातवर्घनीय":[12],"आघारः":[16],"आघार":[16],"आघूर्णित":[17],"आघ्राणम्":[18],"आघ्राण":[18],"आघ्रात":[