{"s":[["n","सरलस्य भावः अवस्था वा।","स्वभावस्य सरलता इति गुणः नैकानां विद्वज्जनानाम् स्थायीभावः अस्ति।",["सरलता","सारल्यम्","अमाया","निष्कापट्यम्","अव्याजः","अवक्रता","ऋजुता"],"दशा",["ಸಾಮಾನ್ಯತೆ","ಸಾಧಾರಣವಾದ"]],["a","यः स्वभावतः सुष्ठुः।","सुशीलः पुरुषः स्वस्वभावेन सर्वेषां चित्तं हरति।",["सुशील","सौम्य","सुजन","अभिविनीत","ऋजुः"],"",["ಸೌಮ್ಯ","ಸಾಧು","ಶಾಂತ","ಮೃಧು"]],["n","चित्तस्य सद्वृत्तिः।","अविनाशः शुचितया कार्यं करोति।",["शुचिता","दाक्षिण्यम्","ऋजुता","आर्जवम्","सारल्यम्","अमाया","अकपटः","अव्याजः","न्यायिता"],"नीतिः",["ಪ್ರಾಮಾಣಿಕ","ಸತ್ಯವಂತ","ಸತ್ಯನಿಷ್ಠ","ನಿಷ್ಕಪಟತನ"]],["n","सहजस्य अवस्था भावो वा।","यद् कार्यं मम कृते कठीनम् आसीत् तद् कार्यं अरुणा सहजतया करोति।",["सहजता","सुगमता","सरलता","ऋजुता","आर्जव"],"दशा",["ಸುಲಭವಾಗಿ","ಆಸಾನಾಗಿ","ಸುಖವಾಗಿ","ಸರಳವಾಗಿ"]],["n","लोहादिभ्यः विनिर्मितं वर्तुलाकारं सपाटं पात्रम्।","सा ऋजीषे पौलिं पाचयति।",["ऋजीषम्","अम्बरीषम्","भ्राष्ट्रः","भृज्जनम्"],"भण्डम्",["ಕಾವಲಿ","ಹಂಚು","ಹೆಂಚು","ತವೆ"]],["n","अवक्रम्।","[कु 5.32]",["ऋजु","आर्जवम्","अकुटिलता","अजिह्मता","सरलता"],"",["ನಿಷ್ಕಪಟಲತೆ","ಕಪಟವಿಲ್ಲದ","ಕಪಟಹೀನತೆ","ಸರಳ ಸ್ವಭಾವ"]],["n","पौराणिकः ऋषिविशेषः।","ऋजिस्वनः वर्णनं ऋग्वेदे अस्ति।",["ऋजिस्वा"],"आप्तः",[]],["n","पौराणिकः ऋषिविशेषः।","ऋज्राश्वस्य वर्णनं ऋग्वेदे प्राप्यते।",["ऋज्राश्वः"],"आप्तः",[]],["n","या रेखा सरला अस्ति ।","तिसृणां समश्रेणिनां मेलनेन त्रिकोणः निर्माति ।",["समश्रेणिः","ऋजुलेखा"],"रेखा",[]],["n","यः शुद्धमनः अस्ति ।","सरलाः जनाः सर्वेभ्यः रोचन्ते ।",["सरल","ऋजु"],"",[]],["n","एका नदी ।","ऋजुपालिकायाः उल्लेखः कोषे अस्ति",["ऋजुपालिका"],"",[]]],"w":{"ऋजुता":[0,2,3],"ऋजुः":[1],"ऋजु":[1,5,9],"ऋजीषम्":[4],"ऋजीष":[4],"ऋजिस्वा":[6],"ऋज्राश्वः":[7],"ऋज्राश्व":[7],"ऋजुलेखा":[8],"ऋजुपालिका":[10]}}