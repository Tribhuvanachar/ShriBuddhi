{"s":[["v","प्रकाशनप्रेरणानुकूलः व्यापारः।","पठनसमये सः वातप्रचालितं दीपम् उज्ज्वलयति।",["उद्दीपय","दीपय","आदीपय","अनुभ्राज्","ज्वलय","उज्ज्वलय","अभिज्वलय","संज्वलय","सञ्ज्वलय","उद्भासय","आभासय","अवभासय"],"वि कृ",["ಕಾಂತಿಯನ್ನು ಹೆಚ್ಚಿಸು","ಪ್ರಕಾಶತೆಯನ್ನು ಹೆಚ್ಚಿಸು","ಬೆಳಕನ್ನು ಹೆಚ್ಚಿಸು"]],["a","यः प्रकाशमानः अस्ति।","तस्य वस्त्रणि अमलानि आसन् यद्यपि सः निर्धनः दृश्यते।",["अमल","अनवस्कर","अम्लानिन्","इद्ध","उज्ज्वल","चौक्ष्य","तार","निर्मल"],"",["ಉಜ್ವಲವಾದ","ಉಜ್ವಲವಾದಂತ","ಉಜ್ವಲವಾದಂತಹ","ಪ್ರಕಾಶಮಾನವಾದ"]],["a","यस्मिन् दीप्तिः अस्ति अथवा यस्य वर्णः आभायुक्तः अस्ति।","प्राच्यदेशात् आगतेन तेन दूतेन तत् द्युमत् रत्नं राजसभायां राज्ञे समर्पितम्।",["द्युमत्","द्युतिकर्","द्युतिमत्","द्योतन","द्योति","द्योतमान","उज्वल","कान्तिमत्","किरणमय","उत्प्रभ","उल्लस","उल्लसित"],"",["ಹೊಳೆಯುತ್ತಿರುವ","ಹೊಳೆಯುತ್ತಿರುವಂತ","ಹೊಳೆಯುತ್ತಿರುವಂತಹ","ಮಿಂಚುತ್ತಿದ್ದ"]],["v","चिरकालं यावत् वियोगानुकूलः व्यापारः।","अहं शीघ्रमेव इदं स्थानं त्यक्ष्यामि।",["त्यज्","हा","व्युत्सृज्","उज्झ्","अपास्","मुच्","प्रोज्झ्","प्रहा","विप्रहा","विमुच्","विसृज्","विहा"],"निस्+पीड्",["ಸ್ಥಾನ ಬಿಟ್ಟು ಕೊಡು","ಸ್ಥಾನ ಖಾಲಿ ಮಾಡು","ಸ್ಥಾನ ತ್ಯಾಗ ಮಾಡು"]],["n","यः कञ्चित् देवतुल्यं मत्वा तं भजते तस्य माहात्म्यं च जानाति।","सः गान्धीमहोदयस्य भक्तः अस्ति।",["भक्तः","व्रती","उज्झकः","यतिः","उपासकः"],"मनुष्यः",["ಭಕ್ತ","ಭಕ್ತಿಯುಳ್ಳವ","ಅನುರಾಗಿ","ವಿಭಾಜಿಸಿದ"]],["v","सङ्ग्रामे विपक्षिणां विरुद्धं जयप्राप्त्यनुकूलः व्यापारः।","पाण्डवाः स्वबान्धवानां विरुद्धम् आरब्धं सङ्ग्रामं विजिग्यिरे।",["विजि [आ.प.]","जि","निर्जि","अभिजि","प्रजि","विनिर्जि","उज्जि","अनुरञ्ज्","अभिषह्"],"जि",["ಜಯಗಳಿಸು","ಗೆಲ್ಲು","ವಿಜಯಿಯಾಗು","ಜಯಶಾಲಿಯಾಗು"]],["v","निद्राभावानुकूलः व्यापारः।","सः नैकानि दिनानि यावत् उज्जागर्ति।",["उज्जागृ","जागृ","प्रतिबुध्","प्रतिविबुध्"],"अस्",["ಏಳು","ಎಚ್ಚರವಾಗು ಮಲಗದಿರು","ನಿದ್ದೆ ಮಾಡದಿರು","ನದ್ರೆ ಮಾಡದಿರು"]],["a","यद् प्रकाश्यते।","सूर्यकिरणैः प्रकाशिते शशिनि तैग्म्यं नास्ति।",["प्रकाशित","दीप्तिमत्","प्रदीप्त","उज्वलित"],"",["ಪ್ರಕಾಶಮಾನವಾದ","ಉಜ್ವಲವಾಗಿ"]],["v","वियोगानुकूलः व्यापारः।","रेलयानं स्थानकम् अत्यजत्।",["त्यज्","हा","व्युत्सृज्","उज्झ्","अपास्","मुच्","प्रोज्झ्","प्रहा","विप्रहा","विमुच्","विसृज्","विहा"],"प्रस्थानं कृ",["ಬಿಟ್ಟು"]],["n","प्रतीच्यस्य मध्य-एशियामहाद्वीपस्य एकः देशः।।","उजबेकिस्तानदेशः पूर्वं सोवियते सड़्घे आसीत्",["उजबेकिस्तानदेशः","उजबेकिस्तान-गणराज्यम्"],"",[]],["n","उजबेकिस्तानदेशस्य निवासी।","बहून् उजबेकिस्तानदेशीयान् अहं साधुरुपेण जानामि।",["उजबेकिस्तानदेशीय","उजबेकिस्तानीय"],"निवासी",[]],["n","उजबेकिस्तानदेशे भाषिता भाषा।","श्यामः उजबेकिस्तानदेशीयां-भाषाम् अपि भाषते।",["उजबेकिस्तानदेशीयभाषा"],"भाषा",[]],["a","उजबेकिस्तानदेशेन सम्बद्धम् उजबेकिस्तानदेशस्य वा।","एषा एका उजबेकिस्तानदेशीया नदी अस्ति।",["उजबेकिस्तानदेशीय"],"",["ಉಜಬೆಕಿಸ್ತಾನಿ","ಉಜಬೆಕಿಸ್ತಾನಿನ"]],["n","उजबेकिस्तानदेशे प्रचलिता मुद्रा।","सः उजबेकिस्तानदेशीय-सोमस्य मूल्यं ज्ञातुम् इच्छति।",["उजबेकिस्तानदेशीय-सोमम्"],"मुद्रा",[]],["n","मध्यप्रदेशराज्ये वर्तमानम् एकं मण्डलम्।","उज्जैनमण्डलस्य मुख्यालयः उज्जैननगरे अस्ति।",["उज्जैनमण्डलम्"],"मण्डलम्",[]],["n","भव्यतायाः अवस्था भावः वा।","तस्य राजप्रासादस्य वैभवं सर्वान् आकर्षयति।",["वैभवम्","तेजः","विभूतिः","प्रतापः","शोभा","उज्ज्वलता","प्रभावः","ऐश्वर्यम्","संपद्"],"",["ಭವ್ಯತೆ","ಉಜ್ವಲತೆ","ಶೋಭಾಯಮಾನತೆ","ವೈಭವಪೂರ್ಣತೆ"]],["a","यद् अपिनद्धम् अस्ति।","उद्घाटितात् द्वारात् श्वा प्राविशत्।",["उद्घाटित","उद्घट्टित","उज्जृम्भित","उत्कलित","उत्कीलित"],"",["ತೆರೆದ","ತೆರೆದಂತಹ","ತೆಗೆದ","ತೆಗೆದಿರುವ"]],["a","आभायुक्तः।","सा आकाशे भ्राजस्वत् नक्षत्रम् पश्यति।",["भ्राजस्वत्","भ्राजस्विन्","उज्ज्वलित","उत्प्रभ","उद्द्योत्"],"",["ಝಗಮಗಿಸುವ","ಮಿನುಗುತ್ತಿರುವ ಹೊಳೆಯುತ್ತಿರುವ"]],["n","नमाजात् प्राक् क्रियमाणा मुखहस्तादेः प्रक्षालनक्रिया ।","वजूक्रियायाः अनन्तरं सः नमाजं करोति ।",["वजूक्रिया","उजूक्रिया"],"कर्म",[]],["n","मुद्राविशेषः- बादशाहस्य काले वर्तमाना एका बृहती मुद्रा ।","राजा वीरसेवकाय पारितोषकरूपेण काचन उजकमुद्राः अयच्छत् ।",["उजकमुद्रा"],"सुवर्णमुद्रा",[]],["v","मार्जनेन स्वच्छीकरणानुकूलः व्यापारः।","सेविका भाण्डानि उज्ज्वलयति।",["उज्ज्वलय"],"कृ",["ತೊಳೆ","ಸ್ವಚ್ಚ ಮಾಡು","ಸ್ವಚ್ಚಗೊಳಿಸು"]],["v","अन्धःकारापनयनानुकूलः व्यापारः।","सायङ्काले दीप्रज्वलनेन गृहं प्रकाश्यते।",["प्रकाशय","उज्ज्वलय"],"कृ",["ಬೆಳಕು ಬರುವಂತೆ ಮಾಡು","ಪ್ರಕಾಶಮಾನವಾಗಿ ಮಾಡು"]],["n","वर्णवृत्तविशेषः।","उज्वलायां नगणः, नगणः, नगणः तथा रगणः भवन्ति।",["उज्वला","उज्ज्वला"],"वृत्तम्",[]],["n","एकः पुरुषः ।","उज्जयनस्य उल्लेखः महाभारते अस्ति",["उज्जयनः"],"",[]],["n","एकं स्थानम् ।","उज्जालुकस्य उल्लेखः महाभारते अस्ति",["उज्जालुकः"],"",[]],["n","काचन ऋचः ।","उज्जितेः उल्लेखः वाजसनेयि-संहितायाम् अस्ति",["उज्जितिः"],"",[]],["n","एकः जनसमुदायः ।","उज्जिहानानाम् उल्लेखः वराहमिहिरस्य बृहत्संहितायाम् अस्ति",["उज्जिहानः"],"",[]],["n","एकः ग्रामः ।","उज्जिहानायाः उल्लेखः रामायणे अस्ति",["उज्जिहाना"],"",[]],["n","एकं स्थानम् ।","उज्जूटडिम्बस्य उल्लेखः राजतरङ्गिण्याम् अस्ति",["उज्जूटडिम्बम्"],"",[]],["n","एकः पुरुषः ।","उज्जेन्द्रस्य उल्लेखः राजतरङ्गिण्याम् अस्ति",["उज्जेन्द्रः"],"",[]]],"w":{"उज्ज्वलय":[0,20,21],"उज्ज्वल":[1],"उज्वल":[2],"उज्झ्":[3,8],"उज्झकः":[4],"उज्झक":[4],"उज्जि":[5],"उज्जागृ":[6],"उज्वलित":[7],"उजबेकिस्तानदेशः":[9],"उजबेकिस्तानदेश":[9],"उजबेकिस्तान-गणराज्यम्":[9],"उजबेकिस्तान-गणराज्य":[9],"उजबेकिस्तानदेशीय":[10,12],"उजबेकिस्तानीय":[10],"उजबेकिस्तानदेशीयभाषा":[11],"उजबेकिस्तानदेशीय-सोमम्":[13],"उजबेकिस्तानदेशीय-सोम":[13],"उज्जैनमण्डलम्":[14],"उज्जैनमण्डल":[14],"उज्ज्वलता":[15],"उज्जृम्भित":[16],"उज्ज्वलित":[17],"उजूक्रिया":[18],"उजकमुद्रा":[19],"उज्वला":[22],"उज्ज्वला":[22],"उज्जयनः":[23],"उज्जयन":[23],"उज्जालुकः":[24],"उज्जालुक":[24],"उज्जितिः":[25],"उज्जिति":[25],"उज्जिहानः":[26],"उज्जिहान":[26],"उज्जिहाना":[27],"उज्जूटडिम्बम्":[28],"उज्जूटडिम्ब":[28],"उज्जेन्द्रः":[29],"उज्जेन्द्र":[29]}}