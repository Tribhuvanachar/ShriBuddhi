{"s":[["n","वृक्षस्य तद्भागः यस्योपरि शाखाः विलसन्ति।","अस्य वृक्षस्य नालः कृशः अस्ति।",["नालः","दण्डः","वोण्टः","स्तम्भः","वृन्तम्","काण्डः","काण्डम्"],"वनस्पति-अङ्गम्",["ಬೊಡ್ಡೆ","ಬುಡು"]],["n","क्षुपस्य शाखा।","बालकः क्षुपस्य काण्डम् उद्भिनत्ति।",["काण्डः","काण्डम्","प्रकाण्डः","प्रकाण्डम्","स्तम्भः","नालः","दण्डः","वोण्टः","वृन्तम्"],"वनस्पति-भागः",["ಕಾಂಡ","ದಂಟು","ಬಡ್ಡೆ","ತುಂಬು"]],["n","सः कर्मकरः यः स्थानके यात्रिणां भारवहनस्य कार्यं करोति।","स्थिते अग्नियाने भारवाहकाः अधावन्।",["भारवाह","भारवाहकः","भारवाही","भारवाहिकः","भारिकः","भारी","भारहरः","भारहारी","भारहारकः","वोढा"],"कर्मकरः",["ಕೂಲಿ"]],["n","एका रुष्यदेशीया सुरा या रङ्गहीना गन्धहीना च भवति।","तेन मद्यालयात् वोडकायाः कूपी क्रीता।",["वोडका"],"मद्यम्",["ವೋಡ್ಕಾ"]],["n","भारतदेशस्य नागालॅण्डराज्ये वर्तमानं मण्डलम्।","वोखामण्डलस्य मुख्यालयः वोखानगरे अस्ति।",["वोखामण्डलम्"],"मण्डलम्",[]],["n","भारतदेशस्य नागालॅण्डराज्ये वर्तमानं नगरम्।","इदानीं वोखानगरे निवासः मह्यं न रोचते।",["वोखानगरम्"],"पुरम्",[]],["n","रूस-देशस्य एका नदी।","वोल्गा नदी महत्तरा अस्ति",["वोल्गा","वोल्गानदी"],"नदी",[]],["n","यः वैधरूपेण लेखं प्रतिलिखति।","कार्यालये लिपिकारस्य अनुपस्थित्या नैकानि कार्याणि न अभवन्।",["लिपिकारः","लेखकः","वोरकः","अक्षरचणः","अक्षरचञ्चुः"],"मनुष्यः",[]],["n","एकं स्थानम् ।","वोक्काणस्य उल्लेखः दिव्यावदाने अस्ति",["वोक्काणः"],"",[]],["n","एकः जनसमुदायः ।","वोक्काणानाम् वर्णनं वराह-मिहिरयोः बृहत्संहितायाम् अस्ति",["वोक्काणाः"],"",[]],["n","एका राजकुमारी ।","वोन्थादेव्याः वर्णनं प्रशस्तिषु अस्ति",["वोन्थादेवी"],"",[]],["n","एकः पुरुषः ।","वोपुलस्य वर्णनं वीरचरिते अस्ति",["वोपुलः"],"",[]]],"w":{"वोण्टः":[0,1],"वोण्ट":[0,1],"वोढा":[2],"वोडका":[3],"वोखामण्डलम्":[4],"वोखामण्डल":[4],"वोखानगरम्":[5],"वोखानगर":[5],"वोल्गा":[6],"वोल्गानदी":[6],"वोरकः":[7],"वोरक":[7],"वोक्काणः":[8],"वोक्काण":[8],"वोक्काणाः":[9],"वोक्काणा":[9],"वोन्थादेवी":[10],"वोपुलः":[11],"वोपुल":[11]}}