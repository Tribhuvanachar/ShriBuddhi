{"s":[["n","अवयवविशेषः- कक्षाद्यङ्गुल्यग्रपर्यन्तावयवविशेषः येन वस्तूनि ध्रियन्ते कार्यं च क्रियते।","बलिनौ भीमस्य बाहू।",["बाहुः","भुजा","करः","प्रवेष्टः","दोः","दोषः","बाहः","आयाती","च्यवना","अनीशू","अप्लवाना","विनङ्गृसौ"],"बाह्य-शारीरिक-भागः",["ಭುಜ","ಕೈ","ಕರ","ತೋಳು"]],["a","स्थानसिद्धान्तादिभ्यः दूरे गतः।","सः मार्गात् भ्रष्टःअस्ति।",["भ्रष्ट","च्युत","विचलित","स्खलित","विकृष्ट","मोहित","विमोहित","व्यग्र","व्याकुल","खण्डित","व्यस्तचित्त"],"",["ವಿಚಲಿತವಾದ","ವಿಚಲಿತವಾದಂತ","ವಿಚಲಿತವಾದಂತಹ","ಚಂಚಲವಾದ"]],["a","यः सदाचारादिभ्यः भ्रष्टः।","पतितः व्यक्तिः समाजं रसातलं नयति।",["पतित","अनुपतित","अधोगत","अधोपतित","अवनत","अपकृष्ट","अपभ्रंशित","अबतर","अवरोहित","च्यूत","स्खलित","अपभ्रंशित"],"",["ನೀತಿಗೆಟ್ಟ","ಭ್ರಷ್ಟತನದ","ವಿಷಯಲಂಪಟತನದ","ಅತಿ ಭೋಗದ"]],["a","यः स्वस्थानात् दूरीभूतः।","स्वाधिकारात् भ्रष्टः राजा वनं गतः।",["भ्रष्ट","अपगत","च्युत"],"",["ಪದಚ್ಯುತಿ","ಬಿದ್ದ","ಪತಿತ","ಭ್ರಷ್ಟ"]],["v","विशिष्य द्रवपदार्थस्य उच्चैः स्थानात् अधोदेशसंयोगानुकूलः व्यापारः।","समुद्रे नदीनां जलं पतति।",["पत्","प्रपत्","अवपत्","भृश्","निपत्","च्यु","अवगल्","प्रच्यु","अवार्छ्","अवपद्","अभिव्ली","स्रंस्"],"पत्",["ಪ್ರವಾಹ ಉಂಟಾಗು","ಸೆಲೆ ಉಂಟಾಗು","ಪ್ರವಾಹವಾಗಿ ಬೀಳು","ಸೆಲೆಯಾಗಿ ಬೀಳು"]],["v","नाशानुकूलः व्यापारः।","धनस्य लिप्सायाः कारणात् सः प्राणान् अजिहीत।",["हा","विहा","वियुज्य","अपचि","च्यु","प्रच्यु","उपदस्","विराध्"],"अस्",["ಕಳೆದುಕೊಳ್ಳು","ಕಳಕೊಳ್ಳು"]],["n","आयुर्वेदिकं बलवर्धकं भेषजम्।","पितामहः प्रतिदिनं प्रातः च्यवनप्राशम् अत्ति।",["च्यवनप्राशः"],"अगदः",["ಚವನ್ ಪ್ರಾಶ"]],["a","अधिकारात् अपसारितः।","भूमिपतिना कृषीवलः तस्य भूमेः पदच्युतः कृतः।",["पदच्युत","च्युताधिकार"],"",["ಪದಚ್ಯುತಿಯಾದ","ಪದಚ್ಯುತಿಯಾದಂತ","ಪದಚ್ಯುತಿಯಾದಂತಹ","ಪದಚ್ಯುತವಾದ"]],["v","उच्चैः स्थानात् अधोदेशसंयोगानुकूलव्यापारः।","सः अश्वात् पतति।",["पत्","प्रपत्","अवपत्","भृश्","निपत्","च्यु","अवगल्","प्रच्यु","अवार्छ्","अवपद्","अभिव्ली","स्रंस्"],"अस्",["ಬೀಳು"]],["n","योनेः तटीयः भागः।","बलात्कारिणः दुष्कर्मात् महिलायाः धारका भग्ना।",["धारका","अपस्करः","उल्बः","च्युति"],"शारीरिकभागः",[]],["n","भृगुऋषेः एकः पुत्रः।","च्यवनऋषिः पुलोमायाः गर्भात् जातः।",["च्यवनऋषिः","च्यवनः"],"आप्तः",[]],["n","यस्य अधिकारात् निराकरणं कृतम् ।","पदच्युतः कर्मकरः अन्यम् उद्योगम् अन्विषति ।",["पदच्युत","च्युताधिकार","भ्रष्टाधिकार"],"",[]],["n","एकः पुरुषः ।","च्यवतानस्य उल्लेखः ऋग्वेदे अस्ति",["च्यवतानः"],"",[]],["n","एकः असुरः ।","च्यवनः प्रवरग्रन्थेन परिगणितः",["च्यवनः"],"",[]],["n","एका अवलेहिका ।","च्यवनप्राशस्य उल्लेखः मल्लप्रकाशे वर्तते",["च्यवनप्राशः"],"",[]],["n","पद्मपुराणस्य अपरं नाम ।","च्यवनसमागमस्य उल्लेखः कोषे अस्ति",["च्यवनसमागमः"],"",[]]],"w":{"च्यवना":[0],"च्युत":[1,3],"च्यूत":[2],"च्यु":[4,5,8],"च्यवनप्राशः":[6,14],"च्यवनप्राश":[6,14],"च्युताधिकार":[7,11],"च्युति":[9],"च्यवनऋषिः":[10],"च्यवनऋषि":[10],"च्यवनः":[10,13],"च्यवन":[10,13],"च्यवतानः":[12],"च्यवतान":[12],"च्यवनसमागमः":[15],"च्यवनसमागम":[15]}}