{"s":[["n","अवयवविशेषः- पृष्ठस्य अस्थियुक्तः वंशः।","पद्मासने पृष्ठवंशं सरलीकृत्य उपवेष्टव्यम्।",["पृष्ठवंशः","रीढकः","कशेरुः","कशेरु","पृष्ठास्थिः"],"अस्थि",["ಬೆನ್ನೆಲುಬು","ಕಶೇರು ಮೂಳೆ","ಬೆನ್ನಿನ ಮೂಳೆ","ಬೆನ್ನಿನ ಎಲುಬು"]],["n","समाजे  अन्यैः सह कृतम् आचरणम्।","तस्य व्यवहारः सम्यक् नास्ति।",["व्यवहारः","वृत्तिः","वृत्तम्","आचारः","रीतिः","चरित्रम्","चरितम्","आचरणम्","गतिः","चेष्टितम्","स्थितिः"],"कर्म",["ನಡವಳಿಕೆ","ನಡಾವಳಿ","ವರ್ತನೆ","ಆಚಾರ-ವಿಚಾರ"]],["n","सा पद्धतिः या दीर्घकालं यावत् अक्षुण्णतया प्रचलति।","अस्माकं समाजस्य विवाहस्य परम्परा भिन्ना अस्ति।",["परम्परा","रीतिः","प्रथा"],"क्रिया",["ಮತಾಚರಣೆ","ಧಾರ್ಮಿಕವಿಧಿ","ಸಂಸ್ಕಾರ","ಕರ್ಮ"]],["n","जीवने वर्तनस्य रीतिः।","साधोः आचारात् सः समाजे प्रतिष्ठाम् अलभत।",["वृत्तिः","वृत्तम्","आचारः","रीतिः","व्यवहारः","चरित्रम्","चरितम्","आचरणम्","गतिः","चेष्टितम्","स्थितिः"],"कर्म",["ಚರಿತೆ","ಚಾರಿತ್ರ್ಯ","ಜೀವನ ಚರಿತೆ","ಚರಿತ್ರೆ"]],["n","लोहादिषु उद्भूतं तद् कृष्णम् आवरणं यद् वातेन तथा च आर्द्रतायाः प्रभावेन उत्पद्यते।","लोहे किट्टम् आगतम्।",["किट्टम्","धूर्तम्","तिमिरम्","पात्रटीरः","मण्डूरम्","रीतिः","लोष्टम्","सिंहाणम्"],"रासायनिकपदार्थः",["ತುಕ್ಕು","ಕಿಲುಬು"]],["n","कार्यादीनां विधिः।","एतया रीत्या कृतेन कार्येण अग्रे समस्या भविष्यति।",["रीतिः","पद्धतिः","शैली"],"कर्म",["ಕಾರ್ಯಶೈಲಿ","ರೀತಿ"]],["n","धातुविशेषः, पीतवर्णीयः रीतिकायुगुलगुणयुक्तधातुः।","पाण्डुरोगी तु योत्यर्थं पित्तलानि निषेवते तस्य पित्तमसृङ्मांसं दग्ध्वा रोगाय कल्पते।",["पित्तलम्","आरकूटः","रीतिः","पतिकावेरम्","द्रव्यदारु","रीती","मिश्रम्","आरः","राजरीतिः","ब्रह्मरीतिः","कपिला","पिङ्गला"],"धातुः",["ಹಿತ್ತಾಳೆ","ಹಿತ್ತಳೆಲೋಹ"]],["n","फलविशेषः, स्वनामख्यातस्य वृक्षस्य फलम् आयुर्वेदे अस्य वातकफकुष्ठकण्डूतिविषविष्फोटनाशित्वादि गुणाः प्रोक्ताः।","रीठया वस्त्रान् प्रक्षालयेत्",["रीठा","करञ्जकः","अरिष्टः","मङ्गल्यः","कुम्भबीजकः","प्रतीर्यः","सोमवल्कः","फेणिलः","गुच्छकः","गुच्छपुष्पकः","गुच्छफलः"],"फलम्",["ಅಂಟವಾಳದ ಕಾಯಿ","ಅಂಟವಾಳದ-ಕಾಯಿ"]],["n","सा शरीरस्य क्रिया यया मनसि स्थिताः भावाः प्रकटीभवन्ति।","सहयात्रिणः वृत्तिं दृष्ट्वा वयं जागरुकाः अभवम्।",["वृत्तिः","वर्तनम्","आचरणम्","रीतिः","स्थितिः"],"क्रिया",["ನಡವಳಿಕೆ","ಹಾವ-ಭಾವ","ಅಂಗಚಲನೆ"]],["n","शृङ्गारादेः नूतना पद्धतिः।","महाविद्यालये छात्राः नव्यताम् आचरन्ति।",["नव्यता","रीतिः"],"रीतिः",["ಫ್ಯಾಷನ್"]],["n","कार्यसञ्चालनस्य प्रणालिः।","इह संसारे सर्वं नियतेः विधिम् अनुसृत्य एव प्रचलति।",["विधिः","विधानम्","रीतिः","पद्धतिः"],"पद्धतिः",["ವಿಧಾನ"]],["v","बन्धनात् वियोगानुकूलः व्यापारः।","मत्स्यः जालकात् अमुञ्चत्।",["मुच्","प्रतिमुच्","प्रमुच्","विमुच्","विप्रयुज्","रिच्","री","विबाध्","विषो"],"पृथग्भू",["ತಪ್ಪಿಸು","ತಪ್ಪಿಹೋಗು"]],["n","भाषाकलासङ्गीतादीनाम् अभिव्यक्तेः प्रत्येकस्य मनुष्यस्य समुदायस्य वा वैशिष्ट्यम्।","सर्वे पत्रकाराः वर्तमानपत्राणां रीतिम् अनुसर्तुम् इच्छन्ति।",["रीतिः","पद्धतिः"],"रीतिः",["ಶೈಲಿ","ಅಭಿವ್ಯಂಜಕ"]],["n","लाट्वियादेशस्य राजधानी।","रीगानगरं लाट्वियादेशस्य महिष्ठं नगरम्।",["रीगानगरम्"],"राजधानी",[]],["n","मध्यप्रदेशस्य नगरविशेषः।","सः रीवानगरस्य केन्द्रीये कारागारे  दण्डं आजीवम् सहते।",["रीवानगरम्"],"पुरम्",[]],["n","मध्यप्रदेशराज्ये वर्तमानम् एकं मण्डलम्।","रीवामण्डलस्य मुख्यालयः रीवानगरे अस्ति।",["रीवामण्डलम्"],"मण्डलम्",[]],["n","भारतदेशस्य मिजोरामराज्ये वर्तमानं मण्डलम्।","रीभोईमण्डलस्य मुख्यालयः नोङ्गपोहनगरे अस्ति।",["रीभोईमण्डलम्"],"मण्डलम्",[]],["n","विशिष्टे काले जनेषु वर्तमाना रुचिः।","1920तमे वर्षे काचित् भिन्ना एव रीतिः आसीत्।",["रीतिः"],"अभिरुचिः",[]],["n","लोहस्य किट्टम्।","लोहनिर्मितेषु वस्तुषु वर्णं लेपयित्वा अयःकिट्टात् रक्षणं शक्यते।",["अयःकिट्टम्","अयोमलम्","किट्टालः","पात्रटीरः","मण्डूरम्","रीतिः","लोष्टम्","लोहकिट्टम्","लोहचूर्णम्","लोहमलम्","सिंहाणम्","सिङ्घाणम्"],"किट्टम्",[]]],"w":{"रीढकः":[0],"रीढक":[0],"रीतिः":[1,2,3,4,5,6],"रीति":[1,2,3,4,5,6],"रीती":[6],"रीठा":[7],"री":[11],"रीगानगरम्":[13],"रीगानगर":[13],"रीवानगरम्":[14],"रीवानगर":[14],"रीवामण्डलम्":[15],"रीवामण्डल":[15],"रीभोईमण्डलम्":[16],"रीभोईमण्डल":[16]}}