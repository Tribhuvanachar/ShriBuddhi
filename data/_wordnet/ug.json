{"s":[["n","लताविशेषः-यस्य फलं कटुः तथा च रक्तपित्तरोगे सुपथ्यकारी।","सः कारवेल्ले कीटनाशकभेषजं सिञ्चयति।",["कारवेल्लः","कठिल्लकः","सुषवी","शुषवी","कण्डुरः","कण्डकटुकः","सुकाण्डः","उग्रकाण्डः","कठिल्लः","नासासम्बेदनः","पटुः"],"लता",["ಹಾಗಲಕಾಯಿ"]],["n","मथुरायाः राज्ञः उग्रसेनस्य पुत्रः।","कंसः एकः अत्याचारी शासकः आसीत्।",["कंसः","कंसासुरः","उग्रसेनजः"],"पौराणिकपुरुषः",["ಕಂಸ","ಕಂಸಾಸುರ"]],["n","ओषधीविशेषः, यस्य सगन्धानि बीजानि भाजने तथा च भेषजे उपयुज्यन्ते अस्य गुणाः कटुत्वं तिक्तत्वं उष्णत्वं वात-अर्शः-श्लेष्म-शूल-अष्मान्-अकृमि-नाशित्वम् च।","यवान्यः बीजानि पत्राणि च सुगन्धितानि सन्ति।",["यवानी","यवानिका","दीप्यकः","दीप्यः","यवसाह्वः","यवाग्रजः","दीपनी","उग्रगन्धा","वातारिः","भूकदम्बकः","यवजः","दीपनीयः"],"क्षुपः",["ಓಮುಕಾಳು","ಓಮಕ್ಕಿ"]],["n","ओषधीबीजविशेषः यवान्यः सगन्धानि बीजानि ये भाजने तथा च भेषजे उपयुज्यन्ते अस्य गुणाः कटुत्वं तिक्तत्वं उष्णत्वं वात-अर्शः-श्लेष्म-शूल-अष्मान्-अकृमि-नाशित्वम् च।","यवानी पाचनी रुच्या तीक्ष्णोष्णा कटुका लघुः।",["यवानी","यवानिका","दीप्यकः","दीप्यः","यवसाह्वः","यवाग्रजः","दीपनी","उग्रगन्धा","वातारिः","भूकदम्बकः","यवजः","दीपनीयः"],"",["ಅಜಗಂಧ","ಅಜ್ವಾನ"]],["a","बलेन सह।","प्रबलेन वेगेन वायुः वहति।",["प्रबल","सबल","स्वोजस्","सौजस्","अतिबल","अदभ्र","उग्र","उद्बल","ऊर्जावत","ऊर्जस्वत्","तवस्वत्","तव्य"],"",["ಪ್ರಬಲವಾದ","ಪ್ರಬಲವಾದಂತ","ಪ್ರಬಲವಾದಂತಹ"]],["a","यः उग्रवादस्य समर्थनं करोति।","उग्रवादी पुरुषः राष्ट्रे हिंसां संवर्धयति।",["उग्रवादिन्","उग्रपन्थिन्"],"",["ಉಗ್ರವಾದಿ","ಉಗ್ರವಾದಿಯಾದ","ಉಗ್ರವಾದಿಯಾದಂತ","ಉಗ್ರವಾದಿಯಾದಂತಹ"]],["n","मथुरानरेशः यः कंसस्य पिता आसीत्।","कंसः उग्रसेनम् अबध्नात्।",["उग्रसेनः"],"पौराणिकपुरुषः",["ಉಗ್ರಸೇನ"]],["a","यः मृदु अथवा कोमलः न अस्ति।","मम पितुः हृदयं नारिकेलवत् कठोरम् अस्ति।",["कठोर","दृढ","हठधर्मिन्","उग्र"],"",["ಕಟ್ಟುನಿಟ್ಟಾದ","ಕಟ್ಟುನಿಟ್ಟಾದಂತ","ಕಟ್ಟುನಿಟ್ಟಾದಂತಹ","ಕರಾರುವಕ್ಕಾದ"]],["a","यस्य व्यवहारः कठोरः अस्ति।","अस्माकं प्रधानाचार्यः  उग्रशासकः अस्ति ।",["उग्रशासक"],"",["ಕಟ್ಟುನಿಟ್ಟಾದ","ಕಟ್ಟುನಿಟ್ಟಾದಂತ","ಕಟ್ಟುನಿಟ್ಟಾದಂತಹ","ಬಿಗಿಯಾದ"]],["n","मूषकजातीयः जन्तुः।","कर्कशा मृदानिर्मितगृहे इतस्ततः भ्राम्यन्ती दृश्यते।",["कर्कशा","कुशीला","वामशीला","वक्रशीला","दुःशीला","उग्रशीला"],"जरायुजजन्तुः",["ಹೆಗ್ಗಣ","ದೊಡ್ಡ ಇಲಿ","ಸೊಂಡಿಲಿ"]],["n","विषवृक्षविशेषः।","वत्सनाभः मधुरः अस्ति।",["वत्सनाभः","अमृतम्","विषम्","उग्रम्","महौषधम्","गरलम्","मारणम्","नागः","स्तौकृंकम्","प्राणहारकम्","स्थावरादि"],"विषम्",["ಸ್ಪ್ರಿಕ್ನಾಸ್","ಸ್ಪ್ರಿಕ್ನೀನ್"]],["n","सः राजनीतिकसिद्धान्तः यः असंयतः तथा च असामञ्जस्यं वर्धयति।","उग्रवादः समाजस्य विकासाय बाधकः।",["उग्रवादः"],"सिद्धान्तः",["ಉಗ್ರವಾದ"]],["n","एकः क्षुपः  यद् व्यञ्जनरूपेण उपयुज्यते अस्य गुणाः ऊनत्वम्, गुरुत्वम्, उष्णत्वम्, कफवातनाशित्वम्, अश्रुचित्वम्, क्रिमिहृद्रोगशोहघ्नत्वम् रसायनत्वञ्च ।","तिक्तिकां निर्मातुं सः क्षेत्रात् हरितं लशुनं औन्मूलयत्।",["लशुनम्","रसुनः","महौषधम्","गृञ्जनः","अरिष्टः","महाकन्दः","रसोनकः","रसोनः","म्लेच्छकन्दः","भूतघ्नः","उग्रगन्धः"],"क्षुपः",["ಬೆಳ್ಳುಳ್ಳಿ"]],["n","यः उग्रवादस्य समर्थकः अस्ति।","आरक्षकाः चत्वारान् उग्रवादीन् अगृह्णन्।",["उग्रवादी"],"समर्थकः",["ಉಗ್ರವಾದಿ","ಆಂತಕವಾದಿ"]],["n","काव्ये नवरसेषु एकः।","रौद्रे क्रोधसूचकोक्तीनां वर्णनं भवति।",["रौद्रम्","उग्रम्"],"रसः",[]],["n","हिंसया युक्तं कर्म।","अपकर्मणि रतः मनुष्यः सदैव अशान्तः एव भवति।",["अपकर्म","विभ्रमः","उग्रता","उग्रत्वम्","तीव्रता","प्रसाहः"],"कर्म",[]],["n","कर्कशस्य अवस्था अथवा भावः।","एकदा अहमपि तेषां कार्कश्यस्य लक्ष्यम् अभवम्।",["कार्कश्यम्","रूक्षता","पारुष्यम्","काठिन्यम्","निष्ठुरता","कठोरता","उग्रता"],"",["ಕರ್ಕಶತೆ","ಒರಟುತನ","ಗಡುಸುತನ","ಬಿರುಸುತನ"]],["n","विशेषेण कच्छभूमौ कुल्यादीनां तटे वा उपलभ्यमानं किञ्चन औषधीयं सस्यम् ।","उग्रगन्धस्य मूलस्य उपयोगः कासः मूत्ररोगः मानसिकरोगः इत्यादीनां कृते क्रियते ।",["उग्रगन्धः","शतपर्वः"],"क्षुपः",[]],["n","विषवृक्षविशेषः।","वत्सनाभस्य मूलेभ्यः विषं प्राप्यते।",["वत्सनाभः","विषम्","उग्रम्","महौषधम्","गरलम्","मारणम्","स्तौङ्ककम्"],"क्षुपः",[]],["n","राज्ञः परीक्षितस्य पुत्रः।","उग्रसेनस्य वर्णनं पुराणेषु प्राप्यते।",["उग्रसेनः"],"पौराणिकपुरुषः",[]],["n","धृतराष्ट्रपुत्रः।","उग्रसेनस्य वर्णनं धार्मिकेषु ग्रन्थेषु प्राप्यते।",["उग्रसेनः"],"कुरुवंशी",[]],["n","धृतराष्ट्रस्य पुत्रः।","उग्रायुधस्य वर्णनं पुराणे वर्तते।",["उग्रायुधः"],"पौराणिकपुरुषः",[]],["n","देवतागणः।","रुद्राः एकादश सन्ति।",["रुद्राः","अहिर्बुध्न्याः","उग्रः","खरः","जयन्तः","वक्रः"],"देवः",[]],["n","क्षत्रियपित्रा शूद्रमातरि उत्पन्नः सङ्करः जातिविशेषः।","उग्राणां स्वभावः उग्रः क्रूरश्च भवतीति मन्यते।",["उग्रः"],"सङ्करजातिः",[]],["n","ज्योतिःशास्त्रानुसारं पूर्वफाल्गुनीपूर्वाषाढपूर्वभाद्रपदमघाभरण्यात्मकः नक्षत्रगणसमूहः।","उग्रस्य स्वभावः एव प्रबलः मन्यते।",["उग्रः"],"वर्ग",[]],["n","दानवविशेषः।","उग्रस्य वर्णनं पुराणेषु प्राप्यते।",["उग्रः"],"असुरः",[]],["n","धृतराष्ट्रस्य शतपुत्रेषु एकः।","उग्रस्य उल्लेखः महाभारते प्राप्यते।",["उग्रः"],"पौराणिकपुरुषः",[]],["n","साहित्ये वर्तमानः सः संचारी भावः यस्मिन् क्रोधादेः कारणात् मनसि दयास्नेहादयः मृदुभावाः नष्टप्रायाः भवन्ति ।","एतेषु पदेषु उग्रता सुस्पष्टं दृश्यते ।",["उग्रता"],"",[]],["n","यद् मूलपर्यन्तं वर्तते ।","कुव्यवस्थां परिवर्तयितुं व्यवस्थायाम् मौलिकस्य परिवर्तनस्य आवश्यकता अस्ति ।",["मौलिक","उग्र","मौल"],"",["ಆಮೂಲ","ಆಮೂಲದ","ಆಮೂಲವಾದ","ಆಮೂಲವಾದಂತ"]],["n","एका ओषधीया वनस्पतिः ।","वचा वातनाशिका, कृमिनाशिका च वर्तते ।",["वचा","उग्रगन्धा","षड्ग्रन्था","गोलोमी","शतपर्विका","तीक्ष्णा","जटिला","मङ्गल्या","विजया","उग्रा","रक्षोघ्नी","वच्या"],"मूलम्",[]],["n","अधिकया मात्रया यद् सोढुं कठिनम् ।","नागपूरनगरे असह्या उष्णता वर्तते ।",["असह्य","तीव्र","उग्र"],"",["ಬಿರುಸು","ಬಿರುಸಾದ","ಬಿರುಸಾದಂತ","ಬಿರುಸಾದಂತಹ"]],["n","एकः आचार्यः ।","उग्रः नरेन्द्रादित्यस्य आचार्यः आसीत्",["उग्रः"],"",[]],["n","एकः दानवः ।","उग्रस्य वर्णनं पुराणे वर्तते",["उग्रः"],"",[]],["n","एकः देशः ।","उग्रस्य उल्लेखः कोषे अस्ति",["उग्रः"],"",[]],["n","एका जातिः ।","उग्रस्य वर्णनं स्मृतिग्रंन्थेषु वर्तते",["उग्रः"],"",[]],["n","धृतराष्ट्रस्य एकः पुत्रः ।","उग्रस्य वर्णनम् महाभारते वर्तते",["उग्रः"],"",[]],["n","नरेन्द्रादित्यस्य गुरुः ।","उग्रस्य उल्लेखः कोषे अस्ति",["उग्रः"],"",[]],["n","एकः देशः ।","उग्रः इति मलबारदेशस्य नाम आसीत्",["उग्रः","मलबारः"],"",[]],["n","एकः पुरुषः ।","उग्रदेवस्य उल्लेखः तैत्तिरीय-आरण्यके अस्ति",["उग्रदेवः"],"",[]],["n","एकः राजा ।","उग्रभटस्य उल्लेखः कथासरित्सागरे अस्ति",["उग्रभटः"],"",[]],["n","रोगस्य कारणः एकः दानवः ।","उग्रमयस्य उल्लेखः हरिवंशे अस्ति",["उग्रमयः"],"",[]],["n","एकः पुरुषः ।","उग्रश्रवसः उल्लेखः महाभारते अस्ति",["उग्रश्रवाः"],"",[]],["n","राजपुत्रनामविशेषः ।","उग्रसेनः इति नामकानां नैकेषां राजपुत्राणाम् उल्लेखः शतपथ-ब्राह्मणे महाभारते च अस्ति",["उग्रसेनः"],"",[]],["n","एकः लेखकः ।","उग्राचार्यस्य उल्लेखः कोषे अस्ति",["उग्राचार्यः"],"",[]],["n","एकः राजपुत्रः ।","उग्रायुधस्य वर्णनं पुराणे वर्तते",["उग्रायुधः"],"",[]],["n","एकः राजपुत्रः ।","उग्रायुधस्य उल्लेखः कोषे अस्ति",["उग्रायुधः"],"",[]]],"w":{"उग्रकाण्डः":[0],"उग्रकाण्ड":[0],"उग्रसेनजः":[1],"उग्रसेनज":[1],"उग्रगन्धा":[2,3,29],"उग्र":[4,7,10,14,18,22],"उग्रवादिन्":[5],"उग्रपन्थिन्":[5],"उग्रसेनः":[6,19,20,42],"उग्रसेन":[6,19,20,42],"उग्रशासक":[8],"उग्रशीला":[9],"उग्रम्":[10,14,18],"उग्रवादः":[11],"उग्रवाद":[11],"उग्रगन्धः":[12,17],"उग्रगन्ध":[12,17],"उग्रवादी":[13],"उग्रता":[15,16,27],"उग्रत्वम्":[15],"उग्रत्व":[15],"उग्रायुधः":[21,44,45],"उग्रायुध":[21,44,45],"उग्रः":[22,23,24,25,26,31],"उग्रा":[29],"उग्रदेवः":[38],"उग्रदेव":[38],"उग्रभटः":[39],"उग्रभट":[39],"उग्रमयः":[40],"उग्रमय":[40],"उग्रश्रवाः":[41],"उग्रश्रवा":[41],"उग्राचार्यः":[43],"उग्राचार्य":[43]}}