{"s":[["n","अग्नेः ऊर्ध्वगामि अर्चिः।","वने वह्नेः ज्वाला आकाशं स्पृशति इव भाति।",["ज्वाला","शिखा","अग्निजिह्वा"],"अग्निः",["ಜ್ವಾಲೆ","ಜ್ವಾಲಾ","ಬೆಂಕಿ","ಬೆಂಕಿ ಜ್ವಾಲೆ"]],["n","तेजःपदार्थविशेषः।","पर्वते दृश्यमानः धूमः अग्नेः सूचकः।",["अग्निः","पावकः","पावनः","तेजः","वह्निः","ज्वलनः","अनलः","कृशानुः","वायुसखा","वायुसखः","दहनः","शिखी"],"प्राकृतिकवस्तु",["ಬೆಂಕಿ","ಅಗ್ನಿ","ಕಿಚ್ಚು","ಉರಿ"]],["v","प्रकाशनप्रेरणानुकूलः व्यापारः।","पठनसमये सः वातप्रचालितं दीपम् उज्ज्वलयति।",["उद्दीपय","दीपय","आदीपय","अनुभ्राज्","ज्वलय","उज्ज्वलय","अभिज्वलय","संज्वलय","सञ्ज्वलय","उद्भासय","आभासय","अवभासय"],"वि कृ",["ಕಾಂತಿಯನ್ನು ಹೆಚ್ಚಿಸು","ಪ್ರಕಾಶತೆಯನ್ನು ಹೆಚ್ಚಿಸು","ಬೆಳಕನ್ನು ಹೆಚ್ಚಿಸು"]],["n","सः पर्वतः यस्य शिखरात् भूगर्भस्थः धूमः रक्षा तथा च द्रवः बहिः आगच्छति।","ज्वालामुखीपर्वतात् नैकानां द्वीपानां निर्मितिः अभवत्।",["ज्वालामुखिपर्वतः","अद्रिवह्निः","ज्वलनपर्वतः","ज्वालामुखः","आग्नेयगिरिः","अग्निपर्वतः"],"पर्वतः",["ಅಗ್ನಿಪರ್ವತ","ಜ್ವಾಲಾಮುಖಿ-ಪರ್ವತ","ಜ್ವಾಲಾಮುಖಿ ಪರ್ವತ","ಜ್ವಾಲಾಮುಖಿಪರ್ವತ"]],["n","शरीरस्य अस्वस्थतासूचकः दाहः।","सः ज्वरेण पीडितः अस्ति।",["ज्वरः","तापः","देहदाहः"],"व्याधिः",["ಜ್ವರ"]],["a","ज्वालामुखीसम्बन्धी।","ज्वालामुखीय मृदा अतीव उपयुक्ता अस्ति।",["ज्वालामुखीय"],"",["ಜ್ವಾಲಾಮುಖಿಯ","ಜ್ವಾಲಾಮುಖಿಯಂತ","ಜ್ವಾಲಾಮುಖಿಯಂತಹ"]],["n","ज्वालामुख्यां स्थितस्य लावारसस्य उद्गमनम्।","ज्वालामुखीस्फोटेन ग्रामाः ध्वस्ताः जाताः।",["ज्वालामुखीस्फोटः","अग्निपर्वतस्फोटः"],"प्राकृतिकघटना",["ಜ್ವಾಲಾಮುಖಿ ಸ್ಪೋಟ","ಅಗ್ನಿ ಪರ್ವತ ಸ್ಪೋಟ","ಬೆಂಕಿಬೆಟ್ಟ ಸ್ಪೋಟ","ಶಿಲಾರಸ ಸ್ಪೋಟ"]],["n","शरीरे ज्वलनेन जायमाना पीडा।","घृतलेपनेन दाहः किञ्चित् न्यूनः भवति।",["दाहः","दहनम्","प्लोषः","तापः","ज्वलनम्"],"वेदना",["ಉರಿ"]],["v","भस्मीकरणानुकूलः व्यापारः।","शत्रुत्वात् मङ्गलः प्रतिनिवेशिनः गृहम् अदहत्।",["दह्","ज्वलय","दीपय","उपतापय","सन्धुक्षय","संधुक्षय","समिन्ध्"],"नाशय",["ಬೆಂಕಿಹಚ್ಚು","ಉರಿಸು","ಸುಡು"]],["v","अपरिसमाप्तदहनानुकूलः व्यापारः।","चुल्ल्याम् अग्निः अभिज्वलति।",["अभिज्वल्","प्रज्वल्","संप्रज्वल्","सम्प्रज्वल्","अभिप्रज्वल्","ज्वल्","प्रदीप्","दह्"],"प्रज्वलय",["ಸುಡು","ಉರಿ","ಜ್ವಾಲೆಯಾಗು"]],["v","अग्निसम्पर्कात् अङ्गपीडनानुकूलः व्यापारः।","पाकं पचन्ती स्नुषा अदहत्।",["दह्","ज्वल्","तप्","दीप्","प्लुष्"],"अस्",["ಸುಡು","ಸುಟ್ಟುಹೋಗು","ಹೊತ್ತಿಕೊಳ್ಳು"]],["a","यः सहजं प्रज्वलति।","गन्धकः ज्वलनशीलः पदार्थः अस्ति।",["ज्वलनशील"],"",["ಜ್ವಲನಶೀಲ","ಜ್ವಲನಶೀಲವಾದ","ಜ್ವಲನಶೀಲವಾದಂತ","ಜ್ವಲನಶೀಲವಾದಂತಹ"]],["n","दहनस्य दाहनस्य वा क्रिया अथवा भावः।","न जाने कथं जनाः स्वस्य दाहं कुर्वन्ति।",["दाहः","दहनम्","ज्वलनम्","प्लोषः"],"सप्तपर्णः",["ದಹನ","ಸುಡು","ಸುಡುವಿಕೆ","ದಾಹಕರ್ಮ"]],["a","यः ज्वरं दूरीकरोति।","वैद्येन ज्वरनाशकानि औषधानि कथितानि।",["ज्वरनाशक"],"",["ಜ್ವರನಿವಾರಕ","ಜ್ವರಹಾರಿ","ಜ್ವರಾರಿ"]],["n","मानवनिर्मितं साधनं येन अग्निः उत्पाद्यते।","तमाखुनालिं ज्वालयितुं सः ज्वालकस्य उपयोगं करोति।",["ज्वालकः"],"उपकरणम्",[]],["n","स्फटिकविशेषः।","मनहरः सूर्यकान्तेन युक्तम् अङ्गुलीयकम् अक्रीणात्।",["सूर्यकान्तः","सूर्यमणिः","सूर्याश्मा","दहनोपमः","तपनमणिः","तापनः","रविकान्तः","दीप्तोपलः","अग्निगर्भः","ज्वलनाश्मा","अर्कोपलः"],"अच्छः",[]],["n","शैत्यस्य ज्वरस्य च पर्यायवृत्तिः।","शीतज्वरः विषाणुजः रोगः अस्ति।",["शीतज्वरः","ज्वरः","शीतगात्रः","शीतरूरः","शीताङ्गः"],"ज्वरः",[]],["n","ज्वालामुखीपर्वतस्य शिखरे वर्तमानः सः गर्तः यस्मात् ज्वाला तथा च गलिता शीली निःसरन्ति ।","अस्मिन् ज्वालामुखात् निसृता ज्वाला अतीव उन्नता वर्तते ।",["ज्वालामुखम्"],"गर्तः",[]],["n","पृथिव्याः कस्यापि अन्यग्रहस्य वा पृष्ठभागे वर्तमानः सः छिद्रः यस्मात् लावारसः वाय्वादयः निर्गच्छन्ति।","ज्वालामुख्याः उद्रेकः प्रायः विस्फोटेन सह भवति।",["ज्वालामुखी"],"",[]],["n","यस्य मुखात् ज्वाला निष्कासति ।","महासागरे ज्वालामुखीयः पर्वतः वर्तते ।",["ज्वालामुखीय"],"",["ಜ್ವಾಲಾಮುಖಿ"]],["n","ज्वलितुं योग्यः ।","अत्र ज्वलनीयस्य काष्ठस्य प्राप्तिः कठिना ।",["ज्वलनीय"],"",["ಉರಿಯುವ","ಉರಿಯುವಂತ","ಉರಿಯುವಂತಹ","ಉರುವಲು"]],["n","यद् ज्वलति ।","सा दीप्ते अङ्गारे चलति ।",["दीप्त","ज्वलित","अग्निदीप्त","प्रदीप्त","प्रज्वलित","इद्ध"],"",["ಉರಿಯುತ್ತಿರುವ","ಉರಿಯುತ್ತಿರುವಂತ","ಉರಿಯುತ್ತಿರುವಂತಹ"]],["n","काङ्गरानगरस्य समीपे वर्तमाना देवी ।","जनाः ज्वालामुखेः दर्शनं कर्तुम् आगच्छन्ति ।",["ज्वालामुखी","ज्वाला"],"सुरनारी",[]],["n","एकः ज्वराङ्कुशः ।","ज्वरधुमकेतोः उल्लेखः भावप्रकाशे अस्ति",["ज्वरधूमकेतुः"],"",[]],["n","एका वैद्यकीया कृतिः ।","ज्वरनिर्णयस्य उल्लेखः कोषे अस्ति",["ज्वरनिर्णयः"],"",[]],["n","एकः ज्वराङ्कुशः ।","ज्वरब्रह्माङ्कुशस्य उल्लेखः कोषे अस्ति",["ज्वरब्रह्मास्त्रम्"],"",[]],["n","एकः ज्वराङ्कुशः ।","ज्वराशनेः उल्लेखः कोषे अस्ति",["ज्वराशनिः"],"",[]]],"w":{"ज्वाला":[0,22],"ज्वलनः":[1],"ज्वलन":[1,7,12],"ज्वलय":[2,8],"ज्वालामुखिपर्वतः":[3],"ज्वालामुखिपर्वत":[3],"ज्वलनपर्वतः":[3],"ज्वलनपर्वत":[3],"ज्वालामुखः":[3],"ज्वालामुख":[3,17],"ज्वरः":[4,16],"ज्वर":[4,16],"ज्वालामुखीय":[5,19],"ज्वालामुखीस्फोटः":[6],"ज्वालामुखीस्फोट":[6],"ज्वलनम्":[7,12],"ज्वल्":[9,10],"ज्वलनशील":[11],"ज्वरनाशक":[13],"ज्वालकः":[14],"ज्वालक":[14],"ज्वलनाश्मा":[15],"ज्वालामुखम्":[17],"ज्वालामुखी":[18,22],"ज्वलनीय":[20],"ज्वलित":[21],"ज्वरधूमकेतुः":[23],"ज्वरधूमकेतु":[23],"ज्वरनिर्णयः":[24],"ज्वरनिर्णय":[24],"ज्वरब्रह्मास्त्रम्":[25],"ज्वरब्रह्मास्त्र":[25],"ज्वराशनिः":[26],"ज्वराशनि":[26]}}