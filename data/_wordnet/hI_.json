{"s":[["a","यस्य शरीरावयवे विकृतिः जाता।","विकलाङ्गानां मनुष्याणां सहाय्यं करणीयम्।",["विकलाङ्ग","विकल","छिनाङ्ग","हीनाङ्ग","लूनाङ्ग","खण्डिताङ्ग","व्यङ्ग","अपाङ्ग","अङ्गविकल","अङ्गहीन"],"",["ಅಂಗವಿಕಲ","ಅಂಗವಿಕಲನಾದ","ಅಂಗವಿಕಲನಾದಂತ","ಅಂಗವಿಕಲನಾದಂತಹ"]],["n","अतिकठोरः प्रभाशीलः महार्हः रत्नविशेषः- अस्य गुणाः सारकत्व-शीतत्व-कषायत्वादयः।","हीरैः युक्तानाम् अलङ्काराणां मूल्यम् अधिकम् अस्ति।",["हीरम्","हीरकः","दृढाङ्गम्","लोहजित्","सूचीमुखम्","रत्नमुख्यम्","अविकम्","वरारकम्","अशिरम्","कुलिशम्","भिदुरम्","पविः"],"",["ರತ್ನ","ವಜ್ರ"]],["n","अल्पस्य अवस्था भावो वा।","समयस्य अप्राचुर्यात् अहम् तत्र गन्तुम् अशक्नवम्।",["अप्राचुर्यम्","न्यूनता","अल्पता","क्षीणता","अल्पत्वम्","अयथेष्टता","हीनता"],"प्रमाणम्",["ಕಡಮೆ","ಕಮ್ಮಿ","ಅರಕೆ","ಸ್ವಲ್ಪ"]],["n","गतो भावम् अभावम्।","ग्रीष्मे जलस्य अभावः वर्तते।",["अभाव","हीनता","रहितत्वम्","शून्यता","न्यूनता"],"अनुपलब्धिः",["ಅಭಾವ","ಕೊರತೆ"]],["n","कृष्णस्य राज्ञी वैदर्भपुत्री च।","रुक्मिणेः गर्भात् प्रद्युम्नः जातः।",["रुक्मिणी","ईः","रमा","सिन्धुजा","सामा","चला","हीरा","चठ्चला","वृषाकपायी","चपला","इन्दिरा","लक्ष्मीः"],"",["ರುಕ್ಮಿಣಿ"]],["n","क्षुद्रस्य अवस्था।","अस्माभिः कस्यापि कृते क्षुद्रतायाः अनुभवः न करणीयः।",["क्षुद्रता","नीचता","हीनता","ऊनता","न्यूनता","अधरता","अवरत्वम्","अपकर्षः","अप्राधान्यम्","गौणता","आनतिः","अपकृष्टता"],"दशा",["ತುಚ್ಛ","ತುಚ್ಛತನ","ಹೀನ","ಸ್ವಾರ್ಥ"]],["n","एकः काल्पनिकः शुकः यस्य स्वर्णवर्णः अस्ति इति मन्यते।","हीरामणेन रत्नसेनाय पद्मावत्यः सौन्दर्यं वर्णितम्।",["हीरामणः"],"",["ಗಿಳಿಯ ಒಂದು ಕಲ್ಪಿತಿ ಜಾತಿ","ಹೊಂಬಣ್ಣದ ಗಿಳಿ"]],["a","केनापि सह तुलनायां अधिकं पापकारकम्।","दिने दिने तस्य स्वभावः हीनतरः भवति।",["हीनतर"],"",["ನಿಕೃಷ್ಟತರ","ನಿಕೃಷ್ಟತರವಾದ","ನಿಕೃಷ್ಟತರವಾದಂತ","ನಿಕೃಷ್ಟತರವಾದಂತಹ"]],["n","यस्य हस्तः अवयवः वा योग्यरूरेण कार्यं न करोति।","एकः विकलः मुखे लेखनीं धृत्वा लिखति।",["विकलः","विकला","विकलाङ्गी","विकलाङ्गिनी","हीनाङ्गः","हीनाङ्गी","अङ्गविकलः","अङ्गविकला"],"",["ಅಂಗವಿಕಲ","ವಿಕಲಾಂಗ"]],["n","विकलाङ्गस्य अवस्था भावः वा।","उद्यमशीलानां कृते विकलाङ्गता विकासे बाधिका न भवति।",["विकलाङ्गता","विकलता","छिन्नाङ्गता","हीनाङ्गता","लूनाङ्गता","खण्डिताङ्गता","व्यङ्गता","अपाङ्गता","अङ्गविकलता","अङ्गहीनता","असमर्थता"],"दशा",["ವಿಕಲಾಂಗತೆ","ಅಂಗಹೀನತೆ"]],["n","बौद्धधर्मस्य द्वयोः प्रमुखासु शाखासु एका शाखा।","हीनयानशाखायाः आधारेण स्वप्रयत्नेन एव मुक्तिः सम्भाव्यते।",["हीनयानशाखा"],"सम्प्रदायः",["ಹೀನಯಾನ"]],["n","छप्पयछन्दसः भेदविशेषः।","हीरस्य उदाहरणं वदतु।",["हीरः"],"छप्पय-छन्दः",[]],["n","मात्रिकः छन्दोविशेषः।","हीरे त्रयोविंशतिः मात्राः भवन्ति।",["हीरः"],"मात्राछन्दः",[]],["n","वर्णवृत्तविशेषः।","हीरस्य प्रत्येकस्मिन् चरणे क्रमेण भगणः सगणः नगणः जगणः नगणः तथा रगणः भवति।",["हीरः"],"वृत्तम्",[]],["n","कस्यापि विषयस्य सः अभावः यस्य पूर्तिः आवश्यकी ।","कर्तव्यपालने किञ्चिदपि न्यूनता न भवेत् ।",["न्यूनता","अपूर्णता","हीनता","न्यूनभावः"],"अप्राचुर्यम्",[]],["n","एकः कविः ।","हिरजितः उल्लेखः विवरणपुस्तिकायाम् अस्ति",["हीरजित्"],"",[]],["n","एकः पुरुषः ।","हीरभट्टस्य उल्लेखः कोषे अस्ति",["हीरभट्टः"],"",[]],["n","एकः राज्ञी ।","हीरादेव्याः उल्लेखः प्रशस्त्याम् अस्ति",["हीरादेवी"],"",[]],["n","लेखकनामविशेषः ।","हीरानन्दः इति नामकयोः द्वयोः लेखकयोः उल्लेखः विवरणपुस्तिकायाम् अस्ति",["हीरानन्दः"],"",[]],["n","एकः कविः ।","हीरोकस्य उल्लेखः विवरणपुस्तिकायाम् अस्ति",["हीरोकः"],"",[]]],"w":{"हीनाङ्ग":[0,8],"हीरम्":[1],"हीर":[1,11,12,13],"हीरकः":[1],"हीरक":[1],"हीनता":[2,3,5,14],"हीरा":[4],"हीरामणः":[6],"हीरामण":[6],"हीनतर":[7],"हीनाङ्गः":[8],"हीनाङ्गी":[8],"हीनाङ्गता":[9],"हीनयानशाखा":[10],"हीरः":[11,12,13],"हीरजित्":[15],"हीरभट्टः":[16],"हीरभट्ट":[16],"हीरादेवी":[17],"हीरानन्दः":[18],"हीरानन्द":[18],"हीरोकः":[19],"हीरोक":[19]}}