{"s":[["n","नद्यादि-सन्तरणार्थम् काष्ठादिभिः विनिर्मितः यानविशेषः।","विदुरेण प्रेषितः नरः मनोमारुतगामिनीं सर्ववातसहां यन्त्रयुक्तां नावं दर्शयामास।",["नौः","नौका","तरिका","तरणिः","तरणी","तरिः","तरी","तरण्डी","तरण्डः","पादालिन्दा","उत्प्लवा","होडः"],"जलयानम्",["ನೌಕೆ","ನಾವ್","ಹಡಗು","ದೋಣಿ."]],["n","गीतप्रकारः यः माघमासे फाल्गुनमासे तथा च होलिकोत्सवे गीयते।","होलिकोत्सवे जनाः उत्साहेन होलिकागानं गायन्ति।",["होलिकागानम्"],"गीतम्",["ಹೋಳಿ","ಹೋಳಿ ಹಬ್ಬ","ಕಾಮನ ಹಬ್ಬ","ಓಕುಳಿ"]],["n","देवतोद्देशेन मन्त्रोच्चारणपूर्वकोऽग्नौ हविर्निक्षेपः।","आहुतेः पश्चात् पण्डितेन यजमानं रक्षासूत्रं बद्धम्।",["आहुतिः","होमः","वषट्कारः"],"धर्म-कर्म",["ಆಹುತಿ","ಅವಿಸ್ಸು","ಬಲಿ"]],["n","दिवसस्य चत्वारिंशत्तमो भागः।","अद्य मुम्बईतः कन्याकुमारीं प्रति गम्यमाना अग्निरथलोहगमिनी चतसृभ्यः घटिकाभ्यः विलम्बेन धावति।",["घटिका","होरा","केरली","दिनांशः"],"कालमापकम्",["ಘಂಟೆ","ಗಂಟೆ","ತಾಸು","ಸಮಯ"]],["n","हवनस्य कुण्डम्।","राजा द्रुपदस्य पुत्री द्रौपदी होमकुण्डात् उत्पन्ना।",["होमकुण्डम्","हवनी"],"मानवकृति",["ಯಜ್ಞಕುಂಡ","ಹೋಮಕುಂಡ","ಅಗ್ನಿಕುಂಡ","ಯಜ್ಞ ಕುಂಡ"]],["n","फाल्गुनमासस्य पौर्णिमायां निर्वर्त्यमानः उत्सवः यस्मिन् अग्निः प्रज्वाल्यते तथा च परस्परम् अबीरादिना रञ्जन्ते।","भारते होलिकोत्सवः उत्साहेन निर्वर्तयन्ति।",["होलिकोत्सवः"],"उत्सवः",["ಕಾಮನ ಹಬ್ಬ","ಹೋಳಿ ಹಬ್ಬ","ಓಕುಳಿ","ಹೋಳಿ"]],["n","एका राक्षसी या हिरण्यकश्यपोः स्वसा आसीत्।","यदा प्रह्लादं ज्वालितुं प्रायतत तदा होलिका भस्मीभूता।",["होलिका"],"राक्षसी",["ಹೋಲಿಕಾ"]],["n","काष्ठादीनां चयः यः होलिकोत्सवे प्रज्वाल्यते।","होलीं प्रज्वलितुं ग्रामस्थाः सम्मिलिताः।",["होली","होलिका"],"समुदायः",["ಕಾಮನ ಹಬ್ಬ"]],["n","कमपि आहूय उच्चैः कृतं सम्बोधनम्।","स्वामिनः हूतिं श्रुत्वा दासः वेगेन आगतः।",["हूतिः","आहूः","होत्रा"],"शब्दः",["ಕೂಗು","ಕರೆ","ಕರೆಯುವಿಕೆ","ಕೂಗುವಿಕೆ"]],["n","ऋग्वेदवेत्ता","तेन हुधात्वर्थव्यनच्छेदकप्रक्षेपोनुकूलव्यापारवति ऋत्विजि होता इत्यादिव्यपदेशः",["होतृ"],"मनुष्यः",[]],["n","फाल्गुनमासस्य कृष्णपक्षस्य पञ्चमी।","होलाकायां सर्वे परस्परं रागमयं कुर्वन्ति।",["होलाका"],"पञ्चमी",[]],["n","मध्यप्रदेशराज्ये वर्तमानम् एकं नगरम्।","मम ननान्दुः श्वशुरगृहं होशङ्गाबादनगरे अस्ति।",["होशङ्गाबादनगरम्"],"पुरम्",[]],["n","मध्यप्रदेशराज्ये वर्तमानम् एकं मण्डलम्।","होशङ्गाबादमण्डलस्य मुख्यालयः होशङ्गाबादनगरे अस्ति।",["होशङ्गाबादमण्डलम्"],"मण्डलम्",[]],["n","पञ्जाबराज्ये वर्तमानं मण्डलम्।","होशियारपुरमण्डलस्य मुख्यालयः होशियारपुरनगरे अस्ति।",["होशियारपुरमण्डलम्"],"मण्डलम्",[]],["n","पञ्जाबराज्ये वर्तमानं नगरम्।","आरक्षकाः होशियारपुरनगरात् आगच्छन्तं कारयानम् अरुन्धन्।",["होशियारपुरनगरम्"],"पुरम्",[]],["n","यः यज्ञे आहुतिं ददाति सः ।","अध्वर्युना पवित्रतायाः विषये अवधातव्यम् ।",["अध्वर्युः","होता","वीतहव्य"],"मनुष्यः",[]],["n","तद् दिनं यदा रङ्गोत्सवं निर्वर्तयन्ति।","वसन्तोत्सवे भगवतः पूजनं कृत्वा जेष्ठेभ्यः आशीर्वचनं प्राप्तव्यम्।",["वसन्तोत्सवः","होलाका"],"वासरः",[]],["n","हवाईराज्यस्य राजधानी।","सः अटनार्थं होनोलूलूनगरम् अगच्छत्।",["होनोलूलूनगरम्"],"पुरम्",["ಸೋನೊಲೂಲೂ"]],["n","होमं कर्तुं निश्चितः समयः ।","होमं कर्तुं इच्छुकैः सज्जनैः होमवेलायाः पूर्वम् आगन्तव्यम् ।",["होमवेला","होमकालः"],"कालः",["ಹೋಮದ ಸಮಯ","ಹೋಮದ-ಸಮಯ","ಹೋಮದ ವೇಳೆ","ಹೋಮದ-ವೇಳೆ"]],["n","हिन्दूधर्मीयाणाम् उत्सवविशेषः यस्मिन् फाल्गुनमासस्य पौर्णिमायां अग्निः प्रज्वाल्यते तथा च अबीरादिना परस्परान् रञ्जन्ते च ।","होलिकायां भागं ग्रहितुं वयं मन्दिरं गच्छामः ।",["होलिका"],"उत्सवः",[]],["n","कस्मिंश्चित् उत्सवे समारोहे वा आनन्दम् अनुभवितुं प्राङ्गणादिषु सर्वस्मात् पुरतः ज्वाल्यमानः अग्निः ।","जनाः होलिकायाः परितः नृत्यं करोति ।",["होलिका"],"अग्निः",[]],["n","अनिष्टकारी या त्याज्य वस्तुओं के ढेर में उनका विनाश करने के लिए सार्वजनिक रूप से जलाई जानेवाली आग ।","लोगों ने होली में अपने सारे विलायती कपड़े झोंक दिए ।",["होलिका"],"क्षुपा",[]],["n","होमियोपथिद्वारा यः चिकित्सां करोति सः ।","सः स्वस्य बालस्य चिकित्सां होमियोपथिचिकित्सकेन कारयति ।",["होमियोपथिचिकित्सकः"],"वैद्यः",[]],["n","होमियपथेः तेन सम्बद्धं वा ।","होमियोपथिकस्य औषधस्य परिणामः मन्दं भवति ।",["होमियोपथिक"],"",[]],["n","एकः ग्रन्थः ।","होतृसंस्थाजपस्य उल्लेखः कोषे अस्ति",["होतृसंस्थाजपः"],"",[]],["n","एकः पुरुषः ।","होलस्य उल्लेखः राजतरङ्गिण्याम् अस्ति",["होलः"],"",[]],["n","स्थानविशेषः ।","होलडः इति नामकानां स्थानानाम् उल्लेखः राजतरङ्गिण्याम् अस्ति",["होलडः"],"",[]],["n","स्थानविशेषः ।","होलरा इति नामकानां स्थानानाम् उल्लेखः राजतरङ्गिण्याम् अस्ति",["होलरा"],"",[]],["n","एकः पुरुषः ।","होलसिंहस्य उल्लेखः विवरणपुस्तिकायाम् अस्ति",["होलसिंहः"],"",[]],["n","एकः ग्रामः ।","होलायाः उल्लेखः राजतरङ्गिण्याम् अस्ति",["होला"],"",[]]],"w":{"होडः":[0],"होड":[0],"होलिकागानम्":[1],"होलिकागान":[1],"होमः":[2],"होम":[2],"होरा":[3],"होमकुण्डम्":[4],"होमकुण्ड":[4],"होलिकोत्सवः":[5],"होलिकोत्सव":[5],"होलिका":[6,7,19,20,21],"होली":[7],"होत्रा":[8],"होतृ":[9],"होलाका":[10,16],"होशङ्गाबादनगरम्":[11],"होशङ्गाबादनगर":[11],"होशङ्गाबादमण्डलम्":[12],"होशङ्गाबादमण्डल":[12],"होशियारपुरमण्डलम्":[13],"होशियारपुरमण्डल":[13],"होशियारपुरनगरम्":[14],"होशियारपुरनगर":[14],"होता":[15],"होनोलूलूनगरम्":[17],"होनोलूलूनगर":[17],"होमवेला":[18],"होमकालः":[18],"होमकाल":[18],"होमियोपथिचिकित्सकः":[22],"होमियोपथिचिकित्सक":[22],"होमियोपथिक":[23],"होतृसंस्थाजपः":[24],"होतृसंस्थाजप":[24],"होलः":[25],"होल":[25],"होलडः":[26],"होलड":[26],"होलरा":[27],"होलसिंहः":[28],"होलसिंह":[28],"होला":[29]}}