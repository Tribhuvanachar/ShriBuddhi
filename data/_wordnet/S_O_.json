{"s":[["n","खगोलीयपिण्डः यः सौरमालायां सप्तमस्थाने अस्ति।","शनिः पृथिवीग्रहाद् अतिदूरे अस्ति।",["शनिः","शनैश्चरः","शौरिः","सौरः","सौरिः","रेवतिभवः","छायासुतः","छायातनयः","छायात्मजः"],"ग्रहः",["ಶನಿ","ಶನಿಗ್ರಹ","ಶನಿ ಗ್ರಹ","ಶನಿ-ಗ್ರಹ"]],["n","समुद्रस्थशुक्तेः उदरे उद्भवः ओजयुक्तः रत्नविशेषः।","शैले शैले न माणिक्यं मौक्तिकं न गजे गजे साधवो न हि सर्वत्र चन्दनं न वने वने।",["मौक्तिकम्","मुक्ता","मौक्तिका","मुक्ताफलम्","शुक्तिजम्","शौक्तेयम्","सिन्धुजातः","शुक्तिबीजम्","मुक्तिका","तौतिकम्","मञ्जरम्","मञ्जरी"],"मणिः",["ಮುತ್ತು"]],["a","धर्मेण शुद्धः।","काशी इति पवित्रं स्थानम् अस्ति।",["पवित्र","मेध्य","पूत","पावन","पवन","शुचि","शौचोपेत"],"",["ಪವಿತ್ರವಾದ","ಪುಣ್ಯವಾದ","ಪುನೀತವಾದ","ಪೂಜನೀಯವಾದ"]],["n","मनुष्याणां सा जातिः या वस्त्रप्रक्षालनस्य कार्यं करोति।","अस्मिन् ग्रामे रजकानां दश परिवाराः सन्ति।",["रजकः","शौचेयः","निर्णेजकः"],"अनुसूचितजातिः",["ಅಗಸ","ಮಡಿವಾಳ"]],["n","शुण्डायाः आपणकम्।","धनियायाः पतिः शौण्डागारात् शुण्डां पीत्वा एव गृहं प्रत्यागच्छति।",["शौण्डागारम्"],"मदिरालयः",["ಮಧ್ಯದ ಅಂಗಡಿ","ಮಧ್ಯದಂಗಡಿ","ಮಧ್ಯದ-ಅಂಗಡಿ","ಹೆಂಡದ ಅಂಗಡಿ"]],["n","शौचार्थे स्थानम्।","ग्रामे रिक्तं कृषिक्षेत्रमेव शौचस्थानं भवति।",["शौचस्थानम्"],"स्थलम्",["ಶೌಚಾಲಯ","ಶೌಚಗೃಹ","ಪಾಯಖಾನೆ","ಕಕ್ಕಸು"]],["n","शुद्धस्य भावः।","शुद्धतायाः रोगः न प्रसरति।",["शुद्धता","निर्मलता","निर्मलत्वम्","वैमल्यम्","शुचिता","शुचित्वम्","शौचम्","शौचत्वम्","अमलत्वम्","अमलता","विमलता","विमलत्वम्"],"",["ಸ್ವಚ್ಛತೆ","ಸ್ವಚ್ಛ","ಸುಚಿ","ಹಸ"]],["n","पशून् हत्वा मांसविक्रयजीवी।","मांसिकेन तीक्ष्णेन शस्त्रेण मेषस्य ग्रीवा खण्डिता।",["मांसिकः","शौनिकः","सौनिकः"],"मनुष्यः",["ಕಟುಕ","ಕ್ರೂರಿ","ಪ್ರಾಣಿಗಳನ್ನು ಕತ್ತರಿಸುವವನು"]],["n","कातरस्य भावः।","अधुना युद्धत्यागः भीरुता अस्ति यतः सर्वे युयुत्सवः कुरुक्षेत्रे समायाताः  सन्ति इति श्रीकृष्णः अर्जुनम् अवदत्।",["भीरुता","कातरता","कातर्यम्","कापुरुषत्वम्","निर्वीर्यम्","अवीर्यम्","अपौरुषम्","अविक्रमः","शौर्यहीनता","क्लैब्यम्","कार्पण्यम्","कापुरुष्यम्"],"मनोदशा",["ಹೇಡಿ","ಹೇಡಿತನ","ಅಂಜುಬುರುಕ","ಅಂಜುವಿಕೆ"]],["n","यः मद्यं विनिर्माति विक्रीणाति च।","यदा शौण्डिकः मद्यं निर्माति तदा सः आरक्षकेण गृहीतः।",["शौण्डिकः"],"मनुष्यः",["ಮಧ್ಯ ತಯಾರಿಸುವ ಹಾಗೂ ಮಾರುವ ಒಂದು ಜಾತಿ"]],["n","मनुष्यैः मलत्यागार्थे विनिर्मितं स्थानम्।","सुलभाः शौचालयाः जनानां सुविधार्थे विनिर्मिताः सन्ति।",["शौचालयः","शौचघरम्","पायुक्षालनभूमिः","नेपथ्यगृहम्","उच्चारप्रस्रावस्थानम्","वर्चःस्थानम्"],"",["ಶೌಚಾಲಯ","ಪಾಯಿಕಾನೆ","ಕಕ್ಕಸ್ಸು ಮನೆ"]],["n","एका लता यस्य कलिका तूतस्य आकारवत् भवति।","पिप्पली औषधस्य रूपेण उपयुज्यते।",["पिप्पली","कृष्णा","उपकुल्या","वैदेही","मागधी","चपला","कणा","उषणा","शौण्डी","कोला","ऊषणा","पिप्पलिः"],"लता",[]],["n","मलापकरणस्य क्रिया।","प्रत्येकस्य वस्तुनः स्वच्छता आवश्यकी।",["स्वच्छता","शौचम्","शुद्धिः","निर्मलता"],"कर्म",["ಸ್ವಚ್ಚ","ಚೊಕ್ಕಟಗೋಳಿಸಿಸುವಿಕೆ","ಚೊಕ್ಕಟಗೊಳಿಸು","ಶುಭ್ರ"]],["n","सर्वेषु शास्त्रेषु निपुणः विद्वान् ऋषिः।","शौनकस्य वर्णनं हरिवंशपुराणे अस्ति।",["शौनकः"],"आप्तः",[]],["n","शौल्बिकस्य कर्म।","मोहनः शौल्बिकेये आपणे शौल्बिककर्म कृत्त्वा बहु धनम् अर्जयति।",["शौल्बिककर्म","ताम्रिककर्म","ताम्रकारर्म","कांस्यकारकर्म"],"कार्यम्",["ಕಂಚಿನ ಕೆಲಸ"]],["a","ताम्रकारसम्बन्धी।","पात्रक्रयणार्थे सः शौल्बिकेये आपणे अगच्छत्।",["शौल्बिकेय","ताम्रिकेय"],"",["ಕಂಚಿನ"]],["n","ऋषिविशेषः।","शौकेः वर्णनं पुराणेषु प्राप्यते।",["शौकिः"],"गोत्रप्रवर्तकः",[]],["n","वैदिकः ऋषिः।","शौलायनः गोत्रकारः ऋषिः आसीत्।",["शौलायनः"],"गोत्रप्रवर्तकः",[]],["n","पौराणिकः ऋषिः।","शौल्कायनेः वर्णनं पुराणेषु प्राप्यते।",["शौल्कायनिः"],"आप्तः",[]],["n","गुणविशेषतासफलतादिजन्यः अभिमानपूर्वकः आत्मश्लाघनानुकूलः व्यापारः ।","धावनस्य स्पर्धायां जीता सा कण्डते ।",["कड्","शौट्","रोड्","क्षीव्"],"अभिमन्",["ಸೊಕ್ಕಿನಿಂದ ನಡೆ","ಅಹಂಕಾರದಿಂದ ನಡೆ","ದುರಹಂಕಾರದಿಂದ ನಡೆ","ಅಹಂಕಾರದಿಂದ ಬೀಗು"]],["n","मद्यपानेन यः उन्मत्तः ।","गृहजनाः शौण्डिकस्य मद्यपानात् मुक्ततां कर्तुं प्रयतन्ते ।",["शौण्डिकः"],"मद्यपी",[]],["n","मद्यपानेन जायमाना उन्मत्तता ।","तस्य शौण्डतायाः परिणामः अयम् ।",["शौण्डता"],"उन्मत्तता",[]],["n","शारीरिकशुचितायैप्रातःकालेउत्थायक्रियमाणंकार्यम् ।","सःमलमूत्रविसर्जनंदन्तधावनंस्नानंइत्यादीनिनित्यानिशौचानिसमाप्यअर्धघण्टांयावत्ध्यानंकरोति ।",["शौचम्"],"नित्यकर्म",[]],["n","शौण्डिकानां वसतिः ।","माता मम शौण्डिकविभागे गमनं निराकरोति ।",["शौण्डिकविभागः"],"अवसथः",[]],["n","एकः शिक्षकः ।","शौङ्गीपुत्रस्य उल्लेखः शतपथ-ब्राह्मणे अस्ति",["शौङ्गीपुत्रः"],"",[]],["n","एकः देशः ।","शौटस्य उल्लेखः प्रशस्त्याम् अस्ति",["शौटः"],"",[]],["n","एकः देशः ।","शौडस्य उल्लेखः राजतरङ्गिण्याम् अस्ति",["शौडः"],"",[]],["n","एका जातिः ।","शौण्डिकस्य उल्लेखः महाभारते वर्तते",["शौण्डिकः"],"",[]],["n","बालकानां कृते अहितकारकः राक्षसः ।","शौण्डिकेयस्य उल्लेखः पारस्कर-गृह्य-सूत्रे अस्ति",["शौण्डिकेयः"],"",[]],["n","एकः पुरुषः ।","शौण्ड्रिनः उल्लेखः प्रवरग्रन्थेषु अस्ति",["शौण्ड्री"],"",[]],["n","एकः शिक्षकः ।","शौनकीपुत्रस्य उल्लेखः शतपथ-ब्राह्मणे अस्ति",["शौनकीपुत्रः"],"",[]],["n","लेखकनामविशेषः ।","शौरिदत्तः इति द्वयोः लेखकयोः नाम आसीत्",["शौरिदत्तः"],"",[]],["n","लेखकनामविशेषः ।","शौरिसूनुः इत्यनयोः द्वयोः लेखकयोः नाम्नः उल्लेखः विवरणपुस्तिकायाम् अस्ति",["शौरिसूनुः"],"",[]],["n","एकः ग्रामः ।","शौर्यः पतञ्जलिना परिगणितः",["शौर्यः"],"",[]],["n","एकं नगरम् ।","शौर्यनगरस्य उल्लेखः हेमचन्द्रस्य परिशिष्टपर्वन् इत्यस्मिन् ग्रन्थे अस्ति",["शौर्यनगरम्"],"",[]],["n","एकः जनसमुदायः ।","शौलिकानाम् उल्लेखः वराहमिहिरयोः बृहत्संहितायाम् अस्ति",["शौलिकाः"],"",[]]],"w":{"शौरिः":[0],"शौरि":[0],"शौक्तेयम्":[1],"शौक्तेय":[1],"शौचोपेत":[2],"शौचेयः":[3],"शौचेय":[3],"शौण्डागारम्":[4],"शौण्डागार":[4],"शौचस्थानम्":[5],"शौचस्थान":[5],"शौचम्":[6,12,22],"शौच":[6,12,22],"शौचत्वम्":[6],"शौचत्व":[6],"शौनिकः":[7],"शौनिक":[7],"शौर्यहीनता":[8],"शौण्डिकः":[9,20,27],"शौण्डिक":[9,20,27],"शौचालयः":[10],"शौचालय":[10],"शौचघरम्":[10],"शौचघर":[10],"शौण्डी":[11],"शौनकः":[13],"शौनक":[13],"शौल्बिककर्म":[14],"शौल्बिकेय":[15],"शौकिः":[16],"शौकि":[16],"शौलायनः":[17],"शौलायन":[17],"शौल्कायनिः":[18],"शौल्कायनि":[18],"शौट्":[19],"शौण्डता":[21],"शौण्डिकविभागः":[23],"शौण्डिकविभाग":[23],"शौङ्गीपुत्रः":[24],"शौङ्गीपुत्र":[24],"शौटः":[25],"शौट":[25],"शौडः":[26],"शौड":[26],"शौण्डिकेयः":[28],"शौण्डिकेय":[28],"शौण्ड्री":[29],"शौनकीपुत्रः":[30],"शौनकीपुत्र":[30],"शौरिदत्तः":[31],"शौरिदत्त":[31],"शौरिसूनुः":[32],"शौरिसूनु":[32],"शौर्यः":[33],"शौर्य":[33],"शौर्यनगरम्":[34],"शौर्यनगर":[34],"शौलिकाः