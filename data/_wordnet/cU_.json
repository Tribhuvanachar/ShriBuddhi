{"s":[["n","स्त्रियाः स्तनस्य अग्रभागम्।","अस्याः गोः स्तनाग्रे व्रणः जातः।",["स्तनाग्रम्","स्तनमुखम्","स्तनमुखः","स्तनशिखा","कुचाग्रम्","चूचुकः","चूचुकम्","स्तनवृन्तः","स्तनवृन्तम्","पिप्पलकम्","नर्म्मठः","वृन्तम्"],"शारीरिकभागः",["ಮೊಲೆತೊಟ್ಟು","ಸ್ತನಗ್ರಂಥಿ"]],["n","गद्यविशेषः, अकठोराक्षरं स्वल्पसमासं चूर्णकं विदुः।","वैद्यः बालकाय चूर्णकम् यच्छति।",["चूर्णकम्"],"अगदः",["ಚೂರ್ಣ","ಪುಡಿ","ಹಿಟ್ಟು","ಹುಡಿ"]],["n","पर्वतस्य शिरोऽग्रम्।","भारतीयेन पर्वतारोहिणा हिमालयस्य शिखरे भारतस्य त्रिवर्णाः ध्वजः अधिरोपिता।",["शिखरम्","शृङ्गम्","कूटः","ककुद्","ककुदः","ककुदम्","चूडा","पर्वताग्रम्","शैलाग्रम्","अद्रिशृङ्गम्","दशनः","वातरायणः"],"शिखरम्",["ಪರ್ವತ ಶಿಖರ","ಬೆಟ್ಟದ ತುದಿ","ಹಿಮಾಲಯದ ಶೃಂಗ","ಗಿರಿ ಶಿಖರ"]],["n","कस्यापि वस्तुनः स्थानस्य वा उपरिभागः अग्रदेशः  तथा च कस्मिन्नपि विषये अर्जितम् अत्युच्चस्थानम् च।","मन्दिरस्य शिखरे केतुः शोभते।",["शिखरम्","शिखा","अग्रम्","अग्रभागः","पृष्ठम्","शृङ्गम्","चूडा","शिरम्","उपरिभागः","शीर्षकम्"],"उन्नतभागः",["ಶಿಖರ","ತುದಿ","ತುತ್ತತುದಿ"]],["n","शिरो मध्यस्य केशाः।","शिखां निबद्ध आसीनो द्विज आचमनम् चरेत्।",["शिखा","चूडा","केशपाशः","जूटिका","जुटिका","शिखण्डिका"],"केशसमूहः",["ಚಂಡಿಕೆ","ಚಿಂಡಿಕೆ","ತುರಾಯಿ","ಶಿಖೆ"]],["a","यस्मिन् चूणाः सन्ति।","माता चूणयुक्तम् प्रावरकं पितरे दत्तवती।",["चूणयुक्त","पुटयुक्त","वेणियुक्त","कव्वरयुक्त","धम्मिलयुक्त"],"",["ಆರಿಸಿ ಕೊಡುವುದು","ಆಯ್ಕೆ ಮಾಡಿಕೊಡುವುದು"]],["n","तृणविशेषः यस्य मूलानि कफपित्तज्वरातिसारारुच्यादिषु भेषजरुपेण युज्यते।","वैद्येन भेषजार्थे समूलं नागरमुस्ता आनीता।",["नागरमुस्ता","नागरोत्था","नागरादिघनसंज्ञका","चक्राङ्का","नादेयी","चूडाला","पिण्डमुस्ता","शिशिरा","वृषध्माङ्क्षी","कच्छरुहा","चारुकेसरा","उच्चटा"],"तृणम्",["ವಿಶಿಷ್ಟ ಜಾತಿಯ ಹುಲ್ಲು","ಶಿಷ್ಟ ಜಾತಿಯ ಹುಲ್ಲು","ಒಂದು ತರದ ಸುಗಂಧಿತ-ಹುಲ್ಲು","ಗರಿಕೆ"]],["n","फलविशेषः, आम्रवृक्षस्य फलम् अस्य गुणाः वर्णरुचिमांसशुक्रबलकारित्वम्।","रामाय आम्रः रोचते।",["आम्रम्","चूतम्","सहकारम्","कामशरम्","कामवल्लभम्","कामाङ्गम्","कीरेवृः","माधवद्रुमम्","भृङ्गामीष्टम्","सीधुरसम्","मधूली","कोकिलोत्सवम्"],"खाद्यफलम्",["ಮಾವು","ಮಾವಿನ ಹಣ್ಣು"]],["n","फलवृक्षविशेषः- दीर्घजीवी पादपः यस्य पीतवर्णीयं फलम् अतीव मधुरम्।","आम्रवृक्षे शुकाः निवसन्ति।",["आम्रः","आम्रवृक्षः","चूतः","सहकारः","कामशरः","कामवल्लभः","कामाङ्गः","कीरेवृः","माधवद्रुमः","भृङ्गामीष्टः","सीधुरसः","मधूली"],"वृक्षः",["ಅಮರಪುರುಷ","ಭ್ರಮರಪ್ರಿಯ","ಸುಂದರಪುರುಷ"]],["n","अश्मखण्डाः कठोरपदार्थस्य खण्डाः वा।","अधुना धान्येषु वालुकाः संमील्य जनाः धान्यस्य विक्रयणं कुर्वन्ति।",["वालुका","चूर्णखण्डः","चूर्णः","शिलाखण्डः","पाषाणखण्डः"],"प्राकृतिकवस्तु",["ಸಣ್ಣ ಹರಳು","ಬೆಣಚುಗಲ್ಲು","ಸುಣ್ಣದ ಹರಳು"]],["n","भूमौ खातः अल्पविस्तारो गम्भीरो मण्डलाकृतिः भागः यस्मात् जलं तैलं च प्राप्स्यते।","अस्य कूपस्य जलं शीतलम्।",["कूपः","कूपकः","प्रहिः","अन्धुः","जलकुपी","कूपी","निपानम्","उदपानम्","उदकाधारः","जलाधारः","आपीनः","चूडकः"],"गर्तः",["ಬಾವಿ","ಅಂಧು","ಅವಟ","ಅವಟಿ"]],["v","जलं रसं वा शोषणाजन्य पानानुकूलः व्यापारः।","वृक्षैः भूमीजलम् आपीयते।",["आपा","चूष्","अवशुष्","धे","निर्धे"],"ग्रह्",["ಪೋಷಿಸು","ರಕ್ಷಿಸು"]],["v","मुखेन आकर्ष्य रसपानानुकूलव्यापारः।","रामः आम्रं चूषति।",["चूष्"],"पा",["ಹೀರು","ಚೀಪು"]],["n","शरीरस्य सः भागः यः कण्ठस्य उर्ध्वभागे अस्ति।","काल्याः कण्ठे शीर्षाणां माला शोभते।",["शीर्षम्","शीर्षकम्","शिरस्","मूर्धा","मस्तकः","मुण्डः","मुण्डकम्","मौलिः","केनारः","चूडालम्","वराङ्गम्","उत्तमाङ्गम्"],"बाह्य-शारीरिक-भागः",["ತಲೆ","ಮುಂಡ","ಶಿರಸ್ಸು","ಮಸ್ತಕ"]],["v","वस्त्राणां कर्गजानां पुटनानुकूलः व्यापारः।","सा वस्त्रं सम्यक् सङ्कोचति।",["सङ्कोच्","संकुच्","पुटीकृ","चूणय"],"चि",["ಮಡಿಚು"]],["v","जलेन सह चूर्णीकरोति।","पूजार्थे चन्दनम् चूर्णयति।",["चूर्ण","पिष","मृद्","क्षद्","खण्ड्","गुण्ड्","कुट्ट"],"कृ",["ರುಬ್ಬು","ಅರಿ"]],["n","सम्येषणेन जातरजः।","कन्याश्चन्दनचूर्णैश्च लाजैर्माल्यैश्च सर्वशः, अवाकिरन् शान्तनवं तत्र गत्वा सहस्रशः।",["चूर्णः","चूर्णम्","क्षोदः","रजः"],"पदार्थः",["ಚೂರ್ಣ","ಪುಡಿ","ಹಿಟ್ಟು"]],["n","हिन्दूनां षोडशेषु संस्कारेषु एकः यस्मिन् बालकस्य केशाः मुण्ड्यन्ते।","सः वाराणसीनगरे स्वपुत्रस्य चौलम् आचरत्।",["चौलम्","चूडासंस्कारः","शिरोमण्डनम्","चूडाकरणम्"],"",[]],["v","चूर्णीकरणप्रेरणानुकूलः व्यापारः।","प्रतिरविवासरे सुरेशः गोधूमान् पेषयति।",["पेषय","आपीडय","क्षोदय","खण्डय","चूर्णय","प्रचूर्णय","घर्षय","निष्पेषय","आस्फोटय","अवमर्दय","आदारय","आदायय"],"कारय",["ಬೀಸು","ಹಿಟ್ಟು ಮಾಡು","ಪುಡಿ ಮಾಡು","ಅರೆ"]],["v","वस्तुविशेषस्य आघर्षणेन चूर्णीकरणानुकूलः व्यापारः।","सः गोधूमं पिनष्टि।",["पिष्","चूर्ण्"],"कृ",["ಬೀಸು","ಪುಡಿಮಾಡು"]],["n","विघट्ट्नाद् विरूपीभवनम्।","पेलवेन मल्लेन सः बलदण्डः मल्लः विनिष्पिष्टः जातः।",["विनिष्पिष्टः","पिष्टीकृतः","चूर्णीकृतः","पिष्टम्","चूर्णितम्","प्रशीर्णः","प्रशीर्णम्","प्रशीर्णा"],"दशा",["ಹಣ್ಣುಗಾಯಿ ನೀರುಗಾಯಿ ಮಾಡುವುದು"]],["n","अखण्डपटकर्गजादेशानां  विशिष्टान्तराले एकस्योपरी एकम् इति पुटीकृत्-रचना","शाटिकाधारणार्थे अनेकाः चूणाः कर्तव्याः",["चूणः","पुटः","वेणिः","कव्वरः","धम्मिलः"],"चयः",["ನೆರಿಗೆ","ಮಡಿಕೆ"]],["n","शिरसि ध्रियमाणः स्त्रीणाम् आभरणविशेषः।","सीतादेवी अशोकवाटिकायां स्वस्य चूडामणिं निष्कास्य हनुमते दत्तवती।",["चूडामणिः","शिरोरत्नम्"],"शिरोभूषणम्",[]],["n","हस्तिबन्धनरज्जुः।","हस्तिनः बलेन आघातात् दूष्या भग्ना।",["दूष्या","कक्षा","वरत्रा","चूषा"],"",[]],["n","आकृष्य पानम्।","चूषणस्य अनन्तरं रामू आम्रस्य बीजम् अक्षिपत्।",["चूषणम्","चोषणम्","आचूषणम्","शोषणम्"],"कर्म",["ಹೀರು","ಚೀಪು"]],["a","यस्य पेषणं चूर्णं वा कृतम्।","तद् चूर्णितं धान्यम् अस्ति।",["चूर्णित"],"",["ರುಬ್ಬಿದ","ರುಬ್ಬಿದಂತ","ರುಬ್ಬಿದಂತಹ"]],["n","केशानां कलकः।","कपोलस्थान् कुन्तलान् सा सङ्कोचति।",["कुन्तलः","केशान्तः","केशस्तुकः","खङ्करः","चूर्णकुन्तलः","केशमण्डलः","गुडालकः"],"समुदायः",[]],["a","यस्य चूर्णं कृतम्।","चूर्णिते औषधे मधु योजयित्वा खादितुं वैद्यः असूचयत्।",["चूर्णित","चूर्णीकृत"],"",["ಚೂರ್ಣವಾದ","ಚೂರ್ಣವಾದಂತ","ಚೂರ್ಣವಾದಂತಹ","ಪುಡಿಯಾದ"]],["n","मसीशोषकं तृष्टपत्रम्।","मसीशोषफलेन पत्रस्था सर्वा मसी शोषिता।",["मसीशोषफलम्","मसीचुषः","चूषपत्रम्"],"पत्रम्",[]],["n","वेण्याः उपरि धार्यमाणं किञ्चन आभरणम् ।","तस्याः चूडामणिः अत्यन्तं सुन्दरी अस्ति ।",["चूडामणिः"],"शिरोभूषणम्",[]],["n","चूर्णजनकक्षुद्रपाषाणखण्डम् ।","कर्करस्य उपयोगः गृहनिर्माणादिकार्ये भवति ।",["कर्करः","चूर्णखण्डम्"],"शिला",[]],["n","एका स्त्री ।","चूडालायाः उल्लेखः बाह्वादिगणे वर्तते",["चूडाला"],"",[]],["n","एकः पुरुषः ।","चूर्णस्य उल्लेखः वीरचरिते वर्तते",["चूर्णः"],"",[]]],"w":{"चूचुकः":[0],"चूचुक":[0],"चूचुकम्":[0],"चूर्णकम्":[1],"चूर