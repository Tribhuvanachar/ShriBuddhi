{"s":[["a","उपक्लृप्तस्य भोजनाद् अनन्तरं भुक्तावशिष्टम् अन्नम्।","उच्छिष्टं न भोजनीयम्।",["उच्छिष्ट","शेष","शेषित","वैघसिक","सम्मार्जन"],"",["ಎಂಜಲಾದ","ಎಂಜಲಾದಂತ","ಎಂಜಲಾದಂತಹ","ಅರ್ಧ ತಿಂದ"]],["n","गझल इत्याख्या उर्दूकाव्यप्रकारस्य पङ्क्तिद्वयम्।","तेन शेरः पठितः।",["शेरः"],"पद्यकाव्यम्",["ಚರಣ"]],["a","यः समाप्तिं न गतः।","अपूर्णं कार्यं पूर्णं करोतु।",["अपूर्ण","शेष","असमाप्त","अनिष्पादित","असिद्ध","असम्पन्न"],"",["ಅಪೂರ್ಣವಾದ","ಅಪೂರ್ಣವಾದಂತ","ಅಪೂರ್ಣವಾದಂತಹ","ಪೂರ್ತಿ ಮುಗಿಯದ"]],["n","पुराणोक्तः सहस्रफणाधारी पृथिव्याः आधाररूपेण वर्तमानः नागः।","हिन्दुजनाः शेषनागं देवता मन्यन्ते।",["शेषनागः"],"नागः",["ಶೇಷನಾಗ","ಸರ್ಪರಾಜ","ನಾಗೇಶ","ಶೇಷಸರ್ಪ"]],["n","कापि सङ्ख्या कयापि सङख्यया न्यूनीकृत्य प्राप्ता सङ्ख्या।","अस्य प्रश्नस्य शेषफलं पञ्च इति।",["शेषफलम्","शेषः","अन्तरम्","अवशिष्टकम्","अवसायः","खिलम्","परीशेषः"],"सारः",["ಉಳಿದ","ಉಳಿದ ಸಂಖ್ಯೆ","ಉಳಿದ ವಸ್ತು","ಅಂತ್ಯ"]],["n","चणकपिष्टस्य सूतसदृशः लवणयुक्तः पदार्थः।","बालकः सेवं खादित्वा कषायं पिबति।",["सेवम्","शेवम्"],"",["ಚೌಚೌ","ಸೇವ್"]],["a","यस्य निर्वेशः न जातः।","अहं शेषं धनं आनेतुं गतवान्।",["शेष","शिष्ट"],"",["ಬಾಕಿ","ಬಾಕಿಯಾದ","ಬಾಕಿಯಾದಂತ","ಬಾಕಿಯಾದಂತಹ"]],["n","एकः कल्पितः महामूर्खः पुरुषः।","एषा कथा शेखचिल्लीना सम्बन्धिता।",["शेखचिल्ली"],"",["ಮೂರ್ಖ","ವಿನೋದಿ"]],["n","एकस्याः लतायाः कलिका यां शोषयित्वा तस्याः व्यञ्जनरूपेण औषधरूपेण च उपयोगः प्रयोगः भवति।","लवङ्गस्य तैलस्य उपयोगः दन्तपीडानिवारणार्थं क्रियते।",["लवङ्गम्","लवङ्गपुष्पम्","लवङ्गकलिका","दिव्यम्","शेखरम्","लवम्","श्रीपुष्पम्","रुचिरम्","वारिसम्भवम्","भृङ्गारम्","गीर्वाणकुसुमम्","चन्दनपुष्पम्"],"",["ಲವಂಗ","ದೇವಕುಸುಮ","ನೀರಸನಿ","ಬಾಳಪರ್ಣ"]],["n","सः पदार्थः यम् अनुपयुक्तम् इति मत्वा क्षिप्यते।","यन्त्रागाराणाम् अवकराः नदीः प्रदूषयन्ति।",["अवकरः","अवक्षयः","शेषम्","उपक्षयः","कान्तारः","कान्तारम्","क्षिया","प्रहीणः"],"पदार्थः",["ಕೆಟ್ಟ ನೀರು","ರಾಸಾಯನಿಕ ಮಿಶ್ರತ ನೀರು"]],["n","सः समयः यदा जनः वृद्धः भवति।","तेन वार्द्धक्यं काठिन्येन व्यतीतम्।",["वार्द्धक्यम्","वृद्धत्वम्","वृद्धता","वार्द्ध्यम्","जरा","शेषावस्था","वार्द्धकभावः","वार्धकम्","वृद्धकालः"],"अवधिः",["ಮುಪ್ಪು","ಮುದಿತನ","ವಾರ್ಧಕ್ಯ ವೃದ್ಧಾಪ್ಯ","ಇಳಿವಯಸ್ಸು"]],["v","परिशेषानुकूलः व्यापारः।","अहं भवतां कृते अपूपस्य खण्डम् उच्छिनष्मि।",["उच्छिष्","अवशिष्","अवशेषय","परिशेष्","परिशेषय","शिष्","शेषय","अपशिष्","अतिशिष्","परिहा","अतिसृज्","अवहा"],"स्थापय",["ಇಡು"]],["n","षड् आरभ्य द्वाविंशतिः पादोन्नतः नित्यहरितक्षुपः यस्मिन् भवति तुवर्याः इव पञ्चपत्राणि एवं शाखायां लघूनि रोमाणि च।","निर्गुण्ड्याः पत्रमूलानि तु औषधेषु उपयुज्यन्ते।",["निर्गुण्डी","शेफालिका","शेफाली","नीलिका","मलिका","सुवहा","रजनीहासा","निशिपुष्पिका","सिन्धुकः","सिन्द्रकः","सिन्द्ररावः","इन्द्रसुषिरः"],"क्षुपः",[]],["n","एकः सुप्रसिद्धः आङ्लदेशीयः कविः नाटककर्ता च।","शेक्सपियरमहोदयेन प्रायः 37 नाटकाः रचिताः।",["शेक्सपियरमहोदयः","विलियमशेक्सपियरमहोदयः"],"ग्रन्थकारः",["ಶೇಕ್ಸಪಿಯರ್","ವಿಲಿಯಮ್ ಶೇಕ್ಸಪಿಯರ್"]],["n","भारतदेशस्य बिहारराज्ये वर्तमानं मण्डलम्।","शेखपुरामण्डलस्य मुख्यालयः शेखपुरानगरे अस्ति।",["शेखपुरामण्डलम्"],"मण्डलम्",[]],["n","भारतदेशस्य बिहारराज्ये वर्तमानं नगरम्।","तस्य मातुलः शेखपुरानगरे निवसति।",["शेखपुरानगरम्"],"पुरम्",[]],["n","तद् यद् (अन्यं सर्वं विनष्टे सति अपि) शिष्यते।","अग्निना भस्मीकृतं गृहम् अतः किम् अपि न अवशिष्टम्।",["अवशिष्टम्","शेषः","अवशेषः","शिष्टम्","उच्छिष्टम्","परिशिष्टम्"],"वस्तुः",["ಬಾಕಿ","ಶೇಷ"]],["n","छन्दोविशेषः।","शेषे षट्चत्वारिंशत् गुरुवर्णाः तथा षष्टिः लघुवर्णाः भवति अथवा द्विपञ्चाशताधिकैकशत मात्राः भवन्ति।",["शेषः"],"छप्पय-छन्दः",[]],["n","दक्षिणभारते वर्तमानः पर्वतविशेषः।","शेषाचलस्य धार्मिकी महत्ता अपि अस्ति।",["शेषाचलः"],"पर्वतः",[]],["n","रासायनिकक्रियायाम् उपयुज्यमाणः पत्रविशेषः ।","अम्ले नील-शेवलपत्रं रक्तवर्णीयं भवति ।",["शेवल-पत्रम्"],"पत्रम्",["ಲಿಟ್ ಮಸ್","ಲಿಟ್ ಮಸ್ ಕಾಗದ"]],["n","पूर्वं सर्वैः सह विद्यमानतायां सत्यां कश्चित् कालादनन्तरं अन्येषां अवर्तमानत्वे अपि एकस्य भागस्य वर्तमानत्वम् ।","शेषाः जनाः इदानीं भोजनं कुर्वन्तु ।",["शेष","परिशेष","शिष्ट","परिशिष्ट","अवशिष्ट","उद्रिक्त","शेषभूत"],"",[]],["n","एकः लेखकः ।","शेखरस्य उल्लेखः कोशे वर्तते",["शेखरः"],"",[]],["n","ग्रन्थप्रकारविशेषः ।","शेखरः इति ग्रन्थः व्याकरणशास्त्रविषयकः वर्तते",["शेखरः"],"",[]],["n","एकः राजा ।","शेखरज्योतिषः वर्णनं कथासरित्सागरे अस्ति",["शेखरज्योतिः"],"",[]],["n","सर्पनामविशेषः ।","शेरभस्य उल्लेखः अथर्ववेदे अस्ति",["शेरभः"],"",[]],["n","सर्पनामविशेषः ।","शेरभकस्य उल्लेखः अथर्ववेदे अस्ति",["शेरभकः"],"",[]],["n","एकः पुरुषः ।","शेलगस्य उल्लेखः प्रवरग्रन्थेषु अस्ति",["शेलगः"],"",[]],["n","एकः पुरुषः ।","शेवलदत्तः पाणिनिना वर्णितः",["शेवलदत्तः"],"",[]],["n","एकः पुरुषः ।","शेवलेन्द्रदत्तः पाणिनिना वर्णितः काशिका-वृत्तौ च अस्य उल्लेखः अस्ति",["शेवलेन्द्रदत्तः"],"",[]],["n","एकः पर्वतः ।","शेवालघोषस्य उल्लेखः विक्रमादित्यचरित्रे अस्ति",["शेवालघोषः"],"",[]],["n","एकः वैयाकरणः ।","शेषचक्रपाणिनः उल्लेखः कोषे अस्ति",["शेषचक्रपाणिः"],"",[]],["n","एकं काव्यम् ।","शेषचिन्तामणेः उल्लेखः कोषे अस्ति",["शेषचिन्तामणिः"],"",[]],["n","एकः लेखकः ।","शेषशार्ङ्गधरस्य उल्लेखः विवरणपुस्तिकायाम् अस्ति",["शेषशारङ्गधरः"],"",[]],["n","एकः वैयाकरणः ।","शेषाद्रेः उल्लेखः विवरणपुस्तिकायाम् अस्ति",["शेषाद्रिः"],"",[]],["n","लेखकनामविशेषः ।","शेषानन्दः इति द्वयोः लेखकयोः नाम अस्ति",["शेषानन्दः"],"",[]],["n","एका स्त्री ।","शेष्याः उल्लेखः विवरणपुस्तिकायाम् अस्ति",["शेषी"],"",[]]],"w":{"शेष":[0,2,4,6,9,16],"शेषित":[0],"शेरः":[1],"शेर":[1],"शेषनागः":[3],"शेषनाग":[3],"शेषफलम्":[4],"शेषफल":[4],"शेषः":[4,16,17],"शेवम्":[5],"शेव":[5],"शेखचिल्ली":[7],"शेखरम्":[8],"शेखर":[8,21,22],"शेषम्":[9],"शेषावस्था":[10],"शेषय":[11],"शेफालिका":[12],"शेफाली":[12],"शेक्सपियरमहोदयः":[13],"शेक्सपियरमहोदय":[13],"शेखपुरामण्डलम्":[14],"शेखपुरामण्डल":[14],"शेखपुरानगरम्":[15],"शेखपुरानगर":[15],"शेषाचलः":[18],"शेषाचल":[18],"शेवल-पत्रम्":[19],"शेवल-पत्र":[19],"शेषभूत":[20],"शेखरः":[21,22],"शेखरज्योतिः":[23],"शेखरज्योति":[23],"शेरभः":[24],"शेरभ":[24],"शेरभकः":[25],"शेरभक":[25],"शेलगः":[26],"शेलग":[26],"शेवलदत्तः":[27],"शेवलदत्त":[27],"शेवलेन्द्रदत्तः":[28],"शेवलेन्द्रदत्त":[28],"शेवालघोषः":[29],"शेवालघोष":[29],"शेषचक्रपाणिः":[30],"शेषचक्रपाणि":[30],"शेषचिन्तामणिः":[31],"शेषचिन्तामणि":[31],"शेषशारङ्गधरः":[32],"शेषशारङ्गधर":[32],"शेषाद्रिः":[33],"शेषाद्रि":[33],"शेषानन्दः":[34],"शेषानन्द":[34],"शेषी":[35]}}