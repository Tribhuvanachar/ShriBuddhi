{"s":[["n","सूर्यात् चतुर्थः ग्रहः।","शास्त्रज्ञाः मङ्गलग्रहं ज्ञातुमिच्छन्ति।",["मङ्गलग्रहः","मङ्गलः","अजपतिः","कोणः","ऐलः","भौमः","अजपतिः","अङ्गारकः","लोहिताङ्गः","रक्ताङ्गः","महीसुतः","आवनेयः"],"ग्रहः",["ಮಂಗಳ ಗ್ರಹ","ಕುಜ ಗ್ರಹ","ಗ್ರಹಗಳಲ್ಲಿ ಒಂದು"]],["n","पौराणिकः राजाविशेषः।","उर्वश्या उत्पन्नः दृढायुनामकः ऐलस्य पुत्रः आसीत्।",["ऐलः"],"पौराणिकपुरुषः",[]],["n","मुम्बईनगर्याः पूर्वस्यां दिशि दशकिलोमीटरं यावत् वर्तमानः द्वीपः।","ऐलिफेन्टाद्वीपस्य कन्दराः प्रसिद्धाः सन्ति।",["ऐलिफेन्टाद्वीपः"],"द्वीपः",[]],["n","एकं स्थानम् ।","ऐलधानस्य उल्लेखः रामायणे अस्ति",["ऐलधानः"],"",[]],["n","एका नदी ।","ऐलधान्याः उल्लेखः कोषे अस्ति",["ऐलधानी"],"",[]],["n","एका नदी ।","ऐलायाः उल्लेखः हरिवंशे अस्ति",["ऐला"],"",[]]],"w":{"ऐलः":[0,1],"ऐल":[0,1],"ऐलिफेन्टाद्वीपः":[2],"ऐलिफेन्टाद्वीप":[2],"ऐलधानः":[3],"ऐलधान":[3],"ऐलधानी":[4],"ऐला":[5]}}