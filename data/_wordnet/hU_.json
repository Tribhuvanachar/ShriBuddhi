{"s":[["n","मस्जिदेषु धर्मगुरोः आवाहनं येन सः यवनान् प्रार्थनां कर्तुम् आमन्त्रयति।","हूतिं श्रुत्वा अहमदः कार्यं त्यक्त्वा यवनदेवालयं गतः।",["हूतिः","आहूतिः"],"हूतिः",["ನಮಾಜಿನ ಕೂಗು"]],["n","श्वानसदृशः वन्यपशुः।","शृगालः मांसाहारी अस्ति।",["शृगालः","सृगालः","जम्बुकः","जम्बूकः","वञ्चकः","क्रोष्टा","गोमी","क्रश्वा","भूरिमायः","घोररासनः","हूरवः","श्वभीरुः"],"मांसाहारी",["ನರಿ","ಜಂಬುಕ","ಬಳ್ಳು"]],["n","यवनमतानुसारेण जन्नते वर्तमाना अप्सरा।","हूरा जन्नते निवसति।",["हूरा"],"कल्पितजीवः",["ಅಪ್ಸರೆ","ಚಲುವೆ","ಸೌಂದರ್ಯವತಿ"]],["n","प्रतिद्वन्द्विनं योद्धुम् आहूयते तादृशी क्रिया।","शत्रोः आह्वानम् अनादृत्य सः अग्रे अगच्छत्।",["आह्वानम्","आकारणम्","हूतिः","प्रत्याह्वानम्","समाह्वानम्","आह्वा","उपहूतिः","अभिग्रहः"],"आहवः",["ಸವಾಲು"]],["n","कमपि आहूय उच्चैः कृतं सम्बोधनम्।","स्वामिनः हूतिं श्रुत्वा दासः वेगेन आगतः।",["हूतिः","आहूः","होत्रा"],"शब्दः",["ಕೂಗು","ಕರೆ","ಕರೆಯುವಿಕೆ","ಕೂಗುವಿಕೆ"]],["n","एकः गन्धर्वः।","हूह्वः वर्णनं पुराणेषु वर्तते।",["हूहूः"],"गन्धर्वः",[]],["n","समीपमानेतुम् उच्चैः कस्यचित् नाम्ना सम्बोधनस्य क्रिया ।","आह्वानं स्थागयतु सः अत्र नास्ति ।",["आह्वानम्","हूतिः"],"क्रिया",[]],["n","एकः कुटुम्बः ।","हूणानाम् उल्लेखः विवरणपुस्तिकायाम् अस्ति",["हूणः"],"",[]],["n","एकः जनसमुदायः ।","हूरहूणस्य उल्लेखः कोषे अस्ति",["हूरहूणः"],"",[]]],"w":{"हूतिः":[0,3,4,6],"हूति":[0,3,4,6],"हूरवः":[1],"हूरव":[1],"हूरा":[2],"हूहूः":[5],"हूहू":[5],"हूणः":[7],"हूण":[7],"हूरहूणः":[8],"हूरहूण":[8]}}