{"s":[["n","नौकायाः वाहनार्थे उपयुक्तः दण्डः।","नाविकः क्षेपण्या नौकां वाहयति।",["क्षेपणी","क्षेपणिः","क्षिपणिः","क्षिपणी","क्षपणी","नौकादण्डः","नौदण्डः","अरित्रम्","आरित्रम्","तरण्डः","तरिरथः"],"जलयान-उपकरणम्",["ಹುಟ್ಟು","ಹಟ್ಟು ಗೋಲು"]],["n","नद्यादि-सन्तरणार्थम् काष्ठादिभिः विनिर्मितः यानविशेषः।","विदुरेण प्रेषितः नरः मनोमारुतगामिनीं सर्ववातसहां यन्त्रयुक्तां नावं दर्शयामास।",["नौः","नौका","तरिका","तरणिः","तरणी","तरिः","तरी","तरण्डी","तरण्डः","पादालिन्दा","उत्प्लवा","होडः"],"जलयानम्",["ನೌಕೆ","ನಾವ್","ಹಡಗು","ದೋಣಿ."]],["n","लोहमययन्त्रं येन नौका बध्यते।","नाविकः विश्रामार्थे गङ्गातटे अरित्रं स्थापयति।",["अरित्रम्","नौबन्धनकीलः"],"उपकरणम्",["ಲಂಗರು"]],["v","नौदण्डकरणकः नौकाकर्मकः जलाधिकरणकः तरणानुकूलः व्यापारः।","नाविकः नौदण्डेन नौकां वहति।",["नौकां वह्","नौकां प्रेरय","नौकां संचालय","नौकां प्रचोदय","नौकां प्रणोदय"],"सञ्चालय्",["ದೋಣಿ ನಡಿಸು","ಹುಟ್ಟು ಹಾಕು"]],["n","सः चोरः यः नौकां तथा च सागरीयात्रिणम् अपहरति।","नौसैनिकाः जलदस्यून् अगृह्णन्।",["जलदस्युः","नौदस्युः"],"अपहारकः",["ಕಡಲ್ಗಳ್ಳ"]],["n","जलाशयेषु कृता यात्रा।","सः जलयात्रां करोति।",["जलयात्रा","नौयात्रा"],"यात्रा",["ನೀರಿನ ಪ್ರಯಾಣ","ನೌಕಾಯಾನ","ನೀರಿನ ಪ್ರವಾಸ"]],["n","सः घट्टः यत्र नौका बध्यते तथा च यत्र यात्रार्थे जनाः नौकायाम् उपविशन्ति।","गङ्गां पारं गन्तुं नौकाघट्टे नौका आगता।",["नौकाघट्टः","नौघट्टः"],"घट्टः",["ನೌಕಾಘಟ್ಟ","ನೌಕಾ ಘಟ್ಟ","ನೌಕಾ-ಘಟ್ಟ","ಹಡಗಿನಘಟ್ಟ"]],["a","यत् नावा तरणीयम्।","एषः जलाशयः नौतरणीयः अस्ति।",["नौतरणीय"],"",["ಹಡಗಿನ ಸಂಚಾರಕ್ಕೆ ಯೋಗ್ಯವಾದ","ಹಡಗಿನ ಸಂಚಾರಕ್ಕೆ ಯೋಗ್ಯವಾದಂತ","ಹಡಗಿನ ಸಂಚಾರಕ್ಕೆ ಯೋಗ್ಯವಾದಂತಹ","ನೌಕಾಸಂಚಾರಯೋಗ್ಯ"]],["n","बृहन्नौकायाः सः दण्डः यस्मै वातवस्त्रं बध्यते।","वायुवेगात् नौकायाः कूपकः भग्नः।",["कूपकः","कूपः","गुणवृक्षकः","गुणवृक्ष","नौकूपकः"],"स्तम्भः",["ಹಡಗಿನ ಪಟದ ಕಂಬ"]],["n","सा सेना या नौकायां वसति तथा च या नद्यां सागरे वा स्थित्वा युद्ध्यते ।","मोहनः जलसेनां गन्तुम् इच्छति।",["जलसेना","नौसेना"],"सेना",["ಜಲಸೇನೆ","ನೌಕಾದಲ","ನೌಕಾದಳ","ನೌಕಾಪಡೆ"]],["n","समुद्रस्य तटे वर्तमानः नौकायाः आश्रयस्थानम् ।","नैकाः नौकाः नौकाश्रये स्थिताः।",["नौकाश्रयः","क्षयणः"],"स्थलम्",["ಬಂದರು","ರೇವು","ನೌಕಾನಿಲ್ದಾಣ"]],["n","नौकादीनां समूहः।","समुद्रस्य तटे नौसाधनम् अस्ति।",["नौसाधनम्"],"समुदायः",["ವಾವೆ ಅಥವಾ ಹಡಗುಗಳ ಸಮೋಹ"]],["n","नौसेनायाः अध्यक्षः।","राजीवस्य पिता नौसेनाध्यक्षः अभवत्।",["नौसेनाध्यक्षः","जलसेनाध्यक्षः"],"सेनाध्यक्षः",["ನೌಕಾಪಡೆಯ ಅಧ್ಯಕ್ಷ","ನೌಕ್ಷಾಪಡೆಯಅಧ್ಯಕ್ಷ","ಜಲಸೇನಾಧ್ಯಕ್ಷ","ಜಲಸೇನಾ ಅಧ್ಯಕ್ಷ"]],["n","तत् विस्तृत-वस्त्रं यद् नौकायाः पुलिन्दे वायुतः गतिनिर्धारणार्थे बध्यते।","आकस्मिकागतेन अतिवातेन नौकापटः विदीर्णः।",["नौकापटः","वातवसनम्","वायुवसनम्","नौकावसनम्","नौवसनम्","नौवस्त्रम्","वातवस्त्रम्","वायुवस्त्रम्","वायुपटः","जवनिका","मरुत्पटः","वातपटः"],"पटम्",["ಹಡಗಿನ ಪಟ","ಹಾಯಿ"]],["n","नौकायाः समाघातेन नाशस्य क्रिया।","पोतभङ्गे नैके जनाः जलसमाधिः प्राप्तवन्ताः।",["पोतभङ्गः","प्रवहणभङ्गः","यानभङ्गः","वहनभङ्गः","वहित्रभङ्गः","विप्लवः","नौव्यसनम्"],"क्रिया",["ಹಡಗೊಡೆತ","ನೌಕಾಘಾತ","ನೌಕಾ-ಭಂಗ","ಭಗ್ನನೌಕೆ"]],["n","यन्त्रचालितं तत् यानं यद् समुद्रं गच्छति।","ह्यः अस्माभिः भारतदेशस्य नौसेनायाः विराट इति अर्णवपोतः दृष्टः।",["अर्णवपोतः","समुद्रयानम्","कण्ठालः","जलयानम्","तरन्ती","नावः","नौका","नौ","परिप्लवः","पोत्रम्","बोहित्थः","बोहित्थम्"],"जलयानम्",["ನೌಕೆ","ಹಡಗು","ನಾವೆ","ಜಹಜು"]],["n","यः नौकां वहति।","सः नौसेनायां क्षेपणिकः अस्ति।",["क्षेपणिकः","नावाजः","नावी","नियामः","नियामकः","नौजीविकः","पोतवाहः","पोतवाहकः"],"मनुष्यः",["ನಾವಿಕ"]],["n","अर्णवपोते यः कार्यं करोति।","मम देवरः जलसेनायां नौजीविकः अस्ति।",["नौजीविकः","नौचरः"],"मनुष्यः",["ನಾವಿಕ"]],["n","मारिटेनियादेशस्य राजधानी।","नौएकचोटनगरं मारिटेनियादेशस्य पश्चिमे वर्तते।",["नौएकचोटनगरम्"],"राजधानी",[]],["n","समुद्रीयसेनायाः सैनिकः।","राधेश्याममहोदयस्य पुत्रः नौसैनिकः अस्ति",["नौसैनिकः","समुद्रीयसैनिकः","नौयोद्धा"],"सैनिकः",["ಜಲಸೇನೆಯ ಸೈನಿಕ","ಜಲಸೇನೆಯ-ಸೈನಿಕ","ನೌಕಾದಲದ ಸೈನಿಕ","ನೌಕಾದಲದ-ಸೈನಿಕ"]],["n","नौकायां वर्तमानः उन्नतः भागः।","केचन कर्मकराः नौकातले उपविशन्ति।",["नौकातलम्","नौतलम्","नौकास्तरणम्"],"वेदिका",[]],["n","नौकया मनोरञ्जनार्थे कृता यात्रा।","सः नौकायनस्य आनन्दम् अनुभवति।",["नौकायनम्"],"यात्रा",["ನೌಕಾಯಾನ"]],["n","आनन्द-प्राप्त्यर्थे नावा तार्यम्।","वयं काश्मीरप्रान्ते रमणीयं नौकाविहारम् अन्वभवन्।",["नौकाविहारः","नौतार्यम्","नाव्यम्"],"कर्म",["ನೌಕಾವಿಹಾರ","ದೋಣಿ ವಿಚಾರ"]],["n","यस्याः रज्जोः साहाय्येन नौका तीरम् आनीयते सा रज्जुः ।","नौका यदा तीरम् आगता तदा नाविकः नौबन्धनकीलेन नौकां तीरं प्रति कृष्टवान् ।",["नौबन्धनकीलम्"],"रज्जुः",[]],["n","नौकायाः लाङ्गलस्य अर्गला ।","नौबन्धनार्गला अत्यन्तं सुदृढा भवति ।",["नौबन्धनकीलार्गला"],"अर्गला",[]],["n","वातवसनोत्तलनस्य रज्जुः।","पोतवाहः नौरज्ज्वा नौकापटं बध्नाति।",["नौरज्जुः","नौगुणः"],"रज्जुः",[]],["n","नौकायां कार्यं कुर्वन् कर्मकरः ।","नाविकेन यात्रिकस्य सहायता कृता ।",["नाविक","नौचरः","नावारोहः"],"कर्मकरः",["ಕಲಾಸಿ","ನಾವಿಕ - ತಂಡ"]],["n","यः नौकया यात्रां करोति।","नौयात्री नौकायां स्थित्वा समुद्रं पश्यति।",["नौयात्री"],"यात्रिकः",["ಹಡಗಿನವ"]],["n","नौकायाः एकस्मात् स्थानात् अन्यत्र नयनम् ।","नौकायनं समाप्य क्षेपणिकः निद्राति ।",["नौकायनम्"],"क्रिया",[]],["n","एकः विद्यालयः ।","नौकायस्य उल्लेखः कोषे अस्ति",["नौकायः"],"",[]],["n","एकः पुरुषः ।","नौनिधिरामस्य उल्लेखः विवरणपुस्तिकायाम् अस्ति",["नौनिधिरामः"],"",[]]],"w":{"नौकादण्डः":[0],"नौकादण्ड":[0],"नौदण्डः":[0],"नौदण्ड":[0],"नौः":[1],"नौ":[1,15],"नौका":[1,15],"नौबन्धनकीलः":[2],"नौबन्धनकील":[2,23],"नौकां वह्":[3],"नौकां प्रेरय":[3],"नौकां संचालय":[3],"नौकां प्रचोदय":[3],"नौकां प्रणोदय":[3],"नौदस्युः":[4],"नौदस्यु":[4],"नौयात्रा":[5],"नौकाघट्टः":[6],"नौकाघट्ट":[6],"नौघट्टः":[6],"नौघट्ट":[6],"नौतरणीय":[7],"नौकूपकः":[8],"नौकूपक":[8],"नौसेना":[9],"नौकाश्रयः":[10],"नौकाश्रय":[10],"नौसाधनम्":[11],"नौसाधन":[11],"नौसेनाध्यक्षः":[12],"नौसेनाध्यक्ष":[12],"नौकापटः":[13],"नौकापट":[13],"नौकावसनम्":[13],"नौकावसन":[13],"नौवसनम्":[13],"नौवसन":[13],"नौवस्त्रम्":[13],"नौवस्त्र":[13],"नौव्यसनम्":[14],"नौव्यसन":[14],"नौजीविकः":[16,17],"नौजीविक":[16,17],"नौचरः":[17,26],"नौचर":[17,26],"नौएकचोटनगरम्":[18],"नौएकचोटनगर":[18],"नौसैनिकः":[19],"नौसैनिक":[19],"नौयोद्धा":[19],"नौकातलम्":[20],"नौकातल":[20],"नौतलम्":[20],"नौतल":[20],"नौकास्तरणम्":[20],"नौकास्तरण":[20],"नौकायनम्":[21,28],"नौकायन":[21,28],"नौकाविहारः":[22],"नौकाविहार":[22],"नौतार्यम्":[22],"नौतार्य":[22],"नौबन्धनकीलम्":[23],"नौबन्धनकीलार्गला":[24],"नौरज्जुः":[25],"नौरज्जु"