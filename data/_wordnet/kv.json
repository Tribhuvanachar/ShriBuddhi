{"s":[["n","कस्मिन्नपि विषये जातः विसंवादः।","अद्य तेन सह मम झझनं जातम्।",["झझनम्","समाघातः","संघट्टः","सङ्घटनम्","सङ्घुष्टः","झः","क्वणितम्","वर्व्वरः"],"वैमत्यम्",["ಜಗಳ","ಜಟಾಪಟಿ"]],["a","यः बुदबुदे जले पक्वः।","सः प्रातः एकं क्वथितम् अण्डम् अत्ति।",["क्वथित"],"",["ಬೇಯಿಸಿದ","ಬೇಯಿಸಿದಂತ","ಬೇಯಿಸಿದಂತಹ","ಕುದಿಸಿದ"]],["d","कस्मिन् स्थाने।","रामः कुत्र अस्ति।",["कुत्र","क्व"],"",["ಎಲ್ಲಿ"]],["d","कस्याम् दिशि।","सः कुत्र गतः।",["कुत्र","क्व"],"",["ಎಲ್ಲಿಗೆ","ಎಲ್ಲಿ"]],["n","गृध्रजातीयः महान् खगः यः गृध्राद् लघुः अस्ति।","चिल्लः मांसभक्षी खगः अस्ति।",["चिल्लः","चिल्ला","आजः","कामायुः","क्वणितेक्षणः","खगेन्द्रः","खगेश्वरः","शकुनः","दाक्षाय्यः"],"खगः",["ಹದ್ದು","ಗಿಡುಗ","ಗರುಡ","ರಣ ಹದ್ದು"]],["n","उष्णतया फेनेन सह उपरिगमनस्य क्रिया।","चुल्ल्यां स्थापिते दुग्धे उत्सेचनम् अभवत्।",["उत्सेचनम्","आस्रवः","क्वथनम्"],"कर्म",["ಉಕ್ಕು"]],["n","तन्त्वादीन् आहत्य कृतः ध्वनिः।","महाभारतस्य युद्धे सैनिकानां धनुषः टङकारः वारंवारं अनदत्।",["टङ्कारः","क्वणितम्"],"शब्दः",["ಠೇಂಕಾರ"]],["v","किङ्किण इति शब्दनानुकूलः व्यापारः।","तस्याः आभूषणानि शिञ्जते।",["शिञ्ज्","विशिञ्ज्","क्वण्","झणझणाय","किङ्किणाय","झञ्झनं कृ"],"क्वण्",["ಝನಝನ ಶಬ್ಧಮಾಡು"]],["n","मेघयोः परस्पराघातस्य शब्दः।","मेघस्य स्तनितं श्रुत्वा बालकाः गृहं प्रति धावति।",["स्तनितम्","आस्फोटनम्","ध्वनितम्","क्वणितम्"],"शब्दः",["ಗುಡುಗು","ಮೇಘಧ್ವನಿ","ಗರ್ಜನೆ"]],["d","सा क्रिया या नियमेन न भविष्यति।","क्वचिद् एव अहं हट्टं गच्छामि।",["क्वचित्","कदाचित्","कर्हिचित्","विरलम्","वैरल्येन","यथाकथाच"],"",[]],["v","भुक्तानां पदार्थानां जठरे पाचनानुकूलः व्यापारः।","गरिष्टं भोजनं सुलभतया जठरे न जीर्यति।",["जठरे जॄ","उदरे जॄ","पच्","परिपच्","क्वथ्"],"परि वृत्",["ಜೀರ್ಣವಾಗು","ಪಚನವಾಗು","ಕರಗು"]],["v","आघातेन ध्वनेः उत्पन्नानुकूलः व्यापारः।","मन्दिरे घण्टा क्वणति।",["क्वण्"],"अस्",["ಹೊಡೆ","ಬಾರಿಸು","ಮೊಳಗು","ಧ್ವನಿಮಾಡು"]],["a","यद् क्वथ्यते।","क्वथितात् अन्नात् शरीरं ऊर्जां प्राप्नोति।",["क्वथित","जीर्ण","प्रजीर्ण","रुचित","पक्व"],"",["ಪಚನವಾದ","ಅರಗಿದ"]],["v","व्यक्तवाग्रहितानां शब्दनानुकूलः व्यापारः।","गुडे मक्षिकाः क्वणन्ति।",["क्वण्","रु","प्रोत्कूज्","गुञ्ज्","क्ष्विड्","कू","मश्"],"ध्वन्",["ಗುಯಿ ಗುಟ್ಟು"]],["d","कस्मिन् अपि स्थाने।","अत्र तत्र कुत्रापि सः न दृश्यते।",["कुत्रापि","कुत्रचित्","कुत्रचिद्","कुत्र अपि","कूचिद्","क्व"],"",[]],["n","शतकिलोग्रामपरिमाणस्य मापकः।","कृषीवलेन पञ्च क्विन्टलपरिमाणानि गोधूमानि विक्रीतानि।",["क्विन्टलपरिमाणम्"],"परिमाणम्",["ಕ್ವಿಂಟಾಲ್","ಕ್ವಿಂಟಲ್"]],["n","यदा आवश्यकं तदा सङ्केतध्वनिः यस्मात् श्रोतुं शक्यते।","सः मह्यं क्वणितघटीम् उपायनरूपेण अददात्।",["क्वणितघटी"],"घटीयन्त्रम्",[]],["n","द्रवे अत्युष्णतया बुद्बुदोद्गमनम्।","दुग्धस्य क्वथने आरम्भे सति ज्वालां न्यूनीकरोतु।",["क्वथनम्","उत्क्वथनम्","उत्पचनम्"],"क्रिया",["ಕಾಯಲು","ಮುರಳಲು","ಕುದಿಸಲು"]],["n","द्रवपदार्थे अत्युष्णतया बुद्बुदोद्गमनं यावत् उष्णीकरणस्य क्रिया।","जलदुग्धयोः क्वथनम् भिन्ने तापमाने भवति।",["क्वथनम्","उत्क्वथनम्"],"क्वथनम्",[]],["n","आस्ट्रेलियादेशे वर्तमानम् एकं राज्यम्।","मनोहरः क्वींसलैण्डराज्ये निवसति।",["क्वींसलैण्डराज्यम्"],"स्थलम्",["ಸ್ವಿಜರ್ ಲ್ಯಾಂಡ್"]],["n","बलूचिस्तानदेशस्य राजधानी।","रहीमः क्वेटानगरे निवसति।",["क्वेटानगरम्"],"पुरम्",["ಕ್ವೇಟಾ"]],["n","मलेशियादेशस्य राजधानी या  मलयद्वीपे स्थिता अस्ति ।","गुर्बखशः क्वालालम्पूरस्य विद्यपीठे स्वस्य अध्ययनं पूर्णं करिष्यति ।",["क्वालालम्पुरम्"],"राजधानी",[]],["n","विपञ्च्यादिभिः वाद्यैः उत्पद्यमाणः ध्वनिः ।","तस्य वीणावादनस्य क्वणनेन श्रोतारः सन्तुष्टाः जाताः ।",["क्वणनम्"],"",[]],["n","कश्चन खाद्यविशेषः यश्च धान्यशाकादीनि संस्थाप्य पच्यते ।","क्वथितं इडली अपूपादि ।",["क्वथितम्"],"व्यञ्जनम्",[]]],"w":{"क्वणितम्":[0,6,8],"क्वणित":[0,6,8],"क्वथित":[1,12,23],"क्व":[2,3,14],"क्वणितेक्षणः":[4],"क्वणितेक्षण":[4],"क्वथनम्":[5,17,18],"क्वथन":[5,17,18],"क्वण्":[7,11,13],"क्वचित्":[9],"क्वथ्":[10],"क्विन्टलपरिमाणम्":[15],"क्विन्टलपरिमाण":[15],"क्वणितघटी":[16],"क्वींसलैण्डराज्यम्":[19],"क्वींसलैण्डराज्य":[19],"क्वेटानगरम्":[20],"क्वेटानगर":[20],"क्वालालम्पुरम्":[21],"क्वालालम्पुर":[21],"क्वणनम्":[22],"क्वणन":[22],"क्वथितम्":[23]}}