{"s":[["a","वर्णविशेषः।","सः श्वेतं वस्त्रं परिगृह्णाति।",["शुक्ल","धवल","श्वेत","सित","श्येत","शुभ्र","शुचि","अवदात","विशद","गौर","धौत","पाण्डुर"],"",["ಬಿಳಿ","ಶ್ವೇತ","ಧವಳ","ರಜತ"]],["n","श्वेतवर्णीयः दीप्तिमान् धातुः तथा च यस्मात् अलङ्कारादयः निर्मीयन्ते।","सा रजतस्य अलङ्कारान् धारयति।",["रजतम्","रूप्यम्","रौप्यम्","श्वेतम्","श्वेतकम्","सितम्","धौतम्","शुक्लम्","शुभ्रम्","महाशुभ्रम्","खर्जूरम्","खर्जुरम्"],"मूल्यवद्धातुः",["ಬೆಳ್ಳಿ","ರಜತ","ಅಮರ","ಅರ್ಜುರ"]],["n","पुराणेषु वर्णितः एकः ऋषिः यः उपमन्योः गुरुः आसीत्।","धौम्यः धूमऋषेः पुत्रः आसीत्।",["धौम्यः"],"आप्तः",[]],["n","राजस्थानप्रान्ते वर्तमानम् एकं मण्डलम्।","धौलपुरमण्डलस्य मुख्यालयः धौलपुरे वर्तते।",["धौलपुरमण्डलम्"],"मण्डलम्",[]],["n","\"राजस्थानप्रान्ते वर्तमानम् एकं नगरम्।","धौलपुरे कारागृहे अपराधी बद्धः।",["धौलपुरम्"],"पुरम्",[]],["a","प्रक्षालितम्।","रमेशः धौतं वस्त्रम् आतपे शोषयति।",["धौत"],"",["ಒಗೆದ","ಒಗೆದಂತ","ಒಗೆದಂತಹ","ತೊಳೆದ"]],["n","पर्वतविशेषः।","धौलाधरस्य पर्वतश्रेण्यां नैकानि सुन्दराणि पर्यटनस्थलानि सन्ति।",["धौलाधरः"],"पर्वतः",[]],["n","यस्मिन् धूमस्य गन्धः भवति ।","इमं धौमीयं दुग्धम् अहं पातुं न शक्नोमि ।",["धौमीय","सधूमक","सोवाल","धूमवत्","धूम्र"],"",[]],["n","एका शुरा आदिमजातिः ।","धौर्तेयस्य उल्लेखः कोषे अस्ति",["धौर्तेयः"],"",[]]],"w":{"धौत":[0,1,5],"धौतम्":[1],"धौम्यः":[2],"धौम्य":[2],"धौलपुरमण्डलम्":[3],"धौलपुरमण्डल":[3],"धौलपुरम्":[4],"धौलपुर":[4],"धौलाधरः":[6],"धौलाधर":[6],"धौमीय":[7],"धौर्तेयः":[8],"धौर्तेय":[8]}}