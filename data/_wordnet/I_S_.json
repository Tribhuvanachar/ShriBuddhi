{"s":[["n","धर्मग्रन्थैः अखिलसृष्टेः निर्मातृरूपेण स्वामिरूपेण वा स्वीकृता महासत्ता।","ईश्वरः सर्वव्यापी अस्ति।",["ईश्वरः","परमेश्वरः","परेश्वरः","परमात्मा","देवः","अमरः","विबुधः","अनिमिषः","अजरः","चिरायुः","सुचिरायुः","भगवान्"],"",["ಪ್ರಧಾನ ಆತ್ಮ","ಮುಖ್ಯ ಆತ್ಮ","ಪರಮಾತ್ಮ","ಜಗದೀಶ"]],["n","सा प्रीतिः या ईश्वरं प्रति अस्ति।","आनन्दस्य अनुभूति ईश्वरप्रीत्या एव प्राप्यते।",["ईश्वरप्रीतिः","ईश्वरप्रेम"],"स्नेहः",["ಅಲೌಕಿಕ ಪ್ರೇಮ","ಅಲೌಕಿಕ-ಪ್ರೇಮ"]],["n","यत्र भवने देवता प्रतिष्ठापनां कृत्वा पूज्यते।","सः स्नात्वा मन्दिरं गच्छति।",["मन्दिरम्","देवालयः","ईश्वरसद्म","देवकुलम्","देवगृहम्","देवभवनम्","देववेश्मन्","देवागारम्","देवायतनम्","देवावसथः","देवतागारम्","परिष्कन्दः"],"यौवनम्",["ದೇವಾಲಯ","ಮಂದಿರ","ಆಲಯ","ದೇವಸ್ಥಾನ"]],["a","ईश्वरसम्बन्धी।","भक्तियुगीनैः सत्कविभिः ईश्वरीयस्य ज्ञानस्य प्रचारः प्रभुततया कृतः।",["ईश्वरीय","दिव्य","देवकीय","दैव","देवक","दैविक","ऐश्वर","ऐश","ऐश्वरीय"],"",["ದೈವಿಕ","ದೈವಿಕವಾದ","ದೈವಿಕವಾದಂತ","ದೈವಿಕವಾದಂತಹ"]],["n","वेदेश्वरादीनां प्रामाण्यम् अङ्गीकुर्वत् मतम्।","वयम् ईश्वरवादस्य समर्थकाः।",["ईश्वरवादः","आस्तिक्यवादः","आस्तिक्यमतम्","आस्तिक्यम्"],"सिद्धान्तः",["ಆಸ್ತಿಕ","ಆಸ್ತಿಕತೆ","ಆಸ್ತಿಕವಾದ"]],["n","देवताविशेषः- हिन्दूधर्मानुसारं सृष्टेः विनाशिका देवता।","शिवस्य अर्चना लिङ्गरूपेण प्रचलिता अस्ति।",["शिवः","शम्भुः","ईशः","पशुपतिः","पिनाकपाणिः","शूली","महेश्वरः","ईश्वरः","सर्वः","ईशानः","शङ्करः","चन्द्रशेखरः"],"देवः",["ಅಂಬರೀಶ","ಪಂಚಾನನ","ವೈದ್ಯಾನಾಥ","ವ್ಯೋಮಕೇಶ"]],["a","यः ईश्वरेण दत्तः।","मानवस्य जीवनम् ईश्वरप्रदत्तम् अस्ति।",["ईश्वरप्रदत्त","भगवद्दत्त","प्रभुप्रदत्त"],"",["ಈಶ್ವರನ ವರಪ್ರಸಾದ"]],["n","ईश्वरस्य इच्छा।","ईश्वरेच्छया एव सर्वं भवति इति मन्यन्ते सन्तः।",["ईश्वरेच्छा","दैवेच्छा","देवेच्छा"],"इच्छा",["ದೈವೇಚ್ಛೆ","ದೈವ ಇಚ್ಛೆ","ದೈವ-ಇಚ್ಛೆ","ಪ್ರಭುವಿನ ಇಚ್ಛೆ"]],["n","सा देवी यया नैके दैत्याः हताः तथा च या आदिशक्तिः अस्ति इति मन्यते।","नवरात्रोत्सवे स्थाने स्थाने दुर्गायाः प्रतिष्ठापना क्रियते।",["दुर्गा","उमा","कात्यायनी","गौरी","ब्रह्माणी","काली","हैमवती","ईश्वरा","शिवा","भवानी","रुद्राणी","सर्वाणी"],"",["ಚಾಮುಂಡಿ","ಚಾಮುಂಡೇಶ್ವರಿ","ಮಹಾಕಾಳಿ","ದುರ್ಗಿ"]],["n","प्राप्तयौवना स्त्री। (प्राग् यौवना युवतिः इति वात्स्यायनः।)","यो यं विचिन्तयति यानि स तन्मयत्वम्। यस्स्माद् अतः सुभगया इव गता युवत्यः॥",["युवती","युवतिः","तरुणी","यूनी","तलुनी","दिक्करी","धनिका","धनीका","मध्यमा","दृष्टरजाः","मध्यमिका","ईश्वरी"],"स्त्री",["ಯುವತಿ","ತರುಣಿ"]],["n","केषाञ्चित् वस्तुस्थानादीनाम् अधिकारिणी स्त्री।","श्रीमती उर्मिलाअग्रवालमहोदया अस्य आपणस्य स्वामिनी अस्ति।",["स्वामिनी","अधिष्ठात्री","शासित्री","ईश्वरी","भट्टिनी"],"स्त्री",["ಯಜಮಾನಿ","ಒಡತಿ","ಮಾಲೀಕರು"]],["a","यः वेदादीन् विश्वसीति।","हिन्दूधर्मियाः आस्तिकाः सन्ति।",["आस्तिक","ईश्वरवादी","ईश्वरनिष्ठ"],"",["ಆಸ್ತಿಕ"]],["n","वेदेषु ईश्वरादिषु च यः विश्वसीति।","दुःखितं मनः ईश्वरवादम् आश्रयति।",["ईश्वरवादः","आस्तिक्यवादः","आस्तिक्यम्"],"ज्ञानम्",["ಆಸ್ತಕತೆ","ಆಸ್ತಕ"]],["n","यः ईश्वरस्य अस्तित्वं मन्यते।","महाशिवरात्री इत्याख्यमहोत्सवार्थे नैके आस्तिकाः आगताः।",["आस्तिक","ईश्वरवादी"],"मनुष्यः",["ಆಸ್ತಿಕರು"]],["n","वेदेषु ईश्वरे परलोके वा अविश्वासः।","नास्तिकतया मनुष्यः पापेन लिप्यते।",["नास्तिकता","देवनिन्दा","ईश्वरनिषेधः","नास्तिवादः","शून्यवादः","नास्तिक्यम्","अनास्तिक्यम्","नास्तिकत्वम्","सौगतिकम्"],"ज्ञानम्",["ನಾಸ್ತಿಕತೆ","ನಾಸ್ತಿಕತ್ವ","ನಾಸ್ತಿಕವಾದ","ಹೇತುವಾದ"]],["n","प्रभोः स्थितिः।","प्रभोः प्रभुतां कः आक्षिपति।",["प्रभुता","प्रभुत्वम्","ईशता","ईश्वरत्वम्","ईश्वरता"],"दशा",["ದೈವತ್ವ","ಈಶ್ವರತ್ವ","ಪ್ರಭುತ್ವ"]],["n","वृक्षविशेषः।","शम्याः काष्ठस्य उपयोगः पूजाकार्येषु भवति।",["शमी","सक्तुफला","शिवा","शक्तुफला","शक्तुफली","शान्ता","तुङ्गा","कचरिपुफला","केशमथनी","ईशानी","लक्ष्मीः","तपनतनया"],"वृक्षः",[]],["n","क्षुपविशेषः।","नाकुलस्य मूलं शाखा च औषधरूपेण उपयुज्येते।",["नाकुलः","नाकुली","चविका","सर्पगन्धा","सुगन्धा","रक्तपत्रिका","ईश्वरी","नागगन्धा","अहिभुक्","सरसा","सर्पादंनी","व्यालगन्धा"],"क्षुपः",[]],["a","ईश्वरेण विना।","अनीश्वरं हृदयम् अशान्तं वर्तते।",["अनीश्वर","ईश्वरहीन"],"",["ಈಶ್ವರನಿಲ್ಲದ","ಈಶ್ವರನಿಲ್ಲದಂತ","ಈಶ್ವರನಿಲ್ಲದಂತಹ"]],["n","अष्टानां सिद्धीनाम् एका।","ईशित्वस्य सिद्धया सर्वेषु शासनं शक्यते।",["ईशित्वम्"],"विभूतिः",[]],["n","प्रमुखा उपनिषद्।","ईशोपनिषद् यजुर्वेदस्य भागः।",["ईशोपनिषद्","ईशावाश्य उपनिषद्","ईश"],"",[]],["a","उत्तरपूर्वदिग्भ्यां सम्बद्धः।","भारतस्य ईशान्ये क्षेत्रे अतीव शैत्यं वर्तते।",["ईशान्य"],"",["ಉತ್ತರ-ಪೂರ್ವ","ಉತ್ತರಪೂರ್ವ","ಉತ್ತರ ಪೂರ್ವ","ಪೂರ್ವೋತ್ತರ"]],["n","क्षुपविशेषः।","रुद्रजटायाः पर्णानि मयूरशिखायाः पर्णानि इव भवन्ति।",["रुद्रजटा","रौद्री","जटा","रुद्रा","सौम्या","सुगन्धा","सुवहा","घना","ईश्वरी","रुद्रलता","सुपत्रा","सुगन्धपत्रा"],"झटि",[]],["n","एकादशेषु रुद्रेषु एकः।","ईशानस्य वर्णनं पुराणेषु प्राप्यते।",["ईशानः"],"रुद्राः",[]],["a","ईश्वरनिष्ठः।","ईश्वरपरायणं मनुष्यम् ईश्वरः सर्वदा रक्षति।",["ईश्वरपरायण"],"",["ಈಶ್ವರಪರಾಯಣ","ಈಶ್ವರ ಪಾರಾಯಣ","ಈಶ್ವರ-ಪಾರಾಯಣ"]],["n","योगस्य पञ्च प्रणिधानेषु एकः ।","ईश्वरप्रणिधाने मानवः ईश्वरे सम्पूर्णश्रद्धया स्वं तस्य चरणे अर्पयति ।",["ईश्वरप्रणिधानम्"],"समाधिः",[]],["n","ईश्वरस्य निन्दा ।","देवनिन्दया कोsपि लाभः नास्ति ।",["देवनिन्दा","ईश्वरनिषेधः"],"निन्दा",["ಈಶ್ವರನ ನಿಂದನೆ","ಈಶ್ವರನ ದೂಷಣೆ"]],["n","एकः तडागः ।","ईशसरसः उल्लेखः कोषे अस्ति",["ईशसरः"],"",[]],["n","एकः पुरुषः ।","ईशानस्य वर्णनम् पुराणे वर्तते",["ईशानः"],"",[]],["n","एकः चिकित्सकः ।","ईशानचन्द्रस्य उल्लेखः राजतरङ्गिण्याम् अस्ति",["ईशानचन्द्रः"],"",[]],["n","एका स्त्री ।","ईशानदेव्याः उल्लेखः राजतरङ्गिण्याम् अस्ति",["ईशानदेवी"],"",[]],["n","एकः राजपुत्रः ।","ईश्वरस्य वर्णनम् पुराणे वर्तते",["ईश्वरः"],"",[]],["n","एकः राजपुत्रः ।","ईश्वरस्य उल्लेखः कोषे अस्ति",["ईश्वरः"],"",[]],["n","नैके क्षुपाः ।","ईश्वरः इति नाम्ना नैके क्षुपाः सन्ति",["ईश्वरः"],"",[]],["n","एकः शिक्षकः ।","ईश्वरतीर्थाचार्यस्य उल्लेखः कोषे अस्ति",["ईश्वरतीर्थाचार्यः"],"",[]],["n","एकः राजपुत्रः ।","ईश्वरदत्तस्य उल्लेखः कोषे अस्ति",["ईश्वरदत्तः"],"",[]],["n","एकः पुरुषः ।","ईश्वरवर्मणः उल्लेखः कतासरित्सागरे अस्ति",["ईश्वरवर्मा"],"",[]],["n","एकः शिक्षकः ।","ईश्वरसूर्यः उल्लेखः कोषे अस्ति",["ईश्वरसूरिः"],"",[]],["n","एकः राजा ।","ईश्वरसेनस्य उल्लेखः विष्णुपुराणे अस्ति",["ईश्वरसेनः"],"",[]],["n","क्षुपविशेषः ।","ईश्वरा इति नामकानां नैकेषां क्षुपाणाम् उल्लेखः कोषे अस्ति",["ईश्वरा"],"",[]],["n","एकः विद्वान् ।","ईश्वरानन्दस्य उल्लेखः कोषे अस्ति",["ईश्वरानन्दः"],"",[]]],"w":{"ईश्वरः":[0,5,31,32,33