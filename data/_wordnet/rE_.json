{"s":[["v","शुनः शब्दनानुकूलः व्यापारः।","न जाने ह्यः रात्रौ मम श्वा किमर्थम् अभषत्।",["भष्","बुक्क्","रै"],"कूज्",["ಬೊಗಳು","ಬೌಬೌ ಕೂಗು","ಬೌ-ಬೌ ಕೂಗು"]],["n","पौराणिकः पर्वतविशेषः।","रैवतस्य वर्णनं महाभारते अस्ति।",["रैवतः"],"",[]],["n","दैत्यविशेषः।","रैवतः बालग्रहः अस्ति।",["रैवतः"],"असुरः",[]],["n","चतुर्दशसु मनुषु पञ्चमः मनुः यस्य उत्पत्तिः रेवत्याः अस्ति इति मन्यते।","कथानुसारेण वैवस्वतः रैवतस्य पुत्रः आसीत्।",["रैवतः"],"मनुः",[]],["n","राजस्थानराज्ये वर्तमानः वर्णविशेषः।","राजस्थानराज्ये वर्तमानासु जातिषु रैगरजातिः एका।",["रैगरजातिः"],"जाति",[]],["n","एकः पुरुषः ।","रैक्वस्य उल्लेखः छान्दोग्य-उपनिषदि अस्ति",["रैक्वः"],"",[]],["n","एकं स्थानम् ।","रैक्वपर्णस्य उल्लेखः कोषे अस्ति",["रैक्वपर्णः"],"",[]],["n","एकः पुरुषः ।","रैचीक्यस्य उल्लेखः चतुर्वर्ग-चिन्तामणिः इत्यस्मिन् ग्रन्थे अस्ति",["रैचीक्यः"],"",[]],["n","एकः राजा ।","रैवस्य उल्लेखः भागवतपुराणे अस्ति",["रैवः"],"",[]],["n","एकः पर्वतः ।","रैवतकस्य उल्लेखः महाभारते हरिवंशे पुराणे च अस्ति",["रैवतकः"],"",[]],["n","एकः राजपुत्रः ।","रैवतकस्य उल्लेखः विष्णुपुराणे अस्ति",["रैवतकः"],"",[]],["n","एकः पर्वतः ।","रैवतगिरेः उल्लेखः विवरणपुस्तिकायाम् अस्ति",["रैवतगिरिः"],"",[]],["n","एकं नाटकम् ।","रैवतमदनिकायाः उल्लेखः कोषे अस्ति",["रैवतमदनिका"],"",[]]],"w":{"रै":[0],"रैवतः":[1,2,3],"रैवत":[1,2,3],"रैगरजातिः":[4],"रैगरजाति":[4],"रैक्वः":[5],"रैक्व":[5],"रैक्वपर्णः":[6],"रैक्वपर्ण":[6],"रैचीक्यः":[7],"रैचीक्य":[7],"रैवः":[8],"रैव":[8],"रैवतकः":[9,10],"रैवतक":[9,10],"रैवतगिरिः":[11],"रैवतगिरि":[11],"रैवतमदनिका":[12]}}