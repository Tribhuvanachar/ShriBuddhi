{"s":[["n","मनोरञ्जनात्मिका शरीरव्यापारादिक्रिया।","क्रीडायां जयपराजयौ स्तः एव।",["क्रीडा","खेला","केलिः","लीला","नर्म","कूर्दनम्"],"क्रियारूपम्",["ಆಟ","ಆಟ-ಪಾಠ","ಕ್ರೀಡೆ"]],["n","स्फीतं निष्यूतम् आच्छादनम्।","एषः मूल्यवानः चित्रकटः।",["चित्रकटः","वस्त्रकटः","कूथः"],"शय्या",["ರತ್ನಗಂಬಳಿ","ಜಮಖಾನೆ"]],["n","पर्वतस्य शिरोऽग्रम्।","भारतीयेन पर्वतारोहिणा हिमालयस्य शिखरे भारतस्य त्रिवर्णाः ध्वजः अधिरोपिता।",["शिखरम्","शृङ्गम्","कूटः","ककुद्","ककुदः","ककुदम्","चूडा","पर्वताग्रम्","शैलाग्रम्","अद्रिशृङ्गम्","दशनः","वातरायणः"],"शिखरम्",["ಪರ್ವತ ಶಿಖರ","ಬೆಟ್ಟದ ತುದಿ","ಹಿಮಾಲಯದ ಶೃಂಗ","ಗಿರಿ ಶಿಖರ"]],["n","अवयवविशेषः सः कठोरः अवयवः यः खुरयुक्तानां पशूनां मस्तिष्के वर्तते।","वृषभस्य शृङ्गम् अभिदत्।",["शृङ्गम्","विषाणः","विषाणी","विषाणम्","कूणिका","काहलः","काहला","काहलिका"],"शारीरिकभागः",["ಕೊಂಬು","ಕೂಡು"]],["n","तद् वचनम् यद् अयथार्थम् अन्यायसङ्गतम् अधर्मसङ्गतं च","असत्यं वचनं पापम्।",["असत्यम्","मिथ्या","मृषा","वितथः","अनृतम्","कूटः","कूटम्"],"दुर्गुणः",["ಅಸತ್ಯ","ಸುಳ್ಳು","ಹುಸಿ","ಸಟೆ"]],["n","यः अतीव धूर्तः अस्ति।","कपटिकात् दूरमेव वरम्।",["कपटिकः","कूटछद्मा","खर्परः","डिङ्गर","धवः","धूर्तकः","वमिः","शरण्डः","हरकः"],"पुरुषः",["ಕುಯುಕ್ತಿ","ಕಪಟ","ಕುತಂತ್ರ","ಸ್ವಾರ್ಥಪೂರಿತ ಜಾಣತನ"]],["n","अशुद्धं स्वर्णम्।","स्वर्णकारेण कूटस्वर्णस्य आभूषणं कृतम्।",["कूटस्वर्णम्"],"सुवर्णम्",["ಅಶುದ್ಧ ಚಿನ್ನ","ಅಶುದ್ಧ-ಚಿನ್ನ","ಅಶುದ್ಧ ಸುವರ್ಣ","ಅಶುದ್ಧ-ಸುವರ್ಣ"]],["n","वस्त्रविशेषः यः स्त्रियः स्तनाच्छादनार्थे धारयन्ति।","श्यामा एषा कौशिकां शाटिकां तथा च तदनुरूपम् चोलं परिधृत्य अतीव शोभते।",["चोलः","चोलकम्","कूर्पासः","कञ्चुकः"],"वेशः",["ಕುಪ್ಪುಸ","ರವಿಕೆ","ಕಂಚುಕ","ಕುಪ್ಪಸ"]],["n","वातादिप्रेरितजलकणाः।","शीतकाले धूमिकया आवागमनस्य कृते काठिन्यं जायते।",["धूमिका","धूलिका","धूपिका","शीकरः","खबाष्पः","मृगतृष्णा","मृगतृषा","मृगतृट्","कूहा","कुहेडिका","कुझटिका","कुझटिः"],"प्राकृतिकवस्तु",["ಹಿಮ","ಮಂಜು","ಇಬ್ಬನಿ","ಕಾವಳ"]],["a","यत् सुकरं नास्ति।","युधिष्ठिरः यक्षस्य कूटानां प्रश्नानाम् उत्तराणि लीलया अददात् अनुजानां प्राणान् अरक्षत् च।",["कूट","क्लिष्ट","दुष्कर","मोहन","मोहनीय"],"",["ಕ್ಲಿಷ್ಟವಾದ","ಕ್ಲಿಷ್ಟವಾದಂತ","ಕ್ಲಿಷ್ಟವಾದಂತಹ","ಕಷ್ಟವಾದ"]],["n","कस्यचित् वस्तुनः मध्ये रिक्तम्।","सर्पः विवरात् कोष्ठं प्रविष्टः।",["विवरम्","बिलम्","रन्ध्रम्","छिद्रम्","कुहरम्","शुषिरम्","शुषिः","शुषी","कूपः","अवढः","अवढिः"],"खण्डः",["ಬಿಲ","ತೂತು","ರಂದ್ರ","ಬಿಡುವು"]],["a","यत् शुद्धं न वर्तते।","आपणिकः मह्यं कूटं रुप्यकं प्रत्यददात्।",["कूट","अलीक"],"",["ನಕಲಿ","ನಕಲಿಯಾದ","ನಕಲಿಯಾದಂತ","ನಕಲಿಯಾದಂತಹ"]],["n","कूपकस्य उपरी वर्तमानः भागः।","कूपकशिखरे रक्तं वस्त्रं निबद्धम्।",["कूपकशिखरः"],"शिखरम्",["ದೋಣಿಯೊಳಗಿನ ಬಟ್ಟೆ ಕಟ್ಟುವ ಕಂಬದ ತುದಿ","ಶಿಖರ"]],["n","दीर्घकण्ठयुक्तं काचादीनां पात्रम्।","तेन मद्यस्य कूपीं संमार्ज्य तस्मिन् कृष्णिकातैलं स्थापितम्।",["कूपी"],"भण्डम्",["ಸೀಸೆ","ಬಾಟಲಿ"]],["n","अवयवविशेषः यस्मिन् स्त्री दुग्धं धारयति।","माता उरोजस्य दुग्धं बालकं पाययति।",["उरोजः","उरस्यः","कुचः","कुचकुम्भः","कूचः","चुचिः","धरणः","पयोधरः","पयोध्रः","प्रलम्बः","वण्ठरः","वामः"],"शारीरिकभागः",["ಮೊಲೆ","ಸ್ತನ","ಕುಚ","ಎದೆ"]],["n","अवयवविशेषः, गुल्फस्य अधोभागः, पादग्रन्थ्याः आधारः, अनेन भूम्यादिकम् पृष्यते","कण्टकेन पार्ष्णि आहतः",["पार्ष्णिः","पादमूलम्","अंहिस्कन्धः","कूर्चशिरस्","गोहिरम्"],"कायिकसंरचना",["ಹಿಮ್ಮಡಿ","ಪಾದದ ಬುಡ","ಪಾದದ ಮೂಲ","ಪಾದದ ತಳಹದಿ"]],["n","नद्याः जलाशयस्य वा समीपस्थानम्।","सः नद्याः तीरे नौकां प्रतीक्षते।",["तीरम्","तटः","कूलम्","कच्छः","रोधः","तटम्"],"स्थलम्",["ದಡ","ತೀರ","ದಂಡೆ","ತಟ"]],["n","कूर्मस्य पृष्ठास्थिः।","कटाहः कूर्मं रक्षति।",["कटाहः","कूर्मपृष्ठम्"],"बाह्य-शारीरिक-भागः",["ಕಟಾಹ"]],["n","जन्तुविशेषः सः जन्तुः किञ्चिद् दृष्ट्वा शरीरे एव मुखसम्पुटं प्रवेशयति।","अधुना कच्छपस्य सङ्ख्या न्यूना जाता।",["कूर्मः","कच्छपः","कमठः","कामठः","गूढाङ्गः","पञ्चागगुप्तः","पञ्चगुप्तः","कठिनपृष्ठम्","चतुर्गतिः","क्रोडपादः","उद्भटः","स्मरणापत्यतर्पकः"],"उरगः",["ಆಮೆ"]],["a","यः असत्यं साक्ष्यम् करोति।","कूटकारः असत्यम् अङ्गीकृत्वा जीवति।",["कूटकारः"],"",["ಸುಳ್ಳುಗಾರ","ಸುಳ್ಳುಗಾರನಾದ","ಸುಳ್ಳುಗಾರನಾದಂತ","ಸುಳ್ಳುಗಾರನಾದಂತಹ"]],["n","भूमौ खातः अल्पविस्तारो गम्भीरो मण्डलाकृतिः भागः यस्मात् जलं तैलं च प्राप्स्यते।","अस्य कूपस्य जलं शीतलम्।",["कूपः","कूपकः","प्रहिः","अन्धुः","जलकुपी","कूपी","निपानम्","उदपानम्","उदकाधारः","जलाधारः","आपीनः","चूडकः"],"गर्तः",["ಬಾವಿ","ಅಂಧು","ಅವಟ","ಅವಟಿ"]],["v","शरीरस्य प्रतनूभवनानुकूलः व्यापारः।","अहरहः सः कृशः भवति ।",["कृशः भू","विम्लै","विक्लम्","उद्वै","इयस्य","कूप्","दुर्बलीभू"],"परि वृत्",["ಸೊರಗು","ಹಸಗೆಡು","ಕೃಶಕಾಯವಾಗು","ಕೃಶ ಕಾಯವಾಗು"]],["n","व्यक्तिषु राष्ट्रेषु वा पारस्पारिकेषु व्यवहारेषु उपयुक्ता नीतिः।","कूटनीत्या अशक्यानि कार्याणि अपि शक्यानि भवन्ति।",["कूटनीतिः"],"नीतिः",["ರಾಜನಿಪುಣತೆ","ವ್ಯವಹಾರಕೌಶಲ","ವ್ಯವಹಾರ ನಿಪುಣತೆ"]],["v","पिकादीनां पक्षीणां मधुरस्वरेण हिक्वनानुकूलः व्यापारः।","वसन्तसमये प्राप्ते पिकः मधुरस्वरेण कूजति।",["कूज्","उत्कूज्","आकूज्","कू","कूज्"],"कूज्",["ಕುಹೂ ಕುಹೂ","ಕೂಗು"]],["v","जीवस्य शरीरं वेगेन ऊर्ध्वदेशे उत्प्लुत्य अधोदेशसंयोगानुकूलः व्यापारः।","बालः वालुकायां कूर्दन्ति।",["कूर्द्","क्ष्वेल्","गूर्द्","चञ्च्","त्वङ्ग्","प्लु","स्कन्द्","स्कुन्द्","आवल्ग्","आस्कन्द्","उत्प्रु","उत्प्लु"],"अभिनिर्वृत्",["ಜಿಗಿ","ಹಾರು","ಕುಣಿ","ನೆಗೆ"]],["n","सन्देशं गुप्तरूपेण प्रेषयितुम् उपयुक्तः सङ्केतः।","मेजरमहोदयः कूटसङ्केतेन सैनिकेभ्यः सन्देशं दत्तवान्।",["कूटसङ्केतः"],"चिह्नम्",["ಸಂಕೇತ","ಕೋಡ್"]],["n","फलप्रकारः यस्मात् सूपं शाकं वा पाचयति।","कतिपयाय जनाय कर्कारोः शाकं रोचते।",["कर्कारुः","कुष्माण्डः","कुष्माण्डी","कुष्माण्डकः","कूष्माण्डः","कूष्माण्डी","कूष्माण्डकः","अलाबुः","अलाबूः","आतावुः","तुम्बी"],"",["ಸೀತಾಫಲ"]],["n","लताप्रकारः यस्याः फलात् सूपं शाकं वा पाचयति।","कर्षके कर्कारुः पक्वः।",["कर्कारुः","कुष्माण्डः","कुष्माण्डी","कुष्माण्डकः","कूष्माण्डः","कूष्माण्डी","कूष्माण्डकः","अलाबुः","अलाबूः","आतावुः","तुम्बी"],"लता",["ಸೀತಾಫಲ"]],["n","यः कूटनीतेः ज्ञाता अस्ति।","कौटिल्यः एकः ख्यातः कूटनीतिज्ञः आसीत्।",["कूटनीतिज्ञः"],"",["ಚತುರ","ನಿಪುಣ","ಕುಶಾಲಮತಿ"]],["n","तालस्य पिधानार्थे तथा च उद्घाटनार्थे उपयुक्तं उपकरणम्।","मम तालस्य कुञ्चिका विलुप्ता।",["कुञ्चिका","कूर्च्चिका","ताली","तल्लिका","अङ्कुटः"],"उपकरणम्",["ಬೀಗದ ಕೈ","ಕೀಲಿಕೈ"]],["n","तर्जन्यङ्गुष्ठयोः मध्ये शरीरस्य त्वग् गृहीत्वा आकर्षणस्य क्रिया यया पीडा उद्भवति।","तस्य कूर्चनेन मम हस्ते रुधिरं समुद्विजते।",["कूर्चः","कूर्चम्"],"कर्म",["ಚಿವುಟುವುದು","ಜಿಗುಟುವುದು","ಜಿಗಟುವುದು","ಹಿಂಡುವುದು"]],["n","किमपि आलम्बितुं कृतः अङ