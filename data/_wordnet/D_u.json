{"s":[["n","यत् अवश्यं करणीयम्।","देशसेवा इति अस्माकं परमं कर्तव्यम्।",["कर्तव्यम्","धर्मः","स्वधर्मः","कर्तव्यता","कार्यम्","कृत्यम्","क्रिया","नियमः","यमः","व्रतम्","धुरा","तपः"],"कर्म",["ಕರ್ತವ್ಯ","ಮಾಡತಕ್ಕ","ಹೊಣೆ","ಜವಾಬ್ದಾರಿ"]],["n","जलस्य सः प्रवाहः यः पर्वतात् आरभ्य विशिष्टमार्गेण सागरं प्रति गच्छति।","पर्वतप्रदेशे पाषाणसिकतादिषु नदी मार्गम् आक्रमति ।",["नदी","सरित्","तरङ्गिणी","शैवलिनी","तटिनी","धुनी","स्रोतस्वती","द्वीपवती","स्रवन्ती","निम्नगा","आपगा","स्रोतस्विनी"],"",["ನದಿ","ಹೊಳೆ"]],["n","यः अक्षैः अक्षान् वा दीव्यति।","द्यूतकरः द्यूते विगतविभवः जातः।",["द्यूतकरः","द्यूतकारः","कितवः","अक्षधूर्तः","अक्षदेवी","अक्षद्यूः","अक्षधूर्तः","धुस्तूरः","कैरवः","द्यूतकृत्","अक्षकितवः","कटप्रूः"],"मनुष्यः",["ಜೂಜುಗಾರ","ಜೂಜುಕೋರ","ಜೂಜಾಳಿ","ಇಸ್ಪೀಟುಕೋರನು"]],["n","प्राचीनकाले वर्तमानः मृगचर्मणः निर्मितः वीजनप्रकारः।","प्राचीने काले  धुवित्रेण यज्ञस्य अग्निं प्रज्वालयन्ति स्म।",["धुवित्रम्"],"वीजनम्",[]],["n","मल्लाररागस्य एकः प्रकारः।","धुरियामल्लारे सर्वे स्वराः शुद्धाः आवश्यकाः सन्ति।",["धुरियामल्लार"],"मल्हाररागः",[]],["n","एकः असुरः।","धुन्धुः मधुनामकस्य असुरस्य पुत्रः आसीत्।",["धुन्धुः"],"असुरः",[]],["n","पुराणेषु वर्णितः एकः अश्वः।","पातालकेतुं हन्तुं सूर्यः कुवलयाश्वं प्रैषयत्।",["कुवलयाश्वः","धुन्धुमारः","धुन्धमारः"],"पौराणिकजीवः",[]],["n","इक्ष्क्वाकुवंशस्य एकः राजा यः रामस्य पूर्वजः त्रिशङ्कोः पुत्रः आसीत्।","युवनाश्वः धुन्धुमारस्य पुत्रः आसीत्।",["धुन्धुमारः"],"पौराणिकपुरुषः",[]],["n","वस्तुनः सा मात्रा या एकवारं वोढुं शक्या।","गोमयस्य सारस्य अधुनापि चत्वारः भराः सन्ति।",["भरः","धुरा"],"पदार्थः",[]],["n","महाराष्ट्रराज्यस्य नगरविशेषः।","धुलेमण्डलस्य प्रधानकार्यालयः धुलेनगरम् अस्ति।",["धुलेनगरम्"],"पुरम्",[]],["n","महाराष्ट्रराज्ये वर्तमानम् एकं मण्डलम्।","धुलेमण्डलं नन्दुरबारमण्डलस्य जलगावमण्डलस्य च मध्ये अस्ति।",["धुलेमण्डलम्"],"मण्डलम्",[]],["n","असमराज्ये वर्तमानम् एकं नगरम्।","धुबरीनगरस्य सः प्राणातिपातः मया न विस्मर्यते।",["धुबरीनगरम्"],"पुरम्",[]],["n","असमराज्ये वर्तमानम् एकं मण्डलम्।","धुबरीमण्डलस्य मुख्यालयः धुबरीनगरे अस्ति।",["धुबरीमण्डलम्"],"मण्डलम्",[]],["n","राक्षसविशेषः।","धुरन्धरस्य वर्णनं पुराणेषु अस्ति।",["धुरन्धरः"],"असुरः",[]],["n","कस्मिंश्चित् विशेषे क्षेत्रे प्रवीणः तथा च प्रतिकूलायां परिस्थित्यां यः सङ्घर्षं करोति तथा च नित्यपराक्रमं कृत्वा उत्कर्षं साधयति सः ।","अमिताभ बच्चन महोदयः धुरन्धरं नेतारं स्वर्गीयं हेमवतीनन्दन बहुगुणा महोदयं निर्वाचने पराजयत् ।",["धुरन्धर"],"",["ಧುರಂಧರ"]],["n","एकः जनसमुदायः ।","धुरन्धराणाम् उल्लेखः महाभारते विष्णुपुराणे च अस्ति",["धुरन्धरः"],"",[]],["n","एका नदी ।","धुशुल्यायाः उल्लेखः विष्णुपुराणे अस्ति",["धुशुल्या"],"",[]]],"w":{"धुरा":[0,8],"धुनी":[1],"धुस्तूरः":[2],"धुस्तूर":[2],"धुवित्रम्":[3],"धुवित्र":[3],"धुरियामल्लार":[4],"धुन्धुः":[5],"धुन्धु":[5],"धुन्धुमारः":[6,7],"धुन्धुमार":[6,7],"धुन्धमारः":[6],"धुन्धमार":[6],"धुलेनगरम्":[9],"धुलेनगर":[9],"धुलेमण्डलम्":[10],"धुलेमण्डल":[10],"धुबरीनगरम्":[11],"धुबरीनगर":[11],"धुबरीमण्डलम्":[12],"धुबरीमण्डल":[12],"धुरन्धरः":[13,15],"धुरन्धर":[13,14,15],"धुशुल्या":[16]}}