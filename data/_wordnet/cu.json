{"s":[["n","मृद्-लोह-इष्टिकादिभिः निर्मितं पाकार्थम् अग्निपात्रम्।","भोजनोत्तपनार्थं माता चुल्लिं प्रज्वालयति।",["चुल्लिः","अश्मन्तम्","उद्धनम्","अधिश्रयणी","अन्तिका","असमन्तम्","उष्मानम्","उद्धारम्","आन्दिका","उद्धानि","अङ्गारिणी","अङ्गारगुप्तिः"],"पाकसाधनम्",["ಒಲೆ"]],["n","अवयवविशेषः, ओष्ठौ च दन्तमूलानि दन्ता जिह्वा च तालु च गलो गलादि सकलम् सप्ताङ्गं मुखम् उच्यते।","पिता स्नेहात् स्वबालकस्य मुखम् चुम्बति।",["मुखम्","वदनम्","आननम्","वक्त्रम्","आस्यम्","वन्दनम्","चुब्रम्","श्मन्"],"शारीरिकभागः",["ಮುಖ"]],["n","वृक्षविशेषः अस्य पक्वफलस्य गुणाः दीपनत्व-रुचिकारित्व-भेदित्वादयः।","श्यामस्य प्राङ्गणे चिञ्चायाः वृक्षम् अस्ति।",["चिञ्चा","अम्लफलः","अम्लवृक्षः","आम्लिका","आम्लीका","गुरुपत्त्रा","चण्डचुक्रा","चरित्रा","चिञ्चिणी","चुक्रचण्डिका","तिन्तिडिका"],"फलदाता",["ಹುಣಸೆ ಮರ","ಹುಣಸೆ ವೃಕ್ಷ","ಹುಣಸೆ"]],["n","लघु चुल्लिका यस्योपरि दुग्धादयः पाच्यन्ते।","सीता चुल्लिकायां दुग्धं तपति।",["चुल्लिका"],"सन्धानी",["ಅಗ್ಗಿಷ್ಟಿಕೆ","ಕುಮಟಿ"]],["n","फलविशेषः, तितिन्डिवृक्षस्य फलम् ।","चिञ्चायां क इति जीवसत्त्वम् वर्तते।",["चिञ्चा","चुक्रफलम्","अम्लफलम्"],"खाद्यफलम्",["ಹುಣಸೆ ಹಣ್ಣು","ಬಿಳಿ ಹುಣಸೆ"]],["n","सन्धिं छित्वा अन्यस्य वस्तुनः ग्रहणस्य क्रिया भावो वा।","रामः चौर्यं करोति।",["चौर्यम्","स्तेयम्","चौरम्","चौरिका","स्तैन्यम्","स्तैनम्","चुरा","तास्कर्यम्","तस्करता","मुष्टम्","मुष्टिः","अपहारः"],"",["ಕಳ್ಳತನ","ಕಳುವು","ಅಪಹರಣ","ಕದಿ"]],["n","पशुविशेषः, या अप्रशस्ता खरतुल्यनादा प्रदीप्तपुच्छा कुनखा विवर्णा निकृत्तकर्णा द्विपमस्तका तथा च  यस्याः दुग्धं पानार्थंम् उपयुज्यते ।","अजायाः दुग्धं शीतलं मधुरं च।",["अजा","छागी","पयस्विनी","भीरुः","मेध्या","गलेस्तनी","छागिका","मज्जा","सर्वभक्ष्या","गलस्तनी","चुलुम्पा","सज्जा"],"अजा",["ಮೇಕೆ","ಆಡು"]],["a","यस्य अभ्यासं क्रियते।","श्यामः बहुकष्टस्य अभ्यस्तः अस्ति।",["अभ्यस्त","ओकिवस्","चुञ्चु","धृतव्रत"],"",["ಅಭ್ಯಾಸವಾದ","ಅಭ್ಯಾಸವಾದಂತ","ಅಭ್ಯಾಸವಾದಂತಹ","ಪಳಗಿದ"]],["n","अवयवविशेषः यस्मिन् स्त्री दुग्धं धारयति।","माता उरोजस्य दुग्धं बालकं पाययति।",["उरोजः","उरस्यः","कुचः","कुचकुम्भः","कूचः","चुचिः","धरणः","पयोधरः","पयोध्रः","प्रलम्बः","वण्ठरः","वामः"],"शारीरिकभागः",["ಮೊಲೆ","ಸ್ತನ","ಕುಚ","ಎದೆ"]],["v","कम् अपि कस्मिन् अपि कार्ये शब्देन प्रवर्तनानुकूलः व्यापारः।","अध्ययनोपरान्तम् आचार्यः गृहं गच्छ इति आदिशत्।",["आदिश्","अनुशास्","आज्ञापय्","चुद्","समादिश्","सन्दिश्","व्यादिश्","प्रतिसन्दिश्","अभिचुद्"],"वद्",["ಆಜ್ಞೆ ಮಾಡು","ಆಜ್ಞೆ ಕೊಡು","ಆಜ್ಞೆ ನೀಡು","ಆದೇಶ ಮಾಡು"]],["n","आतपे पाचयित्वा तिक्तीकृतस्य कस्यापि फलस्य रसः ।","रसाम्लं संमिश्र्य लवणितं निर्मीयते ।",["रसाम्लः","चुक्राम्लः","लिकुचः","शाकाम्लभेदकम्"],"अन्नम्",["ಒಂದು ತರಹದ ಆಸವ"]],["n","रासायनिकधातुविशेषः, अयस्सु कान्तः प्रस्तरभेदः।","अयस्कारः अयस्कान्तेन सूक्ष्मलोहकणान् उञ्छति।",["अयस्कान्तः","अयोमणिः","लोहकान्तः","चुम्बकः"],"पदार्थः",["ಆಯಸ್ಕಾಂತ","ಸೂಚಿಗಲ್ಲು","ಕಾಂತ","ಚುಂಬಕ"]],["n","समाघ्राणस्य क्रिया।","माता प्रसन्ना भूत्वा वारंवारं पुत्रस्य चुम्बनं करोति।",["चुम्बनम्","चुम्बितम्","परिणिंसा","निक्षणम्","प्रणिक्षणम्"],"कर्म",["ಮುತ್ತು","ಚುಂಬನ"]],["v","छलेन कस्य अपि वस्तुनः आहरणानुकूलव्यापारः।","कोऽपि मम स्यूतम् अचोरयत्।",["चुर्","अपहृ","हृ","मुष्","परिमुष्","प्रमुष्","स्तेन्","चौर्यं कृ","स्तेयं कृ"],"ग्रह्",["ಕದಿ","ಕಳ್ಳತನ ಮಾಡು","ಕೊಳ್ಳೆಹೊಡೆ","ಹೊತ್ತುಕೊಂಡು ಹೋಗು"]],["n","बृहद् जलजन्तुः।","मकरः अतीव भयकरः अस्ति।",["मकरः","शिशुमारः","अम्बुकीशः","अम्बुकूर्मः","चुलुकी"],"",["ಕಡಲಹಂದಿ","ಶಿಶುಮಾರ"]],["n","अवयवविशेषः-  ओष्ठाद् अधः कपोल-द्वयात् परः मुखभागः।","तस्य हनौ व्रणम् अस्ति।",["हनुः","चिबिः","चुबुकः","श्मश्रु","जानु","छुबुकम्","जोड"],"शारीरिकभागः",["ಗಲ್ಲ","ಗದ್ದ"]],["n","च् इति वर्णात् आरभ्य ञ् इति वर्णं यावत् वर्गः।","चवर्गाद् अनन्तरं टवर्गः वर्तते।",["चवर्गः","चुः"],"वर्गः",["ಚವರ್ಗ"]],["n","रसात्मको आम्लात् विमनिर्मितः पदार्थः।","चुक्रम् आम्लत्वेन उपयुज्यते।",["चुक्रम्","रसाम्लम्"],"",["ಹುಳಿ ಪದಾರ್ಥ"]],["v","ओष्ठयोः अन्याङ्गान् स्पर्शनानुकूलव्यापारः।","मात्रा बालकः चुम्ब्यते।",["चुम्ब्","अवघ्राणं कृ","चुम्बनं कृ"],"आविष्कृ",["ಮುತ್ತಿಡು","ಮುದ್ದಿಡು","ಚುಂಬಿಸು"]],["a","चुम्बकसम्बन्धी।","लोहे चुम्बकीयान् गुणान् उत्पादयितुं शक्यन्ते।",["चुम्बकीय"],"",["ಆಯಾಸ್ಕಾಂತದ ಗುಣ"]],["n","विश्वामित्रस्य एकः पुत्रः।","चुञ्चुलस्य वर्णनं पुराणेषु वर्तते।",["चुञ्चुलः"],"क्षुपः",[]],["n","विश्वामित्रस्य पुत्रविशेषः।","चुञ्चुलस्य वर्णनं पुराणेषु अस्ति।",["चुञ्चुलः"],"पौराणिकपुरुषः",[]],["n","भारतदेशस्य मणिपुरराज्ये वर्तमानं मण्डलम्।","चुराचान्दपुरमण्डलस्य मुख्यालयः चुराचान्दपुरनगरे अस्ति।",["चुराचान्दपुरमण्डलम्"],"मण्डलम्",[]],["n","भारतदेशस्य मणिपुरराज्ये वर्तमानं नगरम्।","कथञ्चित् सः चुराचान्दपुरनगरम् प्राप्नोत्।",["चुराचान्दपुरनगरम्"],"पुरम्",[]],["n","रोमन्थकारिणी।","सः अजाः तृणभक्षणार्थे नयति।",["अजा","छागा","छगलम्","छेलिका","चुलुम्पा","पयस्विनी","भीरु","मञ्जा","मञ्जी","सञ्जा","शुभा","मेध्या"],"पशुः",["ಆಡು"]],["n","चुम्बकस्य गुणः भावः वा।","अश्वस्य नाले चुम्बकत्वं वर्तते।",["चुम्बकत्वम्"],"",[]],["n","आकर्षणशक्तिः।","पृथिव्यां वर्तमानेन चुम्बकत्वेन उपरि क्षिप्तानि वस्तूनि अधः पतन्ति।",["चुम्बकत्वम्"],"शक्तिः",[]],["n","यः चुम्बति","चुम्बकः स्नेहात् बालकस्य ललाटं गण्डं च पुनः पुनः चुम्बति",["चुम्बकः","परिणिंसकः"],"मनुष्यः",[]],["n","साधनविशेषः, विशिष्टकार्यार्थे विनिर्मितः चुम्बकस्य गुणधर्मयुक्तः खण्डः, यस्य चुम्बनक्षमता न कदापि क्षीयते","कान्तलोहः लोहम् आकर्षति",["कान्तलोहम्","चुम्बकः","कान्तपाषाणः"],"शिला",[]],["n","हस्तसम्पुटे यावन्मात्रं वस्तु विद्यते तावन्मात्रम् ।","त्रिभिः चुलुकैः अपि पिपासा न शाम्यते ।",["चुलुकः","चुलुकम्","चलुः","मुखपूरणम्","कवडः","आस्यस्रवणम्","गण्डूषः","द्विमुखा","प्रसेकः"],"",[]],["n","एकः पुरुषः ।","चुञ्चुलस्य उल्लेखः हरिवंशे वर्तते",["चुञ्चुलः"],"",[]]],"w":{"चुल्लिः":[0],"चुल्लि":[0],"चुब्रम्":[1],"चुब्र":[1],"चुक्रचण्डिका":[2],"चुल्लिका":[3],"चुक्रफलम्":[4],"चुक्रफल":[4],"चुरा":[5],"चुलुम्पा":[6,24],"चुञ्चु":[7],"चुचिः":[8],"चुचि":[8],"चुद्":[9],"चुक्राम्लः":[10],"चुक्राम्ल":[10],"चुम्बकः":[11,27,28],"चुम्बक":[11,27,28],"चुम्बनम्":[12],"चुम्बन":[12],"चुम्बितम्":[12],"चुम्बित":[12],"चुर्":[13],"चुलुकी":[14],"चुबुकः":[15],"चुबुक":[15],"चुः":[16],"चु":[16],"चुक्रम्":[17],"चुक्र":[17],"चुम्ब्":[18],"चुम्बनं कृ":[18],"चुम्बकीय":[19],"चुञ्चुलः":[20,21,30],"चुञ्चुल":[20,21,30],"चुराचान्दपुरमण्डलम्":[22],"चुराचान्दपुरमण्डल":[22],"चुराचान्दपुरनगरम्":[23],"चुराचान्दपुरनगर":[23],"चुम्बकत्वम्":[25,26],"चुम्बकत्व":[25,26],"चुलुकः":[29],"चुलुक":[29],"चु