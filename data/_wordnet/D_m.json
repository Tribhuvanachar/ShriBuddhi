{"s":[["n","खगविशेषः- कृष्णवर्णीयः खगः यस्य ध्वनिः कर्कशः।","काकः शाखायां स्थित्वा काकध्वनिं करोति।",["काकः","वायसः","ध्माक्षः","ध्वांक्षः","ध्वांक्षरावी","करटः","बलिभुक्","बलिभुज्","गृहबलिभुज्","गृहबलिभुक्","बलिपुष्टः","बलिपुष्टा"],"खगः",["ಕಾಗೆ","ಕಪ್ಪು ಬಣ್ಣದ ಪಕ್ಷಿ","ಕರಟಕ","ಕಾಕೆ"]],["n","शरीरे कुत्रापि रक्ताशुद्धिवशाद् जातानि उद्वर्तनानि।","सः प्रतिदिनं गण्डे लेपनं करोति।",["गण्डः","विद्रधिः","ध्मानम्","आटोपः","अर्बुदः"],"त्वग्रोगः",["ಕುರು","ಕುರ","ಹುಣ್ಣು","ಗುಳ್ಳೆ"]],["v","मुखेन वायुप्रचालनेन शब्दनानुकूलः व्यापारः।","कथायाः प्रारम्भात् पूर्वं आचार्यः शङ्खम् अधमत्।",["ध्मा"],"नद्",["ಊದು"]],["n","शतावर्याः इव लताप्रकारः।","काकोल्याः मूलं भेषजरूपेण उपयुज्यते।",["काकोली","मधुरा","काकी","कालिका","वायसोली","क्षीरा","ध्मांक्षिका","वीरा","शुक्ला","धीरा","मेदुरा","ध्मांक्षोली"],"लता",[]]],"w":{"ध्माक्षः":[0],"ध्माक्ष":[0],"ध्मानम्":[1],"ध्मान":[1],"ध्मा":[2],"ध्मांक्षिका":[3],"ध्मांक्षोली":[3]}}