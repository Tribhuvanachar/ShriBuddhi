{"s":[["n","वृक्षाङ्गविशेषः।","बालकाः आम्रस्य शाखासु हिन्दोलयन्ति।",["शाखा","स्कन्धः","शिखा","बाहुः","लङ्का"],"वनस्पति-अङ्गम्",["ರೆಂಬೆ","ಕೊಂಬೆ","ಟೊಂಗೆ"]],["n","एकविषयप्रतिपादनदृष्ट्या ग्रन्थस्थितप्रकरणस्य अवयवः।","अस्मिन् अध्याये प्रभुरामचन्द्रस्य जन्मनः अद्भुतं वर्णनम् अस्ति।",["अध्यायः","परिच्छेदः","अध्ययः","सर्गः","पर्वः","विच्छेदः","स्कन्धः","प्रकरणम्","प्रस्तावः","अङ्कः","वर्गः","शाखा"],"मानवकृति",["ಅನುಚ್ಛೇದ","ಆಶ್ವಾಸ","ಭಾಗ","ಪರ್ವ"]],["n","अवयवविशेषः, कण्ठबाहुमध्यगः अवयवः।","हनुमान् रामलक्ष्मणौ स्वस्य स्कन्धे स्थापयित्वा सुग्रीवस्य समीपे गतः।",["स्कन्धः","भुजशिरः","अंसः","दोःशिखरम्"],"शारीरिकभागः",["ಭುಜ","ತೋಳು","ಹೆಗಲು","ಬಾಹು"]],["n","भगवतः शिवस्य ज्येष्ठपुत्रः।","सेनानीनामहम् स्कन्दः।",["स्कन्दः","षडाननः","कुमारः","कार्त्तिकेयः","षाण्मातुरः","मयूरकेतुः","सिद्धसेनः","विशाखः","अग्निभूः","आम्बिकेयः","आग्नेयः","कामजितः"],"देवः",["ಮಹಾಸೇನ"]],["v","जीवस्य शरीरं वेगेन ऊर्ध्वदेशे उत्प्लुत्य अधोदेशसंयोगानुकूलः व्यापारः।","बालः वालुकायां कूर्दन्ति।",["कूर्द्","क्ष्वेल्","गूर्द्","चञ्च्","त्वङ्ग्","प्लु","स्कन्द्","स्कुन्द्","आवल्ग्","आस्कन्द्","उत्प्रु","उत्प्लु"],"अभिनिर्वृत्",["ಜಿಗಿ","ಹಾರು","ಕುಣಿ","ನೆಗೆ"]],["n","शासनानां धानकं नगरम्।","उत्तरप्रदेशस्य राजधानी लखनौ इति अस्ति।",["राजधानी","राजधानम्","स्कन्धावारः","कर्व्वटः","कर्व्वटम्","खर्व्वटः","खर्वटम्"],"पुरम्",["ರಾಜಧಾನಿ","ಮಹಾನಗರ"]],["n","इन्धनात् परिचाल्यमाना द्विचक्रिका।","सः कार्यालये गन्तुं स्कुन्दनम् उपयुनक्ति।",["स्कुन्दनम्"],"द्विचक्रिका-यानम्",["ಸ್ಕೂಟರ್"]],["n","वृक्षस्य शाखायाः अन्तिमः भागः।","वृक्षस्य स्कन्धसि खगः शोभते।",["स्कन्धः"],"वनस्पति-भागः",["ಅಂಕುರ","ಚಿಗುರು","ತೆನೆ","ಮೊಳಕೆದೋರು"]],["n","नवदुर्गासु एका या स्कन्दस्य माता आसीत्।","स्कन्दमातुः पूजनं नवरात्रि-उत्सवे पञ्चमे दिने क्रियते।",["स्कन्दमाता"],"दुर्गा",["ಸ್ಕಂದಮಾತಾ","ಸ್ಕಂದಮಾತೆ"]],["n","श्वेतः चिल्लः।","वृक्षस्य शाखायां एकः स्कन्धमल्लकः उपविष्टः अस्ति।",["स्कन्धमल्लकः"],"चिल्लः",[]],["n","एका उपनिषद्","स्कन्दोपनिषद् यजुर्वेदेन सम्बन्धिता।",["स्कन्दोपनिषद्","स्कन्दः"],"",[]],["n","भित्तिकायां गुलिकानाडन्या कन्दुकस्य ताडनेन क्रीडिता खेलविशेषः।","स्क्वाश-क्रीडां द्वौ अथवा चत्वारः जनाः क्रीडन्ति एकया गुलिकानाडन्या कन्दुकं ताडयन्ति।",["स्क्वाश-क्रीडा"],"क्रीडा",[]],["n","मैसिडोनियादेशस्य राजधानी।","मदरटेरेसायाः जन्मः स्कोपजेनगरे अभवत्।",["स्कोपजेनगरम्"],"राजधानी",[]],["n","पठनसौलभ्यार्थे निर्धारिता एकम् उद्दिश्यम् अनुसन्दधाना ज्ञानस्य शाखा।","मया गणित इति विषयस्य परीक्षा उत्तीर्णा।",["विषयः","स्कन्धः"],"",["ವಿಷಯ","ಪಠ್ಯವಿಷಯ","ಪಠ್ಯ ವಿಷಯ","ಪಠ್ಯ-ವಿಷಯ"]],["n","आधारार्थं कस्यापि वस्तुनः अधः स्थाप्यमाना काचित् रचना।","अयं सेतुः सप्तसु स्तम्भेषु आधारितः अस्ति।",["स्कम्भः","स्तम्भः","अवष्टम्भः","यष्टिः","धारिका"],"आधारः",[]],["n","मन्त्रगण्डकविशेषः।","मनहरः स्कन्दमणिं धारयति।",["स्कन्धमणिः"],"कवचः",[]],["n","शरीरस्य उपरितन भागः यस्मात् बाहू निस्सरतः ।","सः स्कन्धस्य विस्तारं मापयति ।",["स्कन्धः"],"अंशः",[]],["n","आर्याछन्दसः भेदविशेषः।","इदं स्कन्धस्य उदाहरणम् अस्ति।",["स्कन्धः"],"",[]],["n","राज्याभिषेकस्य समये उपयुज्यमाना सामग्री ।","स्कंधस्य अवलोकनं कृत्वा राजगुरुः राज्याभिषेकम् आरब्धवान् ।",["स्कन्धः"],"सामग्री",[]],["n","पुरुषैः स्कन्धे धार्यमाणः वस्त्रविशेषः।","सम्प्रति स्कन्धपटस्य प्रचलनम् अस्ति।",["स्कन्धपटः"],"पटम्",[]],["n","एकः ग्रामः ।","स्कन्दकग्रामस्य उल्लेखः राजतरङ्गिण्याम् अस्ति",["स्कन्दकग्रामः"],"",[]],["n","एकः राजा ।","स्कन्दगुप्तस्य उल्लेखः प्रशस्त्याम् अस्ति",["स्कन्दगुप्तः"],"",[]],["n","एकः वणिक् ।","स्कन्ददासस्य उल्लेखः कथासरित्सागरे अस्ति",["स्कन्ददासः"],"",[]],["n","एकं नगरम् ।","स्कन्दपुरस्य उल्लेखः राजतरङ्गिण्याम् अस्ति",["स्कन्दपुरम्"],"",[]],["n","पुरुषनामविशेषः ।","स्कन्दभटः इति नामकानां नैकेषां पुरुषाणाम् उल्लेखः प्रशस्त्याम् अस्ति",["स्कन्दभटः"],"",[]],["n","एकः पुरुषः ।","स्कन्दभट्टस्य उल्लेखः प्रशस्त्याम् अस्ति",["स्कन्दभट्टः"],"",[]],["n","राज्ञः नामविशेषः ।","स्कनवर्मन् इति नामकानां नैकेषां राज्ञाम् उल्लेखः प्रशस्त्याम् अस्ति",["स्कन्दवर्मा"],"",[]],["n","एकः कविः ।","स्कन्दस्कारशङ्करस्य उल्लेखः सुभाषितरत्नावल्याम् अस्ति",["स्कन्दस्कारशङ्करः"],"",[]],["n","एकः टीकाकारः ।","स्कन्दस्वामिनः उल्लेखः विवरणपुस्तिकायाम् अस्ति",["स्कन्दस्वामी"],"",[]],["n","एकः आचार्यः ।","स्कन्दिलाचार्यस्य उल्लेखः विवरणपुस्तिकायाम् अस्ति",["स्कन्दिलाचार्यः"],"",[]],["n","एकः पर्वतः ।","स्कन्धपादस्य उल्लेखः मार्कण्डेयपुराणे अस्ति",["स्कन्धपादः"],"",[]],["n","एकः राजा ।","स्कन्धस्तम्भेः उल्लेखः विष्णुपुराणे अस्ति",["स्कन्धस्तम्भिः"],"",[]],["n","एकः राजा ।","स्कन्धस्वातेः उल्लेखः विष्णुपुराणे अस्ति",["स्कन्धस्वातिः"],"",[]],["n","एकः पुरुषः ।","स्कन्धिलस्य उल्लेखः बौद्धसाहित्ये अस्ति",["स्कन्धिलः"],"",[]],["n","एकः पुरुषः ।","स्कम्भस्य उल्लेखः कुञ्जादिगणे अस्ति",["स्कम्भः"],"",[]],["n","एकः टीकाग्रन्थः ।","स्कान्दभाष्यस्य उल्लेखः कोषे अस्ति",["स्कान्दभाष्यम्"],"",[]]],"w":{"स्कन्धः":[0,1,2,7,13,16],"स्कन्ध":[0,1,2,7,13,16],"स्कन्दः":[3,10],"स्कन्द":[3,10],"स्कन्द्":[4],"स्कुन्द्":[4],"स्कन्धावारः":[5],"स्कन्धावार":[5],"स्कुन्दनम्":[6],"स्कुन्दन":[6],"स्कन्दमाता":[8],"स्कन्धमल्लकः":[9],"स्कन्धमल्लक":[9],"स्कन्दोपनिषद्":[10],"स्क्वाश-क्रीडा":[11],"स्कोपजेनगरम्":[12],"स्कोपजेनगर":[12],"स्कम्भः":[14,34],"स्कम्भ":[14,34],"स्कन्धमणिः":[15],"स्कन्धमणि":[15],"स्कन्धपटः":[19],"स्कन्धपट":[19],"स्कन्दकग्रामः":[20],"स्कन्दकग्राम":[20],"स्कन्दगुप्तः":[21],"स्कन्दगुप्त":[21],"स्कन्ददासः":[22],"स्कन्ददास":[22],"स्कन्दपुरम्":[23],"स्कन्दपुर":[23],"स्कन्दभटः":[24],"स्कन्दभट":[24],"स्कन्दभट्टः":[25],"स्कन्दभट्ट":[25],"स्कन्दवर्मा":[26],"स्कन्दस्कारशङ्करः":[27],"स्कन्दस्कारशङ्कर":[27],"स्कन्दस्वामी":[28],"स्कन्दिलाचार्यः":[29],"स्कन्दिलाचार्य":[29],"स्कन्धपादः":[30],"स्कन्धपाद":[30],"स्कन्धस्तम्भिः":[31],"स्कन्धस्तम्भि":[31],"स्कन्धस्वातिः":[32],"स्कन्धस्वाति":[32],"स्कन्धिलः":[33],"स्कन्धिल":[33],"स्कान्दभाष्यम्":[35],"स्कान्दभाष्य":[35]}}