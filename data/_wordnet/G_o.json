{"s":[["n","स्वनामख्यातम् तन्तुवाद्यम्।","माते शारदे त्वं कुत्र वीणां वादयसि।",["वीणा","घोषवती","विपञ्ची","विपञ्चिका","वल्लकी"],"तन्तुवाद्यम्",["ವೀಣೆ"]],["n","अवयवविशेषः, जिघ्रते अनेन इति।","न्यायमतेन घ्राणस्य गन्धग्राहित्वम् इति गुणः।",["घ्राणम्","नासा","नासिका","नसा","नस्या","घोणा","गन्धवाहः","गन्धज्ञा","गन्धनाली","घ्रतिः","नाः","नस्तः"],"ज्ञानेन्द्रियम्",["ಮೂಗು","ನಾಸಿಕಾ","ಘಾಣೇಂದೆರಿಯ"]],["n","शृगालजातीयः श्वसदृशः  निशाचरः वन्यः पशुः विशेषतः आफ्रिकादेशे दक्षिणाशियाखण्डे च विद्यते।","व्याधेन एकमेव आघातं कृत्वा तरक्षुः हतः।",["तरक्षु","दंष्ट्री","घोरदर्शनः","मृगाजीवः","मृगादः","युयुक्खुरः","तिलित्सक"],"",["ಕತ್ತೆ ಕಿರುಬ","ಗುಳ್ಳೆಲಕ್ಕ"]],["n","उच्चस्वरेण कृता शंसा।","स्वस्य अपेक्षापूर्त्यर्थं श्रमिकनेतृन् उद्यतदण्डस्य घोषणा कृता।",["घोषणा"],"प्रख्यापनम्",["ಘೋಷಣೆ","ಬಹಿರಂಗ ಹೇಳಿಕೆ"]],["n","रासायनिकधातुविशेषः ताम्ररङ्गमिश्रितधातुः, तस्य गुणाः चक्षुर्हितकारित्वम्, वातकफविकारनाशित्वम्।","कांस्यकारः कांसस्य पात्रं करोति।",["कांस्यम्","घण्टाशब्दः","घोषः","घोरपुष्पम्","ताम्रार्धम्","पीतलोहम्"],"मिश्रधातुः",["ಕಂಚು","ಲೋಹ","ಧಾತು","ತಾವ್ರವೂ-ತವರವೂ ಸೇರಿ ಆದ ಮಿಶ್ರಲೋಹ"]],["n","ग्राम्यपशुविशेषः-यः विषाणहीनः चतुष्पादः।","राणाप्रतापस्य अश्वस्य नाम चेतकः इति आसीत्।",["अश्वः","वाजी","हयः","तुरगः","तुरङ्गः","तुरङ्गमः","सैन्धवः","पीतिः","पीती","घोटकः","घोटः","वीतिः"],"",["ಕುದುರೆ","ಅಶ್ವ","ತುರಗ"]],["n","अश्वस्य पत्नी।","वरः श्वेतवर्णीयां घोटिकायाम् आरूढः।",["घोटिका","तुरङ्गी","तुरगी","हयी","प्रसूता","प्रसू","वामी"],"अश्वः",["ಕುದುರೆ","ಅಶ್ವ","ತುರಗ","ಅಶ್ವಿನಿ"]],["a","भयजनकम्।","महिषासुरं हन्तुं देवी महाकाली रौद्रं रूपम् अधारयत्।",["भयङ्कर","भैरव","दारुण","भीष्म","घोर","भीम","भयानक","प्रतिभय","भयावह","रौद्र","भीषण"],"",["ಪ್ರಚಂಡ","ಪ್ರಚಂಡನಾದ","ಪ್ರಚಂಡನಾದಂತ","ಪ್ರಚಂಡನಾದಂತಹ"]],["a","यद् अतीव विदारकम् अस्ति।","यदा रामः वनवासे गतः तदा तस्य वियोगस्य दारुणेन दुःखेन दशरथः कालवशः अभवत्।",["दारुण","भयङ्कर","घोर","भीषण"],"",["ಭೀಕರವಾದ","ಭೀಕರವಾದಂತ","ಭೀಕರವಾದಂತಹ","ದಾರುಣವಾದ"]],["n","श्वानसदृशः वन्यपशुः।","शृगालः मांसाहारी अस्ति।",["शृगालः","सृगालः","जम्बुकः","जम्बूकः","वञ्चकः","क्रोष्टा","गोमी","क्रश्वा","भूरिमायः","घोररासनः","हूरवः","श्वभीरुः"],"मांसाहारी",["ನರಿ","ಜಂಬುಕ","ಬಳ್ಳು"]],["n","घण्टायाः वादनात् उत्पन्नः ध्वनिः।","तस्य यन्त्रस्य घण्टारवः अतीव कर्कशः अस्ति।",["घण्टारवः","घण्टा","घोषः"],"शब्दः",["ಘಂಟೆ ಶಬ್ದ","ಘಂಟೆಯ ಧ್ವನಿ","ಗಡಿಯಾರದ ಶಬ್ದ","ಗಡಿಯಾರದ ಧ್ವನಿ"]],["n","अनुचितं तथा च समस्यापूर्णं कर्म ।","अहं घोरकर्मणि बद्धः ।",["घोरकर्म"],"कर्म",["ಪೇಚಾಟದ ವ್ಯವಹಾರ","ತೊಡಕಿನ ವ್ಯವಹಾರ","ಕಷ್ಟದ ವ್ಯವಹಾರ","ಅನೈತಿಕ ವ್ಯವಹಾರ"]],["n","पुंसः मुखे वर्धिताः लोमाः।","प्रायः महात्मनां बृहती श्मश्रुः वर्तते।",["श्मश्रुः","मुखरोमम्","कोटः","घोटः","कूर्चकः","दाढिका"],"केशसमूहः",["ಗಡ್ಡ","ದಾಡಿ"]],["n","तद् वाक्यादयः यद् कोऽपि विशेषसिद्धान्तः पक्षः दलः वा जनान् स्वं प्रति आकृष्यमाणार्थे उपयुज्यते।","समाजवादी कार्यकारी शासनविरोधी घोषणां ददाति।",["घोषणा"],"गर्जम्",["ಘೋಷಣೆ"]],["n","साहित्यस्य नवरसेषु एकः यस्य स्थायीभावः भयम् अस्ति तथा च जगुप्सावेगसंमोहसंत्रासग्लानिदीनताशङ्कासम्भ्रान्तिजनकः अपि।","अस्यां कवितायां भयानकरसः अस्ति।",["भैरवरसः","दारुणरसः","भीषणरसः","भीष्मरसः","घोररसः","भीमरसः","भयानकरसः","भयङ्कररसः","प्रतिभयरसः"],"रसः",["ಭಯಾನಕ ರಸ","ಭಯಾನಕ"]],["n","लघुः क्षुपः यः भेषजरूपेण तथा च व्यञ्जनरूपेण अपि उपयुज्यते।","तेन उद्याने शतपुष्पा उप्ता।",["शतपुष्पा","अतिच्छत्रा","मधुरा","शताक्षी","मिशिः","मधुरिका","मिसिः","शताह्वा","अवाक्पुष्पी","कारवी","शतपुष्पिका","घोषा"],"क्षुपः",["ಸೋಂಪು","ಬಡೇಸಪ್ಪು","ಶತಪುಷ್ಪ"]],["n","यः अश्वान् पालयति।","अश्वपालः अश्वान् अश्वशालायां बध्नाति।",["अश्वपालः","घोटकरक्षकः"],"मनुष्यः",["ಕುದುರೆಯಾಳು","ಕುದುರೆ-ಆಳು","ಕುದುರೆ ಆಳು"]],["n","जनान् सूचयितुं सर्वकारद्वारा निर्मितं पत्रम्।","सर्वकारेण ज्ञापनपत्रं प्रकाशितम्।",["ज्ञापनपत्रम्","घोषणापत्रम्","ख्यापनपत्रम्","प्रसिद्धिपत्रम्"],"",["ಘೋಷಣೆ ಪತ್ರ","ಪ್ರಕಟನೆ ಪತ್ರ","ಘೋಷಣೆ-ಪತ್ರ","ಪ್ರಕಟನೆ-ಪತ್ರ"]],["n","केनचित् राजनैतिकेन दलेन निर्वाचनस्य समये प्रसिद्धाः कृताः स्वनीतयः।","नेतारः निर्वाचनसमये स्वेनैव प्रसृतं घोषणापत्रम् न अनुसरन्ति।",["घोषणापत्रम्","प्रसिद्धिपत्रम्","ज्ञापनपत्रम्"],"घोषणा",["ರಾಜಕೀಯನೀತಿ","ಘೋಷಣೆ","ಪ್ರಣಾಳಿಕೆ","ಬಹಿರಂಗವಾದ ಪ್ರಕಟನೆ"]],["a","यस्य घोषणा कृता।","दशमी-कक्षायाः परिक्षायाः घोषितस्य परिणामस्य सूच्यां मम नाम नास्ति।",["घोषित"],"",["ಘೋಷಿಸಿದ ಪ್ರಕಟಿಸಿದ"]],["v","घटीयन्त्रकर्तृकः समयज्ञापनानुकूलः व्यापारः।","घटीयन्त्रं चतुर्वादनसमयं घोषयति।",["घोषय"],"कथ्",["ಗಂಟೆಹೊಡಿ","ಬಾರಿಸು"]],["n","अभिष्टनक्रिया।","मेघानां गर्जनाभिः सह विद्युद्भिः सह च वर्षा अवर्षत्।",["गर्जम्","गर्जः","गर्जनम्","घोषः","घोषणम्","हिङ्कारः","घनध्वनिः","अभिष्टनः","अवक्रन्दः","अवगूरणम्","अवस्वन्यम्","आनर्दम्"],"क्रिया",["ಗರ್ಜನೆ"]],["a","अत्यधिकया मात्रया।","घोरया वर्षया जनजीवनम् आकुलीभूतम्।",["घोर","घनघोर","प्रोथ"],"",["ಭೀಕರ","ಭಯಾನಕ","ಭೀಷಣ","ಭಯಂಕರ"]],["a","यस्य परिणामः गम्भीरः अस्ति।","हत्या इति एकः भीषणः अपराधः अस्ति।",["भीषण","विकट","घोर","भयङ्कर"],"",["ಘೋರ","ವಿಕಟ","ಭೀಷಣ","ಭಯನಾಕ"]],["n","कण्ठे वर्तमानः एकः शरीरावयवः यस्मादेव नादः उत्पद्यते।","घोषतन्त्र्याः एव स्वरः उत्पद्यते।",["घोषतन्त्री"],"शारीरिकभागः",["ಶೃತಿ ಪೆಟ್ಟಿಗೆ"]],["n","सार्वजनिकरूपेण उद्घोषिता राजाज्ञा सूचना वा।","शासनेन घोषणा कृता यद् दशमीं कक्षां यावत् शिक्षणं निःशुल्कम् अस्ति।",["घोषणा","उद्घोषणा"],"प्रख्यापनम्",["ಘೋಷಣೆ","ಪ್ರಕಟನೆ","ಉದ್ಘೋಷಣೆ"]],["a","यस्य उच्चारणसमये स्वरतन्त्र्यः परिस्पन्दन्ति।","सर्वे एकमात्रिकाः वर्णाः घोषाः सन्ति।",["घोष"],"",["ಧ್ವನಿ","ಘೋಷ"]],["n","कृष्णचिह्नाङ्कितः विषधरः सर्पविशेषः।","गोनसस्य दंशेन तस्य मृत्युः अभवत्।",["गोनसः","घोणसः","तिलित्सः"],"सर्पः",[]],["n","अश्वस्य शिशुः पुमान्।","अश्वी अश्वशावकाय वत्सलयति।",["अश्वशावः","अश्वशावकः","किशोरः","घोटकवत्सः","अम्बरीषः"],"",[]],["n","लताविशेषः।","घोषकायाः बीजगुप्तेः शाकं पच्यते।",["घोषका"],"लता",[]],["n","घोषकालतायाः बीजगुप्तिः।","माता घोषकस्य शाकं पचति।",["घोषकः"],"शाकम्",[]],["n","ग्राम्यपशुः- नरजातीयः यः वेगवान् अस्ति।","अश्वः रथाय युज्यते।",["अश्वः","तुरगः","तुरङ्गः","तुरङ्गमः","वाजी","हयः","पीतिः","पीती","वीतिः","घोटः","घोटकः","वाहः"],"अश्वः",[]],["n","पौराणिकः ऋषिविशेषः यः अङ्गिरसः पुत्रः इति मन्यते।","घोरः ब्रह्मणः पौत्रः आसीत्।",["घोरः"],"आप्तः",[]],["n","सः ग्रामः यः दुर्गस्य पार्श्वे अथवा अङ्के वा अस्ति ।","पूर्वस्मिन् काले राजानः अपि गोषान् निर्मान्ति स्म ।",["घोषः","अञ्चलः"],"ग्रामः",[]],["n","घोषकुलोत्पन्नस्य कृष्णधनस्य पुत्रः यः एकः प्रसिद्धः भारतीयः विद्वान् आसीत्।","अरविन्दस्य जन्