{"s":[["n","कण्टकयुक्तस्य वनवृक्षस्य फलम्।","विषकन्दात् तैलं प्राप्यते।",["विषकन्दः","पूतिगन्धः","इङ्गुदी"],"फलम्",["ಹೊಂಗೆ ಹಣ್ಣು","ಹೊಂಗೆ-ಹಣ್ಣು"]],["v","स्त्रीवत् हस्तादीनां नयनयोः च सञ्चालनात्मकः व्यापारः।","संभाषणसमये षण्ढः अङ्गविक्षेपं करोति।",["अङ्गविक्षेपं कृ","अङ्गानि विक्षिप्","हस्तादि विक्षिप्","हस्तादि सञ्चाल्","इङ्ग","चेष्ट्"],"कृ",["ಮೈ ಬಳುಕಿಸುವುದು","ಮೈ ಕೈ ಅಲ್ಲಾಡಿಸುವುದು"]],["n","लताविशेषः-यस्याः बीजात् तैलं प्राप्यते तथा च या वातकफहारिणी अस्ति।","ज्योतिष्मतेः बीजस्य तैलं बहु उपयुक्तम् अस्ति।",["ज्योतिष्मती","पारावताङ्घ्री","कटभी","पिण्या","पारावतपदी","नगणा","स्फुटबन्धनी","पूतितैला","इङ्गुदी","स्वर्णलता","अनलप्रभा","ज्योतिर्लता"],"लता",["ಗಿಡದ ಮೇಲೆ ಹಬ್ಬುವ ಒಂದು ಕಾಡು ಬಳ್ಳಿ"]],["n","पेरुदेशस्य कूजकोप्रान्ते वर्तमानाः जनाः।","इङ्काजनाः समीपस्थे राज्ये आधिपत्यं कुर्वन्ति।",["इङ्काजनाः"],"लोकः",["ಇಂಕಾ"]],["n","इङ्का-राज्यस्य राजकुलः।","इङ्कावंशस्य शासनः एकादशशतके आसीत्",["इङ्का"],"मनुष्यः",["ಇಂಕಾ"]],["n","यत् प्रकृतिम् अनुसृत्य नास्ति।","इदं सङ्ग्रहालयम् अद्भुतैः युक्तं वर्तते।",["अद्भुतम्","आश्चर्यम्","इङ्गम्"],"वस्तुः",["ಅದ್ಭುತ","ವಿಲಕ್ಷಣ","ವಿಚಿತ್ರ"]],["n","पश्चिमबङ्गालराज्ये वर्तमानम् एकं नगरम्।","मालदामण्डलस्य मुख्यालयः इङ्गलिशबाजारनगरे अस्ति।",["इङ्गलिशबाजारनगरम्"],"पुरम्",[]],["n","सूचनस्य क्रिया।","तस्य इङ्गितं मया नावधानं दत्तं स्वकार्यम् एव कृतम्।",["इङ्गितम्"],"कर्म",[]],["n","एकः क्षुपः ।","इङ्गिडस्य उल्लेखः कौशिक-सूत्रे अस्ति",["इङ्गिडः"],"",[]]],"w":{"इङ्गुदी":[0,2],"इङ्ग":[1,5],"इङ्काजनाः":[3],"इङ्काजना":[3],"इङ्का":[4],"इङ्गम्":[5],"इङ्गलिशबाजारनगरम्":[6],"इङ्गलिशबाजारनगर":[6],"इङ्गितम्":[7],"इङ्गित":[7],"इङ्गिडः":[8],"इङ्गिड":[8]}}