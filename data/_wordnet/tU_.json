{"s":[["n","मस्या कर्गजे लेखनस्य साधनम्।","एषा लेखनी केनचित् मह्यम् उपायनत्वेन दत्ता।",["लेखनी","आलेखनी","कलमः","तूलिः","तूलिका","अक्षरतूलिका","वर्णिका","वर्णाङ्का","श्रीकरणः","मसिपथः","अक्षरजननी","अवलेखा"],"लेखनी",["ಲೇಖನಿ","ಪೆನ್ನು","ಲೇಖನ","ಲೆಕ್ಕಣಿಕೆ"]],["n","तत् यन्त्रं यस्मात् संगीतस्य स्वरादीनि तालानि वा वाद्यन्ते।","अस्मिन् सङ्गीतविद्यालये नानाप्रकारकानि वाद्यानि सन्ति।",["वाद्यम्","वादित्रम्","तूर्यम्","आतोद्यम्","तालितम्"],"",["ಸಂಗೀತ ವಾಧ್ಯಗಳು","ಸಂಗೀತ ಉಪಕರಣಗಳು"]],["n","यः धनुः धरति।","साधुवेशधरौ भ्रमन्तौ द्वौ धनुर्धरौ ऋषिः अपश्यत्।",["धनुर्धरः","धनुर्भृत्","धनुर्धारी","धन्वी","धनुषमान्","धानुष्कः","निषङ्गी","अस्त्री","तूणी"],"अस्त्रधारी",["ಧನುರ್ಧಾರಿ","ಬಿಲ್ಲನ್ನು ಧರಿಸುವವನು","ಕೊಂದಂಡ ಧರಿಸುವವನು","ಧನಸ್ಸು ಧರಿಸುವವನು"]],["n","तन्तुहेतुभूतः कर्पासस्य भागः।","अस्मिन् आच्छादने किलोत्रयः तूलः अस्ति।",["तूलः","पिचुलः","पिचुः","पिचुतूलम्","तूलम्","तूलकम्","तूलपिचुः"],"",["ಅರಳೆ","ಹತ್ತಿ"]],["n","तैलादिषु मज्जित्वा निर्मितः वस्त्रादेः भागः।","तेन तूलनिगेन गण्डः संमार्जितः।",["तूलनिगः"],"मानवकृति",["ಔಷಧ ಮುಂತಾದವುಗಳಿಂದ ಒದ್ದೆ ಮಾಡಿದ ಅರಳೆಯ ಹಂಜಿ"]],["n","यः तूर्यवादने निपुणः अस्ति।","सः कुशलः तूर्यवादकः अस्ति।",["तूर्यवादकः"],"वादकः",["ತುತ್ತೂರಿ ವಾದಕ","ತುತ್ತೂರಿ-ವಾದಕ","ತುತ್ತೂರಿ ಊದುವವನು","ತುತ್ತೂರಿ-ಊದುವವನು"]],["d","तीव्रगत्या सह यथा स्यात् तथा।","शीघ्रम् एतत् कार्यं सम्पन्नतां नयतु।",["शीघ्रम्","त्वरया","त्वरितम्","द्रुतम्","वेगेन","वेगतः","जवेन","तूर्णम्","आशु","सत्वरम्","सत्वरितम्","अञ्जसा"],"",["ಬೇಗ","ಬೇಗ-ಬೇಗ","ಚಟಪಟನೆ","ಸರಸರನೆ"]],["n","वृक्षविशेषः यस्य फलानि मिष्टानि सन्ति।","तूतस्य अदनार्थे वयं तूते आरोहामः।",["तूतः","तूदः","यूपः","क्रमुकः","ब्रह्मभागः","ब्राह्मणेष्टः","ब्रह्मनिष्ठः","ब्रह्मस्थानः","सुरूपः","यूषः","नूदः","पूषः"],"वृक्षः",["ನೇರಿಳೆ","ನೇರಳೆ","ನೇರಳೆಹಣ್ಣು"]],["n","मध्यमाकारवतः तूतवृक्षस्य फलम्।","बालकाः तूदान् अदन्ति।",["तूदः","क्रमुकः","यूपः"],"खाद्यफलम्",["ನೇರಳೆ","ನೇರಿಳೆ","ನೇರಳೆ ಹಣ್ಣು","ನೇರಿಳೆ ಹಣ್ಣು"]],["n","सूतवयनाय उपयुक्तम् उपकरणम्।","सीता तूलपीठ्या सूतं वयति।",["तूलपीठी","सूत्रला"],"सूत्रग्रन्थनसाधनम्",["ಕದಿರುಂಡಿಗೆ","ಕದಿರು","ಕದರು","ತಕಲಿ"]],["n","यस्मिन् बाणानि तूण्यन्ते।","अर्जुनस्य तूणे नैके बाणाः सन्ति।",["तूणः","तूणा","तूणी","तूणीरः","शरधिः","इषुधिः","शराश्रयः","बाणाश्रयः","निषङ्गः","अपासङ्गः","उपासङ्गः","तुलसारिणी"],"सुषिपात्रम्",["ಬತ್ತಳಿಕೆ"]],["n","चित्रकरस्य उपकरणम्।","सः तूलिकया चित्राकृतिं रञ्जयति।",["तूलिका","तूली","ईषीका","इषीका"],"उपकरणम्",["ಕುಂಚ","ಕೂರ್ಚಿ","ಬ್ರಷ್ಷು","ವರ್ಣ ಕುಂಚ"]],["d","मूकम् इव।","भवान् अत्र तूष्णीम् उपविशतु।",["तूष्णीम्","मूकम्","जडवत्","मूकवत्","निःशब्दम्","निरुत्तरम्"],"",[]],["n","तूलस्य बीजम्।","सः यन्त्रेण तूलात् तूलबीजं दूरीकरोति।",["तूलबीजम्"],"बीजम्",["ಹತ್ತಿ ಬೀಜ"]],["n","वायुवाद्यम्।","विवाहकाले तूरीवादकः तूरीं वादयति।",["तूरी","तूर्यम्"],"सुषिर-वाद्यम्",["ತುತ್ತೂರಿ","ಕೊಂಬು ಕಹಳೆ","ಕೊಂಬು"]],["n","सः जनः यः न स्त्री न च पुमान्।","अद्यतनकाले क्लीबाः अपि राजनीतौ भागं गृह्णन्ति।",["क्लीबः","तृतीयप्रकृतिः","अपुंस्","उडुम्बरः","तूबरकः","पृष्ठशृङ्गी","वर्षवरः","पण्ड्रः","मुष्कशून्यः","पण्ड्रकः","स्त्रीस्वभावः","वृषाङ्कः"],"मनुष्यः",["ನಪುಂಸಕ","ಹಿಜಡಾ","ಹಿಜರಾ","ಗಂಡಸುತನವಿಲ್ಲದವನು"]],["v","वस्तुनः गुरुत्वं प्रमातुं तानि तुलायन्त्रे प्रस्थापनानुकूलः व्यापारः।","आपणिकः धान्यं तोलयति।",["तोलय","तूलय"],"कृ",["ತೂಕ ಮಾಡು","ತುಲನೆ ಮಾಡು"]],["n","ताम्रस्य लवणम्।","शिखिग्रीवम् रञ्जने तथाच मुद्रणे उपयुज्यते।",["शिखिग्रीवम्","शिखिकण्ठम्","कृष्णः","वितुन्नकः","तूतकम्","हेमसारम्","नीलम्","कांस्यनीली","अमृतासङ्गम्","हेमतारम्","तुत्थकम्"],"रासायनिकपदार्थः",["ತಾಮ್ರದ ಕಿಲಬು","ತಾಮ್ರದ-ಕಿಲಬು"]],["n","तुलादीन् निवेशयित्वा निर्मितः प्रच्छदः।","शैत्यनिवारणार्थे जनाः तुलिकाम् आच्छाद्य स्वपन्ति।",["तुलिका","तुला","तुली","तूलपटी","उत्तरप्रच्छदः","उत्तरछदः","आस्तरः","संस्तरः","स्तरिमा"],"प्रावरणम्",["ಅರಳೆ ತುಂಬಿದ ಹೊದಿಕೆ"]],["n","सुषिरवाद्यविशेषः।","तूम्बवीणायाः ध्वनिं श्रुत्वा बालकाः संघटिताः।",["तूम्बवीणा"],"सुषिर-वाद्यम्",["ಪುಂಗಿ"]],["n","बीजानाम् उपरीतनः तन्तुयुक्तः भागः।","शाल्मलेः कर्पासस्य उपाधानम् अतीव मृदु भवति।",["कर्पासः","तूली","तूलपिचुः","पिशुनः"],"",["ಹತ್ತಿ ಅರಳೆ","ರಲೆ","ಅರುನಬ","ಪಳ್ತೆ"]],["n","एकं प्राचीनं वाद्यम्।","तूणवं तूणसदृशम् आसीत्।",["तूणवम्"],"वाद्यम्",[]],["n","वातरोगविशेषः।","तूण्यां पीडा मूत्राशयात् आरभ्य गुदां यावत् भवति।",["तूणी"],"वातरोगः",[]],["n","लेखनार्थं पटोलिकारुपेण निर्मितः पत्राणां समूहः।","गीता बृस्यां लिखति किञ्चित्।",["बृसी","वर्ती","तूलपदम्"],"लेखनपुस्तिका",[]],["n","एकं प्राचीनं वाद्यम्।","तूर्यं भोजनसमये वाद्यते।",["तूर्यम्"],"वाद्यम्",[]],["n","तमिलनाडुराज्ये वर्तमानम् एकं नगरम्।","तूतुकुडीनगरे नौकास्थानस्य वर्तमानत्वात् उद्योगानां कृते प्रोत्साहनं प्राप्यते।",["तूतुकुडीनगरम्"],"पुरम्",[]],["n","तमिलनाडुराज्ये वर्तमानम् एकं मण्डलम्।","तूतुकुडीमण्डलस्य मुख्यालयः तूतुकुडीनगरे अस्ति।",["तूतुकुडीमण्डलम्"],"मण्डलम्",[]],["n","लेखने चित्रादीनां निर्माणे वा उपयुज्यमाना आलेख्यकूर्चिका।","चित्रकारः शलाकाम् उपयुज्य चित्रं निर्माति।",["शलाका","तूलिका","ईषिका","तुलिः","तूली","ईषीका","इषीका"],"उपकरणम्",[]],["a","स्वरबद्धं गातुं योग्यं च।","मीरायाः गानीयानि पदानि सर्वेषां मनसि भक्तिभावं जनयन्ति।",["गानीय","तूर्यमय"],"",["ಸಂಗೀತಾತ್ಮಕ","ಸಂಗೀತಾತ್ಮಕವಾದ","ಸಂಗೀತಮಯ","ಸಂಗೀತಮಯವಾದ"]],["n","कार्पासजातं वस्त्रम्।","तस्मै कार्पासात् निर्मितानि परिधानानि रोचन्ते।",["कार्पासम्","कार्पासवस्त्रम्","कार्पासाम्बरम्","तूलावस्त्रम्","फालम्","वादरम्"],"पटम्",["ನೂಲಿನ ಬಟ್ಟೆ"]],["n","कर्गजे लेखितुम् उपयुक्तं सीसयुक्तम् उपकरणम् ।","माता मह्यम् अङ्कनीम् अददत् ।",["अङ्कनी","कुचिका","शलका","तूलिका","आलेखनी"],"लेखनी",["ಸೀಸದ ಕಡ್ಡಿ","ಪೆನ್ಸಿಲ್ ಲೆಡ್ಡ್","ಸೀಸದ-ಕಡ್ಡಿ","ಸೀಸದಕಡ್ಡಿ"]],["n","वस्त्रस्य सः अन्तीमः भागः यस्मिन् वस्त्रं शोभयितुं  विविधानां प्रकाराणां वस्तूनि वर्तन्ते ।","तस्याः पोशाखस्य वस्त्रदशायां सुन्दरः तन्तुः अस्ति ।",["वस्त्रदशा","अवतारणम्","तूषम्","माढिः","सिच्"],"",[]],["n","एकः पुरुषः ।","तूखस्य उल्लेखः काठके वर्तते",["तूखः"],"",[]],["n","एकः जनपदः ।","तूदी पाणिनिना परिगणिता",["तूदी"],"",[]],["n","एकः वंशः ।","तूर्यस्य उल्लेखः कोशे वर्तते",["तूर्यः"],"",[]],["n","एकः क्षुपः ।","तूर्यन्त्याः एत्यस्य उल्लेखः आपस्तम्बगृह्यसूत्रे वर्तते",["तूर्यन्ती"],"",[]]],"w":{"तूलिः":[0],"तूलि":[0],"तूलिका":[0,11,27,30],"तूर्यम्":[1,14,24],"तूर्य":[1,14,24,34],"तूणी":[2,10,22],"तूलः":[3],"तूल":[3],"तूलम्":[3],"तूलकम्":[3],"तूलक":[3],"तूलपिचुः":[3,20],"तूलपिचु":[3,20],"तूलनिगः":[4],"तूलनिग":[4],"तूर्यवादकः":