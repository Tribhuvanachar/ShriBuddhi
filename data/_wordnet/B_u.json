{"s":[["n","अवयवविशेषः- कक्षाद्यङ्गुल्यग्रपर्यन्तावयवविशेषः येन वस्तूनि ध्रियन्ते कार्यं च क्रियते।","बलिनौ भीमस्य बाहू।",["बाहुः","भुजा","करः","प्रवेष्टः","दोः","दोषः","बाहः","आयाती","च्यवना","अनीशू","अप्लवाना","विनङ्गृसौ"],"बाह्य-शारीरिक-भागः",["ಭುಜ","ಕೈ","ಕರ","ತೋಳು"]],["n","अवयवविशेषः, हस्तमध्यगतः अवयवः येन मणिबन्ध-बाहु-पर्यन्तः हस्तः अनायासेन परिवर्तते।","वाहनभ्रंशेन तस्य कफोणिः आहतः।",["कफोणिः","कफणिः","भुजामध्यः"],"",["ಮೊಣಕೈ"]],["n","सर्पभार्या।","एतद् सर्पिण्याः अण्डम् अस्ति।",["सर्पिणी","सर्पी","भुजङ्गिनी"],"उरगः",["ಹೆಣ್ಣು ಜಾತಿಯ ಹಾವು","ಹೆಣ್ಣು ಜಾತಿಯ-ಹಾವು","ಹೆಣ್ಣು ಹಾವು","ಹೆಣ್ಣು-ಹಾವು"]],["n","पृथिव्याः अधोरुर्ध्वभागे च कल्पितानि चतुर्दशस्थानानि।","धर्मग्रन्थानुसारेण पृथिव्याः अधः सप्त तथा च उपरि सप्त लोकाः सन्ति।",["भुवनम्","लोकः"],"पौराणिकस्थानम्",["ಲೋಕ","ಭುವನ","ಜಗತ್ತು","ಭೂಮಿ"]],["a","यस्य उपयोगः कृतः।","मिष्टान्नविक्रेता मिष्टान्ने प्रयुक्तानां पदार्थानां सूचिम् अकरोत्।",["प्रयुक्त","प्रयोजित","उपयोजित","व्यवहृत","व्यवहारित","सेवित","उपसेवित","भुक्त","उपभुक्त","धृत","अभ्यस्त"],"",["ಬಳಸಿದ","ಬಳಸಿದಂತ","ಬಳಸಿದಂತಹ","ಬಳಕೆಗೊಂಡ"]],["n","भुजस्य कोटरः।","तस्य भुजकोटरे विस्फोटः जातः।",["भुजकोटरः","दोर्मूलम्","उपपक्षः","कक्षपुटः","खण्डिकः","निकक्षः","पुरञ्जरः","शिखरः"],"शारीरिकभागः",["ಕಂಕುಳು","ಬಗಲು","ಕಂಕುಳುಕುಳಿ","ಕಕ್ಷ"]],["n","यत्र सर्वे प्राणिनः वसन्ति।","अस्मिन् संसारे मृत्युः शाश्वतः।",["संसारः","विश्वः","विश्वम्","जगत्","भुवनम्","मृत्युलोकः","इहलोकः"],"स्थलम्",["ಭೂಮಿ","ಜಗತ್ತು","ಭೂಲೋಕ","ಭೂ-ಲೋಕ"]],["a","यस्मिन् कपटम् अस्ति।","तस्य हास्यं कुटिलम् अस्ति।",["कुटिल","वक्र","अराल","वृजिन","जिह्म","ऊर्मिमत्","कुञ्चित","नत","आविद्ध","भुग्न","वेल्लित"],"",["ಮೋಸಗಾರಿಕೆಯ","ಕಪಟದ","ವಂಚನೆಯ","ಸಂಚಿನ"]],["n","शरीरावयवविशेषः, हृदयोपरिकण्ठादधोभागः।","कौस्तुभाख्यमपां सारं बिभ्राणं बृहतोरसा।",["उरः","वक्षः","क्रोडम्","भुजान्तरम्","वक्षणम्","वक्षस्थलम्"],"शारीरिकभागः",["ಎದೆ","ವಕ್ಷಸ್ಥಳ","ವಕ್ಷ-ಸ್ಥಳ","ವಕ್ಷ"]],["n","जन्तुविशेषः, सः अगात्रायतसशल्कजन्तुः यः उरसा गच्छति।","सर्पाः शून्यागारे वसन्ति।",["सर्पः","भुजगः","भुजङ्गः","अहिः","भुजङ्गम्","उरगः","पृदाकुः","आशीविषः","विषधरः","चक्री","व्यालः","सरीसृपः"],"उरगः",["ಹಾವು","ಸರಿಸೃಪ","ಉರುಗ","ಸರ್ಪ"]],["n","हिन्दुधर्मग्रन्थेषु वर्तमाना एका देवता या भुवलोकस्य अधिपतिः अस्ति ।","वेदेषु भुवस्य अर्चना विधीयते ।",["भुवः"],"देवः",["ಭೂಮಿ","ಭೂಲೋಕ"]],["n","अवयवविशेषः, कण्ठबाहुमध्यगः अवयवः।","हनुमान् रामलक्ष्मणौ स्वस्य स्कन्धे स्थापयित्वा सुग्रीवस्य समीपे गतः।",["स्कन्धः","भुजशिरः","अंसः","दोःशिखरम्"],"शारीरिकभागः",["ಭುಜ","ತೋಳು","ಹೆಗಲು","ಬಾಹು"]],["v","अन्नस्य शीघ्रगत्या गल-बिलाधः-संयोगानुकूल-व्यापारः।","सिंहः शशकम् अभक्षयत्।",["भक्ष्","भुज्","खाद्","अश्"],"भक्ष्(भक्षति/ते)",["ಗಪಗಪ ತಿನ್ನು","ಮುಕ್ಕು","ಭಕ್ಷಿಸು","ತಿನ್ನು"]],["v","अन्नस्य गल-बिलाधः-संयोगानुकूल-व्यापारः।","भो माणवक, भक्षय एतत् फलम्।",["भक्ष्(भक्षति/ते)","भक्ष् (भक्षयति)","भुज्","खाद्","अश्","घस्","खद्","हु","चर्ब","छम्","चम् (चमति)","वी"],"कृ",["ತಿನ್ನು","ಭಕ್ಷಿಸು","ಭೋಜಿಸು"]],["n","व्यायामविशेषः- यस्मिन् अभिमुखीकृत्य शयनं क्रियते तथा च तदनन्तरं शरीरं करतलबलेन उद्धार्यते पुनः भूमिशयनं च क्रियते।","सः प्रतिदिनं धावनाद् अनन्तरं भुजव्यायामं करोति।",["भुजव्यायामः"],"व्यायामः",["ವ್ಯಾಯಾಮ","ಕಸರತ್ತು","ದಂಡ"]],["n","सर्पविशेषः, तीव्रविषयुक्तः, फणालाङ्गुलयुक्तः सर्पः।","नागः चन्दनतरौ वसति।",["नागः","भुजङ्गः","फणी"],"सर्पः",["ಸರ್ಪ","ಹಾವು","ಫಣಿ","ಅಕರ್ಣ"]],["v","सुखदुःखादिविकाराणाम् भुक्तिः।","स्वकर्मस्य फलम् भुनक्ति",["भुज्"],"सह्",["ಅನುಭವಿಸು","ಪಡೆ"]],["n","भूमितिशास्त्रे क्षेत्रस्य आकृतेः वा पक्षस्य रेखा।","अस्य चतुर्भुजस्य चत्वारः अपि भुजाः असमानाः सन्ति।",["भुजः","भुजा"],"रेखा",["ಭುಜ","ಬಾಹು"]],["n","अपक्वा भोजनसामग्री या कमपि भोजननिर्मातुं यच्छति।","महात्मना भुक्तिं गृहीत्वा स्वस्य भोजनं पाचयति।",["भुक्तिः"],"शस्यम्",["ನೇರವಾಗಿ"]],["n","वृक्षस्य त्वक् या पवित्रा अस्ति इति मन्यते तथा च प्राचीने काले या लेखनार्थे उपयुज्यते स्म।","हिन्दूनां नैकेषु धर्मानुष्ठानेषु भुर्जपत्रम् उपयुज्यते।",["भुर्जपत्रम्"],"वल्कलः",["ಭೋರ್ಜಪತ್ರ"]],["n","सा बालिका या अन्येषां कृते कार्यं करोति।","तेन पित्रोः सेवार्थे कना नियुक्ता।",["कना","भुजिष्या"],"अनुचरी",["ಬಾಲಕಿ","ಹುಡುಗಿ","ಹೆಣ್ಣು ಮಗಳು"]],["n","छत्रविशेषः।","मह्यं छत्रकस्य शाकं रोचते।",["छत्रकः","दिलीरः","पालघ्नः","भूस्फोटः","वसारोहः","भुवः","ऊर्वङ्गम्","कन्दलीकुसुमम्","करकम्","कवकम्","छत्राकम्","देशकपटुम्"],"अतिच्छत्रः",["ಅಣಬೆ","ನಾಯಿಗೊಡೆ"]],["n","वक्रस्य अवस्था भावः वा।","कर्मकारः तन्तोः वक्रतां दूरीकरोति।",["वक्रता","वक्रीभावः","अरालता","वृजिनता","कुञ्चितता","कुटिलता","भुग्नता","वङ्कुरता"],"",["ವಕ್ರ","ಡೊಂಕು","ಅಂಕು-ಡೊಂಕು","ಓರೆ"]],["v","सुखदुःखप्रतीत्यनुकूलः व्यापारः।","पुरुषः यथा कर्म तथैव फलं भुङ्क्ते।",["भुज्","उपभुज्","अनुभू"],"ज्ञा",["ಅನುಭವಿಸು"]],["n","एकः अधिकः द्वौ इति कृत्वा प्राप्ता संख्या।","पञ्च इति सङ्ख्यातः यदा द्वौ इति सङ्ख्या न्यूनीकृता तदा त्रयः इति संङ्ख्या प्राप्ता।",["त्रयः","तिस्रः","त्रीणि","कालः","अग्निः","भुवनम्","गङ्गामार्गः","शिवचक्षुः","गुणः","ग्रीवारेखा","कालिदासकाव्यम्","वलिः"],"सङ्ख्या",["ಮೂರು","3","III"]],["v","विशेषतः मनुष्यैः परिवेषणस्य भोजनस्य भक्षणानुकूलः व्यापारः।","कथासमाप्त्यनन्तरं भक्ताः पङ्क्तौ उपविश्य भुञ्जते।",["भुज्","अद्","खाद्","अश्","भक्षय","घस्","प्सा","आस्वाद्","गॄ","चर्व्","अभ्यवहृ","आहृ"],"",["ತಿನ್ನು","ಸೇವಿಸು"]],["n","उडिसाराज्यस्य राजधानी।","भुवनेश्वरं तु दर्शनीयं नगरमेव।",["भुवनेश्वरम्"],"राजधानी",[]],["n","लताविशेषः।","रासना औषधरूपेण उपयुज्यते।",["रासना","नाकुली","सुरसा","सुगन्धा","गन्धनाकुली","नकुलेष्टा","भुजङ्गाक्षी","छत्राही","सुवहा","रस्या","श्रेयसी","रसना"],"लता",[]],["n","महाराष्ट्रराज्यस्य नगरविशेषः यः जलगावमण्डले वर्तते।","भुसावळनगरं तापीनद्याः तटे स्थितम्।",["भुसावळनगरम्"],"पुरम्",[]],["n","\"गुजरातप्रान्ते वर्तमानम् एकं नगरम्।","कच्छमण्डलस्य मुख्यालयः भुजनगरे वर्तते।",["भुजनगरम्"],"पुरम्",[]],["n","सर्पविशेषः।","पृदाकोः विषेण कानिचन औषधानि अपि निर्मीयन्ते।",["पृदाकुः","स्वजः","भुज्युः"],"सर्पः",[]],["a","हस्तविहीनः।","भिक्षां याचमानम् अभुजं पुरुषं दृष्ट्वा अहं करुणामयः अभवम्।",["अभुज","भुजाहीन","बाहुहीन"],"",[]],["n","ऋषिविशेषः।","भुरुण्डस्य वर्णनं पुराणेषु अस्ति।",["भुरुण्डः"],"आप्तः",[]],["n","पौराणिकः अस्त्रविशेषः।","भुशुण्डेः वर्णनं महाभारते अस्ति।",["भुशुण्डिः"],"",[]],["n","छन्दविशेषः।","भुजङ्गप्रयातस्य प्रत्येकस्मिन् चरणे द्वादश अक्षराणि भवन्ति।",["भुजङ्गप्रयातम्"],"वृत्तम्",[]],["n","वर्णवृत्तविशेषः।","भुजङ्गसङ्गतायाः प्रत्येकस्मिन् चरणे नव वर्णाः भवन्ति।",["भुजङ्गसङ्गता"],"वृत्तम्",[]],["n","रोगविशेषः यस्मिन् हस्तः अकार्यशीलः भवति।","भुजस्तम्भस्य कारणात् पितामही हस्तः उपरि कर्तुं न शक्नोति।",["भुजस्तम्भः"],"व्याधिः",[]],["n","कापि गोलाकृतिः ।","सर्पः वलयम् अपश्यत् ।",["वलयम्","भोगः","भुजा","भुजः"],"आकृतिः",[]],["n","एकं नगरम् ।","भुजनगरस्य उल्लेखः कोशे वर्तते",["भुजनगरम्"],"",[]],["n","एकः पुरुषः ।","भुरुण्डस्य उल्लेखः प्रवरग्रन्थे वर्तते",["भुरुण्डः"],"",[]],["n","एका देवता ।","भुवनेश्याः उल्लेखः कोशे वर्तते",["भुवनेशी"],"",[]]],"w":{"भुजा":[0,17,37],"भुजामध्यः":[1],"भुजामध्य":[1],"भुजङ्गिनी":[2],"भुवनम्":[3,6,24],"भुवन":[3,6,24],"भुक्त":[4],"भुजकोटरः":[5],"भुजकोटर":[5],"भुग्न":[7],"भुजान्तरम्":[8],"भुजान्तर":[8],"भुजगः":[9],"भुजग":[9],"भुजङ्गः":[9,15],"भुजङ्ग":[9,15],"भुजङ्गम्":[9],"भुवः":[10,21],"भुव":[10,21],"भुजशिरः":[11],"भुजशिर":[11],"भुज्":[12,13,16,23,25],"भुजव्यायामः":[14],"भुजव्यायाम":[14],"भुजः":[17,37],"भुज":[17,37],"भुक्तिः":[18],"भुक्ति":[18],"भुर्जपत्रम्":[19],"भुर्जपत्र":[19],"भुजिष्या":[20],"भुग्नता":[22],"भुवनेश्वरम्":[26],"भुवनेश्वर":[26],"भुजङ्गाक्षी":[27],"भुसावळनगरम्":[28],"भुसावळनगर":[28],"भुजनगरम्":[29,38],"भुजनगर":[29,38],"भुज्युः":[30],"भुज्यु":[30],"भुजाहीन":[31],"भुरुण्डः":[32,39],"भुरुण्ड":[32,39],"भुशुण्डिः":[33],"भुशुण्डि":[33],"भुजङ्गप्रयातम्":[34],"भुजङ्गप्रयात":[34],"भुजङ्गसङ्गता":[35],"भुजस्तम्भः":[36],"भुजस्तम्भ":[36],"भुवनेशी":[40]}}