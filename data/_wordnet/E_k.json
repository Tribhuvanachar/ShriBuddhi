{"s":[["n","एकमतेः भावः।","तयोः मध्ये ऐकमत्यं सञ्जातम्।",["ऐकमत्यम्"],"कर्म",["ಸಹಮತ","ಕರಾರು","ಅಗ್ರಿಮೆಂಟ್"]],["n","एकचित्तस्य भावः।","सरिता प्रत्येकं कार्यं एकाग्रतया करोति।",["एकाग्रता","ऐकाग्र्यम्","निष्ठा","निष्ठितत्वम्","एकनिष्ठता","अनन्यवृत्तिः","एकचित्ता","एकचित्तत्वम्","अनन्यचित्तता","अभिनिवेशः","चित्ताभिनिवेशः","अभियुक्तता"],"मनोदशा",["ಗಮನವಿಟ್ಟು","ಗಮನವಹಿಸುವಿಕೆ","ಲಕ್ಷ್ಯವಿಡುವಿಕೆ"]],["n","एकस्य भावः।","देशस्य एकतायाः तथा च अखण्डतायाः रक्षणं अस्माकं परमं कर्तव्यम्।",["एकता","एकत्वम्","ऐक्यम्","संयोगः","योगः","सन्धिः","सङ्गः","सम्भूति"],"",["ಏಕತೆಯ","ಒಗ್ಗಟ್ಟು","ಒಕ್ಕಟ್ಟು","ಐಕ್ಯ"]],["n","सा स्थितिः यत्र उपस्थिताः सम्बद्धाः वा जनाः एकं एव मतम् अनुमन्यन्ते।","रामाय एकमत्येन अस्य संस्थायाः सचिवं निर्वाचितम्।",["ऐकमत्यम्","एकचित्तम्","एकवाक्यता","एकायनीभाव","ऐकमुख्य"],"दशा",["ಸರ್ವಾನುಮತ","ಒಮ್ಮತ","ಏಕಾಭಿಪ್ರಾಯ"]],["a","यस्य अन्ते ऐकारः अस्ति।","कै इति ऐकारान्तः शब्दः अस्ति।",["ऐकारान्त"],"",["ಏ ಕರಾಂತ್ಯ","ಏ ಕರಾಂತ್ಯದ","ಏ ಕರಾಂತ್ಯದಂತ","ಏ ಕರಾಂತ್ಯದಂತಹ"]],["n","कस्मिञ्चित् विषये विचारे वा सर्वेषां जनानां समानं मतं वर्तते तादृशी अवस्था।","तस्य व्यक्तित्वस्य विषये विद्वत्सु ऐकमत्यं नास्ति।",["ऐकमत्यम्","एकवाक्यता","एकचित्तता"],"",[]],["n","वर्णमालायां नवमः स्वरः।","कण्ठः तालुश्च ऐकारस्य उच्चारणस्थाने स्तः।",["ऐकारः"],"स्वरः",[]]],"w":{"ऐकमत्यम्":[0,3,5],"ऐकमत्य":[0,3,5],"ऐकाग्र्यम्":[1],"ऐकाग्र्य":[1],"ऐक्यम्":[2],"ऐक्य":[2],"ऐकमुख्य":[3],"ऐकारान्त":[4],"ऐकारः":[6],"ऐकार":[6]}}