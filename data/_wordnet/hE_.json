{"s":[["n","मासभेदः चान्द्रसंवत्सरे द्वादशमासान्तर्गतदशमः मासः।","पौषे अतिशीतता अस्ति।",["पौषः","तैषः","सहस्यः","पौषिकः","हैमनः","तिष्यः","तिष्यकः"],"चान्द्रमासः",["ಪುಷ್ಯ","ಪುಷ್ಯ ಮಾಸ"]],["n","सस्यविशेषः, कृष्णपुष्पवान् क्षुद्रवृक्षः यस्य तैलदानि बीजानि सन्ति।","अतस्यः पक्वेभ्यः बीजेभ्यः तैलं निकृष्यते।",["अतसी","उमा","चणका","क्षौमी","रुद्रपत्नी","सुवर्चला","पिछिला","देवी","नदगन्धा","मदोत्कटा","क्षुमा","हैमवती"],"क्षुपः",["ಅಗಸೆ"]],["n","गव्यविशेषः- अस्य गुणाः शीतत्व-वर्णबलाहत्वादयः।","कृष्णाय नवनीतं रोचते।",["नवनीतम्","सरसजम्","मन्थजम्","हैयङ्गवीनम्","दधिजम्","सारसम्","हैयङ्गवीनकम्"],"दुग्धजः",["ಬೆಣ್ಣೆ","ನವನೀತ"]],["n","शरीरस्य सा अनुभूतिः या तापमानह्रासात् प्रादुर्भवति तथा च यस्याम् और्ण-वस्त्र-परिधानस्य।","प्रातःकालात् आरभ्य अहं शैत्यम् अनुभवामि।",["शैत्यम्","शीतता","शीतम्","शीतलता","हैमम्"],"अनुभूतिः",["ಥಂಡಿ","ಶೀತ","ಚಳಿ"]],["n","हरितकीवृक्षस्य फलं यद् हरितपीतवर्णीयम् अस्ति।","शुष्ककासे शिवा अतीव उपयुक्ता अस्ति।",["शिवा","हरितकी","अभया","अव्यथा","पथ्या","वयःस्था","पूतना","अमृता","हैमवती","चेतकी","श्रेयसी","सुधा"],"खाद्यफलम्",["ಅಳಲೆಕಾಯಿ ಮರ","ಅಳಲೆಕಾಯಿ"]],["n","सा देवी यया नैके दैत्याः हताः तथा च या आदिशक्तिः अस्ति इति मन्यते।","नवरात्रोत्सवे स्थाने स्थाने दुर्गायाः प्रतिष्ठापना क्रियते।",["दुर्गा","उमा","कात्यायनी","गौरी","ब्रह्माणी","काली","हैमवती","ईश्वरा","शिवा","भवानी","रुद्राणी","सर्वाणी"],"",["ಚಾಮುಂಡಿ","ಚಾಮುಂಡೇಶ್ವರಿ","ಮಹಾಕಾಳಿ","ದುರ್ಗಿ"]],["n","भीमसेनस्य हिडिम्बायाः गर्भात् जातः पुत्रः।","महाभारते युद्धे कर्णेन घटोत्कचः हतः।",["घटोत्कचः","हैडिम्बः"],"पौराणिकपुरुषः",["ಘಟೋತ್ಕಚ","ಹಿಂಡಿಂಬೆ"]],["n","शीतस्य कालः।","यदा शीतकाले वर्षा जायते तदा शीतत्वं वर्धते।",["शीतकालः","शीतकः","हेमन्तः","सहाः","हैमनः"],"कालः",["ಚಳಿ","ಥಂಡಿ","ಶೀತ","ಚಲಿಗಾಲ"]],["a","स्वर्णस्य वर्णसदृशः।","शीतकाले स्वर्णिमानि किरणानि आल्हादयन्ति।",["स्वर्णिम","सुवर्णीय","सुवर्ण","हैम","हिरण्मय","स्वर्णिल","हेममय"],"",["ಬಂಗಾರ ಬಣ್ಣದ"]],["n","शीतकालः यत् अग्रहायणपौषमासात्मकः।","हेमन्ते कस्मिंश्चित् स्थाने हिमपातः भवति।",["हेमन्तः","हेमन्तम्","हैमनः","उष्मासहः","शरदन्तः","हिमागमः"],"ऋतुः",["ಹೇಮಂತ ಋತು","ಹೇಮಂತ-ಋತು"]],["n","धान्य-विशेषः, कृष्ण-पुष्प-क्षुद्र-वृक्षस्य तैलदाः बीजाः (आयुर्वेदे अस्य उष्णत्व-तिक्तत्व-अम्लत्वादयः गुणाः प्रोक्ताः वातहारित्वं श्लेष्म-पित्तकारित्वं च)","अतसी मधुरा तिक्ता स्निग्धा पाके कटुर्गुरु [श क]",["अतसी","उमा","चणका","क्षौमी","रुद्रपत्नी","सुवर्चला","पिछिला","देवी","नदगन्धा","मदोत्कटा","क्षुमा","हैमवती"],"तिलः",["ಅಗಸೆ ಬೀಜ"]],["n","पर्वतप्रदेशेषु प्राप्यमाणः औषधीयक्षुपः यः एकवर्षीयः वा द्विवर्षीयः वा भवति, यस्य उन्नतिः द्व्यङ्गुलादारभ्य चतुरङ्गुलपर्यन्तं च भवति।","भूनिम्बस्य मूलरूपं नेपालदेशे प्राप्यते।",["भूनिम्बः","किराततिक्तः","अनार्यतिक्तः","भूतिकम्","कैरातः","रामसेनकः","हैमः","काण्डतिक्तः","किरातकः","कटुतिक्तः"],"क्षुपः",[]],["n","भारतदेशे वर्तमानस्य आन्ध्रप्रदेशस्य राजधानी।","हैदराबादनगरे वर्तमानं चारमीनार इति भवनम् आवश्यं प्रेक्षणीयम्।",["हैदराबादनगरम्"],"",["ಹೈದರಾಬಾದ್","ಹೈದರಾಬಾದ್ ನಗರ","ಹೈದ್ರಾಬಾದ್","ಹೈದ್ರಾಬಾದ್ ನಗರ"]],["n","सः वादः यस्मिन् केवलं बुद्धेः सम्मताः विषयाः स्वीकृताः।","हेतुवादः बुद्धेः महत्वं प्रतिपादयति।",["हेतुवादः","कारणवादः","हैतुकत्वम्"],"सिद्धान्तः",["ಬುದ್ಧಿವಾದ","ತಿಳುವಳಿಕೆ ಮಾತು","ತಿಳುವಳಿಕೆ-ಮಾತು"]],["n","आम्राणाम् एकः प्रकारः।","हैदरसाहेब-आम्रस्य रसः अतीव मधुरः।",["हैदरसाहेब-आम्रम्"],"आम्रम्",[]],["n","हैदरसाहेब इति नामकानाम् आम्राणां वृक्षः।","हैदरसाहेब-आम्रः प्रफुल्लितः।",["हैदरसाहेब-आम्रः"],"आम्रः",[]],["n","आम्राणाम् एकः प्रकारः।","तेन ब्राजीलदेशात् हैडेन-आम्राणि आद्ष्टानि।",["हैडेन-आम्रम्"],"आम्रम्",[]],["n","हैडेन इति नामकानाम् आम्राणां वृक्षः।","सम्प्रति हैडेन-आम्रे अल्पानि फलानि आगतानि।",["हैडेन-आम्रः"],"आम्रः",[]],["a","सुवर्णः वर्णयुक्तः।","एकः पुरुषः सौवर्णया स्त्रिया मुग्धः।",["सौवर्ण","हैम","काञ्चन","कानक","कनकमय","काञ्चनक","काञ्चनीय"],"",["ಚಿನ್ನದ ಬಣ್ಣದ","ಚಿನ್ನದ-ಬಣ್ಣದ","ಚಂದದ ಬಣ್ಣದ","ಒಳ್ಳೆಯ ಬಣ್ಣದ"]],["n","आन्ध्रप्रदेशस्य मण्डलविशेषः।","हैदराबादमण्डलस्य मुख्यालयः हैदराबादनगरे अस्ति।",["हैदराबादमण्डलम्"],"मण्डलम्",[]],["n","असमराज्ये वर्तमानम् एकं नगरम्।","ते स्वस्य हैलाकाण्डीनगरे वर्तमाने निवासस्थाने न मिलिताः।",["हैलाकाण्डीनगरम्"],"पुरम्",[]],["n","असमराज्ये वर्तमानम् एकं मण्डलम्।","हैलाकाण्डीमण्डलस्य मुख्यालयः हैलाकाण्डीनगरे अस्ति।",["हैलाकाण्डीमण्डलम्"],"मण्डलम्",[]],["n","पाकिस्तानदेशस्य दक्षिणदिशि वर्तमानं नगरम्।","हैदराबादनगरं सिन्धुनद्याः तटे स्थितम् अस्ति।",["हैदराबादनगरम्"],"पुरम्",[]],["n","नोआः पुत्रविशेषः।","हैमस्य वर्णनं बायबलग्रन्थे अस्ति।",["हैमः"],"मनुष्यः",[]],["n","हैहयवंशोत्पन्नः राजा यं परशुरामः जघान।","कार्तवीर्यः ख्यातः आसीत्।",["कार्तवीर्यः","हैहयः","दोःसहस्त्रभृत्","अर्जुनः","कार्तवीर्यार्जुनः"],"",[]],["n","क्षत्रियः वंशः यस्य जनकः राजा यदुः आसीत्।","सहस्त्रार्जुनः हैहयवंशे जातः।",["हैहयवंशः"],"कुलम्",[]],["n","जर्मनीदेशस्य द्वितीयक्रमाङ्कस्य बृहद् नगरम्।","रमेशः हैमबर्गनगरे अटनार्थं गतः।",["हैमबर्गनगरम्","हमबर्गनगरम्"],"पुरम्",["ಹೈಮಬರ್ಗ್","ಹಮಬರ್ಗ್"]],["n","यस्य किमपि विशिष्टम् उद्दिष्टं भवति ।","इमानि दानार्थं हैतुकानि वस्तूनि सन्ति ।",["हैतुक"],"",[]],["n","एकः पर्वतः ।","हैमस्य उल्लेखः महाभारते वर्तते",["हैमः"],"",[]],["n","एकः विद्यालयः ।","हैमवतस्य उल्लेखः बौद्धसाहित्ये अस्ति",["हैमवतः"],"",[]],["n","अष्टमः मासः ।","हैमवतः उल्लेखः सूर्यप्रज्ञप्तिः इत्यस्मिन् ग्रन्थे अस्ति",["हैमवत्"],"",[]],["n","एकः पर्वतः ।","हैमशैलस्य उल्लेखः विष्णुपुराणे अस्ति",["हैमशैलः"],"",[]],["n","एका स्त्री ।","हैमिन्याः उल्लेखः मार्कण्डेयपुराणे अस्ति",["हैमिनी"],"",[]],["n","एका नदी ।","हैरण्वत्याः उल्लेखः महाभारते अस्ति",["हैरण्वती"],"",[]],["n","एकः सम्प्रदायः ।","हैरम्बस्य उल्लेखः कोषे अस्ति",["हैरम्बः"],"",[]],["n","एकं काव्यम् ।","हैहयेन्द्रकाव्यस्य उल्लेखः कोषे अस्ति",["हैहयेन्द्रकाव्यम्"],"",[]]],"w":{"हैमनः":[0,7,9],"हैमन":[0,7,9],"हैमवती":[1,4,5,10],"हैयङ्गवीनम्":[2],"हैयङ्गवीन":[2],"हैयङ्गवीनकम्":[2],"हैयङ्गवीनक":[2],"हैमम्":[3],"हैम":[3,8,11,18,23,28],"हैडिम्बः":[6],"हैडिम्ब":[6],"हैमः":[11,23,28],"हैदराबादनगरम्":[12,22],"हैदराबादनगर":[12,22],"हैतुकत्वम्":[13],"हैतुकत्व":[13],"हैदरसाहेब-आम्रम्":[14],"हैदरसाहेब-आम्र":[14,15],"हैदरसाहेब-आम्रः":[15],"हैडेन-आम्रम्":[16],"हैडेन-आम्र":[16,17],"हैडेन-आम्रः":[17],"हैदराबादमण्डलम्":[19],"हैदराबादमण्डल":[19],"हैलाकाण्डीनगरम्":[20],"हैलाकाण्डीनगर":[20],"हैलाकाण्डीमण्डलम्":[21],"हैलाकाण्डीमण्डल":[21],"हैहयः":[24],"हैह