pp_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ನಾರಾಯಣ ನರಹರಿ ಪರಬ್ರಹ್ಮನಿರ್ವಿಕಾರಿ ಪ","ದ್ರುಕ್ ದೃಶ್ಯ ಮಧ್ಯದಲ್ಲಿ ಚೊಕ್ಕಟ್ಟಾಗಿರುವನಲ್ಲಿ","ಪ್ರಕಟವಾಗಿ ತ್ರಿಕೊಟ ನಿಜ ಸ್ಥಾನದಲ್ಲಿ ತೋರುವನಲ್ಲಿ","ಏನೊಂದು ತಿಳಿಯದದನೆ ತಾನೆಂದು ತಿಳಿಯಲವನೆ","ಧ್ಯಾನದರುವಿನಲ್ಲಿ ಮನ ತಾನೆ ಚಿನ್ಮೂರ್ತಿ ಘನ","ತನುವಿನೊಳ ಹೊರಗಿರ್ಪ ತನ್ನ ತಾನೆ ಕಾಣುತಿರ್ಪ","ಚಿನುಮಯಾತ್ಮ ಪರಂಜ್ಯೋತಿ ಘನಪರಾತ್ಪರ ಮೂರ್ತಿ","ಅಂತರಾತ್ಮ ಗುರು ಪೂರ್ಣನಂತ ಮಹಿಮ ನಾರಾಯಣ","ಸಂತ ಸಾಧು ಸಾಧ್ಯ ಜ್ಞಾನ ಶಾಂತಿ ಪಾಲಿಪ ಘನ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":188,"keerthana_id":12123,"category_raw":0,"favorite":false,"header_stripped":["ಶಾಂತಿಬಾಯಿ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"samtibayi__dasa1_12124","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ನಾರಾಯಣ ನಿನ್ನ","latin":"","iast":"nārāyaṇa ninna","devanagari":"नारायण निन्न"},"composer":"ಶಾಂತಿಬಾಯಿ","composer_iast":"śāṃtibāyi","deity":"","tags":["composer:ಶಾಂತಿಬಾಯಿ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ವೇದನಾಲ್ಕರ ಕದ್ದಂತಾದೈತ್ಯನ ಅಕ್ಷೌರುಷೇಯವಾದ","ನಾರಾಯಣ ನಿನ್ನ ಸ್ಮರಣೆಯಲಿ ಮನ","ಬೇರು ವೂರಿರುವಂತೆ ಕಾರುಣ್ಯದಲಿ ಕಾಯೊ ಪ","ವೇದನಾಲ್ಕರ ಕದ್ದಂಥಾ ದೈತ್ಯನ ಕೊಲ್ವಾ","ಶದಿ ಮತ್ಯಾವತಾರ ಧರಿಸಿದೆ ಹರಿಯೇ","ದೇವದಾನವರ ಮಥನದಿ ಮಂದರ ಪೊತ್ತೆ","ಭಾವಕಿಯಳ ಮೋಹಿಸಿ ಮೋಹಿನಿಯಾದೆ","ವರಹರೂಪದಿ ಪೋಗಿ ಧರೆಯನು ಧರಿಸಿದೆ","ದುರುಳ ಹಿರಣ್ಯಕನಕರದಿಂದ ಸೀಳಿದೆ","ಕಂದನ ನುಡಿಕೇಳಿ ಕಂಬದಿಂದುದಿಸಿದೆ","ತಂದೆಯ ಬಗೆದವನಾ ಛಂದದಿ ಸಲಹಿದೆ","ಬಲಿಯ ದಾನವ ಬೇಡಿ ನೆಲನ ಈರಡಿ ಮಾಡಿ","ತುಳಿದು ಆತನ ಮನೆ ಬಾಗಿಲ ಕಾಯ್ದೆಯೊ","ತಾತನ ಮಾತನು ಕೇಳಿ ಮಾತೆಯ ಕೊಂದೆ","ಖ್ಯಾತಿಯಿಂದಲಿ ಕ್ಷತ್ರಿಯರನು ಸಂಹರಿಸಿದೆ","ಮಾತೆಯ ವರ ಕೇಳಿ ನೀತಿಯಿಂದಲಿ ಪೋದೆ","ಸೇತುವೆ ಕಟ್ಟಿ ನೀಖ್ಯಾತರಾವಣನಕೊಂದೆ","ಪುಟ್ಟ ಶಿಶುವಾಗಿ ಗೋಪಿಗೆ ಮುದ್ದು ತೋರಿದೆ","ಬೊಟ್ಟಿಲಿ ಗಿರಿಯನು ನೆಗಹಿದೆ ಶ್ರೀ ಕೃಷ್ಣಾ","ತ್ರಿಪುರರ ಸತಿಯರ ವ್ರತವಗೆಡಿಸುವಂಥಾ","ಅಪರಿಮಿತದಿ ಮೋಹಿಸುವಾ ಮೂರ್ತಿಯಾದೆ","ಭಕ್ತವತ್ಸಲ ದೇವಾ ಯುಕ್ತಿಯಿಂದಲಿ ಕಾಯ್ವ","ವ್ಯಕ್ತಿ ಕಲ್ಕ್ಯಾವತಾರ ಧರಿಸಿದ ಹರಿಯೇ","ಶಬ್ದವ ನುಡಿಸುವ ಅಬ್ದಿನಿನ್ನದೊ ದೇವಾ","ಶಬ್ದವಾಲಿಸದ ನಿಶ್ಯಬ್ದದೊಳಿರಿಸೆನ್ನಾ","ಅಂತರದೊಳಗೆನ್ನಾ ಕಂತುನಾರಾಯಣಾ","ಸಂತಸದೊಳು ನಿಜ ಶಾಂತಿ ಪಾಲಿಪ ಗುರು"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":188,"keerthana_id":12124,"category_raw":0,"favorite":false,"header_stripped":["ಶಾಂತಿಬಾಯಿ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"samtibayi__dasa1_12125","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ನಾರಾಯಣಾ ಕರುಣಾ","latin":"","iast":"nārāyaṇā karuṇā","devanagari":"नारायणा करुणा"},"composer":"ಶಾಂತಿಬಾಯಿ","composer_iast":"śāṃtibāyi","deity":"","tags":["composer:ಶಾಂತಿಬಾಯಿ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ನಾರಾಯಣಾ ಕರುಣಾ ಘನಚರಣಕ್ಕೆರಗುವೇ","ಸ್ಮರಣೆಯೊಳಗೆ ಮನ ಒಲಿಯಿಸಿ ಪ್ರೇರಣೆ ಮಾಡುವಾ ಪ","ನನ್ನ ನಿಜವನರಿಯದೆ ನಾ","ಅನ್ಯ ಯೋನಿಯೊಳಗೆ ತಿರುಗಿ","ಬನ್ನ ಬಡುವುದನ್ನು ತಿಳಿದು","ನಿನ್ನ ಬಿಡೆನೆನ್ನೆ","ಭಾವಭಕ್ತಿಯಿಂದ ಪಿಡಿದು","ನೋಯದಂತರದೊಳಗಿಳಿದು","ಸಾವಧಾನದಿ ಸೇವೆಮಾಳ್ಪೆ","ಭಾವ ಬಲಿದು ನಾ","ಎಲ್ಲಿಯೂ ಪರಿಪೂರ್ಣ ನೀನೆ","ಸೊಲ್ಪಗೊಡಲಶಕ್ಯ ನಾನೈ","ಬಲ್ಲಿದವರಿಂದೆಲ್ಲಾ ಅರಿಶ","ಘುಲ್ಲನಾಭನೇ","ನಾದದ ಮೊದಲಿನ ಮೂಲದಿ","ಭೇದಭಾವವೆಲ್ಲ ಅಳಿದು","ಆದಿಶಾಂತಿ ಸುಖವನೀವ","ನಾದಿ ಶ್ರೀಗುರು"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":188,"keerthana_id":12125,"category_raw":0,"favorite":false,"header_stripped":["ಶಾಂತಿಬಾಯಿ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"samtibayi__dasa1_12126","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ನಿನ್ನ ಹೊರತು ಅನ್ಯರನರಿಯೆನೂ","latin":"","iast":"ninna hòratu anyaranariyènū","devanagari":"निन्न हॊरतु अन्यरनरियॆनू"},"composer":"ಶಾಂತಿಬಾಯಿ","composer_iast":"śāṃtibāyi","deity":"","tags":["composer:ಶಾಂತಿಬಾಯಿ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ನಿನ್ನ ಹೊರತು ಅನ್ಯರನರಿಯೆನೂ ಶ್ರೀ ವಾಸುದೇವಾ","ನಿನ್ನ ಹೊರತು ಅನ್ಯನರಿಯೆನೂ","ನಿನ್ನ ಹೊರತು ಅನ್ಯರರಿಯೆ ಪನ್ನಗೇಂದ್ರವಾಸ ಹರಿಯೆ","ಸನ್ನುತಾತ್ಮ ನಿಜವನಿತ್ತು ಪ್ರಸನ್ನ ಗುರುವರೇಂದ್ರ ದೇವಾ ಪ","ಉರಗನ್ಹೆಡೆಯ ನೆರಳ ಸ್ಥಿರವೆಂದು ಕಪ್ಪೆಯು ನಿಂತ","ತೆರದಿ ವಿಷಯದೊಳಗೆ ಬೆರದು ಬೆಂದೆನು ನಾ","ದುರಿತ ದುಷ್ಟಗಣದಿ ಹರಿದೂ ಮೃತ್ಯುವನೆ ಮರೆದು","ಅರಿವು ಮಾಯವಾಗಿರುವ ಎನ್ನಾ ಸ್ತರದ ಆತ್ಮಪ್ರಭೆಯ ಮರೆತು","ಇರುವ ಎನ್ನ ಮೇಲೆ ನಿನ್ನ ಕರುಣವಿಟ್ಟು ಕಾಯ್ದ ದೇವಾ","ತತ್ವವಿಂಶತಿ ನಾಲ್ಕು ಕೂಡಿದಾ ಈ ದೇಹದಲಿ ಏ","ಕತ್ವವಾಗಿ ಇದನೆ ನಂಬುತಾ ಮುನ್ನರಿಯದಲೆ ವಿ","ಚಿತ್ರವಾಸ್ತುವನ್ನು ಮರೆತು ಸತ್ತು ಹುಟ್ಟಿತೊಳಲಿ ಬಳಲಿ","ಕತ್ತೆಯಂತೆಯಿರುವ ಎನ್ನಾ ನಿತ್ಯ ನಿಜದೊಳಿಟ್ಟ ದೇವಾ","ಆದಿ ಮಧ್ಯ ಅಂತರಾಂತದಿ ತುಂಬಿರುವ ವಸ್ತು","ನಾದ ಬಿಂದು ಸ್ವಪ್ರಕಾಶದಿ ಹೃದಯದಲಿ ತೋರ್ಪ","ಭೇದಾತೀತ ನಿರ್ವಿಕಾರದಿ ಸುಬೋಧದಿ","ಆದರದಿ ಶಾಂತಿ ನಿಜದಾದಿ ಸುಖವನಿತ್ತ ಗುರು","ಪಾದಪದ್ಮ ನೆನೆದು ಪೂರ್ಣನಾದ ನಾರಾಯಣ ಪ್ರಭು"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":188,"keerthana_id":12126,"category_raw":0,"favorite":false,"header_stripped":["ಶಾಂತಿಬಾಯಿ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"samtibayi__dasa1_12127","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಪಾಲಯಮಾಂ ಶ್ರೀ ರಾಮಾ","latin":"","iast":"pālayamāṃ śrī rāmā","devanagari":"पालयमां श्री रामा"},"composer":"ಶಾಂತಿಬಾಯಿ","composer_iast":"śāṃtibāyi","deity":"","tags":["composer:ಶಾಂತಿಬಾಯಿ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಪಾಲಯಮಾಂ ಶ್ರೀ ರಾಮಾ ಮೂಲ ಸುಗುಣ ಶೀಲನೆ ಪ","ನೀಳ್ಗರೆವ ಹೃದಯನಿವಾಸಾ ಕಾಲಾಂತಕ ಕರ್ಮನಾಶಾ","ಚಾಳಿಕ ಚಿನ್ಮಯ ಸುರೇಶ ಹರೀ ಲೋಲಗುಣಾತೀತನೆ","ಚಂಡಕಿರಣ ಕುಲಜರಾಘವಾ ಸುಂದರಶ್ರೀ ಸೀತಾಧವಾ","ಛಂಧ ನಿಜಾನಂದ ವೀಯುವಾ ಬಂದಭಯನಿವಾರನೇ ನೀ","ದಶಮುಖರಾವಣ ನಿವಾರಣಾ ಅಸುರಾಸುರ ನಿಕ್ರಂದ ನಾ","ಕುಶಲ ವಿಭೀಷಣ ಪಾಲಯಸ್ವಾಮೀ","ಋಷಿಯಾಗವ ಕಾಯ್ದ ದೇವಾ","ಅಂಬುಜಾಕ್ಷಾನಂತರೂಪಾ ತುಂಬಿಹ ಸದ್ಗುರು ಸ್ವರೂಪಾ","ನಂಬಿದ ಭಕ್ತರನೆ ಪಾಲಿಪಾ ಚಿದಂಬರ ಶಾಂತಿದಾಯಕಾ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":188,"keerthana_id":12127,"category_raw":0,"favorite":false,"header_stripped":["ಶಾಂತಿಬಾಯಿ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"samtibayi__dasa1_12128","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಬಿಡಬ್ಯಾಡೆನಗೆ ಹರಿಯೇ","latin":"","iast":"biḍabyāḍènagè hariye","devanagari":"बिडब्याडॆनगॆ हरिये"},"composer":"ಶಾಂತಿಬಾಯಿ","composer_iast":"śāṃtibāyi","deity":"","tags":["composer:ಶಾಂತಿಬಾಯಿ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಬಿಡಬ್ಯಾಡೆನಗೆ ಹರಿಯೇ ತಡಮಾಡಲ್ಯಾಕೆ ದೊರೆಯೇ","ದಯಮಾಡಿ ಪೊರೆಯೋ ಇಂದು ಭಯ","ನಿವಾರನೇ ನೀ ಬಂದು ಪ","ಗಜರಾಜ ಪಶುವ ಹಿಂದೆ ಭಜಿಪಾಗ ನೀನೆ ಬಂದೆ","ನಿಜವಾಗಿ ನಕ್ರನೊದೆದು ಸುಜನನಾಥ ನೀ ಕರೆದೊಯ್ದು","ಪಾಂಚಾಳಿ ಸಭೆಯೊಳಂದು ವಂಚಕ ದುಶ್ಯಾಸನ ಬಂದು","ಮುಂಚಿತದಿ ಸೀರೆ ಎಳೆಯೆ ವಾಂಛಿತದಿ ಕಾಯ್ದ ಆ ಪರಿಯೇ","ಅಂದಾಗಲೂ ಪುತ್ರನನು ಕರೆದಾಗಲಜಾಮಿಳನು ಭರ","ದಿಂದ ಕಾಯ್ದೆ ಅವನಾ ಮರದ್ಯಾತಕೀಗಲೆನ್ನಾ","ಈ ಪರಿಯ ಕೀರ್ತಿ ಪಡದು ಕೋಪಿಸಲು ಬ್ಯಾಡ ಮರೆದು","ಶ್ರೀ ಪತಿಯೆ ಪದವನೀಯೋ ಉಪರಮೆ ಶಾಂತಿ ಕಾಯೋ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":188,"keerthana_id":12128,"category_raw":0,"favorite":false,"header_stripped":["ಶಾಂತಿಬಾಯಿ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"samtibayi__dasa1_12129","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಮನವೇ ನಿನ್ನಯ ನಿಜಮೂಲ","latin":"","iast":"manave ninnaya nijamūla","devanagari":"मनवे निन्नय निजमूल"},"composer":"ಶಾಂತಿಬಾಯಿ","composer_iast":"śāṃtibāyi","deity":"","tags":["composer:ಶಾಂತಿಬಾಯಿ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಆತ್ಮನಿವೇದನೆ","ಮನವೇ ನಿನ್ನಯ ನಿಜಮೂಲ ನೀನೋಡು","ಸಮರಸವನೆಗೂಡು || ಚಾಲ ||","ವಿಷಯವಾಸನೆಗಳ ನಿಶಿದು ಹೋಗಲಿ ಕುಳ","ಅಸಮ ಸಾಹಸಿಯಾಗಿ ನಿಜಸುಖದೊಳಗೆ ಪ","ಹಿಂದೆ ಬಹು ಜನ್ಮದೊಳು ನೀ ತೊಳಲಿ ವಾಸನೆಯೊಳು ಬಳಲಿ","ಇಂದೆ ನೀ ಬಂದೆ ನರಜನ್ಮದಲಿ ಎಚ್ಚರು ನಿನಗಿರಲಿ","ಮುಂದೆ ಸಿಕ್ಕುವ ನಿಜವಿಲ್ಲದರಲ್ಲಿ ಆ ನಿಮಿತ್ಯದಲೀ","ಸಂದೇಹಂಗಳ ಬಿಟ್ಟು ಸತ್ಪುರುಷರ ಹೊಂದಿ","ನಿಜದೊಳತಿ ಛಂದದಿ ನಿಲ್ಲೈ","ಗುರುಪಾದ ಕಮಲದ ಸೇವೆಯ ಮಾಡಿ ಇಷ್ಟಾರ್ಥವ ಬೇಡಿ","ದೃಢದೀ ಅದರಲ್ಲಿ ನಲಿನಲಿಹಾಡಿ ಸತ್ ಶಬ್ದವ ಗೂಡಿ","ಬಿಡದೇ ನಡುಮಾರ್ಗದಿಂ ಮುಂದೊಡೊ","ಮೂಧ್ರ್ನಿಯಲಿ ಲೋಲ್ಯಾಡಿ","ಸದಮಲ ನಿಜಸುಖ ಅದರಲಿ ನಿಲ್ಲುತ ಚದಲದೆ","ದೃಢತರವದಗಿ ನಿರಂತರ","ಭಕ್ತಿಭಾವವನೆ ದೃಢಮಾಡು ಸದ್ಧರ್ಮವಗೂಡು","ಯುಕ್ತಿಯಿಂದಲೀ ಸಾಧನೆಮಾಡು ಗುರುಪದದೊಳಗಾಡು ವಿ","ರಕ್ತಿ ನಿಜವಾಗಿ ಹುರಿಯನೆ ಮಾಡು ಸತ್ಸಂಗದೊಳಾಡು","ಸತ್ತನಾಗಿ ತೇಜೋಕ್ತ ಸದ್ಗುರು ವಚನೋಕ್ತಿಯಿಂದಲಿ","ಅನುರಕ್ತನಾಗಿ ನಿಜ","ಕಾಷ್ಠದೊಳಗಿಂದಾ ಅಗ್ನಿಯ ಪುಟ್ಟು ಕಾಷ್ಠವನೆ ಸುಟ್ಟು","ಉತ್ಕøಷ್ಟ ಚಿತ್ತವನೆ ಪುಟವಿಟ್ಟು ಜಡಭಾವನೆ ಬಿಟ್ಟು","ಥಟ್ಟನೇ ಜ್ಞಾನಾಗ್ನಿ ಪುಟವಿಟ್ಟು ಕ್ಷಡ್ರಿಪುಗಳ ಸುಟ್ಟು","ಶ್ರೇಷ್ಟ ಚಿಜ್ಯೋತಿಯಿಂದೆಸೆವ ನಾರಾಯಣ ದಿಟ್ಟ","ಸದ್ಗುರುವಿನೊಳ್ ಇಟ್ಟ ಶಾಂತಿ ನಿಜ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":188,"keerthana_id":12129,"category_raw":0,"favorite":false,"header_stripped":["ಶಾಂತಿಬಾಯಿ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"samtibayi__dasa1_12130","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಯಾವಾಗಲೂ ನಿನ್ನ ಸೇವೆಯೊಳಿರುವಂತೆ","latin":"","iast":"yāvāgalū ninna sevèyòḻiruvaṃtè","devanagari":"यावागलू निन्न सेवॆयॊळिरुवंतॆ"},"composer":"ಶಾಂತಿಬಾಯಿ","composer_iast":"śāṃtibāyi","deity":"","tags":["composer:ಶಾಂತಿಬಾಯಿ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಪುಂಡಲೀಕನ ಭಕ್ತಿಗೆ ಮೆಚ್ಚಿ","ಆತ್ಮನಿವೇದನೆ","ಯಾವಾಗಲೂ ನಿನ್ನ ಸೇವೆಯೊಳಿರುವಂತೆ","ಕಾವುದೆನ್ನಯ ನಿಜದೀ ಕೃಪಾನಿಧೇ","ಈ ಪರಿಯಿಂದನಾ ಭಾರಿ ಭವದಿ ನೊಂದೆ","ತೋರೋ ನಿನ್ನಯ ಚರಣಾ ನಾರಾಯಣ ಪ","ಆಶಾಪಾಶದಲಿ ನಾ ಘಾಸಿಯಾದೆನು ದೇವಾ","ವಾಸನೆಯೊಳು ತೊಳಲಿ ಬಹು ಬಳಲಿ","ವಾಸುದೇವನೆ ನಿನ್ನ ಪಾದದೊಳಗೆನ್ನಯ","ಬೇಸರದಲೆ ರಕ್ಷಿಸೋ ನಿಜಪಾಲಿಸೋ","ನೀರಮೇಲಿನ ಗುಳ್ಳೆಯಂತೆ ತೋರುವ ಕಾಯ","ಸೇರಿ ನಂಬಿದೆ ಭರದಿ ಬಹು ವಿಧದಿ","ದೂರನಾದೆನು ನಿಜದರಿವುನಾನರಿಯದೇ","ಸೇರಿಸೊ ನಿಜ ಸುಖದಿ ಪ್ರಬೋಧದಿ","ನಂಬಿದವರ ಕಾಯ್ವ ಸಂಭ್ರಮ ಪೊತ್ತವ","ಶಂಭು ಶಂಕರ ಪ್ರಿಯನೇ ಸರ್ವೇಶನೇ","ಇಂಬು ದೋರೆನ್ನಾ ಚಿದಂಬರ ನಿಜಪದ","ನಂಬಿ ನಿಲ್ಲುವ ತೆರದಿ ಸದೃಢದೀ","ತತ್ವಮಸಿ ಮಹಾ ವಾಕ್ಯವ ಶೋಧಿಸಿ","ನಿಸ್ತರಿಸುವ ಭವವಾ ಉಪಾಯವಾ","ಚಿತ್ತಚೈತನ್ಯವಾಗಿ ನಿತ್ಯಶಾಂತಿಸ್ವಸುಖ","ಸತ್ಯ ಸದ್ಗುರು ಸ್ವಾನಂದಾ ಸಹಜಾನಂದಾ","ಕಡಹದಾ ಮರನೇರಿ ಮಡುವಾ ಧುಮ್ಮಿಕೃಇದ್ಯೋ","ಪಿಡಿದು ಕಾಳಿಂಗನಾ ಹೆಡೆ ಕುಳಿದು ಕುಣಿದ್ಯೋ","ಸಡಗರದಿಂದಲಿ ಮಾತೆಯ ತೊಡೆಯ ಮೇಲೆ ಬಂದು ಕುಳಿತೆ","ದುರುಳ ದುಷ್ಟರ ಶಿರವ ಶರದಿಂದಾ ಕಡಿದೆಯೊ","ಶರಣ ಬಂದ ದೀನರನು ಸಲಹಿದೆಯೊ","ಪರಮ ಪುರುಷನೇ ನಿನ್ನ ಸ್ಮರಣೆಯೊಳಿರಿಸೆನ್ನಾ","ಅನ್ಯಾಯದಲಿ ಕುರುಪತಿಯ ಮಡುಹಿದೆಯೊ","ಕರ್ಣನ ಕಂಠವ ಕತ್ತರಿಸಿದೆಯೊ","ಧನ್ಯಧರ್ಮಾರ್ಜುನರ ಶಿರವಾ ಸನ್ಮತದಿಂದಲಿ ಕಾಯ್ದೆ","ಪುಂಡಲೀಕನ ಭಕ್ತಿಗೆ ಮೆಚ್ಚಿ","ಪಂಡರಪುರದಲ್ಲಿ ನಿಂತೆನಿ ಹೆಚ್ಚಿ","ತಂಡತಂಡದಲ್ಲಿ ಬರುವ ಹಿಂಡುಭಕ್ತರುಗಳ ಕೂಡುವ","ಅಂತರದೊಳಗೆನ್ನಾ ಕಂತು ನಾರಾಯಣ","ಶಾಂತಿ ಪದದಲಿ ವಿಶ್ರಾಂತಿಯ ಕೊಟ್ಟಿನ್ನಾ","ಭ್ರಾಂತಿಗಳನೆಲ್ಲ ತೋರಿಸಿ ಸಂತ ಸಂಗದೊಳಿರಿಸೆನ್ನಾ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":188,"keerthana_id":12130,"category_raw":0,"favorite":false,"header_stripped":["ಶಾಂತಿಬಾಯಿ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"samtibayi__dasa1_12131","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ರಾಮಾ ನಿನ್ನಯ ದಿವ್ಯ ನಾಮಾ","latin":"","iast":"rāmā ninnaya divya nāmā","devanagari":"रामा निन्नय दिव्य नामा"},"composer":"ಶಾಂತಿಬಾಯಿ","composer_iast":"śāṃtibāyi","deity":"","tags":["composer:ಶಾಂತಿಬಾಯಿ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ದಶರಥನುದರದಿ ಶಿಷುವಾಗಿ ಜನಿಸಿದೆ","ರಾಮಾ ನಿನ್ನಯ ದಿವ್ಯ ನಾಮಾ ನೆನೆವೆನು","ರಾಮಾ ನಿನ್ನಯ ದಿವ್ಯ ನಾಮಾ","ಪ್ರೇಮವ ಕೊಟ್ಟನ್ನಾ ನೇಮದೊಳಿರಿಸೊ ನೀ ಕರುಣದಿ ಪ","ಚಿತ್ತ ಶುದ್ಧವ ಮಾಡಿ ಮತ್ತೆ ನಿನ್ನಯ ಪಾದ","ನಿತ್ಯದಿ ನೆನೆವಂತೆ ಭಕ್ತಿಯೊಳಿರಿಸೊ ನೀ ಎನ್ನನು","ದಶರಥನುದರದಿ ಶಿಶುವಾಗಿ ಜನಿಸಿದೆ","ಹೊಸ ಆಭರಣವಿಟ್ಟು ಕುಶಲಮಾತೆಯನು ನೋಡುವ","ಛಂದದಿಂದಲಿ ಆನಂದದೊಳಿಹ ರಾಮಾ","ಚಂದ್ರನ ಮೊಗ ಅತಿ ಸುಂದರವಾಗಿರುವವನೇ","ಬಿಲ್ಲ ಬಾಣವಪಿಡಿದು ಎಲ್ಲಾ ದೈತ್ಯರ ಕೊಂದು","ಅಲ್ಲೇ ಕೌಶಿಕಯಾಗ ಎಲ್ಲ ಸಲಹಿದೆ ಧೀರನೇ","ವಿಥುಳಾಪುರದಿ ಬಂದು ಅತುಳ ಧನುವ ಮುರಿದು","ಸತಿ ಸೀತಾ ಸಹಗೂಡಿ ಪಿತನಾ ಪಟ್ಟಣವನು ಸೇರಿದೆ","ಮಾತೆಯ ವರ ಕೇಳಿ ನೀತಿಯಿಂದಲಿ ಅನು","ಜಾತನ ಒಡಗೂಡಿ ಖ್ಯಾತಿಯಿಂದಲಿ ಪೋದಂತಹ","ಸರಯು ತೀರದಿ ಬಂದು ಪುರದ ಜನರ ಬಿಟ್ಟು","ಭರದಿ ನಾವೆಯನೇರಿ ತ್ವರಿತದಿಂ ದಾಟಿ ನೀ ಪೋದೆ","ಭಕ್ತಿಯಿಂದಲಿ ಆ ಸಕ್ತ ಭರತನ ಕಂಡು","ಯುಕ್ತಿಯಿಂದಲಿ ತೇಜೋಯುಕ್ತಪಾದುಕವನು ಕೊಟ್ಟೆನೀ","ಪುಸಿಯತಿಯಾಗಿ ಶೀತೆಯ ಅಸುರ ಕೊಂಡೊಯ್ದನೆಂದು","ವ್ಯಸನದಿಂದಲಿ ಪೋಗಿ ಪಕ್ಷಿಯುದ್ಧರಿಸಿದೆ ಘಮ್ಮನೆ","ಶಾಂತಮೂರುತಿ ಹನುಮಂತರೆಲ್ಲರು ಕೂಡಿ","ಅಂತರದಲಿ ಸೇತು ನಿಂತು ನೋಡುವೆ ನೀ ಛಂದದಿ","ಶರಣ ಬಂದ್ವಿಭೀಷಣನ ಕರುಣದಿಂದಲಿ ಕಾಯ್ದೆ","ಸ್ಥಿರದಾಪಟ್ಟವಗಟ್ಟಿ ಹರುಷದೋಳ್ ನಿಲಿಸಿದೆ ಅವನನು","ವಾನರರೊಡಗೊಂಡು ಸೇನೆ ಸಹಿತಲೇ ದಶಾ","ನನ ರಾವಣನಕೊಂದು ಮಾನಿನೀ ಸಹಿತನೀ ಬಂದಿಹೆ","ಪುಷ್ಪಕವನೆ ಏರಿ ಅಕಸ್ಮಾತದಲಿ ಬಂದು","ಆಕ್ಷಣದಲಿ ಭರತ ರಕ್ಷಣ ಮಾಡಿದ ದೇವನೇ","ಪಟ್ಟಣದಲಿ ಮಾಹಾ ಪಟ್ಟವನೇರಿಸಿ","ಶಿಷ್ಟ ಅಯೋಧ್ಯೆಯ ಪಟ್ಟಣವಾಳಿದೆ ರಾಮನೆ","ಬ್ರಹ್ಮಮೂರುತಿ ರಾಮಾಗಮನ ಚರಣದಿ","ಸುಮ್ಮಾನದಲಿ ಶಾಂತಿ ತನ್ಮಯಗೊಳಿಸಾನಂದದಿ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":188,"keerthana_id":12131,"category_raw":0,"favorite":false,"header_stripped":["ಶಾಂತಿಬಾಯಿ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"samtibayi__dasa1_12132","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ವಾರಿಜನೇತ್ರೆಯ ಶಾರದೆ","latin":"","iast":"vārijanetrèya śāradè","devanagari":"वारिजनेत्रॆय शारदॆ"},"composer":"ಶಾಂತಿಬಾಯಿ","composer_iast":"śāṃtibāyi","deity":"","tags":["composer:ಶಾಂತಿಬಾಯಿ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಸರಸ್ವತಿ ದೇವಿ","ವಾರಿಜನೇತ್ರೆಯ ಶಾರದೆ ಶ್ರೀಮುಖ","ತೋರುವದೆನ್ನಯ ಪಾರ ಪರಾತ್ಪರೆ ಪ","ಮಯೂರ ವಾಹಿನಿ ಕಾಯುವುದೆನ್ನ","ತಾಯೆ ಚಿದ್ಛನ ನಿಜದಾಯುವ ನೀಯುವ","ಬಾಲೆಯ ಭಾಗ್ಯವಿಶಾಲೆಯ ನವಕುಸುಮ","ಮಾಲೆಯ ಗಾನವಿಲೋಲೆ ವಾಗೇಶ್ವರಿ","ಛಂಧದೊಳೆನ್ನ ಸಾನಂದವ ಪಾಲಿಪ","ಮಂದಮತಿಯ ತಿದ್ದಿ ಸುಂದರ ಮುಖಿಯೆ ನೀ","ನಂಬಿಕೆ ಹೊಂದಿಹನೆಂಬುವ ಭಕ್ತರ","ಇಂಬುಗಳನ್ನೆ ಕೊಟ್ಟು ಬೆಂಬಲಕಿರ್ಪಳೆ","ಕಂತು ಬ್ರಹ್ಮನರಾಣಿ ಅಂತರಿಕ್ಷಣೆವಾಣಿ","ಶಾಂತಿ ಸದ್ಗುರುಪದ ಸಂತಸಕಾರಿಣಿ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":188,"keerthana_id":12132,"category_raw":0,"favorite":false,"header_stripped":["ಶಾಂತಿಬಾಯಿ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"samtibayi__dasa1_12133","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ವೇಣುಗೋಪಾಲ ನಿನ್ನ ಜಾಣತನವ","latin":"","iast":"veṇugopāla ninna jāṇatanava","devanagari":"वेणुगोपाल निन्न जाणतनव"},"composer":"ಶಾಂತಿಬಾಯಿ","composer_iast":"śāṃtibāyi","deity":"","tags":["composer:ಶಾಂತಿಬಾಯಿ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಗೋಪಿ : ವೇಣುಗೋಪಾಲ ನಿನ್ನ ಜಾಣತನವ ಬಿಡು ಬಿಡು","ಕಾಣದರ್ಮನೆಯ ಸೇರಿ ತ್ರಾಣ ಬಲಹರಣವ","ಮಾಡುವೇಜಾಣ ಪ","ಕೃಷ್ಣ : ನೀರೆ ಗೋಪಿಯೆ ನಿನ್ನ ದ್ವಾರದೊಳಿರುವೆ","ತೋರದೆನ್ನನು ನೀನು ಭಾರಿ ಬಳಲಿರುವೆ ನೀರೆ","ಗೋಪಿ : ಹತ್ತಿರದಲ್ಲಿದ್ದು ನೀನು ಇತ್ತೆನಗೆ ತೋರದಂತೆ","ಚಿತ್ತ ಬೋರ್ಗರೆಳುಕೃಷ್ಣ ಮತ್ತೆನಾ ಬಿಡುವೆನೆ","ನಿನ್ನನು ``ವೇಣು","ಕೃಷ್ಣ : ಅಕ್ಷಿಯೊಳಗೆ ನಿನ್ನ ಸಾಕ್ಷಿಯಾಗಿರುವೆ","ಈಕ್ಷಿಸಲರಿಯೆ ನೀ ಕುಕ್ಷಿ ತುಂಬಿರುನೆ | ನೀರೆ","ಗೋಪಿ : ಆರು ಬಾಗಿಲು ನೀಗಿ ಜೋರಗಂಡಿಯೊಳ್ ಪೋಗಿ","ಏರಿ ಮೇಲಣ ತುದಿಯೋಳ್ ಸಾರಿ ಸಕಲಧ್ವನಿಗಳ","ಮಾಡುವೆ ||ವೇಣು||","ಕೃಷ್ಣ : ಮನುಮುನಿ ಜನರೆಲ್ಲಾ ವಿನಯದಿಂ ಪಿಡಿದು","ಘನಸುಖ ಪಡುವರು ಮನದೊಳಗರಿದು ||ನೀರೆ||","ಗೋಪಿ : ಆಗಮ ಸಂಚಿತ್ತ ಭೋಗ ಸಂಸಾರವನ್ನೆಲ್ಲಾ","ನೀಗಿಸುವೆ ನೀನವರಾ ಯೋಗೀ","ಜರೆನಿಸಿದೆಲ್ಲಾ ||ವೇಣು ||","ಕೃಷ್ಣ : ನಿಮಿಷ ಮಾತ್ರದಿ ಸುಖವ ಮನದೇಸ್ಮರಿಸಿ","ಅಮಮ ಘನಾನಂದ ರಮಿಸು ಸ್ವಸುಖವಿ ||ನೀರೆ||","ಗೋಪಿ : ಕಣ್ಣ ಸನ್ನೆಯ ಮಾಡಿ ಅನ್ಯರ್ಮನ್ಮನೆಗಳಲ್ಯೋಡಿ","ಬೆಣ್ಣೆ ಪಾಲುಮೊಸರು ಸುರಿದು ಬನ್ನಣೆ","ಮಾತುಗಳಾಡುವೆ ||ವೇಣು ||","ಕೃಷ್ಣ : ಧೊರೆಯಾಗಿರುವೆ ನಾನು ತಿರಿದುಣ್ಣಲರಿಯೆ","ಬೆರತು ಎನ್ನೊಳು ನೀನು","ಅರಿವಿನಿಂದರಿಯೆ || ನೀರೆ||","ಗೋಪಿ : ಕಂತು ಪಿತನೆ ನಿನ್ನ ಭ್ರಾಂತಿ ಹತ್ತಿತು ಎನಗೆ","ಸಂತಸದೊಳು ನಿಜ ಶಾಂತಿಪಾಲಿಪ","ಗುರುವರ ||ವೇಣು ||"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":188,"keerthana_id":12133,"category_raw":0,"favorite":false,"header_stripped":["ಶಾಂತಿಬಾಯಿ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"samtibayi__dasa1_12134","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ವೈಕುಂಠವಾಸಿ ನಾರಾಯಣಗೆ","latin":"","iast":"vaikuṃṭhavāsi nārāyaṇagè","devanagari":"वैकुंठवासि नारायणगॆ"},"composer":"ಶಾಂತಿಬಾಯಿ","composer_iast":"śāṃtibāyi","deity":"","tags":["composer:ಶಾಂತಿಬಾಯಿ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಗಜಸುರ ವರನಿತ್ತು ಗಜಚರ್ಮಧಾರU","ವೈಕುಂಠವಾಸಿ ನಾರಾಯಣಗೆ ನೀಲಕಂಠ ವಿಶ್ವೇಶ್ವರಗೆ","ಬಾಲೆ ದ್ರೌಪದಿ ಅಭಿಮಾನವ ಕಾಯ್ದಗೆ","ಭಾಳಲೋಚನ ಭವಹಾರಕಗೆ","ಮಂಗಲಂ ಜಯ ಮಂಗಲಂ ಪ","ವಾಸುಕಿ ಫಣಿವರ ಭೂಷಿತಗೆ ಶೇಷ ಪರೀಯಂಕ ವಾಸನಿಗೆ","ಭಾಸ ಸರ್ವಾಂತರ ವಾಸ ಜಗದೀಶಗೆ","ತೋಷಪಾಲಕ ವಾಸುದೇವನಿಗೆ","ಮಂಗಲಂ ಜಯ ಮಂಗಲಂ","ಗಿರಿವರ ಬಿರುಳಲಿ ನೆಗಹಿದಗೆ ತರಳೆಗಂಗಾ ಜಲಧಾರನಿಗೆ","ಶರಧಿಗೆ ಸೇತು ಕಟ್ಟಿದ ಶ್ರೀರಾಮಗೆ","ಪರಮ ಪುರುಷ ವಿಶ್ವೇಶ್ವರಿಗೆ","ಮಂಗಲಂ ಜಯ ಮಂಗಲಂ","ಗಜಾಸುದ ವರವಿತ್ತ ಗಜಚರ್ಮಧಾರಗೆ","ಗಜರಾಜನ ಕಾಯ್ದ ಗೋವಿಂದಗೆ","ಗಜವದನನ ಪಿತ ಗೌರೀರ ಮಣಗೆ","ಅಜಪಿತನಾದ ನಾರಾಯಣಗೆ","ಮಂಗಲಂ ಜಯ ಮಂಗಲಂ","ಶಂಖಚಕ್ರಧರ ಶಂಕರ ಪ್ರಿಯಗೆ ಪಂಕಜಾಂಬಕ ವಿಷ್ಣು ವಲ್ಲಭಗೆ","ಶಂಕರ ನಿಜಪದ ಶಾಂತಿಪಾಲಿಪಗುರು","ರಂಗರಕ್ಷಕ ಮಹಾಬಲೇಶ್ವರಗೆ","ಮಂಗಲಂ ಜಯ ಮಂಗಲಂ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":188,"keerthana_id":12134,"category_raw":0,"favorite":false,"header_stripped":["ಶಾಂತಿಬಾಯಿ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"samtibayi__dasa1_12135","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಶಂಕರನೇ ಸೌಖ್ಯದಾತ ಸಂಕಟ","latin":"","iast":"śaṃkarane saukhyadāta saṃkaṭa","devanagari":"शंकरने सौख्यदात संकट"},"composer":"ಶಾಂತಿಬಾಯಿ","composer_iast":"śāṃtibāyi","deity":"","tags":["composer:ಶಾಂತಿಬಾಯಿ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಶಿವಸ್ತುತಿ","ಶಂಕರನೇ ಸೌಖ್ಯದಾತ ಸಂಕಟ ನಿವಾರಣ ಶಿವ ಪ","ತನುಮನಕಾಧಾರನಾದ ಘನಪರಾನಂದಾರ್ತ","ವಿನಂಯದಿಂದ ನೋಡಲಕ್ಷ ಚಿನುಮಯಾತ್ಮನೇ ನೀ","ಚಿದ್ದಿಲಾಸ ಜಗವಿದೆಲ್ಲಾ ಅದ್ವಯಾನಂದಾಖ್ಯನೇ","ಸಿದ್ಧನಾಗಿ ತೋರುತಿರುವಬಿದ್ರೂಪಾರ್ತನೇ ನೀ","ವಾಗ್ಮನಗೋಚರನೇ ಸಂಗರಹಿತ ಸ್ವಪ್ರಕಾಶ","ಮಂಗಳಾತ್ಮ ಜ್ಯೋತಿರ್ಮಯ ಗಂಗಾಧರನೇ ನೀ","ಅಂತರಾನಂದಾರ್ತ ಜ್ಞಾನ ಸಂತ ಸಾದು ಸಾಧ್ಯನೇ","ಶಾಂತಿ ಪದವನಿತ್ತ ಗುರು ಶಾಂತರೂಪನೇ ನೀ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":188,"keerthana_id":12135,"category_raw":0,"favorite":false,"header_stripped":["ಶಾಂತಿಬಾಯಿ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"samtibayi__dasa1_12136","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಶ್ರೀ ಗೌರೀವರೇಂದ್ರನೇ ನಮೋ","latin":"","iast":"śrī gaurīvareṃdrane namo","devanagari":"श्री गौरीवरेंद्रने नमो"},"composer":"ಶಾಂತಿಬಾಯಿ","composer_iast":"śāṃtibāyi","deity":"","tags":["composer:ಶಾಂತಿಬಾಯಿ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಶ್ರೀ ಗೌರೀವರೇಂದ್ರನೇ ನಮೋ ನಮೋ ನಮೋ","ಯೋಗಮಯನೆ ಭೋಗದಯನೆ ನಾಗಾಭರಣನೆ","ಭೋಗೀ ಭೂಷಣ ವ್ಯಾಘ್ರವಸನನೆ ಪ","ವಾಸುದೇವ ಪ್ರಿಯನೇ ಸದಾ ಶಿವಾ ಶಿವಾ","ಶಶಾಂಕಧರನೇ ಕ್ಲೇಷಹಾರನೇ ದೋಷನಾಶನೇ","ಭಾಸುರ ಪ್ರಕಾಶಾ ತೋಷದಾತನೇ","ಪಂಚ ಪ್ರಾಣಧಾರನೇ ಪರಾತ್ಪರಾವರಾ","ಸಂಚಿತ ಅಘದೋಷಹರಣ ಸರ್ವಸುಖಕರಾ","ಪಂಚವದನಾ ಪಂಚಶರಹರಾ","ಜ್ಞಾನಮಯ ಸುಚೇತನಾ ಕೃತಾಘನಾವನಾ","ಸ್ವಾನುಭವ ಸ್ವಶಾಂತಿದಾತ ಧ್ಯಾನಿಪಾಜನಾ","ದೀನೋದ್ಧಾರಕಾ ವಿಜ್ಞಾನಮಯನೇ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":188,"keerthana_id":12136,"category_raw":0,"favorite":false,"header_stripped":["ಶಾಂತಿಬಾಯಿ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"samtibayi__dasa1_12137","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಹರಹರ ವಿಶ್ವೇಶ್ವರ","latin":"","iast":"harahara viśveśvara","devanagari":"हरहर विश्वेश्वर"},"composer":"ಶಾಂತಿಬಾಯಿ","composer_iast":"śāṃtibāyi","deity":"","tags":["composer:ಶಾಂತಿಬಾಯಿ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಹರಹರ ವಿಶ್ವೇಶ್ವರ ಕರುಣಾಕರ","ಪರಮ ಪುರುಷ ದೇವಾ","ಚರಾಚರವ ತುಂಬಿಭರಿತವಾಗಿ","ಸ್ಮರಿಸುವ ಭಕ್ತರ ತ್ವರಿತದಿ ಪಾಲಿಪ ಪ","ಗಜಾಸುರನೆಂತೆಂಬ ದನುಜನ","ವಿಜಯನಾಗಿ ತೊಗಲನ್ನು ಪೊತ್ತೆ","ಭುಜಗ ಭೂಷಣ ನೀ ಸುಜನರ ಪಾಲಿಪ","ನಿಜಾನಂದವ ನೀವಾ ಚಿನ್ಮಯನೇ","ತನುಮನದೊಳಗೆಲ್ಲಾ ಹೊಳೆಯುತಲಿರ್ಪಾ","ಜನಜನಿತಳಲ್ಲಿ ಪ್ರಣವರೂಪನಾದ","ತುಂಬುತ್ತಾ ತುಳುಕುತ್ತಾ","ಘನಪರಮಾನಂದಾ ಸಚ್ಚಿದ್ರೂಪಾ","ಒಳಹೊರಗೆಂಬೀ ಭೇದಗಳೆಲ್ಲವ (ಹೊರಗೆ ಒಳಗೆ)","ಹರಣ ಮಾಡುತಿರ್ಪಾ","ಹರನೇ ನಾನೀನಾದ ಕಾರಣ","ಬೆರತು ನಿನ್ನೊಳು ಸ್ಮರಿಸುವೆ ಭರದಿ","ಚಿಂತೆಗಳೆಲ್ಲವನೀಗೆ ನಿಜಾನಂದ","ಸಂತಸಗಳನೀವಾ","ಅಂತವಿಲ್ಲದಾನಂತ ಪರಾತ್ಪರ","ಶಾಂತಿ ಪದವನೀವ ಮಹಾದೇವಾ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":188,"keerthana_id":12137,"category_raw":0,"favorite":false,"header_stripped":["ಶಾಂತಿಬಾಯಿ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"samtibayi__dasa1_12138","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಹರಿಗೋವಿಂದ ಗೋಪಾಲ","latin":"","iast":"harigoviṃda gopāla","devanagari":"हरिगोविंद गोपाल"},"composer":"ಶಾಂತಿಬಾಯಿ","composer_iast":"śāṃtibāyi","deity":"","tags":["composer:ಶಾಂತಿಬಾಯಿ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಮಾನಿನಿ ದ್ರೌಪತಿಯ ಮಾನವಕಾಯ್ದೆ","ಹರಿಗೋವಿಂದ ಗೋಪಾಲ ಮುಕುಂದನೆ ಕರವ ಮುಗಿವೆ","ಚರಣಕ್ಕೆರಗುವೆ ಭರದಿ ರಕ್ಷಿಸು ಬಿಡದೇ ಶ್ರೀ ಪ","ಮಾನಿನಿ ದ್ರೌಪದಿ ಮಾನವ ಕಾಯ್ದೆಯೊ","ಹೀನರ ಮದಗರ್ವವನೆಲ್ಲ ಅಳಿದೆಯೊ","ಧ್ಯಾನ ಮಾಡುವ ಸ್ವಾನುಭವಿಗಳ","ಸ್ಥಾನ ಹೃದಯವಾಸ ಶ್ರೀ","ಧ್ಯಾನಿಸಿವಂಥಾ ಗಜರಾಜನ ಕಾಯ್ದೆ","ಮಾನಿನಿ ಅಹಲ್ಯೆಯ ಪಾದದೊಳುದ್ಧರಿಸಿದೆ","ದೀನರಕ್ಷಕ ಬಿರುದ ಪೊತ್ತ ವಿ","ಜ್ಞಾನದೊಳಗಿರಿಸೆನ್ನಾ","ಶಬರಿಯ ಭಕ್ತಿಗೆ ಮೆಚ್ಚನೀ ಬಂದೆಯೊ","ಬದರಿಯ ಹಣ್ಣನೆ ಸವಿಸವಿ ದುಂಡೆಯೊ","ವಿಭು ಪರಮಾನಂದಾ ಪ್ರಭೆಯೊಳಗಿರಿಸಿದೆ","ಸ್ವರ್ಣಕಶ್ಯಪನ ಸೊಕ್ಕಗಿಸಿದೆ ದೇವಾ","ಮನ್ನಿಸಿ ಪಾಂಡವರೈವರ ಸಲಹುವಾ","ಚನ್ನ ಗೋಪಿಯರ ಕೂಡಿ ಮನ್ನಣೆಕ್ರೀಡೆಯ ನಾಡಿ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":188,"keerthana_id":12138,"category_raw":0,"favorite":false,"header_stripped":["ಶಾಂತಿಬಾಯಿ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"samtibayi__dasa1_12139","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಹರಿಬಾಬು ರಾಮಚಂದ್ರ","latin":"","iast":"haribābu rāmacaṃdra","devanagari":"हरिबाबु रामचंद्र"},"composer":"ಶಾಂತಿಬಾಯಿ","composer_iast":"śāṃtibāyi","deity":"","tags":["composer:ಶಾಂತಿಬಾಯಿ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಹರಿಬಾಬು ರಾಮಚಂದ್ರ ಶೀತಾಪತೇ ಪ","ದಶರಥನುದರದೊಳ್ ಶಿಶುವಾಗಿ ಪುಟ್ಟಿದೆ","ದಶಕಂಠನಾಶನೇ ನೀನೆವೋಹರಿ ಶೀತಾಪತೇ","ತಾಪತ್ರಯಗಳಿಂದ ಪಾಪಿಯಾಗಿಹೆ ನಾನು","ತಾಪವಿದಾರನೇ ನೀನೇವೋಹರಿ ಶೀತಾಪತೇ","ವಾಸುದೇವನೇ ನೀನು ದಾಸರ ಸಲಹುವ","ಭೂಷಣ ಪೋಷಿಪ ನೀನೇವೋಹರಿ","ಆಶಾಪಾಶಗಳಿಂದ ಘಾಶಿಯಾದೆನು ನಾನು","ದೋಷವಿದಾರನೇ ನೀನೇವೋಹರಿ","ಶಾಂತಿಪದದಲಿ ವಿಶ್ರಾಂತಿ ಕೊಟ್ಟಿನ್ನಾ","ಭ್ರಾಂತಿಯ ತೋರಿಸುವ ನೀನೇವೋಹರಿ ಶೀತಾಪತೇ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":188,"keerthana_id":12139,"category_raw":0,"favorite":false,"header_stripped":["ಶಾಂತಿಬಾಯಿ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"samtibayi__dasa1_12140","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಹೃದಯ ವೃಂದಾವನದೊಳಿರು","latin":"","iast":"hṛdaya vṛṃdāvanadòḻiru","devanagari":"हृदय वृंदावनदॊळिरु"},"composer":"ಶಾಂತಿಬಾಯಿ","composer_iast":"śāṃtibāyi","deity":"","tags":["composer:ಶಾಂತಿಬಾಯಿ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಹೃದಯ ವೃಂದಾವನದೊಳಿರುವ ಕೃಷ್ಣನ","ಸಾಧಿಸಿ ನೋಡ್ವೆನೆಂದು ಪೋದರು ಗೋಪಾಂಗನಾ ಪ","ನಾದದ ಕೊಳಲನ್ನು ಊದುವ ವೇಳ್ಯದಿ","ಸದ್ಭಕ್ತಿವೆತ್ತಿಗೋಪಾಂಗನಾ ವಿನೋದದಿ","ಆಧಾರ ಮಾರ್ಗದಿಂದಾ ಪೋದರು ಬೇಗದಿ","ಶೋಧಿಸಿ ನೋಡಲಾಗಿ ತ್ಯಾಗಿಸಿ ಕಾಮನಾ","ಉಬ್ಬೇರಿ ಮೆಲ್ಭಾಗದಿಂದಾ ವಿನೋದದಿ","ಅಬ್ಬರದಿಂದಲೀ ಆ ಷಟದ್ವಾರ ಭೇದದಿ","ಗರ್ಭಿತನಾದ ರಾಜಹಂಸೊಹಂಸ್ವರದಿ","ಮುಬ್ಬರದಿಂದಲಿ ಪಾಡುತ್ತಾ ರಂಗನ","ನಳಿನ ಚಂಪಕಾದಿ ನಾಗ ಪುನ್ನಾಗವು","ಪಾಟಲ ಶಾವಂತಿಗೀ ಕುಂದ ಬಕುಲವು","ಮಾಲತಿ ಜಾಜಿ ಹೂವು ಶ್ರಿಲೋಲನಾಮವೂ","ಮೇಳಿತವಾಗಿ ಪೋಗಿ ಏರಿದರು ಸುಮನಾ","ಶ್ರೀ ಮನೋಹರ ಮೂರ್ತಿ ಸಂಗೀತ ಕೇಳುತಾ","ಆ ಮಹಾ ಮಕುಟದಾ ಬೆಳಕು ನೋಡುತಾ","ಶ್ರೀ ಗುರುಮಹಾದೇವನೊಳ್ ರಮಿಸಿ ಸೂಸದಾ","ಪ್ರೇಮದಿ ಶಾಂತಿ ಸುಖದೊಳ್ ಬೆರತು ಸಘನಾ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":188,"keerthana_id":12140,"category_raw":0,"favorite":false,"header_stripped":["ಶಾಂತಿಬಾಯಿ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"samtibayi__dasa1_12141","form":"devaranama","form_confidence":"sampled, consistent structured header (song/singer/raga/tala/style)","title":{"kn":"ಕಂಗಳಿದ್ಯಾತಕೋ ಚಿನುಮಯ","latin":"","iast":"kaṃgaḻidyātako cinumaya","devanagari":"कंगळिद्यातको चिनुमय"},"composer":"ಶಾಂತಿಬಾಯಿ","composer_iast":"śāṃtibāyi","deity":"","tags":["composer:ಶಾಂತಿಬಾಯಿ","source:android_app_local:dasa1","category_raw:4","form:devaranama","rendition:studio_recording"],"raga":"","tala":"","singer":"ಸತ್ಯವತಿ ಟಿ. ಎಸ್.","style":"","music_director":"ಶ್ರೀಕಂಠನ್ ಆರ್. ಕೆ.","studio":"ಅಶ್ವಿನಿ ಸ್ಟುಡಿಯೊ, ಬೆಂಗಳೂರು","language":"kn","text":{"kannada":[["ಕಂಗಳಿದ್ಯಾತಕೋ ಚಿನುಮಯ","ಕಂಗಳಿದ್ಯಾತಕೋ ಚಿನುಮಯ ರಂಗನ ನೋಡದಾ","ಕಂಗಳೊಳಗೆ ಮಂಗಳ ಮೂರುತಿ","ಸಂಗರಹಿತಾತ್ಮನ ನೋಡದಾ ಪ","ಶರೀರವೇ ತಾನೆಂದು ನಂಬಿ ಮೆರೆದು ನಿಜಾನಂದವನ್ನು","ಬೆರದು ವಿಷಯಾದಿಗಳಲ್ಲಿ ಹರಿದು","ದೃಷ್ಯಂಗಳನ್ನು ನೋಡುವಾ","ತಾನಿದ್ಯಾರು ತನಗೆ ತೋರ್ಪ ತನುವಿದೇನೆಂದರಿವುತಿರ್ಪ","ಜ್ಞಾನದೃಷ್ಟಿಯಿಲ್ಲದಂಥ ಆನನಂಗಳನು ನೋಡುವ","ಹಂಸ ತಾನಾಗಿ ಚರಿಪ ಹಂಸನ ಪ್ರಕಾಶವನ್ನು","ಶುಂಶುಮಾರದಿ ಬೆಳಗುತಿರ್ಪಭ್ರಂಶಿತಾಂ ತನ್ನ ನೋಡದಾ","ಸಂತಸಾಧು ಚರಣಕ್ಕೆರಗಿ ಚಿಂತೆಗಳನು ಹರಿದು ಭರದಿ","ಶಾಂತಿ ಸುಖವನಿತ್ತ ಗುರು ಶಾಂತಮೂರುತಿ ನೋಡಲಾರದ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":188,"keerthana_id":12141,"category_raw":4,"favorite":false,"header_stripped":["ನಿರ್ಗಮನ"],"unclassified_lines":[],"is_recorded_rendition":true},"_needs_review":false,"also_at":[]}]}