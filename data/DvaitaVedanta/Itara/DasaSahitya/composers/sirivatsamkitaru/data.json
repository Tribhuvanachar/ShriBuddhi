ಾರಗಾಣಿಸು ಬೇಗ ಶ್ರೀ ರಾಮದೇವ","ದಶರxಸುತ ನೀನು ಶಶಿಮುಖಕಾಂತನು","ಶಶಿಧರನುತನೀ ಅಪಮಸಾಹಸನೊ","ಮೂರಾವತ್ಸೇಗಳಲ್ಯು ದೂರಾಪೋಗದೆ ನೀ","ಕಾರುಣ್ಯದಿಂದ ಯೆನ್ನ ಶೇರಿರು ಹರುಷದಿ","ಸಿರಿವತ್ಸಾಂಕಿತ ನೀನು ತರಣಿಸುತನ ಸರವ","ಕರಕರೆ ಬಿಡಿಸಲು ಸುರರ ವೃಂದವ ಬಿಟ್ಟು"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":90,"keerthana_id":12999,"category_raw":0,"favorite":false,"header_stripped":["ಸಿರಿವತ್ಸಾಂಕಿತರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"sirivatsamkitaru__dasa1_13000","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಜಯ ಜಯವೆಂಬೆ","latin":"","iast":"jaya jayavèṃbè","devanagari":"जय जयवॆंबॆ"},"composer":"ಸಿರಿವತ್ಸಾಂಕಿತರು","composer_iast":"sirivatsāṃkitaru","deity":"","tags":["composer:ಸಿರಿವತ್ಸಾಂಕಿತರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಜಯ ಜಯವೆಂಬೆ ನಾನು ಶ್ರೀವರ ನಿನಗೆ ಪ","ಜಯವೆಂಬೆ ಶ್ರೀವರನೆ ಭಯ ದೋಷವರ್ಜಿತನೆ","ಅಯನ ವತ್ಸರಗಳೆಂಬ ನಿಯಮವು ಇಲ್ಲದವನೆ ಅ.ಪ.","ಕಾಲನಾಮಕ ನೀನು ಕಾಲನಾಮಕ ಚಕ್ರ ಸಾಲಾಗಿ","ತಿರುಗಿಣಿ ಪಾಲಿಸುವಿ","ಪಾಲಗಡಲಿನಲ್ಲಿ ಆಲದೆಲೆಯಮೇಲೆ ಕಾಲನು","ನೀಡಿ ನೀ ಮಲಗಿರುವಿ","ಸೃಷ್ಟಿಕರ್ತನು ಸೃಷ್ಟಿಪಾಲಕ ನೀನು ಶಿಷ್ಟ ಜನರಭಿಪ್ರದ ನೀನು","ಕಷ್ಟಲೇಶವಿಲ್ಲದೆ ಶಿಷ್ಟ ಜನರುಗಳರಿಷ್ಟವೆಲ್ಲವ ನೀ ಕಟ್ಟಿ ಕೆಡಹುವಿ","ಭೂವಲಯದಿ ಭವನಾವಿಕನೆ ಯನ್ನ ನಾನೀಪರಿಯಲಿ ನೀಯೋ","ಶ್ರೀವಾಸುದೇವನೆ ಭಾವಜನಯ್ಯನೆ ಕಾವ ಭಕ್ತರ","ದೇವ ಶ್ರೀವತ್ಸಾಂಕಿತನೆ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":90,"keerthana_id":13000,"category_raw":0,"favorite":false,"header_stripped":