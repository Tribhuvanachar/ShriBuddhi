 ಮುನಿನುತ ದೇವನೀ","ವನರುಹದಳನೇತ್ರ ಅನಿಮಿಷರೊಡೆಯ","ದುಷ್ಟ ಜನರುಗಳರಿಷ್ಟಗೋಸುಗ","ಶಿಷ್ಟ್ಟಿಲಿ ಬಂದು ಸುಜನೇಷ್ಟಪ್ರದನಾದಿ","ಶಿರಿವತ್ಸಾಂಕಿತ ನಿನ್ನ ಚರಣಕಮಲದಲ್ಲಿ","ನಿರುತ ಭಕುತಿಯಿತ್ತು ಪೊರಿಯುತ ಸರ್ವದಾ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":90,"keerthana_id":13009,"category_raw":0,"favorite":false,"header_stripped":["ಸಿರಿವತ್ಸಾಂಕಿತರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"sirivatsamkitaru__dasa1_13010","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಶಾಮಸುಂದರನೆ ನೀನು","latin":"","iast":"śāmasuṃdaranè nīnu","devanagari":"शामसुंदरनॆ नीनु"},"composer":"ಸಿರಿವತ್ಸಾಂಕಿತರು","composer_iast":"sirivatsāṃkitaru","deity":"","tags":["composer:ಸಿರಿವತ್ಸಾಂಕಿತರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಶಾಮಸುಂದರನೆ ನೀನು ಪ್ರೇಮಾದಿ ಕಾಯೊ ಪ","ಧರೆಯೊಳು ನಾ ಬಂದು ಥರಥರದಲ್ಲಿ ನೊಂದು","ಮರುಗಿದೆ ತೋರ್ನಿನ್ನ ಚರಣಕಮಲವಾ","ಅನ್ಯನೆಂದರಿಯದೆ ನಿನ್ನವನೆಂದೆನ್ನ","ಮನ್ನಿಸಿ ಈಗಲೇ ಬನ್ನ ಬಿಡಿಸು ಬಾರೋ","ಶ್ರೀವತ್ಸಾಂಕಿತ ನೀನು ಶರಣಾಗತ ನಾನು","ಪೊರೆಯದೆ ಬಿಡುವದು ಥರವಲ್ಲ ಶ್ರೀಹರಿ","ಸರಸಿಜನಯನ ಬ್ಯಾಗ ಬಾರೊ ನಿನ್ನ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":90,"keerthana_id":13010,"category_raw":0,"favorite":false,"header_stripped":["ಸಿರಿವತ್ಸಾಂಕಿತರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"sirivatsamkitaru__dasa1_13011","form":"pada","form_confidence":"default bu