ನಯ ಪಾದ ಮುಕುಂದಾ","ಅಭಯವ ನೀಡಯ್ಯಾ ಇಭರಾಜವರದನೆ","ಉಭಯ ಸುಖಪ್ರದ ನೀನೆಂದು","ಅಭಿನಮಿಸುವೆನಯ್ಯ ಶಬರಿಯಂಜಲನುಂಡು","ಬುಜೆಗಧವಕೊಂಡಿ ವಿಬುಧವಂದಿತನೆ","ಮೆರೆಯುವಿ ನೀ ಬಲು ಉರಗರಾಜಶಾಯಿ","ವರವಿಪ್ರನಿಕರದಿಂ ಪೂಜೆಗೊಂಡು","ಥರಥರದಲಿ ನೀ ಪೊರಹಿದೆ ಭಕ್ತರ","ಮರೆಯಬ್ಯಾಡ ನನ್ನ ಶಿರಿವತ್ಸಾಂಕಿತನೆ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":90,"keerthana_id":12996,"category_raw":0,"favorite":false,"header_stripped":["ಸಿರಿವತ್ಸಾಂಕಿತರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"sirivatsamkitaru__dasa1_12997","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಗಂಗಾಜನಕಗೆ","latin":"","iast":"gaṃgājanakagè","devanagari":"गंगाजनकगॆ"},"composer":"ಸಿರಿವತ್ಸಾಂಕಿತರು","composer_iast":"sirivatsāṃkitaru","deity":"","tags":["composer:ಸಿರಿವತ್ಸಾಂಕಿತರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಗಂಗಾಜನಕಗೆ ಮಂಗಳಾರುತಿಯನೆತ್ತಿ","ಮಂಗಳಾಂಗಿಯರು ಸಂಗೀತ ಪಾಡುತ ಪ","ಅನಿಮಿಷೇಶನು ಆನಂದಾತ್ಮಾ ಪ್ರಾಕೃತನು","ಅನಿಲವಾಸಾನಂತಾನಂತಾನಂತನಂತರೂಪನು","ಲಕ್ಷ್ಮೀವಾಸನು ಕುಕ್ಷಿಯೊಳ್ ಬ್ರಹ್ಮಾಂಡಧರನು","ಲಕ್ಷಣಗ್ರಜನು ಸುಕ್ಷೇಮದಿಂದಿಡುವ ನಾಮ","ಕರುಣಪೂರ್ಣನು ಸ್ಮರಿಪರ ಭವವಿದೂರ","ಸರಿಮಿಗಿಲಿಲ್ಲದ ಸಿರಿವಿಠಲ ನಾಮಧೇಯ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":90,"keerthana_id":12997,"category_raw":0,"favorite":false,"header_stripped":["ಸಿರಿವತ್ಸಾಂಕಿತರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"sirivatsamkitaru__dasa