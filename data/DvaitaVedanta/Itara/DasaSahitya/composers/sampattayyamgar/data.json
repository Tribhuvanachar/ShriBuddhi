{"schema":"dasa_pada_text","default_author":"ಸಂಪತ್ತಯ್ಯಂಗಾರ್","composer":"ಸಂಪತ್ತಯ್ಯಂಗಾರ್","count":10,"bio_notes":"","items":[{"id":"sampattayyamgar__dasa1_12638","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಇಲ್ಲಿಗೇತಕೆ ಬಂದೆಯೋ ಮಾನವ","latin":"","iast":"illigetakè baṃdèyo mānava","devanagari":"इल्लिगेतकॆ बंदॆयो मानव"},"composer":"ಸಂಪತ್ತಯ್ಯಂಗಾರ್","composer_iast":"saṃpattayyaṃgār","deity":"","tags":["composer:ಸಂಪತ್ತಯ್ಯಂಗಾರ್","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಹರಿಏಕನಿಷ್ಠೆಯ ಪ್ರತೀಕವಾಗಿ","(ಆ) ಲೋಕನೀತಿ","ಇಲ್ಲಿಗೇತಕೆ ಬಂದೆಯೋ ಮಾನವ","ಇಲ್ಲಿರಲು ಶಾಶ್ವತ ಸಾಧ್ಯವೇ ಹೇಳೋ ಪ","ಬರಲಿಲ್ಲ ಕೇಳಿ ನೀನು ಹೇಳಿ ಹೋಗುವನಲ್ಲ","ಇರಲು ಇಲ್ಲಿ ನಿನಗೇಕೆ ಚಿಂತೆ ಕಾಡುತಿಹುದಯ್ಯ ಅ.ಪ","ಜವನು ನಿನ್ನ ಬೇಡವೆಂದರೂ ಒಯ್ಯುವನಯ್ಯ","ಅವನ ಪಾಲಿಗೆ ನೀನು ಅನ್ನವಾಗಿ ನಿಂತಿರುವೆ","ದೈವ ಕಮಲಾಕ್ಷನಿಗೆ ಅವನು ಉಪ್ಪಿನಕಾಯಿ","ಅವನ ಚರಣ ಪಿಡಿದು ಬರುವುದೇನಿದೆ ನೋಡೋ","ನಂಬು ರಾಮನ ಮಾತನು ಕೃಷ್ಣ ಹಾಡಿದ ಹಾಡನು","ನಂಬಿ ಬಾಳಯ್ಯ ನೀನು ಪದುಮನಾಭನ ಚರಣ","ತಂಬಿ ಕೇಳೋ ಧರಣಿನಾಥನೆ ಕರುಣೆ ಸಾಗರನಯ್ಯ","ನಂಬು ಶೆಲ್ವರಾಯನೆ ದೇವ ಮುಕುತಿದಾತನು ಅವನೆ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":114,"keerthana_id":12638,"category_raw":0,"favorite":false,"header_stripped":["ಸಂಪತ್ತಯ್ಯಂಗಾರ್"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"sampattayyamgar__dasa1_12639","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಏನು ಹೇಳಲಯ್ಯ ರಂಗ","latin":"","iast":"enu heḻalayya raṃga","devanagari":"एनु हेळलय्य रंग"},"composer":"ಸಂಪತ್ತಯ್ಯಂಗಾರ್","composer_iast":"saṃpattayyaṃgār","deity":"","tags":["composer:ಸಂಪತ್ತಯ್ಯಂಗಾರ್","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["(ಅ) ಆತ್ಮನಿವೇದನಾ ಕೃತಿಗಳು","ಏನು ಹೇಳಲಯ್ಯ ರಂಗ ಎಲ್ಲಿ ಹೋಗಲಯ್ಯ","ನನ್ನಮನಸು ಮಂಗವಾಗಿ ದೂರ ತಳ್ಳಿಹುದಯ್ಯ ಪ","ಎಲ್ಲೆಯಿಲ್ಲದ ಎನ್ನವನು ನೀ ಎಂತುನಿಂತಿಹೆ ಸುಮ್ಮನೆ","ಎಲ್ಲವಾಗಿಕೂಡಿಕೊಂಡಿಹೆನಿನ್ನಚರಣಭರಿಸುಮಾಪತೇ ಕ-","ಮಲಾಪತಿ ನೀ ಕರುಣದಿಂದಲಿ ನಡೆಸಲಾರೆಯಾ ನನ್ನನು ಅ.ಪ","ನೋಡಲಾರದ ಕಣ್ಣು ನನ್ನದು","ನಡೆಯಲಾರದೆ ಕಾಲುಬಿದ್ದಿದೆ","ಕೋಪಗೊಳ್ಳದೆ ಬಂದು ನನ್ನಲಿ ನಿಂತು ಸಲಹೈ ದೇವನೇ","ಅಪ್ಪಶೆಲ್ವನೆ ನಿನ್ನ ಬಿಟ್ಟರೆ ಕಾದು ಕುಳಿತಿಹರಾರಯ್ಯ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":114,"keerthana_id":12639,"category_raw":0,"favorite":false,"header_stripped":["ಸಂಪತ್ತಯ್ಯಂಗಾರ್"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"sampattayyamgar__dasa1_12640","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಕಾಡದಿರು ಕಾಡದಿರು ಕಾಂತ","latin":"","iast":"kāḍadiru kāḍadiru kāṃta","devanagari":"काडदिरु काडदिरु कांत"},"composer":"ಸಂಪತ್ತಯ್ಯಂಗಾರ್","composer_iast":"saṃpattayyaṃgār","deity":"","tags":["composer:ಸಂಪತ್ತಯ್ಯಂಗಾರ್","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಕಾಡದಿರು ಕಾಡದಿರು ಕಾಂತ ಕೃಷ್ಣಯ್ಯ","ಬೇಡಿಕೊಂಬೆನು ನಿನ್ನ ಮನಬಿಚ್ಚಿ ತೋರಿಸುವೆ ಪ","ಪಶುವಾದ ಎನ್ನ ಮನಸು ಪಿಸುಮಾತು ಹೇಳುತಿಹುದು","ತುಸುಗುಣವಿಲ್ಲ ನಿನಗಂತೆ ಬಕುತಿಯೇಕಯ್ಯ ನಿನಗೆ ಅ.ಪ","ಬದುಕು ತಪ್ಪಿಸಿ ನಿಲ್ಲು ನೀನಾಗಿ ಎನ್ನುತಿದೆ","ಕದಿಮೋಸ ಮನವನು ನಂಬಿ ಬಾಳುವೆನೆಂತು","ಬುದ್ಧಿ ಕಲಿಸಯ್ಯ ಮನಕೆ ಬೆಳಕು ತೋರಿಸು ನಿನ್ನ","ಬದ್ಧಗೆಳೆಯನಾಗಿಸು ಅದನು ಬದುಕಿ ಬಾಳುವೆನಯ್ಯ","ಹಿಡಿಯಾಸೆ ಎನಗುಂಟು ಗಂಟುಕಟ್ಟಿ ನಿನ್ನೊಡನೆ","ನಡೆವೆ ದಿಟ್ಟತನದಲಿ ಕಮಲಾಕ್ಷ ಲಾಲಿಸಯ್ಯ","ಬಿಡಲಾರೆ ನಿನ್ನನೀಗ ಬೆಳಕು ಕಂಡಿತು ಎನಗೆ","ಒಡೆಯ ಶೆಲ್ವರಾಯ ನನಸು ಕನಸಾಗಿ ಮಾಡದಿರು"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":114,"keerthana_id":12640,"category_raw":0,"favorite":false,"header_stripped":["ಸಂಪತ್ತಯ್ಯಂಗಾರ್"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"sampattayyamgar__dasa1_12641","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಕೂಡಿ ಬನ್ನಿರಯ್ಯ ನೀವು","latin":"","iast":"kūḍi bannirayya nīvu","devanagari":"कूडि बन्निरय्य नीवु"},"composer":"ಸಂಪತ್ತಯ್ಯಂಗಾರ್","composer_iast":"saṃpattayyaṃgār","deity":"","tags":["composer:ಸಂಪತ್ತಯ್ಯಂಗಾರ್","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಇದನ್ನು ಮೂಲಗುರು","ಕೂಡಿ ಬನ್ನಿರಯ್ಯ ನೀವು ಬಂದು ನೋಡಿರಯ್ಯ","ಓಡಿ ಬಂದು ಹಿಂದೆ ಮುಖಕೆ ಮಸಿಯ ಬಳಿದನಯ್ಯಾ ಪ","ಆಟವಾಯಿತವಗೆ ನೋಡಿ ಪಾಪವಾಯಿತೆನಗೆ ಇಲ್ಲಿ","ಬಿಟ್ಟರೆಮಗೆ ನೀವು ಸಾಕ್ಷಿ ಪೇಳ್ವರಾರು ಹೇಳಿರಯ್ಯ ಅ.ಪ","ಇದ್ದುದನ್ನು ಹೇಳಿ ನೀವು ಮರೆಯಬೇಡಿರಯ್ಯ","ಪೇಳ್ದೆನಯ್ಯ ತಪ್ಪು ನಾನು ಕೆನ್ನೆ ಬಡಿಯಿರಯ್ಯ","ಮಸಿಯ ಕೊಟ್ಟು ಮುಂದೆ ಅವನು ಮುಗುಳಿನಕ್ಕಿ ಹೋದ","ಹುಸಿಯಲಾರದೆನ್ನ ಮುಖಕೆ ಹಚ್ಚಿಕೊಂಡೆನಯ್ಯ","ಅಣ್ಣನ ಬೈಯ್ಯಬೇಡಿರಯ್ಯ ತಪ್ಪು ನನ್ನದಯ್ಯ","ಕಣ್ಣು ಕಪ್ಪು ಹಚ್ಚಿ ತನ್ನ ನೋಡು ಎಂದ ಅವನು","ಮುಚ್ಚಿ ಕೊಟ್ಟನಯ್ಯ ಕಣ್ಣು ಬಿಚ್ಚಿ ಕೊಳ್ಳಲಿಲ್ಲ ನಾನು","ಪೆಚ್ಚು ಹೋದೆ ಶೆಲ್ವ ಶರಣು ತಿಳಿಸಿ ಸಲಹಿರಯ್ಯ ನೀವು"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":114,"keerthana_id":12641,"category_raw":0,"favorite":false,"header_stripped":["ಸಂಪತ್ತಯ್ಯಂಗಾರ್"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"sampattayyamgar__dasa1_12642","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಕೃಷ್ಣ ಕದ್ದು ಬಂದೆನಯ್ಯ ರಂಗ","latin":"","iast":"kṛṣṇa kaddu baṃdènayya raṃga","devanagari":"कृष्ण कद्दु बंदॆनय्य रंग"},"composer":"ಸಂಪತ್ತಯ್ಯಂಗಾರ್","composer_iast":"saṃpattayyaṃgār","deity":"","tags":["composer:ಸಂಪತ್ತಯ್ಯಂಗಾರ್","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಜಡ, ಜೀವಿಗಳು ಪರಮಾತ್ಮನ ಶರೀರ","ಕೃಷ್ಣ ಕದ್ದು ಬಂದೆನಯ್ಯ ರಂಗ ಮದ್ದು ಕಾಣೆನಯ್ಯ","ಕಣ್ಣು ಕೊಟ್ಟು ಇಟ್ಟೆ ಇಲ್ಲಿ ನಿನ್ನ ನೋಡಲೆಂದು ಪ","ನಾನು ನನ್ನದೆಂದು ಭ್ರಾಂತಿ ತಂದುಕೊಂಡೆನಯ್ಯ","ನಿನ್ನದೆನ್ನದೆಂದೆ ನಾನು ನನ್ನ ಬಿಟ್ಟು ನೀನು ನಿಂತೆ ಅ.ಪ","ಎಲ್ಲಿ ಇಲ್ಲ ನೀನು ದೇವ ಕುಂದು ಕೊರತೆಯುಂಟೆ ನಿನಗೆ","ಖುಲ್ಲಮೋಹವೆಂಬ ಮೋಡ ನಿನ್ನ ಬೆಳಕು ಮುಚ್ಚಿತಯ್ಯ","ಕಾಲಕಳೆದು ಕಲಿತೆ ನಿನ್ನ ಕಾಲುಬಿಟ್ಟರಿಲ್ಲ","ಕೂಲ ಸೇರಿಸಯ್ಯ ಬೇರೆ ದಾರಿಯಿಲ್ಲವಯ್ಯ","ಅರಿತು ಪೇಳ್ವೆನಯ್ಯ ಕೃಷ್ಣ ನೀನು ಹೇಳಿ ಕೊಟ್ಟೆ ಆಗ","ಬರಿದೆ ಕೆಟ್ಟು ಹೋದೆ ದೇವ ಒಳಿತು ಮಾಡವಯ್ಯ ಈಗ","ಮರೆತು ನಿಲ್ಲಲಾರೆ ನಿನ್ನ ಕಲೆತುಬಂದು ನಿಲ್ಲೊ ನೀನು","[ವರ]ಶೆಲ್ವ ಭಾಗ್ಯವಯ್ಯ ನೀನು ಭೋಗಮೋಕ್ಷವಯ್ಯ ದೇವ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":114,"keerthana_id":12642,"category_raw":0,"favorite":false,"header_stripped":["ಸಂಪತ್ತಯ್ಯಂಗಾರ್"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"sampattayyamgar__dasa1_12643","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಬಣ್ಣ ಬಣ್ಣದ ಬುಗುರಿಯಾಟವ","latin":"","iast":"baṇṇa baṇṇada buguriyāṭava","devanagari":"बण्ण बण्णद बुगुरियाटव"},"composer":"ಸಂಪತ್ತಯ್ಯಂಗಾರ್","composer_iast":"saṃpattayyaṃgār","deity":"","tags":["composer:ಸಂಪತ್ತಯ್ಯಂಗಾರ್","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಇಲ್ಲಿಯೂ ಹರಿಏಕನಿಷ್ಠೆ","ಬಣ್ಣ ಬಣ್ಣದ ಬುಗುರಿಯಾಟವ ಅಡುತಿಯರುವೆಯಾ ರಂಗ","ಗಿಣ್ಣು ಗಿಣ್ಣಲಿ ಕನಿತುನಿಂತಿಹ ಹಣ್ಣನಿದನು ಕಾಣೆಯಾ ಪ","ನೀನು ಬೆಳಿಸಿದ ಹಣ್ಣು ಎನ್ನುವ","ಮಮತೆ ಇಲ್ಲವೆ ಹೇದೇವ","ನನ್ನ ಕೈ ನೀ ಬಿಡುವೆಯಾ ಪುಸಿಯ","ಮಾತಿಗೆ ಮರುಳುಹೋಗಿ ಅ.ಪ","ನಿನ್ನ ಊರಲಿ ನೀನು ಕುಳಿತರೆ ಭಾಗ್ಯವೆನಗದು ಆಯಿತೆ","ನನ್ನ ಇಳಿಯಿಸಿ ಅರಿವು ಕೊಟ್ಟು ನಡೆಯ ಕಲಿಸಿದೆ ಏತಕೆ","ಸನ್ನಡೆಯು ಬಂದಿತು ನುಡಿಯು ಬಂದಿತು","ಇನ್ನು ಬರದೇ ಇರುವೆಯಾ","ನನ್ನಲ್ಲಿ ಸಹನೆ ಇಲ್ಲವೆಂದು ಅರಿಯಲಾರೆಯಾ ದೇವನೇ","ಮೋಸ ಹೋಗದೆ ಮಾಸಿಹೋಗದ","ನೆನಪು ಕೊಟ್ಟಿಹೆ ರಂಗ","ಆಸೆ ಮತಿಯು ದಾರಿ ನೋಡಿದೆ ದೂರ ದಡವನು ದಾಟಿಸೈ","ಭಾಷೆ ನಿನ್ನ ಮಾತ ನೀನು ತೆಗೆದುಕೊ","ನಾನು ಅದರೊಳು ನಿಂತಿಹೆ","ಓ ಶೆಲ್ವರಾಯನೆ ಮಾಧವ ಮತ್ತೆಯಾರನು ಕೇಳಲಿ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":114,"keerthana_id":12643,"category_raw":0,"favorite":false,"header_stripped":["ಸಂಪತ್ತಯ್ಯಂಗಾರ್"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"sampattayyamgar__dasa1_12644","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಬರಿದು ಬಂದಿಹೆನೀಗ ಹಿರಿಮೆಯನು","latin":"","iast":"baridu baṃdihènīga hirimèyanu","devanagari":"बरिदु बंदिहॆनीग हिरिमॆयनु"},"composer":"ಸಂಪತ್ತಯ್ಯಂಗಾರ್","composer_iast":"saṃpattayyaṃgār","deity":"","tags":["composer:ಸಂಪತ್ತಯ್ಯಂಗಾರ್","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಬರಿದು ಬಂದಿಹೆನೀಗ ಹಿರಿಮೆಯನು ಕಂಡರಿತು","ಹರಸು ಸಂಗವ ಕೊಟ್ಟು ದಡಹಾಯ್ದು ಬಂದಿಹೆನು ಪ","ಹುಟ್ಟು ಸಾವಿನ ಗಂಟು ಕಡುಪಾಪಿಯಾಗಿಸಿದೆ","ಮುಟ್ಟಿ ನಿನ್ನನು ನಾನು ಎಂತು ಕಾಣುವೆನಯ್ಯ ಅ.ಪ","ದಣಿದು ಬಂದಿಹೆ ದೇವ ಗತಿಯ ಕಾಣದೆ ಮುಂದೆ","ತಣಿದಬಾಳಿನ ನನ್ನ ಜೀವವ ಚಂದವಾಗಿಸು ರಂಗ","ಕುಣಿದು ಬರುವನು ನೀನು ಸರಿದುಹೋಗುವೆ ನಾನು","ಮಣಿಸಿ ಬಂಧವ ಬಂದು ತಡೆದು ಕಾಪಿಡೊ ರಂಗ","ಕಣ್ಣು ಹೋಗಿಸು ನಿನ್ನಲಿ ಮಣ್ಣು ಬಯಕೆಯ ತಪ್ಪಿಸು ಕಾ -","ಮನ್ನ ಸೇರಿಸು ನಿನ್ನಲಿ ನಲಿದು ಹಾಡಿಸು ನನ್ನನು ಕಾ -","ರುಣ್ಯ ತೋರೈ ನನ್ನಲಿ ಮನವು ನನ್ನದು ಆಗಲಿ","ಅಣ್ಣ ಶೆಲ್ವದೇವ ನೀ ನನಗಾಗಿ ತೋರಿಸಿಕೋ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":114,"keerthana_id":12644,"category_raw":0,"favorite":false,"header_stripped":["ಸಂಪತ್ತಯ್ಯಂಗಾರ್"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"sampattayyamgar__dasa1_12645","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಮೋಸ ಹೋದೆನಯ್ಯ ಕೃಷ್ಣ","latin":"","iast":"mosa hodènayya kṛṣṇa","devanagari":"मोस होदॆनय्य कृष्ण"},"composer":"ಸಂಪತ್ತಯ್ಯಂಗಾರ್","composer_iast":"saṃpattayyaṃgār","deity":"","tags":["composer:ಸಂಪತ್ತಯ್ಯಂಗಾರ್","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಮೋಸ ಹೋದೆನಯ್ಯ ಕೃಷ್ಣ ಮೋಸ ಹೋದೆನಯ್ಯಾ ಪ","ಈಸು ಸುಲಭನೆಂದು ಪೇಳಿ ದೂರ ಸರಿವೆಯೇಕಯ್ಯ","ಇಷ್ಟವಿಲ್ಲವೇ ನಾನು ನಿನಗೆ ಬೇಡವಾದೆನೇ ಅ.ಪ","ಉಡಲು ನಿನ್ನವೆಲ್ಲಾವೆಂದು ಸುಳ್ಳು ಹೇಳಿತೇ ವೇದ","ಕಡಲು ದಾಟಲು ಬೇರೆ ದಾರಿಯಿಲ್ಲವಯ್ಯ","ಒಡಲು ನನ್ನದಾಗಿ ನೊಂದ ನನ್ನ ಕೂಡಯ್ಯ","ಒಡೆಯಶೆಲ್ವರಾಯ ಕೂಡಿಕೊಳ್ಳೊ ಅಯ್ಯ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":114,"keerthana_id":12645,"category_raw":0,"favorite":false,"header_stripped":["ಸಂಪತ್ತಯ್ಯಂಗಾರ್"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"sampattayyamgar__dasa1_12646","form":"devaranama","form_confidence":"sampled, consistent structured header (song/singer/raga/tala/style)","title":{"kn":"ಕಾಡದಿರು ಕಾಡದಿರು ಕಾಂತ","latin":"","iast":"kāḍadiru kāḍadiru kāṃta","devanagari":"काडदिरु काडदिरु कांत"},"composer":"ಸಂಪತ್ತಯ್ಯಂಗಾರ್","composer_iast":"saṃpattayyaṃgār","deity":"","tags":["composer:ಸಂಪತ್ತಯ್ಯಂಗಾರ್","source:android_app_local:dasa1","category_raw:4","form:devaranama","rendition:studio_recording"],"raga":"ಹಂಸಾನಂದಿ","tala":"ಆದಿ ತಾಳ","singer":"ವಿನಯಕುಮಾರ್ ಬಿ. ಎನ್.","style":"ಸುಗಮ","music_director":"ಲೀಲಾವತಿ ಹೆಚ್. ಆರ್.","studio":"ಅರವಿಂದ್ ಸ್ಟುಡಿಯೊ, ಬೆಂಗಳೂರು","language":"kn","text":{"kannada":[["ಕಾಡದಿರು ಕಾಡದಿರು ಕಾಂತ","ಕಾಡದಿರು ಕಾಡದಿರು ಕಾಂತ ಕೃಷ್ಣಯ್ಯ","ಬೇಡಿಕೊಂಬೆನು ನಿನ್ನ ಮನಬಿಚ್ಚಿ ತೋರಿಸುವೆ ಪ","ಪಶುವಾದ ಎನ್ನ ಮನಸು ಪಿಸುಮಾತು ಹೇಳುತಿಹುದು","ತುಸುಗುಣವಿಲ್ಲ ನಿನಗಂತೆ ಬಕುತಿಯೇಕಯ್ಯ ನಿನಗೆ ಅ.ಪ","ಬದುಕು ತಪ್ಪಿಸಿ ನಿಲ್ಲು ನೀನಾಗಿ ಎನ್ನುತಿದೆ","ಕದಿಮೋಸ ಮನವನು ನಂಬಿ ಬಾಳುವೆನೆಂತು","ಬುದ್ಧಿ ಕಲಿಸಯ್ಯ ಮನಕೆ ಬೆಳಕು ತೋರಿಸು ನಿನ್ನ","ಬದ್ಧಗೆಳೆಯನಾಗಿಸು ಅದನು ಬದುಕಿ ಬಾಳುವೆನಯ್ಯ","ಹಿಡಿಯಾಸೆ ಎನಗುಂಟು ಗಂಟುಕಟ್ಟಿ ನಿನ್ನೊಡನೆ","ನಡೆವೆ ದಿಟ್ಟತನದಲಿ ಕಮಲಾಕ್ಷ ಲಾಲಿಸಯ್ಯ","ಬಿಡಲಾರೆ ನಿನ್ನನೀಗ ಬೆಳಕು ಕಂಡಿತು ಎನಗೆ","ಒಡೆಯ ಶೆಲ್ವರಾಯ ನನಸು ಕನಸಾಗಿ ಮಾಡದಿರು"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":114,"keerthana_id":12646,"category_raw":4,"favorite":false,"header_stripped":["ನಿರ್ಗಮನ"],"unclassified_lines":[],"is_recorded_rendition":true},"_needs_review":false,"also_at":[]},{"id":"sampattayyamgar__dasa1_12647","form":"devaranama","form_confidence":"sampled, consistent structured header (song/singer/raga/tala/style)","title":{"kn":"ಕೃಷ್ಣ ಕದ್ದು ಬಂದೆನಯ್ಯ ರಂಗ","latin":"","iast":"kṛṣṇa kaddu baṃdènayya raṃga","devanagari":"कृष्ण कद्दु बंदॆनय्य रंग"},"composer":"ಸಂಪತ್ತಯ್ಯಂಗಾರ್","composer_iast":"saṃpattayyaṃgār","deity":"","tags":["composer:ಸಂಪತ್ತಯ್ಯಂಗಾರ್","source:android_app_local:dasa1","category_raw:4","form:devaranama","rendition:studio_recording"],"raga":"ಶಂಕರಾಭರಣ","tala":"ಆದಿ ತಾಳ","singer":"ರತ್ನಮಾಲಾ ಪ್ರಕಾಶ್","style":"ಕರ್ನಾಟಕ","music_director":"ರಮಾಕಾಂತ್ ಆರ್. ಎಸ್.","studio":"ಅರವಿಂದ್ ಸ್ಟುಡಿಯೊ, ಬೆಂಗಳೂರು","language":"kn","text":{"kannada":[["ಕೃಷ್ಣ ಕದ್ದು ಬಂದೆನಯ್ಯ ರಂಗ","ಕೃಷ್ಣ ಕದ್ದು ಬಂದೆನಯ್ಯ ರಂಗ ಮದ್ದು ಕಾಣೆನಯ್ಯ","ಕಣ್ಣು ಕೊಟ್ಟು ಇಟ್ಟೆ ಇಲ್ಲಿ ನಿನ್ನ ನೋಡಲೆಂದು ಪ","ನಾನು ನನ್ನದೆಂದು ಭ್ರಾಂತಿ ತಂದುಕೊಂಡೆನಯ್ಯ","ನಿನ್ನದೆನ್ನದೆಂದೆ ನಾನು ನನ್ನ ಬಿಟ್ಟು ನೀನು ನಿಂತೆ ಅ.ಪ","ಎಲ್ಲಿ ಇಲ್ಲ ನೀನು ದೇವ ಕುಂದು ಕೊರತೆಯುಂಟೆ ನಿನಗೆ","ಖುಲ್ಲಮೋಹವೆಂಬ ಮೋಡ ನಿನ್ನ ಬೆಳಕು ಮುಚ್ಚಿತಯ್ಯ","ಕಾಲಕಳೆದು ಕಲಿತೆ ನಿನ್ನ ಕಾಲುಬಿಟ್ಟರಿಲ್ಲ","ಕೂಲ ಸೇರಿಸಯ್ಯ ಬೇರೆ ದಾರಿಯಿಲ್ಲವಯ್ಯ","ಅರಿತು ಪೇಳ್ವೆನಯ್ಯ ಕೃಷ್ಣ ನೀನು ಹೇಳಿ ಕೊಟ್ಟೆ ಆಗ","ಬರಿದೆ ಕೆಟ್ಟು ಹೋದೆ ದೇವ ಒಳಿತು ಮಾಡವಯ್ಯ ಈಗ","ಮರೆತು ನಿಲ್ಲಲಾರೆ ನಿನ್ನ ಕಲೆತುಬಂದು ನಿಲ್ಲೊ ನೀನು","[ವರ]ಶೆಲ್ವ ಭಾಗ್ಯವಯ್ಯ ನೀನು ಭೋಗಮೋಕ್ಷವಯ್ಯ ದೇವ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":114,"keerthana_id":12647,"category_raw":4,"favorite":false,"header_stripped":["ನಿರ್ಗಮನ"],"unclassified_lines":[],"is_recorded_rendition":true},"_needs_review":false,"also_at":[]}]}