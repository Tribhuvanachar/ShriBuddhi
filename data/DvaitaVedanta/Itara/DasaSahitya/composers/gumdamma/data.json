ಮಾಡಿ","ಸಾಧಿಸಿನುತವ ಬೋೀಧಿಸಿ ಸುಜನರಿಗೆ","ವ್ಯಾಧಿಗಳ ಕಳೆದು ಪೊರೆವ ಮೆರೆವ","ಸುಜ್ಞಾನ ತೀರ್ಥರೆಂದೆನಿಸಿ ಮಹಿಯೊಳ್","ಅಜ್ಞಾನ ಪರಿಹರಿಸಿ ಪೊರೆವ ಗುರು","ಸುಜ್ಞಾನವೀವ ರುಕ್ಮಿಣೀಶವಿಠಲನ ಭಜಿಪ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":193,"keerthana_id":3092,"category_raw":0,"favorite":false,"header_stripped":["ಗುಂಡಮ್ಮ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"gumdamma__dasa1_3093","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಲೋಕಮಾತೆಯೆ ದಯಮಾಡೆ","latin":"","iast":"lokamātèyè dayamāḍè","devanagari":"लोकमातॆयॆ दयमाडॆ"},"composer":"ಗುಂಡಮ್ಮ","composer_iast":"guṃḍamma","deity":"","tags":["composer:ಗುಂಡಮ್ಮ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಲೋಕಮಾತೆಯೆ ದಯಮಾಡೆ ತಾಯೆ","ಲೋಕಮಾತೆಯೆ ಈ ಪರಿ ಪೂಜಿಪೆ ಶ್ರೀಪತಿಯ ಸತಿಯೆ","ಪುಲ್ಲನಾಭನ ಕೂಡಿ ಮೆಲ್ಲಡಿ ಇಡುತಲಿ","ಉಲ್ಲಾಸದಿಂದಲಿ ಬಂದು ಕಾಯೆ ತಾಯೆ","ನಿತ್ಯ ಮಂಗಳನಾಗೆ ಅಚ್ಚುತನರಾಣಿ","ನಿಚ್ಚದಿ ಭಕ್ತಿ ಜ್ಞಾನವಿತ್ತು ಕಾಯೆ ತಾಯೆ","ವಕ್ಷಸ್ಥಳದಲಿ ನಿಂತೂ ಕಾಯೆ ತಾಯೆ","ಪಕ್ಷಿವಾಹನ ರುಕ್ಮಿಣೀಶ ವಿಠಲನ ರಾಣಿ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":193,"keerthana_id":3093,"category_raw":0,"favorite":false,"header_stripped":["ಗುಂಡಮ್ಮ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"gumdamma__dasa1_3094","form":"devaranama","form_confidence":"sampled, consistent structured header (song/singer/raga/tala/style)","title":{"kn":"ಉಮಾದೇವಿಯೆ ನಿನ್ನ ನಮಿಪೆ ಅನುದಿನ","latin":"","iast":"umādeviyè ninna namipè anudina","devanagari":"उमादेवियॆ निन्न नमिपॆ अनुदिन"},"composer":"ಗುಂಡಮ್ಮ","composer_iast":"guṃḍamma","deity":"","tags":["composer:ಗುಂಡಮ್ಮ","source:android_app_local:dasa1","category_raw:4","form:devaranama","rendition:studio_recording"],"raga":"ನಾಗಸ್ವರಾವಳಿ","tala":"ಆದಿ ತಾಳ","singer":"ವಿಶ್ವೇಶ್ವರನ್ ಆರ್., ರಾಜಲಕ್ಷ್ಮಿ ಶ್ರೀಧರ್ ಜಿ., ಸುಧಾ ಕೆ., ಜಮುನಾ ಶ್ರೀನಿವಾಸ್, ರಂಜನಿ ಪಿ. ಎಸ್.","style":"","music_director":"ವಿಶ್ವೇಶ್ವರನ್ ಆರ್.","studio":"ಅರವಿಂದ್ ಸ್ಟುಡಿಯೊ, ಬೆಂಗಳೂರು","language":"kn","text":{"kannada":[["ಉಮಾದೇವಿಯೆ ನಿನ್ನ ನಮಿಪೆ ಅನುದಿನ","ಉಮಾದೇವಿಯೆ ನಿನ್ನ ನಮಿಪೆ ಅನುದಿನ","ಚರಣಕಮಲವ ತೋರಮ್ಮ ನಮ್ಮಮ್ಮಾ ಪ.","ಮನೋಭಿಮಾನಿಯೇ ಎನ್ನವಗುಣಗಳೆಣಿಸದೆ ತ್ವರಿತದಿ","ಬಂದು ಮುತ್ತಿನ ಗದ್ದಿಗೆಯನೇರಮ್ಮ ನಮ್ಮಮ್ಮಾ ಅ.ಪ.","ದಕ್ಷಕುವರಿ ದಾಕ್ಷಾಯಿಣಿ ಗೌರಿ ಪಕ್ಷಿವಾಹನನ ಸೋದರಿ","ಈಕ್ಷಿಸುತಿರುವೆನು ಉಪೇಕ್ಷಿಸದೆ ಎನ್ನ","ರಕ್ಷಿಸಿ ಕಾಯೆ ಪಾರ್ವತಿ ತಾಯೆ","ಶಂಭುದೇವನ ರಾಣಿ ಹೃದಯಾಂಬರದೊಳು ನಿಂದು","ಬಿಂಬವ ತೋರೆ ಜಗದಾಂಬ ಅಂಬರ ಪೂಜಿತೆ","ನಂಬಿದ ಭಕ್ತರ ಪೊರೆವ ಸದ್ಗುಣ ಚರಿತೆ","ಗೆಜ್ಜೆ ಪಾದಗಳಿಂದ ಘಲ್ ಘಲ್ ಎನುತ ಬಾರಮ್ಮ","ಹೆಜ್ಜೆಯನಿಡುತ ಮುಗುಳ್ನಗೆ ನಗುತ ಬಾರಮ್ಮ","ಸುಜ್ಞಾನ ಮತಿಯಿತ್ತು ಕಾಯುವ ತಾಯಿ ಬಾರಮ್ಮ","ಉಟ್ಟ ಪೀತಾಂಬರ ತೊಟ್ಟ ಕಂಚುಕ ಪಟ್ಟೆಯ ಪದಕ","ಕಟ್ಟಿದ ಕಠಾಣೆ ಮುತ್ತಿನಮೂಗುತಿ ಪಚ್ಚೆಯ ಓಲೆ","ಇಟ್ಟ ಕಸ್ತೂರಿತಿಲಕ ಕೆತ್ತಿದ ಕಿರೀಟ ಹೊಳೆಯುತ","ಬೇಡಿಕೊಂಬೆವೆ ತಾಯೆ ನೀ ಎನ್ನ ಆಪತ್ತು ಪರಿಹರಿಸಿ","ಪಾಡಿ ಪೊಗಳಿ ಕೊಂಡಾಡುವೆ ಕಾಯೆ ತಾಯೆ","ಬೇಡಿದ ವರಗಳ ರುಕ್ಮಿಣೀಶವಿಠಲನ ಕರುಣದೆ ನೀಡೆ ತಾಯೆ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":193,"keerthana_id":3094,"category_raw":4,"favorite":false,"header_stripped":["ನಿರ್ಗಮನ"],"unclassified_lines":[],"is_recorded_rendition":true},"_needs_review":false,"also_at":[]}]}