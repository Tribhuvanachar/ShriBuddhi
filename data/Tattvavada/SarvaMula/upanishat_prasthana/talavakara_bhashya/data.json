{"schema":"grantha_tika_text","default_author":"श्रीमदानन्दतीर्थभगवत्पादाचार्यः","title":"तलवकारोपनिषद्भाष्यम्‌","items":[{"id":"ST_talavakara_bhashya_00001","reference":"तलवकारोपनिषद्भाष्यम्‌ > प्रथमः खण्डः > उपोद्घातः","section":"प्रथमः खण्डः","unit_title":"उपोद्घातः","sanskrit_text":"उपोद्घातः","artha":"","notes":"","tags":["Heading0"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","प्रथमः खण्डः","उपोद्घातः"]},{"id":"ST_talavakara_bhashya_00002","reference":"तलवकारोपनिषद्भाष्यम्‌ > प्रथमः खण्डः > उपोद्घातः","section":"प्रथमः खण्डः","unit_title":"","sanskrit_text":"ओ३म्॥ आप्यायन्तु ममाङ्गानि वाक् प्राणश्चक्षुः श्रोत्रमथो बलमिन्द्रियाणि च सर्वाणि। सर्वं ब्रह्मौपनिषदम्। माऽहं ब्रह्म निराकुर्यां मा मा ब्रह्म निराकारोत्। अनिराकरणमस्त्वनिराकरणं मेऽस्तु। तदात्मनि निरते य उपनिषत्सु धर्मास्ते मयि सन्तु ते मयि सन्तु। ॐ शान्तिः शान्तिः शान्तिः॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","प्रथमः खण्डः","उपोद्घातः"]},{"id":"ST_talavakara_bhashya_00003","reference":"तलवकारोपनिषद्भाष्यम्‌ > प्रथमः खण्डः > उपोद्घातः","section":"प्रथमः खण्डः","unit_title":"","sanskrit_text":"ॐ॥ अनन्तगुणपूर्णत्वादगम्याय सुरैरपि। सर्वेष्टदात्रे देवानां नमो नारायणाय ते॥ *॥","artha":"","notes":"","tags":["Sarvamula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","प्रथमः खण्डः","उपोद्घातः"]},{"id":"ST_talavakara_bhashya_00004","reference":"तलवकारोपनिषद्भाष्यम्‌ > प्रथमः खण्डः > प्रथमः खण्डः","section":"प्रथमः खण्डः","unit_title":"प्रथमः खण्डः","sanskrit_text":"प्रथमः खण्डः","artha":"","notes":"","tags":["Heading1"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","प्रथमः खण्डः","प्रथमः खण्डः"]},{"id":"ST_talavakara_bhashya_00005","reference":"तलवकारोपनिषद्भाष्यम्‌ > प्रथमः खण्डः > प्रथमः खण्डः","section":"प्रथमः खण्डः","unit_title":"","sanskrit_text":"ओ३म्॥ केनेषितं पतति प्रेषितं मनः केन प्राणः प्रथमः प्रैति युक्तः। केनेषितां वाचमिमां वदन्ति चक्षुः श्रोत्रं क उ देवो युनक्ति॥ १/१॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","प्रथमः खण्डः","प्रथमः खण्डः"]},{"id":"ST_talavakara_bhashya_00006","reference":"तलवकारोपनिषद्भाष्यम्‌ > प्रथमः खण्डः > प्रथमः खण्डः","section":"प्रथमः खण्डः","unit_title":"","sanskrit_text":"श्रोत्रस्य श्रोत्रं मनसो मनो यद्‌ वाचो ह वाचं स उ प्राणस्य प्राणः। चक्षुषश्चक्षुरतिमुच्य धीराः प्रेत्यास्माल्लोकादमृता भवन्ति॥ १/२॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","प्रथमः खण्डः","प्रथमः खण्डः"]},{"id":"ST_talavakara_bhashya_00007","reference":"तलवकारोपनिषद्भाष्यम्‌ > प्रथमः खण्डः > प्रथमः खण्डः","section":"प्रथमः खण्डः","unit_title":"","sanskrit_text":"न तत्र चक्षुर्गच्छति न वाग् गच्छति नो मनः। न विद्म न विजानीमो यथैतदनुशिष्यात्‌ ॥ १/३॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","प्रथमः खण्डः","प्रथमः खण्डः"]},{"id":"ST_talavakara_bhashya_00008","reference":"तलवकारोपनिषद्भाष्यम्‌ > प्रथमः खण्डः > प्रथमः खण्डः","section":"प्रथमः खण्डः","unit_title":"","sanskrit_text":"अन्यदेव तद् विदितादथो अविदितादधि। इति शुश्रुम पूर्वेषां ये नस्तद्‌ व्याचचक्षिरे॥ १/४॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","प्रथमः खण्डः","प्रथमः खण्डः"]},{"id":"ST_talavakara_bhashya_00009","reference":"तलवकारोपनिषद्भाष्यम्‌ > प्रथमः खण्डः > प्रथमः खण्डः","section":"प्रथमः खण्डः","unit_title":"","sanskrit_text":"यद्वाचाऽनभ्युदितं येन वागभ्युद्यते। तदेव ब्रह्म त्वं विद्धि नेदं यदिदमुपासते॥ १/५॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","प्रथमः खण्डः","प्रथमः खण्डः"]},{"id":"ST_talavakara_bhashya_00010","reference":"तलवकारोपनिषद्भाष्यम्‌ > प्रथमः खण्डः > प्रथमः खण्डः","section":"प्रथमः खण्डः","unit_title":"","sanskrit_text":"यन्मनसा न मनुते येनाहुर्मनो मतम्‌। तदेव ब्रह्म त्वं विद्धि नेदं यदिदमुपासते॥ १/६॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","प्रथमः खण्डः","प्रथमः खण्डः"]},{"id":"ST_talavakara_bhashya_00011","reference":"तलवकारोपनिषद्भाष्यम्‌ > प्रथमः खण्डः > प्रथमः खण्डः","section":"प्रथमः खण्डः","unit_title":"","sanskrit_text":"यच्चक्षुषा न पश्यति येन चक्षूंषि पश्यति। तदेव ब्रह्म त्वं विद्धि नेदं यदिदमुपासते ॥ १/७॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","प्रथमः खण्डः","प्रथमः खण्डः"]},{"id":"ST_talavakara_bhashya_00012","reference":"तलवकारोपनिषद्भाष्यम्‌ > प्रथमः खण्डः > प्रथमः खण्डः","section":"प्रथमः खण्डः","unit_title":"","sanskrit_text":"यच्छ्रोत्रेण न शृणोति येन श्रोत्रमिदं श्रुतम्‌। तदेव ब्रह्म त्वं विद्धि नेदं यदिदमुपासते ॥ १/८॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","प्रथमः खण्डः","प्रथमः खण्डः"]},{"id":"ST_talavakara_bhashya_00013","reference":"तलवकारोपनिषद्भाष्यम्‌ > प्रथमः खण्डः > प्रथमः खण्डः","section":"प्रथमः खण्डः","unit_title":"","sanskrit_text":"यत् प्राणेन न प्राणिति येन प्राणः प्रणीयते। तदेव ब्रह्म त्वं विद्धि नेदं यदिदमुपासते॥ १/९॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","प्रथमः खण्डः","प्रथमः खण्डः"]},{"id":"ST_talavakara_bhashya_00014","reference":"तलवकारोपनिषद्भाष्यम्‌ > प्रथमः खण्डः > प्रथमः खण्डः","section":"प्रथमः खण्डः","unit_title":"","sanskrit_text":"॥ इति तलवकारोपनिषदि प्रथमः खण्डः ॥","artha":"","notes":"","tags":["Colophon_Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","प्रथमः खण्डः","प्रथमः खण्डः"]},{"id":"ST_talavakara_bhashya_00015","reference":"तलवकारोपनिषद्भाष्यम्‌ > द्वितीयः खण्डः > द्वितीयः खण्डः","section":"द्वितीयः खण्डः","unit_title":"द्वितीयः खण्डः","sanskrit_text":"द्वितीयः खण्डः","artha":"","notes":"","tags":["Heading1"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","द्वितीयः खण्डः","द्वितीयः खण्डः"]},{"id":"ST_talavakara_bhashya_00016","reference":"तलवकारोपनिषद्भाष्यम्‌ > द्वितीयः खण्डः > द्वितीयः खण्डः","section":"द्वितीयः खण्डः","unit_title":"","sanskrit_text":"यदि मन्यसे सुवेदेति दह्रमेवापि नूनं त्वं न वेत्थ ब्रह्मणो रूपम्‌। यदस्य त्वं यदस्य देवेष्वथ नु मीमांस्यमेव ते मन्ये[ऽ]विदितम्‌॥ २/१॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","द्वितीयः खण्डः","द्वितीयः खण्डः"]},{"id":"ST_talavakara_bhashya_00017","reference":"तलवकारोपनिषद्भाष्यम्‌ > द्वितीयः खण्डः > द्वितीयः खण्डः","section":"द्वितीयः खण्डः","unit_title":"","sanskrit_text":"नाहं मन्ये सुवेदेति नो न वेदेति वेद च। यो नस्तद् वेद तद् वेद नो न वेदेति वेद च॥ २/२॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","द्वितीयः खण्डः","द्वितीयः खण्डः"]},{"id":"ST_talavakara_bhashya_00018","reference":"तलवकारोपनिषद्भाष्यम्‌ > द्वितीयः खण्डः > द्वितीयः खण्डः","section":"द्वितीयः खण्डः","unit_title":"","sanskrit_text":"यस्यामतं तस्य मतं मतं यस्य न वेद सः। अविज्ञातं विजानतां विज्ञातमविजानताम्‌॥ २/३॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","द्वितीयः खण्डः","द्वितीयः खण्डः"]},{"id":"ST_talavakara_bhashya_00019","reference":"तलवकारोपनिषद्भाष्यम्‌ > द्वितीयः खण्डः > द्वितीयः खण्डः","section":"द्वितीयः खण्डः","unit_title":"","sanskrit_text":"प्रतिबोधविदितं मतममृतत्वं हि विन्दते। आत्मना विन्दते वीर्यं विद्यया विन्दतेऽमृतम्‌॥ २/४॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","द्वितीयः खण्डः","द्वितीयः खण्डः"]},{"id":"ST_talavakara_bhashya_00020","reference":"तलवकारोपनिषद्भाष्यम्‌ > द्वितीयः खण्डः > द्वितीयः खण्डः","section":"द्वितीयः खण्डः","unit_title":"","sanskrit_text":"इह चेदवेदीदथ सत्यमस्ति न चेदिहावेदीन्महती विनष्टिः। भूतेषुभूतेषु विचित्य धीराः प्रेत्यास्माल्लोकादमृता भवन्ति॥ २/५॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","द्वितीयः खण्डः","द्वितीयः खण्डः"]},{"id":"ST_talavakara_bhashya_00021","reference":"तलवकारोपनिषद्भाष्यम्‌ > द्वितीयः खण्डः > द्वितीयः खण्डः","section":"द्वितीयः खण्डः","unit_title":"","sanskrit_text":"॥ इति तलवकारोपनिषदि द्वितीयः खण्डः ॥","artha":"","notes":"","tags":["Colophon_Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","द्वितीयः खण्डः","द्वितीयः खण्डः"]},{"id":"ST_talavakara_bhashya_00022","reference":"तलवकारोपनिषद्भाष्यम्‌ > तृतीयः खण्डः > तृतीयः खण्डः","section":"तृतीयः खण्डः","unit_title":"तृतीयः खण्डः","sanskrit_text":"तृतीयः खण्डः","artha":"","notes":"","tags":["Heading1"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","तृतीयः खण्डः","तृतीयः खण्डः"]},{"id":"ST_talavakara_bhashya_00023","reference":"तलवकारोपनिषद्भाष्यम्‌ > तृतीयः खण्डः > तृतीयः खण्डः","section":"तृतीयः खण्डः","unit_title":"","sanskrit_text":"ब्रह्म ह देवेभ्यो विजिग्ये तस्य ह ब्रह्मणो विजये देवा अमहीयन्त। त ऐक्षन्तास्माकमेवायं विजयोऽस्माकमेवायं महिमेति॥ ३/१॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","तृतीयः खण्डः","तृतीयः खण्डः"]},{"id":"ST_talavakara_bhashya_00024","reference":"तलवकारोपनिषद्भाष्यम्‌ > तृतीयः खण्डः > तृतीयः खण्डः","section":"तृतीयः खण्डः","unit_title":"","sanskrit_text":"तद्धैषां विजज्ञौ। तेभ्यो ह प्रादुर्बभूव। तन्न व्यजानत किमिदं यक्षमिति॥ ३/२॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","तृतीयः खण्डः","तृतीयः खण्डः"]},{"id":"ST_talavakara_bhashya_00025","reference":"तलवकारोपनिषद्भाष्यम्‌ > तृतीयः खण्डः > तृतीयः खण्डः","section":"तृतीयः खण्डः","unit_title":"","sanskrit_text":"तेऽग्निमब्रुवन्। जातवेद एतद् विजानीहि किमेतद् यक्षमिति। तथेति॥ ३/३॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","तृतीयः खण्डः","तृतीयः खण्डः"]},{"id":"ST_talavakara_bhashya_00026","reference":"तलवकारोपनिषद्भाष्यम्‌ > तृतीयः खण्डः > तृतीयः खण्डः","section":"तृतीयः खण्डः","unit_title":"","sanskrit_text":"तदभ्यद्रवत्। तमभ्यवदत् कोऽसीति। अग्निर्वा अहमस्मीत्यब्रवीज्जातवेदा वा अहमस्मीति॥ ३/४॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","तृतीयः खण्डः","तृतीयः खण्डः"]},{"id":"ST_talavakara_bhashya_00027","reference":"तलवकारोपनिषद्भाष्यम्‌ > तृतीयः खण्डः > तृतीयः खण्डः","section":"तृतीयः खण्डः","unit_title":"","sanskrit_text":"तस्मिंस्त्वयि किं वीर्यमिति। अपीदं सर्वं दहेयं यदिदं पृथिव्यामिति॥ ३/५॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","तृतीयः खण्डः","तृतीयः खण्डः"]},{"id":"ST_talavakara_bhashya_00028","reference":"तलवकारोपनिषद्भाष्यम्‌ > तृतीयः खण्डः > तृतीयः खण्डः","section":"तृतीयः खण्डः","unit_title":"","sanskrit_text":"तस्मै तृणं निदधावेतद् दहेति। तदुपप्रेयाय सर्वजवेन। तन्न शशाक दग्धुम्। स तत एव निववृते। नैतदशकं विज्ञातुं यदेतद् यक्षमिति॥ ३/६॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","तृतीयः खण्डः","तृतीयः खण्डः"]},{"id":"ST_talavakara_bhashya_00029","reference":"तलवकारोपनिषद्भाष्यम्‌ > तृतीयः खण्डः > तृतीयः खण्डः","section":"तृतीयः खण्डः","unit_title":"","sanskrit_text":"अथ वायुमब्रुवन्। वायवेतद् विजानीहि किमेतद् यक्षमिति तथेति॥ ३/७॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","तृतीयः खण्डः","तृतीयः खण्डः"]},{"id":"ST_talavakara_bhashya_00030","reference":"तलवकारोपनिषद्भाष्यम्‌ > तृतीयः खण्डः > तृतीयः खण्डः","section":"तृतीयः खण्डः","unit_title":"","sanskrit_text":"तदभ्यद्रवत्। तमभ्यवदत् कोऽसीति। वायुर्वा अहमस्मीत्यब्रवीन्मातरिश्वा वा अहमस्मीति॥ ३/८॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","तृतीयः खण्डः","तृतीयः खण्डः"]},{"id":"ST_talavakara_bhashya_00031","reference":"तलवकारोपनिषद्भाष्यम्‌ > तृतीयः खण्डः > तृतीयः खण्डः","section":"तृतीयः खण्डः","unit_title":"","sanskrit_text":"तस्मिंस्त्वयि किं वीर्यमिति। अपीदं सर्वमाददीय यदिदं पृथिव्यामिति॥ ३/९॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","तृतीयः खण्डः","तृतीयः खण्डः"]},{"id":"ST_talavakara_bhashya_00032","reference":"तलवकारोपनिषद्भाष्यम्‌ > तृतीयः खण्डः > तृतीयः खण्डः","section":"तृतीयः खण्डः","unit_title":"","sanskrit_text":"तस्मै तृणं निदधावेतदादत्स्वेति। तदुपप्रेयाय सर्वजवेन। तन्न शशाकादातुम्। स तत एव निववृते। नैतदशकं विज्ञातुं यदेतद् यक्षमिति॥ ३/१०॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","तृतीयः खण्डः","तृतीयः खण्डः"]},{"id":"ST_talavakara_bhashya_00033","reference":"तलवकारोपनिषद्भाष्यम्‌ > तृतीयः खण्डः > तृतीयः खण्डः","section":"तृतीयः खण्डः","unit_title":"","sanskrit_text":"अथेन्द्रमब्रुवन्। मघवन्नेतद् विजानीहि किमेतद् यक्षमिति। तथेति तदभ्यद्रवत्। स तस्मात् तिरोदधे॥ ३/११॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","तृतीयः खण्डः","तृतीयः खण्डः"]},{"id":"ST_talavakara_bhashya_00034","reference":"तलवकारोपनिषद्भाष्यम्‌ > तृतीयः खण्डः > तृतीयः खण्डः","section":"तृतीयः खण्डः","unit_title":"","sanskrit_text":"स तस्मिन्नेवाकाशे स्त्रियमाजगाम बहुशोभमानामुमां हैमवतीम्। तां होवाच किमेतद् यक्षमिति॥ ३/१२॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","तृतीयः खण्डः","तृतीयः खण्डः"]},{"id":"ST_talavakara_bhashya_00035","reference":"तलवकारोपनिषद्भाष्यम्‌ > तृतीयः खण्डः > तृतीयः खण्डः","section":"तृतीयः खण्डः","unit_title":"","sanskrit_text":"॥ इति तलवकारोनिषदि तृतीयः खण्डः ॥","artha":"","notes":"","tags":["Colophon_Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","तृतीयः खण्डः","तृतीयः खण्डः"]},{"id":"ST_talavakara_bhashya_00036","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"चतुर्थः खण्डः","sanskrit_text":"चतुर्थः खण्डः","artha":"","notes":"","tags":["Heading1"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","चतुर्थः खण्डः","चतुर्थः खण्डः"]},{"id":"ST_talavakara_bhashya_00037","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"","sanskrit_text":"ब्रह्मेति होवाच। ब्रह्मणो वा एतद्विजयेऽमहीयध्वमिति। ततो हैव विदाञ्चकार ब्रह्मेति॥ ४/१॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","चतुर्थः खण्डः","चतुर्थः खण्डः"]},{"id":"ST_talavakara_bhashya_00038","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"","sanskrit_text":"तस्माद् वा एते देवा अतितरामिवान्यान् देवान् यदग्निर्वायुरिन्द्रस्ते ह्येनन्नेदिष्ठं पस्पर्शुस्ते ह्येनत् प्रथमो विदाञ्चकार ब्रह्मेति॥ ४/२॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","चतुर्थः खण्डः","चतुर्थः खण्डः"]},{"id":"ST_talavakara_bhashya_00039","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"","sanskrit_text":"तस्माद् वा इन्द्रोऽतितरामिवान्यान् देवान् स ह्येनन्नेदिष्ठं पस्पर्श स ह्येनत् प्रथमो विदाञ्चकार ब्रह्मेति॥ ४/३॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","चतुर्थः खण्डः","चतुर्थः खण्डः"]},{"id":"ST_talavakara_bhashya_00040","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"","sanskrit_text":"तस्यैष आदेशः। यदेतद् विद्युतो व्यद्युतदा(३) इति। न्यमीमिषदा(३) इत्यधिदैवतम्‌॥ ४/४॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","चतुर्थः खण्डः","चतुर्थः खण्डः"]},{"id":"ST_talavakara_bhashya_00041","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"","sanskrit_text":"अथाध्यात्मम्। यदेतद् ‌गच्छतीव च मनोऽनेन चैनदुपस्मरत्यभीक्ष्णं सङ्कल्पः॥ ४/५॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","चतुर्थः खण्डः","चतुर्थः खण्डः"]},{"id":"ST_talavakara_bhashya_00042","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"","sanskrit_text":"तद्ध तद् वनं नाम। तद् वनमित्युपासितव्यम्। स य एतदेवं वेदाभि हैनं सर्वाणि भूतानि सं वाञ्छन्ति॥ ४/६॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","चतुर्थः खण्डः","चतुर्थः खण्डः"]},{"id":"ST_talavakara_bhashya_00043","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"","sanskrit_text":"उपनिषदं भो ब्रूहीति। उक्ता त उपनिषत्। ‌ब्राह्मीं वाव त उपनिषदमब्रूमेति॥ ४/७॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","चतुर्थः खण्डः","चतुर्थः खण्डः"]},{"id":"ST_talavakara_bhashya_00044","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"","sanskrit_text":"तस्यै तपो दमः कर्मेति प्रतिष्ठा। वेदाः सर्वाङ्गानि सत्यमायतनम्‌॥ ४/८॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","चतुर्थः खण्डः","चतुर्थः खण्डः"]},{"id":"ST_talavakara_bhashya_00045","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"","sanskrit_text":"यो वा एतामेवं वेदापहत्य पाप्मानमनन्ते स्वर्गे लोके(ऽ)ज्येये प्रतितिष्ठति प्रतितिष्ठति॥ ४/९॥","artha":"","notes":"","tags":["Mula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","चतुर्थः खण्डः","चतुर्थः खण्डः"]},{"id":"ST_talavakara_bhashya_00046","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"","sanskrit_text":"“वैजयन्ते समासीनमेकान्ते चतुराननम्। विष्णोर्विविदिषुस्तत्त्वं पर्यपृच्छत् सदाशिवः। यदि सत्पुरुषावश्यं तत्रतत्र पतेन्मनः। केन तत् प्रेरितं याति प्राणः सर्वोत्तमस्तथा। चक्षुः श्रोत्रं तथा वाचं को देवो विनियोजयेत्। इति पृष्टस्तदा ब्रह्मा प्राह देवमुमापतिम्। ध्यात्वा नारायणं देवं सर्वाधारमनूपमम्। सर्वज्ञं सर्वशक्तिं च सर्वदोषविवर्जितम्॥ *॥","artha":"","notes":"","tags":["Sarvamula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","चतुर्थः खण्डः","चतुर्थः खण्डः"]},{"id":"ST_talavakara_bhashya_00047","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"","sanskrit_text":"यः प्राणस्य प्रणेता च चक्षुरादेश्च सर्वशः। अगम्यः सर्वदेवैश्च परिपूर्णत्वहेतुतः। प्राणादीनां प्रणेता च सर्ववेत्ता च सर्वशः। सर्वोत्तमश्च सर्वत्र स विष्णुरिति धार्यताम्॥ *॥","artha":"","notes":"","tags":["Sarvamula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","चतुर्थः खण्डः","चतुर्थः खण्डः"]},{"id":"ST_talavakara_bhashya_00048","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"","sanskrit_text":"यं सम्यङ् नैव जानाति कश्चिन्निरवशेषतः॥ *॥","artha":"","notes":"","tags":["Sarvamula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","चतुर्थः खण्डः","चतुर्थः खण्डः"]},{"id":"ST_talavakara_bhashya_00049","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"","sanskrit_text":"सर्वात्मना विजानामीति तु यस्य मतं भवेत्। तस्याज्ञातः स भगवान् यो नैवं मन्यते सदा। ज्ञातस्तस्य तथाऽस्यैव निःशेषं मननं कृतम्। इति यो मन्यते नास्य मतः स पुरुषोत्तमः। नातिवेद्यो नचावेद्यस्तस्मात् स परमेश्वरः॥ *॥","artha":"","notes":"","tags":["Sarvamula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","चतुर्थः खण्डः","चतुर्थः खण्डः"]},{"id":"ST_talavakara_bhashya_00050","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"","sanskrit_text":"नेदं जीवस्वरूपं तद् ब्रह्म विष्ण्वाख्यमव्ययम्। किन्तु यत् ते समीपस्थमास ते विनियामकम्। तदेव ब्रह्म विद्धि त्वं विष्ण्वाख्यं परमव्ययम्। नियामकं तद् देवानां मर्त्यानां किमुतोत्तमम्। तत्प्रसादं विना जीवे मन्तव्या न प्रवृत्तयः। किमु जीवस्य तद्भावो न मन्तव्य इतीर्यते॥ *॥","artha":"","notes":"","tags":["Sarvamula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","चतुर्थः खण्डः","चतुर्थः खण्डः"]},{"id":"ST_talavakara_bhashya_00051","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"","sanskrit_text":"इत्यत्राख्यायिकां वच्मि शृणु तां त्वं महेश्वर। स्थित्वा देवेषु तद् ब्रह्म व्यजयद् दैत्यदानवान्। देवेभ्योऽर्थाय विजयं ते देवा मेनिरे स्वकम्। आविष्टा असुरैस्तेषां प्रबोधाय जनार्दनः। यक्षरूपः प्रादुरभूदुमाशिवसमन्वितः। ब्रह्मणा चापि सहित एतेभ्योऽपि परो ह्यहम्। एतेऽपि मे भृत्यभूताः परिवार्य व्यवस्थिताः। इति ज्ञापयितुं विष्णुः सह तैरप्युपागतः। यूयमेतानपि ज्ञातुमशक्ताः किमु मामिति॥ *॥","artha":"","notes":"","tags":["Sarvamula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","चतुर्थः खण्डः","चतुर्थः खण्डः"]},{"id":"ST_talavakara_bhashya_00052","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"","sanskrit_text":"तज्ज्ञानार्थं हुताशश्च नासिक्यो वायुरेव च। इन्द्रश्च क्रमशो जग्मुस्तं ज्ञातुं नैव चाशकन्। तत्रेन्द्रोऽधिकबुद्धित्वात् पृच्छतीति जनार्दनः। मत्तः शिवाद् ब्रह्मणश्च श्रोतुं नैवापि शक्तिमान्। इति ज्ञापयितुं तत्र नादृश्यत स केशवः। एषैव ज्ञानदाने ते योग्योमेति व्यदर्शयत्॥ *॥","artha":"","notes":"","tags":["Sarvamula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","चतुर्थः खण्डः","चतुर्थः खण्डः"]},{"id":"ST_talavakara_bhashya_00053","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"","sanskrit_text":"उमा सा सम्यगाचष्ट तस्मै विष्णुं परं पदम्। यस्माद् ब्रह्मा च वायुश्च शेषवीन्द्रौ शिवस्तथा। सभार्या गर्विणो नासन् सुरेभ्यस्तेऽधिकास्ततः। इन्द्रस्तु प्रथमं ब्रह्म व्यजानात् तेन तूत्तमः। दक्षादिभ्यस्तथा कामस्तज्ज्ञातुं पूर्वमुक्तवान्। दक्षो बृहस्पतिश्चैव मनुः कामात्मजस्तथा। सूर्याचन्द्रमसौ धर्मो वरुणश्चोचुरोमिति। नासिक्यवायुरग्निश्च प्रथमं तदपश्यताम्। सर्वदेवाधिकास्तस्मादेते देवाः प्रकीर्तिताः। एतेभ्यश्चेन्द्रकामौ तु ताभ्यां ब्रह्मादयोऽधिकाः। एतेषामवमो वह्निः परमो विष्णुरुच्यते। अन्तराले स्थितास्त्वन्ये ब्रह्माद्याः पूर्वमीरिताः। अग्निः पश्चाद् व्यजानात् तदिन्द्रवाक्यात् ततोऽवमः। तस्माद् विष्ण्वभिसम्बन्धात् पारावर्यं सुरेष्विदम्॥ *॥","artha":"","notes":"","tags":["Sarvamula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","चतुर्थः खण्डः","चतुर्थः खण्डः"]},{"id":"ST_talavakara_bhashya_00054","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"","sanskrit_text":"व्यद्योतयद् विद्युदादीन् कपिलाख्यस्तु यो हरिः। अक्ष्णोर्निमेषणं कृत्वा यः शेते क्षीरसागरे। स एवैकः परं ब्रह्मेत्येवं तस्योपदेशनम्। अधिदैवे तथाऽध्यात्मे यं मनो गच्छतीव च। सम्यङ् न गच्छति क्वापि मनो येन स्मरत्यपि। सोऽनिरुद्धाख्य ईशेशः परं ब्रह्मेति कीर्त्यते। स विष्णुस्तद् वनं नाम ततत्वाद् वननीयतः। एवमेनं तु यो वेद भवेत् सर्वैरपेक्षितः। एतच्छ्रुत्वा हरोऽपृच्छद् ब्रह्माणं पुनरेव तु। विद्याकारं मम ब्रूहीत्युक्तो ब्रह्माऽऽह तं पुनः। विद्यावेद्यं तव प्रोक्तमास्थानं ते वदाम्यहम्। तपोदमस्वधर्मेषु ये स्थितास्तेषु तिष्ठति। विद्या स्थानानि तस्यास्तु वेदा अङ्गानि निर्णयः। वेदैतामेवमखिलं यो विष्णौ प्रतितिष्ठति॥” इत्यादि ब्रह्मपारे।","artha":"","notes":"","tags":["Sarvamula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","चतुर्थः खण्डः","चतुर्थः खण्डः"]},{"id":"ST_talavakara_bhashya_00055","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"","sanskrit_text":"विद्युत्सूर्यादिप्रकाशान् आ समन्ताद् व्यद्युतत् प्राकाशयत्।","artha":"","notes":"","tags":["Sarvamula"],"references":[{"kind":"pathantara","block":"ba4d6fa5-22c0-4bdf-b5a9-effa87ff88f5","readings":{"setutila":"विद्युत्सूर्यादिप्रकाशान्","trk_patha":"विद्युत्सूर्यादिप्रकाशान्","bg_patha":"विद्युतः सूर्यादिप्रकाशान्"}}],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","चतुर्थः खण्डः","चतुर्थः खण्डः"]},{"id":"ST_talavakara_bhashya_00056","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"","sanskrit_text":"“यदादित्यगतं तेजो जगद् भासयतेऽखिलम्। यच्चन्द्रमसि यच्चाग्नौ तत् तेजो विद्धि मामकम्॥” 🔗 भगवद्गीता १५/१२ इति वचनात्।","artha":"","notes":"","tags":["Sarvamula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","चतुर्थः खण्डः","चतुर्थः खण्डः"]},{"id":"ST_talavakara_bhashya_00057","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"","sanskrit_text":"“तमेव भान्तमनुभाति सर्वं तस्य भासा सर्वमिदं विभाति” 🔗 आथर्वणोपनिषत् २/२/१३ इति च।","artha":"","notes":"","tags":["Sarvamula"],"references":[],"audio":[],"breadcrumb":["उपनिषत्प्रस्थानम्","तलवकारोपनिषद्भाष्यम्‌","चतुर्थः खण्डः","चतुर्थः खण्डः"]},{"id":"ST_talavakara_bhashya_00058","reference":"तलवकारोपनिषद्भाष्यम्‌ > चतुर्थः खण्डः > चतुर्थः खण्डः","section":"चतुर्थः खण्डः","unit_title":"","sanskrit_text":"न्यमीमिषत्। आ समन्तान्निमीलिताक्षमभवत्।","artha":"","notes":"","tags":["Sarvamula"],"references":[{"kind":"pathantara","block":"cd6b8940-