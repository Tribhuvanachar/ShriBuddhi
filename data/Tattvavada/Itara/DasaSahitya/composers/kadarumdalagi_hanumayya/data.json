ಅಜತ ನಾಮಕನೆ ಆದಿ ದೈವವೆಂದು","ತ್ರಿಜಗಮ ತಿಳಿವಂತೆ","ನಿಜ ಪುರುಷನಿಗೆ ವನಮಾಲೆಯ ಹಾಕಿ","ಭಜಿಸಿದೆ ಬಲವಂತೆ","ಕಮಲಜ ಮೊದಲಾದ ಸುಮನಸರಿಂದಲಿ","ಕ್ರಮದಿ ಪೂಜೆಗೊಂಬೆ","ಸಮನಿಲ್ಲದ ಸೌಭಾಗ್ಯವ ಕೊಡು","ನೀ ಮಹ ಜಗದಂಬೆ","ಕಮಲವಾರಿಧೆ ಕಮಲಲೋಚನೆ","ಕರವೀರ ಪುರಧೀರೆ","ವರ ಕದರುಂಡಲಗಿ ಹನುಮಯ್ಯನೊಡೆಯನಉರದೊಳು ಸ್ಥಿರವಾಸೆ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":91,"keerthana_id":834,"category_raw":0,"favorite":false,"header_stripped":["ಕದರುಂಡಲಗಿ ಹನುಮಯ್ಯ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"kadarumdalagi_hanumayya__dasa1_835","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಶರಣು ಹೊಕ್ಕೆನು ಕಾಯೆ ಶ್ರೀ ತುಳಸಿ","latin":"","iast":"śaraṇu hòkkènu kāyè śrī tuḻasi","devanagari":"शरणु हॊक्कॆनु कायॆ श्री तुळसि"},"composer":"ಕದರುಂಡಲಗಿ ಹನುಮಯ್ಯ","composer_iast":"kadaruṃḍalagi hanumayya","deity":"","tags":["composer:ಕದರುಂಡಲಗಿ ಹನುಮಯ್ಯ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ತುಳಸೀದೇವಿಯ ಮೇಲಿನ ಈ ಹಾಡಿನಲ್ಲಿ","(ಅ)","ತುಳಸಿದೇವಿ","ಶರಣು ಹೊಕ್ಕೆನು ಕಾಯೆ ಶ್ರೀ ತುಳಸಿ ತಾಯೆ","ನಾರಾಯಣನ ಪ್ರೀಯೇ","ತರಣಿಕೋಟಿ ದಿವ್ಯ ಪ್ರಕಾಶ","ಹರಿಚರಣಕಮಲಕಾಭರಣಿಯೆನಿಪಳೆ ಪ","ಉದಧಿಯೊಳುದಿಸಿದಮೃತವ","ಮುದದಿಂದಲಿ ಶ್ರೀಧರನು ನೋಡಿ ಸ್ವೀಕಾರವನು ಮಾಡಿ ಆ-","ನಂದಲಾನಂದ ಬಾಷ್ಪಗಳು ಉದುರಲಕ್ಷಿಯೊಳು","ಉದುಭವಿಸಿದೆಯೆ ನೀನು ಪದುಮಮುಖಿಯೆ ನಿಮ್ಮ","ಅದುಭುತ ಮಹಿಮೆಯು ಪದ ಕವಿಗಳಿಗೆಲ್ಲ ಪೊಗಳಲಸಾಧ್ಯ","ನಿಮ್ಮ ಮೂಲ ಮಧ್ಯಾಗ್ರದಲಿ ಬ್ರಹ್ಮಾದಿ ಸುರರು","ಸುಮ್ಮನದಿಂದ ಒಲಿದಿಹರು","ಒಮ್ಮನದಿಂದ ಸ್ತುತಿಸಲು ಶುಭಗುಣವಂತೆ","ಧರ್ಮಾರ್ಥ ಕಾಮ ಮೋಕ್ಷಗಳ ಗಮ್ಮನೆ ಕೊಡುವ","ನಮ್ಮಮ್ಮಗೊಲಿದು ನಿನ್ನಮ್ಮಿದವರಿಗಾಧರ್ಮದ ನಿಧನೆ (?)","ನಿಷ್ಠೀಲಿ ನಿಮ್ಮ ಭಜಿಸುವ ಭಕುತರಿಗೆ ಬಂದ","ಕಷ್ಟವ ಕಳೆದು ಕೈವಿಡಿದು","ದುಷ್ಟ ಸಂಗವನೆ ಬಿಡಿಸಿ ಇಹಪರದಲ್ಲಿ ವಿಷ್ಣುಭಕ್ತರಿವರೆಂದೆನಿಸಿ","ಶ್ರೇಷ್ಟ ಕದುರುಂಡಲಗಿ ಹನುಮಯ್ಯನೊಡೆಯನು ಶ್ರೀ-","ಕೃಷ್ಣನ ಲೋಕದಿ ಸಂತುಷ್ಟಬಡಿ