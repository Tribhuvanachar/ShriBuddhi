ದಂಥ ನಾಸವ್ಯಾಕೆ","ಹರಿಯ ನೈವೇದ್ಯ ಭುಂಜಿಸದಂಥಾ ಉದರವ್ಯಾಕೆ","ಹರಿಯದಾಸರ ಕೊಡಿ ತಿರುಗದ ಚರಣವ್ಯಾಕೆ","ಶರಣಜನರ ಚರಣ ತೊಳೆಯದ ಕರವು ಏಕೆ","ಪ್ರಾನನಾಥವಿಠಲನ ಪಾಡದ ಜಿಹ್ವೆ ಏಕೆ","ಜಾಣರೆಲ್ಲರು ತಿಳಿದು ನೋಡಿ ಬದುಕಿ ಜೋ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":165,"keerthana_id":8532,"category_raw":0,"favorite":false,"header_stripped":["ಬಾಗೇಪಲ್ಲಿ ಶೇಷದಾಸರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"bagepalli_sesadasaru__dasa1_8533","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ನಡೆದು ಬಾರಯ್ಯ ಪ್ರಾಣರಾಯ ಪಿಡಿ ಎನ್ನ ಕೈಯಾ","latin":"","iast":"naḍèdu bārayya prāṇarāya piḍi ènna kaiyā","devanagari":"नडॆदु बारय्य प्राणराय पिडि ऎन्न कैया"},"composer":"ಬಾಗೇಪಲ್ಲಿ ಶೇಷದಾಸರು","composer_iast":"bāgepalli śeṣadāsaru","deity":"","tags":["composer:ಬಾಗೇಪಲ್ಲಿ ಶೇಷದಾಸರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಇದು ಬಾಗೇಪಲ್ಲಿ","ನಡೆದು ಬಾರಯ್ಯ ಪ್ರಾಣರಾಯ ಪಿಡಿ ಎನ್ನ ಕೈಯಾ ಪ","ಕಡುಬಡಜನರಿಗೆ ಒಡೆಯನಾಗಿ ನೀ","ಸಡಗರದಲಿ ಕರ ಪಿಡಿದು ಪೊರೆವುದಕೆ","ಭಾಗ್ಯಪುರಿಯೊಳಗೆ ಭಾಗವತರಿಗೆಲ್ಲ","ಯೋಗ್ಯಮಾರ್ಗವನು ಬೇಗನೆ ತೋರಲು","ಅನಾಥನಾಥ ಪ್ರಾಣನಾಥ ವಿಠ್ಠಲನ ದೂತನೀ","ನೆನೆಸಿ ಭಕ್ತಜನರ ಸಂತೋಷಪಡಿಪುದಕೆ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":165,"keerthana_id":8533,"category_raw":0,"favorite":false,"header_stripped":["ಬಾಗೇಪಲ್ಲಿ ಶೇಷದಾಸರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"bagepalli_sesadasaru__dasa1_8534","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ನಾರಿ ನಾನರಿಯೆನೆ ನಿನ್ನಯ ಮಹಿಮ","latin":"","iast":"nāri nānariyènè ninnaya mahima","devanagari":"नारि नानरियॆनॆ निन्नय महिम"},"composer":"ಬಾಗೇಪಲ್ಲಿ ಶೇಷದಾಸರು","composer_iast":"bāgepalli śeṣadāsaru","deity":"","tags":["composer:ಬಾಗೇಪಲ್ಲಿ ಶೇಷದಾಸರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಇದು ಶ್ರೀಲಕ್ಷ್ಮೀದೇವಿಯ ಮಹಿಮೆಯನ್ನು","ನಾರಿ ನಾನರಿಯೆನೆ ನಿನ್ನಯ ಮಹಿಮ","ಕರುಣದಿ ಇಡು ಪ್ರೇಮ ಪ","ಬಾರಿ ಬಾರಿಗೆ ನಿನ್ನ ಭಜಿಸುವ ಭಕ್ತರ","ಪಾರುಗಾಣಿಸಿ ಪೊರೆ ನಾರಿ ಶಿರೋಮಣಿ ಅ.ಪ","ಕನಸು ಮನಸಿನೊಳ್ ನಿನ್ನಯ ಧ್ಯಾನ ಬಿಡದಲೆ ನಾ ಇನ್ನ","ನೆನಸಿ ನೆನಸಿ ಸುಖಿಸುವೆ ಮುನ್ನ ವನಜಾಕ್ಷಿಯೆ ನಿನ್ನ","ಅನುದಿನ ನಿನ್ನನು ಸ್ಮರಿಸುವ ಸುಜನರ","ಘನವನುಳುಹಿ ಕಾಯೆ ಮನಸಿಜನ ತಾಯೆ","ಸೃಷ್ಟಿಯೊಳಗೆ ಶೆಟ್ಟಿ ಕೆರೆಯ ತಟದಲಿ ನೀ ನಿಂತು","ಶ್ರೇಷ್ಠಳೆನಿಸಿ ಭಕ್ತರ ಮೊರೆಯ ನಿತ್ಯದಿ ನೀನರಿತು","ಇಷ್ಟದಿ ಕೇಳುತ ಶಿಷ್ಟಜನರ ಅಘ","ಹಿಟ್ಟುಮಾಡಿ ಕಾಯೆ ಶ್ರೀ ಕೃಷ್ಣನ ಜಾಯೆ","ಮದನನಯ್ಯನ ಮೋಹದ ರಾಣಿ ಮದಮುಖದ ಶ್ರೇಣಿ","ವಧಿಸಿದ್ಯೆಲೆ ಪರಮ ಕಲ್ಯಾಣಿ ಜಗದೊಳಗತಿ ಜಾಣೆ","ಮದಗೊಂಡನ ಪುರಿ ಸದನ ಮಾಡಿಕೊಂ","ಡೊದಗಿ ಭಕ್ತರ ಮುದವಪಡಿಸಿದ್ಯೆಲೆ","ಜಗದೊಳು ನಿನಗೆ ಸರಿಯಾರೆ ಪರಿಪರಿ ವಯ್ಯಾರೆ","ಅಗಣಿತ ಗುಣಗಂಭೀರೆ ಸುಂದರ ಸುಕುಮಾರೆ","ಬಗೆಯಲಿ ಎನ್ನವಗುಣಗಣ ವೆಣಿಸದೆ","ಸೊಗದಿಂದಲಿ ಕಾಯೆ ನಗಧರನ ಪ್ರಿಯೆ","ಅನುವನರಿತು ಪಾಲಿಸು ಮುನ್ನನಂಬಿದ ಮನುಜರನ","ಅನುದಿನ ನಿನ್ನ ಪಾದಧ್ಯಾನ ಮನಸಿಗೆ ಕೊಟ್ಟೆನ್ನ","ವನಜಾಕ್ಷಶ್ರೀ ಪ್ರಾಣನಾಥ ವಿಠಲನ","ಸನ್ನಿಧಾನವಿತ್ತು ಮನ್ನಿಸು ತಾಯೆ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":165,"keerthana_id":8534,"category_raw":0,"favorite":false,"header_stripped":["ಬಾಗೇಪಲ್ಲಿ ಶೇಷದಾಸರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"bagepalli_sesadasaru__dasa1_8535","form":"pada","form_confidence":"default bucket, not a positive signal","ti