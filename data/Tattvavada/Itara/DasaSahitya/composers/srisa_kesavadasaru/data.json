2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":142,"keerthana_id":12597,"category_raw":0,"favorite":false,"header_stripped":["ಶ್ರೀಶ ಕೇಶವದಾಸರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"srisa_kesavadasaru__dasa1_12598","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಗುರುರಾಜ ನಿನ್ನ ಹೊರತು","latin":"","iast":"gururāja ninna hòratu","devanagari":"गुरुराज निन्न हॊरतु"},"composer":"ಶ್ರೀಶ ಕೇಶವದಾಸರು","composer_iast":"śrīśa keśavadāsaru","deity":"","tags":["composer:ಶ್ರೀಶ ಕೇಶವದಾಸರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಇದು ಕಡೂರಿನಲ್ಲಿ ಭೀಮಸೇತು","ಗುರುರಾಜ ನಿನ್ನ ಹೊರತು ಪೊರೆವ ಧೊರೆಗಳ ಕಾಣೆ |","ಶರಣಜನರಿಷ್ಟವನೆ ಸುರತರುವಿನಂತೀವೆ ಪ","ತರಳಪ್ರಹ್ಲಾದನಾಗಿರಲು ವರಭಕುತಿಯಿಂ |","ನರಹರಿಯ ಮೆಚ್ಚಿಸಿದೆ ಪರಮಕರುಣಾಸಿಂಧೊ","ವ್ಯಾಸಮುನಿಯು ನೀನೆ ವಾಸುದೇವನ ಭಜಿಸಿ |","ಲೇಸಾದ ಚಂದ್ರಿಕೆಯ ಭೂಸುರರಿಗರುಹಿದೆ","ಶ್ರೀರಾಮಚಂದ್ರಪದಸರಸೀರುಹಾಭೃಂಗ |","ಶ್ರೀ ರಾಘವೇಂದ್ರಯತಿ ಸುರುಚಿರಕೃಪಾಪಾಂಗ","ನರಹರಿ ಸಿರಿರಾಮ ಮುರವೈರಿ ಮುನಿವ್ಯಾಸ |","ಇರುತಿಹರು ನಿನ್ನೊಳು ಧರೆಯ ಪಾಲಿಸೆ ಮುದದಿ","ಕರೆದಲ್ಲಿ ಬರುವೆನೆಂದೊರೆದ ವಚನವ ಸಲಿಸೆ |","ಭರದಿ ನಾರಾಯಣಪುರಕೈದಿದಿಯೊ ಮುದದಿ","ಭೀಮಸೇತ್ವ್ಯಾಖ್ಯ ಮಠ ಸೋಮರಘುತಿಲಕರಿಂ |","ದೇ ಮಹಾಸೇವೆಯ ಕೈಗೊಂಡೆಯೋ ಮುದದಿ","ದೋಷದೂರನೆ ಪ್ರಭುವೆ ಆಶೆಯಿಂ ಸೇವಿಪರ |","ಕ್ಲೇಶವೆಲ್ಲವನಳಿದು ಶ್ರೀಶಕೇಶವನೊಲಿಸೊ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":142,"keerthana_id":12598,"category_raw":0,"favorite":false,"header_stripped":["ಶ್ರೀಶ ಕೇಶವದಾಸರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"srisa_kesavadasaru__dasa1_12599","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಚರಣಕಮಲಯುಗಕೆ ನಮಿಪೆ","latin":"","iast":"caraṇakamalayugakè namipè","devanagari":"चरणकमलयुगकॆ नमिपॆ"},"composer":"ಶ್ರೀಶ ಕೇಶವದಾಸರು","composer_iast":"śrīśa keśavadāsaru","deity":"","tags":["composer:ಶ್ರೀಶ ಕೇಶವದಾಸರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಶ್ರೀ ರಾಘವೇಂದ್ರ ಸ್ವಾಮಿಗಳ ಅವತಾರ","ಚರಣಕಮಲಯುಗಕೆ ನಮಿಪೆ ನಿರುತವನುದಿನ |","ಶ್ರೀ ರಾಘವೇಂದ್ರ ಪ","ಪರಿಪರಿ ಶರಣರ ಪೊರೆಯುವ","ಕರುಣಾಸಾಂದ್ರ ಯತಿಕುಲೇಂದ್ರ ಅ.ಪ","ವೇನಮತವಿದಾರ ಸುಂದರ ಜ್ಞಾನದಾತ ಗುರುವರ |","ಶ್ರೀನಾಥನ ಪದಪಂಕಜಧ್ಯಾನನಿರತ ಸುಗುಣಭರಿತ","ಮಧ್ವಶಾಸ್ತ್ರಪಠಿಸಿ ಬಹುಪ್ರಸಿದ್ಧಟೀಕೆ ರಚಿಸುತ |","ಸದ್ವೈಷ್ಣವ ಸಿದ್ಧಾಂತವೇ ಶುದ್ಧವೆನಿಸಿ ಮೆರೆದ ಧೀರಾ","ನರಹರಿ ಸಿರಿರಾಮಕೃಷ್ಣ ವರವೇದವ್ಯಾಸರು |","ಇರುತಿರುವರು ನಿನ್ನೊಳು ತವ ಪರಿಜನ ಸೇವೆಗಳ ಕೊಳುತ","ವಾರಾಹಿ ಸುಕ್ಷೇತ್ರನಿಲಯ ಚಾರುಚರಿತ ಗುಣಮಯ |","ಆರಾಧಿಪ ದೀನಾಳಿಗೆ ಸಾರಸೌಖ್ಯವೀವ ಕಾವ","ಶ್ರೀಶಕೇಶವಾಂಘ್ರಿದೂತ ದಾಸಜನನುತ |","ಲೇಸಾಗಿಹ ಭೂಸುರ ಸಹವಾಸವಿತ್ತು ಕರುಣಿಸಯ್ಯ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":142,"keerthana_id":12599,"category_raw":0,"favorite":false,"header_stripped":["ಶ್ರೀಶ ಕೇಶವದಾಸರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"srisa_kesavadasaru__dasa1_12600","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಜೈ ಜೈ ವಿಠ್ಠಲ ಪಾಂಡುರಂಗ","latin":"","iast":"jai jai viṭhṭhala pāṃḍuraṃga","devanagari":"जै जै विठ्ठल पांडुरंग"},"composer":"ಶ್ರೀಶ ಕೇಶವದಾಸರು","composer_iast":"śrīśa keśavadāsaru","deity":"","tags":["composer:ಶ್ರೀಶ ಕೇಶವದಾಸರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಇದು ಶ್ರೀ ಪಾಂಡುರಂಗ ವಿಠ್ಠಲನ ಭಜನೆ.","ಶ್ರೀಹರಿಸ್ತುತಿ","ಜೈ ಜೈ ವಿಠ್ಠಲ ಪಾಂಡುರಂಗ |","ಜೈ ಹರಿ ವಿಠ್ಠಲ ಪಾಂಡುರಂಗ","ಮಕರಕುಂಡಲಧರ ಪಾಂಡುರಂಗ |","ರಕುಮÁಯೀಧವ ಪಾಂಡುರಂಗ","ರಾಧಾರಾಧಿತ ಪಾಂಡುರಂಗ |","ಸಾಧುಜನಾರ್ಚಿತ ಪಾಂಡುರಂಗ","ನೀಲಶರೀರ ಪಾಂಡುರಂಗ |","ಕಾಲಾಂತಕಪ್ರಿಯ ಪಾಂಡುರಂಗ","ಸರಸಿಜವದನ ಪಾಂಡುರಂಗ |","ಕರಿರಾಜವರದ ಪಾಂಡುರಂಗ","ವನಜಲೋಚನ ಪಾಂಡುರಂಗ |","ವನಜಾಸನನುತ ಪಾಂಡುರಂಗ","ಕಟಿಕರದ್ವಯ ಪಾಂಡುರಂಗ |","ಕುಟಿಲಾಂತಕಹರೆ ಪಾಂಡುರಂಗ","ಪಾವನಚರಣ ಪಾಂಡುರಂಗ |","ಭಾವಜಪಿತಹರೆ ಪಾಂಡುರಂಗ","ಮಣಿಮಕುಟಧರ ಪಾಂಡುರಂಗ |","ಫಣಿಪತಿಶಯನ ಪಾಂಡುರಂಗ","ಸಿರಿವತ್ಸಾಂಕಿತ ಪಾಂಡುರಂಗ |","ದುರಿತವಿದೂರ ಪಾಂಡುರಂಗ","ವನಮಾಲಾಂಕಿತ ಪಾಂಡುರಂಗ |","ವನಜನಾಭಹರೆ ಪಾಂಡುರಂಗ","ಪೀತಾಂಬರಧರ ಪಾಂಡುರಂಗ |","ವಾತಾತ್ಮಜನುತ ಪಾಂಡುರಂಗ","ಖಗಪತಿವಾಹನ ಪಾಂಡುರಂಗ |","ಜಗದೋದ್ಧಾರ ಪಾಂಡುರಂಗ","ಪಂಡರಾಪುರಾಧಿಪ ಪಾಂಡುರಂಗ |","ಪುಂಡರೀಕವರದ ಪಾಂಡುರಂಗ","ಮೀನಶರೀರ ಪಾಂಡುರಂಗ |","ದೀನಮಂದಾರ ಪಾಂಡುರಂಗ","ಮಂದರಧರ ಶ್ರೀ ಪಾಂಡುರಂಗ |","ಸಿಂಧುಶಯನಹರೆ ಪಾಂಡುರಂಗ","ಸೂಕರರೂಪಕ ಪಾಂಡುರಂಗ |","ಶ್ರೀಕರಸೇವಿತ ಪಾಂಡುರಂಗ","ನರಕಂಠೀರವ ಪಾಂಡುರಂಗ |","ನರಕಾಂತಕಹರೆ ಪಾಂಡುರಂಗ","ವಾಮನವೇಷ ಪಾಂಡುರಂಗ |","ಸಾಮಗಾನಪ್ರಿಯ ಪಾಂಡುರಂಗ","ಕ್ಷಾತ್ರಕುಲಾಂತಕ ಪಾಂಡುರಂಗ | ಧಾತ್ರೀರಮಣ ಪಾಂಡುರಂಗ","ರಾಮಚಂದ್ರಹರೆ ಪಾಂಡುರಂಗ |","ಕಾಮಿತಫಲದ ಪಾಂಡುರಂಗ","ದೇವಕಿನಂದನ ಪಾಂಡುರಂಗ |","ಪಾವನಚರಿತ ಪಾಂಡುರಂಗ","ಬತ್ತಲೆನಿಂದಿಹ ಪಾಂಡುರಂಗ |","ಉತ್ತಮದೇವನೆ ಪಾಂಡುರಂಗ","ತೇಜಿಯನೇರಿದ ಪಾಂಡುರಂಗ |","ಸೋಜಿಗಪುರುಷನೆ ಪಾಂಡುರಂಗ","ಗಾನವಿನೋದಿ ಪಾಂಡುರಂಗ |","ಭಾನುಪ್ರಕಾಶ ಪಾಂಡುರಂಗ","ಸುರನರವಂದಿತ ಪಾಂಡುರಂಗ |","ಸುರಭಿನಿವಾಸ ಪಾಂಡುರಂಗ","ಮುಕುತಿದಾಯಕ ಪಾಂಡುರಂಗ |","ಭಕುತಪೋಷಕ ಪಾಂಡುರಂಗ","ಅಗಣಿತಗುಣಗಣ ಪಾಂಡುರಂಗ |","ತ್ರಿಗುಣಾತೀತಾ ಪಾಂಡುರಂಗ","ಚಂದ್ರಭಾಗನುತ ಪಾಂಡುರಂಗ |","ಚಂದ್ರಮೌಳಿಹಿತ ಪಾಂಡುರಂಗ","ಸುರನದಿಜನಕ ಶ್ರೀ ಪಾಂಡುರಂಗ |","ಸುರಮುನಿಸನ್ನುತ ಪಾಂಡುರಂಗ","ಜ್ಞಾನಿಗಳರಸನೆ ಪಾಂಡುರಂಗ |","ದಾನವಾಂತಕ ಪಾಂಡುರಂಗ","ಭಾಸುರಾಂಗ ಶ್ರೀ ಪಾಂಡುರಂಗ |","ಭೂಸುರವಂದಿತ ಪಾಂಡುರಂಗ","ಅಷ್ಟಕರ್ತೃಪ್ರಿಯ ಪಾಂಡುರಂಗ |","ಸೃಷ್ಟಿಗೊಡೆಯ ಶ್ರೀ ಪಾಂಡುರಂಗ","ಸರ್ವವ್ಯಾಪಕ ಪಾಂಡುರಂಗ |","ಉರ್ವಿರಮಣ ಪಾಂಡುರಂಗ","ಕೃತಿರಮಣಹರೆ ಪಾಂಡುರಂಗ |","ಶೃತಿತತಿವಿನುತ ಪಾಂಡುರಂಗ","ಜೀವನಿಯಾಮಕ ಪಾಂಡುರಂಗ |","ಜೀವೋತ್ತಮನುತ ಪಾಂಡುರಂಗ","ಲೋಕನಾಯಕ ಪಾಂಡುರಂಗ |","ನಾಕಾಧಿಪನುತ ಪಾಂಡುರಂಗ","ವೇದವೇದ್ಯವಿಭೋ ಪಾಂಡುರಂಗ |","ಮೋದದಾಯಕ ಪಾಂಡುರಂಗ","ಯೋಗಿರಾಜ ಶ್ರೀ ಪಾಂಡುರಂಗ |","ಭಾಗವತಪ್ರಿಯ ಪಾಂಡುರಂಗ","ಪುರಾಣಪುರುಷ ಪಾಂಡುರಂಗ |","ಕರುಣಿಗಳರಸನೆ ಪಾಂಡುರಂಗ","ಪಾಪನಾಶಕ ಪಾಂಡುರಂಗ |","ತಾಪತ್ರಯಹರೆ ಪಾಂಡುರಂಗ","ಧರ್ಮಸ್ಥಾಪಕ ಪಾಂಡುರಂಗ |","ಕರ್ಮಾಧಿಪತೆ ಪಾಂಡುರಂಗ","ಕಪಿಲವತಾರ ಪಾಂಡುರಂಗ |","ಕಪಟನಾಟಕ ಪಾಂಡುರಂಗ","ಆದಿರಹಿತಹರೆ ಪಾಂಡುರಂಗ |","ಬಾದರಾಯಣ ಪಾಂಡುರಂಗ","ನೊಂದೆನೋ ಭವದೊಳು ಪಾಂಡುರಂಗ |","ಮುಂದೆ ದಾರಿಯೇನೋ ಪಾಂಡುರಂಗ","ದಾಸಜನಪ್ರಿಯ ಪಾಂಡುರಂಗ |","ಪಾಶಪರಿಹರಿಸೊ ಪಾಂಡುರಂಗ","ಎಷ್ಟು ಮಹಿಮೆಯೋ ಪಾಂಡುರಂಗ |","ಎಷ್ಟು ಪೊಗಳಲೋ ಪಾಂಡುರಂಗ","ಕಷ್ಟ ಬಿಡಿಸೋ ನೀ ಪಾಂಡುರಂಗ |","ಇಷ್ಟದಾಯಕ ಪಾಂಡುರಂಗ","ಜನಿಸಲಾರೆನೊ ಪಾಂಡುರಂಗ |","ಜನುಮ ನೀಗಿಸೊ ಪಾಂಡುರಂಗ","ನಿನ್ನ ನಂಬಿಹೆನೋ ಪಾಂಡುರಂಗ |","ಘನ್ನಮಹಿಮನೆ ಪಾಂಡುರಂಗ","ನೀನೆ ಗತಿಯೋ ಹೇ ಪಾಂಡುರಂಗ |","ದೀನವತ್ಸಲನೆ ಪಾಂಡುರಂಗ","ಬೇಡುವೆನನುದಿನ ಪಾಂಡುರಂಗ |","ನೀಡೋ ನಿನ್ನಯ ಪಾದ ಪಾಂಡುರಂಗ","ಜಯಮಂಗಳಹರೆ ಪಾಂಡುರಂಗ |","ಶುಭಮಂಗಳಹರೆ ಪಾಂಡುರಂಗ","ದೋಷದೂರಹರೆ ಪಾಂಡುರಂಗ |","ಶ್ರೀಶಕೇಶವ ಪಾಂಡುರಂಗ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":142,"keerthana_id":12600,"category_raw":0,"favorite":false,"header_stripped":["ಶ್ರೀಶ ಕೇಶವದಾಸರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"srisa_kesavadasaru__dasa1_12601","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ತುಂಗಾತೀರದಿ ನೆಲಸಿಹಗೆ","latin":"","iast":"tuṃgātīradi nèlasihagè","devanagari":"तुंगातीरदि नॆलसिहगॆ"},"composer":"ಶ್ರೀಶ ಕೇಶವದಾಸರು","composer_iast":"śrīśa keśavadāsaru","deity":"","tags":["composer:ಶ್ರೀಶ ಕೇಶವದಾಸರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ದಾವಣಗೆರೆಯಲ್ಲಿರುವ ಶ್ರೀ ರಾಘವೇಂದ್ರ","ತುಂಗಾತೀರದಿ ನೆಲಸಿಹಗೆ |","ಮಂಗಳ ಗುರು ರಾಘವೇಂದ್ರನಿಗೆ |","ಗಂಗಾಜನಕನ ಭಕುತ ಶ್ರೇಷ್ಠ ಯತಿ |","ಪುಂಗವನೆನಿಸುತೆ ಮೆರೆವವಗೆ ||ಮಂಗಳಂ ಜಯ ಮಂಗಳಂ|| ಪ","ದಾವಣಗೆರೆಯೊಳು ನಿಂದವಗೆ|","ಕೋವಿದ ಭೂಸುರ ಸೇವ್ಯನಿಗೆ|","ಧಾವಿಸಿ ಬರುತಿಹ ದೀನಜನಾಳಿಗೆ|","ದೇವ ತರುವಿನಂತೀವನಿಗೆ ||ಮಂಗಳಂ ಜಯ ಮಂಗಳಂ||","ಮಧ್ವಶಾಸ್ತ್ರ ಪಠಿಸಿರುವವಗೆ |","ಶುದ್ಧ ಟೀಕೆಗಳ ರಚಿಸಿದಗೆ|","ಸದ್ವೈಷ್ಣವ ಸುಪ್ರೀತನಿಗೆ ಪರಿ |","ಶುದ್ಧ ಮೂರ್ತಿ ರಾಘವೇಂದ್ರನಿಗೆ ||ಮಂಗಳಂ ಜಯ ಮಂಗಳಂ||","ಶ್ರೀ ಸುಧೀಂದ್ರ ಕರಾಜಾತನಿಗೆ |","ಭಾಸುರ ರಘುವೀರಾರ್ಚಿಪಗೆ|","ಶ್ರೀಶಕೇಶವ ಪಾದಾರಾಧಕಗೆ ಸುರ|","ರೀಶನೆನಿಪ ರಂಗನಾಥನಿಗೆ | ಮಂಗಳಂ ಜಯ ಮಂಗಳಂ||"]],