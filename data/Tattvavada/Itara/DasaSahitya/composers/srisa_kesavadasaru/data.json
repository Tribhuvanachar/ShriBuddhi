| ಗೋಪಾಲ |","ಇಂದು ನೀ ಕಾಯಬೇಕು | ಗೋಪಾಲ ಪ","ಸಿಂಧುಶಯನಯನ್ನ | ಕುಂದುಗಳೆಣಿಸದೆ |","ಬಂದು ನೀ ಸಲಹಬೇಕೋ | ಗೋಪಾಲಅ.ಪ","ನಾನಾಜನುಮದಿ | ನಾನಾರೂಪವ |","ನಾನೆನಿತಾಂತೆನೋ | ಮಾನನಿಧೇ ||","ಹೀನಜನರ ಕೂಡಿ | ನಾನರಿಯದೆ ನಿನ್ನ |","ಶ್ವಾನನಂತಾದೆನಲ್ಲೋ | ಗೋಪಾಲ","ಎಳೆಯತನದಿ ನಾ | ಬೆಳೆದೆನೊ ಲೀಲೆಯೋಳ್ |","ಇಳೆಯಭೋಗಕೆ | ಮನವೆಳೆದಿತೊಪ್ರಾಯ ||","ಕಳೆಯಲು ಪ್ರಾಯವು | ಗಳಿತುದು ಕಾಯ |","ಬಳಲುವೆನಿಳೆಯೊಳಗೆ | ಗೋಪಾಲ","ಸಿರಿಯತನದಿ ನಾ | ಮರೆಯುತ ನಿನ್ನನು |","ಪರಿಪರಿವಿಭವದಿ | ಮೆರೆದೆನೊ ಜೀಯ ||","ಸಿರಿಯು ತಾ ತೊಲಗಲು | ಹೆರರ ಹಾರೈಸಿದೆ |","ಪೊರೆಯುವರಾರಿಹರೋ | ಕೃಪಾಳೋ","ಎನ್ನಪರಾಧ ಗ | ಳಿನ್ನು ಗಣನೆಯಿಲ್ಲ |","ಉನ್ನತಮಹಿಮನೆ | ಘನ್ನಸಂಪನ್ನ ||","ಮುನ್ನಮಾಡಿದ | ಪರಾಧಗಳೆಣಿಸದೆ |","ಮನ್ನಿಪರಾರಿಹರೋ | ಮುರಾರೆ","ಆಶಪಾಶಂಗಳು | ಬೀಸಿದ ಬಲೆಯೊಳು |","ಮೋಸದಿ ಸಿಲುಕುತೆ | ಘಾಸಿಯಾಗಿಹೆನೊ ||","ಶ್ರೀಶಕೇಶವ | ಯನ್ನಕ್ಲೇಶಗಳಳಿಯುತೆ |","ದಾಸನೆಂದೆನಿಸೊ ನಿನ್ನಾ | ಗೋಪಾಲ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":142,"keerthana_id":12609,"category_raw":4,"favorite":false,"header_stripped":["ನಿರ್ಗಮನ"],"unclassified_lines":[],"is_recorded_rendition":true},"_needs_review":false,"also_at":[]}]}