deity":"","tags":["composer:ಸರಸಾಬಾಯಿ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಯಂತ್ರೋದ್ಧಾರಕ ಪ್ರಾಣಸಾಯಿ","ಯಂತ್ರೋದ್ಧಾರಕ ಪ್ರಾಣರಾಯ ಎನ್ನ ಚಿಂತೆ ಹರಿಸೋ ಪ.","ಅಂತರಂಗದಿ ಹರಿಯ ಧ್ಯಾನವ ಮಾಡಿಸೋ ಅ.ಪ.","ನಿನ್ನ ನೋಡಿ ಧನ್ಯಳಾದೆನೊ ಹೊನ್ನು ಹನುಮನೆ","ಎನ್ನ ಪಾಪ ಹರಿಸಿ ಕಾಯೊ ಘನ್ನ ಹನುಮನೆ","ಒಂದು ಅರಿಯದ ಮಂದಮತಿಯಳ ಬಂದು ಕಾಯೋ","ಬಂಧನವ ಬಿಡಿಸಿ ಕಾಯೋ ಸುಂದರಾಂಗನೆ","ತುಂಗಾತೀರದಿ ನಿಂತಿರುವಿ ಮಂಗಳಾಂಗನೆ","ಮಂಗಳ ರಾಮನ ಧ್ಯಾನವ ಮಾಡಿಸು ಎನಗೆ","ಹಂಪಿಯಲಿ ನಿಂತಿರುವಿ ಸೊಂಪಿನಿಂದಲಿ","ಸಂಪಿಗೆ ನೆರಳಲಿ ನೋಡಿದಿ ರಾಮರ ಧ್ಯಾನ ಮಾಡುತ","ರಾಮ ದೂತನೆ ಎನ್ನ ಮೊರೆಯ ಲಾಲಿಸಿ","ರಮಾವಲ್ಲಭವಿಠಲನ ಪಾದ ಬೇಗ ತೋರಿಸೊ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":190,"keerthana_id":12722,"category_raw":0,"favorite":false,"header_stripped":["ಸರಸಾಬಾಯಿ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"sarasabayi__dasa1_12723","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ವೃಂದಾವನದೊಡೆಯ ಸ್ವಾಮಿ","latin":"","iast":"vṛṃdāvanadòḍèya svāmi","devanagari":"वृंदावनदॊडॆय स्वामि"},"composer":"ಸರಸಾಬಾಯಿ","composer_iast":"sarasābāyi","deity":"","tags":["composer:ಸರಸಾಬಾಯಿ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ವೃಂದಾವನ ದಂಡೆಯ ಮಂತ್ರಾಲಯ ನಿಲಯ","ವೃಂದಾವನದೊಡೆಯ ಸ್ವಾಮಿ ಮಂತ್ರಾಲಯನಿಲಯ","ಚಂದದಿ ಬಂದು ದರುಶನವಿತ್ತರು ಸ್ವಾಮಿ ಯತಿರಾಯ ಪ.","ಮೂಢಮತಿಯು ನಾನು ಎನ್ನಗಾಢ ನಿದ್ರೆಯಲಿ","ಮಾಡುತ ಪೂಜೆಯ ಎನಗಾನಂದ ಪಡಿಸಿದನು","ಗುರುನಾರದ ದಿನದಿ ಸ್ವಾಮಿ ಹರಿದಾಸರ ಗೃಹದಿ","ಕರುಣ ತೋರಿ ದರುಶನವಿತ್ತು ಎನಗಾನಂದ ಪಡಿಸಿದರು","ಕರಿರಾಜವರದಾ ಗುರುರಾಜರಿಗೊಲಿದು","ಪರಮಭಕ್ತರ ಮಂದಿರದಿ ಎನಗಾನಂದ ಪಡಿಸಿದರು","ತುಂಗಾತೀರದಲಿ ತಾವು ಚಂದದಿ ನಿಂತು","ಮಂಗಳ ರಾಮನ ಪೂಜೆಯ ಮಾಡಿ","ಎನಗಾನಂದ ಪಡಿಸಿದರು","ರಾಮ ಪೂಜೆಯ ಮಾಡಿ ರಾಮಧ್ಯಾನದಿ ನಿರಂತರ","ರಮಾವಲ್ಲಭವಿಠಲ ಭಜಿಸುವ ಪ್ರಿಯರಿವರು"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":190,"keerthana_id":12723,"category_raw":0,"favorite":false,"header_stripped":["ಸರಸಾಬಾಯಿ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"sarasabayi__dasa1_12724","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಸಂತೆಯ ಬಿದನೂರು","latin":"","iast":"saṃtèya bidanūru","devanagari":"संतॆय बिदनूरु"},"composer":"ಸರಸಾಬಾಯಿ","composer_iast":"sarasābāyi","deity":"","tags":["composer:ಸರಸಾಬಾಯಿ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಸಂಜೀವನವ ತಂದ ಶೂರ","ಸಂತೆಯ ಬಿದನೂರು ಹನುಮಂತ","ಎನ್ನ ಅಂತರಂಗದಲಿ ಹರಿಯ ತೋರು ಹನುಮಂತ ಪ.","ಎನ್ನ ಮೇಲೆ ಪಂಥ ಬೇಡ ನಿಂತು ಬೇಡುವೆ ಹನುಮಂತ ಅ.ಪ.","ಅಂಜನಾದೇವಿಯ ಕುಮಾರ ಅಂಜಿಸುವ ಈ ಘೋರ ಸಂಸಾರ","ಅಂಜಿಕೆಯ ಬಿಡಿಸೆನ್ನ ಕಾಯೊ ಬಲು ಧೀರ ಸುಗುಣ ಗಂಭೀರ","ಸಂಜೀವನನ ಕಂಡ ಶೂರ ಅಂಜನಾದೇವಿಯ ಕುಮಾರ","ಕುಂತಿಯಾ ಸುತನಾಗಿ ನೀ ಜನಿಸಿ ಬಂದೇ","ಪಂಥದಲಿ ಕೀಚಕನ ಸೋಲಿಸಿ ನಿಂತು","ಕಂತುಪಿತನಿಗೆ ದುರ್ಯೋದನನ ಶಿರವ ಒಪ್ಪಿಸಿದೆ","ಮದ್ದಿಗೆ ಭಟ್ಟರಲಿ ನೀ ಜನಿಸೀ","ಮಧ್ವಮತವನೆ ಉದ್ಧರಿಸಿ ನೀ ಬದರಿಯಲಿ ನಿಂದಿ","ಮುದ್ದು ಕೃಷ್ಣನ ಪೂಜಿಸಿ ಉಡುಪಿಲಿ ಸ್ಥಾಪಿಸಿ","ಸಂತೆಬಿದನೂರಿನಲಿ ನಿಂತು ಬಂದ ಜನಕೆ ಆನಂದ ಪಡಿಸಿ","ಸಂತೋಷದಿಂದ ವರಗಳ ಬೇಡಿದವರಿಗೆ ನೀಡುತ್ತ","ಕಂತುಪಿತನ ಧ್ಯಾನದಲಿ ಅನವರತ ಸೇವಿಸುತ","ರಾಮ ಸೇವೆ ನೀ ಸಂಭ್ರಮದಲಿ ಮಾಡಿ","ರಾಮರ ಧ್ಯಾನ ಮಾಡುತ ಪೂಜಿಸುತಿರುವಿ","ರಮಾವಲ್ಲಭವಿಠಲನ ಧ್ಯಾನದಿ ಪಟ್ಟಕೆ ಬರಲಿರುವಿ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","das