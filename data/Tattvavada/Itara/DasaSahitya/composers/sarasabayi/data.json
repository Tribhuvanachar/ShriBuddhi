ಡಿ ವೆರಗಾಗುತಲಿರುವಿ","ರಾಮನಾ ಸತಿಯಾಗಿ ಪ್ರೇಮದಿಂದಲಿ ಈಗ","ಕಾಮನಯ್ಯನ ಕಾರುಣ್ಯದಿಂದ","ರಮಾವಲ್ಲಭವಿಠಲನ ತೊಡೆಯ ಮೇಲೆ ಕುಳಿತು","ಸ್ವಾಮಿಗೆ ಸತಿಯಾಗಿ ಸೇವಿಸುತಲಿರುವಿ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":190,"keerthana_id":12727,"category_raw":4,"favorite":false,"header_stripped":["ನಿರ್ಗಮನ"],"unclassified_lines":[],"is_recorded_rendition":true},"_needs_review":false,"also_at":[]}]}