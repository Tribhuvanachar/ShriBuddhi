ags":["composer:ಅಸ್ಕಿಹಾಳ ಗೋವಿಂದ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ನಿತ್ಯದಿತಿಜರು ಕಲಿಗೆ ದೂರುತಿಹರೋ","ಸತ್ಯಧ್ಯಾನರ ಕಾಟ ತಾಳಲಾರೆವೊಯೆಂದು ಪ","ನೀ ಕಲಿಸಿದಾಟವನು ತಾ ಕಳೆದು ಜನರ ಅಘನೂಕಿ","ಜಗಸತ್ಯ ಶ್ರೀ ಹರಿಯು ಪರನು","ಶ್ರೀಕಮಲಭವರೆಲ್ಲ ದಾಸರೆಂದರುಪಲು","ತಾ ಕಲ್ಪಿಸಿದ ಪಾಠಶಾಲೆ ಸಭೆಗಳನೆಂದು","ಭೂಸುರರಿಗನ್ನ ಧನ ಭೂಷಣಗಳಿತ್ತು","ಅಭ್ಯಾಸಗೈಸಿದ ಸಕಲ ವೇದಶಾಸ್ತ್ರ","ಏಸು ವಿಧ ಯತ್ನಗಳು ನಾ ಮಾಡಿದರು ಜಯ","ಲೇಸು ಕಾಣದೆ ನಿನ್ನ ಬಳಿಗೆ ಬಂದೆವು ಎಂದು","ಇಂತು ತಾ ಮಾಡಿದನು ಪಿಂತಿನಾಶ್ರಮದಿ","ಈ ಗಂತು ನಮ್ಮವರಾದ ವದು ಮತ್ಸರಾ","ಕಂತು ಕೋಪಾದಿಗಳಿಗಂತಕನು ಯನಿಸಿ","ಮುನಿ ಸಂತತಿಪನಾಗಿರುವದೆಂತು ನೋಳ್ಪೆವು ಎಂದು","ತಾಪಸೋತ್ತಮ ಸತ್ಯದ್ಯಾನದಿಂ ಭೂತಳದಿ","ಪಾಪ ಸರಿದಿತು ಪುಣ್ಯವೆಗ್ಗಳಿಸಿತು","ಲೇಪಿಸದು ಖತಿಜನಕ ಇವರ ದಯದಿಂದೆಮ್ಮ","ವ್ಯಾಪಾರ ಧರೆಯೊಳಗೆ ಭೂಪ ಇನ್ಯಾಕೆಂದು","ನಿರುತ ಸಿರಿಗೋವಿಂದ ವಿಠಲನ್ನ ಸೇವಿಸುತಾ","ಪರಹಿಂಸೆ ಧನಯುವತಿ ದ್ಯೂತತೊರದಾ","ವರಯತಿಯ ಮೋಹಿಸುವ ಶಕ್ತಿ ತನಗಿಲ್ಲೆಂದು","ಅರುಹಿದನು ಭೃತ್ಯರಿಗೆ ಕಲಿ ಮನನೊಂದು"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":38,"keerthana_id":84,"category_raw":0,"favorite":false,"header_stripped":["ಅಸ್ಕಿಹಾಳ ಗೋವಿಂದ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"askihala_govimda__dasa1_85","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ನಿರ್ವಿಘ್ನ ನೀಡೋ","latin":"","iast":"nirvighna nīḍo","devanagari":"निर्विघ्न नीडो"},"composer":"ಅಸ್ಕಿಹಾಳ ಗೋವಿಂದ","composer_iast":"askihāḻa goviṃda","deity":"","tags":["composer:ಅಸ್ಕಿಹಾಳ ಗೋವಿಂದ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಗಣೇಶ ಪ್ರಾರ್ಥನೆ","ನಿರ್ವಿಘ್ನ ನೀಡೋ ನಭದೀಶಾ ಪ","ಗಜಮುಖ ಅಗಜ ಅಂಗಜ ಮೃದ್ಭವ","ಗಜವರದನ ನಿಜ ದಾಸ","ನಾಕಪವಂದ್ಯ ಪಿನಾಕಿ