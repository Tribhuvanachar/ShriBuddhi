{"schema":"dasa_pada_text","default_author":"ರಂಗದಾಸರು","composer":"ರಂಗದಾಸರು","count":17,"bio_notes":"","items":[{"id":"ramgadasaru__dasa1_9101","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಎಷ್ಟು ಪ್ರೇಮಿಯೋ ಗುರುವು","latin":"","iast":"èṣṭu premiyo guruvu","devanagari":"ऎष्टु प्रेमियो गुरुवु"},"composer":"ರಂಗದಾಸರು","composer_iast":"raṃgadāsaru","deity":"","tags":["composer:ರಂಗದಾಸರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಶ್ರೀಹರಿಯನ್ನೇ","(ಇ) ಆತ್ಮನಿವೇದನೆ","ಎಷ್ಟು ಪ್ರೇಮಿಯೋ ಗುರುವು ಎಷ್ಟು ಪ್ರೇಮಿಯೋ ಪ","ಎಷ್ಟು ಪ್ರೇಮಿ ಎನ್ನ ಬಿಡದೆ | ಸೃಷ್ಟಿಯಲ್ಲಿ ಕೈಯಪಿಡಿದ ಅ.ಪ","ಭಾನುಕೋಟಿ ತೇಜ ವರದ ಸಾನುರಾಗದಿಂದ ಕರೆದು","ಜ್ಞಾನ ಶಾಸ್ತ್ರ ಬೋಧಿಸುತ್ತ ಹೀನ ವೃತ್ತಿ ದೂರಿ ಪೊರೆದ","ನೀಲವರ್ಣ ಕಂಜನಯನ ನೀಲಕಂಠಮಿತ್ರ ಭಕ್ತ","ಪಾಲ ಭೂರಿದುಃಖಭವವ ಧೂಳಿಮಾಡಿ ಬಾಲಗೊಲಿದ","ಶ್ರೇಷ್ಠ ಸುಮಹದೇವಪುರದೊಳಿಷ್ಟರಂಗನಾಥ ಭರದಿ","ಮುಟ್ಟಿ ಮುಕ್ತಿಯಿತ್ತು ಪುನಃ ಹುಟ್ಟು ಸಾವುಗಳನು ಕಳದ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":24,"keerthana_id":9101,"category_raw":0,"favorite":false,"header_stripped":["ರಂಗದಾಸರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"ramgadasaru__dasa1_9102","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಕನಸನು ಕಂಡೆನು ಕೇಳೌ","latin":"","iast":"kanasanu kaṃḍènu keḻau","devanagari":"कनसनु कंडॆनु केळौ"},"composer":"ರಂಗದಾಸರು","composer_iast":"raṃgadāsaru","deity":"","tags":["composer:ರಂಗದಾಸರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ರಂಗದಾಸರು ಸ್ವಯಂ","ಕನಸನು ಕಂಡೆನು ಕೇಳೌ","ಘನ ಶ್ರೀ ಗುರು ಬಂದು ಶಾಸ್ತ್ರ ತತ್ವವ ಪೇಳ್ದಂ","ಮನಸಿನ ಸಂಶಯವಳಿಯಿಸಿ","ತನಯಗೆ ರಾತ್ರಿಯೊಳು ತೋರಿದಂ ಸತ್ಪಥಮಂ ಕಂದ","ಕನಸನು ಕಂಡೆನು ಕೇಳೌ ಶ್ರೀಗುರುಭರದಿಂ ತಾ ಬಂದೂ ಪ","ತನಯನ ಸಂಶಯವಳಿಯಿಸಿ ಪರತರ","ಗತಿಯನು ತಾ ಕೊಡುವ ಅ.ಪ","ಶ್ರೀಹರಿ ಪೂಜೆಯು ಸ್ತೋತ್ರವು ಚಿಂತನೆ-ಶ್ರೀಹರಿಮಂತ್ರವನೂ","ಶ್ರೀಹರಿ ಲಾಂಛನ ಧರಿಸುತ ಸಂತತ ವಿಠಲನ ಭಜಿಸೆಂದು","ಬಂಧುರದೇಗುಲ ವರಕ್ಷೇತ್ರದೊಳಾನಂದವನೋಡುತಲೀ","ನಿಂದಿಹ ಪರಿಪರಿ ಸಾಧುವೈಷ್ಣವರಿಗೊಂದನೆಮಾಡೆಂದ","ಸತ್ಯಪ್ರಬಂಧವು ಅಷ್ಟಾಕ್ಷರಿಜಪತತ್ವ ಸುದ್ವಯಮಂತ್ರ","ನಿತ್ಯಹೃದಯದೊಳು ಸೋಹಂಭಾವದಿ ಭಕ್ತಿಯೊಳ್ಬೆರೆಯೆಂದ","ವರಮಹದೇವನ ಪುರಶ್ರೀರಂಗನಚರಣವ ಗುರಿಮಾಡೀ","ಮರೆಯದೆ ಧ್ಯಾನಿಸು ನಾನೇ ನಿನ್ನನು ಪೊರೆಯುವೆನೆಂತೆಂದ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":24,"keerthana_id":9102,"category_raw":0,"favorite":false,"header_stripped":["ರಂಗದಾಸರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"ramgadasaru__dasa1_9103","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಕರ್ಮತ್ಯಾಜ್ಯವ ಮಾಡಿರೊ","latin":"","iast":"karmatyājyava māḍirò","devanagari":"कर्मत्याज्यव माडिरॊ"},"composer":"ರಂಗದಾಸರು","composer_iast":"raṃgadāsaru","deity":"","tags":["composer:ರಂಗದಾಸರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಶ್ರೀವೈಷ್ಣವ ತತ್ವದ ಸಾಧನೆಯ","(ಈ) ಲೋಕನೀತಿ-ತಾತ್ವಿಕ ಕೃತಿಗಳು","ಕರ್ಮತ್ಯಾಜ್ಯವ ಮಾಡಿರೊ ಸನ್ಮಾರ್ಗದೋಳ್","ಕರ್ಮತ್ಯಾಜ್ಯವ ಮಾಡಿರೊ ಪ","ಕರ್ಮತ್ಯಾಜ್ಯ ಮಾಡಿ ಧರ್ಮಮಾರ್ಗವ ನೋಡಿ","ನಿರ್ಮಲ ಮನಮೂಡಿ ಮರ್ಮಜ್ಯೋತಿಯ ಕೂಡಿ ಅ.ಪ","ಕಾಮಕ್ರೋಧಗಳ ಸುಟ್ಟು ಸಂಸೃತಿಯಳಿದು","ತಾಮಸಮತಿಯ ಬಿಟ್ಟು ಹೇಮದಾಸೆಗೆಮನ","ಪ್ರೇಮಮಾಡದೆ ಭಿನ್ನ ನಾಮರೂಪವ ನೂಂಕಿ","ರಾಮನೊಳ್ಮನ ನೆಟ್ಟು","ಪರಮಪಾವನಮಾದ ಶ್ರೀಹರಿಯಲ್ಲಿ","ಬೆರೆಯುತಾನಂದದಿಂದ","ಅರಿಗಳಾರರಸಂಗ ಕರಿಗಳೆಂಟರ ಭಂಗ","ಕಿರಿದುಎಂಟರ ಅಂಗ ಭರದಿ ತರಿದು ಈಗ","ಧರೆಯೊಳ್ದುಷ್ಟರ ಮರದು ಮಹನೀಯರ","ಚರಣಸೇವೆಯೊಳ್ಬೆರದು","ವರಮಹದೇವನಪುರದ ಶ್ರೀರಂಗನ","ನಿರುತ ನಂಬಿಯೆ ಸದ್ಗುರುವ ಸೇವಿಸಿ ದುಷ್ಟ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":24,"keerthana_id":9103,"category_raw":0,"favorite":false,"header_stripped":["ರಂಗದಾಸರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"ramgadasaru__dasa1_9104","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಜಯ ಮಂಗಳ ಶ್ರೀಕರ ಹಂಸನಿಗೆ","latin":"","iast":"jaya maṃgaḻa śrīkara haṃsanigè","devanagari":"जय मंगळ श्रीकर हंसनिगॆ"},"composer":"ರಂಗದಾಸರು","composer_iast":"raṃgadāsaru","deity":"","tags":["composer:ರಂಗದಾಸರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["() ಮಾದದಗೊಂಡನಹಳ್ಳಿ (ಮಹದೇವಪುರ)","ಜಯ ಮಂಗಳ ಶ್ರೀಕರ ಹಂಸನಿಗೆ ಪ","ಜಯಮಂಗಳ ಸಾಮಜಪೋಷಕಗೆ ಅ.ಪ","ಜಯಮಂಗಳ ಫಲ್ಗುಣಪಾಲನಿಗೆ","ಜಯಮಂಗಳ ಶ್ರೀಗುರುರಂಗನಿಗೆ","ಪರತರಗತಿಯಂಪೊಂದುವ","ಭರದಿಂ ಶ್ರೀರಂಗದಾಸವರ್ಯನು ಪೆಳ್ದಾ","ವರಕವಿತೆಯ ಜರಿಯದೆ ಸ","ದ್ಧರಿಭಕ್ತರು ತಪ್ಪ ತಿದ್ದಿ ಮನ್ನಿಸಿ ಮುದದಿಂ ಕಂದ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":24,"keerthana_id":9104,"category_raw":0,"favorite":false,"header_stripped":["ರಂಗದಾಸರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"ramgadasaru__dasa1_9105","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ತಂದೆ ನೀನೆ ದಯದಿ ಪಾಲಿಸೆಂದು","latin":"","iast":"taṃdè nīnè dayadi pālisèṃdu","devanagari":"तंदॆ नीनॆ दयदि पालिसॆंदु"},"composer":"ರಂಗದಾಸರು","composer_iast":"raṃgadāsaru","deity":"","tags":["composer:ರಂಗದಾಸರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ತಂದೆ ನೀನೆ ದಯದಿ ಪಾಲಿಸೆಂದು ಬಂದೆನೋ ಪ","ಹಿಂದುಮುಂದು ಗತಿಯದಾರುಯಿಲ್ಲವೆಂಬೆನೊ ಅ.ಪ","ಕುಕ್ಷಿಯೊಳಗೆ ಜಗವನಿಟ್ಟುಕೊಂಡು ಪೊರೆವನೆ","ಪಕ್ಷಿಗಮನ ನಿಮ್ಮ ನೆನೆವೆ ಭಜಕಗೊಲಿವನೆ","ಕ್ಷೀರವಾರ್ಧಿಶಯನ ಗೋಪಿ-ಜಾರ ಪಾಲಿಸೊ","ಮಾರಜನಕ ಮುದದೊಳೆನ್ನ ದೂರಲಾಲಿಸೊ","ಸುಮಹದೇವಪುರದ ನಿಲಯ-ಸುಜನರಕ್ಷನೆ","ಕ್ರಮದೊಳೆನ್ನ ರಕ್ಷಿಸಯ್ಯ-ಕಮಲೆಯಾಣ್ಮನೆ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":24,"keerthana_id":9105,"category_raw":0,"favorite":false,"header_stripped":["ರಂಗದಾಸರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"ramgadasaru__dasa1_9106","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ತಂದೆಯೆ ನೀನೆನಗಹುದೈ","latin":"","iast":"taṃdèyè nīnènagahudai","devanagari":"तंदॆयॆ नीनॆनगहुदै"},"composer":"ರಂಗದಾಸರು","composer_iast":"raṃgadāsaru","deity":"","tags":["composer:ರಂಗದಾಸರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಶ್ರೀವೈಷ್ಣವ ತತ್ವ ಪ್ರತಿಪಾದನೆಯ","ತಂದೆಯೆ ನೀನೆನಗಹುದೈ","ಬಂಧುರ ದುರಿತಾರಿ ನಿನ್ನ ಬಾಲನು ನಾನಾ","ನಂದದಿ ಪೇಳ್ವೆನು ಕರುಣಾ","ಸಿಂಧುವೆ ಪೊರೆಯೆನ್ನನಿಂದು ಶ್ರೀಮದ್ಗುರುವೇ ಕಂದ","ಸನ್ನುತಗುರುವರ ನಿಮ್ಮಯ","ಚನ್ನಡಿದಾವರೆಯ ನಂಬಿ ಸಲೆ ಸೇವಿಸುವಂ","ಗಿನ್ನಿತರ ಕ್ಷೇತ್ರಭ್ರಮೆ","ಯೆನ್ನುವುದೇನುಂಟು ನೋಡಲಿಳೆಯೊಳಗನಿಶಂ","ತಂದೆಯಹುದು ನೀನೆ ಶ್ರೀಗುರು ತಂದೆಯಹುದು ನೀನೆ ಪ","ಅಂದದಿ ಸಂಸೃತಿಸಂಗವ ಜಾರಿಸಿ","ಬಂಧುರ ತತ್ವವನರುಹಿದ ಪರಮನೆ ಅ.ಪ","ಎಷ್ಟುಕರುಣಿ ಎನ್ನ ಪಾಪವಸುಟ್ಟು ಭ್ರಾಂತಿವಿಷಯ","ಕೃಷ್ಣನಪಾದವಮುಟ್ಟಿ ಯಜಿಸಿ ಮನ","ನೆಟ್ಟುಯೋಗದಲಿ ವಿಮಲನಮಾಡಿದ","ನಾಮ ರೂಪ ಮರೆಸಿ ಸೋಹಂ-ಭಾವಮುದ್ರೆ ಧರಿಸಿ","ತಾಮಸ ಬುದ್ಧಿಯ-ತರಿದೀಡಾಡಿಸಿ","ನೇಮದಿ ಜಗದೊಳು-ಚರಿಸೆಂದರಸಿದ","ಭೇದವಾದ ತೊರಸಿ ಚಿತ್ಕಳೆ-ನಾದಕವಚ ತೊಡಿಸಿ","ಸಾಧಿಸಿ ವಿರತಿಯ-ವರವೈರಾಗ್ಯವ","ಬೋಧಿಸುತಲಿ ತನ್ನಂತೆಯೆಮಾಡಿದ","ಚರಮ ಶ್ಲೋಕವನ್ನು ಅಷ್ಟಾಕ್ಷರಯುಗಮಂತ್ರವನ್ನು","ತಿರುಮಂತ್ರಾರ್ಥವ ತೀರ್ಥಪ್ರಸಾದವ","ತರಳನಿಗಿಯುತ ಮರವೆಯ ನೂಕಿದ","ಬಂದ ಕಷ್ಟಗಳನು ಬೇಗದಿಭಂಗಮಾಡಿ ತಾನು","ಬಂದು ಹೃದಯ ವರಮಂದಿರದೊಳುತಾ","ನಿಂದು ಮೋಕ್ಷವನು ಸಂಧಿಸಿ ಸಲಹಿದ","ಶರಣು ಪೊಕ್ಕ ನರನ ಸಂತತಕರವ ಪಿಡಿದು ಮುನ್ನ","ವರಮಹದೇವನ ಪುರ ಶ್ರೀರಂಗನೆ","ಹರುಷದೊಳೆನ್ನನು ಪರದೊಳ್ಬೆರಸಿದ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":24,"keerthana_id":9106,"category_raw":0,"favorite":false,"header_stripped":["ರಂಗದಾಸರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"ramgadasaru__dasa1_9107","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಧ್ಯಾನಿಸಿ ಆತ್ಮನ ಧ್ಯಾನಿಸಿ","latin":"","iast":"dhyānisi ātmana dhyānisi","devanagari":"ध्यानिसि आत्मन ध्यानिसि"},"composer":"ರಂಗದಾಸರು","composer_iast":"raṃgadāsaru","deity":"","tags":["composer:ರಂಗದಾಸರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಸೋಹಂಬ್ರಹ್ಮಂ' ನಾನೇಬ್ರಹ್ಮ","ಧ್ಯಾನಿಸಿ ಆತ್ಮನ ಧ್ಯಾನಿಸಿ ಬ್ರಹ್ಮನ","ಧ್ಯಾನಿಸಿ ಸಂತತ ಗುರುವರ್ಯನ ಪ","ದುರಿತ ಮೋಹ ದುಃಖ ದೂರ ನೂಂಕಿ ಕಾಯ್ವ","ಪರಮ ಪಾವನಮೂರ್ತಿಯ","ಕಾಮಿತಾರ್ಥಗಳನು ಪ್ರೇಮದಿಕೊಡುವನ","ಭೀಮಮಿತ್ರನ ನೀವು","ಪಾಪಪುಣ್ಯವೆಲ್ಲ ಶ್ರೀಪತಿಗರ್ಪಿಸಿ","ಗೋಪತಿಯನು ನಂಬಿ ಧ್ಯಾನಿಸಿ","ಧರೆಯೊಳು ಮಹದೇವಪುರದ ಶ್ರೀರಂಗನ","ಮರೆಯದೆ ಭಾವ[ಶುದ್ಧ]ದೊಳ್"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":24,"keerthana_id":9107,"category_raw":0,"favorite":false,"header_stripped":["ರಂಗದಾಸರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"ramgadasaru__dasa1_9108","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ನರಸಿಂಹಗುರುವೆ ನೋಡೈ","latin":"","iast":"narasiṃhaguruvè noḍai","devanagari":"नरसिंहगुरुवॆ नोडै"},"composer":"ರಂಗದಾಸರು","composer_iast":"raṃgadāsaru","deity":"","tags":["composer:ರಂಗದಾಸರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ನರಸಿಂಹಗುರುವೆ ನೋಡೈ ಬಾಲನ","ಈಗ ಕರವ ಪಿಡಿದು ರಕ್ಷಿಸೈ ಪ","ತರುಣಿದ್ರೌಪದಿಶಬರಿಯಜಮಿಳತರಳಧ್ರುವಬಲಿನಾಗಭಕ್ತರ","ಮೊರೆಯಲಾಲಿಸಿತಕ್ಷಣದಿಬಂದಹರುಷದಿಸಲಹಿದಾ ಸಿರಿ ಅ.ಪ","ಬರಬಾರದು ನಾಬಂದು ಸಂಸೃತಿಯೆಂಬೊ","ಉರಿವಕಿಚ್ಚಿನೊಳುನಿಂದು","ಸ್ಮರಿಸಬಾರದಕೆಟ್ಟಪಾಪದಿ","ಬೆರತುಸತಿಸುತಬಂಧುಮೋಹದಿ","ಚರಿಸಿ ದೇಶದಿ ನಿನ್ನ ಧ್ಯಾನವ","ಮರತು ವಿಷಯದಿ ಮುಳುಗಿಪೋದೆನು","ಗತಿಯಾರು ತೋರೋ ಇಂದು ಮುಂದೆನಗಿನ್ನು","ನತಪಾಲ ನೀನೆ ಎಂದು","ನುತಿಸಿ ಬೇಡುವೆ ಕರವಜೋಡಿಸಿ","ಮತಿವಿಹೀನರಸಂಗಜಾರಿಸಿ","ಹಿತದಿ ನಿನ್ನಡಿ ನೋಡಿ ಯಜಿಸುವ","ಮತಿಯ ನೀನೆನಗಿತ್ತು ಬೇಗದಿ","ಮರೆಹೊಕ್ಕೆ ನಿನ್ನಡಿಯ ಮತ್ರ್ಯರ","ಬಾಧೆ ಘನವಾಗಿ ಇರುವದಯ್ಯ","ಹೊರಗೆ ಒಳಗೊಂದೊಂದು ಯೋಚನೆ","ಹರಡಿ ವೈಷ್ಣವರನ್ನು ದುಃಖದೊ","ಳಿರಿಸಿ ತೋಷಪಡುವ ಪಾಪಾತ್ಮರು","ನಿರಂತರ ವ್ಯಾಪಿಸಿರ್ಪುದ","ಶ್ರೀಶನೀಕೋಪಬಿಟ್ಟುಸಂತತರಂಗ","ದಾಸನೋಳ್ಮನವನಿಟ್ಟೂ","ಭಾಸುರಾತ್ಮನೆ ಬಂದ ವ್ಯಥೆಗಳ","ನಾಶಮಾಡದೆ ಬಿಟ್ಟರಿಳೆಯೊಳು","ದೋಷತಪ್ಪದು ನಿನಗೆ ಭಕ್ತನು","ಪೋಷ ಯದುಗಿರಿವಾಸಪರಮನೆ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":24,"keerthana_id":9108,"category_raw":0,"favorite":false,"header_stripped":["ರಂಗದಾಸರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"ramgadasaru__dasa1_9109","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ನೋಡಲೆ ಮಾನವ ಶ್ರೀಗುರುಚರಣವ","latin":"","iast":"noḍalè mānava śrīgurucaraṇava","devanagari":"नोडलॆ मानव श्रीगुरुचरणव"},"composer":"ರಂಗದಾಸರು","composer_iast":"raṃgadāsaru","deity":"","tags":["composer:ರಂಗದಾಸರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":24,"keerthana_id":9109,"category_raw":0,"favorite":false,"header_stripped":[],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":true,"also_at":[]},{"id":"ramgadasaru__dasa1_9110","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ನೋಡಿರೈ ಕಣ್ದಣಿಯಾ ಸಜ್ಜನರೆಲ್ಲ","latin":"","iast":"noḍirai kaṇdaṇiyā sajjanarèlla","devanagari":"नोडिरै कण्दणिया सज्जनरॆल्ल"},"composer":"ರಂಗದಾಸರು","composer_iast":"raṃgadāsaru","deity":"","tags":["composer:ರಂಗದಾಸರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["(ಆ) ಆಳ್ವಾರಾಚಾರ್ಯ ಸ್ತುತಿಗಳು","() ಆಂಜನೇಯ","ನೋಡಿರೈ ಕಣ್ದಣಿಯಾ ಸಜ್ಜನರೆಲ್ಲ","ಪಾಡಿರೈ ಮನದಣಿಯಾ ಪ","ಗಾಢಭಕುತಿಯನಾಂತು ಭಜನೆಯ","ಮಾಡುವರ ದುರಿತಗಳನೋಡಿಸಿ","ಕೂಡೆನಿರ್ಮಲರೆನಿಸಿ ಪೊರೆವಾ","ರೂಢನಹ ಮಾರುತಿಯ ಮೂರ್ತಿಯ ಅ.ಪ","ಉಡಿಯೋಳ್ ಘಂಟೆಗಳೆಸೆಯೆ ಚರಣದೊಳುಳ್ಳ","ತೊಡರುಗಗ್ಗರಮುಲಿಯೆ","ಪಿಡಿದಪಂಕಜ ಮೆರೆಯೆಕುಂಡಲಿಗಳಿ","ರ್ಕಡೆಯ ಕರ್ಣದಿ ಪೊಳೆಯೆ","ಕಡಗ ಮಣಿಮಕುಟಗಳ ಪೇರುರ","ದೆಡೆಯ ವಜ್ರದಪದಕ ಮೊದಲಹ","ತೊಡಿಗೆಗಳ ಸಡಗರದೊಳೊಪ್ಪುವ","ದೃಢತರದ ಮಾರುತಿಯ ಮೂರ್ತಿಯ","ಭರದಿಂದ ಶರನಿಧಿಯಾ ಲಂಘಿಸಿ ಪೊಕ್ಕಾ","ನಿರುಪಮತರ ಲಂಕೆಯ","ಗುರಿಗೊಂಡರಸಿ ಸೀತೆಯಾ ಕಂಡಾರಘು","ವರನುರುಮುದ್ರಿಕೆಯ","ಕರದೊಳಿತ್ತಾರಮಣಿಯಿಂ ವಿ","ಸ್ಫುರಿಪ ಚೂಡಾಮಣಿಯ ಕೈಕೊಂ","ಡಿರದೆ ಬಂದೊಡೆಯಂಗೆ ಸಲಿಸಿದ","ಪರಮಬಲಯುತನಮಳಮೂರ್ತಿಯ","ವಾದವಿದೂರನನು ಪಾವನ ಮೃದು","ಪಾದಾರವಿಂದನನು","ವೇದಾಂತವೇದ್ಯನನು-ಸನ್ನುತಪರ","ನಾದಾನುಮೋದನನು","ಸಾದರದೊಳೈತಂದು ಪ್ರಾರ್ಥಿಪ","ಸಾಧುಸಂತತಿಗೊಲಿದು ಪರಮಾ","ಮೋದದಿಂ ಪರಮಾರ್ಥವಿಷಯವ","ಬೋಧಿಸುವ ಮಾರುತಿಯ ಮೂರ್ತಿಯ","ರಂಗನಾಥನದೂತನ ಸತ್ಕರುಣಾಂತ","ರಂಗನಾರ್ತಪ್ರೀತನ","ಕಂಗೊಳಿಸುವ ನೂತನಪುರವರದೊಳು","ಹಿಂಗದೊಪ್ಪಿರುವಾತನ","ಮಂಗಳಾತ್ಮನ ಮೋಹದೂರನ","ಸಂಗರಹಿತನ ಸತ್ಯಚರಿತನ","ರಂಗದಾಸಪ್ರಣಿತಮಹಿಮೋ","ತ್ತುಂಗ ಶ್ರೀ ಮಾರುತಿಯ ಮೂರ್ತಿಯ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":24,"keerthana_id":9110,"category_raw":0,"favorite":false,"header_stripped":["ರಂಗದಾಸರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"ramgadasaru__dasa1_9111","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಬಾರೊ ಬಾರೊ ರಂಗಬಾರೊ","latin":"","iast":"bārò bārò raṃgabārò","devanagari":"बारॊ बारॊ रंगबारॊ"},"composer":"ರಂಗದಾಸರು","composer_iast":"raṃgadāsaru","deity":"","tags":["composer:ರಂಗದಾಸರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಬಾರೊ ಬಾರೊ ರಂಗ-ಬಾರೊ ನಮ್ಮನೆಗೆ ಪ","ಬೋರನ್ಹಾಕುವೆ ನಡೆಮುಡಿಯ ನಿಮ್ಮಡಿಗೆ ಅ.ಪ","ಪರಿಮಳಾಂಬುವಿನಿಂದ-ಪದವ ತೊಳೆಯುವೆನೊ","ವರಗಂಧಾಕ್ಷತೆಯನು-ಭರದಿ ಧರಿಸುವೆನೋ","ಹೊಸಪಟ್ಟೆಯನು ತಂದು-ಹೊಂದಿಸಿ ರಾಜಿಸುವೆ","ಕುಸುಮದಿಂದರ್ಚಿಸಿ ಕೂಡೆ ಸಂತಸವ","ಕುಂಕುಮಾಗಿಲು ದಿವ್ಯ ಗುಗ್ಗುಲಹೊಗೆಯ","ಬಿಂಕದಿಂದರ್ಪಿಸುವೆನು ಭೋಗಿಸಯ್ಯಾ","ಮೇಲೆ ಸದ್ಭಕ್ಷ್ಯ ತಾಂಬೂಲವರ್ಪಿಸುವೆ","ಲಾಲಿತ ಮಹಮಂಗಳಾರತಿಯೀವೆ","ಬಿಡದೆ ಸಾಷ್ಟಾಂಗವ ನಿಡುವೆ ರಮೇಶ","ಪೊಡವಿಯೊಳ್ ಮಹದೇವಪುರದ ಶ್ರೀಹರಿಯೆ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":24,"keerthana_id":9111,"category_raw":0,"favorite":false,"header_stripped":["ರಂಗದಾಸರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"ramgadasaru__dasa1_9112","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಬೇಡಿಕೊಂಬುವೆನು ನಿಮ್ಮ ರಾಮಾನುಜರೆ","latin":"","iast":"beḍikòṃbuvènu nimma rāmānujarè","devanagari":"बेडिकॊंबुवॆनु निम्म रामानुजरॆ"},"composer":"ರಂಗದಾಸರು","composer_iast":"raṃgadāsaru","deity":"","tags":["composer:ರಂಗದಾಸರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ರಾಮಾನುಜರನ್ನು ಕುರಿತ ಸ್ತುತಿಗೀತೆ","() ರಾಮಾನುಜರು","ಬೇಡಿಕೊಂಬುವೆನು ನಿಮ್ಮ ರಾಮಾನುಜರೆ","ಬೇಡಿಕೊಂಬುವೆನು ನಿಮ್ಮಾ ಪ","ಬೇಡಿಕೊಂಬುವೆ ನಿಮ್ಮ ಚರಿತೆಯ","ಪಾಡಿ ಹಿಗ್ಗುವ ಸುಖವ ಸಂತತ","ಕೂಡಿ ಹೃದಯದ ಕಮಲ ಮಧ್ಯದೊ","ಳಾಡುತೆನ್ನನು ರಕ್ಷಿಸೆನುತಲಿ ಅ.ಪ","ಚರಮ ಶ್ಲೋಕವ ಬೋಧಿಸಿ ಅಷ್ಟಾಕ್ಷರಿಯೊ","ಳಿರುವ ಗೋಪ್ಯವ ತೋರಿಸಿ","ಮೆರೆವದ್ವಯವರ ಪಂಚಸಂಸ್ಕಾರವನು","ಗೈವುತ ಪ್ರಣವ ಶಬ್ದದಿ","ಬೆರಸಿ ನಿನ್ನನೆ ಭಜಿಸಿ ಸ್ಮರಿಸುತ","ಪರಮನಾಗುವ ಮತಿಯ ತ್ವರಿತದಿ","ಅಷ್ಟಮದಗಳು ಎನ್ನನೂ ಬಂಧಿಸಿ ಮಾಯಾ","ಅಷ್ಟಪಾಶದಿ ನೊಂದೆನೊ","ದುಷ್ಟಕಾಮಾದಿಗಳ ಭ್ರಾಂತಿಯು","ಕಟ್ಟ ನರಕದಿ ಕೆಡಹಿ ಸುಡುತಿದೆ","ಭ್ರಷ್ಟಗುಣಗಳ ದೂರಸೇರಿಸಿ","ಶ್ರೇಷ್ಠಮುಕ್ತಿಯ ಪಡೆವ ವಿರತಿಯ","ಜ್ಯೋತಿ ಜ್ಯೋತಿಯ ನಿಲ್ಲಿಸಿ ಹೂಬಳ್ಳಿಯೊಳ್","ಜ್ಯೋತಿನೋಡು ಪೂಜಿಸಿ","ಮಾತೆ ಮಾತುಳ ಪಾಲಕಾನುಜ-","ತಾತ ಸತಿ ಸುತ ಬಂಧು ಮಿತ್ರ","ವ್ರಾತ ಸಂಗಡಬಂಧಬಿಟ್ಟು ಪು","ನೀತನಾಗಲಿಬೇಕು ಎನುತಲಿ","ಯಾದವಾದ್ರಿಯ ವಾಸನೆ ಭಕ್ತರನೆಲ್ಲ-","ಮೋದದಿಂದಲಿಯಾಳ್ವನೇ","ಮೇದಿನೀಮಹದೇವಪುರವರ","ನಾದಶ್ರೀಗುರುರಂಗ ನಿನ್ನ ಸು-","ಪಾದನಂಬಿದ ರಂಗದಾಸನ","ಪರಮಯೋಗಿಯು ಎನ್ನಿಸೆನುತಲಿ","ಅಷ್ಟಾಕ್ಷರದ್ವಯದರ್ಥದಿ ನಿಷ್ಠಾಪರನಾಗಿ ಮನದಿ ನಿರುತಂ ಜಪಿಸಲ್ ಇಷ್ಟಾರ್ಥವು ಸಿದ್ಧಿಸುತಂ","ಅಷ್ಟಮನೋಳ್ಬೆರದುನಿಲ್ವನಿದು ಸಿದ್ಧಾಂತಂ ಕಂದ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":24,"keerthana_id":9112,"category_raw":0,"favorite":false,"header_stripped":["ರಂಗದಾಸರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"ramgadasaru__dasa1_9113","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಬೋಧರೂಪನೆ ವೇದವೇದ್ಯನೆ","latin":"","iast":"bodharūpanè vedavedyanè","devanagari":"बोधरूपनॆ वेदवेद्यनॆ"},"composer":"ರಂಗದಾಸರು","composer_iast":"raṃgadāsaru","deity":"","tags":["composer:ರಂಗದಾಸರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ದಾಸರು ತಮ್ಮ ಆರಾಧ್ಯದೈವ","(ಅ) ಶ್ರೀಹರಿಸ್ತುತಿಗಳು","ಬೋಧರೂಪನೆ ವೇದವೇದ್ಯನೆ ಬೇಗ ಮೋಕ್ಷವನೀವನೇ","ವೇದತಸ್ಕರನಂ ವಿಭಂಜಿಸಿ ವೇದಮಂತ್ರವ ತಂದನೇ ಪ","ಮೋದದಿಂದಗವನ್ನು ಬೆನ್ನಲಿ ಮಂತ್ರಪೊತ್ತ ದೇವನೆ ಪೋಷಿಸೈ","ಸಾದರಂಮಿಗೆ ರಂಗನಾಥನೆಸಂತತಂ ನುತಿಗೈದಪೆಂ ಅ.ಪ","ಮಂಗಳಾಂಗ ವಿಹಂಗ ರಾಜತುರಂಗ ಸನ್ಮುನಿ ಸಂಗಮಾ","ತಂಗ ರಕ್ಷ ಹಿರಣ್ಯ ಲೋಚನದರ್ಪಶಿಕ್ಷಲ ಸತ್ಕøಪಾ","ಪಾಂಗ ದೈತ್ಯತನೂಭವೇಷ್ಟದ ತುಂಗ ಶೌರ್ಯ ವಿಶಿಷ್ಟ ಶ್ರೀ","ರಂಗನಾಥನೆ ರಕ್ಷಿಸೈ ಭವದಂಘ್ರಿಸೇವೆಯೊಳಾವಗಂ","ಸುಂದರಾಂಗನೆ ಸೂರಿವಂದ್ಯನೆ ಕುಂದಕುಟ್ಮಲದಂತನೇ","ಮಂದಹಾಸದೊಳೊಂದಿ ಬಾಲಕನಂದದಿಂದಲಿ ಬಂದು ಸಾ","ನಂದದಿಂಬಲಿಯಿಂದಭೂಮಿಯನಂದುದಾನವಕೊಂಡಗೋ","ವಿಂದಪೋಷಿಸುರಂಗನಾಥಮುಕುಂದನೀಂ ಪರಿತೋಷದಿಂ","ರಾಮ ತಾಮರಸೋದ್ಭವಸ್ತುತನಾಮ ಸದ್ಗುಣಧಾಮ ಶ್ರೀ","ರಾಮಕೃಷ್ಣ ದಿನೇಶಮಂಡಲಧಾಮದೀನಶರಣ್ಯ ನಿ","ಷ್ಕಾಮ ಸಂಗರಭೀಮ ದೈತ್ಯವಿರಾಮ ಸುಂದರಕಾಮ ಸು","ತ್ರಾಮವಂದ್ಯನೆ ರಂಗನಾಥನೆ ರಕ್ಷಿಸೆನ್ನನು ಮೋದದಿಂ","ಧೀರಬುದ್ಧನೆ ಕಲ್ಕಿರೂಪನೆ ಧೀರಸಂಕುಲದಿವ್ಯಮಂ","ದಾರ ನಿನ್ನನೆ ಬೇಡಿಕೊಂಬೆನು ಘೋರಸಂಸ್ಕøತಿಬಂಧದಿಂ","ಗಾರುಮಾಡಿಸದಿನ್ನು ಮಾತೆಯಗರ್ಭಕೆಂದಿಗುತಾರದೆ","ಪಾರಗಾಣಿಸಿ ರಂಗನಾಥನೆ ಪಾಲಿಸೈ ಬಿಡದಳ್ಕರಿಂ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":24,"keerthana_id":9113,"category_raw":0,"favorite":false,"header_stripped":["ರಂಗದಾಸರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"ramgadasaru__dasa1_9114","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ವರಪುಣ್ಯಬೇಡುವೆನಾಂ","latin":"","iast":"varapuṇyabeḍuvènāṃ","devanagari":"वरपुण्यबेडुवॆनां"},"composer":"ರಂಗದಾಸರು","composer_iast":"raṃgadāsaru","deity":"","tags":["composer:ರಂಗದಾಸರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ವರಪುಣ್ಯಬೇಡುವೆನಾಂ","ಗುರುವರ್ಯನ ಚರಣ ಪಿಡಿದು ಮುಕ್ತಿಯಪಥದೊಳ್","ಪರಿಕಿಸಿ ಶೀಘ್ರದಿಘನತರ","ಪರತತ್ವಪಡೆದು ಮರಣ ಜನನವ ತೊರೆವೇಂ ಕಂದ","ಸನ್ನುತಗುರುವರತತ್ವ ಬೋಧಿಸಿ-","ಮಂಗಳಾಶಾಸನಗೈಯುತಲೀ ಪ","ಎನ್ನನೆ ಯಜಿಸುತ ಸುಮ್ಮನೆಯಿದ್ದರೆ-","ಬೇಡಿದವರಗಳ ಕೊಡುವೆನುತ ಅ.ಪ","ಕೊಟ್ಟರು ದ್ರವ್ಯವ ನಿನ್ನಪರಾಧವ","ಕೊಡದಿದ್ದರು ನಾ ಮನ್ನಿಸುವೆ","ನಿಷ್ಠೆಯೊಳ್ಪರಮನ ಸನಿಯದೊಳಿದ್ದರೆ","ಬಿಟ್ಟೆನೆಯೆಂದಿಗು ನಂಬೆನುತ","ಸಾಧಿಸಿ ವಿರತಿಯ ಸಂಶಯಗೈಯದೆ-","ಭೇದವ ಛೇದಿಸಿ ನಿರ್ಮಲದಿ","ನಾದವ ಕೇಳುತ ಚಿತ್ಕಳೆ ನೋಡುತ","ಮೋದದಿ ಶ್ರೀಹರಿ ನೀನೆನುತ","ತಿರುಪಣ್ಣಾಳ್ವಾರ್ವಿಪ್ರರು ಕಲ್ಲಿನೊಳ್ಬೀರಲು","ಮೌನವ ಧರಿಸಿರಲು","ಕರೆದು ಲೋಕಸಾರಂಗಮುನಿಗಳಂ-","ಕಳುಹಿಸಿಕರುಣದಿ ಪೊರೆದಂತ","ವೇಶ್ಯೆಯ ವಚನಕೆ ಮೆಚ್ಚುತ ವರಗಳ","ಬೇಡಿಕೊ ಎನ್ನಲು ನಿನ್ನಂತ","ಕೂಸನು ಕೋರಿದ ಮಾತ್ರಕೆ ಆಕೆಯ","ಕುಕ್ಷಿಯೊಳ್ಪುಟ್ಟಿದೆ ಮನ್ನಿಸುತ","ಭ್ರಷ್ಟನು ದ್ರೌಪದಿ ಸೆರಗನು ಪಿಡಿಯಲು","ಅಂತರಂಗದಿಂ ಧ್ಯಾನಿಸಲು","ಸೃಷ್ಟಿಯ ಭಾರವ ಹರಿಸಿದ ಧೀರನೆ","ಇಷ್ಟದಿ ಸೀರೆಯ ಕೊಟ್ಟಂತ","ಸತ್ಯವಾಗಿ ತಾ ಭಕ್ತರ ಹೃದಯದಿ","ನಿತ್ಯವು ಕೃಪೆಯನು ತೋರುತಲಿ","ಪೃಥ್ವಿಲಿ ಈ ಮಹದೇವನ ಪುರದೊಳು","ಅರ್ಥಿಲಿ ರಂಗನ ಪಿಡಿದಂತ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":24,"keerthana_id":9114,"category_raw":0,"favorite":false,"header_stripped":["ರಂಗದಾಸರು","ಈ ಕೀರ್ತನೆಯಲ್ಲಿ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"ramgadasaru__dasa1_9115","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಸೃಷ್ಟೀಶ ಕೃಪೆದೋರಿದ","latin":"","iast":"sṛṣṭīśa kṛpèdorida","devanagari":"सृष्टीश कृपॆदोरिद"},"composer":"ರಂಗದಾಸರು","composer_iast":"raṃgadāsaru","deity":"","tags":["composer:ರಂಗದಾಸರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಸೃಷ್ಟೀಶ ಕೃಪೆದೋರಿದ ಬಾಲನಮಾನನಷ್ಟವ ಜಾರಿಸಿದ ಪ","ಶ್ರೇಷ್ಠರೆಲ್ಲರು ಕೂಡಿ ಯದುಗಿರಿಯಲ್ಲಿ","ನ್ಯಾಯಕೆ ಪೋಪಕಾಲದಿ","ಪುಟ್ಟಯಾಖ್ಯನ ಸ್ವಪ್ನದಲಿ ತಾಂ-","ಬಿಟ್ಟು ಬನ್ನಿರಿಯೆನುತಪೇಳ್ದಾ ಅ.ಪ","ಎಲ್ಲಾರ ನಿನ್ನೊಳಗೆ ಸೇರಿಸಿ ಮುಂದೆ-","ಉಲ್ಲಾಸಕೊಡುವೆ ನಿನಗೆ","ಕಲ್ಲಿನಂದದಿ ಮೌನಧರಿಸುತ-","ಖುಲ್ಲಮನುಜರ ಸಂಗವರ್ಜಿಸಿ","ಎಲ್ಲಿಪೋದರು ಅಲ್ಲಿ ನನ್ನಡಿಯಲ್ಲಿ","ನಿಲ್ಲಿಸು ಮನವನೆನುತಲಿ","ಗುರುಸೇವಾವಿರಹಿತರಿಗೆ ವೈಷ್ಣವರನ್ನ","ಗುರುತು ಕಾಣುವದೆಂದಿಗೆ","ಪರಮ ತಿರುಮಂತ್ರಾರ್ಥ ಅಷ್ಟಾ-","ಕ್ಷರಿಯ ಜಪತಪಧ್ಯಾನಮಾಡುವ","ಹಿರಿಯರಿಲ್ಲದ ಸಭೆಗೆ ಪೋಗಲು","ದೊರಯದೆಂದಿಗು ಕೀರ್ತಿ ಎನುತಲಿ","ಮತಧರ್ಮಜ್ಞಾನಿಗಳು ಪೇಳಿರುವಂತ","ಮತಶಾಸ್ತ್ರವೀಕ್ಷಿಸದೆ","ಸತತದೂಷಣೆಗೈದು ಸುಜನರ -","ಕ್ಷಿತಿಯ ಭೋಗವನಂಬಿ ಗರ್ವದಿ","ಗತಿಯಮರತಿರುವಂತ ಮತ್ರ್ಯರ","ಹಿತವತಪ್ಪಿಸಿ ಕರವಪಿಡಿಯುತ","ಸ್ಥಿರವಲ್ಲಕಾಯವೆಂದು ಸಾತ್ವಿಕಶೃತಿಯೊ-","ಳಿರುವ ಸತ್ಯ ನೋಡೆಂದು","ಪರಿಪರಿಯವೇದಾಂತತತ್ವವ","ನಿರುತಬೋಧಿಸಿ ಜನನಮರಣವ","ತರಿದು ಎನ್ನನೆ ಯಜಿಸು ಯೆನುತಲಿ-","ಹರಸಿ ಮೋಕ್ಷವನಿತ್ತ ಆರ್ಯನು","ಬಿಟ್ಟು ಸತಿಸುತರೆಲ್ಲರ ಎನ್ನೊಳುಮನವ","ನಿಟ್ಟುನಂಬಿದಭಕ್ತರ","ಬಿಟ್ಟುಕೊಡೆನಾನೆಂದು ಹೃದಯಾ-","ಧಿಷ್ಟಿತನು ತಾನಾಗಿ ಅಭಯವ","ಕೊಟ್ಟನೀ ಮಹದೇವಪುರವರ","ಇಷ್ಟಶ್ರೀಗುರುರಂಗನೀಕ್ಷಿಸಿ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":24,"keerthana_id":9115,"category_raw":0,"favorite":false,"header_stripped":["ರಂಗದಾಸರು","ಈ ಕೃತಿಗೆ `ಮತವಿಚಾರಕ್ಕಾಗಿ'"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"ramgadasaru__dasa1_9116","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಹರಿಯೇ ದೈವಶಿಖಾಮಣಿ","latin":"","iast":"hariye daivaśikhāmaṇi","devanagari":"हरिये दैवशिखामणि"},"composer":"ರಂಗದಾಸರು","composer_iast":"raṃgadāsaru","deity":"","tags":["composer:ರಂಗದಾಸರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["(ಉ) ಕ್ಷೇತ್ರವರ್ಣನೆ","() ಮೇಲುಕೋಟೆ","ಹರಿಯೇ ದೈವಶಿಖಾಮಣಿ","ಹರಿಯೇ ಸದ್ಭಕ್ತ ಬಂಧು ಹರಿಯೇ ಪೂಜ್ಯಂ","ಹರಿಪೂಜೆಯೆ ಪಾಪಕ್ಷಯ","ಹರಿಪೂಜೆಯೆ ಪರಮಪುಣ್ಯದಾಲಯಮದರಿಂ ಕಂದ","ತಿರುನಾರಾಯಣಸ್ವಾಮಿಯೆ ನಿಮ್ಮಡಿಯೀಕ್ಷಿಸಿ","ಹೃದಯದೊಳರ್ಚಿಸುವೆ ಪ","ಪರಮಸುಗತಿಯನು ಬೇಡುವೆಸಂತತ-","ಮರೆಯದೆ ಪಾಲಿಸು ವರಗಳನು ಅ.ಪ","ತಿರುಮಂತ್ರದ್ವಯದರ್ಥವ ಬೋಧಿಸಿ","ಹರುಷದಿ ಪರಮನೆ ನೀನೆಂದು","ಮರಣ ಜನನದಾಯಾಸವ ತಪ್ಪಿಸಿ","ಉರುತರ ಸೌಖ್ಯಗಳನು ಕೊಡುವ","ಮನ್ನಿಸಿಭಕ್ತರಪೊರೆಯುವಧೀರನೆ","ಅನ್ಯರಕಾಣೆನುನಾನಿನ್ನು","ನಿನ್ನನೆ ನಂಬಿದೆ ನರಹರಿಮೂರ್ತಿಯೆ","ಇಂದೀ ಸಂಸೃತಿ ಜಾರಿಸುವ","ಲೋಕದ ವಾಸನೆ ಶಾಸ್ತ್ರದವಾಸನೆ-","ಸಾಕೈದೇಹದ ವಾಸನೆಯ","ಶ್ರೀ ಕಮಲೇಶನೆ ನಿನ್ನನು ಸ್ಮರಿಸುವ","ಈ ಕಡುವಾಸನೆ ಹೆಚ್ಚಿಸುತ","ಮಂಗಳ ಯದುಗಿರಿವಾಸ ಪರಮಗುರು","ರಂಗನೆ ನಿಜಕೃಪೆದೋರುತಲಿ","ಮಂಗಳಶಾಸನ ಗೈವುತ ಸಜ್ಜನ","ಸಂಗದೊಳೆನ್ನನು ಸೇರಿಸುವ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":24,"keerthana_id":9116,"category_raw":0,"favorite":false,"header_stripped":["ರಂಗದಾಸರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"ramgadasaru__dasa1_9117","form":"devaranama","form_confidence":"sampled, consistent structured header (song/singer/raga/tala/style)","title":{"kn":"ತಂದೆ ನೀನೆ ದಯದಿ ಪಾಲಿಸೆಂದು","latin":"","iast":"taṃdè nīnè dayadi pālisèṃdu","devanagari":"तंदॆ नीनॆ दयदि पालिसॆंदु"},"composer":"ರಂಗದಾಸರು","composer_iast":"raṃgadāsaru","deity":"","tags":["composer:ರಂಗದಾಸರು","source:android_app_local:dasa1","category_raw:4","form:devaranama","rendition:studio_recording"],"raga":"","tala":"","singer":"ಉದಯ್ ಅಂಕೋಲ","style":"","music_director":"ಪ್ರವೀಣ್ ಗೋಡ್ಖಿಂಡಿ","studio":"ಅರ್ಚನ ಸ್ಟುಡಿಯೊ, ಬೆಂಗಳೂರು","language":"kn","text":{"kannada":[["ತಂದೆ ನೀನೆ ದಯದಿ ಪಾಲಿಸೆಂದು","ತಂದೆ ನೀನೆ ದಯದಿ ಪಾಲಿಸೆಂದು ಬಂದೆನೋ ಪ","ಹಿಂದುಮುಂದು ಗತಿಯದಾರುಯಿಲ್ಲವೆಂಬೆನೊ ಅ.ಪ","ಕುಕ್ಷಿಯೊಳಗೆ ಜಗವನಿಟ್ಟುಕೊಂಡು ಪೊರೆವನೆ","ಪಕ್ಷಿಗಮನ ನಿಮ್ಮ ನೆನೆವೆ ಭಜಕಗೊಲಿವನೆ","ಕ್ಷೀರವಾರ್ಧಿಶಯನ ಗೋಪಿ-ಜಾರ ಪಾಲಿಸೊ","ಮಾರಜನಕ ಮುದದೊಳೆನ್ನ ದೂರಲಾಲಿಸೊ","ಸುಮಹದೇವಪುರದ ನಿಲಯ-ಸುಜನರಕ್ಷನೆ","ಕ್ರಮದೊಳೆನ್ನ ರಕ್ಷಿಸಯ್ಯ-ಕಮಲೆಯಾಣ್ಮನೆ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":24,"keerthana_id":9117,"category_raw":4,"favorite":false,"header_stripped":["ನಿರ್ಗಮನ"],"unclassified_lines":[],"is_recorded_rendition":true},"_needs_review":false,"also_at":[]}]}