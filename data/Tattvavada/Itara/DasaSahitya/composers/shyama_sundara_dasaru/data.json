{"schema":"dasa_pada_text","default_author":"Shyama Sundara Dasaru","composer":"Shyama Sundara Dasaru","count":11,"bio_notes":"","items":[{"id":"shyama_sundara_dasaru__c84cfa95","form":"pada","title":{"kn":"","latin":"Dasara padagalu by Shyama sundara dasaru","iast":"","devanagari":""},"composer":"Shyama Sundara Dasaru","deity":"","tags":["composer:Shyama Sundara Dasaru","form:pada"],"raga":"","tala":"","language":"kn","text":{"kannada":[],"iast":[],"devanagari":[],"source_roman":[["Hanumanta paahi hanumanta"],["Kaye durga ambruniye"],["Dayadi salaho jayaraya"],["Jagannatha dasaru suladhi(by Shyama sundara dasaru)"],["Vijaya dasaru suladhi(by Shyamasundara dasaru)"],["Gauri devige saki tare Araati"],["Kaayo kaveri ranga karunya"],["Rajataadri nilayana"],["aarambadhali namipe"],["Sri Sathya Narayana Vrata Katha(by Shyama Sundara Dasaru)"]]},"meaning":"","source":{"site":"https://madhwafestivals.com","url":"https://madhwafestivals.com/2017/05/07/dasara-padagalu-by-shyama-sundara-dasaru/","attribution":"Public devotional archive. Reproduced for non-commercial educational/research use with attribution.","fetched":"2026-08-12"},"_has_text":false,"also_at":[]},{"id":"shyama_sundara_dasaru__3cef5130","form":"pada","title":{"kn":"","latin":"aarambadhali namipe","iast":"","devanagari":""},"composer":"Shyama Sundara Dasaru","deity":"Ganapathi","tags":["composer:Shyama Sundara Dasaru","deity:Ganapathi","form:pada"],"raga":"","tala":"","language":"kn","text":{"kannada":[["ಆರಂಭದಲಿ ನಮಿಪೆ ಬಾಗಿ ಶಿರವ","ಹೇರಂಬ ನೀನೊಲಿದು ನೀಡೆನಗೆ – ವರವ ||pa||"],["ದ್ವಿರದ ವದನನೆ ನಿರುತ | ದ್ವಿರದ ವರದನ ಮಹಿಮೆ","ಹರುಷದಲಿ ಕರಜಿಹ್ವೆ ಎರಡರಿಂದ","ಬರೆದು ಪಾಡುವದಕ್ಕೆ | ಬರುವ ವಿಷ್ನುನವ ತರಿದ","ಕರುಣದಿಂದಲಿ ಎನ್ನ ಕರಪಿಡಿದು ಸಲಹೆಂದು ||1||"],["ಕುಂಭಿಣಿಜೆ ಪತಿ ರಾಮ | ಜಂಭಾರಿ ಧರ್ಮಜರು","ಅಂಬರಾಧಿಪ ರಕುತಾಂಬರನೆ ನಿನ್ನ ||","ಸಂಭ್ರಮದಿ ಪೂಜಿಸಿದರೆಂಬವಾರುತಿ ಕೇಳಿ","ಹಂಬಲವ ಸಲಿಸೆಂದು | ನಂಬಿ ನಿನ್ನಡಿಗಳಿಗೆ||2||"],["ಸೋಮಶಾಪದ ವಿಜಿತ | ಕಾಮ ಕಾಮಿತ ದಾತ","ವಾಮ ದೇವನ ತನಯ ನೇಮದಿಂದ","ಶ್ರೀಮನೋಹರನಾಥ ಶಾಮಸುಂದರ ಸ್ವಾಮಿ ನಾಮ","ನೆನೆಯುವ ಭಾಗ್ಯ ಪ್ರೇಮದಲಿ ಕೊಡು ಎಂದು ||3||"]],"iast":[["āraṃbhadali namipè bāgi śirava","heraṃba nīnòlidu nīḍènagè – varava ||pa||"],["dvirada vadananè niruta | dvirada varadana mahimè","haruṣadali karajihvè èraḍariṃda","barèdu pāḍuvadakkè | baruva viṣnunava tarida","karuṇadiṃdali ènna karapiḍidu salahèṃdu ||1||"],["kuṃbhiṇijè pati rāma | jaṃbhāri dharmajaru","aṃbarādhipa rakutāṃbaranè ninna ||","saṃbhramadi pūjisidarèṃbavāruti keḻi","haṃbalava salisèṃdu | naṃbi ninnaḍigaḻigè||2||"],["somaśāpada vijita | kāma kāmita dāta","vāma devana tanaya nemadiṃda","śrīmanoharanātha śāmasuṃdara svāmi nāma","nènèyuva bhāgya premadali kòḍu èṃdu ||3||"]],"devanagari":[["आरंभदलि नमिपॆ बागि शिरव","हेरंब नीनॊलिदु नीडॆनगॆ – वरव ||pa||"],["द्विरद वदननॆ निरुत | द्विरद वरदन महिमॆ","हरुषदलि करजिह्वॆ ऎरडरिंद","बरॆदु पाडुवदक्कॆ | बरुव विष्नुनव तरिद","करुणदिंदलि ऎन्न करपिडिदु सलहॆंदु ||1||"],["कुंभिणिजॆ पति राम | जंभारि धर्मजरु","अंबराधिप रकुतांबरनॆ निन्न ||","संभ्रमदि पूजिसिदरॆंबवारुति केळि","हंबलव सलिसॆंदु | नंबि निन्नडिगळिगॆ||2||"],["सोमशापद विजित | काम कामित दात","वाम देवन तनय नेमदिंद","श्रीमनोहरनाथ शामसुंदर स्वामि नाम","नॆनॆयुव भाग्य प्रेमदलि कॊडु ऎंदु ||3||"]],"source_roman":[["Aarambhadali namipe baagi shiravaa |","( herambha neenolidu) needenage varavaa || pa ||"],["Dwirada vadanane niruta | dwirada vadanana mahime","Harushadali karajihwe eradarimdaa","Baredu paaduvudakke baruva vignava taridu |","Karunadimdali enna kara pididu salahemdu || 1 ||"],["Kumbhinije patiraama | jambhaari dharmajaru","Ambaraadhipa raktaambharane ninna","Sambhramadi poojisidaremba vaaruti keli","Hambalava salisemdu nambi ninnadigalige || 2 ||"],["Soma shaapada vijita | kaama kaamita daata","Vaama devana tanayaa nemadimdaa","Shreemanoharanaada shyaamasumdaraswaami naama","Neneyuva bhaagya premadali kodu emdu || 3 ||"]]},"meaning":"","source":{"site":"https://madhwafestivals.com","url":"https://madhwafestivals.wordpress.com/2016/08/24/aarambadhali-namipe/","attribution":"Public devotional archive. Reproduced for non-commercial educational/research use with attribution.","fetched":"2026-08-12"},"_has_text":true,"also_at":[]},{"id":"shyama_sundara_dasaru__91fe8614","form":"pada","title":{"kn":"","latin":"Rajataadri nilayana","iast":"","devanagari":""},"composer":"Shyama Sundara Dasaru","deity":"Shiva","tags":["composer:Shyama Sundara Dasaru","deity:Shiva","form:pada"],"raga":"","tala":"","language":"kn","text":{"kannada":[["ರಾಜತಾದ್ರಿ ನಿಲಯನ | ರಜನೀಶ ಧರನತೋರೆ ಪಾರ್ವತಿಯೆ||pa||"],["ಪಂಚಾನನ ಶಂಕರನ | ಶ್ರೀ ಹರಿಮಂಚಪದವ ಪಡೆದವನ","ಪಂಚಬಾಣ ಮದಹರನ ಉರುವಿರಂಚಿ ಕುವರ ದೂರ್ವಾಸ ಶುಕನ ತೋರೆ ಪಾರ್ವತಿಯೆ ||1||"],["ನಂದಿಸುಶ್ಯಂದನ ಶಿವನ ಗರಳಕಂಧರ ತ್ರಿಪುರಾಂತಕನ","ಮಂದಾಕಿನಿಧರ ಭವನ ಸುರವೃಂದ ವಿನುತ ನಗಚಾಪಭವನ ತೋರೆ ಪಾರ್ವತಿಯೆ||2||"],["ಸಾಮಜ ಚರ್ಮಾಂಬರನ | ಶುಭಕಾಮಿತ ಫಲದಾಯಕ","ನವಾಮದೇವ ಮುನಿಸುತನ | ಶ್ರೀವರಶಾಮಸುಂದರನ ಸುಖನ ತೋರೆ ಪಾರ್ವತಿಯೆ ||3||"]],"iast":[["rājatādri nilayana | rajanīśa dharanatorè pārvatiyè||pa||"],["paṃcānana śaṃkarana | śrī harimaṃcapadava paḍèdavana","paṃcabāṇa madaharana uruviraṃci kuvara dūrvāsa śukana torè pārvatiyè ||1||"],["naṃdisuśyaṃdana śivana garaḻakaṃdhara tripurāṃtakana","maṃdākinidhara bhavana suravṛṃda vinuta nagacāpabhavana torè pārvatiyè||2||"],["sāmaja carmāṃbarana | śubhakāmita phaladāyaka","navāmadeva munisutana | śrīvaraśāmasuṃdarana sukhana torè pārvatiyè ||3||"]],"devanagari":[["राजताद्रि निलयन | रजनीश धरनतोरॆ पार्वतियॆ||pa||"],["पंचानन शंकरन | श्री हरिमंचपदव पडॆदवन","पंचबाण मदहरन उरुविरंचि कुवर दूर्वास शुकन तोरॆ पार्वतियॆ ||1||"],["नंदिसुश्यंदन शिवन गरळकंधर त्रिपुरांतकन","मंदाकिनिधर भवन सुरवृंद विनुत नगचापभवन तोरॆ पार्वतियॆ||2||"],["सामज चर्मांबरन | शुभकामित फलदायक","नवामदेव मुनिसुतन | श्रीवरशामसुंदरन सुखन तोरॆ पार्वतियॆ ||3||"]],"source_roman":[["Rajataadri nilayana rajanisha dharana |","Tore paarvatiye || pa ||"],["Panchaanana shankarana shreehari |","Manca padavi padedavana |","Panca baana madaharanaa | guru |","Virinci kuvara doorvaasa shukana || 1 ||"],["Nandi sushyandana shivanaa | gara |","Kandhara tripuraantakanaa |","Mandaakinidhara bhuvana suraa |","Vrundavinuta nagachaapa dharanaa || 2 ||"],["Saamaja charmaambaranaa | shubha |","Kaamita phaladaayakanaa |","Vaamadeva muni sutanaa shreevara |","Shyamasudarana premada sakhanaa || 3 ||"]]},"meaning":"","source":{"site":"https://madhwafestivals.com","url":"https://madhwafestivals.wordpress.com/2016/08/31/rajataadri-nilayana/","attribution":"Public devotional archive. Reproduced for non-commercial educational/research use with attribution.","fetched":"2026-08-12"},"_has_text":true,"also_at":[]},{"id":"shyama_sundara_dasaru__01dcdd8d","form":"pada","title":{"kn":"","latin":"Kaye durga ambruniye","iast":"","devanagari":""},"composer":"Shyama Sundara Dasaru","deity":"Mahalakshmi","tags":["composer:Shyama Sundara Dasaru","deity:Mahalakshmi","form:pada"],"raga":"","tala":"","language":"kn","text":{"kannada":[["ಕಾಯೆ ದುರ್ಗಾಂಭ್ರಣಿಯೆ | ಕಾಯೆ ಶ್ರೀ ರುಕ್ಮಿಣಿಯೆ","ಕಾಯೆ ಕಾಯೆ ಶುಭ ಕಾಯೆ ದಯದಿ ಹರಿ","ಕಾಯ ನಿಲಯೆ ವಿಧಿ ಕಾಯಜ ತಾಯೆ ||"],["ಮಾಕುಮತಿ ಶ್ರೀಕರಳೆ | ಪೋತನ ನುಡಿ ಕೇಳೆ","ಭೀಕರಳೆನಿಸುತ | ವ್ಯಾಕುಲಗೊಳಿಸದೆ","ನೀಕರುಣಿಸು ರತ್ನಾಕರನ ಮಗಳೆ ||"],["ಸೀತೆ ಸಾರಸನಯನೆ | ಶೀತಾಂಶುವಿನ ಭಗಿನಿ","ಮಾತೆ ನಮಿಪೆ ತವ | ಘಾತಕ ವ್ರಾತದ","ಭೀತೆಯ ತೋರದೆ | ಪ್ರೀತಿಯಿಂದೊಲಿದು ||"],["ಲಕ್ಷ್ಮಿಕೃತಿ ಶಾಂತಿ ಅಕ್ಷರಳೆ ಜಯವಂತಿ","ಈಕ್ಷಣ ಕರುಣಕವಾಕ್ಷದಿಂದೀಕ್ಷಿಸು","ಪೇಕ್ಷವ ಮಾಡದೆ ಮೋಕ್ಷದಾಯಕಳೆ||"],["ವಟದೆಲೆಯೊಳು ಮಲಗಿರುವ | ವಟುರೂಪಿ ಪತಿಪದವ","ಪಠಿಸುತಬ್ಜಸೀಕರ | ಪುಟದಿ ನಮಿಸುವಂಥ","ಕುಟಿಲರಹಿತೆ ಶತ | ತಟಿತ ಸನ್ನಿಭಳೆ||"],["ಭಾಮೆ ಶ್ರೀ ಭೂಸುತೆಯೆ | ಶಾಮಸುಂದರ ಸತಿಯೆ","ನಾ ಮೊರೆ ಹೊಕ್ಕೆನು | ಪ್ರೇಮದಿಂದಲಿ |ಸು","ಕ್ಷೇಮಗರೆದು ಮಮಧಾಮದಿ ನೆಲಸೆ ||"]],"iast":[["kāyè durgāṃbhraṇiyè | kāyè śrī rukmiṇiyè","kāyè kāyè śubha kāyè dayadi hari","kāya nilayè vidhi kāyaja tāyè ||"],["mākumati śrīkaraḻè | potana nuḍi keḻè","bhīkaraḻènisuta | vyākulagòḻisadè","nīkaruṇisu ratnākarana magaḻè ||"],["sītè sārasanayanè | śītāṃśuvina bhagini","mātè namipè tava | ghātaka vrātada","bhītèya toradè | prītiyiṃdòlidu ||"],["lakṣmikṛti śāṃti akṣaraḻè jayavaṃti","īkṣaṇa karuṇakavākṣadiṃdīkṣisu","pekṣava māḍadè mokṣadāyakaḻè||"],["vaṭadèlèyòḻu malagiruva | vaṭurūpi patipadava","paṭhisutabjasīkara | puṭadi namisuvaṃtha","kuṭilarahitè śata | taṭita sannibhaḻè||"],["bhāmè śrī bhūsutèyè | śāmasuṃdara satiyè","nā mòrè hòkkènu | premadiṃdali |su","kṣemagarèdu mamadhāmadi nèlasè ||"]],"devanagari":[["कायॆ दुर्गांभ्रणियॆ | कायॆ श्री रुक्मिणियॆ","कायॆ कायॆ शुभ कायॆ दयदि हरि","काय निलयॆ विधि कायज तायॆ ||"],["माकुमति श्रीकरळॆ | पोतन नुडि केळॆ","भीकरळॆनिसुत | व्याकुलगॊळिसदॆ","नीकरुणिसु रत्नाकरन मगळॆ ||"],["सीतॆ सारसनयनॆ | शीतांशुविन भगिनि","मातॆ नमिपॆ तव | घातक व्रातद","भीतॆय तोरदॆ | प्रीतियिंदॊलिदु ||"],["लक्ष्मिकृति शांति अक्षरळॆ जयवंति","ईक्षण करुणकवाक्षदिंदीक्षिसु","पेक्षव माडदॆ मोक्षदायकळॆ||"],["वटदॆलॆयॊळु मलगिरुव | वटुरूपि पतिपदव","पठिसुतब्जसीकर | पुटदि नमिसुवंथ","कुटिलरहितॆ शत | तटित सन्निभळॆ||"],["भामॆ श्री भूसुतॆयॆ | शामसुंदर सतियॆ","ना मॊरॆ हॊक्कॆनु | प्रेमदिंदलि |सु","क्षेमगरॆदु ममधामदि नॆलसॆ ||"]],"source_roman":[["Kaye durgambraniye | kaye sri rukminiyesuba kaye dayadi hari","Vidhi kayaja taye ||pa||"],["Makumati srikarale | potana nudi kele","Bikaralenisuta | vyakulagolisade","Nikarunisu ratnakarana magale ||1||"],["Site sarasanayane | sitamsuvina Bagini","Mate namipe tava | gataka vratada","Biteya torade | pritiyindolidu ||2||"],["Lakshmikruti santi aksharale jayavanti","Ikshana karunakavakshadindikshisu","Pekshava madade mokshadayakale||3||"],["Vatadeleyolu malagiruva | vaturupi patipadava","Pathisutabjasikara | putadi namisuvantha","Kutilarahite Sata | tatita sannibale||4||"],["Bame sri busuteye | syamasundara satiye","Na more hokkenu | premadindali |su","Kshemagaredu mamadhamadi nelase ||5||"]]},"meaning":"","source":{"site":"https://madhwafestivals.com","url":"https://madhwafestivals.wordpress.com/2016/10/18/kaye-durga-ambruniye/","attribution":"Public devotional archive. Reproduced for non-commercial educational/research use with attribution.","fetched":"2026-08-12"},"_has_text":true,"also_at":[]},{"id":"shyama_sundara_dasaru__1f17636f","form":"pada","title":{"kn":"","latin":"Kaayo kaveri ranga karunya","iast":"","devanagari":""},"composer":"Shyama Sundara Dasaru","deity":"Ranganatha","tags":["composer:Shyama Sundara Dasaru","deity:Ranganatha","form:pada"],"raga":"","tala":"","language":"kn","text":{"kannada":[["ಕಾಯೋ ಕಾವೇರಿರಂಗ | ಕಾರುಣ್ಯಪಾಂಗಾ ||pa||"],["ಕಾಯೊ ಕಾಯೊ ಕಾವೇರಿ ನಿಲಯನೆ","ಕಾಯೊ ವಾಙ್ಮನ ಪೂರ್ವಕದಿ ತವ","ತೋಯಜಾಂಘ್ರಿಯ ನಂಬಿದೆನುಭವ","ಮಾಯಗೆಲುವ ಉಪಾಯ ತೋರಿ ||a.pa||"],["ದೇವಾಧಿದೇವ ನೀನು | ಪ್ರಣತ ಜನರಿಗೆ","ದೇವತರು ಮಣಿಧೇನು | ಎಂದರಿತು ನಿಷ್ಟಿಲಿ","ಧಾವಿಸಿ ಬಂದೆ ನಾನು | ರಘುವಂಶ ಭಾನು","ಕಾವನಯ್ಯ ನೀನೊಲಿದು ಕರುಣದಿ","ಪಾವಮಾನಿಯ ಶಾಸ್ತ್ರವರಿತು","ಭಾವ ಭಕ್ತಿಲಿ ನಿನ್ನ ಪಾಡುವ","ಕೋವಿದರ ಸೇವಕನ ಮಾಡಿ ||1||"],["ಪನ್ನಂಗಪತಿಶಯನ | ಶಿರಬಾಗಿ ಪ್ರಾರ್ಥಿಪೆ","ಪನ್ನಂಗರಿಪುವಾಹನ | ಎನ್ನಪರಾಧವ","ಮನ್ನಿಸೊ ಹಯವದನ | ವೈಕುಂಠ ಸದನ","ನಿನ್ನನುಗ್ರಹ ಪೂರ್ಣಪಡೆದು ಜಗನ್ನಾಥದಾಸರ","ಸನ್ನಿಧಾನದಿಂ ಬಂದೆ ತಂದೆ ||2||"],["ನೇಸರ ಕುಲಜಾತ | ವೇದೋಕ್ತಕ್ರಮದಿಂ","ಭೂಸುರ ಕರಪೂಜಿತ | ಕೌಶಿಕನ ಯಜ್ಷವ","ಪೋಷಕ ಪವನಪಿತ | ಪಾವನ್ನ ಚರಿತ","ವಾಸುದೇವಾನಂತ ಮಹಿಮೆ | ವಿಭೀಷಣಪ್ರಿಯ","ದೋಷಕಳೆಯುವ | ಭೇಷಪುಷ್ಕರಣೀಶ","ಕೇಶವ ದಾಶರಧಿ ಶ್ರೀ ಶಾಮಸುಂದರ ||3||"]],"iast":[["kāyo kāveriraṃga | kāruṇyapāṃgā ||pa||"],["kāyò kāyò kāveri nilayanè","kāyò vāṅmana pūrvakadi tava","toyajāṃghriya naṃbidènubhava","māyagèluva upāya tori ||a.pa||"],["devādhideva nīnu | praṇata janarigè","devataru maṇidhenu | èṃdaritu niṣṭili","dhāvisi baṃdè nānu | raghuvaṃśa bhānu","kāvanayya nīnòlidu karuṇadi","pāvamāniya śāstravaritu","bhāva bhaktili ninna pāḍuva","kovidara sevakana māḍi ||1||"],["pannaṃgapatiśayana | śirabāgi prārthipè","pannaṃgaripuvāhana | ènnaparādhava","mannisò hayavadana | vaikuṃṭha sadana","ninnanugraha pūrṇapaḍèdu jagannāthadāsara","sannidhānadiṃ baṃdè taṃdè ||2||"],["nesara kulajāta | vedoktakramadiṃ","bhūsura karapūjita | kauśikana yajṣava","poṣaka pavanapita | pāvanna carita","vāsudevānaṃta mahimè | vibhīṣaṇapriya","doṣakaḻèyuva | bheṣapuṣkaraṇīśa","keśava dāśaradhi śrī śāmasuṃdara ||3||"]],"devanagari":[["कायो कावेरिरंग | कारुण्यपांगा ||pa||"],["कायॊ कायॊ कावेरि निलयनॆ","कायॊ वाङ्मन पूर्वकदि तव","तोयजांघ्रिय नंबिदॆनुभव","मायगॆलुव उपाय तोरि ||a.pa||"],["देवाधिदेव नीनु | प्रणत जनरिगॆ","देवतरु मणिधेनु | ऎंदरितु निष्टिलि","धाविसि बंदॆ नानु | रघुवंश भानु","कावनय्य नीनॊलिदु करुणदि","पावमानिय शास्त्रवरितु","भाव भक्तिलि निन्न पाडुव","कोविदर सेवकन माडि ||1||"],["पन्नंगपतिशयन | शिरबागि प्रार्थिपॆ","पन्नंगरिपुवाहन | ऎन्नपराधव","मन्निसॊ हयवदन | वैकुंठ सदन","निन्ननुग्रह पूर्णपडॆदु जगन्नाथदासर","सन्निधानदिं बंदॆ तंदॆ ||2||"],["नेसर कुलजात | वेदोक्तक्रमदिं","भूसुर करपूजित | कौशिकन यज्षव","पोषक पवनपित | पावन्न चरित","वासुदेवानंत महिमॆ | विभीषणप्रिय","दोषकळॆयुव | भेषपुष्करणीश","केशव दाशरधि श्री शामसुंदर ||3||"]],"source_roman":[["Kayo kaveri ranga karunya panga ||pa.||"],["Kayo kayo kaveri nilayane kaya va~gmanapurnadallindu","Toyajanghriya nambideno bhava maya geluva upaya tori ||a.pa.||"],["Devadhideva ninu pranatajanarige devatarumanidhenu","Endaritu nishthili dhavisi bande nanu raghuvamsha bhanu |","Kavanayya ni olidu karunadi pavamaniya shastravaritu","Bhavabhakutili ninna paduva kovidara sevakana madi ||1||"],["Pannangapati shayana shirabagi prarthipe pannangaripu vahana","Ennaparadhava manniso hayavadana vaikunthasadana |","Ninnanugraha purna padedu dhanyarenisida manya manavi","Ghanna guru jagannathadasara sannidhanadi bande prabhuve ||2||"],["Nesarakulajata vedokta kramadim bhusurakara pujita","Koushikana yagnava poshaka pavanapita pavanna charita |","Vasudevananta mahima vibhishanapriya dosha kaleyuva","Bhesha pushkaranisha keshava dasharathi shri shyamasundara ||3||"]]},"meaning":"","source":{"site":"https://madhwafestivals.com","url":"https://madhwafestivals.wordpress.com/2016/11/09/kayo-kaveri-ranga-karunya/","attribution":"Public devotional archive. Reproduced for non-commercial educational/research use with attribution.","fetched":"2026-08-12"},"_has_text":true,"also_at":[]},{"id":"shyama_sundara_dasaru__85225223","form":"pada","title":{"kn":"","latin":"Hanumanta paahi hanumanta","iast":"","devanagari":""},"composer":"Shyama Sundara Dasaru","deity":"Hanuma","tags":["composer:Shyama Sundara Dasaru","deity:Hanuma","form:pada"],"raga":"","tala":"","language":"kn","text":{"kannada":[["ಹನುಮಂತ ಪಾಹಿ ಹನುಮಂತ ।","ಮುನಿವ್ಯಾಸ ಕರಕಮಲಾರ್ಚಿತ ಜಯವಂತ ।। pa। ।"]],"iast":[["hanumaṃta pāhi hanumaṃta |","munivyāsa karakamalārcita jayavaṃta || pa| |"]],"devanagari":[["हनुमंत पाहि हनुमंत ।","मुनिव्यास करकमलार्चित जयवंत ।। pa। ।"]],"source_roman":[["Hanumanta pahi hanumanta |","Munivyasa karakamalarcita jayavanta || Pa ||"],["Bulola kolajakula sumandira |","Palaksha paulomipati vandita |","Kalakaladi ninna Olaisuvara sanga |","Palisu karunadi kali manohara || 1 ||"],["Bana rupane panchabana nirjitane | Sha |","Tkona madhyadi bamdu ni nelesi |","Kshonigirvana susreniyindarcane |","Manade kaikomba vanisa sthanarha || 2 ||"],["Sindhu bandhana syamasundaraviththalana |","Dvandva padaravindake madhupa |","Nendenisida guru gandhavahana | nina |","Gondisuvenu bavabandha bidisi kayo || 3||"]]},"meaning":"","source":{"site":"https://madhwafestivals.com","url":"https://madhwafestivals.wordpress.com/2016/12/15/song-on-yanthrodharaka-hanuman-composed-by-shyama-sundara-dasaru/","attribution":"Public devotional archive. Reproduced for non-commercial educational/research use with attribution.","fetched":"2026-08-12"},"_has_text":true,"also_at":[]},{"id":"shyama_sundara_dasaru__dd49bcbb","form":"pada","title":{"kn":"","latin":"Gauri devige saki tare Araati","iast":"","devanagari":""},"composer":"Shyama Sundara Dasaru","deity":"Gowri","tags":["composer:Shyama Sundara Dasaru","deity:Gowri","form:pada"],"raga":"","tala":"","language":"kn","text":{"kannada":[["ಗೌರಿ ದೇವಿಗೆ ಸಖಿ ತಾರೆ ಆರುತಿ||pa||"],["ಮುನಿಜನ ವಂದಿತೆ ಮನದಭಿ ಮಾನಿಯೆ |","ಗಣಪತಿ ಷಣ್ಮುಖ ಜನನಿ ದೇವಿಗೆ ||1||"],["ಶಂಕರಿ ಭಕ್ತಸುಶಂಕರಿ ದೈತ್ಯ ಭ","ಯಂಕಾರಿಯಾದ ಶಶಾಂಕ ಮುಖಿಗೆ ||2||"],["ಶಾಮಸುಂದರನಾಮ ಪತಿ ಸಹ","ನೇಮದಿ ಪಠಿಸುವ ಹೈಮಾವತಿಗೆ ||3||"]],"iast":[["gauri devigè sakhi tārè āruti||pa||"],["munijana vaṃditè manadabhi māniyè |","gaṇapati ṣaṇmukha janani devigè ||1||"],["śaṃkari bhaktasuśaṃkari daitya bha","yaṃkāriyāda śaśāṃka mukhigè ||2||"],["śāmasuṃdaranāma pati saha","nemadi paṭhisuva haimāvatigè ||3||"]],"devanagari":[["गौरि देविगॆ सखि तारॆ आरुति||pa||"],["मुनिजन वंदितॆ मनदभि मानियॆ |","गणपति षण्मुख जननि देविगॆ ||1||"],["शंकरि भक्तसुशंकरि दैत्य भ","यंकारियाद शशांक मुखिगॆ ||2||"],["शामसुंदरनाम पति सह","नेमदि पठिसुव हैमावतिगॆ ||3||"]],"source_roman":[["Gauri devige saki tare Aruti||pa||"],["Munijana vandite manadabi maniye |","Ganapati shanmuka janani devige ||1||"],["Sankari baktasusankari daitya Ba","Yamkariyada sasanka mukige ||2||"],["Samasundaranama pati saha","Nemadi pathisuva haimavatige ||3||"]]},"meaning":"","source":{"site":"https://madhwafestivals.com","url":"https://madhwafestivals.wordpress.com/2017/01/17/gauri-devige-saki-tare-araati/","attribution":"Public devotional archive. Reproduced for non-commercial educational/research use with attribution.","fetched":"2026-08-12"},"_has_text":true,"also_at":[]},{"id":"shyama_sundara_dasaru__8c85b6d3","form":"suladi","title":{"kn":"","latin":"Jagannatha dasaru suladhi(by Shyama sundara dasaru)","iast":"","devanagari":""},"composer":"Shyama Sundara Dasaru","deity":"","tags":["composer:Shyama Sundara Dasaru","on:Jagannatha Dasaru","suladi_index:Suladi Index","yati:Jagannatha Dasaru","form:suladi"],"raga":"","tala":"","language":"kn","text":{"kannada":[["ಧ್ರುವತಾಳ","ಪೊಂದಿ ಭಜಿಸು ಸತತ | ಒಂದೇ ಮನದಿ ಸ್ತಂಭ","ಮಂದಿರ ಮಾನವಿ ದಾಸಾರ್ಯರ ಪ","ಮಂದ ಮಾನವ ಕೇಳೋ | ವಂದಿಸಿ ಸೇವಿಪರ","ಬಂಧನ ಪರಿಹರಿಸಿ ಮನದಾಭೀಷ್ಟ","ತಂದು ಕೊಡುವದಕ್ಕೆ | ಮಂದಾರ ಕುಜದಂತೆ","ಬಂದಿಲ್ಲಿ ನಿಂದಿಹ್ಯರೆಂದು ತಿಳಿಯೊ","ಛಂದಾಗಿ ಇವರು ದಯದಿ | ಕಣ್ಣೆರದು ನೋಡಿದರೆ","ಬೆಂದು ಪೋಪವು ದೋಷ ವೃಂದವೆಲ್ಲ","ಕಂದನು ಮಾಡಿದ ಕುಂದು ಕ್ಷಮಿಸಿ ತಾಯಿ","ತಂದೆ ಸಕಹುವಂತೆ ರಕ್ಷಿಸುವರೊ","ಹಿಂದೆ ಸಹ್ಲಾದ ಶಲ್ಯನೆಂದೆನಿಸುತ ಪು |","ರಂದರಗುರು ಸ್ವಾದಿರಾಜರ ಪ್ರೀತ","ಸಿಂಧುವರದ ಶಾಮಸುಂದರನಾಜ್ಞದಿ","ಇಂದುವಿನಂತೆ ಮೂಡಿ ಪುನಃ ಜಗದಿ||1||"],["ಮಟ್ಟತಾಳ","ತ್ವರವಾಡದಿ ಜನಿಸಿ | ವರದೇಂದ್ರನೊಲಿಸಿ","ಮರುತಾಗಮ ಗಳಿಸಿ | ತುರುಕ್ಷಕದಾಸ","ವರಿಯರ ಕರುಣದಲಿ | ಶರಧಿಜ ಭಾಗದಲಿ ಧರಣಿಪ ವಿಠಲೆಂಬ","ಸುರಚಿರದಂಕಿತವ | ದೊರಕಿಸಿ ಪ್ರಾಕೃತದಿ","ಕರುಣಾಕರ ಶಾಮಸುಂದರನೊರಣಿಸಿದ","ಪರಮಭಾಗವತರ ನೆರೆನಂಬೊ ನಿರುತ ||2||"],["ತ್ರಿವಿಡತಾಳ","ಇವರ ಸಂದರುಶನ ಭವಬಂಧ ಮೋಚನ","ಇವರ ಸಂದÀರುಶನ ಭವಬಂಧಮೋಚನ","ಇವರ ಚರಣ ಧ್ಯಾನ ಗಂಗಾಸ್ನಾನ","ಇವರನ ಸಾರಿದರೆ ಜವನ ಅಂಜಿಕೆಯಿಲ್ಲ","ಇವರ ಕವನ ಸ್ತವನ ಶ್ರವಣದಿಂದ","ಪವನ ಸಚ್ಚ್ಯಾಸ್ತ್ರ ಪ್ರವಚನ ಫಲವಕ್ಕು","ಇವರಿದ್ದ ಸ್ಥಳ ಕಾಶಿ ರಾಮೇಶ್ವರ","ಇವರಲ್ಲಿ ಸಮಸ್ತ ದಿವಿಜರು ನೆಲೆಸಿದ್ದು","ಇವರಂದ ವಚನವ ನಡೆಸುವರು","ಇವರಲ್ಲಿರಲು ಬಿಟ್ಟು ಅವನಿಸುತ್ತಿದರವಗೆ","ಲವಲೇಶವಾದರು ಪುಣ್ಯವಿಲ್ಲ","ಇವರನುಗ್ರಹವಾಗೆ ಶ್ರೀ ಶಾಮಸುಂದರನು","ತವಕದಿ ಕೈಪಿಡಿದು ಸಲಹುವ ಸರ್ವದ ||3||"],["ಅಟ್ಟತಾಳ","ಧಾರುಣಿ ಸುರರ | ಉದ್ಧಾರಗೋಸುಗವಾಗಿ |","ಮೂರೆಂಟು ಈರಾರು ಚಾರುಲಕ್ಷಣವುಳ್ಳ |","ಭಾರತಿಪತಿಯಂತೆ ತೋರುವ ಕಾಯುವ","ಶೌರಿ ಕಥಾಮೃತ ಸಾರ ಸುಗ್ರಂಥವಾ","ತಾ ರಚಿಸಿದ ಉಪಕಾರವು ವರ್ಣಿಸ","ಲಾರಿಂದ ಸಾಧ್ಯವು | ಪಾರಾಯಣ ಪ್ರತಿ","ವಾರ ಬಿಡದೆ ಮಾಡೆ ಸಾರಲೇನು | ಸಂ","ಸಾರ ಶರಧಿಯಿಂದ ಪಾರಾಗಿ ಸದ್ಭಕುತಿ","ಪಾರಮಾರ್ಥಜ್ಞಾನ ವೈರಾಗ್ಯ ಪಡೆವ್ರತ","ನಾರದ ನಮಿತ ಶ್ರೀ ಶಾಮಸುಂದರನ ಹೃ","ದ್ವಾರಿಜದೊಳು ಕಂಡು ಸೂರೆಗೊಂಬ ಸುಖ ||4||"],["ಆದಿತಾಳ","ಈತನ ಭಜಿಸಲು | ಯಾತನೆಗಳು ಇಲ್ಲ","ಈತನ ಸೇರಲು | ಯಾತರ ಭೀತಿಯು","ಈತನ ಹೊರತಿನ್ನು | ದಾತರೆ ನಮಗಿಲ್ಲ","ಈತನೆ ರಕ್ಷಕ | ಈತನೆ ತಂದೆ ತಾಯಿ","ಈತನೆ ಸದ್ಗುರು | ಈತನೆ ಗತಿಪ್ರದ","ಈತನು ಮೂಕಗೆ | ಮಾತು ನುಡಿಸಿದಾತ","ಈತನ ಭಕುತಿಗೆ | ಸೋತು ಎರಡುವ್ಯಾಳ್ಯ","ವಾತಾಂತರ್ಗತ ನಮ್ಮ ಶಾಮಸುಂದರವಿಠಲ","ಪ್ರೀತಿಯಿಂದಿವರಿಗೆ ಮೃಷ್ಟಾನ್ನ ಉಣಿಸಿದ ||5||"],["ಜತೆ","ಈ ಮಹಾಮಹಿಮರ ಪ್ರೇಮ ಪಡೆದವರನ್ನು","ಶಾಮಸುಂದರಸ್ವಾಮಿ ಸತತ ಪೊರೆವ ||6||"]],"iast":[["dhruvatāḻa","pòṃdi bhajisu satata | òṃde manadi staṃbha","maṃdira mānavi dāsāryara pa","maṃda mānava keḻo | vaṃdisi sevipara","baṃdhana pariharisi manadābhīṣṭa","taṃdu kòḍuvadakkè | maṃdāra kujadaṃtè","baṃdilli niṃdihyarèṃdu tiḻiyò","chaṃdāgi ivaru dayadi | kaṇṇèradu noḍidarè","bèṃdu popavu doṣa vṛṃdavèlla","kaṃdanu māḍida kuṃdu kṣamisi tāyi","taṃdè sakahuvaṃtè rakṣisuvarò","hiṃdè sahlāda śalyanèṃdènisuta pu |","raṃdaraguru svādirājara prīta","siṃdhuvarada śāmasuṃdaranājñadi","iṃduvinaṃtè mūḍi punaḥ jagadi||1||"],["maṭṭatāḻa","tvaravāḍadi janisi | varadeṃdranòlisi","marutāgama gaḻisi | turukṣakadāsa","variyara karuṇadali | śaradhija bhāgadali dharaṇipa viṭhalèṃba","suraciradaṃkitava | dòrakisi prākṛtadi","karuṇākara śāmasuṃdaranòraṇisida","paramabhāgavatara nèrènaṃbò niruta ||2||"],["triviḍatāḻa","ivara saṃdaruśana bhavabaṃdha mocana","ivara saṃdaÀruśana bhavabaṃdhamocana","ivara caraṇa dhyāna gaṃgāsnāna","ivarana sāridarè javana aṃjikèyilla","ivara kavana stavana śravaṇadiṃda","pavana saccyāstra pravacana phalavakku","ivaridda sthaḻa kāśi rāmeśvara","ivaralli samasta divijaru nèlèsiddu","ivaraṃda vacanava naḍèsuvaru","ivaralliralu biṭṭu avanisuttidaravagè","lavaleśavādaru puṇyavilla","ivaranugrahavāgè śrī śāmasuṃdaranu","tavakadi kaipiḍidu salahuva sarvada ||3||"],["aṭṭatāḻa","dhāruṇi surara | uddhāragosugavāgi |","mūrèṃṭu īrāru cārulakṣaṇavuḻḻa |","bhāratipatiyaṃtè toruva kāyuva","śauri kathāmṛta sāra sugraṃthavā","tā racisida upakāravu varṇisa","lāriṃda sādhyavu | pārāyaṇa prati","vāra biḍadè māḍè sāralenu | saṃ","sāra śaradhiyiṃda pārāgi sadbhakuti","pāramārthajñāna vairāgya paḍèvrata","nārada namita śrī śāmasuṃdarana hṛ","dvārijadòḻu kaṃḍu sūrègòṃba sukha ||4||"],["āditāḻa","ītana bhajisalu | yātanègaḻu illa","ītana seralu | yātara bhītiyu","ītana hòratinnu | dātarè namagilla","ītanè rakṣaka | ītanè taṃdè tāyi","ītanè sadguru | ītanè gatiprada","ītanu mūkagè | mātu nuḍisidāta","ītana bhakutigè | sotu èraḍuvyāḻya","vātāṃtargata namma śāmasuṃdaraviṭhala","prītiyiṃdivarigè mṛṣṭānna uṇisida ||5||"],["jatè","ī mahāmahimara prema paḍèdavarannu","śāmasuṃdarasvāmi satata pòrèva ||6||"]],"devanagari":[["ध्रुवताळ","पॊंदि भजिसु सतत | ऒंदे मनदि स्तंभ","मंदिर मानवि दासार्यर प","मंद मानव केळो | वंदिसि सेविपर","बंधन परिहरिसि मनदाभीष्ट","तंदु कॊडुवदक्कॆ | मंदार कुजदंतॆ","बंदिल्लि निंदिह्यरॆंदु तिळियॊ","छंदागि इवरु दयदि | कण्णॆरदु नोडिदरॆ","बॆंदु पोपवु दोष वृंदवॆल्ल","कंदनु माडिद कुंदु क्षमिसि तायि","तंदॆ सकहुवंतॆ रक्षिसुवरॊ","हिंदॆ सह्लाद शल्यनॆंदॆनिसुत पु |","रंदरगुरु स्वादिराजर प्रीत","सिंधुवरद शामसुंदरनाज्ञदि","इंदुविनंतॆ मूडि पुनः जगदि||1||"],["मट्टताळ","त्वरवाडदि जनिसि | वरदेंद्रनॊलिसि","मरुतागम गळिसि | तुरुक्षकदास","वरियर करुणदलि | शरधिज भागदलि धरणिप विठलॆंब","सुरचिरदंकितव | दॊरकिसि प्राकृतदि","करुणाकर शामसुंदरनॊरणिसिद","परमभागवतर नॆरॆनंबॊ निरुत ||2||"],["त्रिविडताळ","इवर संदरुशन भवबंध मोचन","इवर संदÀरुशन भवबंधमोचन","इवर चरण ध्यान गंगास्नान","इवरन सारिदरॆ जवन अंजिकॆयिल्ल","इवर कवन स्तवन श्रवणदिंद","पवन सच्च्यास्त्र प्रवचन फलवक्कु","इवरिद्द स्थळ काशि रामेश्वर","इवरल्लि समस्त दिविजरु नॆलॆसिद्दु","इवरंद वचनव नडॆसुवरु","इवरल्लिरलु बिट्टु अवनिसुत्तिदरवगॆ","लवलेशवादरु पुण्यविल्ल","इवरनुग्रहवागॆ श्री शामसुंदरनु","तवकदि कैपिडिदु सलहुव सर्वद ||3||"],["अट्टताळ","धारुणि सुरर | उद्धारगोसुगवागि |","मूरॆंटु ईरारु चारुलक्षणवुळ्ळ |","भारतिपतियंतॆ तोरुव कायुव","शौरि कथामृत सार सुग्रंथवा","ता रचिसिद उपकारवु वर्णिस","लारिंद साध्यवु | पारायण प्रति","वार बिडदॆ माडॆ सारलेनु | सं","सार शरधियिंद पारागि सद्भकुति","पारमार्थज्ञान वैराग्य पडॆव्रत","नारद नमित श्री शामसुंदरन हृ","द्वारिजदॊळु कंडु सूरॆगॊंब सुख ||4||"],["आदिताळ","ईतन भजिसलु | यातनॆगळु इल्ल","ईतन सेरलु | यातर भीतियु","ईतन हॊरतिन्नु | दातरॆ नमगिल्ल","ईतनॆ रक्षक | ईतनॆ तंदॆ तायि","ईतनॆ सद्गुरु | ईतनॆ गतिप्रद","ईतनु मूकगॆ | मातु नुडिसिदात","ईतन भकुतिगॆ | सोतु ऎरडुव्याळ्य","वातांतर्गत नम्म शामसुंदरविठल","प्रीतियिंदिवरिगॆ मृष्टान्न उणिसिद ||5||"],["जतॆ","ई महामहिमर प्रेम पडॆदवरन्नु","शामसुंदरस्वामि सतत पॊरॆव ||6||"]],"source_roman":[["dhruvatALa","pondi Bajisu satata | ondE manadi staMBa","mandira mAnavi dAsAryara pa","manda mAnava kELO | vandisi sEvipara","bandhana pariharisi manadABIShTa","tandu koDuvadakke | mandAra kujadante","bandilli nindihyarendu tiLiyo","CandAgi ivaru dayadi | kaNNeradu nODidare","bendu pOpavu dOSha vRundavella","kandanu mADida kundu kShamisi tAyi","tande sakahuvante rakShisuvaro","hinde sahlAda Salyanendenisuta pu |","randaraguru svAdirAjara prIta","sindhuvarada SAmasundaranAj~jadi","induvinante mUDi punaH jagadi||1||"],["maTTatALa","tvaravADadi janisi | varadEndranolisi","marutAgama gaLisi | turukShakadAsa","variyara karuNadali | Saradhija BAgadali dharaNipa viThaleMba","suraciradankitava | dorakisi prAkRutadi","karuNAkara SAmasundaranoraNisida","paramaBAgavatara nerenaMbo niruta ||2||"],["triviDatALa","ivara sandaruSana Bavabandha mOcana","ivara sandaÀruSana BavabandhamOcana","ivara caraNa dhyAna gangAsnAna","ivarana sAridare javana anjikeyilla","ivara kavana stavana SravaNadinda","pavana saccyAstra pravacana Palavakku","ivaridda sthaLa kASi rAmESvara","ivaralli samasta divijaru nelesiddu","ivaranda vacanava naDesuvaru","ivaralliralu biTTu avanisuttidaravage","lavalESavAdaru puNyavilla","ivaranugrahavAge SrI SAmasundaranu","tavakadi kaipiDidu salahuva sarvada ||3||"],["aTTatALa","dhAruNi surara | uddhAragOsugavAgi |","mUrenTu IrAru cArulakShaNavuLLa |","BAratipatiyante tOruva kAyuva","Sauri kathAmRuta sAra sugranthavA","tA racisida upakAravu varNisa","lArinda sAdhyavu | pArAyaNa prati","vAra biDade mADe sAralEnu | saM","sAra Saradhiyinda pArAgi sadBakuti","pAramArthae gnana vairAgya paDevrata","nArada namita SrI SAmasundarana hRu","dvArijadoLu kanDu sUregoMba suKa ||4||"],["AditALa","Itana Bajisalu | yAtanegaLu illa","Itana sEralu | yAtara BItiyu","Itana horatinnu | dAtare namagilla","Itane rakShaka | Itane tande tAyi","Itane sadguru | Itane gatiprada","Itanu mUkage | mAtu nuDisidAta","Itana Bakutige | sOtu eraDuvyALya","vAtAntargata namma SAmasundaraviThala","prItiyindivarige mRuShTAnna uNisida ||5||"],["jate","I mahAmahimara prEma paDedavarannu","SAmasundarasvAmi satata poreva ||6||"]]},"meaning":"","source":{"site":"https://madhwafestivals.com","url":"https://madhwafestivals.wordpress.com/2017/03/26/jagannatha-dasaru-suladhiby-shyama-sundara-dasaru/","attribution":"Public devotional archive. Reproduced for non-commercial educational/research use with attribution.","fetched":"2026-08-12"},"_has_text":true,"also_at":[]},{"id":"shyama_sundara_dasaru__c4060847","form":"suladi","title":{"kn":"","latin":"Vijaya dasaru suladhi(by Shyamasundara dasaru)","iast":"","devanagari":""},"composer":"Shyama Sundara Dasaru","deity":"","tags":["composer:Shyama Sundara Dasaru","on:Vijayadasaru","suladi_index:Suladi Index","yati:Vijayadasaru","form:suladi"],"raga":"","tala":"","language":"kn","text":{"kannada":[["ಧ್ರುವತಾಳ","ನಿಷ್ಟೆಯಿಂದಲಿ ಮನ | ಮುಟ್ಟಿ ಭಜಿಸೊ ವಿಜಯ ||","ವಿಠಲದಾಸರ ಮನವೆ ನಿತ್ಯ ||","ಎಷ್ಟು ಹೇಳಲಿ ಇವರ ಉತ್ಕøಷ್ಟ ಮಹಿಮೆ ಕೃಪಾ |","ದೃಷ್ಟಿಯಿಂದಲಿ ನೋಡಿದಾಕ್ಷಣದಿ ||","ಭ್ರಷ್ಟ ಮನಸಿಲಿಂದ | ಬಿಟ್ಟು ಧರ್ಮಾಚರಣೆ","ಧೃಷ್ಟ ಕೃತ್ಯವಗೈದು ದೋಷದಿಂದ |","ತಪ್ಪಿದ ದುರಿತೌಷ | ಮೊಟ್ಟೆಗಳೆಲ್ಲವು |","ಸುಟ್ಟು ಭಸ್ಮೀ ಭೂತವಾದ ಬಳಿಕ","ಪುಟ್ಟ ಸುಜ್ಞಾನ ಭಕ್ತಿ ವೈರಾಗ್ಯ ಭರಿತರಾಗಿ","ಮೆಟ್ಟುವರೋ ಕೈವಲ್ಯ ಪಥವಾ ||","ಸೃಷ್ಟಿ ಸಂಹಾರಕರ್ತರಿದ್ದಲ್ಲಿ ಪೋಗಿ |","ಸಿಟ್ಟಿನಿಂದಲಿ ಕೊಟ್ಟು ಶಾಪವನ್ನು","ಥಟ್ಟನೆ ವೈಕುಂಟ ಪಟ್ಟಣಕ್ಕೆ ತೆರಳಿ","ಪಟ್ಟದರಸಿಯಾದ ಲಕುಮಿ ಸಹಿತಾ","ಸೃಷ್ಟ್ಯಾಂಡ ಭಾರ ಶಿರದಿ ಇಟ್ಟಂಥಾ ಫಣಿ ಪತಿಯಾ","ಪಟ್ಟಿ ಪರ್ಯಂಕದಲ್ಲಿ ಪವಡಿಸಿಪ್ಪಾ","ಧಿಟ್ಟ ಮೂರುತಿ ಶಾಮಸುಂದರವಿಠಲಗೆ","ಪೆಟ್ಟು ಹಾಕಿದ ಪರಮ ಘಟ್ಟಿಗರಿವರು ||1||"],["ಮಟ್ಟತಾಳ","ಎರಡನೆಯುಗದಲ್ಲಿ ಸುರಲೀಲನು ಎಂಬ","ತರುಚರ ರೂಪದಲಿ ತರು\\ಣಿಕುಲೋದ್ಭವನಾ","ಚರಣವ ಸೇವಿಸಿ ಕರುಣ ಸಂಪಾದಿಸಿದಾ","ಮರಳಿ ನಿಕಂಪಾ ನಾಮದಲಿ | ದ್ವಾ","ಪರದಲಿ ಪುಟ್ಟ ಯಾದವನೆನಿಸಿದಾ","ಅರುಹಲೇನು ಮತ್ತೆ ಚರಣಜಕುಲದಲ್ಲಿ","ಧರಿಸುತ ಜನ್ಮವನು ಕರುಣಾಕರ","ಶಾಮಸುಂದರನಂಘ್ರಿಗೆ ಶರಧನುವಿಗೆ ಹೂಡಿ","ಗುರಿ ನೋಡಿ ಎಸೆದಾ ||2||"],["ತ್ರಿವಿಡತಾಳ","ಪುನಃ ಕಲಿಯುಗದಲ್ಲಿ ಅನುಪಮ ಸನ್ಮಹಿಮ","ಅನಿಮಿಷನಾಥಾಖ್ಯ ದಾಸಾರ್ಯರಾ","ಮನೆಯಲ್ಲಿ ಗೋವತ್ಸನೆನಿಸಿ ವಾಸಿಸಿ ಹರಿಯಾ","ಗುಣನಾಮಕೀರ್ತನೆ ಶ್ರವಣಗೈದಾ","ಘÀನಪುಣ್ಯದಿಂ ಪಶುತನವು ಪೋಗಾಡುತ್ತ","ತನಯರಾಗಿ ಅವರ ಬಳಿಯಲಿದ್ದು","ಮುನಿಮಧ್ವಪತಿ ಎಂಬೊ ಪೆಸರಿನಿಂದಲಿ ಸದಾ","ಮಿನುಗುವರೊಡಗೂಡಿ ಕವನದಿಂದಾ","ಅನನುತ ಶ್ರೀ ಶಾಮಸುಂದರವಿಠಲನ್ನ","ಮನದಿ ಕೊಂಡಾಡುತ್ತ ಅನುಗ್ರಹ ಪಡೆದರೂ ||3||"],["ಅಟ್ಟತಾಳ","ಕ್ಷಿತಿಯೊಳು ಮಾನವಿ ಸೀಮಗೆ ಸೇರಿದ","ಕ್ಷಿತಿಧರ ದೇವನೆ ಸುತೆಯ ಸುತೀರದಿ","ಕ್ಷಿತಿರುಹವರ ನರಹರಿ ಸಾನ್ನಿಧ್ಯದಿ","ಅತಿ ಪುಣ್ಯಕರ ಪುಟ್ಟ ಬದರಿ ಸುಕ್ಷೇತ್ರದಿ","ಸತಿ ಶಿರೋಮಣಿಯಾದ ಕೂಸಮ್ಮನುದರದಿ","ಸುತನಾಗಿ ಪ್ರತಿದಿನ ಶಶಿಯಂತೆ ಬೆಳೆಯುತ್ತ","ಅತಿಶಯ ದಾರಿದ್ತ್ಯ ವ್ಯಥೆಯು ಆವರಿಸಲು","ಖತಿ ಲೇಶವಾಗದೆ ಸಹಿಸುತ್ತ ಶಾಂತದಿ","ಮತಿಯಿಂದ ಮನದೊಳು ಯೋಚಿಸಿ ಮುಂದಣ","ಗತಿಗಾಗಿ ತಾ ಪೋಗಿ ವಾರಣಾಶಿಯಲ್ಲಿ","ಪತಿತರುದ್ಧರಿಸುವ ಸುರನದಿಯಲಿ ಮಿಂದು","ಶಿತಮನದವರಾಗಿ ಇರುತಿರಲೊಂದಿನ","ಸ್ತುತಿಸುತ್ತ ಹರಿಪಾದ ಮಲಗಿರೆ ಸ್ವಪ್ನದಿ","ಶತಧೃತಿನಂದನ ಕರೆದೊಯ್ದಾಚೆಗೆ ಇಪ್ಪ","ಕ್ರತುಭುಜ ತತಿಯಿಂದ ಸುತನಾದ ಶ್ರೀ ಶುಕ","ಪಿತನಂಘ್ರಿ ಕಮಲಕ್ಕೆ ನುತಿಸಿ ಬಿನ್ನೈಸಿದಾ","ಹಿತದಿ ಸಹೋದರ ಇವನ ರಕ್ಷಿಸೆನೆ","ಶೃತಿಗೆ ಸಮ್ಮತ ಮಧ್ವಮತದ ರಹಸ್ಯದ","ಕೃತಿಗಳ ರಚಿಸಿ ಪ್ರಾಕೃತ ಸುಭಾಷೆಯಲ್ಲಿ","ಸತತ ಶ್ರವಣದಿಂದಾ ಮತಿಮಂದ ಜನರು ಉ","ಧೃತರಾಗುವಂದದಿ ಕಥಿಸುತಗರೆದ ಸಂ","ಕೀರ್ತನವನು ಕೃಪೆಯಿಂದಾ ಯತಿಗಳ ಮನೋಹರ","ಕೃತಿದೇವಿ ಪತಿ ಶಾಮಸುಂದರವಿಠಲಾ ||4||"],["ಆದಿತಾಳ","ಮೌನಿ ಸನ್ಮೌನಿ ಸುe್ಞÁನಿವರ್ಯರಾದ ಇವರ ಅ","ಮಾನುಷ ಕೃತಿಗಳು ಭಾನುವಿನ ಕಿರಣದಂತೆ","ಕ್ಷೋಣಿಯೊಳು ತುಂಬಿರಲು ಹೀನಮತಿ","ಮನುಜನಾದ ನಾನೆಂತು ಪೇಳ್ವೆನೈಯಾ","ನೀನೇವೆ ಗತಿಯೆಂದು ಮೊರೆಹೊಕ್ಕ ದೀನರಿಗೆ","ಸಾನುರಾಗದಿ ಒಲಿದು ಪ್ರಾಣವನ್ನು","ಜ್ಞಾನ ವನ್ನು ದಾನವನ್ನು ಮಾಡಿದರು","ವೇಣುಧೇನುಪಾಲ ತುರಗಾನನ ಮೋಹನ","ಜಾಣ ಜಗನ್ನಾಥಧಾಸ ಶ್ರೇಣಿಯ ಸಾಕ್ಷಿಕೇಳು","ಈ ನುಡಿ ನಿಜವೆಂದು ಮಾನಸದೊಳಗನುಮಾನವಿಲ್ಲದೆ ಸದಾ","ಮಾಣದೆ ಇವರ ಪದ ಧ್ಯಾನಿಪರಿಗೆ ಪವ","ಮಾನ ಜನಕ ಶಾಮಸುಂದರವಿಠಲನು","ಪಾಣಿ ಪಿಡಿದು ಪರಿಪಾಲಿಸುವ ಸತತಾ||5||"],["ಜೊತೆ","ಚಿಪ್ಪಶೈಲದೊಳಿಪ್ಪಾ ಅಪ್ಪನ್ನ ಭಜಿಪರಾ","ತಪ್ಪು ಮನ್ನಿಸಿ ಕಾಯ್ವ ಶಾಮಸುಂದರವಿಠಲಾ||6||"]],"iast":[["dhruvatāḻa","niṣṭèyiṃdali mana | muṭṭi bhajisò vijaya ||","viṭhaladāsara manavè nitya ||","èṣṭu heḻali ivara utkaøṣṭa mahimè kṛpā |","dṛṣṭiyiṃdali noḍidākṣaṇadi ||","bhraṣṭa manasiliṃda | biṭṭu dharmācaraṇè","dhṛṣṭa kṛtyavagaidu doṣadiṃda |","tappida duritauṣa | mòṭṭègaḻèllavu |","suṭṭu bhasmī bhūtavāda baḻika","puṭṭa sujñāna bhakti vairāgya bharitarāgi","mèṭṭuvaro kaivalya pathavā ||","sṛṣṭi saṃhārakartariddalli pogi |","siṭṭiniṃdali kòṭṭu śāpavannu","thaṭṭanè vaikuṃṭa paṭṭaṇakkè tèraḻi","paṭṭadarasiyāda lakumi sahitā","sṛṣṭyāṃḍa bhāra śiradi iṭṭaṃthā phaṇi patiyā","paṭṭi paryaṃkadalli pavaḍisippā","dhiṭṭa mūruti śāmasuṃdaraviṭhalagè","pèṭṭu hākida parama ghaṭṭigarivaru ||1||"],["maṭṭatāḻa","èraḍanèyugadalli suralīlanu èṃba","tarucara rūpadali taru\\ṇikulodbhavanā","caraṇava sevisi karuṇa saṃpādisidā","maraḻi nikaṃpā nāmadali | dvā","paradali puṭṭa yādavanènisidā","aruhalenu mattè caraṇajakuladalli","dharisuta janmavanu karuṇākara","śāmasuṃdaranaṃghrigè śaradhanuvigè hūḍi","guri noḍi èsèdā ||2||"],["triviḍatāḻa","punaḥ kaliyugadalli anupama sanmahima","animiṣanāthākhya dāsāryarā","manèyalli govatsanènisi vāsisi hariyā","guṇanāmakīrtanè śravaṇagaidā","ghaÀnapuṇyadiṃ paśutanavu pogāḍutta","tanayarāgi avara baḻiyaliddu","munimadhvapati èṃbò pèsariniṃdali sadā","minuguvaròḍagūḍi kavanadiṃdā","ananuta śrī śāmasuṃdaraviṭhalanna","manadi kòṃḍāḍutta anugraha paḍèdarū ||3||"],["aṭṭatāḻa","kṣitiyòḻu mānavi sīmagè serida","kṣitidhara devanè sutèya sutīradi","kṣitiruhavara narahari sānnidhyadi","ati puṇyakara puṭṭa badari sukṣetradi","sati śiromaṇiyāda kūsammanudaradi","sutanāgi pratidina śaśiyaṃtè bèḻèyutta","atiśaya dāridtya vyathèyu āvarisalu","khati leśavāgadè sahisutta śāṃtadi","matiyiṃda manadòḻu yocisi muṃdaṇa","gatigāgi tā pogi vāraṇāśiyalli","patitaruddharisuva suranadiyali miṃdu","śitamanadavarāgi irutiralòṃdina","stutisutta haripāda malagirè svapnadi","śatadhṛtinaṃdana karèdòydācègè ippa","kratubhuja tatiyiṃda sutanāda śrī śuka","pitanaṃghri kamalakkè nutisi binnaisidā","hitadi sahodara ivana rakṣisènè","śṛtigè sammata madhvamatada rahasyada","kṛtigaḻa racisi prākṛta subhāṣèyalli","satata śravaṇadiṃdā matimaṃda janaru u","dhṛtarāguvaṃdadi kathisutagarèda saṃ","kīrtanavanu kṛpèyiṃdā yatigaḻa manohara","kṛtidevi pati śāmasuṃdaraviṭhalā ||4||"],["āditāḻa","mauni sanmauni sueñaÁnivaryarāda ivara a","mānuṣa kṛtigaḻu bhānuvina kiraṇadaṃtè","kṣoṇiyòḻu tuṃbiralu hīnamati","manujanāda nānèṃtu peḻvènaiyā","nīnevè gatiyèṃdu mòrèhòkka dīnarigè","sānurāgadi òlidu prāṇavannu","jñāna vannu dānavannu māḍidaru","veṇudhenupāla turagānana mohana","jāṇa jagannāthadhāsa śreṇiya sākṣikeḻu","ī nuḍi nijavèṃdu mānasadòḻaganumānavilladè sadā","māṇadè ivara pada dhyāniparigè pava","māna janaka śāmasuṃdaraviṭhalanu","pāṇi piḍidu paripālisuva satatā||5||"],["jòtè","cippaśailadòḻippā appanna bhajiparā","tappu mannisi kāyva śāmasuṃdaraviṭhalā||6||"]],"devanagari":[["ध्रुवताळ","निष्टॆयिंदलि मन | मुट्टि भजिसॊ विजय ||","विठलदासर मनवॆ नित्य ||","ऎष्टु हेळलि इवर उत्कøष्ट महिमॆ कृपा |","दृष्टियिंदलि नोडिदाक्षणदि ||","भ्रष्ट मनसिलिंद | बिट्टु धर्माचरणॆ","धृष्ट कृत्यवगैदु दोषदिंद |","तप्पिद दुरितौष | मॊट्टॆगळॆल्लवु |","सुट्टु भस्मी भूतवाद बळिक","पुट्ट सुज्ञान भक्ति वैराग्य भरितरागि","मॆट्टुवरो कैवल्य पथवा ||","सृष्टि संहारकर्तरिद्दल्लि पोगि |","सिट्टिनिंदलि कॊट्टु शापवन्नु","थट्टनॆ वैकुंट पट्टणक्कॆ तॆरळि","पट्टदरसियाद लकुमि सहिता","सृष्ट्यांड भार शिरदि इट्टंथा फणि पतिया","पट्टि पर्यंकदल्लि पवडिसिप्पा","धिट्ट मूरुति शामसुंदरविठलगॆ","पॆट्टु हाकिद परम घट्टिगरिवरु ||1||"],["मट्टताळ","ऎरडनॆयुगदल्लि सुरलीलनु ऎंब","तरुचर रूपदलि तरु\\णिकुलोद्भवना","चरणव सेविसि करुण संपादिसिदा","मरळि निकंपा नामदलि | द्वा","परदलि पुट्ट यादवनॆनिसिदा","अरुहलेनु मत्तॆ चरणजकुलदल्लि","धरिसुत जन्मवनु करुणाकर","शामसुंदरनंघ्रिगॆ शरधनुविगॆ हूडि","गुरि नोडि ऎसॆदा ||2||"],["त्रिविडताळ","पुनः कलियुगदल्लि अनुपम सन्महिम","अनिमिषनाथाख्य दासार्यरा","मनॆयल्लि गोवत्सनॆनिसि वासिसि हरिया","गुणनामकीर्तनॆ श्रवणगैदा","घÀनपुण्यदिं पशुतनवु पोगाडुत्त","तनयरागि अवर बळियलिद्दु","मुनिमध्वपति ऎंबॊ पॆसरिनिंदलि सदा","मिनुगुवरॊडगूडि कवनदिंदा","अननुत श्री शामसुंदरविठलन्न","मनदि कॊंडाडुत्त अनुग्रह पडॆदरू ||3||"],["अट्टताळ","क्षितियॊळु मानवि सीमगॆ सेरिद","क्षितिधर देवनॆ सुतॆय सुतीरदि","क्षितिरुहवर नरहरि सान्निध्यदि","अति पुण्यकर पुट्ट बदरि सुक्षेत्रदि","सति शिरोमणियाद कूसम्मनुदरदि","सुतनागि प्रतिदिन शशियंतॆ बॆळॆयुत्त","अतिशय दारिद्त्य व्यथॆयु आवरिसलु","खति लेशवागदॆ सहिसुत्त शांतदि","मतियिंद मनदॊळु योचिसि मुंदण","गतिगागि ता पोगि वारणाशियल्लि","पतितरुद्धरिसुव सुरनदियलि मिंदु","शितमनदवरागि इरुतिरलॊंदिन","स्तुतिसुत्त हरिपाद मलगिरॆ स्वप्नदि","शतधृतिनंदन करॆदॊय्दाचॆगॆ इप्प","क्रतुभुज ततियिंद सुतनाद श्री शुक","पितनंघ्रि कमलक्कॆ नुतिसि बिन्नैसिदा","हितदि सहोदर इवन रक्षिसॆनॆ","शृतिगॆ सम्मत मध्वमतद रहस्यद","कृतिगळ रचिसि प्राकृत सुभाषॆयल्लि","सतत श्रवणदिंदा मतिमंद जनरु उ","धृतरागुवंददि कथिसुतगरॆद सं","कीर्तनवनु कृपॆयिंदा यतिगळ मनोहर","कृतिदेवि पति शामसुंदरविठला ||4||"],["आदिताळ","मौनि सन्मौनि सुe्ञÁनिवर्यराद इवर अ","मानुष कृतिगळु भानुविन किरणदंतॆ","क्षोणियॊळु तुंबिरलु हीनमति","मनुजनाद नानॆंतु पेळ्वॆनैया","नीनेवॆ गतियॆंदु मॊरॆहॊक्क दीनरिगॆ","सानुरागदि ऒलिदु प्राणवन्नु","ज्ञान वन्नु दानवन्नु माडिदरु","वेणुधेनुपाल तुरगानन मोहन","जाण जगन्नाथधास श्रेणिय साक्षिकेळु","ई नुडि निजवॆंदु मानसदॊळगनुमानविल्लदॆ सदा","माणदॆ इवर पद ध्यानिपरिगॆ पव","मान जनक शामसुंदरविठलनु","पाणि पिडिदु परिपालिसुव सतता||5||"],["जॊतॆ","चिप्पशैलदॊळिप्पा अप्पन्न भजिपरा","तप्पु मन्निसि काय्व शामसुंदरविठला||6||"]],"source_roman":[["dhruvatALa","niShTeyindali mana | muTTi Bajiso vijaya ||","viThaladAsara manave nitya ||","eShTu hELali ivara utkaøShTa mahime kRupA |","dRuShTiyindali nODidAkShaNadi ||","BraShTa manasilinda | biTTu dharmAcaraNe","dhRuShTa kRutyavagaidu dOShadinda |","tappida duritauSha | moTTegaLellavu |","suTTu BasmI BUtavAda baLika","puTTa suj~jAna Bakti vairAgya BaritarAgi","meTTuvarO kaivalya pathavA ||","sRuShTi saMhArakartariddalli pOgi |","siTTinindali koTTu SApavannu","thaTTane vaikunTa paTTaNakke teraLi","paTTadarasiyAda lakumi sahitA","sRuShTyAnDa BAra Siradi iTTanthA PaNi patiyA","paTTi paryankadalli pavaDisippA","dhiTTa mUruti SAmasundaraviThalage","peTTu hAkida parama GaTTigarivaru ||1||"],["maTTatALa","eraDaneyugadalli suralIlanu eMba","tarucara rUpadali taru\\NikulOdBavanA","caraNava sEvisi karuNa saMpAdisidA","maraLi nikaMpA nAmadali | dvA","paradali puTTa yAdavanenisidA","aruhalEnu matte caraNajakuladalli","dharisuta janmavanu karuNAkara","SAmasundarananGrige Saradhanuvige hUDi","guri nODi esedA ||2||"],["triviDatALa","punaH kaliyugadalli anupama sanmahima","animiShanAthAKya dAsAryarA","maneyalli gOvatsanenisi vAsisi hariyA","guNanAmakIrtane SravaNagaidA","GaÀnapuNyadiM paSutanavu pOgADutta","tanayarAgi avara baLiyaliddu","munimadhvapati eMbo pesarinindali sadA","minuguvaroDagUDi kavanadindA","ananuta SrI SAmasundaraviThalanna","manadi konDADutta anugraha paDedarU ||3||"],["aTTatALa","kShitiyoLu mAnavi sImage sErida","kShitidhara dEvane suteya sutIradi","kShitiruhavara narahari sAnnidhyadi","ati puNyakara puTTa badari sukShEtradi","sati SirOmaNiyAda kUsammanudaradi","sutanAgi pratidina SaSiyante beLeyutta","atiSaya dAridtya vyatheyu Avarisalu","Kati lESavAgade sahisutta SAntadi","matiyinda manadoLu yOcisi mundaNa","gatigAgi tA pOgi vAraNASiyalli","patitaruddharisuva suranadiyali mindu","SitamanadavarAgi irutiralondina","stutisutta haripAda malagire svapnadi","SatadhRutinandana karedoydAcege ippa","kratuBuja tatiyinda sutanAda SrI Suka","pitananGri kamalakke nutisi binnaisidA","hitadi sahOdara ivana rakShisene","SRutige sammata madhvamatada rahasyada","kRutigaLa racisi prAkRuta suBASheyalli","satata SravaNadindA matimanda janaru u","dhRutarAguvandadi kathisutagareda san","kIrtanavanu kRupeyindA yatigaLa manOhara","kRutidEvi pati SAmasundaraviThalA ||4||"],["AditALa","mauni sanmauni sugnani ivara a","mAnuSha kRutigaLu BAnuvina kiraNadante","kShONiyoLu tuMbiralu hInamati","manujanAda nAnentu pELvenaiyA","nInEve gatiyendu morehokka dInarige","sAnurAgadi olidu prANavannu","j~jAna vannu dAnavannu mADidaru","vENudhEnupAla turagAnana mOhana","jANa jagannAthadhAsa SrENiya sAkShikELu","I nuDi nijavendu mAnasadoLaganumAnavillade sadA","mANade ivara pada dhyAniparige pava","mAna janaka SAmasundaraviThalanu","pANi piDidu paripAlisuva satatA||5||"],["jote","cippaSailadoLippA appanna BajiparA","tappu mannisi kAyva SAmasundaraviThalA||6||"]]},"meaning":"","source":{"site":"https://madhwafestivals.com","url":"https://madhwafestivals.wordpress.com/2017/03/26/vijaya-dasaru-suladhiby-shyamasundara-dasaru/","attribution":"Public devotional archive. Reproduced for non-commercial educational/research use with attribution.","fetched":"2026-08-12"},"_has_text":true,"also_at":[]},{"id":"shyama_sundara_dasaru__5cc9cdc7","form":"pada","title":{"kn":"","latin":"Dayadi salaho jayaraya","iast":"","devanagari":""},"composer":"Shyama Sundara Dasaru","deity":"","tags":["composer:Shyama Sundara Dasaru","on:Jaya Theertharu","yati:Jaya Theertharu","form:pada"],"raga":"","tala":"","language":"kn","text":{"kannada":[["ದಯದಿ ಸಲಹೋ | ಜಯರಾಯ ||pa||"],["ಕಾಗಿಣಿ ನಿಲಯ | ಕವಿಜನಗೇಯ","ಯೋಗಿವರಿಯ ಕೃಪಾಸಾಗರ ಸತತ ||1||"],["ಮರುತ ಸುಶಾಸ್ತ್ರಕೆ | ವಿರಚಿಸಿ ಟೀಕೆಯ","ಮುರಿದು ಕುಭಾಷ್ಯವ | ಮೆರೆದ ಮಹಾತ್ಮ ||2||"],["ಭೀಮ ಭವಾಟಲಿ | ಧೂಮಧ್ವಜ ಸಂ","ಸಿರಿ | ಶಾಮಸುಂದರಪ್ರಿಯ ||3||"]],"iast":[["dayadi salaho | jayarāya ||pa||"],["kāgiṇi nilaya | kavijanageya","yogivariya kṛpāsāgara satata ||1||"],["maruta suśāstrakè | viracisi ṭīkèya","muridu kubhāṣyava | mèrèda mahātma ||2||"],["bhīma bhavāṭali | dhūmadhvaja saṃ","siri | śāmasuṃdarapriya ||3||"]],"devanagari":[["दयदि सलहो | जयराय ||pa||"],["कागिणि निलय | कविजनगेय","योगिवरिय कृपासागर सतत ||1||"],["मरुत सुशास्त्रकॆ | विरचिसि टीकॆय","मुरिदु कुभाष्यव | मॆरॆद महात्म ||2||"],["भीम भवाटलि | धूमध्वज सं","सिरि | शामसुंदरप्रिय ||3||"]],"source_roman":[["dayadi salahO | jayarAya ||pa||"],["kAgiNi nilaya | kavijanagEya","yOgivariya kRupAsAgara satata ||1||"],["maruta suSAstrake | viracisi TIkeya","muridu kuBAShyava | mereda mahAtma ||2||"],["BIma BavATali | dhUmadhvaja saM","siri | SAmasundarapriya ||3||"]]},"meaning":"","source":{"site":"https://madhwafestivals.com","url":"https://madhwafestivals.wordpress.com/2017/03/29/dayadi-salaho-jayaraya/","attribution":"Public devotional archive. Reproduced for non-commercial educational/research use with attribution.","fetched":"2026-08-12"},"_has_text":true,"also_at":[]},{"id":"shyama_sundara_dasaru__e5fb54e5","form":"pada","title":{"kn":"","latin":"Sri Sathya Narayana Vrata Katha(by Shyama Sundara Dasaru)","iast":"","devanagari":""},"composer":"Shyama Sundara Dasaru","deity":"","tags":["composer:Shyama Sundara Dasaru","form:pada"],"raga":"","tala":"","language":"kn","text":{"kannada":[],"iast":[],"devanagari":[],"source_roman":[["I have uploaded PDF document of sri Sathya Narayana Vrata katha(in Kannada) composed by Sri Shyama sundara dasaru"],["This poem is written in 5 adhyayas describing the entire sri Sathya Narayana story."],["I hope all our readers will be benefited doing this parayana on  Pournami days."],["Sri_Sathya_Narayana_Vrata_Katha"]]},"meaning":"","source":{"site":"https://madhwafestivals.com","url":"https://madhwafestivals.wordpress.com/2017/06/05/sri-sathya-narayana-vrata-kathaby-shyama-sundara-dasaru/","attribution":"Public devotional archive. Reproduced for non-commercial educational/research use with attribution.","fetched":"2026-08-12"},"_has_text":false,"also_at":[]}]}