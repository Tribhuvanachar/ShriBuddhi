ಯುಕ್ತಿ ಬೇಡುವನಲ್ಲ","ಭುಕ್ತಿ ಎನಗಿಲ್ಲೆಂದು ಕೇಳ್ವನಲ್ಲ","ಮುಕ್ತಿದಾಯಕ ನಮ್ಮ ವಿಟ್ಠಲನ ಚರಣದಲಿ","ಭಕ್ತಿ ದೃಢವಾಗೆನಗಿತ್ತು ರಕ್ಷಿಸಲೆಂದು","ಮಾನ ಬೇಡುವನಲ್ಲ ದಾನ ಬೇಡುವನಲ್ಲ","ಹೀನತನ ಬ್ಯಾಡೆಂದು ಕೇಳ್ವನಲ್ಲ","ಮಾನನಿಧೀಶ ನಮ್ಮ ಶ್ರೀ ನರಹರಿಯ ಚರಣವನು","ಕಾಣಿಸುವ ಜ್ಞಾನವನು ದಾನಮಾಡಲಿ ಎಂದು"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":68,"keerthana_id":6833,"category_raw":0,"favorite":false,"header_stripped":["ಪ್ರದ್ಯುಮ್ನತೀರ್ಥರು"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"pradyumnatirtharu__dasa1_6834","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಬಾದರಾಯಣ ಮದದಿ ಮರೆತೆನೊ","latin":"","iast":"bādarāyaṇa madadi marètènò","devanagari":"बादरायण मददि मरॆतॆनॊ"},"composer":"ಪ್ರದ್ಯುಮ್ನತೀರ್ಥರು","composer_iast":"pradyumnatīrtharu","deity":"","tags":["composer:ಪ್ರದ್ಯುಮ್ನತೀರ್ಥರು","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಬಾದರಾಯಣ ಮದದಿ ಮರೆತೆನೊ","ಸದಯದಿಂ ಮುದ ಪಾಲಿಸೊ ಪ","ಬೋಧ ಮೂರುತೆ ಭಕ್ತರಾ ನುಡಿ","ಸಾದರದಿ ನೀನಾಲಿಸೋ ಅ.ಪ","ವೇದಭಾಗವ ಮಾಡಿ ವೇದವ್ಯಾಸನೆಂದೆನಿಸಿದಿ","ಸದಮಲಾಭಾವದಲಿ ನಿನ್ನಯ ಪಾದಕಮಲವ ತೋರಿದಿ","ಮೋದ ಚಿನ್ಮಯ ಗಾತ್ರ ಎನ್ನಯ ಖೇದ ಭಾವವನೋಡಿಸೊ","ಮೋದತೀರ್ಥ ಹೃದಾಬ್ಜ ಮಂದಿರ ಸಾಧು ಸಂಗವ ಮಾಡಿಸೋ","ತರ್ಕಮುಧ್ರಾಧರನೆ ಎನ್ನ ಕುತರ್ಕ ಬುದ್ಧಿಯನೋಡಿಸೋ","ಅರ್ಕಸನ್ನಿಭ ಬ್ರಹ್ಮ ಸುತರ್ಕ ಮಾರ್ಗವ ಬೋಧಿಸೋ","ಅಭಯಪ್ರದಕರ ಎನ್ನಭವ ಭಯ ತ್ರಿಭುವನೇಶ್ವರ ಓಡಿಸೀ","ಇಭವರದ ಮಧ್ವೇಶ ಸಂತತ ಸಭೆಯ ಸಹನೀ ತೋರೆಲೊ","ಯೋಗ ಪೀಠನೆ ನೀಗಿಸೆನ್ನಯ ಭೋಗಬುದ್ಧಿಯ ಸರ್ವದಾ","ಯೋಗಿಕುಲವರ ಬಾಗಿ ನಮಿಸುವೆ ಯೋಗಮಾರ್ಗವ ತೋರಿಸೊ","ಮಾ ಕಮಲಜ ಭವೇಂದ್ರವಂದಿತ ಮಾಕಳತ್ರ ನಮೋಸ್ತುತೇ","ಯಾಕೆ ಎನ್ನಲಿ ನಿರ್ದಯವು ನೀ ಸಾಕಲಾರದ ಪಾಪಿಯೇ","ಸನ್ನುತಿಸಿ ನಾ ನಿನ್ನ ಬೇಡುವೆ ಸನ್ನುತಾಂಘ್ರಿಯ ಸೇವೆಯಾ","ಸನ್ಮುನೀವರ ಶ್ರೀ ನರಹರೆ ದಾಸದಾಸರ ದಾಸ್ಯವಾ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":