{"schema":"dasa_pada_text","default_author":"Sri Parvathi Devi Sthothra","composer":"Sri Parvathi Devi Sthothra","count":1,"bio_notes":"","items":[{"id":"sri_parvathi_devi_sthothra__9603c72e","form":"suladi","title":{"kn":"","latin":"Sri Parvathi devi sthothra sulaadhi","iast":"","devanagari":""},"composer":"Sri Parvathi Devi Sthothra","deity":"","tags":["suladi:Sri Parvathi Devi Sthothra","form:suladi"],"raga":"","tala":"","language":"kn","text":{"kannada":[["ಧೃವತಾಳ","ಉಮಾ ಕಾತ್ಯಾಯಿನಿ ಪಾವ೯ತಿ ಕಲ್ಯಾಣಿ|","ಬೊಮ್ಮ ಭೃಕುಟಿ ಸಂಭೂತ ದೇವನ ರಾಣಿ |","ಕಮ್ಮಗೋಲನ ಜನನಿ ದಾಕ್ಷಾಯಿಣಿ |","ಸುಮನಸರಿಗೆ ಗತಿ ಕರುಣಾಪೂರಿತ ಪಾಂಗೆ|","ಕುಮನಸರಿಗತಿ ವಜ್ರ ಕಠಿಣ ಪಾಂಗೆ |","ರಮೆಯರಸನ ಪಾದಸುಮನಸ್ವ ಭೃಂಗೆ |","ಬೊಮ್ಮಭಿನವ ಪ್ರಾಣೇಶ ವಿಠಲನ |","ಸುಮನ ಚರಣಗಳಲ್ಲಿ ಮನವ ಪ್ರೇರಿಸು ತಾಯೆ"],["ಮಟ್ಟತಾಳ","ಚಂಡಿದುರ್ಗೆ ಭೂತಗಣ ಸಂಸೇವಿತಳೆ |","ರುಂಡಾಹಿ ಮಾಲಾಧರ ಹೃನ್ಮಂದಿರಳೆ |","ಉಂಡು ವಿಷವ ನಿನ್ನ ಗಂಡನು ಬಳಲಿ |","ಕೈಕೊಂಡೌಷಧವೆನಗೆ ಕರುಣದಿ ನೀಡಮ್ಮ ಮಂಡೆ ಬಾಗಿ ಬೇಡ್ವೆ |","ಕರಗಳ ಜೋಡಿಸುತ | ಪುಂಡರೀಕ ನಯನೆ ಪುಂಡರೀಕ ಗಮನೆ |","ಪಂಢರ ಅಭಿನವ ಪ್ರಾಣೇಶ ವಿಠಲನ |","ಪುಂಡರೀಕ ಚರಣ ಬಂಡುಣಿ ಎನಿಸಮ್ಮಾ||"],["ತ್ರಿವಿಡಿತಾಳ","ಆರುಮೊಗನ ಪೆತ್ತ ಚಾರು ಚರಿತ್ರಳೆ |","ವಾರಣಾರಿ ವೃಷಭಶ್ಯಂದನಳೆ |","ಶ್ರೀ ರಜಪತಿ ರಾಮನಾಮ ಮಂತ್ರವ ಜಪಿಸಿ |","ಸರ್ವಮಂಗಳೆಯಾದ ಶರ್ವಾಣಿಯೆ ನಾರಿಯರಾಭಿಷ್ಟ ಪೂರೈಸುತವರಿಗೆ |","ವೀರ ಪತಿವ್ರತೆ ಧರ್ಮ ಮರ್ಮವ ತೋರ್ದ| ವಾರಿಜನಯನೆ ಮಂಗಳಗೌರಿಯೇ |","ಮಾರಮಣಭಿನವ ಪ್ರಾಣೇಶ ವಿಠಲನ |","ಚಾರು ಚರಣಗಳಲ್ಲಿ ಮನವ ಪ್ರೇರಿಸು ತಾಯಿ"],["ಅಟ್ಟತಾಳ","ಹರಿ ಸರ್ವೋತ್ತಮನೆಂಬ ಸ್ಥಿರವಾದ ಜ್ಞಾನವ |","ಕರುಣಿಸು ಕರುಣಿಸು ಶೆರಗೊಡ್ಡಿ ಬೇಡುವೆ |","ದುರುಳ ದಾನವರಂತೆ ಪರಮೇಶ ಶಿವನೆಂದು ಪೆರಧರ ಪರನೆಂದು ನುಡಿಸದಿರೆಂದೆಂದು |","ಸಿರಿಯರಸನ ಪೆದ್ದ ಪರಿಚರ್ಯವನು ಕೊಡು |","ಮರುಳೊಂದು ಬಯಸೇನು ಖೇಶ ಷಣ್ಮುಖಮಾತೆ |","ಸಿರಿವರ ಅಭಿನವ ಪ್ರಾಣೇಶ ವಿಠಲನ |","ಚರಣ ವಾರಿಜ ಭೃಂಗೆ ಸರ್ವಭಕ್ತಾಂತರಂಗೆ ||"],["ಆದಿತಾಳ","ಭಾಸುರ ಚರಿತಳೆ ಭೂಸುರ ವಿನುತಳೆ |","ಸಾಸಿರ ನಾಮನ ತೋಷದಿ ಭಜಿಪಳೆ |","ವಾಸವಾದಿ ದಿವಿಜೇಶ ಗಣಾರ್ಚಿತೆ |","ದಾಶರಥಿ ಹರಿ ವಾಸುದೇವ ಪದ |","ಸಾಸಿರ ಪತ್ರದಿ ಧೃಢ ಭಕುತಿಯ ಕೊಡು |","ಮೇಷಾಭಿನವ ಪ್ರಾಣೇಶ ವಿಠಲನ|","ದಾಸ್ಯತನವನಿತ್ತು ಪೋಷಿಸುವದೆಮ್ಮಾ||"],["ಜತೆ","ಅಜನಾಮಭಿನವ ಪ್ರಾಣೇಶ ವಿಠಲನ|","ನಿಜ ದಾಸನೆಂದೆನಿಸು ಸುಜನ ಪೋಷಕಳೆ"]],"iast":[["dhṛvatāḻa","umā kātyāyini pāva9ti kalyāṇi|","bòmma bhṛkuṭi saṃbhūta devana rāṇi |","kammagolana janani dākṣāyiṇi |","sumanasarigè gati karuṇāpūrita pāṃgè|","kumanasarigati vajra kaṭhiṇa pāṃgè |","ramèyarasana pādasumanasva bhṛṃgè |","bòmmabhinava prāṇeśa viṭhalana |","sumana caraṇagaḻalli manava prerisu tāyè"],["maṭṭatāḻa","caṃḍidurgè bhūtagaṇa saṃsevitaḻè |","ruṃḍāhi mālādhara hṛnmaṃdiraḻè |","uṃḍu viṣava ninna gaṃḍanu baḻali |","kaikòṃḍauṣadhavènagè karuṇadi nīḍamma maṃḍè bāgi beḍvè |","karagaḻa joḍisuta | puṃḍarīka nayanè puṃḍarīka gamanè |","paṃḍhara abhinava prāṇeśa viṭhalana |","puṃḍarīka caraṇa baṃḍuṇi ènisammā||"],["triviḍitāḻa","ārumògana pètta cāru caritraḻè |","vāraṇāri vṛṣabhaśyaṃdanaḻè |","śrī rajapati rāmanāma maṃtrava japisi |","sarvamaṃgaḻèyāda śarvāṇiyè nāriyarābhiṣṭa pūraisutavarigè |","vīra pativratè dharma marmava torda| vārijanayanè maṃgaḻagauriye |","māramaṇabhinava prāṇeśa viṭhalana |","cāru caraṇagaḻalli manava prerisu tāyi"],["aṭṭatāḻa","hari sarvottamanèṃba sthiravāda jñānava |","karuṇisu karuṇisu śèragòḍḍi beḍuvè |","duruḻa dānavaraṃtè parameśa śivanèṃdu pèradhara paranèṃdu nuḍisadirèṃdèṃdu |","siriyarasana pèdda paricaryavanu kòḍu |","maruḻòṃdu bayasenu kheśa ṣaṇmukhamātè |","sirivara abhinava prāṇeśa viṭhalana |","caraṇa vārija bhṛṃgè sarvabhaktāṃtaraṃgè ||"],["āditāḻa","bhāsura caritaḻè bhūsura vinutaḻè |","sāsira nāmana toṣadi bhajipaḻè |","vāsavādi divijeśa gaṇārcitè |","dāśarathi hari vāsudeva pada |","sāsira patradi dhṛḍha bhakutiya kòḍu |","meṣābhinava prāṇeśa viṭhalana|","dāsyatanavanittu poṣisuvadèmmā||"],["jatè","ajanāmabhinava prāṇeśa viṭhalana|","nija dāsanèṃdènisu sujana poṣakaḻè"]],"devanagari":[["धृवताळ","उमा कात्यायिनि पाव९ति कल्याणि|","बॊम्म भृकुटि संभूत देवन राणि |","कम्मगोलन जननि दाक्षायिणि |","सुमनसरिगॆ गति करुणापूरित पांगॆ|","कुमनसरिगति वज्र कठिण पांगॆ |","रमॆयरसन पादसुमनस्व भृंगॆ |","बॊम्मभिनव प्राणेश विठलन |","सुमन चरणगळल्लि मनव प्रेरिसु तायॆ"],["मट्टताळ","चंडिदुर्गॆ भूतगण संसेवितळॆ |","रुंडाहि मालाधर हृन्मंदिरळॆ |","उंडु विषव निन्न गंडनु बळलि |","कैकॊंडौषधवॆनगॆ करुणदि नीडम्म मंडॆ बागि बेड्वॆ |","करगळ जोडिसुत | पुंडरीक नयनॆ पुंडरीक गमनॆ |","पंढर अभिनव प्राणेश विठलन |","पुंडरीक चरण बंडुणि ऎनिसम्मा||"],["त्रिविडिताळ","आरुमॊगन पॆत्त चारु चरित्रळॆ |","वारणारि वृषभश्यंदनळॆ |","श्री रजपति रामनाम मंत्रव जपिसि |","सर्वमंगळॆयाद शर्वाणियॆ नारियराभिष्ट पूरैसुतवरिगॆ |","वीर पतिव्रतॆ धर्म मर्मव तोर्द| वारिजनयनॆ मंगळगौरिये |","मारमणभिनव प्राणेश विठलन |","चारु चरणगळल्लि मनव प्रेरिसु तायि"],["अट्टताळ","हरि सर्वोत्तमनॆंब स्थिरवाद ज्ञानव |","करुणिसु करुणिसु शॆरगॊड्डि बेडुवॆ |","दुरुळ दानवरंतॆ परमेश शिवनॆंदु पॆरधर परनॆंदु नुडिसदिरॆंदॆंदु |","सिरियरसन पॆद्द परिचर्यवनु कॊडु |","मरुळॊंदु बयसेनु खेश षण्मुखमातॆ |","सिरिवर अभिनव प्राणेश विठलन |","चरण वारिज भृंगॆ सर्वभक्तांतरंगॆ ||"],["आदिताळ","भासुर चरितळॆ भूसुर विनुतळॆ |","सासिर नामन तोषदि भजिपळॆ |","वासवादि दिविजेश गणार्चितॆ |","दाशरथि हरि वासुदेव पद |","सासिर पत्रदि धृढ भकुतिय कॊडु |","मेषाभिनव प्राणेश विठलन|","दास्यतनवनित्तु पोषिसुवदॆम्मा||"],["जतॆ","अजनामभिनव प्राणेश विठलन|","निज दासनॆंदॆनिसु सुजन पोषकळॆ"]],"source_roman":[["dhruvatala","Uma katyayini pava9ti kalyani|","bomma brukuti sambuta devana rani |","kammagolana janani dakshayini |","sumanasarige gati karunapurita pange|","kumanasarigati vajra kathina pange |","rameyarasana padasumanasva brunge |","bommabinava pranesa vithalana |","sumana caranagalalli manava prerisu taye"],["Mattatala","Chandidurge butagana samsevitale |","rundahi maladhara hrunmandirale |","undu vishava ninna gandanu balali |","kaikondaushadhavenage karunadi nidamma mande bagi bedve | karagala jodisuta | pundarika nayane pundarika gamane |","pandhara abinava pranesa vithalana |","pundarika charana banduni enisamma||"],["Trividitala","Arumogana petta caru caritrale |","varanari vrushabasyandanale |","sri rajapati ramanama mantrava japisi |","sarvamangaleyada sarvaniye nariyarabishta puraisutavarige |","vira pativrate dharma marmava torda|","varijanayane mangalagauriye |","maramanabinava pranesa vithalana |","charu charanagalalli manava prerisu tayi"],["Attatala","Hari sarvottamanemba sthiravada j~janava |","karunisu karunisu seragoddi beduve |","durula danavarante paramesa Sivanendu peradhara paranendu nudisadirendendu |","siriyarasana pedda paricharyavanu kodu |","marulondu bayasenu kesa shanmukamate |"],["Sirivara abinava pranes vithalana |","carana varija brunge sarvabaktantarange ||"],["Aditala","Basura caritale busura vinutale |","sasira namana toshadi bajipale |","vasavadi divijesa ganarcite |","dasarathi hari vasudeva pada |","sasira patradi dhrudha Bakutiya kodu |","meshabinava pranesa vithalana|","dasyatanavanittu poshisuvademma||"],["Jate","Ajanamabinava pranesa vithalana|","Nija dasanendenisu sujana poshakale"]]},"meaning":"","source":{"site":"https://madhwafestivals.com","url":"https://madhwafestivals.com/2017/01/10/sri-parvathi-devi-sthothra-sulaadhi/","attribution":"Public devotional archive. Reproduced for non-commercial educational/research use with attribution.","fetched":"2026-08-12"},"_has_text":true,"also_at":[]}]}