ಸುತ ವಿಯೋಗದಿಂದ ಖತಿಗೊಂಡು ಭ್ರಂಶನಾಗಿ","ಮತಿಗೇನು ತೋರದೆ ಮಿತ ವ್ಯಾಪಾರದೊಳಿರಲು","ಪುರಾಣ ಕೇಳಿದಾಗ ನರಕ ಭಯವು ಮನಕೆ ತೋರಿ","ದುರಿತ ದೂರ ಕಾಯೊ ಎಂದು ದೂರ","ಬರಲು ಮರದು ಪೋಗಲು","ಸಿರಿಯು ಬೇಕೆಂದು ನರರ ಪೂಜೆ ಮಾಡಿ ಧನವ ಕೂಡಿಸಿ","ಪರಮ ಗೋಪ್ಯದಿಂದ ಇಡೆ ಸರ್ವ ಸ್ವತ್ತು","ಪೋಗಲಾಗ ಹರಿಯ ನೆನೆಯೊ","ತಾರೊಡಲ ಆರಿಸಲು ಪರರ ಮನೆಗೆ ಪೋಗಿ","ತಿರುಗಿ ಬೇಡಲು","ನೀರಿನ ಲಾಭವಿಲ್ಲದೆ ನರಹರಿಗೆ ಮೊರೆಯಿಡಲು","ಅನುಕೂಲವೆಲ್ಲ ಇರಲು ಅನಿಮಿತ್ತದಿಂದ ಭಜಿಸು","ಅನಿಮಿಷರೊಡೆಯ ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲನ್ನ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":35,"keerthana_id":10262,"category_raw":0,"favorite":false,"header_stripped":["ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"vijaya_ramacamdravithala__dasa1_10263","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಮಂಗಳಂ ಮಂಗಳಂ ತುಲಸಿದೇವಿಗೆ","latin":"","iast":"maṃgaḻaṃ maṃgaḻaṃ tulasidevigè","devanagari":"मंगळं मंगळं तुलसिदेविगॆ"},"composer":"ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ","composer_iast":"vijaya rāmacaṃdraviṭhala","deity":"","tags":["composer:ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಮಂಗಳಂ ಮಂಗಳಂ ತುಲಸಿದೇವಿಗೆ ಪ","ಮಂಗಳಂ ರಂಗನ ಅರ್ಧಾಂಗಿಗೆ","ಮಂಗಳ ಮಾಧವ ಪ್ರಿಯಳಿಗೆ","ಮಂಗಳ ಭಕ್ತರ ಸಲಹುವ ತಾಯಿಗೆ","ಮಂಗಳ ಮಹಿಷಾಸುರಮರ್ದಿನಿಗೆ","ಮಂಗಳ ಮಂದಾರ ವನವಾಸಿಗೆ","ಮಂಗಳ ಶರಧಿ ಉದ್ಭವಳಿಗೆ","ಮಂಗಳ ರಾಮದಾಸಗಭಯವಿತ್ತವಳಿಗೆ","ಮಂಗಳ ಸಂಜೆಯೊಳ್ ಪೂಜೆಗೊಂಬುವಳಿಗೆ","ಮಂಗಳ ನಾರದನುತ ಅಂಬೆಗೆ","ಮಂಗಳ ಸೇವಿತ ಸುರ ಸಮುದಾಯಗಳಿಗೆ","ಮಂಗಳ ಮನೋಭೀಷ್ಟದಾಯಕಳಿಗೆ","ಮಂಗಳ ಹರಿದ್ರಾ ಕುಂಕುಮನಿಡುವಳಿಗೆ","ಮಂಗಳ ಕೃಷ್ಣನ ಅಂತಸ್ಥಿತಳಿಗೆ","ಮಂಗಳ ಜಗನ್ಮೋಹನ ದೇವಿಗೆ","ಮಂಗಳ ಹಾಟಕ ಸಮಕಾಂತ್ಯಾವಳಿಗೆ","ಮಂಗಳ ಬೃಂದಾವನ ದೇವಿಗೆ","ಮಂಗಳ ಕಮಲ ಲೋಚನದೇವಿಗೆ","ಮಂಗಳ ಪೀತಾಂಬರಧಾರಿ ಸುಂದರಿಗೆ","ಮಂಗಳ ಸರ್ವಾಭರಣ ಭೂಷಿತಳಿಗೆ","ಮಂಗಳ ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲನ ರಾಣಿಗೆ"]],"iast":[],"d