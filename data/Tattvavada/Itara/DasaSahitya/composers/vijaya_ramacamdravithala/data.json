ಆಹಾರವನ್ನು","ಬಿಟ್ಟಳು ಇಷ್ಟ ಪದಾರ್ಥವೆಲ್ಲ","ದೃಷ್ಟೀಸಿ ನೋಡಳನ್ಯರು","ಸೃಷ್ಟೀಲಿ ಭಾರಜೀವಿತ","ಕಷ್ಟದೆಶೆಯಲಿರುವುಳೆಂದು","ಇಡಳು ಕನಕಾಭರಣಂಗಳು","ತೊಡಳು ವರವಸ್ತ್ರಂಗಳು","ಬಡುವಾಗಿ ನಡು ಬಳುಕುತಿಹಳು","ಒಡೆಯ ನೀ ಬಾರದಿರಲು ಪ್ರಾಣ","ಬಿಡುವಳು ನಿಶ್ಚಯವೆಂದು","ಬಯಸುವಳು ನಿನ್ನ ಆಗಮನವನ್ನು","ಸಯಿಸಳು ವಿರಹ ತಾಪ","ಧ್ಯೇಯ ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ","ಕೈಯಿ ಸೇರÉ ಸರ್ವಾವಯವ","ಕಾಯ ಸಮರ್ಪಿಸುವಳೆಂದು"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":35,"keerthana_id":10270,"category_raw":0,"favorite":false,"header_stripped":["ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"vijaya_ramacamdravithala__dasa1_10271","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಸುಮ್ಮನೆ ಹರಿದಾಸರೆಂಬಿರೆ","latin":"","iast":"summanè haridāsarèṃbirè","devanagari":"सुम्मनॆ हरिदासरॆंबिरॆ"},"composer":"ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ","composer_iast":"vijaya rāmacaṃdraviṭhala","deity":"","tags":["composer:ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಸುಮ್ಮನೆ ಹರಿದಾಸರೆಂಬಿರೆ ಎಮ್ಮನೆಲ್ಲಾ ಪ","ಹಮ್ಮಿನ ಅರಿಷಡ್ವರ್ಗ ಬಿಡದೆ ಅಧರ್ಮರ ಸೇವೆ ಮಾಡಿ","ಘಮ್ಮನೆ ಕಾಲ ಕಳೆವ ಪಾಮರ ಮನುಜನ ಅ.ಪ","ಹರಿದಿನದುಪವಾಸ ಮರುದಿನ ಪಾರಣೆ","ಸರಿಯಾಗಿ ಮಾಡಿದೆನೆ","ಕೊರಳಲ್ಲಿ ತುಳಸೀ ಸರಗಳ ಧರಿಸಿ","ಹರಿಗೆ ಮೈಮರೆದಾನೊಂದಿಸಿದೆನೆ","ಪಾತ್ರರ ಕೂಡ ಯಾತ್ರೆ ಮಾಡಿ ಪುಣ್ಯ","ಕ್ಷೇತ್ರಗಳ ಬಳಸಿ","ಕ್ಷೇತ್ರಜ್ಞನಾ ಪಾದ ನೇತ್ರದಿಂದ ನೋಡಿ","ಕೃತಾರ್ಥ ನಾನಾದೆನೆ","ವರ ನಾರೇರ ಕಂಡು ನರಕ ಭಯವಿಲ್ಲದೆ","ಕರೆದು ಮನ್ನಿಸುವ","ವರ ಗಾಯಿತ್ರಿ ಮೊದಲಾದ ಪರಿಪರಿ ಮಂತ್ರಗಳು","ನಿರುತ ನಾ ಜಪಿಸುವೆನೆ","ಕಾಲಿಗೆ ಗೆಜ್ಜೆಕಟ್ಟಿ ಶಿರಿಲೋಲನ ಮುಂದೆ","ಲಲಿತದಿಂ ಕುಣಿಯುವೆನೆ","ತಾಳ ಮ್ಯಾಳಾದಿಂದ ನೀಲಮೇಘಶ್ಯಾಮನ","ಬಾಲಲೀಲೆ ಪಾಡಿ ಲೋಲನಾಗುವೆನೆ","ಕಂದರ್ಪ ಪಿತನಾದ ವಿಜಯ ರಾವi","ಚಂದ್ರವಿಠಲನ್ನ ಮಂದಹಾಸ ಮುಖವನ್ನು","ಒಂದಿನವಾದರು ನೋಡ್ಯಾನಂದಪಟ್ಟು","ಮಂದ ಜ್ಞಾನ ತೊರೆದನೆ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":35,"keerthana_id":10271,"category_raw":0,"favorite":false,"header_stripped":["ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"vijaya_ramacamdravithala__dasa1_10272","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಸ್ಮರಿಸಿ ಸೇವಿಸಿ ವೆಂಕಟರಾಯದಾಸರ","latin":"","iast":"smarisi sevisi vèṃkaṭarāyadāsara","devanagari":"स्मरिसि सेविसि वॆंकटरायदासर"},"composer":"ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ","composer_iast":"vijaya rāmacaṃdraviṭhala","deity":"","tags":["composer:ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಇದು ವೆಂಕಟರಾಯದಾಸರ","ಸ್ಮರಿಸಿ ಸೇವಿಸಿ ವೆಂಕಟರಾಯದಾಸರ ಪ","ದುರಿತ ಹರಿಸಿ ಪೊರೆವ ನಮ್ಮ ಪ್ರತಿ ವಾಸರ ಅ.ಪ","ನೆನೆದ ಮಾತ್ರಕೆ ನಮ್ಮ ಪರಮ ಗುರುಗಳ","ಮನದಿ ಅನುದಿನ ಪುಷ್ಟಿ ಕರೆವ ವರಗಳ","ಧ್ಯಾನಮಾಡಲು ಸುಜ್ಞಾನ ಪಾಲಿಸಿ","ತಾನೆ ಒಲಿವನು ಕರುಣಿ ಇದನೆ ಲಾಲಿಸಿ","ಕುಂಭಕೋಣದಿ ವಾಸವನ್ನೆ ಮಾಡುತ","ಡಂಭ ವೇಷವ ತ್ಯಜಿಸಿ ಹರಿಯ ಪಾಡುತ","ಕ್ಷೇತ್ರ ಕ್ಷೇತ್ರವ ಚರಿಸಿ ಬರುತ ಅಲ್ಲಿಹ","ಆರ್ತ ಜನರನು ನೋಡಿ ಪೊರೆವ ಅನುದಿನ","ಸುಲಭ ಶ್ರೀಗುರು ವಿಜಯರಾಮಚಂದಿರವಿ","ಠಲ ಒಲಿವನು ಭವಾಟವಿಯ ತರಿವನು"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":35,"keerthana_id":10272,"category_raw":0,"favorite":false,"header_stripped":["ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"vijaya_ramacamdravithala__dasa1_10273","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಹರಿಕರ್ತ ನಾನಲ್ಲೆಂದು","latin":"","iast":"harikarta nānallèṃdu","devanagari":"हरिकर्त नानल्लॆंदु"},"composer":"ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ","composer_iast":"vijaya rāmacaṃdraviṭhala","deity":"","tags":["composer:ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಹರಿಕರ್ತ ನಾನಲ್ಲೆಂದು ಹಿರಿಯರಾಡಿದ ಮಾತು","ಅರಿ ಜೀವೋಪಿ ಕರ್ತನೆಂಬ ವಿರೋಧ ಪ","ಸಿರಿ ಅರಸ ತತ್ವೇಶರ ಕೈಯೊಳು","ಚರಿಪಾಧೀನ ಜೀವನಲ್ಲವೆ","ಪರಮ ನಿಷ್ಕ್ರಿಯ ನಾ ಹೀನ ಮನವೆ ಅ.ಪ","ಜಲಾಗ್ನಿ ಸ್ತಂಭ ಜಪ ಕಲಿತ ಮಾತ್ರಕೆ ಪ್ರಾಣಿ","ನಿಲಬಹುದೆ ಅನಲ ಜ್ವಾಲೆಯೊಳು","ಮ್ಯಾಲೆ ಸುಖದಾಸೆಯಿಂದ ಹಲವು ಕರ್ಮಾಚರಿಸಿ","ಗೆಲಬಹುದೆ ನಿಲಯ ಹರಿಕರ್ತನೆಂದ ನುಡಿಗೆ","ಬಿಡಿಬಾಯ ಮಾತಿಗೆ ಪೊಡವಿಪ ಒಪ್ಪುವುದಾದರೆ","ಪಡುವದ್ಯಾಕೆ ತದ್ಧಿತಪಃ ಪ್ರಮಾಣ","ಬಿಡುವುಧ್ಯಾಗೆ ಶ್ರುತಿ ಸ್ಮøತಿ ಹರಿ ಆಜ್ಞೆ","ಕೊಡವು ಫಲ ಮನ ವಚನ ಕಾಯ ಏಕವಾಗೋ ತನಕ","ಜ್ಞಾನೇಚ್ಛಾಕ್ರಿಯ ಶಕ್ತಿ ಮಿನುಗುವ ಜೀವಕ್ಕೆ","ಅನಾದಿ ನಿತ್ಯ ಸ್ವಭಾವದಲ್ಲೆ","ಜ್ಞಾನಿಗೆ ಕೊಡುವ ಯಥೇಷ್ಟಾಚರಣೆ","ಏನೇನು ಕೂಡದು ಶ್ರವಣಾಧಿಕಾರಿಗೆ","ನಾನು ನನ್ನದು ಎಂಬ ಜ್ಞಾನ ಅನುಗಾಲ ಇರಲಾಗಿ","ನೀನು ನಿನ್ನದು ಎಂಬ ವಂಚನೆಯಲ್ಲವೆ","ಹೀನ ಬಿಡದು ಇದರಿಂದ ಅನುಮಾನ ಮಾಡಸಲ್ಲ","ತನ್ನ ಕ್ರಿಯ ಅನ್ಯಕ್ರಿಯದಂತಾಗೋತನಕ ಮನವೆ","ಜ್ಞಾತಾಜ್ಞಾತ ಕರ್ಮದೊಳು ಜ್ಞಾತಾನುಷ್ಠಾನ ವಿಶೇಷ","ಪೀತನಾಹ ಶ್ರೀಶ ತಾನು","ನೋತಾಜ್ಞಾತ ಕರ್ಮ ನಿಷ್ಪಲವಲ್ಲವು","ಜ್ಞಾತ ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":35,"keerthana_id":10273,"category_raw":0,"favorite":false,"header_stripped":["ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"vijaya_ramacamdravithala__dasa1_10274","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ಹ್ಯಾಗೆ ಬರುವ ವೇದ ವೇದ್ಯ","latin":"","iast":"hyāgè baruva veda vedya","devanagari":"ह्यागॆ बरुव वेद वेद्य"},"composer":"ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ","composer_iast":"vijaya rāmacaṃdraviṭhala","deity":"","tags":["composer:ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಹ್ಯಾಗೆ ಬರುವ ವೇದ ವೇದ್ಯ","ನಾಗವೇಣಿ ಶುಕವಾಣಿ ಸಖಿ ಪ","ಭೋಗ ಭಾಗ್ಯ ಬಯಸುವ | ಕು","ಯೋಗ ಕುತ್ಸಿತಳಲಿ ಅ.ಪ.","ಅಗಣಿತ ಗುಣಾರ್ಣವಗೆ","ಸುಗುಣನೆಂದರಿತು ನಾ ಮಣಿಯಲರಿಯೆ","ಬಗೆ ಬಗೆ ಕುಸುಮಂಗಳನು ಸೊಗಸಿನಿಂದಲಂಕರಿಸಿ","ನಗಧರನ ಸ್ತುತಿಸಲರಿಯದವಳಲ್ಲಿ","ರಮಾಭಿಮಾನ್ಯನಂತಾಸನ ಸದನಗೆ","ಕಮಲಾಸನವಿತ್ತು ಪ್ರೇಮ ಮಾಡಲರಿಯೆ","ಸೋಮ ಸೂರ್ಯನಂತರುಧಾಮದಿ ಬೆಳಗುತ್ತಿರೆ","ನೇಮದಿಂದ ದೀಪದಾರತಿಯ ಮಾಡುವಳಲ್ಲಿ","ಸಿರಿಭವಾದ್ಯರೆ ಆಭರಣ ಉಳ್ಳವಗೆ","ಕರಗುವ ಕನಕ ತೊಡಿಸಲರಿಯೆ","ಕರಿವರದ ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲನ್ನ","ಅರಿತು ಒಲಿಸಲರಿಯದವಳಲ್ಲಿ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":35,"keerthana_id":10274,"category_raw":0,"favorite":false,"header_stripped":["ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"vijaya_ramacamdravithala__dasa1_10275","form":"devaranama","form_confidence":"sampled, consistent structured header (song/singer/raga/tala/style)","title":{"kn":"ಇಂದಿರೆ ಚಂದಿರವದನೆ ಮಂದಗಮನೆಣಜ ಚಿಟೈಗ್ಟಿಡೀಘ್ಣ","latin":"","iast":"iṃdirè caṃdiravadanè maṃdagamanèṇaja ciṭaigṭiḍīghṇa","devanagari":"इंदिरॆ चंदिरवदनॆ मंदगमनॆणज चिटैग्टिडीघ्ण"},"composer":"ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ","composer_iast":"vijaya rāmacaṃdraviṭhala","deity":"","tags":["composer:ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ","source:android_app_local:dasa1","category_raw:4","form:devaranama","rendition:studio_recording"],"raga":"","tala":"","singer":"","style":"","music_director":"ಶ್ರೀಲತಾ ಆರ್. ಎನ್.","studio":"ಶಂಕರಿ ಡಿಜಿಟಲ್ ಸ್ಟುಡಿಯೊ, ಮೈಸೂರು","language":"kn","text":{"kannada":[["ಇಂದಿರೆ ಚಂದಿರವದನೆ ಮಂದಗಮನೆ","ಇಂದಿರೆ ಚಂದಿರವದನೆ ಮಂದಗಮನೆ","ಕಂದರ್ಪ ಕೋಟಿ ಲಾವಣ್ಯೆ ಪ","ಮಂದನಾಗಿ ಭವಸಿಂಧುವಿಲಿ ಪೊಂದಿದೆ","ಬಂದು ನೀ ಕರಪಿಡಿದು ಮುಂದಕೆ ಕರೆಯೆ ಅ.ಪ.","ನಾಗವೇಣಿಯೆ ಸುರಶ್ರೇಣಿ ಅಗಣಿತಗುಣಮಣಿಯ","ಹೊಗಳುವ ಮತಿ ನೀಡೆ ಕಲ್ಯಾಣಿ","ಹಗಲಿರುಳು ನಡೆಯುವ ಬಗೆ ಬಗೆ ಕ್ರಿಯೆಗಳು","ನಗಧರನೆ ಮಾಳ್ಪಾನೆಂಬ ಮಿಗೆ ಜ್ಞಾನ ಪಾಲಿಸೆ","ಸರಸಿಜೋದ್ಭವ ಮಾತೆ ವಿಖ್ಯಾತೆ","ಸುರ ನಿಕರ ಸನ್ನುತೆ ಕಂಕಣಾಭರಣ ಭೂಷಿತೆ","ಕರೆ ಕರೆಗೊಳಿಸುವ ಅಹಂ ಮಮತೆ ಶರಧಿಯು","ತೆರೆಯಂತೆ ಬರುವುದು ಮರೆಸಿ ನೀ ಪೊರೆಯೆ","ಹರಿಗುಣ ಮಣಿಯೆಣಿಸುವ ಧೀರೆ","ಪರಿಪರಿ ಅಲಂಕಾರೆ ಸ್ಮರಿಸದವರಿಗೆ ದೂರೆ","ಅರಿದೂರ ವಿಜಯ ರಾಮಚಂದಿರವಿಠಲನ","ನಿರುತ ಧೇನಿಸುವಂತೆ ಮರೆಯದೆ ಮಾಡೆ ತಾಯೆ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":35,"keerthana_id":10275,"category_raw":4,"favorite":false,"header_stripped":["ನಿರ್ಗಮನ"],"unclassified_lines":[],"is_recorded_rendition":true},"_needs_review":false,"also_at":[]}]}