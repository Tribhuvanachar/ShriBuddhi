esearch.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":35,"keerthana_id":10267,"category_raw":0,"favorite":false,"header_stripped":["ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"vijaya_ramacamdravithala__dasa1_10268","form":"pada","form_confidence":"default bucket, not a positive signal","title":{"kn":"ವಿಘ್ನೇಶ ಪಾಹಿಮಾಂ","latin":"","iast":"vighneśa pāhimāṃ","devanagari":"विघ्नेश पाहिमां"},"composer":"ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ","composer_iast":"vijaya rāmacaṃdraviṭhala","deity":"","tags":["composer:ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ","source:android_app_local:dasa1","category_raw:0","form:pada"],"raga":"","tala":"","singer":"","style":"","music_director":"","studio":"","language":"kn","text":{"kannada":[["ಆಕಾಶಾಭಿಮಾನಿ: ಪಂಚಭೂತಗಳಲ್ಲಿ","ವಿಘ್ನೇಶ ಪಾಹಿಮಾಂ","ವಿಘ್ನ ನಿವಾರಕ ನಿರ್ವಿಘ್ನದಾಯಕ ಪ","ಭಗ್ನದಂತಾಕಾಶಾಭಿಮಾನಿ","ಮಗ್ನಂ ಕೃತ್ವಾವೋ ಮನ","ಅಗ್ನಿ ನೇತ್ರಸುತ ತವ ಪದದೆ ಅ.ಪ","ಕುಕ್ಷಿ ಮಹಾಲಂಬೋದರ ಇಕ್ಷುಚಾಪಹರ","ಅಕ್ಷತ ಶೋಭಿತ ಗಜಪಾಲ","ರಾಕ್ಷಸ ಮದಹರ ಅಂಕುಶಪಾಶ","ಯಕ್ಷ ಕಿನ್ನರ ವಂದಿತ ಚರಣ","ಗಜಾನನ ಮನೋಹರ ಗಾತ್ರ","ಅಜಿನ ಬದ್ಧ ಪ್ರಲಂಬ ಪವಿತ್ರ","ಭಜಕೇಷ್ಟದ ಪರಮ ಸೂತ್ರ","ಸುಜನ ಪಾಪ ಪರ್ವತ ವೀತಿ ಹೋತ್ರ","ಚತುರ್ಹಸ್ತ ಮೂಷಕ ಗಮನ","ವಾಯಭುಗ್ ಭೂಷ ಆದಿಪೂಜ್ಯ","ವಿತತ ಮಹಿಮ ಏಕದಂತ ಗಂಧಲೇಪಿತ ವಕ್ಷ","ಪತಿತ ಪಾವನ ವಿಶ್ವೋಪಾಸ್ಯ","ವ್ಯಾಸೋಕ್ತ ಪುರಾಣ ಲಿಖಿತನೆ ಶೂರ","ವಿಂಶತ್ಸೇಕ ಮೋದಕ ಭಕ್ಷ","ವಾಸುಕಿ ಬದ್ಧ ಕಟಿ ವಿರಾಜಿತ ಕ್ಲೇಶನಾಶನ ಸುಂದರ","ಆಶಾಪಾಶ ರಹಿತ ಭೂತ ಗಣೇಶ","ಹಾಟಕ ಮಣಿಮಯ ಮಕುಟ","ತಟಿತ್ತೇಜ ನಿತ್ಯವಹಿರೂಪ","ಪಟಪಟ ಶಬ್ದಘಟಿತ ಗಜಕರ್ಣ","ನಿಟಿಲಾಕ್ಷ್ಯವಂದ್ಯ ವಿಜಯರಾಮಚಂದ್ರ","ವಿಠಲ ಪೂಜಕ ಶತಸ್ಥ"]],"iast":[],"devanagari":[],"source_roman":[]},"meaning":"","source":{"site":"android_app_local_asset:dasa1","url":"","attribution":"Imported from a local Android app database asset (dasa1); non-commercial dharma-prachara / education / research.","fetched":"2026-08-19"},"app_meta":{"asset":"dasa1","dasaru_id":35,"keerthana_id":10268,"category_raw":0,"favorite":false,"header_stripped":["ವಿಜಯ ರಾಮಚಂದ್ರವಿಠಲ"],"unclassified_lines":[],"is_recorded_rendition":false},"_needs_review":false,"also_at":[]},{"id":"vijaya_ramacamdravithala__dasa1_10269","form"