 "metadata": {
  "id": "दशावतारहरिगाथा",
  "title": "दशावतारहरिगाथा",
  "totalShlokas": 12
 },
 "shlokas": {
  "0": {
   "sanskrit_text": "दशावतारहरिगाथा\n॥ दशावतारहरिगाथा ॥\nप्रळयोदन्वदुदीर्णजलविहारानिविशाङ्गम् ।\nकमलाकान्तमखण्डितविभवाब्धिं हरिमीडे",
   "note": "preamble"
  },
  "1": {
   "sanskrit_text": "चरमाङ्गोद्धृतमन्दरतटिनं कूर्मशरीरं ।\nकमलाकान्तमखण्डितविभवाब्धिं हरिमीडे"
  },
  "2": {
   "sanskrit_text": "सितदंष्ट्रोद्धृतकाश्यपतनयं सूकररूपं ।\nकमलाकान्तमखण्डितविभवाब्धिं हरिमीडे"
  },
  "3": {
   "sanskrit_text": "निशितप्राग्रनखेन जितसुरारिं नरसिंहं ।\nकमलाकान्तमखण्डितविभवाब्धि हरिमीडे"
  },
  "4": {
   "sanskrit_text": "त्रिपदव्याप्तचतुर्दशभुवनं वामनरूपं ।\nकमलाकान्तमखण्डितविभवाब्धिं हरिमीडे"
  },
  "5": {
   "sanskrit_text": "क्षपितक्षत्रियवंशनगधरं भार्गवरामं ।\nकमलाकान्तमखण्डितविभवाब्धिं हरिमीडे"
  },
  "6": {
   "sanskrit_text": "दयिताचोरनिबर्हणनिपुणं राघवरामं ।\nकमलाकान्तमखण्डितविभवाब्धिं हरिमीडे"
  },
  "7": {
   "sanskrit_text": "मुरळीनिस्वनमोहितवनितं यादवकृष्णं ।\nकमलाकान्तमखण्डितविभवाब्धिं हरिमीडे"
  },
  "8": {
   "sanskrit_text": "पटुचाटीकृतनिस्फुटजननं श्रीघनसञ्ज् नं ।\nकमलाकान्तमखण्डितविभवाब्धिं हरिमीडे"
  },
  "9": {
   "sanskrit_text": "परिनिर्मूलितदुष्टजनकुलं विष्णुयशोजं ।\nकमलाकान्तमखण्डितविभवाब्धिं हरिमीडे"
  },
  "10": {
   "sanskrit_text": "अकृतेमां विजयध्वजवरतीर्थो हरिगाथां ।\nअयते प्रीतिमलं सपदि यया श्रीरमणोऽयम्"
  },
  "11": {
   "sanskrit_text": "इति श्रीविजयध्वजतीर्थकृता दशावतारहरिगाथा समाप्ता ।\n॥ भारतीरमणमुख्यप्राणान्तर्गत श्री कृष्णार्पणमस्तु॥"
  }
 }
}