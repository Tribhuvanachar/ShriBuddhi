   "verse_no": 16
  },
  {
   "id": "VG_G017",
   "reference": "गद्यम् · 17",
   "sanskrit_text": "गुणक्रिया रूप सामान्येन इन्द्राद्युपासित बहुगुणाय ।",
   "tags": [
    "prose",
