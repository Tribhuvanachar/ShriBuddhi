   "verse_no": 11
  },
  {
   "id": "VG_G012",
   "reference": "गद्यम् · 12",
   "sanskrit_text": "गुरुषु स्थित्वा तद्द्वारा ज्ञानोपदेष्ट्रे ।",
   "tags": [
    "prose",
