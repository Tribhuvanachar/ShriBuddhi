   "section": "gadya",
   "kind": "gadya_phrase",
   "verse_no": 14
  },
  {
   "id": "VG_G015",
   "reference": "गद्यम् · 15",
   "sanskrit_text": "क्रिया सामान्येन सरस्वत्युपासितानन्त रूपाय ।",
