   "verse_no": 12
  },
  {
   "id": "VG_G013",
   "reference": "गद्यम् · 13",
   "sanskrit_text": "निरवधिकानन्तानवद्य कल्याण गुणत्वज्ञानपूर्वक स्वात्मात्मीय समस्त वस्तुभ्योनेक गुणाधिकान्तराय सहस्रेणाप्यप्रतिबद्ध निरन्तर प्रेम प्रवाहरूप भक्ति विषयाय ।",
   "tags": [
    "prose",
    "gadya",
    "epithet"
   ],
   "notes": "",
   "references": [],
   "audio": [],
   "category": "श्रीवेदव्यासगद्यम्",
   "section": "gadya",
   "kind": "gadya_phrase",
   "verse_no": 13
  },
  {
   "id": "VG_G014",
   "reference": "गद्यम् · 14",
   "sanskrit_text": "अनन्तवेदोक्त तदनुक्त भारतोक्त प्रकारेण ब्रह्मोपासितानन्त गुणानन्त क्रियानन्त रूपाय ।",
