   "notes": "",
   "references": [],
   "audio": [],
   "category": "श्रीवेदव्यासगद्यम्",
   "section": "gadya",
   "kind": "gadya_phrase",
   "verse_no": 7
  },
  {
   "id": "VG_G008",
   "reference": "गद्यम् · 8",
   "sanskrit_text": "पञ्चभेदभिन्न श्रीब्रह्मरुद्र प्रभृति सकल सुरासुर नरात्मकस्य प्रपञ्चस्य यथायोग्यं सृष्टि स्थिति संहार नियमन ज्ञानाज्ञान बन्ध मोक्ष प्रदात्रे ।",
   "tags": [
    "prose",
    "gadya",
    "epithet"
   ],
   "notes": "",
   "references": [],
   "audio": [],
   "category": "श्रीवेदव्यासगद्यम्",
   "section": "gadya",
   "kind": "gadya_phrase",
   "verse_no": 8
  },
  {
   "id": "VG_G009",
   "reference": "गद्यम् · 9",
   "sanskrit_text": "ऋगादि चतुर्वेद मूल रामायण ब्रह्मसूत्र महाभारत पञ्चरात्राद्यशेष सदागम प्रतिपादित स्वरूपाय ।",
   "tags": [
    "prose",
    "gadya",
    "epithet"
   ],
   "notes": "",
   "references": [],
   "audio": [],
   "category": "श्रीवेदव्यासगद्यम्",
   "section": "gadya",
   "kind": "gadya_phrase",
   "verse_no": 9
  },
  {
   "id": "VG_G010",
   "reference": "गद्यम् · 10",
   "sanskrit_text": "अनाद्यनन्तकालेपि स्वरूपदेहान्तर्बाह्य देहान्तश्च स्थित्वा सत्याप्रतीति प्रवृत्यादिप्रदाय ।",
   "tags": [
    "prose",
    "gadya",
    "epithet"
   ],
   "notes": "",
   "references": [],
   "audio": [],
   "category": "श्रीवेदव्यासगद्यम्",
   "section": "gadya",
   "kind": "gadya_phrase",
   "verse_no": 10
  },
  {
   "id": "VG_G011",
   "reference": "गद्यम् · 11",
