   "section": "gadya",
   "kind": "gadya_phrase",
   "verse_no": 18
  },
  {
   "id": "VG_G019",
   "reference": "गद्यम् · 19",
   "sanskrit_text": "उत्क्रान्ति मार्गरूप मुक्तिद्वय शून्यावशिष्ट द्विविध मुक्तियोग्याधिकारि विशेषोपासित आत्मत्वरूपैक गुणाय ।",
