{
 "schema": "generic",
 "default_author": "Chanakya (Kautilya)",
 "source_url": "https://sanskritdocuments.org/doc_z_misc_major_works/chANakyasUtra.itx",
 "source_note": "Sanskrit Documents (sanskritdocuments.org), transliterated by Sunder Hattangadi. Site's stated norm: personal study/research use, not for commercial redistribution.",
 "items": [
  {
   "id": "adhyaya_01",
   "reference": "Chanakya Sutra, Adhyaya 1",
   "shlokas": [
    {
     "number": 1,
     "sanskrit_text": "सा श्रीर्वोऽव्यात्"
    },
    {
     "number": 2,
     "sanskrit_text": "सुखस्य मूलं धर्मः"
    },
    {
     "number": 3,
     "sanskrit_text": "धर्मस्य मूलमर्थः"
    },
    {
     "number": 4,
     "sanskrit_text": "अर्थस्य मूलं राज्यम्"
    },
    {
     "number": 5,
     "sanskrit_text": "राज्यमूलमिन्द्रियजयः"
    },
    {
     "number": 6,
     "sanskrit_text": "इन्द्रियजयस्य मूलं विनयः"
    },
    {
     "number": 7,
     "sanskrit_text": "विनयस्य मूलं वृद्धोपसेवा"
    },
    {
     "number": 8,
     "sanskrit_text": "वृद्धसेवाया विज्ञानम्"
    },
    {
     "number": 9,
     "sanskrit_text": "विज्ञानेनात्मानं सम्पादयेत्"
    },
    {
     "number": 10,
     "sanskrit_text": "सम्पादितात्मा जितात्मा भवति"
    },
    {
     "number": 11,
     "sanskrit_text": "जितात्मा सर्वार्थैः संयुज्यते"
    },
    {
     "number": 12,
     "sanskrit_text": "स्वामिसम्पत् प्रकृतिसम्पदं करोति"
    },
    {
     "number": 13,
     "sanskrit_text": "प्रकृतिसम्पदा ह्यनायकमपि राज्यं नीयते"
    },
    {
     "number": 14,
     "sanskrit_text": "प्रकृतिकोपः सर्वकोपेभ्यो गरीयान्"
    },
    {
     "number": 15,
     "sanskrit_text": "अविनीतस्वामिभावादस्वामिभावः श्रेयान्"
    },
    {
     "number": 16,
     "sanskrit_text": "सम्पाद्यात्मानमन्विच्छेत् सहायान्"
    },
    {
     "number": 17,
     "sanskrit_text": "नाऽसहास्य मन्त्रनिश्चयः"
    },
    {
     "number": 18,
     "sanskrit_text": "नैकं चक्रं परिभ्रमति"
    },
    {
     "number": 19,
     "sanskrit_text": "सहायः समो दुःखसुखयोः"
    },
    {
     "number": 20,
     "sanskrit_text": "मानी प्रतिमानिनमात्मद्वितीयं मन्त्रिणमुत्पादयेत्"
    },
    {
     "number": 21,
     "sanskrit_text": "अविनीतं स्नेहमात्रेण न मन्त्रे कुर्वीत"
    },
    {
     "number": 22,
     "sanskrit_text": "श्रुतवन्तमुपधाशुद्धं मन्त्रिणं कुर्वीत"
    },
    {
     "number": 23,
     "sanskrit_text": "मन्त्रमूलाः सर्वारम्भाः"
    },
    {
     "number": 24,
     "sanskrit_text": "मन्त्रसंवरणे कार्यसिद्धिर्भवति"
    },
    {
     "number": 25,
     "sanskrit_text": "मन्त्रनिःस्रावः सर्वम् नाशयति"
    },
    {
     "number": 26,
     "sanskrit_text": "प्रमादाद् द्विषतां वशमुपयास्यति"
    },
    {
     "number": 27,
     "sanskrit_text": "सर्वद्वारेभ्यो मन्त्रो रक्षितव्यः"
    },
    {
     "number": 28,
     "sanskrit_text": "मन्त्रसम्पदा हि राज्यं विवर्धते"
    },
    {
     "number": 29,
     "sanskrit_text": "श्रेष्ठतमां मन्त्रगुपितमाहुः"
    },
    {
     "number": 30,
     "sanskrit_text": "कार्याकार्य प्रदीपो मन्त्रः"
    },
    {
     "number": 31,
     "sanskrit_text": "मन्त्रचक्षुषा परच्छिद्राण्यवलोकयन्ति"
    },
    {
     "number": 32,
     "sanskrit_text": "मन्त्रकाले न मत्सरः कर्तव्यः"
    },
    {
     "number": 33,
     "sanskrit_text": "अकामबुद्धयो मन्त्रतत्त्वार्थदर्शिनो मन्त्रिणः"
    },
    {
     "number": 34,
     "sanskrit_text": "षट्कर्णो मन्त्रश्छिद्यते"
    },
    {
     "number": 35,
     "sanskrit_text": "त्रयाणामैकवाक्येऽसम्प्रत्ययः"
    },
    {
     "number": 36,
     "sanskrit_text": "आपत्सु स्नेहयुक्तं मित्रम्"
    },
    {
     "number": 37,
     "sanskrit_text": "मित्रसंग्रहणे बलं सम्पद्यते"
    },
    {
     "number": 38,
     "sanskrit_text": "बलवान् अलब्धलाभे प्रयतेत"
    },
    {
     "number": 39,
     "sanskrit_text": "अलब्धलाभो नालसस्य"
    },
    {
     "number": 40,
     "sanskrit_text": "अलसेन लब्धमपि रक्षितुं न शक्यते"
    },
    {
     "number": 41,
     "sanskrit_text": "न चालसस्ययुक्तस्य रक्षितं विवर्धते"
    },
    {
     "number": 42,
     "sanskrit_text": "न भृत्यान् पोषयति"
    },
    {
     "number": 43,
     "sanskrit_text": "न तीर्थं प्रतिपादयति"
    },
    {
     "number": 44,
     "sanskrit_text": "अलब्धलाभादिचतुष्टयं राजतन्त्रम्"
    },
    {
     "number": 45,
     "sanskrit_text": "तच्च राज्यतन्त्रमायतं नीतिशास्त्रेषु"
    },
    {
     "number": 46,
     "sanskrit_text": "राज्यतन्त्रेष्वायत्तौ मन्त्रावापौ"
    },
    {
     "number": 47,
     "sanskrit_text": "मन्त्रं स्वविषये कृत्येष्वायत्तम्"
    },
    {
     "number": 48,
     "sanskrit_text": "आवापो मण्डले सन्निविष्टः"
    },
    {
     "number": 49,
     "sanskrit_text": "सन्धिविग्रहयोर्योनिर्मण्डलम्"
    },
    {
     "number": 50,
     "sanskrit_text": "नीतिशास्त्रानुगो राजा"
    },
    {
     "number": 51,
     "sanskrit_text": "अनन्तरप्रकृतिः शत्रुः"
    },
    {
     "number": 52,
     "sanskrit_text": "एकान्तरितं मित्रमिष्यते"
    },
    {
     "number": 53,
     "sanskrit_text": "हेतुतः शत्रुमित्रे भविष्यतः"
    },
    {
     "number": 54,
     "sanskrit_text": "हीयमानेन स सन्धिं कुर्वीत"
    },
    {
     "number": 55,
     "sanskrit_text": "तेजो हि सन्धानहेतुस्तदर्थिनाम्"
    },
    {
     "number": 56,
     "sanskrit_text": "नातप्तलोहं लोहेन सन्धत्ते"
    },
    {
     "number": 57,
     "sanskrit_text": "बलवान् हीनेन विगृह्णीयात्"
    },
    {
     "number": 58,
     "sanskrit_text": "न ज्यायसा समेन वा"
    },
    {
     "number": 59,
     "sanskrit_text": "हस्तिनः पादयुद्धमिव बलवद्विग्रहः"
    },
    {
     "number": 60,
     "sanskrit_text": "आमपात्रमापेन सह विनश्यति"
    },
    {
     "number": 61,
     "sanskrit_text": "अरिप्रयत्नमभिसमीक्ष्यात्मरक्षया वसेत्"
    },
    {
     "number": 62,
     "sanskrit_text": "सन्धायैकतो वा यायात्"
    },
    {
     "number": 63,
     "sanskrit_text": "अमित्रविरोधादात्मरक्षामावसेत्"
    },
    {
     "number": 64,
     "sanskrit_text": "शक्तिहीनो बलवन्तमाश्रयेत्"
    },
    {
     "number": 65,
     "sanskrit_text": "दुर्बलाश्रयो दुःखमावहति"
    },
    {
     "number": 66,
     "sanskrit_text": "अग्निवद् राजानमाश्रयेत्"
    },
    {
     "number": 67,
     "sanskrit_text": "राज्ञाः प्रतिकूलं नाचरेत्"
    },
    {
     "number": 68,
     "sanskrit_text": "नोद्धतवेशधरः स्यात्"
    },
    {
     "number": 69,
     "sanskrit_text": "न देवचरितं चरेत्"
    },
    {
     "number": 70,
     "sanskrit_text": "द्वयोरपीर्ष्यतोर्द्वैधीभावकुर्वीत"
    },
    {
     "number": 71,
     "sanskrit_text": "न व्यसनपरस्य कार्यावाप्तिः"
    },
    {
     "number": 72,
     "sanskrit_text": "इन्द्रियवशवर्तिनो नास्ति कार्यावाप्तिः"
    },
    {
     "number": 73,
     "sanskrit_text": "नास्ति कार्यं द्युतप्रवृत्तस्य"
    },
    {
     "number": 74,
     "sanskrit_text": "मृगयापरस्य धर्मार्थौ विनश्यतः"
    },
    {
     "number": 75,
     "sanskrit_text": "न कामासक्तस्य कार्यानुष्ठानम्"
    },
    {
     "number": 76,
     "sanskrit_text": "अर्थेषु पानव्यसनी न गण्यते"
    },
    {
     "number": 77,
     "sanskrit_text": "अर्थदूषकं श्रीः परित्यजति"
    },
    {
     "number": 78,
     "sanskrit_text": "अग्निदहादपि विशिष्तं वाक्पारुष्यम्"
    },
    {
     "number": 79,
     "sanskrit_text": "दण्डपारुष्यात् सर्वजनद्वेष्यो भवति"
    },
    {
     "number": 80,
     "sanskrit_text": "अमित्रो दण्डनीत्यामायत्तः"
    },
    {
     "number": 81,
     "sanskrit_text": "दण्डनीतिमनुष्ठन् प्रजाः संरक्षति"
    },
    {
     "number": 82,
     "sanskrit_text": "दण्डः सर्वसम्पदा योजयति"
    },
    {
     "number": 83,
     "sanskrit_text": "दण्डाभावे त्रिवर्गाभावः"
    },
    {
     "number": 84,
     "sanskrit_text": "दण्डभयादकार्याणि न कुर्वन्ति"
    },
    {
     "number": 85,
     "sanskrit_text": "दण्डनीत्यामायत्तमात्मरक्षणम्"
    },
    {
     "number": 86,
     "sanskrit_text": "आत्मनि रक्षिते सर्वं रक्षितं भवति"
    },
    {
     "number": 87,
     "sanskrit_text": "आत्मायत्तौ वृद्धिविनाशौ"
    },
    {
     "number": 88,
     "sanskrit_text": "दण्डनीत्यादि विज्ञाने प्रणीयते"
    },
    {
     "number": 89,
     "sanskrit_text": "दुर्बलोऽपि राजा नावमन्तव्यः"
    },
    {
     "number": 90,
     "sanskrit_text": "नास्त्यग्नेर्दौर्बल्यम्"
    },
    {
     "number": 91,
     "sanskrit_text": "दण्डेन प्रणीयते वृत्तिः"
    },
    {
     "number": 92,
     "sanskrit_text": "वृत्तिमूलोऽर्थलाभः"
    },
    {
     "number": 93,
     "sanskrit_text": "अर्थमूलौ धर्मकामौ"
    },
    {
     "number": 94,
     "sanskrit_text": "अर्थमूलम् कार्यम्"
    },
    {
     "number": 95,
     "sanskrit_text": "यत्नप्रयत्नात् कार्यसिद्धिर्भवति स उपायः"
    },
    {
     "number": 96,
     "sanskrit_text": "उपायपूर्वं कार्यं न दुष्करं स्यात्"
    },
    {
     "number": 97,
     "sanskrit_text": "अनुपायपूर्वं कार्यं कृतमपि विनश्यति"
    },
    {
     "number": 98,
     "sanskrit_text": "कार्यार्थिनामुपाय एव सहायः"
    },
    {
     "number": 99,
     "sanskrit_text": "कार्यं पुरुषकारेण लक्ष्यं सम्पद्यते"
    },
    {
     "number": 100,
     "sanskrit_text": "पुरुषकारमनुवर्तते दैवम्"
    },
    {
     "number": 101,
     "sanskrit_text": "दैवं विना अतिप्रयत्नं करोति यत्तद् विफलम्"
    },
    {
     "number": 102,
     "sanskrit_text": "अनीहमानस्य वृत्तिर्न सम्पद्यते"
    },
    {
     "number": 103,
     "sanskrit_text": "पूर्वं निश्चित्य पश्चात्कार्यमारभेत"
    }
   ]
  },
  {
   "id": "adhyaya_02",
   "reference": "Chanakya Sutra, Adhyaya 2",
   "shlokas": [
    {
     "number": 1,
     "sanskrit_text": "अर्थमूलं सर्वकार्यं यदल्पप्रयत्नात् कार्यसिद्धिर्भवति"
    },
    {
     "number": 2,
     "sanskrit_text": "उपायपूर्वं कार्यं न दुष्करं स्यात्"
    },
    {
     "number": 3,
     "sanskrit_text": "अनुपायपूर्वकार्यं कृतमपि विनश्यति"
    },
    {
     "number": 4,
     "sanskrit_text": "कार्यार्थिनामुपाय एव सहायः"
    },
    {
     "number": 5,
     "sanskrit_text": "कार्यं पुरुषकारेण लक्ष्यं सम्पद्यते"
    },
    {
     "number": 6,
     "sanskrit_text": "पुरुषकारमनुवर्तते दैवम्"
    },
    {
     "number": 7,
     "sanskrit_text": "दैवं विनाऽतिप्रयत्नं यत्करोति तद्विफलम्"
    },
    {
     "number": 8,
     "sanskrit_text": "असमाहितस्य कार्यं न विद्यते"
    },
    {
     "number": 9,
     "sanskrit_text": "पूर्वं निश्चित्य पश्चात्कार्यमारभेत"
    },
    {
     "number": 10,
     "sanskrit_text": "कार्यान्तरे दीर्घसूत्रता न कर्तव्या"
    },
    {
     "number": 11,
     "sanskrit_text": "न चलचित्तस्य कार्यावाप्तिः"
    },
    {
     "number": 12,
     "sanskrit_text": "हस्तगतावमाननात् कार्यव्यतिक्रमो भवति"
    },
    {
     "number": 13,
     "sanskrit_text": "दोषवर्जितानि कार्याणि दुर्लभानि"
    },
    {
     "number": 14,
     "sanskrit_text": "दुरनिबन्धं कार्यं न आरभेत"
    },
    {
     "number": 15,
     "sanskrit_text": "कालवित् कार्यं साधयेत्"
    },
    {
     "number": 16,
     "sanskrit_text": "कालातिक्रमात् काल एव फलं पिबति"
    },
    {
     "number": 17,
     "sanskrit_text": "क्षणं प्रति कालविक्षेपं न कुर्यात् सर्वकृतेषु"
    },
    {
     "number": 18,
     "sanskrit_text": "देशकालविभागौ ज्ञात्वा कार्यमारभेत"
    },
    {
     "number": 19,
     "sanskrit_text": "दैवहीनं कार्यं सुसाधमपि दुस्साधं भवति"
    },
    {
     "number": 20,
     "sanskrit_text": "नीतिज्ञो देशकालौ परीक्षेत"
    },
    {
     "number": 21,
     "sanskrit_text": "परीक्ष्यकारिणि श्रीश्चिरं तिष्ठति"
    },
    {
     "number": 22,
     "sanskrit_text": "सर्वाश्च सम्पदः सर्वोपायेन परिगृह्णीयात्"
    },
    {
     "number": 23,
     "sanskrit_text": "भाग्यवन्तमप्यपरीक्ष्यकारिणं श्रीः परित्यजति"
    },
    {
     "number": 24,
     "sanskrit_text": "ज्ञात्वाऽनुमानैश्च परीक्षा कर्तव्या"
    },
    {
     "number": 25,
     "sanskrit_text": "यो यस्मिन्कर्मणि कुशलस्तं तस्मिन्नेव योजयेत्"
    },
    {
     "number": 26,
     "sanskrit_text": "दुस्साधमपि सुसाधं करोत्युपायज्ञः"
    },
    {
     "number": 27,
     "sanskrit_text": "अज्ञानिना कृतमपि न बहुमन्तव्यं यादृच्छिकत्वात्"
    },
    {
     "number": 28,
     "sanskrit_text": "कृमयोऽपो हि कदाचित् रूपान्तराणि कुर्वन्ति"
    },
    {
     "number": 29,
     "sanskrit_text": "सिद्धस्यैव कार्यस्य प्रकाशनं कर्तव्यम्"
    },
    {
     "number": 30,
     "sanskrit_text": "ज्ञानवतामपि दैवमानुषदोषात् कार्याणि दुष्यन्ति"
    },
    {
     "number": 31,
     "sanskrit_text": "दैवं दोषं शान्तिकर्मणा प्रतिषेधयेत्"
    },
