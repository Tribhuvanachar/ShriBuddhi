{"id":"1","number":"1","name_sa":"","name_en":"","shlokas":[{"id":"1.0.1","number":"1","kind":"prose","sanskrit_text":"पुरुषपात्राणि","artha":"","bhashya":[]},{"id":"1.0.2","number":"2","kind":"prose","sanskrit_text":"वृद्धः - ब्राह्मणः केशवदासनामा।","artha":"","bhashya":[]},{"id":"1.0.3","number":"3","kind":"prose","sanskrit_text":"प्रथमः - वृद्धस्य प्रथमः पुत्रः।","artha":"","bhashya":[]},{"id":"1.0.4","number":"4","kind":"prose","sanskrit_text":"द्वितीयः - वृद्धस्य द्वितीयः पुत्रः मध्यमनामा।","artha":"","bhashya":[]},{"id":"1.0.5","number":"5","kind":"prose","sanskrit_text":"तृतीयः - वृद्धस्य कनिष्ठः पुत्रः।","artha":"","bhashya":[]},{"id":"1.0.6","number":"6","kind":"prose","sanskrit_text":"घटोत्कचः - राक्षसः, हिडिम्वाभीमसेनयोः सूनुः।","artha":"","bhashya":[]},{"id":"1.0.7","number":"7","kind":"prose","sanskrit_text":"भीमसेनः - मध्यमः कुन्तीपुत्रः।","artha":"","bhashya":[]},{"id":"1.0.8","number":"8","kind":"prose","sanskrit_text":"स्त्रीपात्राणि","artha":"","bhashya":[]},{"id":"1.0.9","number":"9","kind":"prose","sanskrit_text":"ब्राह्मणी - वृद्धस्य भार्या।","artha":"","bhashya":[]},{"id":"1.0.10","number":"10","kind":"prose","sanskrit_text":"हिडिम्बा - राक्षसी, भीमसेनस्य पत्नी।","artha":"","bhashya":[]},{"id":"1.0.11","number":"11","kind":"prose","sanskrit_text":"(नान्द्यन्ते ततः प्रविशति सूत्रधारः।)","artha":"","bhashya":[]},{"id":"1.0.12","number":"12","kind":"prose","sanskrit_text":"सूत्रधारः- पायात्स वोऽसुरवधूहृदयावसादः","artha":"","bhashya":[]},{"id":"1.0.13","number":"13","kind":"prose","sanskrit_text":"पादो हरेः कुवलयामलखङ्गनीलः।","artha":"","bhashya":[]},{"id":"1.0.14","number":"14","kind":"prose","sanskrit_text":"यः प्रोद्यतस्त्रिभुवनक्रमणे रराज","artha":"","bhashya":[]},{"id":"1.1","number":"1","kind":"verse","sanskrit_text":"वैडूर्यसंङ्क्रम इवाम्बरसागरस्य","artha":"","bhashya":[]},{"id":"1.1.1","number":"1","kind":"prose","sanskrit_text":"एवमार्यमिश्रान्विज्ञापयामि। अये किं नु खलु मयि विज्ञापनव्यग्रे शब्द इव श्रूयते। अङ्ग पश्यामि।","artha":"","bhashya":[]},{"id":"1.1.2","number":"2","kind":"prose","sanskrit_text":"भोस्तात! को नु खल्वेषः।","artha":"","bhashya":[]},{"id":"1.1.3","number":"3","kind":"prose","sanskrit_text":"सूत्रधारः- भवतु, विज्ञातम्।","artha":"","bhashya":[]},{"id":"1.1.4","number":"4","kind":"prose","sanskrit_text":"भोः शब्दोच्चारणादस्य ब्राह्मणोऽयं न संशयः।","artha":"","bhashya":[]},{"id":"1.2","number":"2","kind":"verse","sanskrit_text":"त्रास्यते निर्विशङ्केन केनचित्पापचेतसा","artha":"","bhashya":[]},{"id":"1.2.1","number":"1","kind":"prose","sanskrit_text":"(पुनर्नेपथ्ये)","artha":"","bhashya":[]},{"id":"1.2.2","number":"2","kind":"prose","sanskrit_text":"भोस्तात! को नु खल्वेषः।","artha":"","bhashya":[]},{"id":"1.2.3","number":"3","kind":"prose","sanskrit_text":"सूत्रधारः- हन्त दृढं विज्ञातं। एष खलु पाण्डवमध्यमस्यात्मजो हिडिम्बारणिसम्भूतो राक्षसाग्निरकृतवैरं ब्राह्मणजनं वित्रासयति। भोः कष्टम्। अत्र हि","artha":"","bhashya":[]},{"id":"1.2.4","number":"4","kind":"prose","sanskrit_text":"भ्रान्तैः सुतैः परिवृतस्तरुणैः सदारैः","artha":"","bhashya":[]},{"id":"1.3","number":"3","kind":"verse","sanskrit_text":"सन्त्रस्तवत्सक इवाकुलतामुपैति","artha":"","bhashya":[]},{"id":"1.3.1","number":"1","kind":"prose","sanskrit_text":"(निष्क्रान्ताः।)","artha":"","bhashya":[]},{"id":"1.3.2","number":"2","kind":"prose","sanskrit_text":"ततः प्रविशति सुतत्रयकलत्रपरिवृतो ब्राह्मणः पृष्ठतो घटोत्कचश्च।)","artha":"","bhashya":[]},{"id":"1.3.3","number":"3","kind":"prose","sanskrit_text":"ब्राह्मणः- भोः को नु खल्वेषः।","artha":"","bhashya":[]},{"id":"1.3.4","number":"4","kind":"prose","sanskrit_text":"तरुणरविकरप्रकीर्णकेशो","artha":"","bhashya":[]},{"id":"1.3.5","number":"5","kind":"prose","sanskrit_text":"भ्रुकुटिपुटोज्ज्वलपिङ्गलायताक्षः।","artha":"","bhashya":[]},{"id":"1.3.6","number":"6","kind":"prose","sanskrit_text":"सतडिदिव घनः सकण्ठसूत्रो","artha":"","bhashya":[]},{"id":"1.4","number":"4","kind":"verse","sanskrit_text":"युगनिधने प्रतिमाकृतिर्हरस्य","artha":"","bhashya":[]},{"id":"1.4.1","number":"1","kind":"prose","sanskrit_text":"प्रथमः- भोस्तात! को नु खल्वेषः।","artha":"","bhashya":[]},{"id":"1.4.2","number":"2","kind":"prose","sanskrit_text":"ग्रहयुगलनिभाक्षः पीनविस्तीर्णवक्षाः","artha":"","bhashya":[]},{"id":"1.4.3","number":"3","kind":"prose","sanskrit_text":"कनककपिलकेशः पीनकौशेयवासाः।","artha":"","bhashya":[]},{"id":"1.4.4","number":"4","kind":"prose","sanskrit_text":"तिमिरनिवहवर्णः पाण्डरोद्वृत्तदंष्ट्रो","artha":"","bhashya":[]},{"id":"1.5","number":"5","kind":"verse","sanskrit_text":"नव इव जलगर्भो लीयमानेन्दुलेखः","artha":"","bhashya":[]},{"id":"1.5.1","number":"1","kind":"prose","sanskrit_text":"द्वितीयः- क एष भोः!","artha":"","bhashya":[]},{"id":"1.5.2","number":"2","kind":"prose","sanskrit_text":"कलभदशनदंष्ट्रो लाङ्गलाकारनासः","artha":"","bhashya":[]},{"id":"1.5.3","number":"3","kind":"prose","sanskrit_text":"करिवरकरबाहुर्नीलजीमूतवर्णः।","artha":"","bhashya":[]},{"id":"1.5.4","number":"4","kind":"prose","sanskrit_text":"हुतहुतवहदीप्तो य स्थितो भाति भीम-","artha":"","bhashya":[]},{"id":"1.6","number":"6","kind":"verse","sanskrit_text":"स्त्रिपुरपुरनिहन्तुः शङ्करस्येव रोषः","artha":"","bhashya":[]},{"id":"1.6.1","number":"1","kind":"prose","sanskrit_text":"तृतीयः- भोस्तात! को नु खल्वयमस्मान्पीडयति।","artha":"","bhashya":[]},{"id":"1.6.2","number":"2","kind":"prose","sanskrit_text":"वज्रपातोऽचलेन्द्राणां श्येनः सर्वपतत्रिणाम्।","artha":"","bhashya":[]},{"id":"1.7","number":"7","kind":"verse","sanskrit_text":"मृगेन्द्रो मृगसङ्घानां मृत्युः पुरुषविग्रहः","artha":"","bhashya":[]},{"id":"1.7.1","number":"1","kind":"prose","sanskrit_text":"ब्राह्मणी- अय्य को एसो अम्हाअं सन्दावेह। (आर्य! क एषोऽस्मान् सन्तापयति।)","artha":"","bhashya":[]},{"id":"1.7.2","number":"2","kind":"prose","sanskrit_text":"घटोत्कचः- भो ब्राह्मण! तिष्ठ तिष्ठ।","artha":"","bhashya":[]},{"id":"1.7.3","number":"3","kind":"prose","sanskrit_text":"किं यासि मद्भयविनाशितधैर्यसारो","artha":"","bhashya":[]},{"id":"1.7.4","number":"4","kind":"prose","sanskrit_text":"वित्रस्तदारसुतरक्षणहीनशक्ते!","artha":"","bhashya":[]},{"id":"1.7.5","number":"5","kind":"prose","sanskrit_text":"ताक्ष्र्याग्रपक्षपवनोद्धतरोषवह्नि-","artha":"","bhashya":[]},{"id":"1.8","number":"8","kind":"verse","sanskrit_text":"स्तीव्रः कलत्रसहितो भुजगो यथार्तः","artha":"","bhashya":[]},{"id":"1.8.1","number":"1","kind":"prose","sanskrit_text":"भो ब्राह्मण! न गन्तव्यं न गन्तव्यम्।","artha":"","bhashya":[]},{"id":"1.8.2","number":"2","kind":"prose","sanskrit_text":"वृद्धः- ब्राह्मणि! न भेतव्यम्। पुत्रकाः न भेतव्यम्। सविमर्शा ह्यस्य वाणी।","artha":"","bhashya":[]},{"id":"1.8.3","number":"3","kind":"prose","sanskrit_text":"घटोत्कचः- भोः! कष्टम्।","artha":"","bhashya":[]},{"id":"1.8.4","number":"4","kind":"prose","sanskrit_text":"जानामि सर्वत्र सदा च नाम","artha":"","bhashya":[]},{"id":"1.8.5","number":"5","kind":"prose","sanskrit_text":"द्विजोत्तमाः पूज्यतमाः पृथिव्याम्।","artha":"","bhashya":[]},{"id":"1.8.6","number":"6","kind":"prose","sanskrit_text":"अकार्यमेतच्च मयाद्य कार्यं","artha":"","bhashya":[]},{"id":"1.9","number":"9","kind":"verse","sanskrit_text":"मातुर्नियोगादपनीय शङ्काम्","artha":"","bhashya":[]},{"id":"1.9.1","number":"1","kind":"prose","sanskrit_text":"वृद्धः- ब्राह्मणि! किं न स्मरसि तत्रभवता जलक्लिन्नेन मुनिनोक्तं-अनपेतराक्षसमिदं वनमप्रमादेन गन्तव्यमिति। तदेवोत्पन्नं भयम्।","artha":"","bhashya":[]},{"id":"1.9.2","number":"2","kind":"prose","sanskrit_text":"ब्राह्मणी- किं दाणिं अय्यो मज्झत्थवण्णो विअ दिस्सदि। (किंमिदानीमार्यो मध्यस्थवर्ण इव दृश्यते।)","artha":"","bhashya":[]},{"id":"1.9.3","number":"3","kind":"prose","sanskrit_text":"वृद्धः- किं करिष्यामि मन्दभाग्यः।","artha":"","bhashya":[]},{"id":"1.9.4","number":"4","kind":"prose","sanskrit_text":"ब्राह्माणी- णं विक्कोसामो। (ननु विक्रोशामः)","artha":"","bhashya":[]},{"id":"1.9.5","number":"5","kind":"prose","sanskrit_text":"प्रथमः- भवति कस्य वयं विक्रोशामः।","artha":"","bhashya":[]},{"id":"1.9.6","number":"6","kind":"prose","sanskrit_text":"इदं हि शून्यं तिमिरोत्करप्रभै-","artha":"","bhashya":[]},{"id":"1.9.7","number":"7","kind":"prose","sanskrit_text":"र्नगप्रकारैरवरुद्धदिक्पथम्।","artha":"","bhashya":[]},{"id":"1.9.8","number":"8","kind":"prose","sanskrit_text":"खगैर्मृगैश्चापि समाकुलान्तरं","artha":"","bhashya":[]},{"id":"1.10","number":"10","kind":"verse","sanskrit_text":"वनं निवासाभिमतं मनस्विनाम्","artha":"","bhashya":[]},{"id":"1.10.1","number":"1","kind":"prose","sanskrit_text":"वृद्धः- ब्राह्मणि! न भेतव्यं, न भेतव्यम्। मनस्विजननिवासयोग्यमिति श्रुत्वा विगत इव मे संत्रासः। शङ्के नातिदूरेण पाण्डवाश्रमेण भवितव्यम्।","artha":"","bhashya":[]},{"id":"1.10.2","number":"2","kind":"prose","sanskrit_text":"पाण्डवास्तु,","artha":"","bhashya":[]},{"id":"1.10.3","number":"3","kind":"prose","sanskrit_text":"युद्धप्रियाश्च शरणागतवत्सलाश्च","artha":"","bhashya":[]},{"id":"1.10.4","number":"4","kind":"prose","sanskrit_text":"दीनेषु पक्षपतिताः कृतसाहसाश्च।","artha":"","bhashya":[]},{"id":"1.10.5","number":"5","kind":"prose","sanskrit_text":"एवंविधप्रतिभयाकृतिचेष्टितानां","artha":"","bhashya":[]},{"id":"1.11","number":"11","kind":"verse","sanskrit_text":"दण्डं यथार्हमिह धारयितुं समर्थाः","artha":"","bhashya":[]},{"id":"1.11.1","number":"1","kind":"prose","sanskrit_text":"प्रथमः- भोस्तात! नात्र पाणडवा इति मन्ये।","artha":"","bhashya":[]},{"id":"1.11.2","number":"2","kind":"prose","sanskrit_text":"वृद्धः- कथं त्वं जानीषे।8","artha":"","bhashya":[]},{"id":"1.11.3","number":"3","kind":"prose","sanskrit_text":"प्रथमः- श्रुतं मया तस्मादागच्छता केनचिद्ब्राह्मणेन शतकुम्भं नाम यज्ञमनुभवितुं महर्षेर्धौम्यस्याश्रमं गता इति।","artha":"","bhashya":[]},{"id":"1.11.4","number":"4","kind":"prose","sanskrit_text":"वृद्धः- हन्त हताः स्मः।","artha":"","bhashya":[]},{"id":"1.11.5","number":"5","kind":"prose","sanskrit_text":"प्रथमः- तात! न तु सर्व एव। आश्रमपरिपालनार्थमिह स्थापितः किल मध्यमः।","artha":"","bhashya":[]},{"id":"1.11.6","number":"6","kind":"prose","sanskrit_text":"वृद्धः- यद्येवं सन्निहिताः सर्वे पाण्डवाः।","artha":"","bhashya":[]},{"id":"1.11.7","number":"7","kind":"prose","sanskrit_text":"प्रथमः- स चाप्यस्यां वेलायां व्यायामपरिचयार्थं विप्रकृष्टदेशस्थ इति श्रूयते।","artha":"","bhashya":[]},{"id":"1.11.8","number":"8","kind":"prose","sanskrit_text":"वृद्धः- हन्त निराशाः स्मः । भवतु पुत्र! व्यपाश्रयिष्ये तावदेनम्।","artha":"","bhashya":[]},{"id":"1.11.9","number":"9","kind":"prose","sanskrit_text":"प्रथमः- अलमलं परिश्रमेण।","artha":"","bhashya":[]},{"id":"1.11.10","number":"10","kind":"prose","sanskrit_text":"वृद्धः- पुत्र! निर्वेदप्रत्यर्थिनी खलु प्रार्थना। भवतु पश्यामस्तावत्। भो भोः पुरुष! अस्त्यस्माकं मोक्षः।","artha":"","bhashya":[]},{"id":"1.11.11","number":"11","kind":"prose","sanskrit_text":"घटोत्कचः- मोक्षोऽस्ति समयतः।","artha":"","bhashya":[]},{"id":"1.11.12","number":"12","kind":"prose","sanskrit_text":"वृद्धः- कः समयः।","artha":"","bhashya":[]},{"id":"1.11.13","number":"13","kind":"prose","sanskrit_text":"घटोत्कचः- अस्ति मे तत्रभवती जननी। तयाहमाज्ञाप्तः। पुत्र! ममोपवासनिसर्गार्थमस्मिन्वनप्रदेशे कश्चिन्मानुषः प्रतिगृह्यानेतव्य इति। ततो मयासादितो भवान्।","artha":"","bhashya":[]},{"id":"1.11.14","number":"14","kind":"prose","sanskrit_text":"पत्न्या चारित्रशालिन्या द्विपुत्रो मोक्षमिच्छसि।","artha":"","bhashya":[]},{"id":"1.12","number":"12","kind":"verse","sanskrit_text":"बलाबलं परिज्ञाय पुत्रमेकं विसर्जय","artha":"","bhashya":[]},{"id":"1.12.1","number":"1","kind":"prose","sanskrit_text":"वृद्धः- हं भो राक्षसापसद! किमहमब्राह्मणः।","artha":"","bhashya":[]},{"id":"1.12.2","number":"2","kind":"prose","sanskrit_text":"ब्राह्मणः श्रुतवान्वृद्धः पुत्रं शीलगुणान्वितम्।","artha":"","bhashya":[]},{"id":"1.13","number":"13","kind":"verse","sanskrit_text":"पुरुषादस्य दत्वाहं कथं निर्वृतिमाप्नुयाम्","artha":"","bhashya":[]},{"id":"1.13.1","number":"1","kind":"prose","sanskrit_text":"घटोत्कचः- यद्यर्थितो द्विजश्रेष्ठ! पुत्रमेकं मुञ्चसि।","artha":"","bhashya":[]},{"id":"1.14","number":"14","kind":"verse","sanskrit_text":"सकुटुम्बः क्षणेनैव विनाशमुपयास्यसि","artha":"","bhashya":[]},{"id":"1.14.1","number":"1","kind":"prose","sanskrit_text":"वृद्धः- एव एव मे निश्चयः।","artha":"","bhashya":[]},{"id":"1.14.2","number":"2","kind":"prose","sanskrit_text":"कृतकृत्यं शरीरं मे परिणामेन जर्जरम्।","artha":"","bhashya":[]},{"id":"1.15","number":"15","kind":"verse","sanskrit_text":"राक्षसाग्नौ सुतापेक्षी होष्यामि विधिसंस्कृतम्","artha":"","bhashya":[]},{"id":"1.15.1","number":"1","kind":"prose","sanskrit_text":"ब्राह्मणी- अय्य! मा मा एवं। पदिमत्तधम्मिणी पदिव्वदत्ति णाम। गहीदफलेण एदिणा सरीरेण अय्यं कुलं च रक्खिदुमिच्छामि। (आर्य, मा मैवम्।","artha":"","bhashya":[]},{"id":"1.15.2","number":"2","kind":"prose","sanskrit_text":"पतिमात्रधर्मिणी पतिव्रतेति नाम। गृहीतफलेनैतेन शरीरेणार्यं कुलं च रक्षितुमिच्छामि।)","artha":"","bhashya":[]},{"id":"1.15.3","number":"3","kind":"prose","sanskrit_text":"घटोत्कचः- भवति! न खलु स्त्रीजनोऽभिमतस्तत्रभवत्या।","artha":"","bhashya":[]},{"id":"1.15.4","number":"4","kind":"prose","sanskrit_text":"वृद्धः- अनुगमिष्यामि भवन्तम्।","artha":"","bhashya":[]},{"id":"1.15.5","number":"5","kind":"prose","sanskrit_text":"घटोत्कचः- आः वृद्धस्त्वमपसर।","artha":"","bhashya":[]},{"id":"1.15.6","number":"6","kind":"prose","sanskrit_text":"प्रथमः- भोस्तात! ब्रवीमि खलु तावÏत्कचित्।","artha":"","bhashya":[]},{"id":"1.15.7","number":"7","kind":"prose","sanskrit_text":"वृद्धः- ब्रूहि ब्रूहि शीघ्रम्।","artha":"","bhashya":[]},{"id":"1.15.8","number":"8","kind":"prose","sanskrit_text":"प्रथमः- मम प्राणैर्गुरुप्राणानिच्छामि परिरक्षितुम्।","artha":"","bhashya":[]},{"id":"1.16","number":"16","kind":"verse","sanskrit_text":"रक्षणार्थं कुलस्यास्य मोक्तुमर्हति मां भवान्","artha":"","bhashya":[]},{"id":"1.16.1","number":"1","kind":"prose","sanskrit_text":"द्वितीयः- आर्य! मा मैवम्।","artha":"","bhashya":[]},{"id":"1.16.2","number":"2","kind":"prose","sanskrit_text":"ज्येष्ठः श्रेष्ठः कुले लोके पितॄणां च सुसंप्रियः।","artha":"","bhashya":[]},{"id":"1.17","number":"17","kind":"verse","sanskrit_text":"ततोऽहमेव यास्यामि गुरुवृत्तिमनुस्मरन्","artha":"","bhashya":[]},{"id":"1.17.1","number":"1","kind":"prose","sanskrit_text":"तृतीयः- आर्यै! मा मैवम्।","artha":"","bhashya":[]},{"id":"1.17.2","number":"2","kind":"prose","sanskrit_text":"ज्येष्ठो भ्रातापितृसमः कथितो ब्रह्मवादिभिः।","artha":"","bhashya":[]},{"id":"1.18","number":"18","kind":"verse","sanskrit_text":"ततोऽहं कर्तुमस्म्यर्हो गुरूणां प्राणरक्षणम्","artha":"","bhashya":[]},{"id":"1.18.1","number":"1","kind":"prose","sanskrit_text":"प्रथमः- वत्स! मा मैवम्।","artha":"","bhashya":[]},{"id":"1.18.2","number":"2","kind":"prose","sanskrit_text":"आपदं हि पिता प्राप्तो ज्येष्ठपुत्रेण तार्यते।","artha":"","bhashya":[]},{"id":"1.19","number":"19","kind":"verse","sanskrit_text":"ततोऽहमेव यास्यामि गुरूणां प्राणरक्षणात्","artha":"","bhashya":[]},{"id":"1.19.1","number":"1","kind":"prose","sanskrit_text":"वृद्धः- ज्येष्ठमिष्टतमं न शक्नोमि परित्यक्तुम्।","artha":"","bhashya":[]},{"id":"1.19.2","number":"2","kind":"prose","sanskrit_text":"ब्रह्मणी- यह अय्यो ज्येष्ठमिच्छदि तह अहं पि कणिट्ठमिच्छामि (यथार्यो ज्येष्ठमिच्छति तथाहमपि कनिष्ठमिच्छामि।)","artha":"","bhashya":[]},{"id":"1.19.3","number":"3","kind":"prose","sanskrit_text":"द्वितीयः- पित्रोरनिष्टः कस्येदानीं प्रियः।","artha":"","bhashya":[]},{"id":"1.19.4","number":"4","kind":"prose","sanskrit_text":"घटोत्कचः- अहं प्रीतोऽस्मि। शीघ्रमागच्छ।","artha":"","bhashya":[]},{"id":"1.19.5","number":"5","kind":"prose","sanskrit_text":"द्वितीयः- धन्योऽस्मि यद् गुरुप्राणाः स्वैः प्राणैः परिरक्षिताः।","artha":"","bhashya":[]},{"id":"1.20","number":"20","kind":"verse","sanskrit_text":"बन्धुस्नेहाद्धि महतः कायस्नेहस्तु दुर्लभः","artha":"","bhashya":[]},{"id":"1.20.1","number":"1","kind":"prose","sanskrit_text":"घटोत्कचः- अहो स्वजनवात्सल्यमस्य ब्राह्मणवटोः।","artha":"","bhashya":[]},{"id":"1.20.2","number":"2","kind":"prose","sanskrit_text":"द्वितीयः- भोस्तात! अभिवादये।","artha":"","bhashya":[]},{"id":"1.20.3","number":"3","kind":"prose","sanskrit_text":"वृद्धः- एह्येहि पुत्र।","artha":"","bhashya":[]},{"id":"1.20.4","number":"4","kind":"prose","sanskrit_text":"विनिमाय गुरुप्राणान् स्वैः प्राणैर्गुरुवत्सल।","artha":"","bhashya":[]},{"id":"1.21","number":"21","kind":"verse","sanskrit_text":"अकृतात्मदुरावापं ब्रह्मलोकमवाप्नुहि","artha":"","bhashya":[]},{"id":"1.21.1","number":"1","kind":"prose","sanskrit_text":"घटोत्कचः- चिरायते खलु ब्राह्मणवटुः। अतिक्रामति मातुराहारकालः। किं नु खलु करिष्ये। भवतु दृष्टम्। भो ब्राह्मण! आहूयतां तव पुत्रः।","artha":"","bhashya":[]},{"id":"1.21.2","number":"2","kind":"prose","sanskrit_text":"वृद्धः- आः अतिराक्षसं खलु ते वचनम्।","artha":"","bhashya":[]},{"id":"1.21.3","number":"3","kind":"prose","sanskrit_text":"घटोत्कचः- कथं रुष्यति। मर्षयतु भवान्मर्षयतु। अयं मे प्रकृतिदोषः। अथ किंनामा तव पुत्रः।","artha":"","bhashya":[]},{"id":"1.21.4","number":"4","kind":"prose","sanskrit_text":"वृद्धः- एददपि न श्क्यं श्रोतुम्।","artha":"","bhashya":[]},{"id":"1.21.5","number":"5","kind":"prose","sanskrit_text":"घटोत्कचः- युक्तं भोः! ब्राह्मणकुमार! किंनामा ते भ्राता।","artha":"","bhashya":[]},{"id":"1.21.6","number":"6","kind":"prose","sanskrit_text":"प्रथमः- तपस्वी मध्यमः।","artha":"","bhashya":[]},{"id":"1.21.7","number":"7","kind":"prose","sanskrit_text":"घटोत्कचः- मध्यम इति सदृशमस्य। अहमेवाह्वयामि। भो मध्यम! मध्यम! शीघ्रमागच्छ।","artha":"","bhashya":[]},{"id":"1.21.8","number":"8","kind":"prose","sanskrit_text":"(ततः प्रविशति भीमसेनः।)","artha":"","bhashya":[]},{"id":"1.21.9","number":"9","kind":"prose","sanskrit_text":"भीमः- भोः कस्यायं स्वरः।","artha":"","bhashya":[]},{"id":"1.21.10","number":"10","kind":"prose","sanskrit_text":"खगशतविरुते विरौति तारं","artha":"","bhashya":[]},{"id":"1.21.11","number":"11","kind":"prose","sanskrit_text":"द्रुमगहने दृढसंकटे वनेऽस्मिन्।","artha":"","bhashya":[]},{"id":"1.21.12","number":"12","kind":"prose","sanskrit_text":"जनयति च मनोज्वरं स्वरोऽयं","artha":"","bhashya":[]},{"id":"1.25","number":"25","kind":"verse","sanskrit_text":"बहुसदृशो हि धनञ्जयस्वरस्य","artha":"","bhashya":[]},{"id":"1.25.1","number":"1","kind":"prose","sanskrit_text":"घटोत्कचः- चिरायते खलु ब्राह्मणवटुः। अतिक्रामति मातुराहारकालः। किं नु खलु करिष्ये। भवतु दृष्टम्। उच्चैः शब्दापयामि। भो मध्यम! शीघ्रमागच्छ।","artha":"","bhashya":[]},{"id":"1.25.2","number":"2","kind":"prose","sanskrit_text":"भीमः- भोः। को नु खल्वेतस्मिन्वनान्तरे मम व्यायामविघ्नमुत्पाद्य मध्यम इति मां शब्दापयति। भवतु पश्यामस्तावत्। (परिक्रम्यावलोक्य सविस्मयं) अहो","artha":"","bhashya":[]},{"id":"1.25.3","number":"3","kind":"prose","sanskrit_text":"दर्शनीयोऽयं पुरुषः। अयं हि,10","artha":"","bhashya":[]},{"id":"1.25.4","number":"4","kind":"prose","sanskrit_text":"सिंहास्यः सिंहदंष्ट्रो मधुनिभनयनः स्निग्धगम्भीरकण्ठो","artha":"","bhashya":[]},{"id":"1.25.5","number":"5","kind":"prose","sanskrit_text":"बभ्रुभ्रूः श्येननासो द्विरदपतिहनुर्दीप्तविशिलष्टकेशः।","artha":"","bhashya":[]},{"id":"1.25.6","number":"6","kind":"prose","sanskrit_text":"व्यूढोरा वज्रमध्यो गजवृषभगतिर्लम्बपीनांसबाहुः","artha":"","bhashya":[]},{"id":"1.26","number":"26","kind":"verse","sanskrit_text":"सुव्यक्तं राक्षसीजो विपुलबलयुतो लोकवीरस्य पुत्रः","artha":"","bhashya":[]},{"id":"1.26.1","number":"1","kind":"prose","sanskrit_text":"घटोत्कचः- चिरायते खलु ब्राह्मणबटुः। उच्चैः शब्दापयामि। भो भो मध्यम! शीघ्रमागच्छ।","artha":"","bhashya":[]},{"id":"1.26.2","number":"2","kind":"prose","sanskrit_text":"भीमः- भोः! प्राप्तोऽस्मि।","artha":"","bhashya":[]},{"id":"1.26.3","number":"3","kind":"prose","sanskrit_text":"घटोत्कचः- न खल्वयं ब्राह्मणवटुः। अहो दर्शनीयोऽयं पुरुषः। य एषः-","artha":"","bhashya":[]},{"id":"1.26.4","number":"4","kind":"prose","sanskrit_text":"सिंहाकृतिः कनकतालसमानबाहुः","artha":"","bhashya":[]},{"id":"1.26.5","number":"5","kind":"prose","sanskrit_text":"मध्ये तनुर्गरुडपक्षविलिप्तपक्षः।","artha":"","bhashya":[]},{"id":"1.26.6","number":"6","kind":"prose","sanskrit_text":"विष्णुर्भवेद्विकसिताम्बुजपत्रनेत्रो","artha":"","bhashya":[]},{"id":"1.27","number":"27","kind":"verse","sanskrit_text":"नेत्रे ममाहरति बन्धुरिवागतोऽयम्","artha":"","bhashya":[]},{"id":"1.27.1","number":"1","kind":"prose","sanskrit_text":"भो मध्यम! त्वां खल्वहं शब्दापयामि।","artha":"","bhashya":[]},{"id":"1.27.2","number":"2","kind":"prose","sanskrit_text":"भीमः- अतः खल्वहं प्राप्तः।","artha":"","bhashya":[]},{"id":"1.27.3","number":"3","kind":"prose","sanskrit_text":"घटोत्कचः- किं भवानपि मध्यमः।","artha":"","bhashya":[]},{"id":"1.27.4","number":"4","kind":"prose","sanskrit_text":"भीमः- न तावदपरः।","artha":"","bhashya":[]},{"id":"1.27.5","number":"5","kind":"prose","sanskrit_text":"मध्यमोऽहमवध्यानामुत्सिक्तानां च मध्यमः।","artha":"","bhashya":[]},{"id":"1.28","number":"28","kind":"verse","sanskrit_text":"मध्यमोऽहं क्षितौ भद्र भ्रातॄणामपि मध्यमः","artha":"","bhashya":[]},{"id":"1.28.1","number":"1","kind":"prose","sanskrit_text":"घटोत्कचः- भवितव्यम्।","artha":"","bhashya":[]},{"id":"1.28.2","number":"2","kind":"prose","sanskrit_text":"भीमः- अपि च,","artha":"","bhashya":[]},{"id":"1.28.3","number":"3","kind":"prose","sanskrit_text":"मध्यमः पञ्चभूतानां पार्थिवानां च मध्यमः।","artha":"","bhashya":[]},{"id":"1.29","number":"29","kind":"verse","sanskrit_text":"भये च मध्यमो लोके सर्वकार्येषु मध्यमः","artha":"","bhashya":[]},{"id":"1.29.1","number":"1","kind":"prose","sanskrit_text":"वृद्धः- मध्यमस्त्विति समप्रोक्ते नूनं पाण्डवमध्यमः।","artha":"","bhashya":[]},{"id":"1.30","number":"30","kind":"verse","sanskrit_text":"अस्मान्मोक्तुमिहायातो दर्पान्मृत्योरिवोत्थितः","artha":"","bhashya":[]},{"id":"1.30.1","number":"1","kind":"prose","sanskrit_text":"मध्यमः- अस्यामाचम्य पद्मिन्यां परलोकेषु दुर्लभम्।","artha":"","bhashya":[]},{"id":"1.31","number":"31","kind":"verse","sanskrit_text":"आत्मनैवात्मनो दत्तं पद्मपत्रोज्जवलं जलम्","artha":"","bhashya":[]},{"id":"1.31.1","number":"1","kind":"prose","sanskrit_text":"भो पुरुष ! प्राप्तोऽस्मि","artha":"","bhashya":[]},{"id":"1.31.2","number":"2","kind":"prose","sanskrit_text":"घटोत्कचः- प्राप्तवानिदानीं खल्वसि मध्यमः। मध्यम! इत इतः।","artha":"","bhashya":[]},{"id":"1.31.3","number":"3","kind":"prose","sanskrit_text":"वृद्धः- (भीमसेनमुपगम्य) भो मध्यम! परित्रायस्व ब्राह्मणकुलम्।","artha":"","bhashya":[]},{"id":"1.31.4","number":"4","kind":"prose","sanskrit_text":"भीमः- न भेतव्यम् न भेतव्यम्। मध्यमोऽहमभिवादये।","artha":"","bhashya":[]},{"id":"1.31.5","number":"5","kind":"prose","sanskrit_text":"वृद्धः- वायुरिव दीर्घायुर्भव।","artha":"","bhashya":[]},{"id":"1.31.6","number":"6","kind":"prose","sanskrit_text":"भीमः- अनुगृहीतोऽस्मि। कुतो भयमार्यस्य।","artha":"","bhashya":[]},{"id":"1.31.7","number":"7","kind":"prose","sanskrit_text":"वृद्धः- श्रूयताम्। अहं खलु कुरुराजेन युधिष्ठिरेणाधिष्ठितपूर्वे कुरुजाङ्गले यूपग्रामवास्तव्यो माठरसगोत्रश्च कल्पशाखाध्वर्युः केशवदासो नाम ब्राह्मणः।","artha":"","bhashya":[]},{"id":"1.31.8","number":"8","kind":"prose","sanskrit_text":"तस्य ममोत्तरस्यां दिशि उद्यामकग्रामवासी मातुलः कौशिकसगोत्रो यज्ञबन्धुर्नामास्ति। तस्य पुत्रोपनयनार्थं सकलत्रोऽस्मि प्रस्थितः।11","artha":"","bhashya":[]},{"id":"1.31.9","number":"9","kind":"prose","sanskrit_text":"भीमः- अरिष्टोऽस्तु पन्थाः। ततस्ततः।","artha":"","bhashya":[]},{"id":"1.31.10","number":"10","kind":"prose","sanskrit_text":"वृद्धः- ततो मामेष हि-","artha":"","bhashya":[]},{"id":"1.31.11","number":"11","kind":"prose","sanskrit_text":"सजलजलदगात्रः पद्मपत्रायताक्षो","artha":"","bhashya":[]},{"id":"1.31.12","number":"12","kind":"prose","sanskrit_text":"मृगपतिगतिलीलो राक्षसः प्रोग्रदंष्ट्रः।","artha":"","bhashya":[]},{"id":"1.31.13","number":"13","kind":"prose","sanskrit_text":"जगति विगतशङ्कस्त्वद्विधानां समक्षं","artha":"","bhashya":[]},{"id":"1.32","number":"32","kind":"verse","sanskrit_text":"ससुतपरिजनं भो! हन्तुकामोऽभ्युपैति","artha":"","bhashya":[]},{"id":"1.32.1","number":"1","kind":"prose","sanskrit_text":"भीमः- एवम्। अनेन ब्राह्मणजनस्य मार्गविघ्नः कृतः। भवतु निग्रहिष्यामि तावदेनम्। भोः पुरुष! तिष्ठ तिष्ठ।","artha":"","bhashya":[]},{"id":"1.32.2","number":"2","kind":"prose","sanskrit_text":"घटोत्कचः- एष स्थितोऽस्मि।","artha":"","bhashya":[]},{"id":"1.32.3","number":"3","kind":"prose","sanskrit_text":"भीमः- किमर्थं ब्राह्मणजनमपराध्यसि।","artha":"","bhashya":[]},{"id":"1.32.4","number":"4","kind":"prose","sanskrit_text":"पुत्रनक्षत्रकीर्णस्य पत्नीकान्तप्रभस्य च।","artha":"","bhashya":[]},{"id":"1.33","number":"33","kind":"verse","sanskrit_text":"वृद्धस्य विप्रचन्द्रस्य भवान् राहुरिवोत्थितः","artha":"","bhashya":[]},{"id":"1.33.1","number":"1","kind":"prose","sanskrit_text":"घटोत्कचः- अथ किम्। राहुरेव।","artha":"","bhashya":[]},{"id":"1.33.2","number":"2","kind":"prose","sanskrit_text":"निवृत्तव्यवहारोऽयं सदारस्तनयैः सह।","artha":"","bhashya":[]},{"id":"1.34","number":"34","kind":"verse","sanskrit_text":"सर्वापराधेऽवध्यत्वान्मुच्यतां द्विजसत्तमः","artha":"","bhashya":[]},{"id":"1.34.1","number":"1","kind":"prose","sanskrit_text":"घटोत्कचः- न मुच्यते।","artha":"","bhashya":[]},{"id":"1.34.2","number":"2","kind":"prose","sanskrit_text":"भीमः- (आत्मगतम्) भोः। कस्य पुत्रेणानेन भवितव्यम्।","artha":"","bhashya":[]},{"id":"1.34.3","number":"3","kind":"prose","sanskrit_text":"भ्रातृणां मम सर्वेषां कोऽयं भोः! गुणतस्करः।","artha":"","bhashya":[]},{"id":"1.34-2","number":"34-2","kind":"verse","sanskrit_text":"दृष्टै्वतद्वालशौण्डीर्यं सौभद्रस्य स्मराम्यहम्","artha":"","bhashya":[]},{"id":"1.34.1-2","number":"1-2","kind":"prose","sanskrit_text":"घटोत्कचः- न मुच्यते।","artha":"","bhashya":[]},{"id":"1.34.2-2","number":"2-2","kind":"prose","sanskrit_text":"मुच्यतामिति विस्त्रब्धं ब्रवीति यदि मे पिता।","artha":"","bhashya":[]},{"id":"1.36","number":"36","kind":"verse","sanskrit_text":"मुच्यते न तथा ह्येष गृहीतो मातुराज्ञया","artha":"","bhashya":[]},{"id":"1.36.1","number":"1","kind":"prose","sanskrit_text":"भीमः- (आत्मगतम्) कथं मातुराज्ञेति। अहो गुरुशुश्रूषुः खल्वयं तपस्वी।","artha":"","bhashya":[]},{"id":"1.36.2","number":"2","kind":"prose","sanskrit_text":"माता किल मनुष्याणां दैवतानां च दैवतम्।","artha":"","bhashya":[]},{"id":"1.37","number":"37","kind":"verse","sanskrit_text":"मातुराज्ञां पुरस्कृत्य वयमेतां दशां गताः","artha":"","bhashya":[]},{"id":"1.37.1","number":"1","kind":"prose","sanskrit_text":"(प्रकाशम्)ः- भो पुरुष! प्रष्टव्यं खलु तावदस्ति।","artha":"","bhashya":[]},{"id":"1.37.2","number":"2","kind":"prose","sanskrit_text":"घटोत्कचः- ब्रूहि ब्रूहि, शीघ्रम्।","artha":"","bhashya":[]},{"id":"1.37.3","number":"3","kind":"prose","sanskrit_text":"भीमः- का नाम भवतो माता।","artha":"","bhashya":[]},{"id":"1.37.4","number":"4","kind":"prose","sanskrit_text":"घटोत्कचः- श्रूयतां, हिडिम्बा नाम राक्षसी,","artha":"","bhashya":[]},{"id":"1.37.5","number":"5","kind":"prose","sanskrit_text":"कौरव्यकुलदीपेन पाण्डवेन महात्मना।","artha":"","bhashya":[]},{"id":"1.38","number":"38","kind":"verse","sanskrit_text":"सनाथा या महाभागा पूर्णेन द्यौरिवेन्दुना","artha":"","bhashya":[]},{"id":"1.38.1","number":"1","kind":"prose","sanskrit_text":"भीमः- (सहर्षमात्मगतम्) एवं हिडिम्बायाः पुत्रोऽयम्। सदृशो ह्यस्य गर्वः।","artha":"","bhashya":[]},{"id":"1.38.2","number":"2","kind":"prose","sanskrit_text":"रूपं सत्त्वं बलं चैव पितृभिः सदृशं बहु।","artha":"","bhashya":[]},{"id":"1.39","number":"39","kind":"verse","sanskrit_text":"प्रजासु वीतकारुण्यं मनश्चैवास्य कीदृशम्","artha":"","bhashya":[]},{"id":"1.39.1","number":"1","kind":"prose","sanskrit_text":"(प्रकाशम्) भोः पुरुष! मुच्यताम्।","artha":"","bhashya":[]},{"id":"1.39.2","number":"2","kind":"prose","sanskrit_text":"घटोत्कचः- न मुच्यते12","artha":"","bhashya":[]},{"id":"1.39.3","number":"3","kind":"prose","sanskrit_text":"भीमः- भो ब्राह्मण! गृह्यतां तव पुत्रः। वयमेनमनुगमिष्यामः।","artha":"","bhashya":[]},{"id":"1.39.4","number":"4","kind":"prose","sanskrit_text":"द्वितीयः- मा मा भवानेवम्।","artha":"","bhashya":[]},{"id":"1.39.5","number":"5","kind":"prose","sanskrit_text":"त्यक्ताः प्रागेव मे प्राणाः गुरुप्राणेष्वपेक्षया।","artha":"","bhashya":[]},{"id":"1.40","number":"40","kind":"verse","sanskrit_text":"युवा रूपगुणोपेतो भवांस्तिष्ठतु भूतले","artha":"","bhashya":[]},{"id":"1.40.1","number":"1","kind":"prose","sanskrit_text":"भीमः- आर्य! मा मैवम्। क्षत्रियकुलोत्पन्नोऽहम्। पूज्यतमाः खलु ब्राह्मणाः। तस्मान्मच्छरीरेण ब्राह्मणशरीरं विनिमातुमिच्छामि।","artha":"","bhashya":[]},{"id":"1.40.2","number":"2","kind":"prose","sanskrit_text":"घटोत्कचः- एवं क्षत्रियोऽयं, तेनास्य दर्पः। भवतु, इममेव हत्वा नेष्यामि। अथ केनायं वारितः।","artha":"","bhashya":[]},{"id":"1.40.3","number":"3","kind":"prose","sanskrit_text":"घटोत्कचः- किं त्वया।","artha":"","bhashya":[]},{"id":"1.40.4","number":"4","kind":"prose","sanskrit_text":"भीमः- अथ किम्।","artha":"","bhashya":[]},{"id":"1.40.5","number":"5","kind":"prose","sanskrit_text":"घटोत्कचः- तेन हि भवानेवागच्छतु।","artha":"","bhashya":[]},{"id":"1.40.6","number":"6","kind":"prose","sanskrit_text":"भीमः- एवमतिबलवीर्यान्नानुगच्छामि। यदि ते शक्तिरस्ति बलात्कारेण मां नय।","artha":"","bhashya":[]},{"id":"1.40.7","number":"7","kind":"prose","sanskrit_text":"घटोत्कचः- किं मां प्रत्यभिजानीते भवान्।","artha":"","bhashya":[]},{"id":"1.40.8","number":"8","kind":"prose","sanskrit_text":"भीमः- मत्पुत्र इति जाने।","artha":"","bhashya":[]},{"id":"1.40.9","number":"9","kind":"prose","sanskrit_text":"घटोत्कचः- कथं कथं तव पुत्रोऽहम्।","artha":"","bhashya":[]},{"id":"1.40.10","number":"10","kind":"prose","sanskrit_text":"भीमः- कथं रुष्यति। मर्षयतु भवान्। सर्वाः प्रजाः क्षत्रियाणां पुत्रशब्देनाभिधीयन्ते। अत एवं मयाभिहितम्।","artha":"","bhashya":[]},{"id":"1.40.11","number":"11","kind":"prose","sanskrit_text":"घटोत्कचः- भीतानामायुधं गृहीतम्।","artha":"","bhashya":[]},{"id":"1.40.12","number":"12","kind":"prose","sanskrit_text":"भीमः- शपामि सत्येन भयं न जाने","artha":"","bhashya":[]},{"id":"1.40.13","number":"13","kind":"prose","sanskrit_text":"ज्ञातुं तदिच्छामि भवत्समीपे।","artha":"","bhashya":[]},{"id":"1.40.14","number":"14","kind":"prose","sanskrit_text":"किंरूपमेतद्वद भद्र तस्य","artha":"","bhashya":[]},{"id":"1.41","number":"41","kind":"verse","sanskrit_text":"गुणागुणज्ञः सदृशं प्रपत्स्ये","artha":"","bhashya":[]},{"id":"1.41.1","number":"1","kind":"prose","sanskrit_text":"घटोत्कचः- एष ते भयमुपदिशामि। गृह्यतामायुधम्।","artha":"","bhashya":[]},{"id":"1.41.2","number":"2","kind":"prose","sanskrit_text":"भीमः- आयुधमिति, गृहीतमेतत्।","artha":"","bhashya":[]},{"id":"1.41.3","number":"3","kind":"prose","sanskrit_text":"घटोत्कचः- कथमिव।","artha":"","bhashya":[]},{"id":"1.41.4","number":"4","kind":"prose","sanskrit_text":"भीमः- काञ्चनस्तम्भसदृशो रिपूणां निग्रहे रतः।","artha":"","bhashya":[]},{"id":"1.42","number":"42","kind":"verse","sanskrit_text":"अयं तु दक्षिणो बाहुरायुधं सहजं मम","artha":"","bhashya":[]},{"id":"1.42.1","number":"1","kind":"prose","sanskrit_text":"घटोत्कचः- इदमुपपन्नं पितुर्मे भीमसेनस्य।","artha":"","bhashya":[]},{"id":"1.42.2","number":"2","kind":"prose","sanskrit_text":"भीमः- अथ कोऽयं भीमो नाम।","artha":"","bhashya":[]},{"id":"1.42.3","number":"3","kind":"prose","sanskrit_text":"विश्वकर्ता शिवः कृष्णः शक्रः शक्तिधरो यमः।","artha":"","bhashya":[]},{"id":"1.43","number":"43","kind":"verse","sanskrit_text":"एतेषु कथ्यतां भद्र केन ते सदृशः पिता","artha":"","bhashya":[]},{"id":"1.43.1","number":"1","kind":"prose","sanskrit_text":"घटोत्कचः- सर्वेः।","artha":"","bhashya":[]},{"id":"1.43.2","number":"2","kind":"prose","sanskrit_text":"भीमः- धिगनृतमेतत्।","artha":"","bhashya":[]},{"id":"1.43.3","number":"3","kind":"prose","sanskrit_text":"घटोत्कचः- कथं कथमनृतमित्याह। क्षिपसि मे गुरुम्। भवत्विमं स्थूलं वृक्षमुत्पाट्य प्रहरामि। (उत्पाट्य प्रहरति।) कथमनेनापि नशक्यते हन्तुम्। किं नु खलु","artha":"","bhashya":[]},{"id":"1.43.4","number":"4","kind":"prose","sanskrit_text":"करिष्ये। भवतु, दृष्टम्। एतद्गिरिकूटमुत्पाट्य प्रहरामि।13","artha":"","bhashya":[]},{"id":"1.43.5","number":"5","kind":"prose","sanskrit_text":"शैलकूटं मया क्षिप्तं प्राणानादाय यास्यति।","artha":"","bhashya":[]},{"id":"1.44","number":"44","kind":"verse","sanskrit_text":"भीमः- रुष्टोऽपि कुञ्जरो वन्यो न व्याघ्रं घर्षयेद्वने","artha":"","bhashya":[]},{"id":"1.44.1","number":"1","kind":"prose","sanskrit_text":"घटोत्कचः- (प्रहृत्य) कथमनेनापि न शक्यते हन्तुम्। किं न खलु करिष्ये। बवतु दृष्टम्।","artha":"","bhashya":[]},{"id":"1.44.2","number":"2","kind":"prose","sanskrit_text":"नन्वहं भीमसेनस्य पुत्रः पौत्रो नभस्वतः।","artha":"","bhashya":[]},{"id":"1.45","number":"45","kind":"verse","sanskrit_text":"तिष्ठेदानीं सुसन्नद्धो नियुद्धे नास्ति मत्समः","artha":"","bhashya":[]},{"id":"1.45.1","number":"1","kind":"prose","sanskrit_text":"(इत्युभौ नियुद्धं कुरुतः।)","artha":"","bhashya":[]},{"id":"1.45.2","number":"2","kind":"prose","sanskrit_text":"घटोत्कचः- (भीमसेनं बद्ध्वा)","artha":"","bhashya":[]},{"id":"1.45.3","number":"3","kind":"prose","sanskrit_text":"व्रजसि कथमिह त्वं वीर्यमुल्लङ्घ्य बाह्वो-","artha":"","bhashya":[]},{"id":"1.45.4","number":"4","kind":"prose","sanskrit_text":"र्गज इव दृढपाशैः पीडितो मद्भुजाभ्याम्।","artha":"","bhashya":[]},{"id":"1.45.5","number":"5","kind":"prose","sanskrit_text":"भीमः- (आत्मगतम्) कथं गृहीतोऽस्म्यनेन। भोः सुयोधन! वर्धते ते शत्रुपक्षः। कृतरक्षो भव। (प्रकाशम्) भोः पुरुष! अवहितो भव।","artha":"","bhashya":[]},{"id":"1.45.6","number":"6","kind":"prose","sanskrit_text":"घटोत्कचः- अवहितोऽस्मि।","artha":"","bhashya":[]},{"id":"1.45.7","number":"7","kind":"prose","sanskrit_text":"भीमः- (नियुद्धबन्धमवधूय)","artha":"","bhashya":[]},{"id":"1.45.8","number":"8","kind":"prose","sanskrit_text":"व्यपनय बलदर्पं दृष्टसारोऽसि वीर!","artha":"","bhashya":[]},{"id":"1.46","number":"46","kind":"verse","sanskrit_text":"न हि मम परिखेदो विद्यते बाहुयुद्धे","artha":"","bhashya":[]},{"id":"1.46.1","number":"1","kind":"prose","sanskrit_text":"घटोत्कचः- कथमनेनापि न शक्यते हन्तुम्। किं नु खलु करिष्ये। भवतु दृष्टम्। अस्ति मातृप्रासदलब्धो मायापाशः। तेन बध्वैनं नेष्यामि। कुतः खल्वापः। भो","artha":"","bhashya":[]},{"id":"1.46.2","number":"2","kind":"prose","sanskrit_text":"गिरे! आपस्तावत्। हन्त स्त्रवति। (आचम्य मन्त्रं जपति।) भोः पुरुष।","artha":"","bhashya":[]},{"id":"1.46.3","number":"3","kind":"prose","sanskrit_text":"मायापाशेन बद्धस्त्वं विवोशोऽनुगमिष्यसि।","artha":"","bhashya":[]},{"id":"1.47","number":"47","kind":"verse","sanskrit_text":"राजसे रज्जुभिर्बद्धः शक्रध्वज इवोत्सवे","artha":"","bhashya":[]},{"id":"1.47.1","number":"1","kind":"prose","sanskrit_text":"भीमः- कथं मायापाशेन बद्धोऽस्मि। किमिदानीं करिष्ये। भवतु दृष्टम्। अस्ति मे महेश्वरप्रसादाल्लब्धो मायापाशमोक्षो मम्त्रः। तं जपामि। कुतः खल्वापः।","artha":"","bhashya":[]},{"id":"1.47.2","number":"2","kind":"prose","sanskrit_text":"भो ब्राह्मणकुमार! आनय कमण्डलुगता आपः।","artha":"","bhashya":[]},{"id":"1.47.3","number":"3","kind":"prose","sanskrit_text":"बृद्धः- इमा आपः।","artha":"","bhashya":[]},{"id":"1.47.4","number":"4","kind":"prose","sanskrit_text":"(भीमः आदायाचम्य मन्त्रं जप्त्वा मायामपनयति।)","artha":"","bhashya":[]},{"id":"1.47.5","number":"5","kind":"prose","sanskrit_text":"घटोत्कचः- अये पतितः पाशः। किमिदानीं करिष्ये। भवतु, दृष्टम्। भोः पुरुष! पूर्वसमयं स्मर।","artha":"","bhashya":[]},{"id":"1.47.6","number":"6","kind":"prose","sanskrit_text":"भीमः- समयमिति। एष स्मरामि। गच्छाग्रतः। (उमौ परिक्रामतः।)","artha":"","bhashya":[]},{"id":"1.47.7","number":"7","kind":"prose","sanskrit_text":"वृद्धः- पुत्रकाः किं कुर्मः। अयं गच्छति वृकोदरः।","artha":"","bhashya":[]},{"id":"1.47.8","number":"8","kind":"prose","sanskrit_text":"आक्रम्य राक्षसमिमं ज्वलदुग्ररूप-","artha":"","bhashya":[]},{"id":"1.47.9","number":"9","kind":"prose","sanskrit_text":"मुग्रेण बाहुबलवीर्णगुणेन युक्तम्।","artha":"","bhashya":[]},{"id":"1.47.10","number":"10","kind":"prose","sanskrit_text":"एष प्रयाति शनकैरवधूय शीघ्र-","artha":"","bhashya":[]},{"id":"1.48","number":"48","kind":"verse","sanskrit_text":"मासारवर्षमिव गोवृषभस्सलीलम्","artha":"","bhashya":[]},{"id":"1.48.1","number":"1","kind":"prose","sanskrit_text":"घटोत्कचः- इह तिष्ठ। त्वदागमनमम्बायै निवेदयामि।","artha":"","bhashya":[]},{"id":"1.48.2","number":"2","kind":"prose","sanskrit_text":"भीमः- बाढम्। गच्छ।","artha":"","bhashya":[]},{"id":"1.48.3","number":"3","kind":"prose","sanskrit_text":"घटोत्कचः- (उपसृत्य) अम्ब! अयमभिवादये। चिराभिलषितो भवत्या आहारार्थमानीतो मानुषः।","artha":"","bhashya":[]},{"id":"1.48.4","number":"4","kind":"prose","sanskrit_text":"(प्रविश्य)14","artha":"","bhashya":[]},{"id":"1.48.5","number":"5","kind":"prose","sanskrit_text":"हिडिम्बा- जाद! चिरं जीव। (जात! चिरं जीव।)","artha":"","bhashya":[]},{"id":"1.48.6","number":"6","kind":"prose","sanskrit_text":"घटोत्कचः- अनुगृहीतोऽस्मि।","artha":"","bhashya":[]},{"id":"1.48.7","number":"7","kind":"prose","sanskrit_text":"हिडिम्बा- जाद! कीदिसो माणुसो आणीदो। (जात, कीदृशो मानुष आनीतः।)","artha":"","bhashya":[]},{"id":"1.48.8","number":"8","kind":"prose","sanskrit_text":"घटोत्कचः- भवति रूपमात्रेण मानुषः। न वीर्येण।","artha":"","bhashya":[]},{"id":"1.48.9","number":"9","kind":"prose","sanskrit_text":"हिडिम्बा- किं बह्मणो। (किं ब्राह्मणः।)","artha":"","bhashya":[]},{"id":"1.48.10","number":"10","kind":"prose","sanskrit_text":"घटोत्कचः- न ब्राह्मणः।","artha":"","bhashya":[]},{"id":"1.48.11","number":"11","kind":"prose","sanskrit_text":"हिडिम्बा- आदु थेरो। (अथवा स्थविरः।)","artha":"","bhashya":[]},{"id":"1.48.12","number":"12","kind":"prose","sanskrit_text":"घटोत्कचः- न वृद्धः।","artha":"","bhashya":[]},{"id":"1.48.13","number":"13","kind":"prose","sanskrit_text":"हिडिम्बा- किं वाळो। (किं बालः।)","artha":"","bhashya":[]},{"id":"1.48.14","number":"14","kind":"prose","sanskrit_text":"घटोत्कचः- न बालः।","artha":"","bhashya":[]},{"id":"1.48.15","number":"15","kind":"prose","sanskrit_text":"हिडिम्बा- जइ एव्वं, पेक्खामि दावणं। (उभौ परिक्रामतः।) (यद्येवं पश्यामि तावदेनम्।)","artha":"","bhashya":[]},{"id":"1.48.16","number":"16","kind":"prose","sanskrit_text":"हिडिम्बा- किं एसो ममाणुसो आणीदो। (किमेष मानुष आनीतः।)","artha":"","bhashya":[]},{"id":"1.48.17","number":"17","kind":"prose","sanskrit_text":"घटोत्कचः- अम्ब! कोऽयम्।","artha":"","bhashya":[]},{"id":"1.48.18","number":"18","kind":"prose","sanskrit_text":"हिडिम्बा- उम्मत्तअ दव्वदं खु अम्हाअं। (उन्मत्तक दैवतं खल्वस्माकम्।)","artha":"","bhashya":[]},{"id":"1.48.19","number":"19","kind":"prose","sanskrit_text":"घटोत्कचः- आः कस्य दैवतम्।","artha":"","bhashya":[]},{"id":"1.48.20","number":"20","kind":"prose","sanskrit_text":"हिडिम्बा- तव अ, मम अ। (तव च, मम च।)","artha":"","bhashya":[]},{"id":"1.48.21","number":"21","kind":"prose","sanskrit_text":"घटोत्कचः- कः प्रत्ययः।","artha":"","bhashya":[]},{"id":"1.48.22","number":"22","kind":"prose","sanskrit_text":"हिडिम्बा- अअं पञ्चओ। जेदु अय्यउत्तो। (अयं प्रत्ययः! जयत्वार्यपुत्रः।)","artha":"","bhashya":[]},{"id":"1.48.23","number":"23","kind":"prose","sanskrit_text":"भीमः- (विलोक्य) का पुनरियम्। अये देवी हिडिम्बा।","artha":"","bhashya":[]},{"id":"1.48.24","number":"24","kind":"prose","sanskrit_text":"अस्माकं भ्रष्टराज्यानां भ्रमतां गहने वने।","artha":"","bhashya":[]},{"id":"1.49","number":"49","kind":"verse","sanskrit_text":"जातकारुण्यया देवि! सन्तापो नाशितस्त्वया","artha":"","bhashya":[]},{"id":"1.49.1","number":"1","kind":"prose","sanskrit_text":"हिडिम्बे! किमिदम्।","artha":"","bhashya":[]},{"id":"1.49.2","number":"2","kind":"prose","sanskrit_text":"हिडिम्बा- (कर्णे) अय्यउत्त! ईदिसं विअ। (आर्यपुत्र! ईदृशमिव।)","artha":"","bhashya":[]},{"id":"1.49.3","number":"3","kind":"prose","sanskrit_text":"भीमः- जात्या राक्षसी, न समुदाचारेण।","artha":"","bhashya":[]},{"id":"1.49.4","number":"4","kind":"prose","sanskrit_text":"हिडिम्बा- उम्मत्तअ! अभिवादेहि पिदरं। (उन्मत्तक! अभिवादय पितरम्।)","artha":"","bhashya":[]},{"id":"1.49.5","number":"5","kind":"prose","sanskrit_text":"घटोत्कचः- भोस्तात!","artha":"","bhashya":[]},{"id":"1.49.6","number":"6","kind":"prose","sanskrit_text":"आज्ञानात्तु मया पूर्वं यद्भवान्नाभिवादितः।","artha":"","bhashya":[]},{"id":"1.50","number":"50","kind":"verse","sanskrit_text":"अस्य पुत्रापराधस्य प्रसादं कर्तुमर्हसि","artha":"","bhashya":[]},{"id":"1.50.1","number":"1","kind":"prose","sanskrit_text":"अहं स धार्तराष्ट्रवनदवाग्निर्घटोत्कचोऽभिवादये। पुत्रचापलं क्षन्तुमर्हसि।","artha":"","bhashya":[]},{"id":"1.50.2","number":"2","kind":"prose","sanskrit_text":"भीमः- एह्येहि पुत्र! व्यतिक्रमकृतं क्षान्तमेव। (इति परिष्वज्य) अयं स धार्तराष्ट्रवनदवाग्निः। पुत्रापेक्षीणि खलु पितृहृदयानि। पुत्र, अतिबलपराक्रमो भव।","artha":"","bhashya":[]},{"id":"1.50.3","number":"3","kind":"prose","sanskrit_text":"घटोत्कचः- अनुगृहीतोऽमि।15","artha":"","bhashya":[]},{"id":"1.50.4","number":"4","kind":"prose","sanskrit_text":"वृद्धः- एवं भीमसेनपुत्रोऽयं घटोत्कचः।","artha":"","bhashya":[]},{"id":"1.50.5","number":"5","kind":"prose","sanskrit_text":"भीमः- पुत्र! अभिवादयात्रभवन्तं केशवदासम्।","artha":"","bhashya":[]},{"id":"1.50.6","number":"6","kind":"prose","sanskrit_text":"घटोत्कचः- भगवन्नभिवादये।","artha":"","bhashya":[]},{"id":"1.50.7","number":"7","kind":"prose","sanskrit_text":"वृद्धः- पुतृसदृशगुणकीर्तिर्भव।","artha":"","bhashya":[]},{"id":"1.50.8","number":"8","kind":"prose","sanskrit_text":"घटोत्कचः- अनुगृहीतोऽस्मि।","artha":"","bhashya":[]},{"id":"1.50.9","number":"9","kind":"prose","sanskrit_text":"वृद्धः- भो वृकोदर! रक्षितमस्मत्कुलं, स्वकुलमुद्धृतं च। गच्छामस्तावत्।","artha":"","bhashya":[]},{"id":"1.50.10","number":"10","kind":"prose","sanskrit_text":"भीमः- अनुग्राहात्तु भवतः सर्वमासीदिदं शुभम्।","artha":"","bhashya":[]},{"id":"1.51","number":"51","kind":"verse","sanskrit_text":"आश्रमोऽदूरतोऽस्माकं तत्र विश्रम्य गम्यताम्","artha":"","bhashya":[]},{"id":"1.51.1","number":"1","kind":"prose","sanskrit_text":"वृद्धः- कृतमातिथ्यमनेन जीवितप्रदानेन। तस्माद्गच्छामस्तावत्।","artha":"","bhashya":[]},{"id":"1.51.2","number":"2","kind":"prose","sanskrit_text":"भीमः- गच्छतु भवान् सकुटुम्बः पुनर्दर्शनाय।","artha":"","bhashya":[]},{"id":"1.51.3","number":"3","kind":"prose","sanskrit_text":"वृद्धः- बाढम्। प्रथमः कल्पः।","artha":"","bhashya":[]},{"id":"1.51.4","number":"4","kind":"prose","sanskrit_text":"भीमः- हिडिम्बे! इतस्तावत्। वत्स घटोत्कच! इतस्तावत्। तत्रभवन्तं केशवदासं आश्रमपदद्वारमात्रमपि सम्भावयिष्यामः।","artha":"","bhashya":[]},{"id":"1.51.5","number":"5","kind":"prose","sanskrit_text":"यथा नदीनां प्रभवः समुद्रो","artha":"","bhashya":[]},{"id":"1.51.6","number":"6","kind":"prose","sanskrit_text":"यथाहुतीनां प्रभवो हुताशनः।","artha":"","bhashya":[]},{"id":"1.51.7","number":"7","kind":"prose","sanskrit_text":"यथेन्द्रियाणां प्रभवं मनोऽपि","artha":"","bhashya":[]},{"id":"1.52","number":"52","kind":"verse","sanskrit_text":"तथा प्रभुर्नो भगवानुपेन्द्रः","artha":"","bhashya":[]},{"id":"1.52.1","number":"1","kind":"prose","sanskrit_text":"(निष्क्रान्ताः सर्वे।)","artha":"","bhashya":[]},{"id":"1.52.2","number":"2","kind":"prose","sanskrit_text":"मध्यमव्यायोगं नाम नाटकं समाप्तम्","artha":"","bhashya":[]}]}
]}
