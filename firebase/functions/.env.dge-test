# Loaded automatically by the Firebase CLI (emulators:exec / deploy) for
# the "dge-test" project only -- matches --project dge-test in
# tests/package.json's test:rules/test:e2e scripts. Switches sendOtp/
# verifyOtp onto the console provider (prints the code instead of sending
# it) so tests/e2e.spec.js can run the real OTP flow with no phone number,
# no credentials, and no money. assertProviderAllowed() in
# functions/lib/providers.js refuses this provider outside an emulator
# regardless of this file, so it is not a bypass anyone could carry into
# a real deploy by copying this value elsewhere.
OTP_PROVIDER=console
# tests/e2e.spec.js reads OTPs back from this file (the console provider
# only ever logs them otherwise, which the test would have to scrape --
# racy against the emulator's own log buffering). Loaded here so the
# FUNCTIONS emulator process reliably has it; tests/package.json's
# test:e2e script also exports it for the test-runner process itself.
DGE_OTP_ECHO_FILE=/tmp/dge-otp-echo.txt
