  "corrections": [
    { "claim": "Tarkasaṅgraha has a commentary named Āloka", "verdict": "FALSE — conflation", "detail": "Āloka is Pakṣadhara Miśra's commentary on Tattvacintāmaṇi. No Tarkasaṅgraha Āloka is catalogued anywhere checked. Removed from the tree." },
    { "claim": "Nīlakaṇṭhī and Bhāskarodaya comment on Tarkasaṅgraha", "verdict": "WRONG LEVEL", "detail": "Nīlakaṇṭhī comments on the Dīpikā (layer 2); Bhāskarodaya is a gloss on the Nīlakaṇṭhī (layer 3). Encoded at their true levels." },
    { "claim": "Kiraṇāvalī belongs in the Muktāvalī tree", "verdict": "TWO HOMONYMOUS WORKS", "detail": "Udayana's Kiraṇāvalī is on the Praśastapādabhāṣya (Vaiśeṣika, 10c). A distinct modern Kiraṇāvalī by Kṛṣṇavallabhācārya IS on the Siddhāntamuktāvalī. Both encoded, separately." },
    { "claim": "Ṛjuvimalā is by Prabhākara", "verdict": "FALSE", "detail": "Bṛhatī is Prabhākara's (on the Śābarabhāṣya); Ṛjuvimalā is Śālikanātha's, on the Bṛhatī." },
    { "claim": "Nyāyakusumāñjali's Prakāśa is by Varadarāja", "verdict": "CONFLATION", "detail": "Bodhinī is Varadarāja's; Prakāśa is Vardhamāna Upādhyāya's; Makaranda is Rucidatta's. Haridāsa is not attested as a Kusumāñjali commentator — he wrote a Prakāśa on the Tattvacintāmaṇi." },
    { "claim": "Rāmarudrī is the work's title", "verdict": "REFINEMENT", "detail": "Rāmarudra Bhaṭṭācārya's commentary on the Dinakarī is properly titled Taraṅgiṇī; Rāmarudrī is the patronymic short name. Both recorded." },
    { "claim": "Pañcalakṣaṇī, Sāmānyanirukti, Avayava etc. are independent works", "verdict": "MOSTLY FALSE", "detail": "They are named sections of Tattvacintāmaṇi's Anumāna-khaṇḍa, cross-cut by commentary layer. Only Vyutpattivāda and Śaktivāda are standalone; Bādhānta is Rucidatta's at the Āloka layer." },
    { "claim": "Mādhava, Āpadeva and Laugākṣi Bhāskara are Prābhākara", "verdict": "FALSE — scrape artifact", "detail": "Britannica's page layout places them near the Prābhākara heading. All three are Bhāṭṭa. Any importer reading that page must not infer school from proximity." }
  ],

