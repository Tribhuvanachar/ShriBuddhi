"tadvasadarTapratitisidDeriti","ck":"tatvasatartapratitisiteriti","s":"तद्वशादर्थप्रतीतिसिद्धेरिति"},{"u":"2.1","pk":"anunanan dviviDa","ck":"anunanan tvivita","s":"अनुमानं द्विविधा"},{"u":"2.2","pk":"svarTan pararTan ca","ck":"svartan parartan ca","s":"स्वार्थं परार्थं च"},{"u":"2.3","pk":"tatra svarTan trirupalingadyadanuneye jnanan tadanunanan","ck":"tatra svartan trirupalinkatyatanuneye cnanan tatanunanan","s":"तत्र स्वार्थं त्रिरूपाल्लिङ्गाद्यदनुमेये ज्ञानं तदनुमानम्"},{"u":"2.4","pk":"prananaPalavyavasTa atra api pratyaksavat","ck":"prananapalavyavasta atra api pratyaksavat","s":"प्रमाणफलव्यवस्था अत्र अपि प्रत्यक्षवत्"},{"u":"2.5","pk":"trErupyan punarlingasya anuneye satvaneva sapaksa eva satvanasapakse ca asatvaneva niscitan","ck":"trErupyan punarlinkasya anuneye satvaneva sapaksa eva satvanasapakse ca asatvaneva niscitan","s":"त्रैरूप्यं पुनर्लिङ्गस्य अनुमेये सत्त्वमेव सपक्ष एव सत्त्वमसपक्षे च असत्त्वमेव निश्चितम्"},{"u":"2.6","pk":"anuneyo tra jijnasitaviseso Darni","ck":"anuneyo tra cicnasitaviseso tarni","s":"अनुमेयो ऽत्र जिज्ञासितविशेषो धर्मी"},{"u":"2.7","pk":"saDyaDarnasananyena sanano rTa sapaksa","ck":"satyatarnasananyena sanano rta sapaksa","s":"साध्यधर्मसामान्येन समानो ऽर्थः सपक्षः"},{"u":"2.8","pk":"na sapakso sapaksa","ck":"na sapakso sapaksa","s":"न सपक्षो ऽसपक्षः"},{"u":"2.9","pk":"tato nyastadvirudDastadaBavasceti","ck":"tato nyastatvirutastatapavasceti","s":"ततो ऽन्यस्तद्विरुद्धस्तदभावश्चेति"},{"u":"2.10","pk":"trirupani ca trinyeva lingani","ck":"trirupani ca trinyeva linkani","s":"त्रिरूपाणि च त्रीण्येव लिङ्गानि"},{"u":"2.11","pk":"anupalabDi svaBava karyan ceti","ck":"anupalapti svapava karyan ceti","s":"अनुपलब्धिः स्वभावः कार्यं चेति"},{"u":"2.12","pk":"tatranupalabDiryaTa na pradesavisese kvacidGawa upalabDilaksanapraptasya anupalabDeriti","ck":"tatranupalaptiryata na pratesavisese kvacitkata upalaptilaksanapraptasya anupalapteriti","s":"तत्रानुपलब्धिर्यथा न प्रदेशविशेषे क्वचिद्घटः उपलब्धिलक्षणप्राप्तस्य अनुपलब्धेरिति"},{"u":"2.13","pk":"upalabDilaksanapraptirupalanBapratyayantarasakalyan svaBavavisesasca","ck":"upalaptilaksanapraptirupalanpapratyayantarasakalyan svapavavisesasca","s":"उपलब्धिलक्षणप्राप्तिरुपलम्भप्रत्ययान्तरसाकल्यं स्वभावविशेषश्च"},{"u":"2.14","pk":"ya svaBava satsvanyesu upalanBapratyayesu san pratyaksa eva Bavati sa svaBavavisesa","ck":"ya svapava satsvanyesu upalanpapratyayesu san pratyaksa eva pavati sa svapavavisesa","s":"यः स्वभावः सत्स्वन्येषु उपलम्भप्रत्ययेषु सन् प्रत्यक्ष एव भवति स स्वभावविशेषः"},{"u":"2.15","pk":"svaBava svasatanatraBavini saDyaDarne hetu","ck":"svapava svasatanatrapavini satyatarne hetu","s":"स्वभावः स्वसत्तामात्रभाविनि साध्यधर्मे हेतुः"}]