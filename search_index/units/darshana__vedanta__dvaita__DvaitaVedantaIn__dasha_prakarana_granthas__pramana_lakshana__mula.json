[{"u":"1","pk":"sri asesagurunisesan narayananananayan sanprananya pravaksyani pranananan svalaksanan sri jayatirTanuniviracita","ck":"sri asesakurunisesan narayananananayan sanprananya pravaksyani pranananan svalaksanan sri cayatirtanuniviracita","s":"श्रीः अशेषगुरुमीशेशं नारायणमनामयम् सम्प्रणम्य प्रवक्ष्यामि प्रमाणानां स्वलक्षणम् श्री जयतीर्थमुनिविरचिता"},{"u":"2","pk":"narayanasyEva nanaskare ko heturityata uktan asesa-guruniti","ck":"narayanasyEva nanaskare ko heturityata uktan asesa-kuruniti","s":"नारायणस्यैव नमस्कारे को हेतुरित्यत उक्तम् अशेष-गुरुमिति"},{"u":"3","pk":"laksyanatravyapako Darno laksanan","ck":"laksyanatravyapako tarno laksanan","s":"लक्ष्यमात्रव्यापको धर्मो लक्षणम्"},{"u":"4","pk":"nananatrena vastusankirtananudesa","ck":"nananatrena vastusankirtananutesa","s":"नाममात्रेण वस्तुसङ्कीर्तनमुद्देशः"},{"u":"5","pk":"dviviDan laksanan, yavalaksyaBavi ayavalaksyaBavi ceti","ck":"tvivitan laksanan, yavalaksyapavi ayavalaksyapavi ceti","s":"द्विविधं लक्षणम्, यावल्लक्ष्यभावि अयावल्लक्ष्यभावि चेति"},{"u":"6","pk":"yaTarTan prananan ,tad dviviDan ,kevalananuprananan ca","ck":"yatartan prananan ,tat tvivitan ,kevalananuprananan ca","s":"यथार्थं प्रमाणम् ,तद् द्विविधम् ,केवलमनुप्रमाणं च"},{"u":"7","pk":"yaTarTajnanan kevalan , anavaDaranajnanan sansaya","ck":"yatartacnanan kevalan , anavataranacnanan sansaya","s":"यथार्थज्ञानं केवलम् , अनवधारणज्ञानं संशयः"},{"u":"8","pk":"asananaDarnavipratipatyorapi sananaDarna evantarBavayitun sakyatvat","ck":"asananatarnavipratipatyorapi sananatarna evantarpavayitun sakyatvat","s":"असमानधर्मविप्रतिपत्त्योरपि समानधर्म एवान्तर्भावयितुं शक्यत्वात्"},{"u":"9","pk":"viparitaniscayo viparyaya","ck":"viparitaniscayo viparyaya","s":"विपरीतनिश्चयो विपर्ययः"},{"u":"10","pk":"tatsaDanananuprananan","ck":"tatsatanananuprananan","s":"तत्साधनमनुप्रमाणम्"},{"u":"11","pk":"kevalan caturviDan, isalaksniyogyayogiBedena","ck":"kevalan caturvitan, isalaksniyokyayokipetena","s":"केवलं चतुर्विधम्, ईशलक्ष्मीयोग्ययोगिभेदेन"},{"u":"12","pk":"purvadvayananadi nityan, svatantryaparatantryaByan tadvisesa","ck":"purvatvayananati nityan, svatantryaparatantryapyan tatvisesa","s":"पूर्वद्वयमनादि नित्यम्, स्वातन्त्र्यपारतन्त्र्याभ्यां तद्विशेषः"},{"u":"13","pk":"aTa va purvanityanena kartsnyenesavisayatvan","ck":"ata va purvanityanena kartsnyenesavisayatvan","s":"अथ वा पूर्वमित्यनेन कार्त्स्न्येनेशविषयत्वं"},{"u":"14","pk":"yogijnananrjunananadinityan","ck":"yokicnananrcunananatinityan","s":"योगिज्ञानमृजूनामनादिनित्यम्"},{"u":"15","pk":"tatorvak kranena hrasitan","ck":"tatorvak kranena hrasitan","s":"ततोऽर्वाक् क्रमेण ह्रसितम्"},{"u":"16","pk":"ayogijnananutpativinasavat, alpan","ck":"ayokicnananutpativinasavat, alpan","s":"अयोगिज्ञानमुत्पत्तिविनाशवत्, अल्पम्"},{"u":"17","pk":"sarvan cotpatinat kevalan triviDan","ck":"sarvan cotpatinat kevalan trivitan","s":"सर्वम् चोत्पत्तिमत् केवलं त्रिविधम्"},{"u":"18","pk":"anuprananan triviDan ,pratyaksananunananagana iti","ck":"anuprananan trivitan ,pratyaksananunananakana iti","s":"अनुप्रमाणं त्रिविधम् ,प्रत्यक्षमनुमानमागम इति"},{"u":"19","pk":"nidosarTendriyasanikarsa pratyaksan","ck":"nitosartentriyasanikarsa pratyaksan","s":"निदोषार्थेन्द्रियसन्निकर्षः प्रत्यक्षम्"},{"u":"20","pk":"nirdosopapatiranunanan","ck":"nirtosopapatiranunanan","s":"निर्दोषोपपत्तिरनुमानम्"},{"u":"21","pk":"triviDananunanan .","ck":"trivitananunanan .","s":"त्रिविधमनुमानम् .."},{"u":"22","pk":"nirdosa sabda agana","ck":"nirtosa sapta akana","s":"निर्दोषः शब्द आगमः"},{"u":"23","pk":"arTapatyupane anunavisesa","ck":"artapatyupane anunavisesa","s":"अर्थाऽपत्त्युपमे अनुमाविशेषः"},{"u":"24","pk":"sadrsyapranasaDananupananan","ck":"satrsyapranasatananupananan","s":"सादृश्यप्रमासाधनमुपमानम्"},{"u":"25","pk":"akrtasanayasanjnasnaranasahayan tatsanaBivyahrta-vakyarTapratyaBijnapratyaksan upananan","ck":"akrtasanayasancnasnaranasahayan tatsanapivyahrta-vakyartapratyapicnapratyaksan upananan","s":"अकृतसमयसंज्ञास्मरणसहायं तत्समभिव्याहृत-वाक्यार्थप्रत्यभिज्ञाप्रत्यक्षं उपमानम्"},{"u":"26","pk":"aBavonuna pratyaksan ca","ck":"apavonuna pratyaksan ca","s":"अभावोऽनुमा प्रत्यक्षं च"},{"u":"27","pk":"sanBavaparisesavanuna","ck":"sanpavaparisesavanuna","s":"संभवपरिशेषावनुमा"},{"u":"28","pk":"atnanyonyasrayacakrakanavasTakalpanagOrava srutadrswahanadayo dusananuna","ck":"atnanyonyasrayacakrakanavastakalpanakOrava srutatrstahanatayo tusananuna","s":"आत्मान्योन्याश्रयचक्रकानवस्थाकल्पनागौरव श्रुतदृष्टहानाऽदयो दूषणानुमा"},{"u":"29","pk":"syadetat na tarkonunanan","ck":"syatetat na tarkonunanan","s":"स्यादेतत् न तर्कोऽनुमानम्"},{"u":"30","pk":"upakranopasanharatadEkarupyaByasapurvataPalarTavadasca","ck":"upakranopasanharatatEkarupyapyasapurvatapalartavatasca","s":"उपक्रमोपसंहारतदैकरूप्याभ्यासापूर्वताफलार्थवादाश्च"},{"u":"31","pk":"sanaKyavakyaprakaranasTanani ca lingavisesa","ck":"sanakyavakyaprakaranastanani ca linkavisesa","s":"समाऽख्यावाक्यप्रकरणस्थानानि च लिङ्गविशेषाः"},{"u":"32","pk":"vyaptinirupanan yaduktan nirdosan pranitan lingananunananiti tadayuktan narikeladvipavasino Dunadarsanepi vahniprananudayadityata aha vyaptirupapatinulan vyaptiriti visayena visayina pratyayasyopalaksanan na kevalan pranitan linganatrananunitijanakanangikriyate kin nana ? nirdosatvantargatavyaptipranitipurvakaneva na ca tadrsan nanunitijanakan avinaBavo vyapti sa dviviDa anvayavyaptirvyatirekavyaptisceti tatra saDyena saDanasya vyaptiranvayavyapti yaTa ‘yo Dunavanasavagninan’ iti saDanaBavena saDyaBavasya vyaptirvyatirekavyapti yaTa, ‘yogninana Bavati sa Dunavana Bavati’ iti Buyo Buyo hi Dunan pasyan tatragnin pasyati, agnyaBavan pasyansca DunaBavan tato niscinoti Dunagnyo sahacaryat astyavinaBava iti grhitavyaptisca parvate Dunan pasyanstananusnarati ‘yatsaniDO yo drswa sa tasya snaraka’ iti nyayat snrtavyaptisca vyaptan Dunan parvate pratyaBijanati tenagnyanunitiriti yuktan laksananiti","ck":"vyaptinirupanan yatuktan nirtosan pranitan linkananunananiti tatayuktan narikelatvipavasino tunatarsanepi vahniprananutayatityata aha vyaptirupapatinulan vyaptiriti visayena visayina pratyayasyopalaksanan na kevalan pranitan linkanatrananuniticanakanankikriyate kin nana ? nirtosatvantarkatavyaptipranitipurvakaneva na ca tatrsan nanuniticanakan avinapavo vyapti sa tvivita anvayavyaptirvyatirekavyaptisceti tatra satyena satanasya vyaptiranvayavyapti yata ‘yo tunavanasavakninan’ iti satanapavena satyapavasya vyaptirvyatirekavyapti yata, ‘yokninana pavati sa tunavana pavati’ iti puyo puyo hi tunan pasyan tatraknin pasyati, aknyapavan pasyansca tunapavan tato niscinoti tunaknyo sahacaryat astyavinapava iti krhitavyaptisca parvate tunan pasyanstananusnarati ‘yatsanitO yo trsta sa tasya snaraka’ iti nyayat snrtavyaptisca vyaptan tunan parvate pratyapicanati tenaknyanunitiriti yuktan laksananiti","s":"व्याप्तिनिरूपणम् यदुक्तं निर्दोषं प्रमितं लिंगमनुमानमिति तदयुक्तम् नारिकेलद्वीपवासिनो धूमदर्शनेऽपि वह्निप्रमानुदयादित्यत आह व्याप्तिरूपपत्तिमूलम् व्याप्तिरिति विषयेण विषयिणः प्रत्ययस्योऽपलक्षणम् न केवलं प्रमितं लिङ्गमात्रमनुमितिजनकमंगीक्रियते किं नाम ? निर्दोषत्वान्तर्गतव्याप्तिप्रमितिपूर्वकमेव न च तादृशं नानुमितिजनकम् अविनाभावो व्याप्तिः सा द्विविधा अन्वयव्याप्तिर्व्यतिरेकव्याप्तिश्चेति तत्र साध्येन साधनस्य व्याप्तिरन्वयव्याप्तिः यथा ‘यो धूमवानसावग्निमान्’ इति साधनाभावेन साध्याभावस्य व्याप्तिर्व्यतिरेकव्याप्तिः यथा, ‘योऽग्निमान्न भवति स धूमवान्न भवति’ इति भूयो भूयो हि धूमं पश्यन् तत्राग्निं पश्यति, अग्न्यभावं पश्यंश्च धूमाभावं ततो निश्चिनोति धूमाग्न्योः साहचर्यात् अस्त्यविनाभाव इति गृहीतव्याप्तिश्च पर्वते धूमं पश्यंस्तामनुस्मरति ‘यत्सन्निधौ यो दृष्ष्टः स तस्य स्मारकः’ इति न्यायात् स्मृतव्याप्तिश्च व्याप्तं धूमं पर्वते प्रत्यभिजानाति तेनाग्न्यनुमितिरिति युक्तं लक्षणमिति"},{"u":"33","pk":"dviviDananunanan svarTan pararTan ceti","ck":"tvivitananunanan svartan parartan ceti","s":"द्विविधमनुमानम् स्वार्थं परार्थं चेति"},{"u":"34","pk":"sa pratijnahetudaswantarupa setyupapatipratipadakan vakyanupalaksyate drswanteti tatpratipadakanudaharanan pratipadanaya paksavacanan pratijna yaTa ‘parvatogninan’ iti saDanatvaBivyanjakaviBaktyantan lingavacanan hetu yaTa ‘Dunavatvat’ iti vyaptidarsanapurasaran sanyagdrswantaBiDananudaharanan vyaptagrahanasTalan drswanta sa dviviDa saDarnyadrswanto vEDarnyadrswantascetyeke anvaya-vyaptigrahanasTalan saDanaryadrswanta vyatirekavyaptigrahanasTalan vEDarnyadaswanta ata evodaharananapyevan dviviDan tatra saDarnyodaharanan yaTa ‘yo Dunavanasavagninan yaTa nahanasa’ iti vEDarnyodaharanan yaTa ‘yogninana Bavati sa Dunavana Bavati yaTa hrda’ iti etEstriBirevavayavErupapaterboDayitun sakyatvana tadrsavayavatvadiniyano yukta aTa va drswantapadena tadvacananatropalaksanenedan paksantaran upalaksanan cEtat udaharanopanayanigananE udaharanopanayaByan va sakyate boDayitun drswantopananena lingasya pakse upasanhara upanaya sopyudaharananusarena dviviDa iti ‘taTa cayan Dunavan parvata’ iti saDarnyopanaya ‘na taTayan nirDuna parvata’ iti vEDarnyopanaya hetupurasaran pakse saDyopasanharo nigananan yaTa ‘tasnat parvatogninaneva’ iti kin ca jijnasadaya sabda eva na Bavanti kuto vakyavayava kutastaran taniyana upanayanigananayo pratijnahetuByan gatarTatvaceti","ck":"sa praticnahetutastantarupa setyupapatipratipatakan vakyanupalaksyate trstanteti tatpratipatakanutaharanan pratipatanaya paksavacanan praticna yata ‘parvatokninan’ iti satanatvapivyancakavipaktyantan linkavacanan hetu yata ‘tunavatvat’ iti vyaptitarsanapurasaran sanyaktrstantapitananutaharanan vyaptakrahanastalan trstanta sa tvivita satarnyatrstanto vEtarnyatrstantascetyeke anvaya-vyaptikrahanastalan satanaryatrstanta vyatirekavyaptikrahanastalan vEtarnyatastanta ata evotaharananapyevan tvivitan tatra satarnyotaharanan yata ‘yo tunavanasavakninan yata nahanasa’ iti vEtarnyotaharanan yata ‘yokninana pavati sa tunavana pavati yata hrta’ iti etEstripirevavayavErupapaterpotayitun sakyatvana tatrsavayavatvatiniyano yukta ata va trstantapatena tatvacananatropalaksanenetan paksantaran upalaksanan cEtat utaharanopanayanikananE utaharanopanayapyan va sakyate potayitun trstantopananena linkasya pakse upasanhara upanaya sopyutaharananusarena tvivita iti ‘tata cayan tunavan parvata’ iti satarnyopanaya ‘na tatayan nirtuna parvata’ iti vEtarnyopanaya hetupurasaran pakse satyopasanharo nikananan yata ‘tasnat parvatokninaneva’ iti kin ca cicnasataya sapta eva na pavanti kuto vakyavayava kutastaran taniyana upanayanikananayo praticnahetupyan katartatvaceti","s":"सा प्रतिज्ञाहेतुद्दष्टान्तरूपा सेत्युपपत्तिप्रतिपादकं वाक्यमुपलक्ष्यते दृष्टान्तेऽति तत्प्रतिपादकमुदाहरणम् प्रतिपादनाय पक्षवचनं प्रतिज्ञा यथा ‘पर्वतोऽग्निमान्’ इति साधनत्वाभिव्यंजकविभक्त्यन्तं लिङ्गवचनं हेतुः यथा ‘धूमवत्वात्’ इति व्याप्तिदर्शनपुरस्सरं सम्यग्दृष्टान्ताभिधानमुदाहरणम् व्याप्तग्रहणस्थलं दृष्टान्तः स द्विविधः साधर्म्यदृष्टान्तो वैधर्म्यदृष्टान्तश्चेत्येके अन्वय-व्याप्तिग्रहणस्थलं साधमर्यदृष्टान्तः व्यतिरेकव्याप्तिग्रहणस्थलं वैधर्म्यद्दष्टान्तः अत एवोदाहरणमप्येवं द्विविधम् तत्र साधर्म्योदाहरणं यथा ‘यो धूमवानसावग्निमान् यथा महानस’ इति वैधर्म्योदाहरणं यथा ‘योऽग्निमान्न भवति स धूमवान्न भवति यथा हृद’ इति एतैस्त्रिभिरेवावयवैरुपपत्तेर्बोधयितुं शक्यत्वान्न तदृशावयवत्वाऽदिनियमो युक्तः अथ वा दृष्टान्तपदेन तद्वचनमात्रोपलक्षणेनेदं पक्षान्तरम् उपलक्षणं चैतत् उदाहरणोपनयनिगमनैः उदाहरणोपनयाभ्यां वा शक्यते बोधयितुम् दृष्टान्तोपमानेन लिङ्गस्य पक्षे उपसंहारः उपनयः सोप्युदाहरणानुसारेण द्विविध इति ‘तथा चायं धूमवान् पर्वतः’ इति साधर्म्योपनयः ‘न तथाऽयं निर्धूमः पर्वतः’ इति वैधर्म्योपनयः हेतुपुरस्सरं पक्षे साध्योपसंहारो निगमनम् यथा ‘तस्मात् पर्वतोऽग्निमानेव’ इति किं च जिज्ञासादयः शब्दा एव न भवन्ति कुतो वाक्यावयवाः कुतस्तरां तन्नियमः उपनयनिगमनयोः प्रतिज्ञाहेतुभ्यां गतार्थत्वाच्चेति"},{"u":"35","pk":"upapatidosO viroDasangati","ck":"upapatitosO virotasankati","s":"उपपत्तिदोषौ विरोधासङ्गती"},{"u":"36","pk":"sanvadanuktiyuta nigraha","ck":"sanvatanuktiyuta nikraha","s":"संवादानुक्तियुता निग्रहाः"},{"u":"37","pk":"tatra yena yat yaTa saDyatvadina nirdiswan tasya taTa nirvahadarsanena punastyaga pratijnahani","ck":"tatra yena yat yata satyatvatina nirtistan tasya tata nirvahatarsanena punastyaka praticnahani","s":"तत्र येन यत् यथा साध्यत्वादिना निर्दिष्टं तस्य तथा निर्वाहादर्शनेन पुनस्त्यागः प्रतिज्ञाहानिः"},{